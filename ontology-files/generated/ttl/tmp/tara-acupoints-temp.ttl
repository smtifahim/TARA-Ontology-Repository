    tara:hasSurfaceLocation UBERON:0003823 ;
    tara:hasSynonym "B 55",
        "Bladder 55",
        "UB 55",
        "Urinary Bladder 55" ;
    tara:hasVasculatureDescription "The small saphenous vein; deeper, the popliteal artery and vem." ;
