tara:TARA_8120328 a owl:Class ;
    rdfs:label "SP 11" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 75. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "箕門(门)" ;
    tara:hasGeneralSurfaceLocation UBERON:0000376 ;
    tara:hasIndicationsDescription "dysuria, enuresis, pain and swelling in the inguinal region, muscular atrophy, motor impairment, pain and paralysis of the lower extremities." ;
    tara:hasInnervationDescription "The anterior femoral cutaneous nerve; deeper, the saphenous nerve." ;
    tara:hasLocationalDescription "On the medial aspect of the thigh, at the junction of the upper one third and lower two thirds of the line connecting the medial end of the base of the patella with SP12, between the sartorius muscle and the adductor longus muscle, over the femoral artery." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Jimen" ;
