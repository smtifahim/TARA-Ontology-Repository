tara:TARA_3641900 a owl:Class ;
    rdfs:label "Jinjing" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasIndicationsDescription "Swelling of the tongue, vomiting, aphasia with stiffness of tongue." ;
    tara:hasLocationalDescription "On the veins on both sides of the frenulum of the tongue, Jinjin is on the left, Yuye, on the right." ;
    tara:hasMethodDescription "Prick to cause bleeding." ;
    tara:hasSynonym "EX-HN 12",
        "Jinjin",
        "M-HN 20a" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_3668538 a owl:Class ;
    rdfs:label "GB 41" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 192. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "足臨(临)泣" ;
    tara:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara:hasIndicationsDescription "headache, vertigo, pain of the outer canthus, scrofula, pain in the hypochondriac region, distending pain of the breast, irregular menstruation, pain and swelling of the dorsum of foot, spastic pain of the foot and toe." ;
    tara:hasInnervationDescription "The branch of the intermediate dorsal cutaneous nerve of the foot." ;
    tara:hasLocationalDescription "On the dorsum of the foot, distal to the junction of the bases of the fourth and fifth metatarsal bones, in the depression lateral to the fifth extensor digitorum longus tendon." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Zulinqi" ;
    tara:hasSpecialPointRole tara:TARA_6705086,
        tara:TARA_9493899 ;
    tara:hasSpecificSurfaceLocation UBERON:0003653,
        UBERON:0003654,
        ILX:0795504 ;
    tara:hasSynonym "G 41",
        "Gallbladder 41" ;
    tara:hasVasculatureDescription "The dorsal arterial and venous network of foot, the fourth dorsal metatarsal artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_5283975 ;
