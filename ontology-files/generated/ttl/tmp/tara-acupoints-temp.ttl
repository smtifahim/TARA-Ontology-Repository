    tara:hasSpecificSurfaceLocation UBERON:0001539,
        UBERON:0003650,
        UBERON:0003651 ;
    tara:hasSynonym "LIV 3",
        "LV 3",
        "Liver 3" ;
    tara:hasVasculatureDescription "The dorsal venous network of the foot, the first dorsal metatarsal artery." ;
    tara:isLocatedOnMeridian tara:TARA_5419503 ;
