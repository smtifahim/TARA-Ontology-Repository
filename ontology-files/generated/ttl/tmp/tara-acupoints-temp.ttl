                    owl:someValuesFrom UBERON:0036014 ] ] .

tara:TARA_2687954 a owl:Class ;
    rdfs:label "KI 9" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 140. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "築(筑)賓(宾)" ;
    tara:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara:hasIndicationsDescription "mental disorder, pain in the foot and lower leg, hernia." ;
    tara:hasInnervationDescription "The medial sural and medial crural cutaneous nerves, deeper, the tibial nerve." ;
    tara:hasLocationalDescription "On the posteromedial aspect of the leg, between the soleus muscle and the calcaneal tendon, 5 B-cun superior to the prominence of the medial malleolus. Note 1: With the knee flexed and the leg stretched (plantar flexion) against resistance, the soleus muscle can be seen more clearly along the medial border of the tibia bone. Note 2: At the same level as LR5, on the line connecting KI3 with KI10." ;
    tara:hasPinyinLabel "Zhubin" ;
    tara:hasSpecialPointRole tara:TARA_8063120 ;
    tara:hasSpecificSurfaceLocation UBERON:0000979,
        UBERON:0001389,
        UBERON:0003701,
        ILX:0795305 ;
    tara:hasSynonym "K 9",
        "KD 9",
        "KID 9",
        "Kidney 9" ;
    tara:hasVasculatureDescription "Deeper, the posterior tibial artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_4813389 ;
    rdfs:subClassOf [ a owl:Restriction ;
