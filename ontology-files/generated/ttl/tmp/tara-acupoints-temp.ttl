    tara:hasChineseLabel "天井" ;
    tara:hasGeneralSurfaceLocation UBERON:0001461 ;
    tara:hasIndicationsDescription "migraine, pain in the neck, shoulder and arm, epilepsy, scrofula, goiter." ;
