tara:TARA_8833337 a owl:Class ;
    rdfs:label "CV 6" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 222. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "氣(气,気)海(海)" ;
    tara:hasGeneralSurfaceLocation ILX:0795303 ;
    tara:hasIndicationsDescription "abdominal pain, enuresis, nocturnal emission, impotence, hernia, edema, diarrhea, dysentery, uterine bleeding, irregular menstruation, dysmenorrhea, amenorrhea, morbid leukorrhea, postpartum hemorrhage, constipation, flaccid type of apoplexy, asthma." ;
    tara:hasLocationalDescription "On the lower abdomen, 1.5 B-cun inferior to the centre of the umbilicus, on the ante- rior median line." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. This is one of the important points for tonification. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Qihai" ;
    tara:hasSpecificSurfaceLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSynonym "Conception Vessel 6",
        "RN 6",
        "Ren 6",
        "VC 6" ;
    tara:hasVasculatureDescription "The branches of superficial epigastric artery and vein, and the branches of inferior epigastric artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_6789717 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0007118 ] ],
        [ a owl:Restriction ;
