    tara:hasChineseLabel "然谷" ;
    tara:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara:hasIndicationsDescription "pruritus vulvae, prolapse of the uterus, irregular menstruation, nocturnal emission, hemoptysis, thirst, diarrhea, swelling and pain of the dorsum of foot, acute infantile omphalitis." ;
    tara:hasInnervationDescription "The terminal branch of the medial crural cutaneous nerve, the medial plantar nerve." ;
    tara:hasLocationalDescription "On the medial aspect of the foot, inferior to the tuberosity of the navicular bone, at the border between the red and white flesh." ;
    tara:hasPinyinLabel "Rangu" ;
    tara:hasSpecialPointRole tara:TARA_9857829 ;
    tara:hasSpecificSurfaceLocation UBERON:0010759 ;
    tara:hasSynonym "K 2",
        "KD 2",
        "KID 2",
        "Kidney 2" ;
    tara:hasVasculatureDescription "The branches of the medial plantar and medial tarsal arteries." ;
    tara:isLocatedOnMeridian tara:TARA_4813389 ;
