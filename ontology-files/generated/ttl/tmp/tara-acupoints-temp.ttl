tara:TARA_6135195 a owl:Class ;
    rdfs:label "GV 17" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 212. ISBN 978-92-9061-248-7.

