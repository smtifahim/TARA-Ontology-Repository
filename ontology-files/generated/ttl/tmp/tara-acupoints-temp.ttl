tara:TARA_3865403 a owl:Class ;
    rdfs:label "GV 1" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 204. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "長(长)強" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_6993030 ;
    tara:hasIndicationsDescription "Diarrhea, bloody stools, hemorrhoids, prolapse of the rectum, constipation, pain in the lower back, epilepsy." ;
    tara:hasInnervationDescription "The posterior ramus of the coccygeal nerve, the hemorrhoid nerve." ;
    tara:hasLocationalDescription "In the perineal region, inferior to the coccyx, midway between the tip of the coccyx and the anus. Note: The subject may be in prone position or knee-chest position." ;
    tara:hasMeridian tara:TARA_0386099 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.1 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Changqiang" ;
    tara:hasRelatedLocation UBERON:0001245,
        UBERON:0001350 ;
    tara:hasSurfaceLocation UBERON:0002356 ;
    tara:hasSynonym "Du 1",
        "Governor Vessel 1" ;
    tara:hasVasculatureDescription "The branches of the inferior hemorrhoid artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
