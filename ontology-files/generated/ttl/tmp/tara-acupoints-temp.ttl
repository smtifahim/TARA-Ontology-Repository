            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001684 ] ] .

tara:TARA_3452202 a owl:Class ;
    rdfs:label "Acupoint of the Small Intestine Meridian" ;
    dc:description "An acupuncture point that is located along the Small Intestine Meridian of Hand-Taiyang (SI), which consists of 19 standardized acupoints beginning at SI 1 (Shaoze) on the ulnar side of the little finger near the corner of the nail, traveling up the dorsal-ulnar aspect of the arm, across the scapular region, and ascending along the lateral neck and cheek, and ending at SI 19 (Tinggong) in the depression between the tragus and the mandibular condyloid process." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7." ;
    tara:hasMeridian tara:TARA_9093316 ;
    tara:hasSynonym "Acupoint of the small intestine meridian of hand-taiyang",
        "Acupuncture point of the small intestine meridian",
        "Acupuncture point of the small intestine meridian of hand-taiyang",
        "SI" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_9093316 ] ) ] .

tara:TARA_3472408 a owl:Class ;
    rdfs:label "CV 17" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 228. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "膻中" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_0220312,
        tara:TARA_9406515 ;
    tara:hasIndicationsDescription "Asthma, pain in the chest, fullness in the chest, palpitation, insufficient lactation, hiccup, difficulty in swallowing." ;
    tara:hasInnervationDescription "The anterior cutaneous branch of the fourth intercostal nerve." ;
    tara:hasLocationalDescription "In the anterior thoracic region, at the same level as the fourth intercostal space, on the anterior median line." ;
    tara:hasMeridian tara:TARA_6789717 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Tanzhong" ;
    tara:hasRelatedLocation ILX:0795285,
        ILX:0795298 ;
    tara:hasSurfaceLocation UBERON:0016416 ;
    tara:hasSynonym "Conception Vessel 17",
        "Front-Mu Point of the Pericardium",
        "RN 17",
        "Ren 17" ;
    tara:hasVasculatureDescription "See Zhongting (CV 16)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795298 ] ],
        [ a owl:Restriction ;
