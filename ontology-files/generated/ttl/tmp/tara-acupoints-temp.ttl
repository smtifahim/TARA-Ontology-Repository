tara:TARA_4613316 a owl:Class ;
    rdfs:label "Yaoqi" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Epilepsy, headache, inomnia, constipation." ;
    tara:hasLocationalDescription "2 cun directly above the tip of the coccyx." ;
    tara:hasMethodDescription "Puncture subcutaneously upward 1.0-2.0 inches. Moxibustion is applicable." ;
    tara:hasSynonym "EX-B 9",
        "M-BW 29" ;
    rdfs:subClassOf tara:TARA_3535998 .

