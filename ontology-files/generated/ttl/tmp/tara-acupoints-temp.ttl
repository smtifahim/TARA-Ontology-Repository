tara:TARA_5894876 a owl:Class ;
    rdfs:label "TE 14" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 164. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "肩髎(髎)" ;
    tara:hasIndicationsDescription "Pain and motor impairment of the shoulder and upper arm." ;
    tara:hasInnervationDescription "The muscular branch of the axillary nerve." ;
    tara:hasLocationalDescription "On the shoulder girdle, in the depression between the acromial angle and the greater tubercle of the humerus. Note: When the elbow is flexed and the arm is abducted, two depressions appear respectively anterior and posterior to the acromion. LI15 is located in the anterior one, deeper than the posterior one, in which tE14 is located." ;
    tara:hasMeridian tara:TARA_3898257 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.7-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Jianliao" ;
    tara:hasRelatedLocation UBERON:0002497,
        UBERON:0011187 ;
    tara:hasSurfaceLocation UBERON:0001421 ;
    tara:hasSynonym "SJ 14",
        "San Jiao 14",
        "TB 14",
        "TH 14",
        "TW 14",
        "Triple Burner 14",
        "Triple Energizer 14",
        "Triple Heater 14",
        "Triple Warmer 14" ;
    tara:hasVasculatureDescription "The muscular branch of the posterior circumflex humeral artery." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_3898257 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002497 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
