        ILX:0795332 ;
    tara:hasSynonym "H 3",
        "HE 3",
        "Heart 3" ;
    tara:hasVasculatureDescription "The basilic vein, the inferior ulnar collateral artery, the ulnar recurrent artery and vein." ;
