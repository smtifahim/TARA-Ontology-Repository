        "TW 14",
        "Triple Burner 14",
        "Triple Energizer 14",
        "Triple Heater 14",
        "Triple Warmer 14" ;
    tara:hasVasculatureDescription "The muscular branch of the posterior circumflex humeral artery." ;
    tara:isLocatedOnMeridian tara:TARA_3898257 ;
