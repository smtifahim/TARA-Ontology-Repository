    tara:hasChineseLabel "大赫" ;
    tara:hasGeneralSurfaceLocation ILX:0795303 ;
    tara:hasIndicationsDescription "nocturnal emission, impotence, morbid leukorrhea, pain in the external genitalia, prolapse of the uterus." ;
    tara:hasInnervationDescription "The branches of subcostal nerve and the iliohypogastric nerve." ;
    tara:hasLocationalDescription "On the lower abdomen, 4 B-cun inferior to the centre of the umbilicus, 0.5 B-cun lateral to the anterior median line." ;
    tara:hasPinyinLabel "Dahe" ;
    tara:hasSpecificSurfaceLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSynonym "K 12",
