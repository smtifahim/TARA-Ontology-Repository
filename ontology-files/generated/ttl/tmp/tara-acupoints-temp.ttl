tara:TARA_6477399 a owl:Class ;
    rdfs:label "PC 5" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 154. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "間(间)使" ;
    tara:hasGeneralSurfaceLocation UBERON:0002386 ;
    tara:hasIndicationsDescription "cardiac pain, palpitation, stomachache, vomiting, febrile diseases, irritability, malaria, mental disorder, epilepsy, swelling of the axilla, contracture of the elbow and arm." ;
    tara:hasInnervationDescription "The medial and lateral antebrachial cutaneous nerves, the palmar cutaneous branch of the median nerve; deeper, the anterior interosseous nerve." ;
    tara:hasLocationalDescription "On the anterior aspect of the forearm, between the tendons of the palmaris longus and the flexor carpi radialis, 3 B-cun proximal to the palmar wrist crease. Note 1: With the fist clenched, the wrist supinated and the elbow slightly flexed, the two tendons become more prominent. PC5 is located 3 B-cun proximal to PC7. Note 2: If the palmaris longus tendon is not present, PC5 is medial to the flexor carpi radialis tendon." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Jianshi" ;
    tara:hasSpecialPointRole tara:TARA_7315457 ;
    tara:hasSpecificSurfaceLocation UBERON:0016496,
        ILX:0795334,
        ILX:0795500 ;
    tara:hasSynonym "P 5",
        "Pericardium 5" ;
    tara:hasVasculatureDescription "The median artery and vein; deeper, the anterior interosseous artery and vein." ;
