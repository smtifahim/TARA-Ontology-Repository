tara:TARA_2031703 a owl:Class ;
    rdfs:label "ST 12" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 51. https://iris.who.int/handle/10665/353407",
