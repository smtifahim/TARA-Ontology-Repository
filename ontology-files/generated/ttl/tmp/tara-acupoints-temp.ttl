            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ] .

tara:TARA_9217640 a owl:Class ;
    rdfs:label "KI 12" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 141. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "大赫" ;
    tara:hasIndicationsDescription "Nocturnal emission, impotence, morbid leukorrhea, pain in the external genitalia, prolapse of uterus." ;
    tara:hasInnervationDescription "The branches of subcostal nerve and the iliohypogastric nerve." ;
    tara:hasLocationalDescription "On the lower abdomen, 4 B-cun inferior to the centre of the umbilicus, 0.5 B-cun lateral to the anterior median line." ;
    tara:hasMeridian tara:TARA_4813389 ;
    tara:hasPinyinLabel "Dahe" ;
    tara:hasRelatedLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSurfaceLocation ILX:0795303 ;
    tara:hasSynonym "K 12",
        "Kidney 12" ;
    tara:hasVasculatureDescription "The muscular branches of the inferior epigastric artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
