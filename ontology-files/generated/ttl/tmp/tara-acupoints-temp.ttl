tara:TARA_2324295 a owl:Class ;
    rdfs:label "GB 20" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 181. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "風(风)池" ;
    tara:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara:hasIndicationsDescription "headache, vertigo, insomnia, pain and stiffness of the neck, blurred vision, glaucoma, red and painful eyes, tinnitus, convulsion, epilepsy, infantile convulsion, febrile diseases, common cold, nasal obstruction, rhinorrhea." ;
    tara:hasInnervationDescription "The branch of the lesser occipital nerve." ;
    tara:hasLocationalDescription "In the anterior region of the neck, inferior to the occipital bone, in the depression between the origins of sternocleidomastoid and the trapezius muscles. Note: GB20 is at the same level as GV16." ;
    tara:hasMethodDescription "Puncture 0.5-0.8 inch towards the tip of the nose. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Fengchi" ;
    tara:hasSpecificSurfaceLocation UBERON:0001128,
        UBERON:0001676,
        UBERON:0002380 ;
    tara:hasSynonym "G 20",
        "Gallbladder 20" ;
    tara:hasVasculatureDescription "The branches of the occipital artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_5283975 ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ],
