            owl:someValuesFrom tara:TARA_5288936 ] .

tara:TARA_0995552 a owl:Class ;
    rdfs:label "Acupoint of the Bladder Meridian" ;
    dc:description "An acupuncture point that is located along the Bladder Meridian of Foot-Taiyang (BL), which consists of 67 standardized acupoints beginning at BL 1 (Jingming) on the face in the depression just superior to the inner canthus of the eye, traveling up over the head, descending down the back in two parallel lines flanking the spine, and continuing along the posterior aspect of the leg, ending at BL 67 (Zhiyin) on the lateral side of the little toe near the corner of the nail." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasSynonym "Acupoint of the bladder meridian of foot-taiyang",
        "Acupuncture point of the bladder meridian",
        "Acupuncture point of the bladder meridian of foot-taiyang",
        "Acupuncture point of the urinary bladder meridian",
        "BL",
        "UB" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ] .

tara:TARA_1031890 a owl:Class ;
    rdfs:label "GB 12" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 177. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "完骨(骨)" ;
    tara:hasIndicationsDescription "Headache, insomnia, swelling of the cheek, retroauricular pain, deviation of the eye and mouth, toothache." ;
    tara:hasInnervationDescription "The lesser occipital nerve." ;
    tara:hasLocationalDescription "In the anterior region of the neck, in the depression posteroinferior to the mastoid process." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Wangu" ;
    tara:hasRelatedLocation UBERON:0011220 ;
    tara:hasSurfaceLocation UBERON:0000974 ;
    tara:hasSynonym "G 12",
        "Gallbladder 12" ;
    tara:hasVasculatureDescription "The posterior auricular artery and vein." ;
