tara:TARA_2678362 a owl:Class ;
    rdfs:label "GV 2" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 204. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "腰兪(俞)" ;
    tara:hasGeneralSurfaceLocation UBERON:0005473 ;
    tara:hasIndicationsDescription "irregular menstruation, pain and stiffness of the lower back, hemorrhoids, muscular atrophy of the lower extremities, epilepsy." ;
    tara:hasInnervationDescription "The branch of the coccygeal nerve." ;
    tara:hasLocationalDescription "In the sacral region, at the sacral hiatus, on the posterior median line. Note: The sacral hiatus is a small depression immediately above the anal cleft." ;
    tara:hasMethodDescription "Puncture obliquely upward 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Yaoshu" ;
    tara:hasSpecificSurfaceLocation UBERON:0036013,
        ILX:0795312 ;
    tara:hasSynonym "Du 2",
        "Governor Vessel 2",
        "VG 2" ;
    tara:hasVasculatureDescription "The branches of the median sacral artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_0386099 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
