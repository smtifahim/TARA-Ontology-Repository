tara:TARA_5873796 a owl:Class ;
    rdfs:label "ST 29" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 60. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "歸(归,帰)來(来)" ;
    tara:hasIndicationsDescription "Abdominal pain, hernia, dysmenorrhea, irregular menstruation, amenorrhea, leucorrhea, prolapse of the uterus." ;
    tara:hasInnervationDescription "The iliohypogastric nerve." ;
    tara:hasLocationalDescription "On the lower abdomen, 4 B-cun inferior to the centre of the umbilicus, 2 B-cun lateral to the anterior median line. Note: ST29 is 4 B-cun inferior to ST25, 1 B-cun inferior to St28, 2 B-cun lateral to CV3." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.7-1.2 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Guilai" ;
    tara:hasRelatedLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSurfaceLocation ILX:0795303 ;
    tara:hasSynonym "S 29",
        "Stomach 29" ;
    tara:hasVasculatureDescription "Laterally, the inferior epigastric artery and vein." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6221269 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795303 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0007118 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ] .

tara:TARA_5884251 a owl:Class ;
    rdfs:label "ST 3" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 47. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "巨髎(髎)" ;
    tara:hasIndicationsDescription "Facial paralysis, eyelid twitch, epistaxis, toothache, swelling of lips and cheek." ;
    tara:hasInnervationDescription "The branches of the facial and infraorbital nerves." ;
    tara:hasLocationalDescription "On the face, directly inferior to the pupil, at the same level as the inferior border of the ala of the nose. Note: When looking straight ahead, ST3 is located at the intersection of the vertical line of the pupil and the horizontal line of the inferior border of the ala of the nose." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Juliao" ;
    tara:hasRelatedLocation UBERON:0001771,
        UBERON:0006906 ;
    tara:hasSurfaceLocation UBERON:0001456 ;
    tara:hasSynonym "S 3",
        "Stomach 3" ;
    tara:hasVasculatureDescription "The branches of the facial and infraorbital arteries and veins." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001456 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001771 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
