tara:TARA_6894093 a owl:Class ;
    rdfs:label "SP 2" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 70. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "大都(都)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_9857829 ;
    tara:hasIndicationsDescription "Abdominal distension, gastric pain, constipation, febrile diseases with anhidrosis." ;
    tara:hasInnervationDescription "The proper plantar digital nerve derived from the medial plantar nerve." ;
    tara:hasLocationalDescription "On the great toe, in the depression distal to the first metatarsophalangeal joint, at the border between the red and white flesh." ;
    tara:hasMeridian tara:TARA_4167850 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.1-0.3 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Dadu" ;
    tara:hasRelatedLocation UBERON:0007750 ;
    tara:hasSurfaceLocation UBERON:0003631 ;
    tara:hasSynonym "Spleen 2" ;
    tara:hasVasculatureDescription "The branches of the medial plantar artery and vein." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4167850 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_2478120 ],
