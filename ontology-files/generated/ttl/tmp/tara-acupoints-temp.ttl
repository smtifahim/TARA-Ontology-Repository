            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ] .

tara:TARA_3369897 a owl:Class ;
    rdfs:label "TE 1" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 158. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "關(关,関)衝(冲)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_2954517 ;
    tara:hasIndicationsDescription "Headache, redness of the eyes, sore throat, stiffness of the tongue, febrile diseases, irritability." ;
    tara:hasInnervationDescription "The palmar digital proprial nerve derived from the ulnar nerve." ;
    tara:hasLocationalDescription "On the ring finger, ulnar to the distal phalanx, 0.1 f-cun proximal to the ulnar corner of the fingernail, at the intersection of the vertical line of the ulnar side of the nail and the horizontal line of the base of the fingernail." ;
    tara:hasMeridian tara:TARA_3898257 ;
    tara:hasMethodDescription "Puncture superficially 0.1 inch, or prick with a three-edged needle to cause bleeding. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Guanchong" ;
    tara:hasRelatedLocation UBERON:0004300,
        UBERON:0011276 ;
    tara:hasSurfaceLocation UBERON:0003624 ;
    tara:hasSynonym "SJ 1",
        "San Jiao 1",
        "TB 1",
        "TH 1",
        "TW 1",
        "Triple Burner 1",
        "Triple Energizer 1",
        "Triple Heater 1",
        "Triple Warmer 1" ;
    tara:hasVasculatureDescription "The arterial and venous network formed by the palmar digital proprial artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0011276 ] ],
