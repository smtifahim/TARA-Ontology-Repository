tara:TARA_3549064 a owl:Class ;
    rdfs:label "GB 5" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 174. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "懸(悬)顱(颅)" ;
    tara:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara:hasIndicationsDescription "migraine, pain in the outer canthus, facial swelling." ;
    tara:hasLocationalDescription "On the head, at the midpoint of the curved line from St8 to gB7." ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Xuanlu" ;
    tara:hasSynonym "G 5",
        "Gallbladder 5" ;
    tara:hasVasculatureDescription "The parietal branches of the superficial temporal artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_5283975 ;
