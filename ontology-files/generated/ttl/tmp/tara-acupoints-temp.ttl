            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_9093316 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004300 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003625 ] ] .

tara:TARA_9191188 a owl:Class ;
    rdfs:label "GB 3" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 173. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "上關(关,関)" ;
    tara:hasIndicationsDescription "Headache, deafness, tinnitus, diplacusis, deviation of the eye and mouth, toothache." ;
    tara:hasInnervationDescription "The zygomatic branch of the facial nerve and the zygomaticofacial nerve." ;
    tara:hasLocationalDescription "On the head, in the depression superior to the midpoint of the zygomatic arch Note: In the depression superior to the zygomatic arch, superior to St7." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Deep puncture is not advisable. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Shangguan" ;
    tara:hasRelatedLocation UBERON:0002500 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "G 3",
        "Gallbladder 3" ;
    tara:hasVasculatureDescription "The zygomaticoorbital artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002500 ] ],
