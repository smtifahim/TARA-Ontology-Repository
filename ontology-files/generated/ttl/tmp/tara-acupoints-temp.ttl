tara:TARA_9907701 a owl:Class ;
    rdfs:label "Shiqizhui" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Lumbar Pain, thigh pain, paralysis of the lower extremities, irregular menstruation, dysmenorrhea." ;
    tara:hasLocationalDescription "Below the spinous process of the fifth lumbar vertebra." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara:hasSynonym "EX-B 8",
        "M-BW 25",
        "Shiqizhuixia" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_9921528 a owl:Class ;
    rdfs:label "CV 4" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 221. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "關(关,関)元" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_3092014 ;
    tara:hasIndicationsDescription "Enuresis, nocturnal emission, frequency of urination, retention of urine, hernia, irregular menstruation, morbid leukorrhea, dysmenorrhea, uterine bleeding, postpartum hemorrhage, lower abdominal pain, indigestion, diarrhea, prolapse of the rectum, flaccid type of apoplexy." ;
    tara:hasInnervationDescription "The medial branch of the anterior cutaneous branch of the twelfth intercostal nerve." ;
    tara:hasLocationalDescription "On the lower abdomen, 3 B-cun inferior to the centre of the umbilicus, on the anterior median line." ;
    tara:hasMeridian tara:TARA_6789717 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. This is one of the important points for tonification. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Guanyuan" ;
    tara:hasRelatedLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSurfaceLocation ILX:0795303 ;
    tara:hasSynonym "Conception Vessel 4",
        "Front-Mu Point of the Small Intestine",
        "RN 4",
        "Ren 4" ;
    tara:hasVasculatureDescription "See Zhongji (CV 3)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795303 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0007118 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6789717 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_5430806 ] .

tara:TARA_9927213 a owl:Class ;
    rdfs:label "BL 36" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 117. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "承扶" ;
    tara:hasIndicationsDescription "Pain in the lower back and gluteal region, constipation, muscular atrophy, pain, numbness and motor impairment of the lower extremities." ;
    tara:hasInnervationDescription "The posterior femoral cutaneous nerve; deeper, the sciatic nerve." ;
    tara:hasLocationalDescription "In the buttock region, at the midpoint of the gluteal fold." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 1.0-1.5 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Chengfu" ;
    tara:hasRelatedLocation UBERON:0036014 ;
    tara:hasSurfaceLocation UBERON:0013691 ;
    tara:hasSynonym "B 36",
        "Bladder 36",
        "UB 36",
        "Urinary Bladder 36" ;
    tara:hasVasculatureDescription "The artery and vein running alongside the sciatic nerve." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0036014 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0013691 ] ] .

tara:TARA_9927492 a owl:Class ;
    rdfs:label "BL 7" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 103. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "通(通)天" ;
    tara:hasIndicationsDescription "Headache, giddiness, nasal obstruction, epistaxis, rhinorrhea." ;
    tara:hasInnervationDescription "The branch of the great occipital nerve." ;
    tara:hasLocationalDescription "On the head, 4 B-cun superior to the anterior hairline, 1.5 B-cun lateral to the anterior median line. Note: Midway between BL6 and BL8." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Tongtian" ;
    tara:hasRelatedLocation ILX:0795285,
        ILX:0795292 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "B 7",
        "Bladder 7",
        "UB 7",
        "Urinary Bladder 7" ;
    tara:hasVasculatureDescription "The superficial temporal artery and vein and the occipital artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795292 ] ] .

tara:TARA_9946635 a owl:Class ;
    rdfs:label "ST 8" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 49. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "頭(头)維(维)" ;
    tara:hasIndicationsDescription "Headache, blurring of vision, ophthalmalgia, lacrimation." ;
    tara:hasInnervationDescription "The branch of the auriculotemporal nerve and the temporal branch of the facial nerve." ;
    tara:hasLocationalDescription "On the head, 0.5 B-cun directly superior to the anterior hairline at the corner of the forehead, 4.5 B-cun lateral to the anterior median line." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture 0.5-1.0 inch subcutaneously." ;
    tara:hasPinyinLabel "Touwei" ;
    tara:hasRelatedLocation UBERON:0008200,
        ILX:0795285,
        ILX:0795292 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "S 8",
        "Stomach 8" ;
    tara:hasVasculatureDescription "The frontal branches of the superficial temporal artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795292 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6221269 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0008200 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ] .

tara:TARA_9968219 a owl:Class ;
    rdfs:label "GB 38" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 190. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "陽(阳)輔(辅)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_7315457 ;
    tara:hasIndicationsDescription "Migraine, pain of the outer canthus, pain in the axillary region, scrofula, lumbar pain, pain in the chest, hypochondriac region and lateral aspect of the lower extremities, malaria." ;
    tara:hasLocationalDescription "On the fibular aspect of the leg, anterior to the fibula, 4 B-cun proximal to the prominence of the lateral malleolus." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Yangfu" ;
    tara:hasRelatedLocation UBERON:0001446,
        UBERON:0012291 ;
    tara:hasSurfaceLocation UBERON:0003823 ;
    tara:hasSynonym "G 38",
        "Gallbladder 38" ;
    tara:hasVasculatureDescription "See Guangming (GB 37)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001446 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003823 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_1758929 ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0012291 ] ] .

tara:TARA_9987270 a owl:Class ;
    rdfs:label "GB 14" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 178. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "陽(阳)白" ;
    tara:hasIndicationsDescription "Headache in the frontal region, pain of the orbital ridge, eye pain, vertigo, twitching of the eyelids, ptosis of the eyelids, lacrimation." ;
    tara:hasInnervationDescription "The lateral branch of the frontal nerve." ;
    tara:hasLocationalDescription "On the head, 1 B-cun superior to the eyebrow, directly superior to the centre of the pupil." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Yangbai" ;
    tara:hasRelatedLocation UBERON:0001771,
        UBERON:0010163 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "G 14",
        "Gallbladder 14" ;
    tara:hasVasculatureDescription "The lateral branches of the frontal artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001771 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0010163 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ] .

tara:acupoints.owl a owl:Ontology ;
    dc:contributor "Fahim T. Imam, PhD - https://orcid.org/0000-0003-4752-543X",
        "Ilias Ziogas, PhD - https://orcid.org/0000-0002-9210-2455",
        "Maryann E. Martone, PhD - https://orcid.org/0000-0002-8406-3871",
        "Richard Harris, PhD - https://orcid.org/0000-0002-2067-8447" ;
    dc:creator "Fahim T. Imam, PhD - https://orcid.org/0000-0003-4752-543X" ;
    dc:date "April 17, 2026" ;
    dc:description "The TARA Acupoints Ontology is an ontology developed as part of the Topological Atlas and Repository for Acupoint Research (TARA) project funded by the National Institute of Health (NIH). The goal of TARA is to establish a new comprehensive resource for the acupuncture research and clinician community. The ontology will be used to support semantic search and annotations for anatomical maps, atlases, and data sets relevant to the TARA project."@en ;
    dc:source "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. ISBN 978-7-119-01758-7.",
        "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7." ;
    dc:title "TARA Acupoints Ontology"@en ;
    rdfs:seeAlso "About TARA Ontology: https://purl.org/tara/ontology"@en,
        "About TARA Project: https://www.acupunctureresearch.org/tara"@en,
        "TARA Ontology GitHub Repo: https://purl.org/tara/ontology/repo"@en ;
    owl:priorVersion "1.0.0"^^rdfs:Literal ;
    owl:versionInfo "1.2.0"^^rdfs:Literal .

tara:hasAbbreviation a owl:AnnotationProperty ;
    rdfs:label "Abbreviation" ;
    rdfs:subPropertyOf IAO:0000118 .

tara:hasAcronym a owl:AnnotationProperty ;
    rdfs:label "Acronym" ;
    rdfs:subPropertyOf IAO:0000118 .

tara:hasAcupunctureModality a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasAuthor a owl:AnnotationProperty ;
    rdfs:label "Author" ;
    rdfs:subPropertyOf dc:creator .

tara:hasChineseLabel a owl:AnnotationProperty ;
    rdfs:label "Chinese Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara:hasControlsInformation a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasCountryInformation a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasDOI a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:identifier .

tara:hasDesignatedOrgan a owl:AnnotationProperty ;
    dc:description "An annotation property that relates an acupoint to the organ it is designated to affect according to traditional Chinese medicine theory (e.g., LU 1 is designated to the Lung). This designation reflects the organ affiliation defined by the meridian to which the acupoint belongs." ;
    rdfs:subPropertyOf tara:hasAcupointAnnotaionProperty .

tara:hasDesignatedSpecialPointRole a owl:AnnotationProperty ;
    rdfs:label "Special Point Role" ;
    dc:description "An annotation property that records the named special point role(s) designated to an acupoint as a textual annotation (e.g., LU 1 has the role Front-Mu Point of the Lung; LU 5 has the role He-Sea Point). For the structured object-property representation of this designation, see hasSpecialPointDesignation." ;
    rdfs:subPropertyOf tara:hasAcupointAnnotaionProperty .

tara:hasEnglishLabel a owl:AnnotationProperty ;
    rdfs:label "English Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara:hasFigureSource a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:source .

tara:hasIndicationsDescription a owl:AnnotationProperty ;
    rdfs:label "Indications" ;
    dc:description "An annotation property that lists the clinical conditions and symptoms for which an acupoint is indicated according to traditional Chinese medicine (e.g., LU 1: 'Cough, asthma, pain in the chest, shoulder and back; fullness of the chest.')." ;
    rdfs:subPropertyOf tara:hasAcupointDescription .

tara:hasInnervationDescription a owl:AnnotationProperty ;
    rdfs:label "Innervation" ;
    dc:description "An annotation property that describes the nerve supply in the vicinity of an acupoint relevant to safe needling (e.g., LU 1: 'The intermediate supraclavicular nerve, the branches of the anterior thoracic nerve, and the lateral cutaneous branch of the first intercostal nerve.')." ;
    rdfs:subPropertyOf tara:hasAcupointDescription .

tara:hasListedAcupointsUsed a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasLocationalDescription a owl:AnnotationProperty ;
    rdfs:label "Acupuncture Location" ;
    dc:description "An annotation property that provides the canonical textual description of an acupoint's anatomical location on the body surface (e.g., LU 1: 'On the anterior thoracic region, at the same level as the first intercostal space, lateral to the infraclavicular fossa, 6 B-cun lateral to the anterior median line.'). Values follow the WHO Standard Acupuncture Point Locations where available." ;
    rdfs:subPropertyOf tara:hasAcupointDescription .

tara:hasMemberAcupoint a owl:ObjectProperty ;
    dc:description "An object property that relates a meridian to an acupoint belonging to it (e.g., the Lung Meridian has member acupoints LU 1 through LU 11). It is the inverse of isMemberAcupointOf and is a sub-property of the RO relation 'has member' (RO:0002351)." ;
    rdfs:domain tara:TARA_7226516 ;
    rdfs:range tara:TARA_1132428 ;
    rdfs:subPropertyOf RO:0002351 ;
    owl:inverseOf tara:isMemberAcupointOf .

tara:hasMeridian a owl:AnnotationProperty ;
    rdfs:label "Meridian Membership" ;
    dc:description "An annotation property that relates an acupoint to the meridian it belongs to (e.g., LU 1 and LU 2 belong to the Lung Meridian). Each meridian acupoint is assigned to exactly one meridian." ;
    rdfs:domain tara:TARA_1132428 ;
    rdfs:range tara:TARA_7226516 ;
    rdfs:subPropertyOf tara:hasAcupointAnnotaionProperty .

tara:hasMethodDescription a owl:AnnotationProperty ;
    rdfs:label "Acupuncture Method" ;
    dc:description "An annotation property that describes the recommended needling method for an acupoint, including needle angle, depth, and applicability of moxibustion (e.g., LU 1: 'Puncture obliquely 0.5-0.8 cun towards the lateral aspect of the chest. To avoid injuring the lung, never puncture deeply towards the medial aspect. Moxibustion is applicable.')." ;
    rdfs:subPropertyOf tara:hasAcupointDescription .

tara:hasNeedlingInformation a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasPinyinLabel a owl:AnnotationProperty ;
    rdfs:label "Pinyin Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara:hasPublicationDate a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:date .

tara:hasPublicationVenue a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation .

tara:hasReference a owl:AnnotationProperty ;
    rdfs:label "Reference" ;
    rdfs:subPropertyOf dcterms:bibliographicCitation .

tara:hasRelatedLocation a owl:AnnotationProperty ;
    rdfs:label "Specific Body Region" ;
    dc:description "An annotation property that relates an acupoint to one or more specific anatomical structures within the general body region identified by hasSurfaceLocation. It provides a finer-grained localization of the acupoint (e.g., LU 1 is related to the First Intercostal Space, Infraclavicular Fossa, and Anterior Median Line, all within the Anterior Thoracic Region identified by hasSurfaceLocation)." ;
    rdfs:subPropertyOf tara:hasAcupointLocation .

tara:hasSampleSizeInformation a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasStimulationType a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasStudiedCondition a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasStudiedConditionContext a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasStudiedConditionNote a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasSurfaceLocation a owl:AnnotationProperty ;
    rdfs:label "General Body Region" ;
    dc:description "An annotation property that relates an acupoint to the general body region on whose surface it is located. It provides a coarse-grained anatomical grouping for the acupoint (e.g., LU 1 is located on the Anterior Thoracic Region). This property is used together with hasRelatedLocation, which further specifies the particular anatomical structures within this general region." ;
    rdfs:subPropertyOf tara:hasAcupointLocation .

tara:hasSynonym a owl:AnnotationProperty ;
    rdfs:label "Synonym" ;
    rdfs:subPropertyOf IAO:0000118 .

tara:hasTrialType a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasUsedAcupoint a owl:AnnotationProperty ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

tara:hasVasculatureDescription a owl:AnnotationProperty ;
    rdfs:label "Vasculature" ;
    dc:description "An annotation property that describes the blood vessels in the vicinity of an acupoint relevant to safe needling (e.g., LU 1: 'Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein.')." ;
    rdfs:subPropertyOf tara:hasAcupointDescription .

tara:isStudiedInArticle a owl:AnnotationProperty ;
    rdfs:domain tara:TARA_1132428 ;
    rdfs:subPropertyOf tara:hasAcupunctureSpecificMetadata .

OboInOwl:creation_date a owl:AnnotationProperty .

