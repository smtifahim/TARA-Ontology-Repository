tara:TARA_8257616 a owl:Class ;
    rdfs:label "TE 12" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 163. https://iris.who.int/handle/10665/353407",
