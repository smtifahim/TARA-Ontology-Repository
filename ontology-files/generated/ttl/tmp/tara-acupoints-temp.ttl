tara:TARA_5660399 a owl:Class ;
    rdfs:label "Erjian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasIndicationsDescription "Redness, swelling and pain of the eyes, febrile disease, nebula." ;
    tara:hasLocationalDescription "Fold the auricle, the point is at the apex of the auricle." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.1-0.2 inch or prick to cause bleeding." ;
    tara:hasSynonym "EX-HN 6",
        "M-HN 10" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_5677319 a owl:Class ;
    rdfs:label "LI 5" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 36. https://iris.who.int/handle/10665/353407",
