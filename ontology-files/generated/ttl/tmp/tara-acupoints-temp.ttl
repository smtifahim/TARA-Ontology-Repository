    tara:hasSpecificSurfaceLocation UBERON:0006633,
        ILX:0795284,
        ILX:0795285,
        ILX:0795286 ;
    tara:hasSynonym "L 2",
        "Lung 2" ;
    tara:hasVasculatureDescription "The cephalic vein, the thoracoacromial artery and vein; inferiorly, the axillary artery." ;
