tara:TARA_7532145 a owl:Class ;
    rdfs:label "Lanweixue" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasIndicationsDescription "Acute and chronic appendicitis, indigestion, paralysis of the lower extremities." ;
    tara:hasLocationalDescription "The tender spot about 2 cun below Zusanli (ST 36)." ;
    tara:hasMethodDescription "Puncture perpendicularly 1.0-1.2 inches." ;
    tara:hasSynonym "EX-LE 7",
        "M-LE 13" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_7584875 a owl:Class ;
    rdfs:label "Yaotongxue" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasIndicationsDescription "Acute lumbar sprain" ;
    tara:hasLocationalDescription "On the dorsum of the hand, midway between the transverse wrist crease and metacarpophalangeal joint, between the second and third metacarpal bones, and between the fourth and fifth metacarpal bones, four points in all on both hands." ;
    tara:hasMethodDescription "Puncture obliquely 0.5-1.0 inch toward the centre of metacarpus from both sides." ;
    tara:hasSynonym "EX-UE 7" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_7589061 a owl:Class ;
    rdfs:label "GV 18" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 212. https://iris.who.int/handle/10665/353407",
