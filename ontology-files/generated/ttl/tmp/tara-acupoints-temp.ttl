tara:TARA_1055536 a owl:Class ;
    rdfs:label "SP 21" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 80. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "大包(包)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_3779268 ;
    tara:hasIndicationsDescription "Pain in the chest and hypochondriac region, asthma, general aching and weakness." ;
    tara:hasInnervationDescription "The seventh intercostal nerve and the terminal branch of the long thoracic nerve." ;
    tara:hasLocationalDescription "In the lateral thoracic region, in the sixth intercostal space, on the midaxillary line. Note: With the subject lying on the side and the arm abducted, SP21 is located at the intersection of the midaxillary line and the sixth intercostal space." ;
    tara:hasMeridian tara:TARA_4167850 ;
    tara:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Dabao" ;
