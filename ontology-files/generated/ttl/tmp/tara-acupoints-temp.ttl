                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom tara:TARA_3898257 ] ) ] .

tara:TARA_8876563 a owl:Class ;
    rdfs:label "CV 24" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 231. https://iris.who.int/handle/10665/353407",
