tara:TARA_0228386 a owl:Class ;
    rdfs:label "TE 18" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 166. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "瘈脈(脉)" ;
    tara:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara:hasIndicationsDescription "headache, tinnitus, deafness, infantile convulsion." ;
    tara:hasInnervationDescription "The posterior auricular branch of the great auricular nerve." ;
    tara:hasLocationalDescription "On the head, at the centre of the mastoid process, at the junction of the upper two thirds and lower one third of the curved line from tE17 to tE20." ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch or prick with a three-edged needle to cause bleeding. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Chimai",
        "Qimai" ;
    tara:hasSpecificSurfaceLocation UBERON:0011220 ;
    tara:hasSynonym "SJ 18",
        "San Jiao 18",
        "TB 18",
        "TH 18",
        "TW 18",
        "Triple Burner 18",
        "Triple Energizer 18",
        "Triple Heater 18",
        "Triple Warmer 18" ;
    tara:hasVasculatureDescription "The posterior auricular artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_3898257 ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom tara:TARA_3898257 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0011220 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ] .

tara:TARA_0242146 a owl:Class ;
    rdfs:label "BL 10" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 104. https://iris.who.int/handle/10665/353407",
