    tara:hasRelatedVein UBERON:0006200 ;
    tara:hasSpecificSurfaceLocation UBERON:0002497,
        UBERON:0011187 ;
    tara:hasSynonym "CO 15",
        "Colon 15",
        "Large Intestine 15" ;
    tara:hasVasculatureDescription "The posterior circumflex artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_4610474 ;
