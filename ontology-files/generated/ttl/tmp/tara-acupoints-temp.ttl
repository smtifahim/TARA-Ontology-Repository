        "Bladder 14",
        "UB 14",
        "Urinary Bladder 14" ;
    tara:hasVasculatureDescription "The medial cutaneous branches of the posterior branches of the intercostal artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_7525476 ;
