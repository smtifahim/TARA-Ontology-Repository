        "TH 7",
        "TW 7",
        "Triple Burner 7",
        "Triple Energizer 7",
        "Triple Heater 7",
        "Triple Warmer 7" ;
    tara:hasVasculatureDescription "The posterior antebrachial interosseous artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
