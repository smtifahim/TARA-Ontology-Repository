                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ] .

tara:TARA_2260472 a owl:Class ;
    rdfs:label "ST 45" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 68. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "厲(厉)兌(兑)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_2954517 ;
    tara:hasIndicationsDescription "Facial swelling, deviation of the mouth, epistaxis, toothache, sore throat and hoarse voice, abdominal distension, coldness in the leg and foot, febrile diseases, dream-disturbed sleep, mania." ;
    tara:hasInnervationDescription "The dorsal digital nerve derived from the superficial peroneal nerve." ;
    tara:hasLocationalDescription "On the second toe, lateral to the distal phalanx, 0.1 f-cun proximal-lateral to the lateral corner of the second toenail, at the intersection of the vertical line of the lateral border and the horizontal line of the base of the second toenail." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.1 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Lidui" ;
    tara:hasRelatedLocation UBERON:0004300,
        UBERON:0011279 ;
    tara:hasSurfaceLocation UBERON:0003632 ;
    tara:hasSynonym "S 45",
        "Stomach 45" ;
    tara:hasVasculatureDescription "The arterial and venous network formed by the dorsal digital artery and vein of foot." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004300 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0011279 ] ],
