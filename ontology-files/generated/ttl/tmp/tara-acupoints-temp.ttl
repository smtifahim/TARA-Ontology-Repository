                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom tara:TARA_3898257 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795319 ] ] .

tara:TARA_5850983 a owl:Class ;
    rdfs:label "Sifeng" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasIndicationsDescription "Malnutrition and indigestion syndrome in children, whooping cough." ;
    tara:hasLocationalDescription "On the palmar surface, in the midpoint of the transverse creases of the proximal interphalangeal joints of the index, middle, ring and little fingers." ;
    tara:hasMethodDescription "Prick to cause bleeding, or squeeze out a small amount of yellowish viscous fluid locally." ;
    tara:hasSynonym "EX-UE 10",
        "M-UE 9" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_5859631 a owl:Class ;
    rdfs:label "SI 8" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 91. https://iris.who.int/handle/10665/353407",
