tara:TARA_0780558 a owl:Class ;
    rdfs:label "LR 5" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 198. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "蠡溝(沟)" ;
    tara:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara:hasIndicationsDescription "retention of urine, enuresis, hernia, irregular menstruation, leukorrhea, pruritus vulvae, weakness and atrophy of the leg." ;
    tara:hasInnervationDescription "The branch of the saphenous nerve." ;
    tara:hasLocationalDescription "On the anteromedial aspect of the leg, at the centre of the medial border (surface) of the tibia, 5 B-cun proximal to the prominence of the medial malleolus. Note: LR5 is located at the same level as the upper two thirds and lower one third of the line connecting the apex of the patella with the prominence of the medial malleolus, at the centre of the medial border (surface) of the tibia, at the same level as KI9." ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Ligou" ;
    tara:hasSpecialPointRole tara:TARA_6993030 ;
    tara:hasSpecificSurfaceLocation UBERON:0000979,
        UBERON:0002446,
        ILX:0795305 ;
    tara:hasSynonym "LIV 5",
        "LV 5",
        "Liver 5" ;
    tara:hasVasculatureDescription "Posteriorly, the great saphenous vein." ;
    tara:isLocatedOnMeridian tara:TARA_5419503 ;
