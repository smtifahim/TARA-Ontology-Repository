tara:TARA_0471803 a owl:Class ;
    rdfs:label "BL 64" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 131. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "京骨(骨)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_1840369 ;
    tara:hasIndicationsDescription "Headache, neck rigidity, pain in the lower back and thigh, epilepsy." ;
    tara:hasLocationalDescription "On the lateral aspect of the foot, distal to the tuberosity of the fifth metatarsal bone, at the border between the red and white flesh. Note: The tuberosity of the fifth metatarsal bone is located approximately midway be- tween the heel and the fifth metatarsophalangeal joint." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Jinggu" ;
    tara:hasRelatedLocation UBERON:0003654,
        UBERON:0007762 ;
    tara:hasSurfaceLocation UBERON:0002387 ;
    tara:hasSynonym "B 64",
        "Bladder 64",
        "UB 64",
        "Urinary Bladder 64" ;
    tara:hasVasculatureDescription "See Jinmen (BL 63)." ;
