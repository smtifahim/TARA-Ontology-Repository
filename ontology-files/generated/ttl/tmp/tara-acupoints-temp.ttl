tara:TARA_0411625 a owl:Class ;
    rdfs:label "CV 7" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 223. ISBN 978-92-9061-248-7.

