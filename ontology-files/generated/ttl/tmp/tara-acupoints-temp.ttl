tara:TARA_0307907 a owl:Class ;
    rdfs:label "GB 9" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 176. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "天衝(冲)" ;
    tara:hasIndicationsDescription "Headache, epilepsy, swelling and pain of the gums, convulsion." ;
    tara:hasInnervationDescription "The branch of the great occipital nerve." ;
    tara:hasLocationalDescription "On the head, directly superior to the posterior border of the auricular root, 2 B-cun superior to the hairline. Note: GB9 is 0.5 B-cun posterior to GB8." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch." ;
    tara:hasPinyinLabel "Tianchong" ;
    tara:hasRelatedLocation UBERON:0004104 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "G 9",
        "Gallbladder 9" ;
    tara:hasVasculatureDescription "The posterior auricular artery and vein." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004104 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ] .

tara:TARA_0316650 a owl:Class ;
    rdfs:label "GB 6" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 174. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
