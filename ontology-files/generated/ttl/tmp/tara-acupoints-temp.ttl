    tara:hasSynonym "B 41",
        "Bladder 41",
        "UB 41",
        "Urinary Bladder 41" ;
    tara:hasVasculatureDescription "The descending branch of the transverse cervical artery, the posterior branches of the intercostal artery and vein." ;
