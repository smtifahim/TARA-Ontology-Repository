            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003624 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004300 ] ] .

tara:TARA_3386254 a owl:Class ;
    rdfs:label "GV 20" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 213. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "百會(会)" ;
    tara:hasIndicationsDescription "Headache, vertigo, tinnitus, nasal obstruction, aphasia by apoplexy, coma, mental disorders, prolapse of the rectum and the uterus." ;
    tara:hasInnervationDescription "The branch of the great occipital nerve." ;
    tara:hasLocationalDescription "On the head, 5 B-cun superior to the ante- rior hairline, on the anterior median line. Note 1: GV20 is located in the depression 1 B-cun anterior to the midpoint of the line from the anterior hairline to the posterior hairline. Note 2: When the ears are folded, GV 20 is located at the midpoint of the connecting line between the auricular apices." ;
    tara:hasMeridian tara:TARA_0386099 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Baihui" ;
    tara:hasRelatedLocation ILX:0795285,
        ILX:0795292,
        ILX:0795326 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "Du 20",
        "Governor Vessel 20" ;
    tara:hasVasculatureDescription "The anastomotic network formed by the superficial temporal arteries and veins and the occipital arteries and veins on both sides." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_0386099 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795326 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
