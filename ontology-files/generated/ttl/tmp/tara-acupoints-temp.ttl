tara:TARA_0674193 a owl:Class ;
    rdfs:label "Pigen" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Hepatosplenomegaly, lumbar pain." ;
    tara:hasLocationalDescription "3.5 cun lateral to the lower border of the spinous process of the first lumbar vertebra." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara:hasSynonym "EX-B 4",
        "M-BW 16" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_0683404 a owl:Class ;
    rdfs:label "SI 10" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 92. ISBN 978-92-9061-248-7.

