        UBERON:0004611,
        ILX:0795323 ;
    tara:hasSurfaceLocation UBERON:0000916 ;
    tara:hasSynonym "Front-Mu Point of the Kidney",
        "G 25",
        "Gallbladder 25" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ],
