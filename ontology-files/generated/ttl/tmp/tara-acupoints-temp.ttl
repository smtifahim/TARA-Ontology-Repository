tara:TARA_4325595 a owl:Class ;
    rdfs:label "LR 4" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 197. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "中封" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_7315457 ;
    tara:hasIndicationsDescription "Hernia, pain in the external genitalia, nocturnal emission, retention of urine, distending pain in the hy pochondrium." ;
    tara:hasInnervationDescription "The branch of the medial dorsal cutaneous nerve of the foot and the saphenous nerve." ;
    tara:hasLocationalDescription "On the anteromedial aspect of the ankle, in the depression medial to the tibialis anterior tendon, anterior to the medial malleolus. Note: LR4 is located midway between SP5 and St41." ;
    tara:hasMeridian tara:TARA_5419503 ;
    tara:hasMethodDescription "Puncture perpendicularl 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Zhongfeng" ;
    tara:hasRelatedLocation ILX:0795305,
        ILX:0795325 ;
    tara:hasSurfaceLocation UBERON:0004454 ;
    tara:hasSynonym "LIV 4",
        "LV 4",
        "Liver 4" ;
    tara:hasVasculatureDescription "The dorsal venous ne work of the foot and the anterior medial malleolar artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795305 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004454 ] ],
        [ a owl:Class ;
