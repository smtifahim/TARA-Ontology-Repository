tara:TARA_9254368 a owl:Class ;
    rdfs:label "GB 40" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 191. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "丘(坵)墟(墟)" ;
    tara:hasGeneralSurfaceLocation UBERON:0004454 ;
    tara:hasIndicationsDescription "pain in the neck, swelling in the axillary region, pain in the hypochondriac region, vomiting, acid regurgitation, muscular atrophy of the lower limbs, pain and swelling of the external malleolus, malaria." ;
    tara:hasInnervationDescription "The branches of the intermediate dorsal cutaneous nerve and superficial peroneal nerve." ;
    tara:hasLocationalDescription "On the anterolateral aspect of the ankle, in the depression lateral to the extensor digitorum longus tendon, anterior and distal to the lateral malleolus. Note: GB40 is easier to locate by finding the extensor digitorum longus tendon when the second to fifth toes are extended against resistance." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Qiuxu" ;
    tara:hasSpecialPointRole tara:TARA_1840369 ;
    tara:hasSpecificSurfaceLocation UBERON:0012291,
        ILX:0795504 ;
    tara:hasSynonym "G 40",
        "Gallbladder 40" ;
    tara:hasVasculatureDescription "The branch of the anterolateral malleolar artery." ;
    tara:isLocatedOnMeridian tara:TARA_5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0012291 ] ],
