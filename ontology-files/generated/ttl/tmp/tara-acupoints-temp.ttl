tara:TARA_2465151 a owl:Class ;
    rdfs:label "BL 31" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 115. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "上髎(髎)" ;
    tara:hasIndicationsDescription "Low back pain, dysuria, constipation, irregular menstruation, morbid leukorrhea, prolapse of the uterus." ;
    tara:hasInnervationDescription "At the site where the posterior ramus of the first sacral nerve passes." ;
    tara:hasLocationalDescription "In the sacral region, in the first posterior sacral foramen. Note: The first posterior sacral foramen is palpated in the depression, moving superiorly from BL32." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Shangliao" ;
    tara:hasRelatedLocation ILX:0795313 ;
    tara:hasSurfaceLocation UBERON:0005473 ;
    tara:hasSynonym "B 31",
        "Bladder 31",
        "UB 31",
        "Urinary Bladder 31" ;
    tara:hasVasculatureDescription "The posterior branches of the lateral sacral artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795313 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0005473 ] ] .

tara:TARA_2491709 a owl:Class ;
    rdfs:label "Baxie" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Excessive heat, finger numbness, spasm and contracture of the fingers, redness and swelling of the dorsum of the hand." ;
    tara:hasLocationalDescription "On the dorsum of the hand, at the junction of the white and red skin of the hand webs, eight in all, making a loose fist to locate the points." ;
    tara:hasMethodDescription "Puncture obliquely 0.3-0.5 inch, or prick to cause bleeding. Moxibustion is applicable." ;
    tara:hasSynonym "EX-UE 9",
        "M-UE 22" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_2542400 a owl:Class ;
    rdfs:label "ST 20" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 55. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "承滿(满,満)" ;
    tara:hasIndicationsDescription "Gastric pain, abdominal distension, vomiting, anorexia." ;
    tara:hasLocationalDescription "On the upper abdomen, 5 B-cun superior to the centre of the umbilicus, 2 B-cun lateral to the anterior median line. Note: ST20 is 5 B-cun superior to ST25, 1 B-cun inferior to St19, 2 B-cun lateral to CV13." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasPinyinLabel "Chengman" ;
    tara:hasRelatedLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSurfaceLocation ILX:0795301 ;
    tara:hasSynonym "S 20",
        "Stomach 20" ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6221269 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795301 ] ],
