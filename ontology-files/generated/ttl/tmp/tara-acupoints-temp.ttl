tara:TARA_1282828 a owl:Class ;
    rdfs:label "HT 5" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 84. ISBN 978-92-9061-248-7.

