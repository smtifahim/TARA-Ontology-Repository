        "TB 4",
        "TH 4",
        "TW 4",
        "Triple Burner 4",
        "Triple Energizer 4",
        "Triple Heater 4",
        "Triple Warmer 4" ;
    tara:hasVasculatureDescription "The dorsal venous network of the wrist and the posterior carpal artery." ;
    tara:isLocatedOnMeridian tara:TARA_3898257 ;
