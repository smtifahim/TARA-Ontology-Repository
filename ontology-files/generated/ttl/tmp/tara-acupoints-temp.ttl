    tara:hasSurfaceLocation UBERON:0000916 ;
    tara:hasSynonym "Front-Mu Point of the Spleen",
        "Influential Point of Zang Organs",
        "LIV 13",
        "LV 13",
        "Liver 13" ;
    tara:hasVasculatureDescription "The terminal branch of the tenth intercostal artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
