tara:TARA_8854888 a owl:Class ;
    rdfs:label "TE 20" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 167. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "角孫(孙)" ;
    tara:hasIndicationsDescription "Tinnitus, redness, pain and swelling of the eye, swelling of gum, toothache, parotitis." ;
    tara:hasLocationalDescription "On the head, just superior to the auricular apex. Note: With the auricle folded forward and pressed against the head, the point is located where the auricular apex touches the head." ;
    tara:hasMeridian tara:TARA_3898257 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Jiaosun" ;
    tara:hasRelatedLocation UBERON:0001690 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "SJ 20",
        "San Jiao 20",
        "TB 20",
        "TH 20",
        "TW 20",
        "Triple Burner 20",
        "Triple Energizer 20",
        "Triple Heater 20",
        "Triple Warmer 20" ;
    tara:hasVasculatureDescription "The branches of the superficial temporal artery and vein. Innervation: The branches of the auriculotemporal nerve." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001690 ] ],
