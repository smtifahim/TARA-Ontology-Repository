tara:TARA_2186848 a owl:Class ;
    rdfs:label "BL 39" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 119. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "委陽(阳)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_1160697 ;
    tara:hasIndicationsDescription "Stiffness and pain of the lower back, distension and fullness of the lower abdomen, edema, dysuria, cramp of the leg and foot." ;
    tara:hasLocationalDescription "On the posterolateral aspect of the knee, just medial to the biceps femoris tendon in the popliteal crease. Note: The biceps femoris tendon is more prominent when the knee is slightly flexed." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Weiyang" ;
    tara:hasRelatedLocation ILX:0795317,
        ILX:0795330 ;
    tara:hasSurfaceLocation UBERON:0001465 ;
    tara:hasSynonym "B 39",
        "Bladder 39",
        "Lower He-Sea Point of Triple Energizer",
        "UB 39",
        "Urinary Bladder 39" ;
    tara:hasVasculatureDescription "See Fuxi (BL 38)" ;
    rdfs:subClassOf [ a owl:Restriction ;
