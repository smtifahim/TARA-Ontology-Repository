tara:TARA_0488267 a owl:Class ;
    rdfs:label "BL 54" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 126. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "秩邊(边,辺)" ;
    tara:hasIndicationsDescription "Pain in the lumbosacral region, muscular atrophy, motor impairment of the lower extremities, dysuria, swelling around external genitalia, hemorrhoids, constipation." ;
    tara:hasInnervationDescription "The inferior gluteal nerve, the posterior femoral cutaneous nerve and the sciatic nerve." ;
    tara:hasLocationalDescription "In the buttock region, at the same level as the fourth posterior sacral foramen, 3 B-cun lateral to the median sacral crest. Note: 3 B-cun lateral to the sacral hiatus, at the same level as BL 30." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 1.5-2.0 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Zhibian" ;
    tara:hasRelatedLocation ILX:0741680,
        ILX:0741717,
        ILX:0795316 ;
    tara:hasSurfaceLocation UBERON:0013691 ;
    tara:hasSynonym "B 54",
        "Bladder 54",
        "UB 54",
        "Urinary Bladder 54" ;
    tara:hasVasculatureDescription "The inferior gluteal artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0013691 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795316 ] ],
