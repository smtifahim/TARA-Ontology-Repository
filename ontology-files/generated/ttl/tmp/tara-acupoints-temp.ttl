tara:TARA_8440155 a owl:Class ;
    rdfs:label "ST 44" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 68. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "内庭" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_9857829 ;
    tara:hasIndicationsDescription "Toothache, pain in the face, deviation of the mouth, sore throat, epistaxis, gastric pain, acid regurgitation, abdominal distension, diarrhea, dysentery, constipation, swelling and pain of the dorsum of the foot, febrile diseases." ;
    tara:hasInnervationDescription "Just where the lateral branch of the medial dorsal cutaneous nerve divides into dorsal digital nerves." ;
    tara:hasLocationalDescription "On the dorsum of the foot, between the second and third toes, posterior to the web margin, at the border between the red and white flesh." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Neiting" ;
    tara:hasRelatedLocation UBERON:0003632,
        UBERON:0003633 ;
    tara:hasSurfaceLocation UBERON:0002387 ;
    tara:hasSynonym "S 44",
        "Stomach 44" ;
    tara:hasVasculatureDescription "The dorsal venous network of foot." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003632 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_2478120 ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003633 ] ],
