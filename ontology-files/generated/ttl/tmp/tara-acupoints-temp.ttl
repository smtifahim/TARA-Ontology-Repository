tara:TARA_8854888 a owl:Class ;
    rdfs:label "TE 20" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 167. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "角孫(孙)" ;
    tara:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara:hasIndicationsDescription "tinnitus, redness, pain and swelling of the eye, swelling of the gums, toothache, parotitis." ;
    tara:hasLocationalDescription "On the head, just superior to the auricular apex. Note: With the auricle folded forward and pressed against the head, the point is located where the auricular apex touches the head." ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Jiaosun" ;
    tara:hasSpecificSurfaceLocation UBERON:0001690 ;
    tara:hasSynonym "SJ 20",
        "San Jiao 20",
        "TB 20",
        "TH 20",
        "TW 20",
        "Triple Burner 20",
        "Triple Energizer 20",
        "Triple Heater 20",
        "Triple Warmer 20" ;
    tara:hasVasculatureDescription "The branches of the superficial temporal artery and vein. Innervation: The branches of the auriculotemporal nerve." ;
    tara:isLocatedOnMeridian tara:TARA_3898257 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
