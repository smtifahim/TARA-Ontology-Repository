tara:TARA_5264783 a owl:Class ;
    rdfs:label "GB 31" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 187. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "風(风)市" ;
    tara:hasGeneralSurfaceLocation UBERON:0000376 ;
    tara:hasIndicationsDescription "pain and soreness in the thigh and lumbar region, paralysis of the lower limbs, beriberi, general pruritus." ;
    tara:hasInnervationDescription "The lateral femoral cutaneous nerve, the muscular branch of the femoral nerve." ;
    tara:hasLocationalDescription "On the lateral aspect of the thigh, in the depression posterior to the iliotibial band where the tip of the middle finger rests, when standing up with the arms hanging alongside the thigh. Note: GB31 is located by first finding the iliotibial band when the knee is slightly flexed and the hip is abducted against resis- tance." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.7-1.2 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Fengshi" ;
    tara:hasSpecificSurfaceLocation ILX:0795324 ;
    tara:hasSynonym "G 31",
        "Gallbladder 31" ;
    tara:hasVasculatureDescription "The muscular branches of the lateral circumflex femoral artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
