    tara:hasSurfaceLocation UBERON:0008231 ;
    tara:hasSynonym "B 49",
        "Bladder 49",
        "UB 49",
        "Urinary Bladder 49" ;
    tara:hasVasculatureDescription "The posterior branches of the intercostal artery and vein." ;
