tara:TARA_8423766 a owl:Class ;
    rdfs:label "BL 53" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 126. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "胞(胞)肓" ;
    tara:hasIndicationsDescription "Borborygmus, abdominal distension, pain in the lower back, anuria." ;
    tara:hasInnervationDescription "The superior cluneal nerves; deeper, the superior gluteal nerve." ;
    tara:hasLocationalDescription "In the buttock region, at the same level as the second posterior sacral foramen, 3 B-cun lateral to the median sacral crest. Note: BL53, BL28 and BL32 are located at the same level as the second posterior sacral foramen." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Baohuang" ;
    tara:hasRelatedLocation ILX:0741680,
        ILX:0795314 ;
    tara:hasSurfaceLocation UBERON:0013691 ;
    tara:hasSynonym "B 53",
        "Bladder 53",
        "UB 53",
        "Urinary Bladder 53" ;
    tara:hasVasculatureDescription "The superior gluteal artery and vein." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0013691 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0741680 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795314 ] ] .

tara:TARA_8433932 a owl:Class ;
    rdfs:label "SP 10" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 74. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "血海(海)" ;
    tara:hasIndicationsDescription "Irregular menstruation, dysmenorrhea, uterine bleeding, amenorrhea, urticaria, eczema, erysipelas, pain in the medial aspect of the thigh." ;
    tara:hasInnervationDescription "The anterior femoral cutaneous nerve and the muscular branch of the femoral nerve." ;
    tara:hasLocationalDescription "On the anteromedial aspect of the thigh, on the bulge of the vastus medialis muscle, 2 B-cun superior to the medial end of the base of the patella." ;
    tara:hasMeridian tara:TARA_4167850 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.2 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Xuehai" ;
    tara:hasRelatedLocation UBERON:0001380,
        UBERON:0002446 ;
    tara:hasSurfaceLocation UBERON:0000376 ;
    tara:hasSynonym "Spleen 10" ;
    tara:hasVasculatureDescription "The muscular branches of the femoral artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001380 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000376 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002446 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4167850 ] ) ] .

tara:TARA_8435800 a owl:Class ;
    rdfs:label "BL 63" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 131. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "金門(门)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_4598552 ;
    tara:hasIndicationsDescription "Mania, epilepsy, infantile convulsion, backache, pain the external malleolus, motor impairment and pain of the lower extremities." ;
    tara:hasInnervationDescription "The lateral dorsal cutaneous nerve of foot; deeper, the lateral plantar nerve." ;
    tara:hasLocationalDescription "On the dorsum of the foot, distal to the anterior border of the lateral malleolus, posterior to the tuberosity of the fifth metatarsal bone, in the depression inferior to the cuboid bone." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Jinmen" ;
    tara:hasRelatedLocation UBERON:0001455,
        UBERON:0003654,
        UBERON:0012291 ;
    tara:hasSurfaceLocation UBERON:0002387 ;
    tara:hasSynonym "B 63",
        "Bladder 63",
        "UB 63",
        "Urinary Bladder 63" ;
    tara:hasVasculatureDescription "The lateral plantar artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001455 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
