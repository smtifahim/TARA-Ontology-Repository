tara:TARA_5246417 a owl:Class ;
    rdfs:label "SI 16" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 95. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "天窗(窓)" ;
    tara:hasIndicationsDescription "Sore throat, sudden loss of voice, deafness, tinnitus, stiffness and pain of the neck." ;
    tara:hasInnervationDescription "The cutaneous cervical nerve, the emerging portion of the great auricular nerve." ;
    tara:hasLocationalDescription "In the anterior region of the neck, posterior to the sternocleidomastoid muscle, at the same level as the superior border of the thyroid cartilage. Note 1: The sternocleidomastoid muscle is more distinct when the head is turned to the opposite side against resistance. Note 2: SI16 is located at the same level as St9, LI18 and the superior border of the thyroid cartilage. St9 is located anterior to the sternocleidomastoid muscle, SI16, posterior to the sternocleidomastoid muscle and LI18, midway between the anterior and posterior borders of the sternocleidomastoid muscle." ;
    tara:hasMeridian tara:TARA_9093316 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.7 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Tianchuang" ;
    tara:hasRelatedLocation UBERON:0001128,
        UBERON:0001738 ;
    tara:hasSurfaceLocation UBERON:0000974 ;
    tara:hasSynonym "Small Intestine 16" ;
    tara:hasVasculatureDescription "The ascending cervical artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001128 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_9093316 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001738 ] ] .

tara:TARA_5264783 a owl:Class ;
    rdfs:label "GB 31" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 187. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "風(风)市" ;
    tara:hasIndicationsDescription "Pain and soreness in the thigh and lumbar region, paralysis of the lower limbs, beriberi, general pruritus." ;
    tara:hasInnervationDescription "The lateral femoral cutaneous nerve, the muscular branch of the femoral nerve." ;
    tara:hasLocationalDescription "On the lateral aspect of the thigh, in the depression posterior to the iliotibial band where the tip of the middle finger rests, when standing up with the arms hanging alongside the thigh. Note: GB31 is located by first finding the iliotibial band when the knee is slightly flexed and the hip is abducted against resis- tance." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.7-1.2 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Fengshi" ;
    tara:hasRelatedLocation ILX:0795324 ;
    tara:hasSurfaceLocation UBERON:0000376 ;
    tara:hasSynonym "G 31",
        "Gallbladder 31" ;
    tara:hasVasculatureDescription "The muscular branches of the lateral circumflex femoral artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000376 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795324 ] ] .

tara:TARA_5282844 a owl:Class ;
    rdfs:label "Acupoint of the Stomach Meridian" ;
    dc:description "An acupuncture point that is located along the Stomach Meridian of Foot-Yangming (ST), which consists of 45 standardized acupoints beginning at ST 1 (Chengqi) on the face between the eyeball and the infraorbital margin directly below the pupil, traveling down across the face, neck, chest, and abdomen and continuing along the anterior-lateral aspect of the leg, and ending at ST 45 (Lidui) on the lateral side of the second toe near the corner of the nail." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasSynonym "Acupoint of the stomach meridian of foot-yangming",
        "Acupuncture point of the stomach meridian",
        "Acupuncture point of the stomach meridian of foot-yangming",
        "ST" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6221269 ] ) ] .

tara:TARA_5290080 a owl:Class ;
    rdfs:label "BL 40" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 119. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "委中" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_6594221 ;
    tara:hasIndicationsDescription "Low back pain, motor impairment of the hip joint, contracture of the tendons in the popliteal fossa, muscular atrophy, pain, numbness and motor impairment of the lower extremities, hemiplegia, abdominal pain, vomiting, diarrhea, erysipelas." ;
    tara:hasInnervationDescription "The posterior femoral cutaneous nerve, the tibial nerve." ;
    tara:hasLocationalDescription "On the posterior aspect of the knee, at the midpoint of the popliteal crease." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch, or prick the popliteal vein with three-edged needle to cause bleedmg." ;
    tara:hasPinyinLabel "Weizhong" ;
    tara:hasRelatedLocation ILX:0795330 ;
    tara:hasSurfaceLocation UBERON:0001465 ;
    tara:hasSynonym "B 40",
        "Bladder 40",
        "UB 40",
        "Urinary Bladder 40" ;
    tara:hasVasculatureDescription "Superficially, the femoro-popliteal vein; deeper and medially, the popliteal vein; deepest, the popliteal artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_4109407 ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001465 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795330 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ] .

tara:TARA_5309570 a owl:Class ;
    rdfs:label "PC 1" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 152. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "天池" ;
    tara:hasIndicationsDescription "Suffocating sensation in the chest, pain in the hypochondriac region, swelling and pain of the axillary regIon." ;
    tara:hasInnervationDescription "The muscular branch of the anterior thoracic nerve, the fourth intercostal nerve" ;
    tara:hasLocationalDescription "In the anterior thoracic region, in the fourth intercostal space, 5 B-cun lateral to the anterior median line." ;
    tara:hasMeridian tara:TARA_4694897 ;
    tara:hasMethodDescription "Puncture obliquely 0.2-0.4 inch. Deep puncture is not advisable." ;
    tara:hasPinyinLabel "Tianchi" ;
    tara:hasRelatedLocation ILX:0795285,
        ILX:0795298 ;
    tara:hasSurfaceLocation UBERON:0016416 ;
    tara:hasSynonym "P 1",
        "Pericardium 1" ;
    tara:hasVasculatureDescription "The thoracoepigastric vein, the branches of the lateral thoracic artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016416 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4694897 ] ) ],
        [ a owl:Restriction ;
