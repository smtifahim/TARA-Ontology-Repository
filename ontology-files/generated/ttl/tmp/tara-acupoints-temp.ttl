    tara:hasSpecificSurfaceLocation UBERON:0004300,
        UBERON:0011273 ;
    tara:hasSynonym "L 11",
        "Lung 11" ;
    tara:hasVasculatureDescription "The arterial and venous network formed by the proper palmar digital artery and veins." ;
    tara:isLocatedOnMeridian tara:TARA_9964503 ;
