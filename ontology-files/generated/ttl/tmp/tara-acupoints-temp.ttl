tara:TARA_1216325 a owl:Class ;
    rdfs:label "Zhongquan" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Stuffy chest, gastric pain, spitting of blood." ;
    tara:hasLocationalDescription "On the dorsal crease of the wrist, in the depression on the radial side of the tendon of common extensor muscle of fingers between Yangxi (Ll 5) and Yangchi (TE 4)." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasSynonym "EX-UE 3",
        "M-UE 33" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_1252750 a owl:Class ;
    rdfs:label "LI 16" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 41. ISBN 978-92-9061-248-7.

