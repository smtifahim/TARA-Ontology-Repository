tara:TARA_4512048 a owl:Class ;
    rdfs:label "KI 1" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 136. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "湧(涌)泉" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_2954517 ;
    tara:hasIndicationsDescription "Headache, blurring of vision, dizziness, sore throat, dryness of the tongue, loss of voice, dysuria, infantile, convulsions, feverish sensation in the sole, loss of consciousness." ;
    tara:hasInnervationDescription "The second common plantar digital nerve." ;
    tara:hasLocationalDescription "On the sole of the foot, in the deepest depression of the sole when the toes are flexed. Note: When the toes are flexed, KI1 is located approximately in the depression at the junction of the anterior one third and the posterior two thirds of the line connecting the heel with the web margin between the bases of the second and third toes." ;
    tara:hasMeridian tara:TARA_4813389 ;
    tara:hasPinyinLabel "Yongquan" ;
    tara:hasRelatedLocation UBERON:0003632,
        UBERON:0003633 ;
    tara:hasSurfaceLocation UBERON:0008338 ;
    tara:hasSynonym "K 1",
        "Kidney 1" ;
    tara:hasVasculatureDescription "Deeper, the plantar arterial arch." ;
