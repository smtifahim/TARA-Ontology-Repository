tara:TARA_1594912 a owl:Class ;
    rdfs:label "TE 4" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 159. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "陽(阳)池" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_1840369 ;
    tara:hasIndicationsDescription "Pain in the arm, shoulder and wrist, malaria, deafness, thirst." ;
    tara:hasInnervationDescription "The terminal branch of the posterior antebrachial cutaneous nerve and the dorsal branch of the ulnar nerve." ;
    tara:hasLocationalDescription "On the posterior aspect of the wrist, in the depression ulnar to the extensor digitorum tendon, on the dorsal wrist crease. Note 1: TE4 can be palpated when moving proximally along the gap between the fifth and fourth metacarpal bones, at the same level as LI5 and SI5. Note 2: When the wrist is extended against resistance, the extensor digitorum tendon can be palpated more easily." ;
    tara:hasMeridian tara:TARA_3898257 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Yangchi" ;
    tara:hasRelatedLocation UBERON:0003648,
        UBERON:0003649,
        ILX:0795333,
        ILX:0795502 ;
    tara:hasSurfaceLocation UBERON:0004452 ;
    tara:hasSynonym "SJ 4",
        "San Jiao 4",
        "TB 4",
        "TH 4",
        "TW 4",
        "Triple Burner 4",
        "Triple Energizer 4",
        "Triple Heater 4",
        "Triple Warmer 4" ;
    tara:hasVasculatureDescription "The dorsal venous network of the wrist and the posterior carpal artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003648 ] ],
