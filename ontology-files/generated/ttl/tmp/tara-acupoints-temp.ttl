tara:TARA_7834226 a owl:Class ;
    rdfs:label "ST 6" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 48. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "頰(颊)車(车)" ;
    tara:hasIndicationsDescription "Facial paralysis, toothache, swelling of the cheek and face, mumps, trismus." ;
    tara:hasInnervationDescription "The great auricular nerve, facial nerve and masseteric nerve." ;
    tara:hasLocationalDescription "On the face, one fingerbreadth (middle finger) anterosuperior to the angle of the mandible. Note: On the bisector of the angle of the mandible. When the mouth is closed and the teeth are clenched, this point is located at the prominence of the masseter and in the depression felt when the clenched teeth are released." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasPinyinLabel "Jiache" ;
    tara:hasRelatedLocation UBERON:0001597,
        UBERON:0001684 ;
    tara:hasSurfaceLocation UBERON:0001456 ;
    tara:hasSynonym "S 6",
        "Stomach 6" ;
    tara:hasVasculatureDescription "The masseteric artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001597 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001684 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6221269 ] ) ],
