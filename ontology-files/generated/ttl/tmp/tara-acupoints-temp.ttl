tara:TARA_3480360 a owl:Class ;
    rdfs:label "Anmian" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Insomnia, vertigo, headache, palpitation, mental disorders." ;
    tara:hasLocationalDescription "Midpoint between Yifeng (TE 17) and Fengchi (GB 20)." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch." ;
    tara:hasSynonym "EX-HN 16",
        "M-HN 54",
        "N-HN 54" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_3493245 a owl:Class ;
    rdfs:label "GB 19" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 181. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
