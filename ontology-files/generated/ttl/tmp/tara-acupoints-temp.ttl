tara:TARA_1194553 a owl:Class ;
    rdfs:label "Acupoint of the Heart Meridian" ;
    dc:description "An acupuncture point that is located along the Heart Meridian of Hand-Shaoyin (HT), which consists of 9 standardized acupoints beginning at HT 1 (Jiquan) in the center of the axillary fossa, traveling down the medial aspect of the arm, and ending at HT 9 (Shaochong) on the radial side of the little finger near the corner of the nail." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    tara:hasSynonym "Acupoint of the heart meridian of hand-shaoyin",
        "Acupuncture point of the heart meridian",
        "Acupuncture point of the heart meridian of hand-shaoyin",
        "HT" ;
    tara:isLocatedOnMeridian tara:TARA_9474009 ;
