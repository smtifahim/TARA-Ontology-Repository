    tara:hasIndicationsDescription "Scrofula" ;
    tara:hasLocationalDescription "On the tip of the ulnar olecranon when the elbow is flexed." ;
    tara:hasSynonym "EX-UE 1",
        "M-UE 46" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_8826565 a owl:Class ;
    rdfs:label "ST 32" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 62. https://iris.who.int/handle/10665/353407",
