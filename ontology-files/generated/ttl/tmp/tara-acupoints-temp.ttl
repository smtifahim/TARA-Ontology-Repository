                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4610474 ] ) ] .

tara:TARA_7831710 a owl:Class ;
    rdfs:label "SP 5" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 72. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "商丘" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_7315457 ;
    tara:hasIndicationsDescription "Abdominal distension, constipation, diarrhea, borborygmus, pain and rigidity of the tongue, pain in the foot and ankle, hemorrhoid." ;
    tara:hasInnervationDescription "The medial crural cutaneous nerve and the branch of the superficial peroneal nerve." ;
    tara:hasLocationalDescription "On the medial aspect of the foot, anteroinferior to the medial malleolus, in the depression midway between the tuberosity of the navicular bone and the prominence of the medial malleolus. Note 1: SP5 is located at the intersection of two imaginary lines: the vertical line of the anterior border of the medial malleolus and the horizontal line of the inferior border of the medial malleolus. Note 2: SP5 is located posterior to LR4 and anterior to KI6." ;
    tara:hasMeridian tara:TARA_4167850 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.2-0.3 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Shangqiu" ;
    tara:hasRelatedLocation UBERON:0010759,
        ILX:0795305 ;
    tara:hasSurfaceLocation UBERON:0002387 ;
    tara:hasSynonym "Spleen 5" ;
    tara:hasVasculatureDescription "The medial tarsal artery and the great saphenous vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002387 ] ],
