tara:TARA_2849795 a owl:Class ;
    rdfs:label "GB 2" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 172. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "聽(听,聴)會(会)" ;
    tara:hasIndicationsDescription "Deafness, tinnitus, toothache, motor impairment of the temporomandibular joint, mumps, deviation of the eye and mouth." ;
    tara:hasInnervationDescription "The great auricular nerve and facial nerve." ;
    tara:hasLocationalDescription "On the face, in the depression between the intertragic notch and the condylar process of the mandible. Note: When the mouth is opened, GB2 is located in the depression anterior to the intertragic notch." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Tinghui" ;
    tara:hasRelatedLocation UBERON:0004657,
        UBERON:0036212 ;
    tara:hasSurfaceLocation UBERON:0001456 ;
    tara:hasSynonym "G 2",
        "Gallbladder 2" ;
    tara:hasVasculatureDescription "The superficial temporal artery." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004657 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001456 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0036212 ] ] .

tara:TARA_2922507 a owl:Class ;
    rdfs:label "ST 23" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 57. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "太乙" ;
    tara:hasIndicationsDescription "Gastric pain, irritability, mania, indigestion." ;
    tara:hasInnervationDescription "The branches of the eighth and ninth intercostal nerves." ;
    tara:hasLocationalDescription "On the upper abdomen, 2 B-cun superior to the centre of the umbilicus, 2 B-cun lateral to the anterior median line. Note: ST23 is located at the same level and lateral to KI17 and CV10." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.7-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Taiyi" ;
    tara:hasRelatedLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSurfaceLocation ILX:0795301 ;
    tara:hasSynonym "S 23",
        "Stomach 23" ;
    tara:hasVasculatureDescription "The branches of the eighth and ninth intercostal and inferior epigastric arteries and veins." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795301 ] ],
