tara:TARA_8833337 a owl:Class ;
    rdfs:label "CV 6" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 222. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "氣(气,気)海(海)" ;
    tara:hasIndicationsDescription "Abdominal pain, enuresis, nocturnal emission, impotence, hernia, edema, diarrhea, dysentery, uterine bleeding, irregular menstruation, dysmenorrhea, amenorrhea, morbid leukorrhea, postpartum hemorrhage, constipation, flaccid type of apoplexy, asthma." ;
    tara:hasLocationalDescription "On the lower abdomen, 1.5 B-cun inferior to the centre of the umbilicus, on the ante- rior median line." ;
    tara:hasMeridian tara:TARA_6789717 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. This is one of the important points for tonification. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Qihai" ;
    tara:hasRelatedLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSurfaceLocation ILX:0795303 ;
    tara:hasSynonym "Conception Vessel 6",
        "RN 6",
        "Ren 6" ;
    tara:hasVasculatureDescription "See Shimen (CV 5)." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6789717 ] ) ],
