ILX:0795285 a owl:Class .

tara:hasSpecialPointDesignation a owl:ObjectProperty ;
    dc:description "An object property that relates an acupoint to its designated special acupoint role class (e.g., LU 1 hasSpecialPointDesignation Front-Mu Point of the Lung Role). It is the inverse of isSpecialPointDesignationOf and is a sub-property of the RO relation 'bearer of' (RO:0000053). Used in OWL axioms to classify acupoints as special points." ;
    rdfs:subPropertyOf RO:0000053 ;
    owl:inverseOf tara:isSpecialPointDesignationOf .

tara:TARA_5151019 a owl:Class ;
    rdfs:label "Meridian Acupoint" ;
    dc:description "Acupuncture points of the fourteen meridians, also known as \"meridian points,\" acupuncture points of the fourteen meridians are distributed along the twelve main meridian, the Governor Vessel and the Conception Vessel, totally amounting to 361." ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Page 115. ISBN 978-7-119-01758-7." ;
    tara:hasSynonym "Acupoint of meridian",
        "Meridian Acupuncture Point",
        "Meridian point",
        "meridian points" ;
    rdfs:subClassOf tara:TARA_1132428 .

tara:isMemberAcupointOf a owl:ObjectProperty ;
    dc:description "An object property that relates an acupoint to the meridian it belongs to (e.g., LU 1 isMemberAcupointOf Lung Meridian). It is the inverse of hasMemberAcupoint and a sub-property of the RO relation 'member of collection' (RO:0002350)." ;
    rdfs:subPropertyOf RO:0002350 .

tara:locatedOnTheSurfaceOf a owl:ObjectProperty ;
    rdfs:label "locatedOnTheSurfaceOf" ;
    dc:description "An object property that relates an acupoint to the general body region on whose surface it is located (e.g., LU 1 locatedOnTheSurfaceOf Anterior Thoracic Region). It is a sub-property of the RO relation 'located in' (RO:0001025) and corresponds to the annotation property hasSurfaceLocation." ;
    rdfs:subPropertyOf RO:0001025 .

tara:locatedInRelationTo a owl:ObjectProperty ;
    rdfs:label "locatedInRelationTo" ;
    dc:description "An object property that relates an acupoint to one or more specific anatomical structures in whose vicinity it is located on the body surface (e.g., LU 1 locatedInRelationTo First Intercostal Space, Infraclavicular Fossa, and Anterior Median Line, all within the Anterior Thoracic Region). It is a sub-property of the RO relation 'located in' (RO:0001025) and corresponds to the annotation property hasRelatedLocation." ;
    rdfs:subPropertyOf RO:0001025 .

[] a swrl:Imp ;
    swrl:body [ a swrl:AtomList ;
            rdf:first [ a swrl:ClassAtom ;
                    swrl:argument1 <urn:swrl:var#d> ;
                    swrl:classPredicate tara:TARA_4176111 ] ;
            rdf:rest [ a swrl:AtomList ;
                    rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:argument1 <urn:swrl:var#e> ;
                            swrl:argument2 <urn:swrl:var#d> ;
                            swrl:propertyPredicate tara:hasSpecialPointDesignation ] ;
                    rdf:rest () ] ] ;
    swrl:head [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:argument1 <urn:swrl:var#e> ;
                    swrl:argument2 <urn:swrl:var#d> ;
                    swrl:propertyPredicate tara:hasSpecialPointRole ] ;
            rdf:rest () ] .

