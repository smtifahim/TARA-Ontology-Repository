tara:TARA_0022762 a owl:Class ;
    rdfs:label "CV 3" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 221. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "中極(极)" ;
    tara:hasGeneralSurfaceLocation ILX:0795303 ;
    tara:hasIndicationsDescription "enuresis, nocturnal emission, impotence, hernia, uterine bleeding, irregular menstruation, dysmenorrhea, morbid leukorrhea, frequency of urination, retention of urine, pain in the lower abdomen, prolapse of the uterus, vaginitis." ;
    tara:hasInnervationDescription "The branch of the iliohypogastric nerve." ;
    tara:hasLocationalDescription "On the lower abdomen, 4 B-cun inferior to the centre of the umbilicus, on the anterior median line." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Zhongji" ;
    tara:hasSpecialPointRole tara:TARA_5308180 ;
    tara:hasSpecificSurfaceLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSynonym "Conception Vessel 3",
        "Front-Mu Point of the Bladder",
        "RN 3",
        "Ren 3",
        "VC 3" ;
    tara:hasVasculatureDescription "The branches of superficial epigastric artery and vein, and the branches of inferior epigastric artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_6789717 ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom tara:TARA_6789717 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom tara:TARA_1670028 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795303 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0007118 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ] .

tara:TARA_0093665 a owl:Class ;
    rdfs:label "BL 61" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 130. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "僕(仆)參(参)" ;
    tara:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara:hasIndicationsDescription "muscular atrophy and weakness of the lower extremities, pain in the heel." ;
    tara:hasInnervationDescription "The external calcaneal branch of the sural nerve." ;
    tara:hasLocationalDescription "On the lateral aspect of the foot, distal to BL60, lateral to the calcaneus, at the border between the red and white flesh." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Pucan",
        "Pushen" ;
    tara:hasSpecificSurfaceLocation UBERON:0001450 ;
    tara:hasSynonym "B 61",
        "Bladder 61",
        "UB 61",
        "Urinary Bladder 61" ;
    tara:hasVasculatureDescription "The external calcaneal branches of the peroneal artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002387 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001450 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ] .

tara:TARA_0095074 a owl:Class ;
    rdfs:label "ST 5" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 48. https://iris.who.int/handle/10665/353407",
