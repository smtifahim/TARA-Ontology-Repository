tara:TARA_7896553 a owl:Class ;
    rdfs:label "TE 2" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 158. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "液門(门)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_9857829 ;
    tara:hasIndicationsDescription "Headache, redness of the eyes, sudden deafness, sore throat, malaria, pain in the arm." ;
    tara:hasInnervationDescription "The dorsal branch of the ulnar nerve." ;
    tara:hasLocationalDescription "On the dorsum of the hand, in the depression superior to the web margin between the ring and little fingers, at the border between the red and white flesh." ;
    tara:hasMeridian tara:TARA_3898257 ;
    tara:hasMethodDescription "Puncture obliquely 0.3-0.5 inch towards the interspace of the metacarpal bones. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Yemen" ;
    tara:hasRelatedLocation UBERON:0003624,
        UBERON:0003625 ;
    tara:hasSurfaceLocation ILX:0794954 ;
    tara:hasSynonym "SJ 2",
        "San Jiao 2",
        "TB 2",
        "TH 2",
        "TW 2",
        "Triple Burner 2",
        "Triple Energizer 2",
        "Triple Heater 2",
        "Triple Warmer 2" ;
    tara:hasVasculatureDescription "The dorsal digital artery of the ulnar artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_2478120 ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_3898257 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003624 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0794954 ] ],
