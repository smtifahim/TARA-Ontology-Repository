    tara:hasRelatedVein UBERON:0001363 ;
    tara:hasSpecialPointRole tara:TARA_7315457 ;
    tara:hasSpecificSurfaceLocation UBERON:0010759,
        ILX:0795305 ;
    tara:hasSynonym "Spleen 5" ;
    tara:hasVasculatureDescription "The medial tarsal artery and the great saphenous vein." ;
    tara:isLocatedOnMeridian tara:TARA_4167850 ;
