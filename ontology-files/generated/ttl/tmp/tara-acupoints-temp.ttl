tara:TARA_6941032 a owl:Class ;
    rdfs:label "Baichongwo" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasIndicationsDescription "Rubella, eczema, gastrointestinal parasitic diseases." ;
    tara:hasLocationalDescription "1 cun above Xuehai (SP 10)." ;
    tara:hasMethodDescription "Pu ncture perpendicularly 1.0-1.2 inches. Moxibustion is applicable." ;
    tara:hasSynonym "M-LE 34" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_6946713 a owl:Class ;
    rdfs:label "Yuyao" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasIndicationsDescription "Pain in the supraorbital region, twitching of the eyelids, ptosis, cloudiness of the cornea, redness, swelling and pain of the eyes." ;
    tara:hasLocationalDescription "At the midpoint of the eyebrow, directly above the pupil." ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch." ;
    tara:hasSynonym "EX-HN 4",
        "M-HN 6" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_6969962 a owl:Class ;
    rdfs:label "CV 2" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 220. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "曲骨(骨)" ;
    tara:hasGeneralSurfaceLocation ILX:0795303 ;
    tara:hasIndicationsDescription "retention and dribbling of urine, enuresis, nocturnal emission, impotence, morbid leukorrhea, irregular menstruation, dysmenorrhea, hernia." ;
    tara:hasInnervationDescription "The branch of the iliohypogastric nerve." ;
    tara:hasLocationalDescription "On the lower abdomen, superior to the pubic symphysis, on the anterior median line." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Great care should be taken to puncture the points from Qugu (CV 2) to Shangwan (CV 13) of this meridian in pregnant women. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Qugu" ;
    tara:hasSpecificSurfaceLocation UBERON:0003699,
        ILX:0795285 ;
    tara:hasSynonym "Conception Vessel 2",
        "RN 2",
        "Ren 2",
        "VC 2" ;
    tara:hasVasculatureDescription "The branches of the inferior epigastric artery and the obturator artery." ;
    tara:isLocatedOnMeridian tara:TARA_6789717 ;
