tara:TARA_5629511 a owl:Class ;
    rdfs:label "Acupoint of the Spleen Meridian" ;
    dc:description "An acupuncture point that is located along the Spleen Meridian of Foot-Taiyin (SP), which consists of 21 standardized acupoints beginning at SP 1 (Yinbai) on the medial side of the great toe near the corner of the nail, traveling up along the medial aspect of the leg and continuing up the abdomen and chest, and ending at SP 21 (Dabao) on the lateral thorax in the sixth intercostal space on the midaxillary line." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7." ;
    tara:hasMeridian tara:TARA_4167850 ;
    tara:hasSynonym "Acupoint of the spleen meridian of foot-taiyin",
        "Acupuncture point of the spleen meridian",
        "Acupuncture point of the spleen meridian of foot-taiyin",
        "SP" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4167850 ] ) ] .

tara:TARA_5656394 a owl:Class ;
    rdfs:label "SP 18" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 78. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "天谿(溪)" ;
    tara:hasIndicationsDescription "Fullness and pain in the chest and hypochondrium, cough, hiccup, mastitis, insufficient lactation." ;
    tara:hasInnervationDescription "The lateral cutaneous branch of the fourth intercostal nerve." ;
    tara:hasLocationalDescription "In the anterior thoracic region, in the fourth intercostal space, 6 B-cun lateral to the anterior median line. Note: SP18, ST17 and KI23 are located along the curve of the fourth intercostal space." ;
    tara:hasMeridian tara:TARA_4167850 ;
    tara:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Tianxi" ;
    tara:hasRelatedLocation ILX:0795285,
        ILX:0795298 ;
    tara:hasSurfaceLocation UBERON:0016416 ;
    tara:hasSynonym "Spleen 18" ;
    tara:hasVasculatureDescription "The branches of the lateral thoracic artery and vein, the thoracoepigastric artery and vein, the fourth intercostal artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016416 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4167850 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795298 ] ] .

tara:TARA_5660399 a owl:Class ;
    rdfs:label "Erjian" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Redness, swelling and pain of the eyes, febrile disease, nebula." ;
    tara:hasLocationalDescription "Fold the auricle, the point is at the apex of the auricle." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.1-0.2 inch or prick to cause bleeding." ;
    tara:hasSynonym "EX-HN 6",
        "M-HN 10" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_5677319 a owl:Class ;
    rdfs:label "LI 5" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 36. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "陽(阳)谿(溪)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_7315457 ;
    tara:hasIndicationsDescription "Headache, redness, pain and swelling of the eye, toothache, sore throat, pain of the wrist." ;
    tara:hasInnervationDescription "The superficial branch of the radial nerve." ;
    tara:hasLocationalDescription "On the posterolateral aspect of the wrist, at the radial side of the dorsal wrist crease, distal to the radial styloid process, in the depression of the anatomical snuffbox. Note : The depression of the anatomical snuffbox is formed when the thumb is fully abducted and extended between the tendons of the extensor pollicis longus and the extensor pollicis brevis." ;
    tara:hasMeridian tara:TARA_4610474 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
