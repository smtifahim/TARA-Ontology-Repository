                    owl:someValuesFrom UBERON:0002386 ] ] .

tara:TARA_8458036 a owl:Class ;
    rdfs:label "BL 35" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 117. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "會(会)陽(阳)" ;
    tara:hasIndicationsDescription "Dysentery, bloody stools, diarrhea, hemorrhoids, impotence, morbid leukorrhea." ;
    tara:hasInnervationDescription "The coccygeal nerve." ;
    tara:hasLocationalDescription "In the buttock region, 0.5 B-cun lateral to the extremity of the coccyx. Note: The subject may be in prone position or knee-chest position. BL35 is located at the soft depression lateral to the extremity of the coccyx." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Huiyang" ;
    tara:hasRelatedLocation UBERON:0001350 ;
    tara:hasSurfaceLocation UBERON:0013691 ;
    tara:hasSynonym "B 35",
        "Bladder 35",
        "UB 35",
        "Urinary Bladder 35" ;
    tara:hasVasculatureDescription "The branches of the inferior gluteal artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001350 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
