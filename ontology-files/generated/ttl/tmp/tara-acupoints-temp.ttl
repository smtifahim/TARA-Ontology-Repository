            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003625 ] ] .

tara:TARA_7927421 a owl:Class ;
    rdfs:label "CV 1 (Female)" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 220. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasIndicationsDescription "Vaginitis, retention of urine hemorrhoids, nocturnal emission, enuresis, irregular menstruation, mental disorders." ;
    tara:hasInnervationDescription "The branch of the perineal nerve." ;
    tara:hasLocationalDescription "In the perineal region, at the midpoint of the line connecting the anus with the posterior border of the scrotum in males and the posterior commissure of labium majoris in females. Note: CV 1 is located midway between the anus and the genital organ, with the subject lying on the side or in knee-chest position." ;
    tara:hasMeridian tara:TARA_6789717 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasRelatedLocation UBERON:0001245,
        UBERON:0003133,
        UBERON:0004084 ;
    tara:hasSurfaceLocation UBERON:0002356 ;
    tara:hasSynonym "Conception Vessel 1",
        "RN 1",
        "Ren 1" ;
    tara:hasVasculatureDescription "The branches of the perineal artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002356 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001245 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004084 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003133 ] ],
        tara:TARA_8693603 .

tara:TARA_7932600 a owl:Class ;
    rdfs:label "Acupoint of the Large Intestine Meridian" ;
    dc:description "An acupuncture point that is located along the Large Intestine Meridian of Hand-Yangming (LI), which consists of 20 standardized acupoints beginning at LI 1 (Shangyang) on the radial side of the index finger near the corner of the nail, traveling up the dorsal-radial aspect of the arm and across the shoulder and side of the neck to the face, and ending at LI 20 (Yingxiang) in the nasolabial sulcus beside the ala of the nose." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7." ;
    tara:hasMeridian tara:TARA_4610474 ;
    tara:hasSynonym "Acupoint of the large intestine meridian of hand-yangming",
        "Acupuncture point of the large intestine meridian",
        "Acupuncture point of the large intestine meridian of hand-yangming",
        "LI" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4610474 ] ) ] .

tara:TARA_8009041 a owl:Class ;
    rdfs:label "Dingchuan" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Asthma, cough, neck rigidity, pain in the shoulder and back, rubella." ;
    tara:hasLocationalDescription "0.5 cun lateral to Dazhui (GV 14)." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara:hasRelatedLocation UBERON:0004616 ;
    tara:hasSurfaceLocation UBERON:0000974 ;
    tara:hasSynonym "EX-B 1",
        "M-BW 1" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004616 ] ],
        tara:TARA_3535998 .

tara:TARA_8036487 a owl:Class ;
    rdfs:label "SP 7" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 73. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "漏谷" ;
    tara:hasIndicationsDescription "Abdominal distension, borborygmus, coldness, numbness and paralysis of the knee and leg." ;
    tara:hasLocationalDescription "On the tibial aspect of the leg, posterior to the medial border of the tibia, 6 B-cun superior to the prominence of the medial malleolus. Note: 3 B-cun superior to SP6." ;
    tara:hasMeridian tara:TARA_4167850 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Lougu" ;
    tara:hasRelatedLocation UBERON:0000979,
        ILX:0795305 ;
    tara:hasSurfaceLocation UBERON:0003823 ;
    tara:hasSynonym "Spleen 7" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000979 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795305 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4167850 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003823 ] ] .

tara:TARA_8087484 a owl:Class ;
    rdfs:label "LI 19" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 43. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "口禾髎(髎)" ;
    tara:hasIndicationsDescription "Nasal obstruction, epistaxis, deviation of the mouth." ;
    tara:hasInnervationDescription "The anastomotic branch of the facial nerve and the infraorbital nerve." ;
    tara:hasLocationalDescription "On the face, at the same level as the midpoint of the philtrum, inferior to the lateral margin of the nostril. Note: 0.5 B-cun laterals to GV 26. Remarks: Alternative location for LI19 - On the face, at the same level as the junc- tion of the upper one third and lower two thirds of the philtrum, inferior to the lateral margin of the nostril." ;
    tara:hasMeridian tara:TARA_4610474 ;
    tara:hasMethodDescription "Puncture obliquely 0.2-0.3 inch." ;
    tara:hasPinyinLabel "Kouheliao" ;
    tara:hasRelatedLocation UBERON:0005402,
        UBERON:0005928 ;
    tara:hasSurfaceLocation UBERON:0001456 ;
    tara:hasSynonym "Large Intestine 19" ;
    tara:hasVasculatureDescription "The superior labial branches of the facial artery and vein." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4610474 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001456 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0005402 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0005928 ] ] .

tara:TARA_8088170 a owl:Class ;
    rdfs:label "GB 26" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 184. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "帶(带,帯)脈(脉)" ;
    tara:hasIndicationsDescription "Irregular menstruation, amenorrhea, leukorrhea, abdominal pain, hernia, pain in the lumbar and hypochondriac region." ;
    tara:hasInnervationDescription "The subcostal nerve." ;
    tara:hasLocationalDescription "On the lateral abdomen, inferior to the free extremity of the 11th rib, at the same level as the centre of umbilicus. Note 1: GB26 can be located by first locat- ing the tenth rib, then searching for the free extremity of the 11th rib that is situated immediately below the inferior border of the costal arch. Note 2: GB 26 is inferior to LR 13, at the same level as CV 8." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Daimai" ;
    tara:hasRelatedLocation UBERON:0002225,
        UBERON:0004610,
        UBERON:0007118 ;
    tara:hasSurfaceLocation UBERON:0000916 ;
    tara:hasSynonym "G 26",
        "Gallbladder 26" ;
    tara:hasVasculatureDescription "The subcostal artery and vem." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002225 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0007118 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000916 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004610 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ] .

tara:TARA_8093645 a owl:Class ;
    rdfs:label "GV 8" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 207. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "筋縮(缩)" ;
    tara:hasIndicationsDescription "Epilepsy, stiffness of the back, gastric pain." ;
    tara:hasInnervationDescription "The medial branch of the posterior ramus of the ninth thoracic nerve." ;
    tara:hasLocationalDescription "In the upper back region, in the depression inferior to the spinous process of the ninth thoracic vertebra (T9), on the posterior median line." ;
    tara:hasMeridian tara:TARA_0386099 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Jinsuo" ;
    tara:hasRelatedLocation UBERON:0004633,
        ILX:0795312 ;
    tara:hasSurfaceLocation UBERON:0008231 ;
    tara:hasSynonym "Du 8",
        "Governor Vessel 8" ;
    tara:hasVasculatureDescription "The posterior branch of the ninth intercostal artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795312 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0008231 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_0386099 ] ) ],
