        ILX:0795308 ;
    tara:hasSurfaceLocation ILX:0795306 ;
    tara:hasSynonym "Spleen 21" ;
    tara:hasVasculatureDescription "The thoracodorsal artery and vein, the seventh intercostal artery and vein." ;
