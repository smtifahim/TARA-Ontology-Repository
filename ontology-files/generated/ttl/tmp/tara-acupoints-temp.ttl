tara:TARA_4043356 a owl:Class ;
    rdfs:label "Crossing Point" ;
    dc:description "Crossing points are those at the intersections of two or more meridians. Distributed mainly on the head, face and trunk, and amounting to over ninety in total. They are key points used to treat meridian disorders of the areas where they are located." ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    tara:hasDesignatedSpecialPointRole tara:TARA_9695467 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_2614885 [ a owl:Restriction ;
                        owl:onProperty tara:hasSpecialPointDesignation ;
                        owl:someValuesFrom tara:TARA_9695467 ] ) ] .

tara:TARA_4050310 a owl:Class ;
    rdfs:label "KI 23" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 147. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "神(神)封" ;
    tara:hasIndicationsDescription "Cough, asthma, fullness in the chest and hypochondriac region, mastitis." ;
    tara:hasInnervationDescription "The anterior cutaneous branch of the fourth intercostal nerve; deeper, the fourth intercostal nerve." ;
    tara:hasLocationalDescription "In the anterior thoracic region, in the fourth intercostal space, 2 B-cun lateral to the anterior median line." ;
    tara:hasMeridian tara:TARA_4813389 ;
    tara:hasPinyinLabel "Shengfeng" ;
    tara:hasRelatedLocation ILX:0795285,
        ILX:0795298 ;
    tara:hasSurfaceLocation UBERON:0016416 ;
    tara:hasSynonym "K 23",
        "Kidney 23" ;
    tara:hasVasculatureDescription "The fourth intercostal artery and vein." ;
    rdfs:subClassOf [ a owl:Class ;
