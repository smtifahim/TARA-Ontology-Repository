        UBERON:0011279 ;
    tara:hasSynonym "S 45",
        "Stomach 45" ;
    tara:hasVasculatureDescription "The arterial and venous network formed by the dorsal digital artery and vein of foot." ;
    tara:isLocatedOnMeridian tara:TARA_6221269 ;
