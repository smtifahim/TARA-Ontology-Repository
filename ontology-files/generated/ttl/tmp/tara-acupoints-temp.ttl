tara:TARA_7793286 a owl:Class ;
    rdfs:label "CV 1 (Male)" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 220. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasGeneralSurfaceLocation UBERON:0002356 ;
    tara:hasIndicationsDescription "vaginitis, retention of urine, hemorrhoids, nocturnal emission, enuresis, irregular menstruation, mental disorder." ;
    tara:hasInnervationDescription "The branch of the perineal nerve." ;
    tara:hasLocationalDescription "In the perineal region, at the midpoint of the line connecting the anus with the posterior border of the scrotum in males and the posterior commissure of labium majoris in females. Note: CV 1 is located midway between the anus and the genital organ, with the subject lying on the side or in knee-chest position." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasSpecificSurfaceLocation UBERON:0001245,
        UBERON:0001300,
        UBERON:0003133 ;
    tara:hasSynonym "Conception Vessel 1 (Male)" ;
    tara:hasVasculatureDescription "The branches of the perineal artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_6789717 ;
