    rdfs:label "LR 13" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 202. ISBN 978-92-9061-248-7.

