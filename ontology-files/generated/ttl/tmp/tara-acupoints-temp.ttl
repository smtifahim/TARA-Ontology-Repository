tara:TARA_9591551 a owl:Class ;
    rdfs:label "ST 30" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 60. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "氣(气,気)衝(冲)" ;
    tara:hasIndicationsDescription "Abdominal pain, borborygmus, hernia, swelling and pain of the external genitalia, impotence, dysmenorrhea, irregular menstruation." ;
    tara:hasInnervationDescription "The pathway of the ilioinguinal nerve." ;
    tara:hasLocationalDescription "In the groin region, at the same level as the superior border of the pubic symphysis, 2 B-cun lateral to the anterior median line, over the femoral artery. Note: ST30 is 5 B-cun inferior to ST25, 2 B-cun lateral to CV2." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasPinyinLabel "Qichong" ;
    tara:hasRelatedLocation UBERON:0002060,
        UBERON:0003699,
        ILX:0795285 ;
    tara:hasSurfaceLocation UBERON:0008337 ;
    tara:hasSynonym "S 30",
        "Stomach 30" ;
    tara:hasVasculatureDescription "The branches of the superficial epigastric artery and vein; laterally, the inferior epigastric artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0008337 ] ],
