tara:TARA_0307907 a owl:Class ;
    rdfs:label "GB 9" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 176. https://iris.who.int/handle/10665/353407",
