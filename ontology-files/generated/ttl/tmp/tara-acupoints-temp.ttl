tara:TARA_1459681 a owl:Class ;
    rdfs:label "Acupoint of the Lung Meridian" ;
    dc:description "An acupuncture point that is located along the Lung Meridian of Hand-Taiyin (LU), which consists of 11 standardized acupoints beginning at LU 1 (Zhongfu) on the upper anterior chest lateral to the infraclavicular fossa, traveling down the anterior-lateral aspect of the arm, and ending at LU 11 (Shaoshang) on the radial side of the thumb near the corner of the nail." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7." ;
    tara:hasMeridian tara:TARA_9964503 ;
    tara:hasSynonym "Acupoint of the lung meridian of hand-taiyin",
        "Acupuncture point of the lung meridian",
        "Acupuncture point of the lung meridian of hand-taiyin",
        "LU" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_9964503 ] ) ] .

tara:TARA_1460220 a owl:Class ;
    rdfs:label "BL 1" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 100. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "睛(睛)明" ;
    tara:hasIndicationsDescription "Redness, swelling and pain of the eye, itching of the canthus, lacrimation, night blindness, color blindness, blurring of vision, myopia." ;
    tara:hasInnervationDescription "Superficially, the supratrochlear and infratrochlear nerves; deeper, the branches of the oculomotor nerve, the ophthalmic nerve." ;
    tara:hasLocationalDescription "On the face, in the depression between the superomedial parts of the inner canthus of the eye and the medial wall of the orbit. Note: When the eye is closed, BL1 is located in the depression 0.1 B-cun superior and medial to the inner canthus of the eye." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Ask the patient to close his eyes when pushing gently the eyeball to the lateral side. Puncture slowly perpendicularly 0.3-0.7 inch along the orbital wall. It is not advisable to twist of lift and thrust the needle vigorously. To avoid bleeding, press the puncturing site for a few seconds after withdrawal of the needle. Moxibustion is forbidden." ;
    tara:hasPinyinLabel "Jingming" ;
    tara:hasRelatedLocation UBERON:0000019,
        UBERON:0004867,
        UBERON:0005611 ;
    tara:hasSurfaceLocation UBERON:0001456 ;
    tara:hasSynonym "B 1",
        "Bladder 1",
        "UB 1",
        "Urinary Bladder 1" ;
    tara:hasVasculatureDescription "The angular artery and vein, deeper, superiorly, the ophthalmic artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001456 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004867 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0005611 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000019 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ] .

tara:TARA_1522109 a owl:Class ;
    rdfs:label "BL 34" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 116. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "下髎(髎)" ;
    tara:hasIndicationsDescription "Low back pain, lower abdominal pain, dysuria, constipation, morbid leukorrhea." ;
    tara:hasInnervationDescription "On the course of the posterior ramus of the fourth sacral nerve." ;
    tara:hasLocationalDescription "In the sacral region, in the fourth posterior sacral foramen. Note: The fourth posterior sacral foramen is located in the second depression, moving downward from BL32, at the same level as the sacral hiatus." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Xialiao" ;
    tara:hasRelatedLocation ILX:0741717,
        ILX:0795316 ;
    tara:hasSurfaceLocation UBERON:0005473 ;
    tara:hasSynonym "B 34",
        "Bladder 34",
        "UB 34",
        "Urinary Bladder 34" ;
    tara:hasVasculatureDescription "The branches of the inferior gluteal artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0005473 ] ],
