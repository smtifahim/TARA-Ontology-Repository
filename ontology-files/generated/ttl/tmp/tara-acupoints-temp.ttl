tara:TARA_7010544 a owl:Class ;
    rdfs:label "Influential Point" ;
    dc:description "Represents one of the Eight lnfluential Points. The Eight Influential Points refer to the specific points which have particular effects in treatment of disorders relating to the zang-fu organs, qi, blood, tendon, pulse and vessels, bone and marrow. Each of the Eight Influential Points overlaps the other point. It is said in Classic on Medical Problems, \"Zhongwan (CV 12) is the Influential Point of the fu organs; Zhangmen (LR 13) is the Influential Point of the zang organs; Yanglingquan (GB 34) is the Influential Point of tendons; Xuanzhong (GB 39) is the Influential Point of marrow; Geshu (BL 17) is the Influential Point of blood; Dazhu (BL 11) is the Influential Point of bone; Taiyuan (LU 9) is the Influential Point of pulse and vessels; and Tanzhong (CV 17) is the Influential Point of Qi." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. Ch. 16, General Introduction to Acupuncture Treatment, Page 392. ISBN 978-7-119-01758-7." ;
    tara:hasSpecialPointRole tara:TARA_4235924 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_7852472 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom tara:TARA_4235924 ] ) ] .

tara:TARA_9493899 a owl:Class ;
    rdfs:label "Confluent Point" ;
    dc:description "Confluent Points refer to the eight points on the limbs where the main meridians communicate with the eight extra meridians. They are Neiguan (PC 6). Gongsun (SP 4), Houxi (SJ 3), Shenmai (BL 62). Waiguan (TE 5), Zulinqi (GB 41 ), Lieque (LU 7) and Zhaohai (KI 6), which are respectively connected with the Yin Link Vessel. Thoroughfare Vessel, governor Vessel, Yang Heel Vessel. Yang Link Vessel, Belt Vessel, Conception Vessel and Yin Heel Vessel. The Eight Confluent Points are used to treat a variety of disorders of the corresponding eight extra meridians." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    tara:hasSpecialPointRole tara:TARA_3091322 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_4943316 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom tara:TARA_3091322 ] ) ] .

