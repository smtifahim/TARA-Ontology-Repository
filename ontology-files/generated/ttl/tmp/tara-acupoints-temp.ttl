                    owl:someValuesFrom UBERON:0003823 ] ] .

tara:TARA_3201959 a owl:Class ;
    rdfs:label "GB 33" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 188. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "膝陽(阳)關(关,関)" ;
    tara:hasIndicationsDescription "Swelling and pain of the knee, contracture of the tendons in popliteal fossa, numbness of the leg." ;
    tara:hasInnervationDescription "The terminal branch of the lateral femoral cutaneous nerve." ;
    tara:hasLocationalDescription "On the lateral aspect of the knee, in the depression between the biceps femoris tendon and the iliotibial band, posterior and proximal to the lateral epicondyle of the femur." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch." ;
    tara:hasPinyinLabel "Xiyangguan" ;
    tara:hasRelatedLocation UBERON:0000981,
        ILX:0795317,
        ILX:0795324 ;
    tara:hasSurfaceLocation UBERON:0001465 ;
    tara:hasSynonym "G 33",
        "Gallbladder 33" ;
    tara:hasVasculatureDescription "The superior lateral genicular artery and vein." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000981 ] ],
