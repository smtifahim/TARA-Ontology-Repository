        "Triple Burner 17",
        "Triple Energizer 17",
        "Triple Heater 17",
        "Triple Warmer 17" ;
    tara:hasVasculatureDescription "The posterior auricular artery and vein, the external jugular vein." ;
    tara:isLocatedOnMeridian tara:TARA_3898257 ;
