tara:TARA_6213780 a owl:Class ;
    rdfs:label "Influential Point of Pulse" ;
    dc:description "The Eight Influential Points refer to the specific points which have particular effects in treatment of disorders relating to the zang-fu organs, qi, blood, tendon, pulse and vessels, bone and marrow. Each of the Eight Influential Points overlaps the other point. Taiyuan (LU 9) is the Influential Point of blood." ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    tara:hasDesignatedSpecialPointRole tara:TARA_8571343 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_7010544 [ a owl:Restriction ;
                        owl:onProperty tara:hasSpecialPointDesignation ;
                        owl:someValuesFrom tara:TARA_8571343 ] ) ] .

tara:TARA_6269212 a owl:Class ;
    rdfs:label "Zhongkui" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Nausea, vomiting, hiccup." ;
    tara:hasLocationalDescription "On the midpoint of the proximal interphalangeal joint of the middle finger at dorsum aspect." ;
    tara:hasMethodDescription "Moxibustion is applied with three moxa cones." ;
    tara:hasSynonym "EX-UE 4" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_6299396 a owl:Class ;
    rdfs:label "TE 11" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 163. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "淸(清)冷(令)淵(渊)" ;
    tara:hasInnervationDescription "The posterior brachial cutaneous nerve and the muscular branch of the radial nerve." ;
    tara:hasLocationalDescription "On the posterior aspect of the arm, on the line connecting the prominence of olecranon with the acromial angle, 2 B-cun proximal to the prominence of the olecranon. Note: With the elbow extended, 2 B-cun superior to the prominence of the olecranon." ;
    tara:hasMeridian tara:TARA_3898257 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Qinglengyuan" ;
    tara:hasRelatedLocation UBERON:0001461,
        UBERON:0006810 ;
    tara:hasSurfaceLocation UBERON:0001460 ;
    tara:hasSynonym "SJ 11",
        "San Jiao 11",
        "TB 11",
        "TH 11",
        "TW 11",
        "Triple Burner 11",
        "Triple Energizer 11",
        "Triple Heater 11",
        "Triple Warmer 11" ;
    tara:hasVasculatureDescription "The terminal branches of the median collateral artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001461 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001460 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_3898257 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0006810 ] ] .

tara:TARA_6308255 a owl:Class ;
    rdfs:label "GB 24 (Male)" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 183. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasIndicationsDescription "Pain in the hypochondriac region, vomiting, acid regurgitation, hiccup, jaundice, mastitis." ;
    tara:hasInnervationDescription "The seventh intercostal nerve." ;
    tara:hasLocationalDescription "In the anterior thoracic region, in the sev- enth intercostal space, 4 B-cun lateral to the anterior median line. Note 1: GB 24 is inferior to the centre of the nipple, one rib inferior to LR 14. Note 2: In females, GB24 can be found at the intersection of the midclavicular line and the seventh intercostal space." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasRelatedLocation UBERON:0002030,
        ILX:0795285,
        ILX:0795321 ;
    tara:hasSurfaceLocation UBERON:0016416 ;
    tara:hasSynonym "Front-Mu Point of the Gallbladder",
        "G 24",
        "Gallbladder 24" ;
    tara:hasVasculatureDescription "The seventh intercostal artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016416 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795321 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002030 ] ],
        tara:TARA_0214009 .

tara:TARA_6314936 a owl:Class ;
    rdfs:label "LI 1" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 34. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "商陽(阳)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_2954517 ;
    tara:hasIndicationsDescription "Toothache, sore throat, swelling of the submandibular region, numbness of fingers, febrile diseases with anhidrosis, loss of consciousness." ;
    tara:hasInnervationDescription "The palmar digital proprial nerve derived from the median nerve." ;
    tara:hasLocationalDescription "On the index finger, radial to the distal phalanx, 0.1 f-cun proximal-lateral to the radial corner of the index fingernail, at the intersection of the vertical line of the radial border of the fingernail and the horizontal line of the base of the index fingernail." ;
    tara:hasMeridian tara:TARA_4610474 ;
    tara:hasMethodDescription "Puncture 0.1 inch, or prick the point to cause bleeding." ;
    tara:hasPinyinLabel "Shangyang" ;
    tara:hasRelatedLocation UBERON:0004300,
        UBERON:0011274 ;
    tara:hasSurfaceLocation UBERON:0003622 ;
    tara:hasSynonym "Large Intestine 1" ;
    tara:hasVasculatureDescription "The arterial and venous network formed by the dorsal digital arteries and veins." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004300 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0011274 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003622 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_3839815 ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4610474 ] ) ] .

tara:TARA_6320058 a owl:Class ;
    rdfs:label "GB 37" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 190. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "光明" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_6993030 ;
    tara:hasIndicationsDescription "Pain in the knee, muscular atrophy, motor impairment and pain of the lower extremities, blurring of vision, ophthalmalgia, night blindness, distending pain of the breast." ;
    tara:hasInnervationDescription "The superficial peroneal nerve." ;
    tara:hasLocationalDescription "On the fibular aspect of the leg, anterior to the fibula, 5 B-cun proximal to the prominence of the lateral malleolus." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.7-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Guangming" ;
    tara:hasRelatedLocation UBERON:0001446,
        UBERON:0012291 ;
    tara:hasSurfaceLocation UBERON:0003823 ;
    tara:hasSynonym "G 37",
        "Gallbladder 37" ;
    tara:hasVasculatureDescription "The branches of the anterior tibial artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003823 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001446 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_2162578 ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0012291 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ] .

tara:TARA_6392753 a owl:Class ;
    rdfs:label "ST 2" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 46. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "四白" ;
    tara:hasIndicationsDescription "Redness, pain and itching of the eye, facial paralysis, twitching of eye lids, pain in the face." ;
    tara:hasInnervationDescription "The branches of the facial nerve. The point is right on the course of the infraorbital nerve." ;
    tara:hasLocationalDescription "On the face, in the infraorbital foramen." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.2-0.3 inch. It is not advisable to puncture deeply." ;
    tara:hasPinyinLabel "Sibai" ;
    tara:hasRelatedLocation UBERON:0018407 ;
    tara:hasSurfaceLocation UBERON:0001456 ;
    tara:hasSynonym "S 2",
        "Stomach 2" ;
    tara:hasVasculatureDescription "The branches of facial artery and vein, the infraorbital artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0018407 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6221269 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001456 ] ] .

tara:TARA_6421594 a owl:Class ;
    rdfs:label "HT 6" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 84. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "陰(阴)郄" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_4598552 ;
    tara:hasIndicationsDescription "Cardiac pain, hysteria, night sweating, hemoptysis, epistaxis, sudden loss of voice." ;
    tara:hasLocationalDescription "On the anteromedial aspect of the forearm, radial to the flexor carpi ulnaris tendon, 0.5 B-cun proximal to the palmar wrist crease. Note 1: 0.5 B-cun proximal to HT7, at the same level as the distal border of the head of the ulna. Note 2: 0.5 B-cun proximal to the radial side of the proximal border of the pisiform bone." ;
    tara:hasMeridian tara:TARA_9474009 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Yinxi" ;
    tara:hasRelatedLocation UBERON:0001424,
        UBERON:0001429,
        ILX:0795334,
        ILX:0795501 ;
    tara:hasSurfaceLocation UBERON:0002386 ;
    tara:hasSynonym "H 6",
        "HE 6",
        "Heart 6" ;
    tara:hasVasculatureDescription "See Lingdao (HT 4)." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_9474009 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001429 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002386 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795501 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001424 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795334 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_2798650 ] .

tara:TARA_6463344 a owl:Class ;
    rdfs:label "ST 36" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 64. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "足三里" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_6594221 ;
    tara:hasIndicationsDescription "Gastric pain, vomiting, hiccup, abdominal distension, borborygmus, diarrhea, dysentery, constipation, mastitis, enteritis, aching of the knee joint and leg, beriberi, edema, cough, asthma, emaciation due to general deficiency, indigestion, apoplexy, hemiplegia, dizziness, insomnia, mania." ;
    tara:hasInnervationDescription "Superficially, the lateral sural cutaneous nerve and the cutaneous branch of the saphenous nerve; deeper, the deep peroneal nerve." ;
    tara:hasLocationalDescription "On the anterior aspect of the leg, on the line connecting ST35 with ST41, 3 B-cun inferior to ST35. Note: ST36 is located on the tibialis anterior muscle." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.2 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Zusanli" ;
    tara:hasRelatedLocation UBERON:0001385 ;
    tara:hasSurfaceLocation UBERON:0003823 ;
    tara:hasSynonym "S 36",
        "Stomach 36" ;
    tara:hasVasculatureDescription "The anterior tibial artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003823 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001385 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6221269 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_4109407 ] .

tara:TARA_6472655 a owl:Class ;
    rdfs:label "CV 22" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 230. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "天突" ;
    tara:hasIndicationsDescription "Asthma, cough, sore throat, dry throat, hiccup, sudden hoarseness of the voice, difficulty in swallowing, goiter." ;
    tara:hasInnervationDescription "The anterior branch of the supraclavicular nerve." ;
    tara:hasLocationalDescription "In the anterior region of the neck, in the centre of the suprasternal fossa, on the anterior median line. Note: CV22 is located in the depression midway between the medial ends of each clavicle." ;
    tara:hasMeridian tara:TARA_6789717 ;
    tara:hasMethodDescription "First puncture perpendicularly 0.2 inch and then insert the needle tip downward along the posterior aspect of the sternum 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Tiantu" ;
    tara:hasRelatedLocation UBERON:0001105,
        ILX:0795285,
        ILX:0795331 ;
    tara:hasSurfaceLocation UBERON:0000974 ;
    tara:hasSynonym "Conception Vessel 22",
        "RN 22",
        "Ren 22" ;
    tara:hasVasculatureDescription "Superficially, the jugular arch and the branch of the inferior thyroid artery; deeper, the trachea; inferiorly, at the posterior aspect of the sternum, the inominate vein at aortic arch." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795331 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6789717 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001105 ] ] .

tara:TARA_6477399 a owl:Class ;
    rdfs:label "PC 5" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 154. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "間(间)使" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_7315457 ;
    tara:hasIndicationsDescription "Cardiac pain, palpitation, stomachache, vomiting, febrile diseases, irritability, malaria, mental disorders, epilepsy, swelling of the axilla, contracture of the elbow and arm." ;
    tara:hasInnervationDescription "The medial and lateral antebrachial cutaneous nerves, the palmar cutaneous branch of the median nerve; deeper, the anterior interosseous nerve." ;
    tara:hasLocationalDescription "On the anterior aspect of the forearm, between the tendons of the palmaris longus and the flexor carpi radialis, 3 B-cun proximal to the palmar wrist crease. Note 1: With the fist clenched, the wrist supinated and the elbow slightly flexed, the two tendons become more prominent. PC5 is located 3 B-cun proximal to PC7. Note 2: If the palmaris longus tendon is not present, PC5 is medial to the flexor carpi radialis tendon." ;
    tara:hasMeridian tara:TARA_4694897 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Jianshi" ;
    tara:hasRelatedLocation UBERON:0016496,
        ILX:0795334,
        ILX:0795500 ;
    tara:hasSurfaceLocation UBERON:0002386 ;
    tara:hasSynonym "P 5",
        "Pericardium 5" ;
    tara:hasVasculatureDescription "The median artery and vein; deeper, the anterior interosseous artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_1758929 ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795500 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4694897 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002386 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016496 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795334 ] ] .

tara:TARA_6499349 a owl:Class ;
    rdfs:label "LR 3" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 197. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "太衝(冲)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_1840369,
        tara:TARA_6705086 ;
    tara:hasIndicationsDescription "Headache, dizziness and vertigo, insomnia, congestion, swelling and pain of the eye, depression, infantile convulsion, deviation of the mouth, pain in the hypochondriac region, uterine bleeding, hernia, enuresis, retention of urine, epilepsy, pain in the anterior aspect of the medial malleolus." ;
    tara:hasInnervationDescription "The branch of the deep peroneal nerve." ;
    tara:hasLocationalDescription "On the dorsum of the foot, between the first and second metatarsal bones, in the depression distal to the junction of the bases of the two bones, over the dorsalis pedis artery. Note: LR3 can be felt in the depression when moving proximally from Lr2 in the gap between the first and second metatarsal bones towards the base of two metatarsal bones." ;
    tara:hasMeridian tara:TARA_5419503 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Taichong" ;
    tara:hasRelatedLocation UBERON:0001539,
        UBERON:0003650,
        UBERON:0003651 ;
    tara:hasSurfaceLocation UBERON:0002387 ;
    tara:hasSynonym "LIV 3",
        "LV 3",
        "Liver 3" ;
    tara:hasVasculatureDescription "The dorsal venous network of the foot, the first dorsal metatarsal artery." ;
