tara:TARA_7809864 a owl:Class ;
    rdfs:label "Front-Mu Point of the Spleen" ;
    dc:description "The Front-Mu Point of the Spleen meridian. Front-Mu points are those points on the chest and abdomen where the qi of the respective zang-fu organs is infused and converged. Located close to their corresponding zang-fu organs, the Front-Mu points play a significant role in the diagnosis and treatment of the disorders of the internal organs." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    tara:hasSpecialPointRole tara:TARA_8203632 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_8746709 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom tara:TARA_8203632 ] ) ] .

tara:TARA_7819406 a owl:Class ;
    rdfs:label "Major Luo-Connecting Point" ;
    dc:description "The Major Luo-Connecting Point is a Luo-Connecting point. Each of twelve main meridians has, on the limbs, a Luo-Connecting Point to link its exteriorly-interiorly related meridian. Each of the Governor and Conception vessels, and the Major Collateral of the spleen has its Luo-Connecting Point on the trunk. A Luo-Connecting Point is used to treat disorders involving the two exteriorly-interiorly related meridians and those in the area supplied by the two meridians." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    tara:hasSpecialPointRole tara:TARA_6035619 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_6993030 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom tara:TARA_6035619 ] ) ] .

tara:TARA_8063120 a owl:Class ;
    rdfs:label "Xi-Cleft Point of the Yin Link Vessel" ;
    dc:description "The Xi-Cleft Point of the Yin Link Vessel (an extra meridian). The Xi-Cleft Point is the site where the qi and blood of the meridian are deeply converged. The Xi-Cleft Point is used to treat acute disorders in the area supplied by its pertaining meridian and those of its pertaining zang or fu organ." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
