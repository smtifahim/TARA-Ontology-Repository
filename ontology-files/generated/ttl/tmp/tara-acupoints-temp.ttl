tara:TARA_0420802 a owl:Class ;
    rdfs:label "HT 1" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 82. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "極(极)泉" ;
    tara:hasIndicationsDescription "Pain in the costal and cardiac regions, scrofula, cold pain of the elbow and arm, dryness of the throat." ;
    tara:hasInnervationDescription "The ulnar nerve, median nerve and medial brachial cutaneous nerve." ;
    tara:hasLocationalDescription "In the axilla, in the centre of the axillary fossa, over the axillary artery." ;
    tara:hasMeridian tara:TARA_9474009 ;
    tara:hasMethodDescription "Avoid puncturing the axillary artery. Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Jiquan" ;
    tara:hasRelatedLocation UBERON:0001394,
        ILX:0795309 ;
    tara:hasSurfaceLocation UBERON:0009472 ;
    tara:hasSynonym "H 1",
        "HE 1",
        "Heart 1" ;
    tara:hasVasculatureDescription "Laterally, the axillary artery." ;
