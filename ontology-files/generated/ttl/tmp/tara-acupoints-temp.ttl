        ILX:0795333,
        ILX:0795336,
        ILX:0795337 ;
    tara:hasSurfaceLocation UBERON:0004452 ;
    tara:hasSynonym "Large Intestine 5" ;
    tara:hasVasculatureDescription "The cephalic vein, the radial artery and its dorsal carpal branch." ;
