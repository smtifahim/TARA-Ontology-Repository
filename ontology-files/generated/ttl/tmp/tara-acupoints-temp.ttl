tara:TARA_1926756 a owl:Class ;
    rdfs:label "Acupoint of the Gallbladder Meridian" ;
    dc:description "An acupuncture point that is located along the Gallbladder Meridian of Foot-Shaoyang (GB), which consists of 44 standardized acupoints beginning at GB 1 (Tongziliao) on the head in the depression lateral to the outer canthus of the eye, zigzagging across the temporal and occipital regions of the head and descending along the lateral side of the neck, trunk, and leg, and ending at GB 44 (Zuqiaoyin) on the lateral side of the fourth toe near the corner of the nail." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    tara:hasSynonym "Acupoint of the gallbladder meridian of foot-shaoyang",
        "Acupuncture point of the gallbladder meridian",
        "Acupuncture point of the gallbladder meridian of foot-shaoyang",
        "GB" ;
    tara:isLocatedOnMeridian tara:TARA_5283975 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ] .

tara:TARA_1985889 a owl:Class ;
    rdfs:label "BL 11" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 105. https://iris.who.int/handle/10665/353407",
