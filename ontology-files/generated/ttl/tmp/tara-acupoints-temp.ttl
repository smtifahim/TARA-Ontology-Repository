tara:TARA_5804897 a owl:Class ;
    rdfs:label "CV 23" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 231. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "廉泉" ;
    tara:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara:hasIndicationsDescription "swelling and pain of the subglossal region, salivation with glossoplegia, aphasia with stiffness of tongue by apoplexy, sudden hoarseness of the voice, difficulty in swallowing." ;
    tara:hasInnervationDescription "The branch of the cutaneous cervical nerve, the hypoglossal nerve, and the branch of the glossopharyngeal nerve." ;
    tara:hasLocationalDescription "In the anterior region of the neck, superior to superior border to thyroid cartilage, in the depression superior to the hyoid bone, on the anterior median line. Note: With the head slightly extended, the hyoid tubercle can be palpated between the mandible and the thyroid cartilage." ;
    tara:hasMethodDescription "Puncture obliquely 0.5-1.0 inch toward the tongue root. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Lianquan" ;
    tara:hasSpecificSurfaceLocation UBERON:0001684,
        UBERON:0001685,
        UBERON:0001738,
        ILX:0795285,
        ILX:0795328 ;
    tara:hasSynonym "Conception Vessel 23",
        "RN 23",
        "Ren 23",
        "VC 23" ;
    tara:hasVasculatureDescription "The anterior jugular vein." ;
    tara:isLocatedOnMeridian tara:TARA_6789717 ;
