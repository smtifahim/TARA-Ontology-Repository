            owl:intersectionOf ( tara:TARA_3861175 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom tara:TARA_3996418 ] ) ] .

tara:TARA_7083740 a owl:Class ;
    rdfs:label "Influential Point of the Fu Organs" ;
    dc:description "One of the eight influential points, the Influential Point of the Fu Organs can be employed to treat disorders of the Fu organs. Zhongwan (CV 12) is the Influential Point of the Fu organs." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    tara:hasSpecialPointRole tara:TARA_5906686 ;
