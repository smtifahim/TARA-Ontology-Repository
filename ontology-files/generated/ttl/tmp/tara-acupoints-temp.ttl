tara:TARA_2465151 a owl:Class ;
    rdfs:label "BL 31" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 115. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "上髎(髎)" ;
    tara:hasGeneralSurfaceLocation UBERON:0005473 ;
    tara:hasIndicationsDescription "low back pain, dysuria, constipation, irregular menstruation, morbid leukorrhea, prolapse of the uterus." ;
    tara:hasInnervationDescription "At the site where the posterior ramus of the first sacral nerve passes." ;
    tara:hasLocationalDescription "In the sacral region, in the first posterior sacral foramen. Note: The first posterior sacral foramen is palpated in the depression, moving superiorly from BL32." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Shangliao" ;
    tara:hasSpecificSurfaceLocation ILX:0795313 ;
    tara:hasSynonym "B 31",
        "Bladder 31",
        "UB 31",
        "Urinary Bladder 31" ;
    tara:hasVasculatureDescription "The posterior branches of the lateral sacral artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
