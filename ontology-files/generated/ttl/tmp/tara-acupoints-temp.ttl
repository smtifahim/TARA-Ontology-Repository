    tara:hasChineseLabel "承漿(浆)" ;
    tara:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara:hasIndicationsDescription "facial puffiness, swelling of the gums, toothache, salivation, mental disorder, deviation of the eye and mouth." ;
    tara:hasInnervationDescription "The branch of the facial nerve." ;
    tara:hasLocationalDescription "On the face, in the depression in the centre of the mentolabial sulcus." ;
    tara:hasMethodDescription "Puncture obliquely upward 0.2-0.3 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Chengjiang" ;
    tara:hasSpecificSurfaceLocation ILX:0795327 ;
    tara:hasSynonym "Conception Vessel 24",
        "RN 24",
        "Ren 24",
        "VC 24" ;
    tara:hasVasculatureDescription "The branches of the inferior labial artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_6789717 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795327 ] ],
