        UBERON:0010230,
        UBERON:0035848 ;
    tara:hasSynonym "S 1",
        "Stomach 1" ;
    tara:hasVasculatureDescription "The branches of the infraorbital artery and infraorbital vein, and ophthalmic artery and ophthalmic veins." ;
    tara:isLocatedOnMeridian tara:TARA_6221269 ;
