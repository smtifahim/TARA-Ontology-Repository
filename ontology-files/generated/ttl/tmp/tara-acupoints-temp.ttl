                    owl:someValuesFrom UBERON:0004633 ] ] .

tara:TARA_8104948 a owl:Class ;
    rdfs:label "BL 2" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 100. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "攢(攒,攅)竹" ;
    tara:hasIndicationsDescription "Headache, blurring and failing of vision, pain in the supraorbital region, lacrimation, redness, swelling and pain of the eye, twitching of eyelids, glaucoma." ;
    tara:hasInnervationDescription "The medial branch of the frontal nerve." ;
    tara:hasLocationalDescription "On the head, in the depression at the medial end of the eyebrow. Note: A depression, the frontal notch, can often be palpated on the medial end of the eyebrow directly superior to BL1." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch, or prick with three-edged needle to cause bleeding." ;
    tara:hasPinyinLabel "Zanzhu" ;
    tara:hasRelatedLocation UBERON:0010163,
        ILX:0741726 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "B 2",
        "Bladder 2",
        "UB 2",
        "Urinary Bladder 2" ;
    tara:hasVasculatureDescription "The frontal artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0010163 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0741726 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ] .

tara:TARA_8107205 a owl:Class ;
    rdfs:label "LI 7" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 37. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "溫(温)溜" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_4598552 ;
    tara:hasIndicationsDescription "Headache, swelling of the face, sore throat, borborygmus, abdominal pain, aching of the shoulder and arm." ;
    tara:hasInnervationDescription "The posterior antebrachial cutaneous nerve and the deep ramus of the radial nerve." ;
    tara:hasLocationalDescription "On the posterolateral aspect of the forearm, on the line connecting LI5 with LI11, 5 B- cun superior to the dorsal wrist crease." ;
    tara:hasMeridian tara:TARA_4610474 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Wenliu" ;
