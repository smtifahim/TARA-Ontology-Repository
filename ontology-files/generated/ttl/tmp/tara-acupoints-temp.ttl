            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4610474 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0006807 ] ] .

tara:TARA_9586774 a owl:Class ;
    rdfs:label "GV 7" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 207. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "中樞(枢)" ;
    tara:hasIndicationsDescription "Pain in the epigastric region, low back pain, stiffness of the back." ;
    tara:hasInnervationDescription "The medial branch of the posterior ramus of the tenth thoracic nerve." ;
    tara:hasLocationalDescription "In the upper back region, in the depression inferior to the spinous process of the tenth thoracic vertebra (T10), on the posterior median line." ;
    tara:hasMeridian tara:TARA_0386099 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Zhongshu" ;
    tara:hasRelatedLocation UBERON:0004634,
        ILX:0795312 ;
    tara:hasSurfaceLocation UBERON:0008231 ;
    tara:hasSynonym "Du 7",
        "Governor Vessel 7" ;
    tara:hasVasculatureDescription "The posterior branch of the tenth intercostal artery." ;
