tara:TARA_9492402 a owl:Class ;
    rdfs:label "Jianqian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasIndicationsDescription "Pain in the shoulder and arm, paralysis of the upper extremities." ;
    tara:hasLocationalDescription "Midway between the end of the anterior axillary fold and Jianyu (LI 15)." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara:hasSynonym "Jianneiling",
        "M-UE 48" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_9523348 a owl:Class ;
    rdfs:label "BL 14" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 106. https://iris.who.int/handle/10665/353407",
