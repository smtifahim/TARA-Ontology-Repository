tara:TARA_4125415 a owl:Class ;
    rdfs:label "SI 6" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 90. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "養(养)老" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_4598552 ;
    tara:hasIndicationsDescription "Blurring of vision, pain in the shoulder, elbow and arm." ;
    tara:hasInnervationDescription "The anastomotic branches of the posterior antebrachial cutaneous nerve and the dorsal branch of the ulnar nerve." ;
    tara:hasLocationalDescription "On the posteromedial aspect of the forearm, in the depression radial to the head of the ulnar bone, 1 B-cun proximal to the dorsal wrist crease. Note: With the palm facing downwards, press the highest point of the head of ulnar bone with a finger, and then turn the palm towards the chest; SI6 is located at the cleft between the bones where the finger slides." ;
    tara:hasMeridian tara:TARA_9093316 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Yanglao" ;
    tara:hasRelatedLocation UBERON:0001424,
        ILX:0795333 ;
    tara:hasSurfaceLocation UBERON:0002386 ;
    tara:hasSynonym "Small Intestine 6" ;
    tara:hasVasculatureDescription "The terminal branches of the posterior interosseous artery and vein, the dorsal venous network of the wrist." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_9093316 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_2798650 ],
