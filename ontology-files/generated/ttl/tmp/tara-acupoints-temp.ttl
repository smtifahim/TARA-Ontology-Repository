tara:TARA_3761087 a owl:Class ;
    rdfs:label "Acupoint of the Pericardium Meridian" ;
    dc:description "An acupuncture point that is located along the Pericardium Meridian of Hand-Jueyin (PC), which consists of 9 standardized acupoints beginning at PC 1 (Tianchi) on the anterior chest in the fourth intercostal space lateral to the nipple, traveling down the middle of the anterior aspect of the arm, and ending at PC 9 (Zhongchong) at the center of the tip of the middle finger." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7." ;
    tara:hasMeridian tara:TARA_4694897 ;
    tara:hasSynonym "Acupoint of the pericardium meridian of hand-jueyin",
        "Acupuncture point of the pericardium meridian",
        "Acupuncture point of the pericardium meridian of hand-jueyin",
        "PC" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_4694897 ] ) ] .

tara:TARA_3770332 a owl:Class ;
    rdfs:label "GB 39" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 191. ISBN 978-92-9061-248-7.

