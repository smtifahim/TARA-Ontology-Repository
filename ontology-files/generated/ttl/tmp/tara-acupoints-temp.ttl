tara:TARA_5828993 a owl:Class ;
    rdfs:label "TE 15" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 165. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "天髎(髎)" ;
    tara:hasGeneralSurfaceLocation ILX:0795319 ;
    tara:hasIndicationsDescription "pain in the shoulder and elbow, stiffness of the neck." ;
    tara:hasInnervationDescription "The accessory nerve and the branch of the suprascapular nerve." ;
    tara:hasLocationalDescription "In the scapular region, in the depression superior to the superior angle of the scapula. Note: With the upper limb hanging by the side of trunk in a seated position, TE15 is located midway between gB21 and SI13." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Tianliao" ;
    tara:hasSpecificSurfaceLocation UBERON:0006849 ;
    tara:hasSynonym "SJ 15",
        "San Jiao 15",
        "TB 15",
        "TH 15",
        "TW 15",
        "Triple Burner 15",
        "Triple Energizer 15",
        "Triple Heater 15",
        "Triple Warmer 15" ;
    tara:hasVasculatureDescription "The descending branch of the transverse cervical artery; deeper, the muscular branch of the suprascapular artery." ;
    tara:isLocatedOnMeridian tara:TARA_3898257 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0006849 ] ],
