    tara:hasSpecificSurfaceLocation ILX:0795283,
        ILX:0795284,
        ILX:0795285 ;
    tara:hasSynonym "Front-Mu Point of the Lung",
        "L 1",
        "Lung 1" ;
    tara:hasVasculatureDescription "Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein." ;
