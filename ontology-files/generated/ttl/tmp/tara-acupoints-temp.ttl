tara:TARA_6924908 a owl:Class ;
    rdfs:label "GV 25" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 216. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "素髎(髎)" ;
    tara:hasIndicationsDescription "Loss of consciousness, nasal obstruction, epistaxis, rhinorrhea, rosacea." ;
    tara:hasInnervationDescription "The external nasal branch of the anterior ethmoidal nerve." ;
    tara:hasLocationalDescription "On the face, at the tip of the nose." ;
    tara:hasMeridian tara:TARA_0386099 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.2-0.3 inch, or prick to cause bleeding." ;
    tara:hasPinyinLabel "Suliao" ;
    tara:hasRelatedLocation UBERON:0000004,
        UBERON:0012128 ;
    tara:hasSurfaceLocation UBERON:0001456 ;
    tara:hasSynonym "Du 25",
        "Governor Vessel 25" ;
    tara:hasVasculatureDescription "The lateral nasal branches of the facial artery and vein." ;
