    tara:hasSurfaceLocation UBERON:0002398,
        UBERON:0008878 ;
    tara:hasSynonym "P 8",
        "Pericardium 8" ;
    tara:hasVasculatureDescription "The Common palmar digital artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
