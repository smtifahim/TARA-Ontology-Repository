tara:TARA_8300996 a owl:Class ;
    rdfs:label "GV 11" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 209. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "神(神)道(道)" ;
    tara:hasIndicationsDescription "Poor memory, anxiety, palpitation, pain and stiffness of the back, cough, cardiac pain." ;
    tara:hasInnervationDescription "The medial branch of the posterior ramus of the fifth thoracic nerve." ;
    tara:hasLocationalDescription "In the upper back region, in the depression inferior to the spinous process of the fifth thoracic vertebra (T5), on the posterior median line." ;
    tara:hasMeridian tara:TARA_0386099 ;
    tara:hasMethodDescription "Puncture obliquely upward 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Shendao" ;
    tara:hasRelatedLocation UBERON:0004630,
        ILX:0795312 ;
    tara:hasSurfaceLocation UBERON:0008231 ;
    tara:hasSynonym "Du 11",
        "Governor Vessel 11" ;
    tara:hasVasculatureDescription "The posterior branch of the' fifth intercostal artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004630 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_0386099 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795312 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0008231 ] ] .

tara:TARA_8343475 a owl:Class ;
    rdfs:label "Bitong" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Rhinitis, nasal obstruction, nasal boils." ;
    tara:hasLocationalDescription "At the highest point of the nasolabial groove." ;
    tara:hasMethodDescription "Puncture subcutaneously upward 0.3-0.5 inch." ;
    tara:hasSynonym "M-HN 14" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_8364824 a owl:Class ;
    rdfs:label "Acupoint of the Governor Vessel" ;
    dc:description "An acupuncture point that is located along the Governor Vessel (GV / Du Mai), one of the eight extraordinary vessels, which consists of 28 standardized acupoints beginning at GV 1 (Changqiang) in the perineal region midway between the tip of the coccyx and the anus, traveling up along the posterior midline of the body over the spine and across the top of the head, and ending at GV 28 (Yinjiao) in the oral cavity at the frenulum of the upper lip." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7." ;
    tara:hasMeridian tara:TARA_0386099 ;
    tara:hasSynonym "Acupoint of the Du channel",
        "Acupuncture point of the Du channel",
        "Du",
        "GV" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_0386099 ] ) ] .

tara:TARA_8393005 a owl:Class ;
    rdfs:label "TE 5" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 160. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "外關(关,関)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_6993030,
        tara:TARA_9493899 ;
    tara:hasIndicationsDescription "Febrile diseases, headache, pain in the cheek, strained neck, deafness, tinnitus, pain in the hypochondriac region, motor impairment of the elbow and arm, pain of the fingers, hand tremor." ;
    tara:hasInnervationDescription "The posterior antebrachial cutaneous nerve; deeper, the posterior interosseous nerve and the anterior interosseous nerve." ;
    tara:hasLocationalDescription "On the posterior aspect of the forearm, midpoint of the interosseous space between the radius and the ulna, 2 B-cun proximal to the dorsal wrist crease. Note: 2 B-cun proximal to TE4, in the depression between the radius and the ulna. The anterior point corresponding to TE5 is PC6." ;
    tara:hasMeridian tara:TARA_3898257 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Waiguan" ;
    tara:hasRelatedLocation UBERON:0001423,
        UBERON:0001424,
        UBERON:0006508,
        ILX:0795333 ;
    tara:hasSurfaceLocation UBERON:0002386 ;
    tara:hasSynonym "SJ 5",
        "San Jiao 5",
        "TB 5",
        "TH 5",
        "TW 5",
        "Triple Burner 5",
        "Triple Energizer 5",
        "Triple Heater 5",
        "Triple Warmer 5" ;
    tara:hasVasculatureDescription "Deeper, the posterior and anterior antebrachial interosseous arteries and veins." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_3091322 ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002386 ] ],
