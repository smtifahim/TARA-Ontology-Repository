tara:TARA_7226516 a owl:Class ;
    rdfs:label "Meridian" ;
    IAO:0000115 "A one-dimensional continuant fiat boundary, demarcated by convention within traditional Chinese medicine theory rather than by any natural physical discontinuity in the body, along which Acupoints are located." ;
    dc:description "In traditional Chinese Medicine (TCM), meridians are strings connecting acupuncture points, which are considered as passageways through which energy flows throughout the body. The meridian system is composed of 12 principal meridians, each of which connects to an organ system and extends to an extremity and eight collaterals." ;
    dcterms:bibliographicCitation "Maurer, N., Nissel, H., Egerbacher, M., Gornik, E., Schuller, P., & Traxler, H. (2019). Anatomical evidence of acupuncture meridians in the human extracellular matrix: results from a macroscopic and microscopic interdisciplinary multicentre study on human corpses. Evidence-Based Complementary and Alternative Medicine, 2019. https://doi.org/10.1155/2019/6976892" ;
    tara:hasSynonym "Acupuncture meridian" ;
    rdfs:subClassOf BFO:0000009 .

tara:TARA_0886544 a owl:Class ;
    rdfs:label "Special Point on the Head and Trunk Role" ;
    rdfs:subClassOf tara:TARA_4176111 .

tara:TARA_1787498 a owl:Class ;
    rdfs:label "Shu Point" ;
    dc:description "Represents one of the five Shu Points. Each of the twelve main meridians has, below the elbow or knee, five specific points, namely, Jing-Well, Ying-Spring, Shu-Stream, Jing-River and He-Sea, which are termed Five Shu points in general. They are situated in the above order from the distal end of extremities to the elbow or knee. It is said in the first chapter of Miraculous Pivot that \"the qi of the twelve main meridians and fifteen collaterals flow all over the body. The flow of qi running in the meridians from the extremities to the elbow or knee is flourishing gradually.\" The names of the five shu points image the flow of meridian qi as the flow of water." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    tara:hasSpecialPointRole tara:TARA_1375080 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_4943316 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom tara:TARA_1375080 ] ) ] .

tara:TARA_4943316 a owl:Class ;
    rdfs:label "Special Point on the Limbs" ;
    dc:description "A special, specific acupoint located on the Limbs. Specific points refer to those of the fourteen meridians that have special properties and are grouped under special names. Specific Points on the Limbs include: (1) Five Shu Points, (2) Yuan-Primary Points, (3) Luo-Conneetiog Points, (4) Xi-Cleft Points, and (5) Eight Confluent Points." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    tara:hasSpecialPointRole tara:TARA_8173108 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_7852472 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom tara:TARA_8173108 ] ) ] .

tara:hasAcupointDescription a owl:AnnotationProperty ;
    rdfs:label "Acupoint Description" ;
    dc:description "An annotation property grouping all textual descriptive attributes of an acupoint, including its anatomical location, needling method, indications, vasculature, and innervation. Subproperties further specialize the type of description." ;
    rdfs:subPropertyOf tara:hasAcupointAnnotaionProperty .

