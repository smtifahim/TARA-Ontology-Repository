    tara:hasSurfaceLocation ILX:0795301 ;
    tara:hasSynonym "S 19",
        "Stomach 19" ;
    tara:hasVasculatureDescription "The branches of the seventh intercostal artery and vein, the branches of the superior epigastric artery and vein." ;
