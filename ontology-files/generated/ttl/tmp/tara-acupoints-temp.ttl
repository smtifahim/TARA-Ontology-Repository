tara:TARA_5318530 a owl:Class ;
    rdfs:label "BL 28" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 113. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "膀胱兪(俞)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_6484209 ;
    tara:hasInnervationDescription "The lateral branches of the posterior rami of the first and second sacral nerves." ;
    tara:hasLocationalDescription "In the sacral region, at the same level as the second posterior sacral foramen, and 1.5 B-cun lateral to the median sacral crest. Note: At the same level as BL32." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Pangguangshu" ;
    tara:hasRelatedLocation ILX:0741680,
        ILX:0795314 ;
    tara:hasSurfaceLocation UBERON:0005473 ;
    tara:hasSynonym "B 28",
        "Back-Shu Point of the Bladder",
        "Bladder 28",
        "UB 28",
        "Urinary Bladder 28" ;
    tara:hasVasculatureDescription "The posterior branches of the lateral sacral artery and vein." ;
    rdfs:subClassOf [ a owl:Class ;
