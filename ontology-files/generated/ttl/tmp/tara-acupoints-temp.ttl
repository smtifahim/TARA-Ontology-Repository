tara:TARA_9927213 a owl:Class ;
    rdfs:label "BL 36" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 117. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "承扶" ;
    tara:hasGeneralSurfaceLocation UBERON:0013691 ;
    tara:hasIndicationsDescription "pain in the lower back and gluteal region, constipation, muscular atrophy, pain, numbness and motor impairment of the lower extremities." ;
    tara:hasInnervationDescription "The posterior femoral cutaneous nerve; deeper, the sciatic nerve." ;
    tara:hasLocationalDescription "In the buttock region, at the midpoint of the gluteal fold." ;
    tara:hasMethodDescription "Puncture perpendicularly 1.0-1.5 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Chengfu" ;
    tara:hasSpecificSurfaceLocation UBERON:0036014 ;
    tara:hasSynonym "B 36",
        "Bladder 36",
        "UB 36",
        "Urinary Bladder 36" ;
    tara:hasVasculatureDescription "The artery and vein running alongside the sciatic nerve." ;
    tara:isLocatedOnMeridian tara:TARA_7525476 ;
