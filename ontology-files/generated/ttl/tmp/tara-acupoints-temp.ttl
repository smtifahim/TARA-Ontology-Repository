tara:TARA_5047952 a owl:Class ;
    rdfs:label "LR 14 (Female)" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 202. https://iris.who.int/handle/10665/353407",
