    tara:hasSpecialPointRole tara:TARA_4598552 ;
    tara:hasSpecificSurfaceLocation UBERON:0001379,
        UBERON:0002446,
        UBERON:0014848 ;
    tara:hasSynonym "S 34",
        "Stomach 34" ;
    tara:isLocatedOnMeridian tara:TARA_6221269 ;
