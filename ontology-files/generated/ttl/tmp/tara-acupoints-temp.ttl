tara:TARA_0214009 a owl:Class ;
    rdfs:label "GB 24" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 183. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "日月" ;
    tara:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara:hasIndicationsDescription "pain in the hypochondriac region, vomiting, acid regurgitation, hiccup, jaundice, mastitis." ;
    tara:hasInnervationDescription "The seventh intercostal nerve." ;
    tara:hasLocationalDescription "In the anterior thoracic region, in the sev- enth intercostal space, 4 B-cun lateral to the anterior median line. Note 1: GB 24 is inferior to the centre of the nipple, one rib inferior to LR 14. Note 2: In females, GB24 can be found at the intersection of the midclavicular line and the seventh intercostal space." ;
    tara:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Riyue" ;
    tara:hasSpecialPointRole tara:TARA_4192840 ;
    tara:hasSpecificSurfaceLocation UBERON:0002030,
        ILX:0795285,
        ILX:0795321,
        ILX:0795322 ;
    tara:hasSynonym "Front-Mu Point of the Gallbladder",
        "G 24",
        "Gallbladder 24" ;
    tara:hasVasculatureDescription "The seventh intercostal artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795321 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002030 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795322 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom tara:TARA_9940480 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016416 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ] .

tara:TARA_0926802 a owl:Class ;
    rdfs:label "Xiyan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasGeneralSurfaceLocation UBERON:0001465 ;
    tara:hasIndicationsDescription "Knee pain, weakness of the lower extremities." ;
    tara:hasLocationalDescription "A pair of points in the two depressions, medial and lateral to the patellar ligament, locating the point with the knee flexed. These two points are also termed medial and lateral Xiyan respectively. Lateral Xiyan overlaps with Dubi (ST 35)." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5- 1.0 inch. Moxibustion is applicable." ;
    tara:hasSpecificSurfaceLocation UBERON:0003676 ;
    tara:hasSynonym "EX-LE 5",
        "M-LE 16" ;
