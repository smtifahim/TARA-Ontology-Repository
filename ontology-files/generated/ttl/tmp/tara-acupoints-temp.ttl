                    owl:someValuesFrom UBERON:0001690 ] ] .

tara:TARA_8866697 a owl:Class ;
    rdfs:label "Acupoint of the Kidney Meridian" ;
    dc:description "An acupuncture point that is located along the Kidney Meridian of Foot-Shaoyin (KI), which consists of 27 standardized acupoints beginning at KI 1 (Yongquan) on the sole of the foot in the depression formed when the toes are flexed, traveling up along the medial aspect of the leg and continuing up the abdomen and chest close to the midline, and ending at KI 27 (Shufu) on the anterior chest in the depression at the inferior border of the clavicle." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    tara:hasSynonym "Acupoint of the kidney meridian of foot-shaoyin",
        "Acupuncture point of the kidney meridian",
        "Acupuncture point of the kidney meridian of foot-shaoyin",
        "KI" ;
    tara:isLocatedOnMeridian tara:TARA_4813389 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom tara:TARA_4813389 ] ) ] .

tara:TARA_8876235 a owl:Class ;
    rdfs:label "TE 19" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 167. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "顱(颅)息" ;
    tara:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara:hasIndicationsDescription "headache, tinnitus, deafness, pain in the ear, infantile convulsion." ;
    tara:hasInnervationDescription "The anastomotic branch of the great auricular nerve and the lesser occipital nerve." ;
    tara:hasLocationalDescription "On the head, at the junction of the upper one third and lower two thirds of the curved line from tE17 to tE20." ;
    tara:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Luxi" ;
    tara:hasSynonym "SJ 19",
        "San Jiao 19",
        "TB 19",
        "TH 19",
        "TW 19",
        "Triple Burner 19",
        "Triple Energizer 19",
        "Triple Heater 19",
        "Triple Warmer 19" ;
    tara:hasVasculatureDescription "The posterior auricular artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_3898257 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
