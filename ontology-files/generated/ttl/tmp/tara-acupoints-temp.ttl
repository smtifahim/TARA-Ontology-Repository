tara:TARA_7218725 a owl:Class ;
    rdfs:label "BL 67" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 133. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "至陰(阴)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_2954517 ;
    tara:hasIndicationsDescription "Headache, nasal obstruction, epistaxis, ophthalmalgia, malposition of fetus, difficult labour, detention of after birth, feverish sensation in the sole." ;
    tara:hasInnervationDescription "The plantar digital proprial nerve and the lateral dorsal cutaneous nerve of foot." ;
    tara:hasLocationalDescription "On the little toe, lateral to the distal pha- lanx, 0.1 f-cun proximal to the lateral corner of the toenail; at the intersection of the vertical line of the lateral side of the nail and the horizontal line of the base of the toenail." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture superficially 0.1 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Zhiyin" ;
    tara:hasRelatedLocation UBERON:0009567 ;
    tara:hasSurfaceLocation UBERON:0003635 ;
    tara:hasSynonym "B 67",
        "Bladder 67",
        "UB 67",
        "Urinary Bladder 67" ;
    tara:hasVasculatureDescription "The network formed by the dorsal digital artery and plantar digital proprial artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003635 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
