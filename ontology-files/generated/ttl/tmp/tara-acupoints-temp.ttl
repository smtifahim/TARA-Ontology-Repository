tara:TARA_5220479 a owl:Class ;
    rdfs:label "Lateral Xiyan" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Knee pain, weakness of the lower extremities." ;
    tara:hasLocationalDescription "A Xiyan point located in the depression, lateral to the patellar ligament, locating the point with the knee flexed. Lateral Xiyan overlaps with Dubi (ST 35)." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5- 1.0 inch. Moxibustion is applicable." ;
    tara:hasRelatedLocation UBERON:0003676 ;
    tara:hasSurfaceLocation UBERON:0001465 ;
    rdfs:subClassOf [ a owl:Restriction ;
