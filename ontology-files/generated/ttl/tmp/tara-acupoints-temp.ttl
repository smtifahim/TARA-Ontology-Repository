tara:TARA_0478496 a owl:Class ;
    rdfs:label "GB 7" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 175. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "曲鬢(鬓)" ;
    tara:hasIndicationsDescription "Headache, swelling of the cheek, trismus, pain in the temporal region, infantile convulsion." ;
    tara:hasLocationalDescription "On the head, at the junction of the vertical line of the posterior border of the temple hairline and the horizontal line of the apex of the auricle." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Qubin" ;
    tara:hasRelatedLocation UBERON:0001690,
        UBERON:0004104 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "G 7",
        "Gallbladder 7" ;
    tara:hasVasculatureDescription "See Hanyan (GB 4)." ;
