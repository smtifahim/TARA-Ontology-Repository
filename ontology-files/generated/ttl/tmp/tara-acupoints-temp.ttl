tara:TARA_0022762 a owl:Class ;
    rdfs:label "CV 3" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 221. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "中極(极)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_5308180 ;
    tara:hasIndicationsDescription "Enuresis, nocturnal emission, impotence, hernia, uterine bleeding, irregular menstruation, dysmenorrhea, morbid leukorrhea, frequency of urination, retention of urine, pain in the lower abdomen, prolapse of the uterus, vaginitis." ;
    tara:hasInnervationDescription "The branch of the iliohypogastric nerve." ;
    tara:hasLocationalDescription "On the lower abdomen, 4 B-cun inferior to the centre of the umbilicus, on the anterior median line." ;
    tara:hasMeridian tara:TARA_6789717 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Zhongji" ;
    tara:hasRelatedLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSurfaceLocation ILX:0795303 ;
    tara:hasSynonym "Conception Vessel 3",
        "Front-Mu Point of the Bladder",
        "RN 3",
        "Ren 3" ;
    tara:hasVasculatureDescription "The branches of superficial epigastric artery and vein, and the branches of inferior epigastric artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_1670028 ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795303 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6789717 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0007118 ] ] .

tara:TARA_0093665 a owl:Class ;
    rdfs:label "BL 61" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 130. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "僕(仆)參(参)" ;
    tara:hasIndicationsDescription "Muscular atrophy and weakness of the lower extremities, pain in the heel." ;
    tara:hasInnervationDescription "The external calcaneal branch of the sural nerve." ;
    tara:hasLocationalDescription "On the lateral aspect of the foot, distal to BL60, lateral to the calcaneus, at the border between the red and white flesh." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Pucan",
        "Pushen" ;
    tara:hasRelatedLocation UBERON:0001450 ;
    tara:hasSurfaceLocation UBERON:0002387 ;
    tara:hasSynonym "B 61",
        "Bladder 61",
        "UB 61",
        "Urinary Bladder 61" ;
    tara:hasVasculatureDescription "The external calcaneal branches of the peroneal artery and vein." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001450 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002387 ] ] .

tara:TARA_0095074 a owl:Class ;
    rdfs:label "ST 5" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 48. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "大迎(迎)" ;
    tara:hasIndicationsDescription "Facial paralysis, trismus, swelling of the cheek, facial pain, toothache." ;
    tara:hasInnervationDescription "The facial and buccal nerves." ;
    tara:hasLocationalDescription "On the face, anterior to the angle of the mandible, in the depression anterior to the masseter attachment, over the facial artery." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Avoid puncturing the artery. Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Daying" ;
    tara:hasRelatedLocation UBERON:0001597,
        UBERON:0001612,
        UBERON:0001684 ;
    tara:hasSurfaceLocation UBERON:0001456 ;
    tara:hasSynonym "S 5",
        "Stomach 5" ;
    tara:hasVasculatureDescription "Anteriorly, the facial artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001456 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001612 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001684 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001597 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6221269 ] ) ] .

tara:TARA_0220496 a owl:Class ;
    rdfs:label "SI 3" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 89. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "後(后)谿(溪)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_6705086,
        tara:TARA_9493899 ;
    tara:hasIndicationsDescription "Pain and rigidity of the neck, tinnitus, deafness, sore throat, mania, malaria, acute lumbar sprain, night sweating, febrile diseases, contracture and numbness of the fingers, pain in the shoulder and elbow." ;
    tara:hasInnervationDescription "The dorsal branch derived from the ulnar nerve." ;
    tara:hasLocationalDescription "On the little finger, ulnar to the distal phalanx, 0.1 f-cun proximal-medial to the ulnar corner of the little fingernail, at the intersection of the vertical line of ulnar border of the nail and horizontal line of the base of the little fingernail." ;
    tara:hasMeridian tara:TARA_9093316 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Houxi" ;
    tara:hasRelatedLocation UBERON:0004300,
        UBERON:0011277 ;
    tara:hasSurfaceLocation UBERON:0003625 ;
    tara:hasSynonym "Small Intestine 3" ;
    tara:hasVasculatureDescription "The dorsal digital artery and vein, the dorsal venous network of the hand." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004300 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_9093316 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_3091322 ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003625 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_1716565 ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0011277 ] ] .

tara:TARA_0228386 a owl:Class ;
    rdfs:label "TE 18" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 166. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "瘈脈(脉)" ;
    tara:hasIndicationsDescription "Headache, tinnitus, deafness, infantile convulsion." ;
    tara:hasInnervationDescription "The posterior auricular branch of the great auricular nerve." ;
    tara:hasLocationalDescription "On the head, at the centre of the mastoid process, at the junction of the upper two thirds and lower one third of the curved line from tE17 to tE20." ;
    tara:hasMeridian tara:TARA_3898257 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch or prick with a three-edged needle to cause bleeding. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Chimai",
        "Qimai" ;
    tara:hasRelatedLocation UBERON:0011220 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "SJ 18",
        "San Jiao 18",
        "TB 18",
        "TH 18",
        "TW 18",
        "Triple Burner 18",
        "Triple Energizer 18",
        "Triple Heater 18",
        "Triple Warmer 18" ;
    tara:hasVasculatureDescription "The posterior auricular artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_3898257 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0011220 ] ] .

tara:TARA_0242146 a owl:Class ;
    rdfs:label "BL 10" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 104. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "天柱" ;
    tara:hasIndicationsDescription "Headache, nasal obstruction, sore throat, neck rigidity, pain in the shoulder and back." ;
    tara:hasInnervationDescription "The great occipital nerve." ;
    tara:hasLocationalDescription "In the posterior region of the neck, at the same level as the superior border of the spinous process of the second cervical vertebra (C2), in the depression lateral to the trapezius muscle." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch." ;
    tara:hasPinyinLabel "Tianzhu" ;
    tara:hasRelatedLocation UBERON:0001093,
        UBERON:0002380 ;
    tara:hasSurfaceLocation UBERON:0000974 ;
    tara:hasSynonym "B 10",
        "Bladder 10",
        "UB 10",
        "Urinary Bladder 10" ;
    tara:hasVasculatureDescription "The occipital artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002380 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001093 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ] .

tara:TARA_0287877 a owl:Class ;
    rdfs:label "SI 18" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 96. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "顴(颧)髎(髎)" ;
    tara:hasIndicationsDescription "Facial paralysis, twitching of eyelids, pain in the face, toothache, swelling of the cheek, yellowish sclera." ;
    tara:hasInnervationDescription "The facial and infraorbital nerves." ;
    tara:hasLocationalDescription "On the face, inferior to the zygomatic bone, in the depression directly inferior to the outer canthus of the eye." ;
    tara:hasMeridian tara:TARA_9093316 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch." ;
    tara:hasPinyinLabel "Quanliao" ;
    tara:hasRelatedLocation UBERON:0000019,
        UBERON:0001683,
        UBERON:0006726 ;
    tara:hasSurfaceLocation UBERON:0001456 ;
    tara:hasSynonym "Small Intestine 18" ;
    tara:hasVasculatureDescription "The branches of the transverse facial artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001683 ] ],
