tara:TARA_0739106 a owl:Class ;
    rdfs:label "Acupoint of the Liver Meridian" ;
    dc:description "An acupuncture point that is located along the Liver Meridian of Foot-Jueyin (LR), which consists of 14 standardized acupoints beginning at LR 1 (Dadun) on the lateral side of the great toe near the corner of the nail, traveling up along the medial aspect of the leg and passing through the genital region and abdomen, and ending at LR 14 (Qimen) on the anterior chest in the sixth intercostal space." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7." ;
    tara:hasMeridian tara:TARA_5419503 ;
    tara:hasSynonym "Acupoint of the liver meridian of foot-jueyin",
        "Acupuncture point of the liver meridian",
        "Acupuncture point of the liver meridian of foot-jueyin",
        "LR" ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5419503 ] ) ] .

tara:TARA_0742938 a owl:Class ;
    rdfs:label "LI 10" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 38. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
