tara:TARA_2459635 a owl:Class ;
    rdfs:label "LU 10" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 30. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "魚(鱼)際(际)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_9857829 ;
    tara:hasIndicationsDescription "Cough,hemoptysis, sore throat, loss of voice, fever, feverish sensation in the palm. ." ;
    tara:hasInnervationDescription "The superficial ramus of the radial nerve." ;
    tara:hasLocationalDescription "On the palm, radial to the midpoint of the first metacarpal bone, at the border between the red and white flesh." ;
    tara:hasMeridian tara:TARA_9964503 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Yuji" ;
    tara:hasRelatedLocation UBERON:0003645 ;
    tara:hasSurfaceLocation UBERON:0008878 ;
    tara:hasSynonym "L 10",
        "Lung 10" ;
    tara:hasVasculatureDescription "Venules of the thumb draining to the cephalic vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
