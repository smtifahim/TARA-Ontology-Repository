                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ] .

tara:TARA_1051162 a owl:Class ;
    rdfs:label "SI 7" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 91. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "支正" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_6993030 ;
    tara:hasIndicationsDescription "Neck rigidity, headache, dizziness, spasmodic pain in the elbow and fingers, febrile diseases, mania." ;
    tara:hasInnervationDescription "Superficially, the branch of the medial antebrachial cutaneous nerve; deeper, on the radial side, the posterior interosseous nerve." ;
    tara:hasLocationalDescription "On the posteromedial aspect of the forearm, between the medial border of the ulnar bone and the flexor carpi ulnaris muscle, 5 B-cun proximal to the dorsal wrist crease. Note: 1 B-cun distal to the midpoint of the line connecting SI5 with SI8." ;
    tara:hasMeridian tara:TARA_9093316 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Zhizheng" ;
    tara:hasRelatedLocation UBERON:0001424,
        UBERON:0001522,
        ILX:0795333 ;
    tara:hasSurfaceLocation UBERON:0002386 ;
    tara:hasSynonym "Small Intestine 7" ;
    tara:hasVasculatureDescription "The terminal branches of the posterior interosseous artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
