tara:TARA_0598260 a owl:Class ;
    rdfs:label "BL 4" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 101. https://iris.who.int/handle/10665/353407",
