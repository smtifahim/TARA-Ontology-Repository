tara:TARA_8574156 a owl:Class ;
    rdfs:label "Bizhong" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Paralysis, spasm and contracture of the upper extremities, pain of the forearm." ;
    tara:hasLocationalDescription "On the lateral aspect of the forearm, midway between the transverse wrist crease and elbow crease, between the radius and the ulna." ;
    tara:hasMethodDescription "Puncture perpendicularly 1.0-1.2 inches. Moxibustion is applicable." ;
    tara:hasSynonym "EX-UE 12",
        "M-UE 30" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_8607646 a owl:Class ;
    rdfs:label "GV 12" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 209. ISBN 978-92-9061-248-7.

