tara:TARA_3735582 a owl:Class ;
    rdfs:label "Huanzhong" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Lumbar pain, thigh pain." ;
    tara:hasLocationalDescription "Midway between Huantiao (GB 30) and Yaoshu (GV 2)." ;
    tara:hasMethodDescription "Puncture perpendicularly 1.5-2.0 inches. Moxibustion is applicable." ;
    tara:hasSynonym "EX-B 12" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_3744150 a owl:Class ;
    rdfs:label "LI 14" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 40. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "臂臑" ;
    tara:hasIndicationsDescription "Pain in the shoulder and arm, rigidity of the neck, scrofula." ;
    tara:hasInnervationDescription "The posterior brachial cutaneous nerve; deeper, the radial nerve." ;
    tara:hasLocationalDescription "On the lateral aspect of the arm, just anterior to the border of the deltoid muscle, 7 B-cun superior to LI11." ;
    tara:hasMeridian tara:TARA_4610474 ;
    tara:hasMethodDescription "Puncture perpendicularly or obliquely upward 0.8-1.5 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Binao" ;
    tara:hasRelatedLocation UBERON:0001476 ;
    tara:hasSurfaceLocation UBERON:0001460 ;
    tara:hasSynonym "Large Intestine 14" ;
    tara:hasVasculatureDescription "The branches of posterior circumflex humeral artery and vein, the deep brachial artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001476 ] ],
