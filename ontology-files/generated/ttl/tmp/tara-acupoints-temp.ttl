tara:TARA_3369897 a owl:Class ;
    rdfs:label "TE 1" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 158. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "關(关,関)衝(冲)" ;
    tara:hasGeneralSurfaceLocation UBERON:0003624 ;
    tara:hasIndicationsDescription "headache, redness of the eye, sore throat, stiffness of the tongue, febrile diseases, irritability." ;
    tara:hasInnervationDescription "The palmar digital proprial nerve derived from the ulnar nerve." ;
    tara:hasLocationalDescription "On the ring finger, ulnar to the distal phalanx, 0.1 f-cun proximal to the ulnar corner of the fingernail, at the intersection of the vertical line of the ulnar side of the nail and the horizontal line of the base of the fingernail." ;
    tara:hasMethodDescription "Puncture superficially 0.1 inch, or prick with a three-edged needle to cause bleeding. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Guanchong" ;
    tara:hasSpecialPointRole tara:TARA_2954517 ;
    tara:hasSpecificSurfaceLocation UBERON:0004300,
        UBERON:0011276 ;
    tara:hasSynonym "SJ 1",
        "San Jiao 1",
        "TB 1",
        "TH 1",
        "TW 1",
        "Triple Burner 1",
        "Triple Energizer 1",
        "Triple Heater 1",
        "Triple Warmer 1" ;
    tara:hasVasculatureDescription "The arterial and venous network formed by the palmar digital proprial artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_3898257 ;
