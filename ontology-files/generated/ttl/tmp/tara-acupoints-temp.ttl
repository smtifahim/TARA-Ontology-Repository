tara:TARA_3386254 a owl:Class ;
    rdfs:label "GV 20" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 213. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "百會(会)" ;
    tara:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara:hasIndicationsDescription "headache, vertigo, tinnitus, nasal obstruction, aphasia by apoplexy, coma, mental disorder, prolapse of the rectum and the uterus." ;
    tara:hasInnervationDescription "The branch of the great occipital nerve." ;
    tara:hasLocationalDescription "On the head, 5 B-cun superior to the ante- rior hairline, on the anterior median line. Note 1: GV20 is located in the depression 1 B-cun anterior to the midpoint of the line from the anterior hairline to the posterior hairline. Note 2: When the ears are folded, GV 20 is located at the midpoint of the connecting line between the auricular apices." ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Baihui" ;
    tara:hasSpecificSurfaceLocation ILX:0795285,
        ILX:0795292,
        ILX:0795326 ;
    tara:hasSynonym "Du 20",
        "Governor Vessel 20",
        "VG 20" ;
    tara:hasVasculatureDescription "The anastomotic network formed by the superficial temporal arteries and veins and the occipital arteries and veins on both sides." ;
    tara:isLocatedOnMeridian tara:TARA_0386099 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificSurfaceLocation ;
