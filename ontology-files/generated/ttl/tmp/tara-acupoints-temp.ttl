    tara:hasRelatedVein UBERON:0001101 ;
    tara:hasSpecificSurfaceLocation UBERON:0001128,
        UBERON:0002375 ;
    tara:hasSynonym "CO 17",
        "Colon 17",
        "Large Intestine 17" ;
    tara:hasVasculatureDescription "The external jugular vein." ;
    tara:isLocatedOnMeridian tara:TARA_4610474 ;
