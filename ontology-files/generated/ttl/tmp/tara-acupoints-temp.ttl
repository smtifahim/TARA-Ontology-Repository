tara:TARA_5629511 a owl:Class ;
    rdfs:label "Acupoint of the Spleen Meridian" ;
    dc:description "An acupuncture point that is located along the Spleen Meridian of Foot-Taiyin (SP), which consists of 21 standardized acupoints beginning at SP 1 (Yinbai) on the medial side of the great toe near the corner of the nail, traveling up along the medial aspect of the leg and continuing up the abdomen and chest, and ending at SP 21 (Dabao) on the lateral thorax in the sixth intercostal space on the midaxillary line." ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    tara:hasSynonym "Acupoint of the spleen meridian of foot-taiyin",
        "Acupuncture point of the spleen meridian",
        "Acupuncture point of the spleen meridian of foot-taiyin",
        "SP" ;
    tara:isLocatedOnMeridian tara:TARA_4167850 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom tara:TARA_4167850 ] ) ] .

