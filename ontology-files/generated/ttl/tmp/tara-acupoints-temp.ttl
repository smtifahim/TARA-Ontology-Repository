            owl:intersectionOf ( tara:TARA_4598552 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom tara:TARA_9345451 ] ) ] .

tara:TARA_7546644 a owl:Class ;
    rdfs:label "Influential Point of the Zang Organs" ;
    dc:description "One of the eight influential points, the Influential Point of the Zang Organs can be employed to treat disorders of the Zang organs. Zhangmen (LR 13) is the Influential Point of the Zang organs." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
