tara:TARA_7233436 a owl:Class ;
    rdfs:label "Luozhen" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Sore neck, pain in the shoulder and arm." ;
    tara:hasLocationalDescription "On the dorsum of the hand, between the second and third metacarpal bones, about 0.5 cun posterior to metacarpophalangeal joint." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch." ;
    tara:hasSynonym "EX-UE 14",
        "M-UE 24" ;
    rdfs:subClassOf tara:TARA_3535998 .

