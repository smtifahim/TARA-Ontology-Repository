    tara:hasRelatedVein UBERON:0007154 ;
    tara:hasSpecificSurfaceLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSynonym "S 29",
        "Stomach 29" ;
    tara:hasVasculatureDescription "Laterally, the inferior epigastric artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_6221269 ;
