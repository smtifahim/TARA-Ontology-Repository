tara:TARA_6615149 a owl:Class ;
    rdfs:label "TE 17" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 166. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "翳風(风)" ;
    tara:hasIndicationsDescription "Tinnitus, deafness, otorrhea, facial paralysis, toothache, swelling of the cheek, scrofula, trismus." ;
    tara:hasInnervationDescription "The great auricular nerve; deeper, the site where the facial nerve perforates out of the stylomastoid foramen." ;
    tara:hasLocationalDescription "In the anterior region of the neck, posterior to the ear lobe, in the depression anterior to the inferior end of the mastoid process." ;
    tara:hasMeridian tara:TARA_3898257 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Yifeng" ;
    tara:hasRelatedLocation UBERON:0001847,
        UBERON:0011220 ;
    tara:hasSurfaceLocation UBERON:0000974 ;
    tara:hasSynonym "SJ 17",
        "San Jiao 17",
        "TB 17",
        "TH 17",
        "TW 17",
        "Triple Burner 17",
        "Triple Energizer 17",
        "Triple Heater 17",
        "Triple Warmer 17" ;
    tara:hasVasculatureDescription "The posterior auricular artery and vein, the external jugular vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
