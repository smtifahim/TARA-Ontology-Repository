tara:TARA_8819424 a owl:Class ;
    rdfs:label "Zhoujian" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasLocationalDescription "On the tip of the ulnar olecranon when the elbow is flexed." ;
    tara:hasSynonym "EX-UE 1",
        "M-UE 46" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_8826565 a owl:Class ;
    rdfs:label "ST 32" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 62. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "伏兎(兔)" ;
    tara:hasIndicationsDescription "Pain in the lumbar and iliac region, coldness of the knee, paralysis or motor impairment and pain of the lower extremities, beriberi." ;
    tara:hasInnervationDescription "The anterior and lateral femoral cutaneous nerves." ;
    tara:hasLocationalDescription "On the anterolateral aspect of the thigh, on the line connecting the lateral end of the base of the patella with the anterior superior iliac spine, 6 B-cun superior to the base of the patella." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture perpendicularly 1.0-1.5 inches. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Futu" ;
    tara:hasRelatedLocation UBERON:0002446,
        UBERON:0013708 ;
    tara:hasSurfaceLocation UBERON:0000376 ;
    tara:hasSynonym "S 32",
        "Stomach 32" ;
    tara:hasVasculatureDescription "The branches of the lateral circumflex femoral artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
