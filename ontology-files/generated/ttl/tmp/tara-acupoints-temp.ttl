        "Triple Burner 16",
        "Triple Energizer 16",
        "Triple Heater 16",
        "Triple Warmer 16" ;
    tara:hasVasculatureDescription "The posterior auricular artery." ;
    tara:isLocatedOnMeridian tara:TARA_3898257 ;
