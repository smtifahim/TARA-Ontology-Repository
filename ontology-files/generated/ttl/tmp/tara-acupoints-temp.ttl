tara:TARA_5828993 a owl:Class ;
    rdfs:label "TE 15" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 165. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "天髎(髎)" ;
    tara:hasIndicationsDescription "Pain in the shoulder and elbow, stiffness of the neck." ;
    tara:hasInnervationDescription "The accessory nerve and the branch of the suprascapular nerve." ;
    tara:hasLocationalDescription "In the scapular region, in the depression superior to the superior angle of the scapula. Note: With the upper limb hanging by the side of trunk in a seated position, TE15 is located midway between gB21 and SI13." ;
    tara:hasMeridian tara:TARA_3898257 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Tianliao" ;
    tara:hasRelatedLocation UBERON:0006849 ;
    tara:hasSurfaceLocation ILX:0795319 ;
    tara:hasSynonym "SJ 15",
        "San Jiao 15",
        "TB 15",
        "TH 15",
        "TW 15",
        "Triple Burner 15",
        "Triple Energizer 15",
        "Triple Heater 15",
        "Triple Warmer 15" ;
    tara:hasVasculatureDescription "The descending branch of the transverse cervical artery; deeper, the muscular branch of the suprascapular artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0006849 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795319 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_3898257 ] ) ] .

tara:TARA_5850983 a owl:Class ;
    rdfs:label "Sifeng" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7." ;
    tara:hasIndicationsDescription "Malnutrition and indigestion syndrome in children, whooping cough." ;
    tara:hasLocationalDescription "On the palmar surface, in the midpoint of the transverse creases of the proximal interphalangeal joints of the index, middle, ring and little fingers." ;
    tara:hasMethodDescription "Prick to cause bleeding, or squeeze out a small amount of yellowish viscous fluid locally." ;
    tara:hasSynonym "EX-UE 10",
        "M-UE 9" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_5859631 a owl:Class ;
    rdfs:label "SI 8" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 91. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "小海(海)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_6594221 ;
    tara:hasIndicationsDescription "Headache, swelling of the cheek, pain in the nape, shoulder, arm and elbow, epilepsy." ;
    tara:hasInnervationDescription "The branches of the medial antebrachial cutaneous nerve, the ulnar nerve." ;
    tara:hasLocationalDescription "On the posteromedial aspect of the elbow, in the depression between the olecranon and the medial epicondyle of the humerus bone. Note: When the elbow is slightly flexed, SI 8 is located in the groove for the ulnar nerve." ;
    tara:hasMeridian tara:TARA_9093316 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Xiaohai" ;
    tara:hasRelatedLocation UBERON:0000976,
        UBERON:0001494,
        UBERON:0006806,
        UBERON:0006810 ;
    tara:hasSurfaceLocation UBERON:0001461 ;
    tara:hasSynonym "Small Intestine 8" ;
    tara:hasVasculatureDescription "The superior and inferior ulnar collateral arteries and veins, the ulnar recurrent artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001494 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0006810 ] ],
