tara:TARA_4242691 a owl:Class ;
    rdfs:label "Weiwanxiashu" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasIndicationsDescription "Diabetes, vomiting, abdominal pain, pain in the chest and hypochondriac region." ;
    tara:hasLocationalDescription "1.5 cun lateral to the lower border of the spinous process of the eighth thoracic vertebra. (See Fig. 123)" ;
    tara:hasMethodDescription "Puncture obliquely 0.5-0.7 inch. Moxibustion is applicable." ;
    tara:hasSynonym "EX-B 3",
        "M-BW 12",
        "Yishu" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_4254258 a owl:Class ;
    rdfs:label "Zigongxue" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara:hasIndicationsDescription "Prolapse of the uterus, irregular menstruation." ;
    tara:hasLocationalDescription "3 cun lateral to Zhongji (CV 3)." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara:hasSynonym "EX-CA 1",
        "M-CA 18",
        "Zigong" ;
    rdfs:subClassOf tara:TARA_3535998 .

tara:TARA_4311153 a owl:Class ;
    rdfs:label "PC 6" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 154. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara:hasChineseLabel "內關(关,関)" ;
    tara:hasGeneralSurfaceLocation UBERON:0002386 ;
    tara:hasIndicationsDescription "cardiac pain, palpitation, stuffy chest, pain in the hypochondriac region, stomachache, nausea, vomiting, hiccup, mental disorder, epilepsy, insomnia, febrile diseases, irritability, malaria, contracture and pain of the elbow and arm." ;
    tara:hasLocationalDescription "On the anterior aspect of the forearm, between the tendons of the palmaris longus and the flexor carpi radialis, 2 B-cun proximal to the palmar wrist crease. Note 1: With the fist clenched, the wrist supinated and the elbow slightly flexed, the two tendons become more prominent. PC6 is located 2 B-cun proximal to PC7. the posterial point corresponding to PC6 is TE5. Note 2: If the palmaris longus tendon is not present, PC6 is medial to the flexor carpi radialis tendon." ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Neiguan" ;
    tara:hasSpecialPointRole tara:TARA_6993030,
        tara:TARA_9493899 ;
    tara:hasSpecificSurfaceLocation UBERON:0016496,
        ILX:0795334,
        ILX:0795500 ;
    tara:hasSynonym "P 6",
        "Pericardium 6" ;
    tara:isLocatedOnMeridian tara:TARA_4694897 ;
