        ILX:0795287 ;
    tara:hasSynonym "L 4",
        "Lung 4" ;
    tara:hasVasculatureDescription "The cephalic vein, cular branches of the brachial artery and vein." ;
    tara:isLocatedOnMeridian tara:TARA_9964503 ;
