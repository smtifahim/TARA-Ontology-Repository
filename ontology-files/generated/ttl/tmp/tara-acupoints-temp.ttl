tara:TARA_1632803 a owl:Class ;
    rdfs:label "BL 3" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 101. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "眉衝(冲)" ;
    tara:hasIndicationsDescription "Headache, giddiness, epilepsy, nasal obstruction." ;
    tara:hasLocationalDescription "On the head, superior to the frontal notch, 0.5 B-cun superior to the anterior hairline. Note: Midway between GV24 and BL4." ;
    tara:hasMeridian tara:TARA_7525476 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch." ;
    tara:hasPinyinLabel "Meichong" ;
    tara:hasRelatedLocation ILX:0741726,
        ILX:0795292 ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "B 3",
        "Bladder 3",
        "UB 3",
        "Urinary Bladder 3" ;
    tara:hasVasculatureDescription "See Zanzhu (BL 2)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795292 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0741726 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_7525476 ] ) ] .

tara:TARA_1654197 a owl:Class ;
    rdfs:label "ST 21" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 56. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "梁門(门)" ;
    tara:hasIndicationsDescription "Gastric pain, vomiting, anorexia, abdominal distension, diarrhea." ;
    tara:hasInnervationDescription "The branch of the eighth intercostal nerve." ;
    tara:hasLocationalDescription "On the upper abdomen, 4 B-cun superior to the centre of the umbilicus, 2 B-cun lateral to the anterior median line. Note: ST21 is 4 B-cun superior to ST25, 1 B-cun inferior to St20, 2 B-cun lateral to CV12." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.8-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Liangmen" ;
    tara:hasRelatedLocation UBERON:0007118,
        ILX:0795285 ;
    tara:hasSurfaceLocation ILX:0795301 ;
    tara:hasSynonym "S 21",
        "Stomach 21" ;
    tara:hasVasculatureDescription "The branches of the eighth intercostal and superior epigastric arteries and veins." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0007118 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795301 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6221269 ] ) ] .

tara:TARA_1661723 a owl:Class ;
    rdfs:label "ST 10" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 50. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "水突" ;
    tara:hasIndicationsDescription "Sore throat, asthma, cough." ;
    tara:hasInnervationDescription "Superficially, the cutaneous cervical nerve; deeper, the superior cardiac nerve issued from the sympathetic nerve and the sympathetic trunk." ;
    tara:hasLocationalDescription "In the anterior region of the neck, at the same level as the cricoid cartilage, just anterior to the border of the sternocleidomastoid muscle." ;
    tara:hasMeridian tara:TARA_6221269 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Shuitu" ;
    tara:hasRelatedLocation UBERON:0001128,
        UBERON:0002375 ;
    tara:hasSurfaceLocation UBERON:0000974 ;
    tara:hasSynonym "S 10",
        "Stomach 10" ;
    tara:hasVasculatureDescription "The common carotid artery." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002375 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001128 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_6221269 ] ) ] .

tara:TARA_1697302 a owl:Class ;
    rdfs:label "GV 5" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 206. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "懸(悬)樞(枢)" ;
    tara:hasIndicationsDescription "Pain and stiffness of the lower back, diarrhea, indigestion." ;
    tara:hasLocationalDescription "In the lumbar region, in the depression inferior to the spinous process of the first lumbar vertebra (L1), on the posterior median line." ;
    tara:hasMeridian tara:TARA_0386099 ;
    tara:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Xuanshu" ;
    tara:hasRelatedLocation UBERON:0004617,
        ILX:0795312 ;
    tara:hasSurfaceLocation UBERON:0005462 ;
    tara:hasSynonym "Du 5",
        "Governor Vessel 5" ;
    tara:hasVasculatureDescription "See Yaoyangguan (GY 3)." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:locatedInRelationTo ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795312 ] ],
