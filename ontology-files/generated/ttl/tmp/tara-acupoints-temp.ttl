            owl:intersectionOf ( tara:TARA_7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom tara:TARA_5906686 ] ) ] .

tara:TARA_7406349 a owl:Class ;
    rdfs:label "Lower He-Sea Point of the Small Intestine" ;
    dc:description "The Lower He-Sea Point of the the Small Intestine meridian. One of the five Shu Points, the He-Sea point signifies the confluence of rivers in the sea, where the meridian qi is the most flourishing. In addition, each of the six fu organs has another He-Sea point in the three yang meridians of the foot, known as the Lower He-Sea point. The Lower He-Sea points are mostly employed to treat the disorders of the six fu organs in clinic." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    tara:hasSpecialPointRole tara:TARA_7154478 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_4830205 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom tara:TARA_7154478 ] ) ] .

tara:TARA_7524444 a owl:Class ;
    rdfs:label "Xi-Cleft Point of the Yin Heel Vessel" ;
    dc:description "The Xi-Cleft Point of the Yin Heel Vessel (an extra meridian). The Xi-Cleft Point is the site where the qi and blood of the meridian are deeply converged. The Xi-Cleft Point is used to treat acute disorders in the area supplied by its pertaining meridian and those of its pertaining zang or fu organ." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
