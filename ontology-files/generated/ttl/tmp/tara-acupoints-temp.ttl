tara:TARA_4352504 a owl:Class ;
    rdfs:label "GB 4" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 173. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "頷(颔)厭(厌)" ;
    tara:hasIndicationsDescription "Migraine, vertigo, tinnitus, pain in the outer canthus, toothache, convulsion, epilepsy." ;
    tara:hasInnervationDescription "The temporal branch of the auriculotemporal nerve." ;
    tara:hasLocationalDescription "On the head, at the junction of the upper one fourth and lower three fourths of the curved line from St8 to gB7." ;
    tara:hasMeridian tara:TARA_5283975 ;
    tara:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara:hasPinyinLabel "Hanyan" ;
    tara:hasSurfaceLocation UBERON:0000033 ;
    tara:hasSynonym "G 4",
        "Gallbladder 4" ;
    tara:hasVasculatureDescription "The parietal branches of the superficial temporal artery and vein." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( tara:TARA_5151019 [ a owl:Restriction ;
                        owl:onProperty tara:isMemberAcupointOf ;
                        owl:someValuesFrom tara:TARA_5283975 ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara:locatedOnTheSurfaceOf ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ] .

tara:TARA_4362146 a owl:Class ;
    rdfs:label "KI 3" ;
    dcterms:bibliographicCitation """Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 137. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.""" ;
    tara:hasChineseLabel "太谿(溪)" ;
    tara:hasDesignatedSpecialPointRole tara:TARA_1840369,
        tara:TARA_6705086 ;
    tara:hasIndicationsDescription "Sore throat, toothache, deafness, tinnitus, dizziness, spitting of blood, asthma, thirst, irregular menstruation, insomnia, nocturnal emission, impotence, frequency of micturition, pain in the lower back." ;
    tara:hasLocationalDescription "On the posteromedial aspect of the ankle, in the depression between the prominence of the medial malleolus and the calcaneal tendon." ;
    tara:hasMeridian tara:TARA_4813389 ;
    tara:hasPinyinLabel "Taixi" ;
    tara:hasRelatedLocation UBERON:0003701,
        ILX:0795305 ;
    tara:hasSurfaceLocation UBERON:0004454 ;
    tara:hasSynonym "K 3",
        "Kidney 3" ;
    tara:hasVasculatureDescription "Anteriorly, the posterior tibial artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara:hasSpecialPointDesignation ;
            owl:someValuesFrom tara:TARA_3455429 ],
