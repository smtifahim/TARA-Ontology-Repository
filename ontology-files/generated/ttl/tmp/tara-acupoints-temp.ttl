    tara:hasSynonym "SJ 13",
        "San Jiao 13",
        "TB 13",
        "TH 13",
        "TW 13",
        "Triple Burner 13",
        "Triple Energizer 13",
        "Triple Heater 13",
        "Triple Warmer 13" ;
    tara:hasVasculatureDescription "The median collateral artery and vein." ;
    rdfs:subClassOf [ a owl:Restriction ;
