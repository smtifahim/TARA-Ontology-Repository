        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 166. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>翳風(风)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Tinnitus, deafness, otorrhea, facial paralysis, toothache, swelling of the cheek, scrofula, trismus.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The great auricular nerve; deeper, the site where the facial nerve perforates out of the stylomastoid foramen.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the anterior region of the neck, posterior to the ear lobe, in the depression anterior to the inferior end of the mastoid process.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Yifeng</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001847"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011220"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <TARA:hasSynonym>SJ 17</TARA:hasSynonym>
        <TARA:hasSynonym>San Jiao 17</TARA:hasSynonym>
        <TARA:hasSynonym>TB 17</TARA:hasSynonym>
        <TARA:hasSynonym>TH 17</TARA:hasSynonym>
        <TARA:hasSynonym>TW 17</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 17</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 17</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 17</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 17</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior auricular artery and vein, the external jugular vein.</TARA:hasVasculatureDescription>
        <rdfs:label>TE 17</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6659923 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6659923">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Beriberi, toe pain, redness and swelling of the dorsum of the foot.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the dorsum of foot, in the depressions on the webs between toes, proximal to the margins of the webs, at the junction of the red and white skin, eight points in all.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture obliquely 0.5-0.8 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-LE 10</TARA:hasSynonym>
        <TARA:hasSynonym>M-LE 8</TARA:hasSynonym>
        <rdfs:label>Bafeng</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6681003 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6681003">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7932600"/>
