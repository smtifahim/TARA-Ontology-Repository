        <obo:IAO_0000115>A joint that connects the bones of the crus to the proximal tarsal bones.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:UBPROP_0000001>an ankle joint that passes between the astragalus and calcaneum[Palaeos].</obo:UBPROP_0000001>
        <OboInOwl:hasDbXref>Wikipedia:Crurotarsal</OboInOwl:hasDbXref>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:hasRelatedSynonym>crurotarsal</OboInOwl:hasRelatedSynonym>
