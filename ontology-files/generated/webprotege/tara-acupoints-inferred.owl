    <!-- http://purl.obolibrary.org/obo/UBERON_0000950 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000950">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004252"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011144"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000376"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The most superficial muscle on the medial side of the thigh. It is thin and flattened, broad above, narrow and tapering below. It arises by a thin aponeurosis from the anterior margins of the lower half of the symphysis pubis and the upper half of the pubic arch.</obo:IAO_0000115>
        <obo:IAO_0000116>AAO has minor and major gracilis, which merge together, attaching the pelvic rim to the tibiofibula - this could be grouped with the mammalian gracilis at some level; note the current insertion site is &apos;tibia&apos; which would be modified for amphibian tibiafibula</obo:IAO_0000116>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000008>A&amp;P heads in rat, single head in humans[DOI:10.1002/ar.22919]</obo:UBPROP_0000008>
        <OboInOwl:hasDbXref>BTO:0000536</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EMAPA:36231</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:43882</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0002311</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C52935</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:181689005</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C0224439</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Gracilis_muscle</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>galen:Gracilis</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>gracilis muscle</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>musculus gracilis</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:id>UBERON:0000950</OboInOwl:id>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#human_reference_atlas"/>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#human_subset"/>
