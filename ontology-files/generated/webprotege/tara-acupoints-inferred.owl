        <TARA:hasChineseLabel>腹哀</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Abdominal pain, indigestion, constipation, dysentery.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The eighth intercostal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the upper abdomen, 3 B-cun superior to the centre of the umbilicus, 4 B-cun lateral to the anterior median line. Note: 3 B-cun superior to SP15, at the same level as CV11.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Fuai</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795301"/>
        <TARA:hasSynonym>Spleen 16</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The eighth intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>SP 16</rdfs:label>
    </owl:Class>
    


