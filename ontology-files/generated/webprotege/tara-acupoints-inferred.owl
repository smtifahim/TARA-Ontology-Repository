        <TARA:hasChineseLabel>滑(滑)肉門(门)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Gastric pain, vomiting, mania.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The branch of the ninth intercostal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the upper abdomen, 1 B-cun superior to the centre of the umbilicus, 2 B-cun lateral to the anterior median line. Note: ST24 is at the same level and lateral to CV9.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <TARA:hasPinyinLabel>Huaroumen</TARA:hasPinyinLabel>
