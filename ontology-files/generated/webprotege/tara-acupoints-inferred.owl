        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795307"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <TARA:hasSynonym>Front-Mu Point of the Liver</TARA:hasSynonym>
        <TARA:hasSynonym>LIV 14</TARA:hasSynonym>
        <TARA:hasSynonym>LV 14</TARA:hasSynonym>
        <TARA:hasSynonym>Liver 14</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The sixth intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>LR 14 (Male)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1317363 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1317363">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Hemorrhoids, prolapse of the rectum.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the metacarpal aspect of the forearm, 4 cun above the transverse wrist crease, on the both sides of the tendon of m. flexor carpi radialis, two points on one hand.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5- 1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-UE 2</TARA:hasSynonym>
        <TARA:hasSynonym>M-UE 29</TARA:hasSynonym>
        <rdfs:label>Erbai</rdfs:label>
    </owl:Class>
    


