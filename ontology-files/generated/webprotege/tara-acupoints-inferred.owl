        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <TARA:hasSynonym>G 16</TARA:hasSynonym>
        <TARA:hasSynonym>Gallbladder 16</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The frontal branches of the superficial temporal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>GB 16</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1338884 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1338884">
