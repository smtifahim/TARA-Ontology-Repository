        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001>The first metacarpal bone or the metacarpal bone of the thumb is the first bone of the thumb. It is connected to the trapezium of the carpus at the first carpometacarpal joint and to the proximal thumb phalanx at the first metacarpophalangeal joint[Wikipedia:First_metacarpal_bone].</obo:UBPROP_0000001>
        <obo:UBPROP_0000104 rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</obo:UBPROP_0000104>
