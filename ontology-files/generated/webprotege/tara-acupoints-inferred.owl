        <OboInOwl:hasDbXref>GAID:312</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0000331</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C43362</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:181262009</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>TADS:0000066</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>TGMA:0001279</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C0003461</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>WBbt:0005364</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Anus</OboInOwl:hasDbXref>
