    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2260412 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2260412">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7932600"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
