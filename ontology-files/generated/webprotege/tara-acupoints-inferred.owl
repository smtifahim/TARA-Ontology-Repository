        <OboInOwl:hasDbXref>UMLS:C0230143</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Costal_margin</OboInOwl:hasDbXref>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
