    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_4176111 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4176111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <dc:description>Represents the special roles associated with the acupoints of the main meridan. These roles are named after the special properties of the special points. Special points are the specific acupoints of the 14 meridans that have special properties and are groupd under special names. This class is used to classify the acupoints based on their special roles.</dc:description>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasSynonym>Special Acupoint Role</TARA:hasSynonym>
        <rdfs:label>Special Point Role</rdfs:label>
    </owl:Class>
    


