    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0007028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0007028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0020120"/>
        <obo:IAO_0000115>Tear of one or more of the tendons of the four rotator cuff muscles of the shoulder. A rotator cuff &apos;injury&apos; can include any type of irritation or overuse of those muscles or tendons, and is among the most common conditions affecting the shoulder.</obo:IAO_0000115>
