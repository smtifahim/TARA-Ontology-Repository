    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7532145 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7532145">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Acute and chronic appendicitis, indigestion, paralysis of the lower extremities.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>The tender spot about 2 cun below Zusanli (ST 36).</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 1.0-1.2 inches.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-LE 7</TARA:hasSynonym>
        <TARA:hasSynonym>M-LE 13</TARA:hasSynonym>
        <rdfs:label>Lanweixue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7546644 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7546644">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7010544"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointDesignation"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1028514"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7010544"/>
        <dc:description>The Eight Influential Points refer to the specific points which have particular effects in treatment of disorders relating to the zang-fu organs, qi, blood, tendon, pulse and vessels, bone and marrow. Each of the Eight Influential Points overlaps the other point. Zhangmen (LR 13) is the Influential Point of the zang organs.</dc:description>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1028514"/>
        <rdfs:label>Influential Point of Zang Organs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7571236 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7571236">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0886544"/>
        <rdfs:label>Front-Mu Point Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7584875 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7584875">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasLocationalDescription>On the dorsum of the hand, midway between the transverse wrist crease and metacarpophalangeal joint, between the second and third metacarpal bones, and between the fourth and fifth metacarpal bones, four points in all on both hands.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture obliquely 0.5-1.0 inch toward the centre of metacarpus from both sides.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-UE 7</TARA:hasSynonym>
        <TARA:hasSynonym>M-UE 19</TARA:hasSynonym>
        <TARA:hasSynonym>N-UE 19</TARA:hasSynonym>
        <rdfs:label>Yaotongxue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7589061 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7589061">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8364824"/>
        <rdfs:subClassOf>
            <owl:Restriction>
