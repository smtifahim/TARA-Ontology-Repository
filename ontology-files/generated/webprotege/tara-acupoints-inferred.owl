        <OboInOwl:hasRelatedSynonym>metatarsal joint</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>metatarsalphalangeal joint</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>metatarsophalangeal</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>metatarsophalangeal articulation</OboInOwl:hasRelatedSynonym>
        <OboInOwl:id>UBERON:0003696</OboInOwl:id>
