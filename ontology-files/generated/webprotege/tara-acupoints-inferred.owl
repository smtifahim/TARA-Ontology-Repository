        <TARA:hasChineseLabel>懸(悬)樞(枢)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Pain and stiffness of the lower back, diarrhea, indigestion.</TARA:hasIndicationsDescription>
