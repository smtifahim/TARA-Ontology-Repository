        <OboInOwl:hasDbXref>UMLS:C1280202</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VHOG:0000275</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>XAO:0000179</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>ZFA:0000107</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>regio orbitalis</OboInOwl:hasExactSynonym>
        <OboInOwl:hasNarrowSynonym>vertebrate eye</OboInOwl:hasNarrowSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:hasRelatedSynonym>camera-type eye plus associated structures</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>eyes</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>orbital part of face</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>orbital region</OboInOwl:hasRelatedSynonym>
        <OboInOwl:id>UBERON:0000019</OboInOwl:id>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#human_subset"/>
