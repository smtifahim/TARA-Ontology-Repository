        <TARA:hasChineseLabel>天池</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Suffocating sensation in the chest, pain in the hypochondriac region, swelling and pain of the axillary regIon.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The muscular branch of the anterior thoracic nerve, the fourth intercostal nerve</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the anterior thoracic region, in the fourth intercostal space, 5 B-cun lateral to the anterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4694897"/>
        <TARA:hasMethodDescription>Puncture obliquely 0.2-0.4 inch. Deep puncture is not advisable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Tianchi</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
