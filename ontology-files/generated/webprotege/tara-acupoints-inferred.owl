    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2849795 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2849795">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1926756"/>
        <rdfs:subClassOf>
