        <TARA:hasChineseLabel>氣(气,気)海(海)兪(俞)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Low back pain, irregular menstruation, dysmenorrhea, asthma.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lateral cutaneous branch of the posterior ramus of the second lumbar nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the lumbar region, at the same level as the inferior border of the spinous process of the third lumbar vertebra (L3), 1.5 B-cun lateral to the posterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Qihaishu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004619"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005462"/>
        <TARA:hasSynonym>B 24</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 24</TARA:hasSynonym>
        <TARA:hasSynonym>UB 24</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 24</TARA:hasSynonym>
        <rdfs:label>BL 24</rdfs:label>
    </owl:Class>
    


