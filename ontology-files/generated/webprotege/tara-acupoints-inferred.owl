    <!-- http://purl.obolibrary.org/obo/UBERON_0004573 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004573">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0001637"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
