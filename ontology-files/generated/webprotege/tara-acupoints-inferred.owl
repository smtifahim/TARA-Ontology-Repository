                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 206. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>脊中</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Pain in the epigastric region, diarrhea, jaundice, epilepsy, stiffness and pain of the back.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The medial branch of the posterior ramus of the eleventh thoracic nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the upper back region, in the depression inferior to the spinous process of the 11th thoracic vertebra (T11), on the posterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Jizhong</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004635"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <TARA:hasSynonym>Du 6</TARA:hasSynonym>
        <TARA:hasSynonym>Governor Vessel 6</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior branch of the eleventh intercostal artery.</TARA:hasVasculatureDescription>
        <rdfs:label>GV 6</rdfs:label>
    </owl:Class>
    


