        <TARA:hasChineseLabel>太淵(渊)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1840369"/>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4105303"/>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6705086"/>
        <TARA:hasIndicationsDescription>Cough, asthma, hemoptysis, sore throat, palpitation, pain in the chest, wrist and arm.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lateral antebrachial cutaneous nerve and superficial branch of the radial nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the anterolateral aspect of the wrist, between the radial styloid process and the scaphoid bone, in the depression ulnar to the abductor pollicis longus tendon. Note: On the radial side of the palmar wrist crease, over the radial artery.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9964503"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.2-0.3 inch. Avoid puncturing the radial artery. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Taiyuan</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001404"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001427"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_7500078"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795334"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795335"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004452"/>
        <TARA:hasSynonym>Influential Point of Vessels</TARA:hasSynonym>
        <TARA:hasSynonym>L 9</TARA:hasSynonym>
        <TARA:hasSynonym>Lung 9</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The radial artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>LU 9</rdfs:label>
    </owl:Class>
    


