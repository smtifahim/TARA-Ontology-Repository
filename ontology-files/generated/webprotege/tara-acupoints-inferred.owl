                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003625"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedOnTheSurfaceOf"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://uri.interlex.org/base/ilx_0794954"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 158. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>液門(门)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9857829"/>
        <TARA:hasIndicationsDescription>Headache, redness of the eyes, sudden deafness, sore throat, malaria, pain in the arm.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The dorsal branch of the ulnar nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the dorsum of the hand, in the depression superior to the web margin between the ring and little fingers, at the border between the red and white flesh.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <TARA:hasMethodDescription>Puncture obliquely 0.3-0.5 inch towards the interspace of the metacarpal bones. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Yemen</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003624"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003625"/>
        <TARA:hasSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0794954"/>
        <TARA:hasSynonym>SJ 2</TARA:hasSynonym>
        <TARA:hasSynonym>San Jiao 2</TARA:hasSynonym>
        <TARA:hasSynonym>TB 2</TARA:hasSynonym>
        <TARA:hasSynonym>TH 2</TARA:hasSynonym>
        <TARA:hasSynonym>TW 2</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 2</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 2</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 2</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 2</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The dorsal digital artery of the ulnar artery.</TARA:hasVasculatureDescription>
        <rdfs:label>TE 2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7927421 -->

