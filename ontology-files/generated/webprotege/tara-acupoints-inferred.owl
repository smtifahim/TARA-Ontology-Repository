                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedOnTheSurfaceOf"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001461"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 28. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>尺澤(泽,沢)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <TARA:hasIndicationsDescription>Cough, hemoptysis, afternoon fever, asthma, sore throat, fullness in the chest, infantile convulsions, spasmodic pain of the elbow and arm, mastitis.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lateral antebrachial cutaneous nerve and the radial nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the anterior aspect of the elbow, at the cubital crease, in the depression lateral to the biceps brachii tendon.
Note: With the elbow flexed, LU5 is located at the cubital crease, between LI11 and PC3, separated from PC3 by the biceps brachii tendon.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9964503"/>
        <TARA:hasMethodDescription>puncture perpendicularly 0.5-1 inch.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Chize</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008188"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795332"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001461"/>
        <TARA:hasSynonym>L 5</TARA:hasSynonym>
        <TARA:hasSynonym>Lung 5</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The branches of the radial recurrent artery and vein, the cephalic vein.</TARA:hasVasculatureDescription>
        <rdfs:label>LU 5</rdfs:label>
    </owl:Class>
    


