        <TARA:hasChineseLabel>眉衝(冲)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Headache, giddiness, epilepsy, nasal obstruction.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the head, superior to the frontal notch, 0.5 B-cun superior to the anterior hairline. Note: Midway between GV24 and BL4.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch.</TARA:hasMethodDescription>
