        <TARA:hasChineseLabel>膺窗(窓)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Fullness and pain in the chest and hypochondrium, cough, asthma, mastitis.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The branch of the anterior thoracic nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the anterior thoracic region, in the third intercostal space, 4 B-cun lateral to the anterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <TARA:hasMethodDescription>Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Yingchuang</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795297"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <TARA:hasSynonym>S 16</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 16</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The lateral thoracic artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 16</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_4613316 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4613316">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Epilepsy, headache, inomnia, constipation.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>2 cun directly above the tip of the coccyx.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture subcutaneously upward 1.0-2.0 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-B 9</TARA:hasSynonym>
        <TARA:hasSynonym>M-BW 29</TARA:hasSynonym>
        <rdfs:label>Yaoqi</rdfs:label>
    </owl:Class>
    


