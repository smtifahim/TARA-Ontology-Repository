        <TARA:hasChineseLabel>衝(冲)門(门)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Abdominal pain, hernia, dysuria.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>Just where the femoral nerve traverses.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the groin region, at the inguinal crease, lateral to the femoral artery. Note: At the same level as CV2, medial and inferior to SP13.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <TARA:hasMethodDescription>Avoid puncturing the artery.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Chongmen</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002060"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795329"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008337"/>
        <TARA:hasSynonym>Spleen 12</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>On the medial side, the femoral artery.</TARA:hasVasculatureDescription>
        <rdfs:label>SP 12</rdfs:label>
    </owl:Class>
    


