        <TARA:hasSynonym>L 17</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 17</TARA:hasSynonym>
        <rdfs:label>ST 17</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9474009 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6200120"/>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</dcterms:bibliographicCitation>
        <TARA:hasAbbreviation>HT</TARA:hasAbbreviation>
        <TARA:hasChineseLabel>手少陰(阴)心經(经,経)</TARA:hasChineseLabel>
        <TARA:hasDesignatedOrgan rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000948"/>
        <TARA:hasSynonym>HT</TARA:hasSynonym>
        <TARA:hasSynonym>Heart Meridian of Hand-Shaoyin</TARA:hasSynonym>
        <TARA:hasSynonym>meridian of the heart</TARA:hasSynonym>
        <rdfs:label>Heart Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9492402 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9492402">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Pain in the shoulder and arm, paralysis of the upper extremities.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>Midway between the end of the anterior axillary fold and Jianyu (L I 15).</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-UE 13</TARA:hasSynonym>
        <TARA:hasSynonym>Jianneiling</TARA:hasSynonym>
        <TARA:hasSynonym>M-UE 48</TARA:hasSynonym>
        <rdfs:label>Jianqian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9493899 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9493899">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4943316"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointDesignation"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3091322"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4943316"/>
        <dc:description>Eight Confluent Points refer to the eight points on the limbs where the main meridians communicate with the eight extra meridians. They are Neiguan (PC 6). Gongsun (SP 4), Houxi (SJ 3), Shenmai (BL 62). Waiguan (TE 5), Zulinqi (GB 41 ), Lieque (LU 7) and Zhaohai (KI 6), which are respectively connected with the Yin Link Vessel. Thoroughfare Vessel, governor Vessel, Yang Heel Vessel. Yang Link Vessel, Belt Vessel, Conception Vessel and Yin Heel Vessel. The Eight Confluent Points are used to treat a variety of disorders of the corresponding eight extra meridians.</dc:description>
        <dcterms:bibliographicCitation>&quot;Chinese Acupuncture and Moxibustion” (1999) ISBN-13: 978-7119017587</dcterms:bibliographicCitation>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3091322"/>
        <rdfs:label>Confluent Point</rdfs:label>
    </owl:Class>
    


