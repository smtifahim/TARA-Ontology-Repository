        <TARA:hasSynonym>G 9</TARA:hasSynonym>
        <TARA:hasSynonym>Gallbladder 9</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior auricular artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>GB 9</rdfs:label>
    </owl:Class>
    


