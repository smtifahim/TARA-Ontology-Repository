                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 114. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>白環(环)兪(俞)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Enuresis, pain due to hernia, morbid leukorrhea, irregular menstruation, cold sensation and pain of the lower back, dysuria, constipation, tenesmus, prolapse of the rectum.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lateral branches of the posterior rami of the third and fourth sacral nerves, the inferior gluteal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the sacral region, at the same level as the fourth posterior sacral foramen, 1.5 B-cun lateral to the median sacral crest. Note: 1.5 B-cun lateral to the sacral hiatus, at the same level as BL34.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Baihuanshu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0741680"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0741717"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795316"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <TARA:hasSynonym>B 30</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 30</TARA:hasSynonym>
        <TARA:hasSynonym>UB 30</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 30</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The inferior gluteal artery and vein; deeper, the internal pudendal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 30</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9159226 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9159226">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7932600"/>
        <rdfs:subClassOf>
