    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012198"/>
        <obo:IAO_0000115>The space between the fourth and fifth ribs, containing intercostal muscles, vessels, and nerves.</obo:IAO_0000115>
