        <TARA:hasSynonym>Bladder 38</TARA:hasSynonym>
        <TARA:hasSynonym>UB 38</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 38</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The superolateral genicular artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 38</rdfs:label>
    </owl:Class>
    


