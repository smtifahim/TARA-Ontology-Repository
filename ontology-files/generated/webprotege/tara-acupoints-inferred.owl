        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002387"/>
        <TARA:hasSynonym>S 43</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 43</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The dorsal venous network of foot.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 43</rdfs:label>
    </owl:Class>
    


