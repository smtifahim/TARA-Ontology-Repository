Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>絲(丝)竹空</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Headache, redness and pain of the eye, blurring of vision, twitching of the eyelid, toothache, facial paralysis.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The zygomatic branch of the facial nerve and the branch of the auriculotemporal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the head, in the depression at the lateral end of the eyebrow. Note: TE23 is superior to GB1.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Sizhukong</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010163"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <TARA:hasSynonym>SJ 23</TARA:hasSynonym>
        <TARA:hasSynonym>San Jiao 23</TARA:hasSynonym>
        <TARA:hasSynonym>TB 23</TARA:hasSynonym>
        <TARA:hasSynonym>TH 23</TARA:hasSynonym>
        <TARA:hasSynonym>TW 23</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 23</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 23</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 23</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 23</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The frontal branches of the superficial temporal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>TE 23</rdfs:label>
    </owl:Class>
    


