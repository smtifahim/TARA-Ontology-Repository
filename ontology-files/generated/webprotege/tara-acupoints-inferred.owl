        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:hasRelatedSynonym>c. medialis tibiae</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>medial condyle of the tibia</OboInOwl:hasRelatedSynonym>
