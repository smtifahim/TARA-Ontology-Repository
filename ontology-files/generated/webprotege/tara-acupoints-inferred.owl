        <OboInOwl:hasDbXref>UMLS:C1709948</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Twelfth_rib</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>costa XII</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>twelfth rib</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
