        <TARA:hasChineseLabel>輒(辄)筋</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Fullness of the chest, pain in the hypochondriac region, asthma.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lateral cutaneous branch of the fifth intercostal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the lateral thoracic region, in the fourth intercostal space, 1 B-cun anterior to the midaxillary line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <TARA:hasMethodDescription>Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
