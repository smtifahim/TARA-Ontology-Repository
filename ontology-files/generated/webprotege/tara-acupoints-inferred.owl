        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 212. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>強間(间)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Headache, neck rigidity, blurring of vision, mania.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the head, 4 B-cun superior to the posterior hairline, on the posterior median line. Note: GV18 is located in the depression 1.5 B-cun superior to gV17.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Qiangjian</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795326"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <TARA:hasSynonym>Du 18</TARA:hasSynonym>
        <TARA:hasSynonym>Governor Vessel 18</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Naohu (GV 17).</TARA:hasVasculatureDescription>
        <rdfs:label>GV 18</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7596288 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7596288">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Eye diseases, tinnitus, insomma.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>1 cun posterior to Yifeng (TE 17).</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-HN 14</TARA:hasSynonym>
        <rdfs:label>Yiming</rdfs:label>
    </owl:Class>
    


