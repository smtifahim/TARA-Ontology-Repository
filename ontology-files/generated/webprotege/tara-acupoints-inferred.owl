        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014848"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000376"/>
        <TARA:hasSynonym>S 33</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 33</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The descending branch of the lateral circumflex femoral artery.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 33</rdfs:label>
    </owl:Class>
    


