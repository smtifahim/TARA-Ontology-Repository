        <TARA:hasSynonym>G 23</TARA:hasSynonym>
        <TARA:hasSynonym>Gallbladder 23</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The lateral thoracic artery and vein, the fifth intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>GB 23</rdfs:label>
    </owl:Class>
    


