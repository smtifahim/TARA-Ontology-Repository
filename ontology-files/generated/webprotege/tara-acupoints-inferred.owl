        <ilxtr:hasIlxPreferredId rdf:resource="http://uri.interlex.org/base/ilx_0795309"/>
        <rdfs:label>axillary fossa</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795310 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004704"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001460"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A triangular depression on the anterior aspect of the elbow, containing important neurovascular structures.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001460"/>
        <ilxr:type rdf:resource="http://uri.interlex.org/base/readable/type/term"/>
