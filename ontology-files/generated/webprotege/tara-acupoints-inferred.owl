    <!-- http://purl.obolibrary.org/obo/UBERON_0006846 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006846">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000466"/>
        <obo:IAO_0000115>A furrow or an incomplete tube.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <OboInOwl:hasDbXref>AEO:0000161</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EHDAA2_RETIRED:0003161</OboInOwl:hasDbXref>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
