        <TARA:hasSynonym>Kidney 22</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The fifth intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>KI 22</rdfs:label>
    </owl:Class>
    


