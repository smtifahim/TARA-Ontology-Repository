        <TARA:hasSynonym>Kidney 25</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The second intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>KI 25</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6615149 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6615149">
