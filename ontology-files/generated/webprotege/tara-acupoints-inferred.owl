        <TARA:hasChineseLabel>支溝(沟)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7315457"/>
        <TARA:hasIndicationsDescription>Tinnitus, deafness, pain in the hypochondriac region, vomiting, constipation, febrile diseases, aching and heavy sensation of the shoulder and back, sudden hoarseness of voice.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the posterior aspect of the forearm, midpoint of the interosseous space between the radius and the ulna, 3 B-cun proximal to the dorsal wrist crease. Note: 1 B-cun proximal to TE5, between the radius and the ulna, at the same level as tE7.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Zhigou</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001423"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001424"/>
