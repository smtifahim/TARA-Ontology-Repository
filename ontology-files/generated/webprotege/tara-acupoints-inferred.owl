        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#human_subset"/>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#mouse_subset"/>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#uberon_slim"/>
        <rdfs:label>vastus lateralis</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/5/57/Illu_lower_extremity_muscles.jpg</foaf:depiction>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001380 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001380">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001377"/>
