        <ilxtr:hasIlxId rdf:resource="http://uri.interlex.org/base/ilx_0795305"/>
        <ilxtr:hasIlxPreferredId rdf:resource="http://uri.interlex.org/base/ilx_0795305"/>
        <rdfs:label>medial malleolus</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795306 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The area of the thorax on the lateral body wall, containing portions of the serratus anterior and intercostal muscles.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
