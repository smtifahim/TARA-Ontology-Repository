        <TARA:hasIndicationsDescription>Pain in the face, deviation of the eyes and mouth, spasm of facial muscle.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>1 cun lateral to Chengjiang (CV 24).</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture obliquely 0.5-1.0 inch..</TARA:hasMethodDescription>
        <TARA:hasSynonym>M-HN 18</TARA:hasSynonym>
        <rdfs:label>Jiachengjiang</rdfs:label>
    </owl:Class>
    


