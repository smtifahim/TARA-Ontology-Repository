        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 209. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>神(神)道(道)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Poor memory, anxiety, palpitation, pain and stiffness of the back, cough, cardiac pain.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The medial branch of the posterior ramus of the fifth thoracic nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the upper back region, in the depression inferior to the spinous process of the fifth thoracic vertebra (T5), on the posterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <TARA:hasMethodDescription>Puncture obliquely upward 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Shendao</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004630"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <TARA:hasSynonym>Du 11</TARA:hasSynonym>
        <TARA:hasSynonym>Governor Vessel 11</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior branch of the&apos; fifth intercostal artery.</TARA:hasVasculatureDescription>
        <rdfs:label>GV 11</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_8343475 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_8343475">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Rhinitis, nasal obstruction, nasal boils.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>At the highest point of the nasolabial groove.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture subcutaneously upward 0.3-0.5 inch.</TARA:hasMethodDescription>
        <TARA:hasSynonym>M-HN 14</TARA:hasSynonym>
        <rdfs:label>Bitong</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_8364824 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_8364824">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/isMemberAcupointOf"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Governor Vessel (GV / Du Mai), one of the eight extraordinary vessels, which consists of 28 standardized acupoints beginning at GV 1 (Changqiang) in the perineal region midway between the tip of the coccyx and the anus, traveling up along the posterior midline of the body over the spine and across the top of the head, and ending at GV 28 (Yinjiao) in the oral cavity at the frenulum of the upper lip.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</dcterms:bibliographicCitation>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <TARA:hasSynonym>Acupoint of the Du channel</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of the Du channel</TARA:hasSynonym>
        <TARA:hasSynonym>Du</TARA:hasSynonym>
        <TARA:hasSynonym>GV</TARA:hasSynonym>
        <rdfs:label>Acupoint of the Governor Vessel</rdfs:label>
    </owl:Class>
    


