        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <TARA:hasSynonym>Conception Vessel 20</TARA:hasSynonym>
        <TARA:hasSynonym>RN 20</TARA:hasSynonym>
        <TARA:hasSynonym>Ren 20</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Zhongting (CV 16).</TARA:hasVasculatureDescription>
        <rdfs:label>CV 20</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_0739106 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_0739106">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/isMemberAcupointOf"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5419503"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Liver Meridian of Foot-Jueyin (LR), which consists of 14 standardized acupoints beginning at LR 1 (Dadun) on the lateral side of the great toe near the corner of the nail, traveling up along the medial aspect of the leg and passing through the genital region and abdomen, and ending at LR 14 (Qimen) on the anterior chest in the sixth intercostal space.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</dcterms:bibliographicCitation>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5419503"/>
        <TARA:hasSynonym>Acupoint of the liver meridian of foot-jueyin</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of the liver meridian</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of the liver meridian of foot-jueyin</TARA:hasSynonym>
        <TARA:hasSynonym>LR</TARA:hasSynonym>
        <rdfs:label>Acupoint of the Liver Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_0742938 -->

