        </rdfs:subClassOf>
        <obo:IAO_0000115>Region of the scapula where the latter meets with the clavicle: attachment point of the clavicle to the scapula in some taxa.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:UBPROP_0000001>Anterior rounded projection of the pars acromialis of the scapula.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000002>relationship loss: part_of pars acromialis (AAO:0000752)[AAO]</obo:UBPROP_0000002>
