        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002387"/>
        <TARA:hasSynonym>K 4</TARA:hasSynonym>
        <TARA:hasSynonym>Kidney 4</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The medial calcaneal branch of the posterior tibial artery.</TARA:hasVasculatureDescription>
        <rdfs:label>KI 4</rdfs:label>
    </owl:Class>
    


