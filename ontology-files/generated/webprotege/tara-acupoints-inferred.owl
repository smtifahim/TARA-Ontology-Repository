        <TARA:hasSynonym>Stomach 10</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The common carotid artery.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 10</rdfs:label>
    </owl:Class>
    


