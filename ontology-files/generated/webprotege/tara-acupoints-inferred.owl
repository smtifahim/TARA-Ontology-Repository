        <OboInOwl:hasDbXref>XAO:0004030</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>dense fibrous connective tissue</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>dense regular collagenous connective tissue</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>dense regular collagenous tissue</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>regular dense connective tissue</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>typus regularis (textus connectivus collagenosus compactus)</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
