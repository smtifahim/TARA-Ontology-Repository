        <OboInOwl:hasDbXref>UMLS:C0039987</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Thoracic_vertebrae</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>dorsal vertebra</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>thorax vertebra</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>vertebra of thorax</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>vertebra thoracica</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:id>UBERON:0002347</OboInOwl:id>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#human_reference_atlas"/>
