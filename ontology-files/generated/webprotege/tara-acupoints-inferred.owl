        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 202. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>章門(门)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7546644"/>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7809864"/>
        <TARA:hasIndicationsDescription>Abdominal distension, borborygmus, pain in the hypochondriac region, vomiting, diarrhea, indigestion.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>Slightly inferiorly, the tenth intercostal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the lateral abdomen, inferior to the free extremity of the 11th rib. Note: LR13 can be located while the subject is lying on the side with the shoulder flexed. The free extremity of the 11th rib can be palpated below the inferior border of the costal arch.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5419503"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Zhangmen</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002225"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004610"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000916"/>
        <TARA:hasSynonym>Front-Mu Point of the Spleen</TARA:hasSynonym>
        <TARA:hasSynonym>Influential Point of Zang Organs</TARA:hasSynonym>
        <TARA:hasSynonym>LIV 13</TARA:hasSynonym>
        <TARA:hasSynonym>LV 13</TARA:hasSynonym>
        <TARA:hasSynonym>Liver 13</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The terminal branch of the tenth intercostal artery.</TARA:hasVasculatureDescription>
        <rdfs:label>LR 13</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_0829128 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_0829128">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8364824"/>
