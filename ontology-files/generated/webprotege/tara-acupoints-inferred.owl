    <!-- http://purl.obolibrary.org/obo/UBERON_0002217 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002217">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/UBERON_0000982"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002219"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001484"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000982"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002162"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_7742"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002219"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001484"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Joint in which the articulating bones or cartilages are connected by an articular capsule which encloses a synovial membrane and a synovial cavity. Examples: Temporomandibular joint, knee joint.[FMA].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:UBPROP_0000001>Is a joint that is located at the point of contact of articulating bones allowing movement. The joint has a capsule containing synovial fluid surrounding the articulating bone surfaces.[TAO]</obo:UBPROP_0000001>
        <OboInOwl:hasDbXref>AEO:0000183</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>CALOHA:TS-2138</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EHDAA2:0003183</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:7501</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0000322</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C32461</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:113234001</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>TAO:0005153</OboInOwl:hasDbXref>
