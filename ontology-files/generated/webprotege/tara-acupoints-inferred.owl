        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 220. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Vaginitis, retention of urine hemorrhoids, nocturnal emission, enuresis, irregular menstruation, mental disorders.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The branch of the perineal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the perineal region, at the midpoint of the line connecting the anus with the posterior border of the scrotum in males and the posterior commissure of labium majoris in females. Note: CV 1 is located midway between the anus and the genital organ, with the subject lying on the side or in knee-chest position.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001245"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003133"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004084"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002356"/>
        <TARA:hasSynonym>Conception Vessel 1</TARA:hasSynonym>
        <TARA:hasSynonym>RN 1</TARA:hasSynonym>
        <TARA:hasSynonym>Ren 1</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The branches of the perineal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>CV 1 (Female)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7932600 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7932600">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/isMemberAcupointOf"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Large Intestine Meridian of Hand-Yangming (LI), which consists of 20 standardized acupoints beginning at LI 1 (Shangyang) on the radial side of the index finger near the corner of the nail, traveling up the dorsal-radial aspect of the arm and across the shoulder and side of the neck to the face, and ending at LI 20 (Yingxiang) in the nasolabial sulcus beside the ala of the nose.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</dcterms:bibliographicCitation>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <TARA:hasSynonym>Acupoint of the large intestine meridian of hand-yangming</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of the large intestine meridian</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of the large intestine meridian of hand-yangming</TARA:hasSynonym>
        <TARA:hasSynonym>LI</TARA:hasSynonym>
        <rdfs:label>Acupoint of the Large Intestine Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_8009041 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_8009041">
