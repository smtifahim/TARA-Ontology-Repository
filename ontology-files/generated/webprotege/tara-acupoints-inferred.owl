    <!-- http://purl.obolibrary.org/obo/UBERON_0002412 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002412">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002513"/>
