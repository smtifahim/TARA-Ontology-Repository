                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 103. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>通(通)天</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Headache, giddiness, nasal obstruction, epistaxis, rhinorrhea.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The branch of the great occipital nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the head, 4 B-cun superior to the anterior hairline, 1.5 B-cun lateral to the anterior median line. Note: Midway between BL6 and BL8.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Tongtian</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795292"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <TARA:hasSynonym>B 7</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 7</TARA:hasSynonym>
        <TARA:hasSynonym>UB 7</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 7</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The superficial temporal artery and vein and the occipital artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 7</rdfs:label>
    </owl:Class>
    


