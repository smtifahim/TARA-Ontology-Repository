    <!-- http://purl.obolibrary.org/obo/MONDO_0006862 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0006862">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005336"/>
        <obo:IAO_0000115>Muscular pain in numerous body regions that can be reproduced by pressure on trigger points, localized hardenings in skeletal muscle tissue. Pain is referred to a location distant from the trigger points. A prime example is the temporomandibular joint dysfunction syndrome.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/mondo.owl"/>
        <OboInOwl:hasDbXref>DOID:431</OboInOwl:hasDbXref>
