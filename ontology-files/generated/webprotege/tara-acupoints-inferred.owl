    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6269212 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6269212">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Nausea, vomiting, hiccup.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the midpoint of the proximal interphalangeal joint of the middle finger at dorsum aspect.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Moxibustion is applied with three moxa cones.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-UE 4</TARA:hasSynonym>
        <rdfs:label>Zhongkui</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6299396 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6299396">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5361067"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001461"/>
                    </owl:Restriction>
