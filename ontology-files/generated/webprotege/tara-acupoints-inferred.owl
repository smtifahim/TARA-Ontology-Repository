        <OboInOwl:hasDbXref>TGMA:0000131</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VHOG:0000280</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VHOG:0000812</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Mouth</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>XAO:0003029</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>ZFA:0000547</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>ZFA:0000590</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>galen:Mouth</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>http://purl.oboInOwllibrary.org/oboInOwl/uberon/images/lamprey_sucker_rosava_3238889218.jpg</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>regio oralis</OboInOwl:hasExactSynonym>
