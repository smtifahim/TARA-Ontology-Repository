        <TARA:hasChineseLabel>足竅(窍)陰(阴)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <TARA:hasIndicationsDescription>Migraine, deafness, tinnitus, ophthalmalgia, dream-disturbed sleep, febrile diseases.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The dorsal digital nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the fourth toe, lateral to the distal phalanx, 0.1 f-cun proximal to the lateral corner of the toenail, at the intersection of the vertical line of the lateral side of the nail and the horizontal line of the base of the fourth toenail.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <TARA:hasMethodDescription>Puncture superficially about 0.1 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Zuqiaoyin</TARA:hasPinyinLabel>
