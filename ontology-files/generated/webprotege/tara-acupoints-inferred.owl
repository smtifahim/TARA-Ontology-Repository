        <ilxtr:hasIlxPreferredId rdf:resource="http://uri.interlex.org/base/ilx_0795311"/>
        <NIFRID:synonym>posterior armpit fold</NIFRID:synonym>
        <rdfs:label>posterior axillary fold</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795312 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006800"/>
        <obo:IAO_0000115>A vertical line running along the posterior midline of the back, aligned with the spinous processes of the vertebrae.</obo:IAO_0000115>
        <ilxr:type rdf:resource="http://uri.interlex.org/base/readable/type/term"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
