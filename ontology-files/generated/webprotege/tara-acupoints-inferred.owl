        <OboInOwl:hasRelatedSynonym>pleural rib</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>ribs</OboInOwl:hasRelatedSynonym>
        <OboInOwl:id>UBERON:0002228</OboInOwl:id>
