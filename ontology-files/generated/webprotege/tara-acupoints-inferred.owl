        <TARA:hasSynonym>TH 3</TARA:hasSynonym>
        <TARA:hasSynonym>TW 3</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 3</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 3</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 3</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 3</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The dorsal venous network of hand and the fourth dorsal metacarpal artery.</TARA:hasVasculatureDescription>
        <rdfs:label>TE 3</rdfs:label>
    </owl:Class>
    


