        <TARA:hasChineseLabel>不容</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Abdominal distension, vomiting, gastric pain, anorexia.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The branch of the seventh intercostal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the upper abdomen, 6 B-cun superior to the centre of the umbilicus, 2 B-cun lateral to the anterior median line. Note 1: ST 19 is 2 B-cun lateral to CV14. Note 2: If the infrasternal angle is too sharp and the rib is located inferior to ST 19, ST 19 can be reached by oblique needling.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Burong</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002228"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795302"/>
        <TARA:hasSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795301"/>
        <TARA:hasSynonym>S 19</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 19</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The branches of the seventh intercostal artery and vein, the branches of the superior epigastric artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 19</rdfs:label>
    </owl:Class>
    


