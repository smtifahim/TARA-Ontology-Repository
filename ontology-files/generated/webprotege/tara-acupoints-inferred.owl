        <TARA:hasChineseLabel>(浮)白</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Headache, tinnitus, deafness.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the head, posterosuperior to the mastoid process, at the junction of the upper one third and lower two thirds of the curved line from gB9 to gB12. Note: Posterior to the auricular apex, 1 B-cun superior to the hairline.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Fubai</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001690"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004104"/>
