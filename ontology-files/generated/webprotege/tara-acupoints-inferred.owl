        <TARA:hasSynonym>UB 28</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 28</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior branches of the lateral sacral artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 28</rdfs:label>
