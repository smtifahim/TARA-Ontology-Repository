        <OboInOwl:hasDbXref>FMA:54448</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0000261</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C12401</OboInOwl:hasDbXref>
