        <OboInOwl:hasDbXref>EHDAA2:0000895</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EHDAA:5159</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EHDAA:6184</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EMAPA:17493</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:24974</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>GAID:48</OboInOwl:hasDbXref>
