                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://uri.interlex.org/base/ilx_0795319"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 165. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>天髎(髎)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Pain in the shoulder and elbow, stiffness of the neck.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The accessory nerve and the branch of the suprascapular nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the scapular region, in the depression superior to the superior angle of the scapula. Note: With the upper limb hanging by the side of trunk in a seated position, TE15 is located midway between gB21 and SI13.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Tianliao</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006849"/>
        <TARA:hasSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795319"/>
        <TARA:hasSynonym>SJ 15</TARA:hasSynonym>
        <TARA:hasSynonym>San Jiao 15</TARA:hasSynonym>
        <TARA:hasSynonym>TB 15</TARA:hasSynonym>
        <TARA:hasSynonym>TH 15</TARA:hasSynonym>
        <TARA:hasSynonym>TW 15</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 15</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 15</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 15</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 15</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The descending branch of the transverse cervical artery; deeper, the muscular branch of the suprascapular artery.</TARA:hasVasculatureDescription>
        <rdfs:label>TE 15</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5850983 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5850983">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Malnutrition and indigestion syndrome in children, whooping cough.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the palmar surface, in the midpoint of the transverse creases of the proximal interphalangeal joints of the index, middle, ring and little fingers.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Prick to cause bleeding, or squeeze out a small amount of yellowish viscous fluid locally.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-UE 10</TARA:hasSynonym>
        <TARA:hasSynonym>M-UE 9</TARA:hasSynonym>
        <rdfs:label>Sifeng</rdfs:label>
    </owl:Class>
    


