    <!-- http://purl.obolibrary.org/obo/UBERON_0005402 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0005402">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006846"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001834"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The vertical groove found on the median line of the upper lip, extending to the nose.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:UBPROP_0000008>vestigial in humans. In humans, the philtrum is formed where the nasomedial and maxillary processes meet during embryonic development (colloquially known as Hulse lines). When these processes fail to fuse fully in humans, a cleft lip (sometimes called a &apos;hare lip&apos;) can result. A flattened or smooth philtrum can be a symptom of fetal alcohol syndrome or Prader-Willi syndrome</obo:UBPROP_0000008>
        <OboInOwl:hasDbXref>EHDAA2:0001462</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EHDAA:9280</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EMAPA:17926</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:59819</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0001577</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:362087004</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VHOG:0000862</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Philtrum</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>lip philtrum</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:hasRelatedSynonym>infranasal depression</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>medial cleft</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>philtral region of upper lip</OboInOwl:hasRelatedSynonym>
        <OboInOwl:id>UBERON:0005402</OboInOwl:id>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#human_subset"/>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#mouse_subset"/>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#pheno_slim"/>
        <rdfs:comment>Philtrum is modelled as the groove rather than the surface structure itself.</rdfs:comment>
        <rdfs:label>philtrum</rdfs:label>
        <rdfs:seeAlso>https://github.com/obophenotype/uberon/pull/2691</rdfs:seeAlso>
    </owl:Class>
    


