        <OboInOwl:hasDbXref>NCIT:C12785</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:265794003</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C0036471</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Scrotum</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>galen:Scrotum</OboInOwl:hasDbXref>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
