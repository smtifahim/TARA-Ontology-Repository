    <!-- http://purl.obolibrary.org/obo/UBERON_0004610 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004610">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002228"/>
        <obo:IAO_0000115>The eleventh rib has a single articular facet on the head, which is of rather large size. It has no necks or tubercles, and is pointed at its anterior ends. The eleventh has a slight angle and a shallow costal groove. [WP,unvetted].</obo:IAO_0000115>
