        <TARA:hasChineseLabel>陰(阴)都(都)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Borborygmus, abdominal pain, epigastric pain, constipation, vomiting.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the upper abdomen, 4 B-cun superior to the centre of the umbilicus, 0.5 B-cun lateral to the anterior median line.</TARA:hasLocationalDescription>
