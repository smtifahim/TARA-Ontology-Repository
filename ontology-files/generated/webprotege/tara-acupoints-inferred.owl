                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 177. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>完骨(骨)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Headache, insomnia, swelling of the cheek, retroauricular pain, deviation of the eye and mouth, toothache.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lesser occipital nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the anterior region of the neck, in the depression posteroinferior to the mastoid process.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <TARA:hasMethodDescription>Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Wangu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011220"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <TARA:hasSynonym>G 12</TARA:hasSynonym>
        <TARA:hasSynonym>Gallbladder 12</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior auricular artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>GB 12</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1051162 -->

