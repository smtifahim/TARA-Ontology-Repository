        <TARA:hasVasculatureDescription>The branches of the thoracoacromial artery and thoracoacromial vein; superiorly, the subclavicular vein.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 13</rdfs:label>
    </owl:Class>
    


