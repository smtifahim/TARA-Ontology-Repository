        <TARA:hasSynonym>K 23</TARA:hasSynonym>
        <TARA:hasSynonym>Kidney 23</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The fourth intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>KI 23</rdfs:label>
    </owl:Class>
    


