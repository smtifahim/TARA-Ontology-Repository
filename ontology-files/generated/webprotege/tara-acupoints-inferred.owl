Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>鳩(鸠)尾</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6993030"/>
        <TARA:hasIndicationsDescription>Pain in the cardiac region and the chest, nausea, mental disorders, epilepsy.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the upper abdomen, 1 B-cun inferior to the xiphisternal junction, on the anterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <TARA:hasMethodDescription>Puncture obliquely downward 0.4-0.6 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Jiuwei</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011124"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795301"/>
        <TARA:hasSynonym>Conception Vessel 15</TARA:hasSynonym>
        <TARA:hasSynonym>RN 15</TARA:hasSynonym>
        <TARA:hasSynonym>Ren 15</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Zhongwan (CV 12).</TARA:hasVasculatureDescription>
        <rdfs:label>CV 15</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7634323 -->

