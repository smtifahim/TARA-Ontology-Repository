                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010759"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
                <owl:someValuesFrom>
