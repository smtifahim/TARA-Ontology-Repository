        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 67. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>衝(冲)陽(阳)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1840369"/>
        <TARA:hasIndicationsDescription>Pain of the upper teeth, redness and swelling of the dorsum of the foot, facial paralysis, muscular atrophy and motor impairment of the foot.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>Superficially, the medial dorsal cutaneous nerve of foot derived from the superficial peroneal nerve; deeper, the deep peroneal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the dorsum of the foot, at the joint of the base of the second metatarsal bone and the intermediate cuneiform bone, over the dorsalis pedis artery.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <TARA:hasMethodDescription>Avoid puncturing the artery.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Chongyang</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001453"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001539"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003651"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002387"/>
        <TARA:hasSynonym>S 42</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 42</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The dorsal artery and vein of foot, the dorsal venous network of foot.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 42</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7218725 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7218725">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552"/>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointDesignation"/>
                <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3839815"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009567"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
