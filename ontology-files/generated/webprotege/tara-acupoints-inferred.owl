    <!-- http://purl.obolibrary.org/obo/UBERON_0002225 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006800"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002228"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The costal margin, sometimes referred to as the costal arch, is the medial margin formed by the false ribs, which in humans is from the eighth rib to the tenth rib.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:UBPROP_0000012>we treat margin and arch in FMA as equivalent here, as a temporary measure. This may be split in future. We follow MA in making this a part of the rib.</obo:UBPROP_0000012>
        <OboInOwl:hasDbXref>EMAPA:37491</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:7569</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:7570</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0001396</OboInOwl:hasDbXref>
