                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003635"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 133. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>至陰(阴)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <TARA:hasIndicationsDescription>Headache, nasal obstruction, epistaxis, ophthalmalgia, malposition of fetus, difficult labour, detention of after birth, feverish sensation in the sole.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The plantar digital proprial nerve and the lateral dorsal cutaneous nerve of foot.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the little toe, lateral to the distal pha- lanx, 0.1 f-cun proximal to the lateral corner of the toenail; at the intersection of the vertical line of the lateral side of the nail and the horizontal line of the base of the toenail.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture superficially 0.1 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Zhiyin</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009567"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003635"/>
        <TARA:hasSynonym>B 67</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 67</TARA:hasSynonym>
        <TARA:hasSynonym>UB 67</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 67</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The network formed by the dorsal digital artery and plantar digital proprial artery.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 67</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7226516 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7226516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006800"/>
        <dc:description>In traditional Chinese Medicine (TCM), meridians are strings connecting acupuncture points, which are considered as passageways through which energy flows throughout the body. The meridian system is composed of 12 principal meridians, each of which connects to an organ system and extends to an extremity and eight collaterals.</dc:description>
        <dcterms:bibliographicCitation>Maurer, N., Nissel, H., Egerbacher, M., Gornik, E., Schuller, P., &amp; Traxler, H. (2019). Anatomical evidence of acupuncture meridians in the human extracellular matrix: results from a macroscopic and microscopic interdisciplinary multicentre study on human corpses. Evidence-Based Complementary and Alternative Medicine, 2019. https://doi.org/10.1155/2019/6976892</dcterms:bibliographicCitation>
        <TARA:hasSynonym>Acupuncture meridian</TARA:hasSynonym>
        <rdfs:label>Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7228895 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7228895">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004618"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedOnTheSurfaceOf"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005462"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 125. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>志室</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Nocturnal emission, impotence, enuresis, frequency of urination, dysuria, irregular menstruation, pain in the back and knee, edema.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lateral branch of the posterior ramus of the twelfth thoracic nerve and the lateral branch of the first lumbar nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the lumbar region, at the same level as the inferior border of the spinous process of the second lumbar vertebra (L2), 3 B-cun lateral to the posterior median line. Note: BL52, BL23 and GV4 are located at the same level as the inferior border of the spinous process of the second lumbar vertebra (L2).</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Zhishi</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004618"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005462"/>
        <TARA:hasSynonym>B 52</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 52</TARA:hasSynonym>
        <TARA:hasSynonym>UB 52</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 52</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior branches of the second lumbar artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 52</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7233436 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7233436">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Sore neck, pain in the shoulder and arm.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the dorsum of the hand, between the second and third metacarpal bones, about 0.5 cun posterior to metacarpophalangeal joint.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-UE 14</TARA:hasSynonym>
        <TARA:hasSynonym>M-UE 24</TARA:hasSynonym>
        <rdfs:label>Luozhen</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7280334 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7280334">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
                <owl:someValuesFrom>
