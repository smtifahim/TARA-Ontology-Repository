        <TARA:hasSynonym>Stomach 37</TARA:hasSynonym>
        <TARA:hasSynonym>The Lower He-Sea Point of the Large Intestine</TARA:hasSynonym>
        <rdfs:label>ST 37</rdfs:label>
    </owl:Class>
    


