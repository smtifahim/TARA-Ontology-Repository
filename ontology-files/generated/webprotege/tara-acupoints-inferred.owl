        <TARA:hasChineseLabel>足通(通)谷</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9857829"/>
        <TARA:hasIndicationsDescription>Headache, neck rigidity, blurring of vision, epistaxis, mania.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The plantar digital proprial nerve and the lateral dorsal cutaneous nerve of foot.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the little toe, in the depression distal and lateral to the fifth metatarsophalangeal joint, at the border between the red and white flesh.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.2-0.3 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Zutonggu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007762"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003635"/>
        <TARA:hasSynonym>B 66</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 66</TARA:hasSynonym>
        <TARA:hasSynonym>UB 66</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 66</TARA:hasSynonym>
        <rdfs:label>BL 66</rdfs:label>
    </owl:Class>
    


