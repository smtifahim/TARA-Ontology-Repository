        <OboInOwl:hasDbXref>SCTID:430725003</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C0877149</OboInOwl:hasDbXref>
        <OboInOwl:id>MONDO:0006894</OboInOwl:id>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/mondo#otar"/>
        <rdfs:label>patellofemoral pain syndrome</rdfs:label>
        <skos:closeMatch rdf:resource="http://identifiers.org/meddra/10049143"/>
        <skos:exactMatch rdf:resource="http://identifiers.org/medgen/164080"/>
        <skos:exactMatch rdf:resource="http://identifiers.org/mesh/D046788"/>
