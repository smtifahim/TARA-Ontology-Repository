        <TARA:hasSynonym>Bladder 65</TARA:hasSynonym>
        <TARA:hasSynonym>UB 65</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 65</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The fourth common plantar digital artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 65</rdfs:label>
    </owl:Class>
    


