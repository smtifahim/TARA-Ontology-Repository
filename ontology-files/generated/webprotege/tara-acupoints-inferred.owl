        <TARA:hasChineseLabel>大敦</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <TARA:hasIndicationsDescription>Hernia, enuresis, uterine bleeding, prolapse of the uterus, epilepsy.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The dorsal digital nerve derived from the deep peroneal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the great toe, lateral to the distal phalanx, 0.1 f-cun proximal to the lateral corner of the toenail, at the intersection of the vertical line of the lateral side of the nail and the horizontal line of the base of the toenail.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5419503"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.1-0.2 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Dadun</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004300"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009567"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003631"/>
        <TARA:hasSynonym>LIV 1</TARA:hasSynonym>
        <TARA:hasSynonym>LV 1</TARA:hasSynonym>
        <TARA:hasSynonym>Liver 1</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The dorsal digital artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>LR 1</rdfs:label>
    </owl:Class>
    


