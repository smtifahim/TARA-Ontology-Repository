        <TARA:hasChineseLabel>經(经,経)渠</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7315457"/>
        <TARA:hasIndicationsDescription>Cough, asthma, fever, pain in the chest, sore throat, pain in the wrist.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lateral antebrachial cutaneous nerve and the superficial branch of the radial nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the anterolateral aspect of the forearm, between the radial styloid process and the radial artery, 1 B-cun superior to the palmar wrist crease. Note: 1 B-cun superior to LU9.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9964503"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.1-0.3 inch. Avoid puncturing the radial artery.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Jingqu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001404"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_7500078"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795334"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <TARA:hasSynonym>L 8</TARA:hasSynonym>
        <TARA:hasSynonym>Lung 8</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>Laterally, the radial artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>LU 8</rdfs:label>
    </owl:Class>
    


