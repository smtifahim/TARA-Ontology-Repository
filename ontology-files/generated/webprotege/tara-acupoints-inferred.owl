        <TARA:hasChineseLabel>關(关,関)門(门)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Abdominal distension and pain, anorexia, borborygmus, diarrhea, edema.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the upper abdomen, 3 B-cun superior to the centre of the umbilicus, 2 B-cun lateral to the anterior median line. Note: ST22 is located at the same level and lateral to KI18 and CV11.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <TARA:hasPinyinLabel>Guanmen</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795301"/>
        <TARA:hasSynonym>S 22</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 22</TARA:hasSynonym>
        <rdfs:label>ST 22</rdfs:label>
    </owl:Class>
    


