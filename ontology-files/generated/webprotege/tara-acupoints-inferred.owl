        <ilxtr:hasIlxPreferredId rdf:resource="http://uri.interlex.org/base/ilx_0795299"/>
        <rdfs:label>fifth intercostal space</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795300 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006800"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The nipple line is an imaginary horizontal reference line running around the body at the level of the nipples.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
        <ilxr:type rdf:resource="http://uri.interlex.org/base/readable/type/term"/>
