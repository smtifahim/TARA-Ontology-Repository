                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 115. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>上髎(髎)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Low back pain, dysuria, constipation, irregular menstruation, morbid leukorrhea, prolapse of the uterus.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>At the site where the posterior ramus of the first sacral nerve passes.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the sacral region, in the first posterior sacral foramen. Note: The first posterior sacral foramen is palpated in the depression, moving superiorly from BL32.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Shangliao</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795313"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <TARA:hasSynonym>B 31</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 31</TARA:hasSynonym>
        <TARA:hasSynonym>UB 31</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 31</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior branches of the lateral sacral artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 31</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2478120 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2478120">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1375080"/>
        <rdfs:label>Ying-Spring Point Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2491709 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2491709">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Excessive heat, finger numbness, spasm and contracture of the fingers, redness and swelling of the dorsum of the hand.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the dorsum of the hand, at the junction of the white and red skin of the hand webs, eight in all, making a loose fist to locate the points.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture obliquely 0.3-0.5 inch, or prick to cause bleeding. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-UE 9</TARA:hasSynonym>
        <TARA:hasSynonym>M-UE 22</TARA:hasSynonym>
        <rdfs:label>Baxie</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2510634 -->

