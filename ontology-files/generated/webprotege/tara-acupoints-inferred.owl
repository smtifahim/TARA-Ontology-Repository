        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795333"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <TARA:hasSynonym>SJ 6</TARA:hasSynonym>
        <TARA:hasSynonym>San Jiao 6</TARA:hasSynonym>
        <TARA:hasSynonym>TB 6</TARA:hasSynonym>
        <TARA:hasSynonym>TH 6</TARA:hasSynonym>
        <TARA:hasSynonym>TW 6</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 6</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 6</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 6</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 6</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Waiguan (TE 5).</TARA:hasVasculatureDescription>
        <rdfs:label>TE 6</rdfs:label>
    </owl:Class>
    


