        <TARA:hasChineseLabel>陽(阳)陵泉</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2003524"/>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <TARA:hasInnervationDescription>Just where the common peroneal nerve bifurcates into the superficial and deep peroneal nerves.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the fibular aspect of the leg, in the depression anterior and distal to the head of the fibula.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
