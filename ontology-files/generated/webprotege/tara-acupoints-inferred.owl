        <TARA:hasChineseLabel>攢(攒,攅)竹</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Headache, blurring and failing of vision, pain in the supraorbital region, lacrimation, redness, swelling and pain of the eye, twitching of eyelids, glaucoma.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The medial branch of the frontal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the head, in the depression at the medial end of the eyebrow. Note: A depression, the frontal notch, can often be palpated on the medial end of the eyebrow directly superior to BL1.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch, or prick with three-edged needle to cause bleeding.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Zanzhu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010163"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0741726"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <TARA:hasSynonym>B 2</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 2</TARA:hasSynonym>
        <TARA:hasSynonym>UB 2</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 2</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The frontal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 2</rdfs:label>
    </owl:Class>
    


