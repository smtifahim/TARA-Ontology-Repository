    <!-- http://purl.obolibrary.org/obo/UBERON_0004704 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0004704">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002553"/>
