        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 141. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>橫骨(骨)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Fullness and pain of the lower abdomen, dysuria enuresis, nocturnal emission, impotence, pain of genitalia.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The branch of the iliohypogastric nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the lower abdomen, 5 B-cun inferior to the centre of the umbilicus, 0.5 B-cun lateral to the anterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <TARA:hasPinyinLabel>Henggu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <TARA:hasSynonym>K 11</TARA:hasSynonym>
        <TARA:hasSynonym>Kidney 11</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The inferior epigastric artery and external pudendal artery.</TARA:hasVasculatureDescription>
        <rdfs:label>KI 11</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9610280 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9610280">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Headache, vertigo, insomnia, poor memory, epilepsy.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>A group of 4 points, at the vertex, 1 cun respectively posterior, anterior and lateral to Baihui (GV 20). (See Fig. 119)</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-HN 1</TARA:hasSynonym>
        <TARA:hasSynonym>M-HN 1</TARA:hasSynonym>
        <rdfs:label>Sishencong</rdfs:label>
    </owl:Class>
    


