        <TARA:hasSynonym>Gallbladder 10</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Tianchong (GB 9)</TARA:hasVasculatureDescription>
        <rdfs:label>GB 10</rdfs:label>
    </owl:Class>
    


