        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 228. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>膻中</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0220312"/>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9406515"/>
        <TARA:hasIndicationsDescription>Asthma, pain in the chest, fullness in the chest, palpitation, insufficient lactation, hiccup, difficulty in swallowing.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The anterior cutaneous branch of the fourth intercostal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the anterior thoracic region, at the same level as the fourth intercostal space, on the anterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Tanzhong</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795298"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <TARA:hasSynonym>Conception Vessel 17</TARA:hasSynonym>
        <TARA:hasSynonym>Front-Mu Point of the Pericardium</TARA:hasSynonym>
        <TARA:hasSynonym>RN 17</TARA:hasSynonym>
        <TARA:hasSynonym>Ren 17</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Zhongting (CV 16).</TARA:hasVasculatureDescription>
        <rdfs:label>CV 17</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3480360 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3480360">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Insomnia, vertigo, headache, palpitation, mental disorders.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>Midpoint between Yifeng (TE 17) and Fengchi (GB 20).</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-HN 16</TARA:hasSynonym>
        <TARA:hasSynonym>M-HN 54</TARA:hasSynonym>
        <TARA:hasSynonym>N-HN 54</TARA:hasSynonym>
        <rdfs:label>Anmian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3493245 -->

