Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>少衝(冲)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <TARA:hasIndicationsDescription>Palpitation, cardiac pain, pain in the chest and hypochondriac regions, mania, febrile diseases, loss of consciousness.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The palmar digital proprial nerve derived from the ulnar nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the little finger, radial to the distal phalanx, 0.1 f-cun proximal-lateral to the radial corner of the little fingernail, at the intersection of the vertical line of the radial border of the nail and horizontal line of the base of the little fingernail.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.1 inch, or prick with a three-edged needle to cause bleeding. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Shaochong</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004300"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011277"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003625"/>
        <TARA:hasSynonym>H 9</TARA:hasSynonym>
        <TARA:hasSynonym>HE 9</TARA:hasSynonym>
        <TARA:hasSynonym>Heart 9</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The arterial and venous network formed by the palmar digital proprial artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>HT 9</rdfs:label>
    </owl:Class>
    


