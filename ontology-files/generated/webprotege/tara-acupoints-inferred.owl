        <OboInOwl:hasDbXref>UMLS:C0034015</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Pubic_symphysis</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>symphysis pubis</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:hasRelatedSynonym>interpubic articulation</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>symphisis pubis</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>symphysis pubica</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>symphysis pubis</OboInOwl:hasRelatedSynonym>
