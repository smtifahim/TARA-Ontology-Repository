        <TARA:hasSynonym>TB 7</TARA:hasSynonym>
        <TARA:hasSynonym>TH 7</TARA:hasSynonym>
        <TARA:hasSynonym>TW 7</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 7</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 7</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 7</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 7</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior antebrachial interosseous artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>TE 7</rdfs:label>
    </owl:Class>
    


