    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2454652 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2454652">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5282844"/>
        <rdfs:subClassOf>
            <owl:Restriction>
