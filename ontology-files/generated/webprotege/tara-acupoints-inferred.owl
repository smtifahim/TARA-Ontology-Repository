        <ilxtr:hasIlxId rdf:resource="http://uri.interlex.org/base/ilx_0795296"/>
        <ilxtr:hasIlxPreferredId rdf:resource="http://uri.interlex.org/base/ilx_0795296"/>
        <rdfs:label>sternal angle</rdfs:label>
    </owl:Class>
    


