        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 59. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>大巨</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Lower abdominal distension, dysuria, hernia, seminal emission, premature ejaculation.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The eleventh intercostal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the lower abdomen, 2 B-cun inferior to the centre of the umbilicus, 2 B-cun lateral to the anterior median line. Note: ST27 is at the same level and lateral to KI14 and CV5.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.7-1.2 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Daju</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <TARA:hasSynonym>S 27</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 27</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The branches of the eleventh intercostal artery and vein; laterally, the inferior epigastric artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 27</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1459681 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1459681">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/isMemberAcupointOf"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9964503"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Lung Meridian of Hand-Taiyin (LU), which consists of 11 standardized acupoints beginning at LU 1 (Zhongfu) on the upper anterior chest lateral to the infraclavicular fossa, traveling down the anterior-lateral aspect of the arm, and ending at LU 11 (Shaoshang) on the radial side of the thumb near the corner of the nail.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</dcterms:bibliographicCitation>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9964503"/>
        <TARA:hasSynonym>Acupoint of the lung meridian of hand-taiyin</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of the lung meridian</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of the lung meridian of hand-taiyin</TARA:hasSynonym>
        <TARA:hasSynonym>LU</TARA:hasSynonym>
        <rdfs:label>Acupoint of the Lung Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1460220 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1460220">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
                <owl:someValuesFrom>
