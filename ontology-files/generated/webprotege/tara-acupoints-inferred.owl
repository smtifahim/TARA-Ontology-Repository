            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The first opening in the posterior sacrum, allowing passage of sacral nerves.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <ilxr:type rdf:resource="http://uri.interlex.org/base/readable/type/term"/>
