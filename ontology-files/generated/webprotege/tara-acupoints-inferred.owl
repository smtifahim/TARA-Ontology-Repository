        <TARA:hasSynonym>S 24</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 24</TARA:hasSynonym>
        <rdfs:label>ST 24</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1216325 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1216325">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Stuffy chest, gastric pain, spitting of blood.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the dorsal crease of the wrist, in the depression on the radial side of the tendon of common extensor muscle of fingers between Yangxi (Ll 5) and Yangchi (TE 4).</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-UE 3</TARA:hasSynonym>
        <TARA:hasSynonym>M-UE 33</TARA:hasSynonym>
        <rdfs:label>Zhongquan</rdfs:label>
    </owl:Class>
    


