        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 142. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>氣(气,気)穴</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Irregular menstruation, dysmenorrhea, dysuria, abdominal pain, diarrhea.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The subcostal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the lower abdomen, 3 B-cun inferior to the centre of the umbilicus, 0.5 B-cun lateral to the anterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <TARA:hasPinyinLabel>Qixue</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <TARA:hasSynonym>K 13</TARA:hasSynonym>
        <TARA:hasSynonym>Kidney 13</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Dahe (KI 12).</TARA:hasVasculatureDescription>
        <rdfs:label>KI 13</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5361067 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5361067">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/isMemberAcupointOf"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Triple Energizer Meridian of Hand-Shaoyang (TE), which consists of 23 standardized acupoints beginning at TE 1 (Guanchong) on the ulnar side of the ring finger near the corner of the nail, traveling up the dorsal-middle aspect of the arm, ascending over the shoulder and the side of the neck, and circling around the ear, and ending at TE 23 (Sizhukong) in the depression at the lateral end of the eyebrow.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</dcterms:bibliographicCitation>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <TARA:hasSynonym>Acupuncture point of triple energizer meridian</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of triple energizer meridian of hand-shaoyang</TARA:hasSynonym>
        <TARA:hasSynonym>SJ</TARA:hasSynonym>
        <TARA:hasSynonym>TB</TARA:hasSynonym>
        <TARA:hasSynonym>TE</TARA:hasSynonym>
        <TARA:hasSynonym>TW</TARA:hasSynonym>
        <rdfs:label>Acupoint of Triple Energizer Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5362994 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5362994">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552"/>
