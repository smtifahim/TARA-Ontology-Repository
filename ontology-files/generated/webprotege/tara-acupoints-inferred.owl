    <!-- http://purl.obolibrary.org/obo/UBERON_0003652 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003652">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001448"/>
