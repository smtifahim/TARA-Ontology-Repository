Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>筋縮(缩)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Epilepsy, stiffness of the back, gastric pain.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The medial branch of the posterior ramus of the ninth thoracic nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the upper back region, in the depression inferior to the spinous process of the ninth thoracic vertebra (T9), on the posterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Jinsuo</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004633"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <TARA:hasSynonym>Du 8</TARA:hasSynonym>
        <TARA:hasSynonym>Governor Vessel 8</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior branch of the ninth intercostal artery.</TARA:hasVasculatureDescription>
        <rdfs:label>GV 8</rdfs:label>
    </owl:Class>
    


