        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 158. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>關(关,関)衝(冲)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <TARA:hasIndicationsDescription>Headache, redness of the eyes, sore throat, stiffness of the tongue, febrile diseases, irritability.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The palmar digital proprial nerve derived from the ulnar nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the ring finger, ulnar to the distal phalanx, 0.1 f-cun proximal to the ulnar corner of the fingernail, at the intersection of the vertical line of the ulnar side of the nail and the horizontal line of the base of the fingernail.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <TARA:hasMethodDescription>Puncture superficially 0.1 inch, or prick with a three-edged needle to cause bleeding. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Guanchong</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004300"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011276"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003624"/>
        <TARA:hasSynonym>SJ 1</TARA:hasSynonym>
        <TARA:hasSynonym>San Jiao 1</TARA:hasSynonym>
        <TARA:hasSynonym>TB 1</TARA:hasSynonym>
        <TARA:hasSynonym>TH 1</TARA:hasSynonym>
        <TARA:hasSynonym>TW 1</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 1</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 1</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 1</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 1</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The arterial and venous network formed by the palmar digital proprial artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>TE 1</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3386254 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3386254">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8364824"/>
