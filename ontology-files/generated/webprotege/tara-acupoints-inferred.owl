        <OboInOwl:hasDbXref>Wikipedia:Axillary_artery</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>galen:AxillaryArtery</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>arteria axillaris</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>axillary part of subclavian artery</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>axillary part of trunk of subclavian artery</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:id>UBERON:0001394</OboInOwl:id>
