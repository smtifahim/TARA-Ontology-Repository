            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 68. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>厲(厉)兌(兑)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <TARA:hasIndicationsDescription>Facial swelling, deviation of the mouth, epistaxis, toothache, sore throat and hoarse voice, abdominal distension, coldness in the leg and foot, febrile diseases, dream-disturbed sleep, mania.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The dorsal digital nerve derived from the superficial peroneal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the second toe, lateral to the distal phalanx, 0.1 f-cun proximal-lateral to the lateral corner of the second toenail, at the intersection of the vertical line of the lateral border and the horizontal line of the base of the second toenail.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.1 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Lidui</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004300"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011279"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003632"/>
        <TARA:hasSynonym>S 45</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 45</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The arterial and venous network formed by the dorsal digital artery and vein of foot.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 45</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2324295 -->

