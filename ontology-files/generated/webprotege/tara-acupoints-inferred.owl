        <TARA:hasSynonym>Bladder 39</TARA:hasSynonym>
        <TARA:hasSynonym>Lower He-Sea Point of Triple Energizer</TARA:hasSynonym>
        <TARA:hasSynonym>UB 39</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 39</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Fuxi (BL 38)</TARA:hasVasculatureDescription>
        <rdfs:label>BL 39</rdfs:label>
    </owl:Class>
    


