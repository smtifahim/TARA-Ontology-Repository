                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001474"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A depression or hollow in a bone[WP].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:UBPROP_0000001>Anatomical space that is a concavity, shallow depression, or groove on a bone.[TAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000012>General Anatomical term in FMA; not restricted to bone in ncit; surface feature in VSAO; note that entities named &apos;fossa&apos; are cavities in FMA, hence placement here</obo:UBPROP_0000012>
