        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 38. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>上廉</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Aching of the shoulder and arm, motor impairment of the upper limbs, numbness of the hand and arm, borborygmus, abdominal pain.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the posterolateral aspect of the forearm, on the line connecting LI5 with LI11, 3 B- cun inferior to the cubital crease.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Shanglian</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795332"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <TARA:hasSynonym>Large Intestine 9</TARA:hasSynonym>
        <rdfs:label>LI 9</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_0674193 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_0674193">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Hepatosplenomegaly, lumbar pain.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>3.5 cun lateral to the lower border of the spinous process of the first lumbar vertebra.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-B 4</TARA:hasSynonym>
        <TARA:hasSynonym>M-BW 16</TARA:hasSynonym>
        <rdfs:label>Pigen</rdfs:label>
    </owl:Class>
    


