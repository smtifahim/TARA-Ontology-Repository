        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:UBPROP_0000001>the tissue or structures associated with or embedded in the skin such as hair and hair follicles, sweat glands, sebaceous glands and claws or nails[MP:0010678]</obo:UBPROP_0000001>
        <OboInOwl:hasDbXref>EMAPA:37883</OboInOwl:hasDbXref>
