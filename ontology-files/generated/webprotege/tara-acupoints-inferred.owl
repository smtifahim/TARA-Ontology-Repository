        <OboInOwl:hasDbXref>MIAA:0000092</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>epipodium</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>middle free limb segment</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>middle limb segment</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>zeugopod limb segment</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>zeugopodial limb segment</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>zeugopodium</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>zygopod</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>zygopodium</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:hasRelatedSynonym>middle segment of free limb</OboInOwl:hasRelatedSynonym>
        <OboInOwl:id>UBERON:0002471</OboInOwl:id>
