        <TARA:hasChineseLabel>絡(络)卻(却)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Dizziness, blurring of vision, tinnitus, mania.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The branch of the great occipital nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the head, 5.5 B-cun superior to the anterior hairline, 1.5 B-cun lateral to the anterior median line. Note: 0.5 B-cun posterior and 1.5 B-cun lateral to gV20.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Luoque</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795292"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <TARA:hasSynonym>B 8</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 8</TARA:hasSynonym>
        <TARA:hasSynonym>UB 8</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 8</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The branches of the occipital artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_8300996 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_8300996">
