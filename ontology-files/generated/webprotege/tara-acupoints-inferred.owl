        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 136. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>然谷</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9857829"/>
        <TARA:hasIndicationsDescription>Pruritus vulvae, prolapse of uterus, irregular menstruation, nocturnal emission, hemoptysis, thirst, diarrhea, swelling and pain of the dorsum of foot, acute infantile omphalitis.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The terminal branch of the medial crural cutaneous nerve, the medial plantar nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the medial aspect of the foot, inferior to the tuberosity of the navicular bone, at the border between the red and white flesh.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <TARA:hasPinyinLabel>Rangu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010759"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002387"/>
        <TARA:hasSynonym>K 2</TARA:hasSynonym>
        <TARA:hasSynonym>Kidney 2</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The branches of the medial plantar and medial tarsal arteries.</TARA:hasVasculatureDescription>
        <rdfs:label>KI 2</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3135569 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3135569">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Headache, head heaviness, epistaxis, rhinorrhea, infantile convulsion, frontal headache, insomnia.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>Midway between the medial ends of the two eyebrows.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-HN 3</TARA:hasSynonym>
        <TARA:hasSynonym>M-HN 3</TARA:hasSynonym>
        <rdfs:label>Yintang</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3145377 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3145377">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Acute and chronic cholecystitis, cholelithiasis, biliary ascariasis, muscular atrophy and numbness of the lower extremities.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>The tender spot 1-2 cun directly below Yanglingquan (GB 34).</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-LE 6</TARA:hasSynonym>
        <TARA:hasSynonym>M-LE 23</TARA:hasSynonym>
        <rdfs:label>Dannangxue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3182190 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3182190">
