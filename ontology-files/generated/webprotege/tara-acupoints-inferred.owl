        <TARA:hasChineseLabel>秩邊(边,辺)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Pain in the lumbosacral region, muscular atrophy, motor impairment of the lower extremities, dysuria, swelling around external genitalia, hemorrhoids, constipation.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The inferior gluteal nerve, the posterior femoral cutaneous nerve and the sciatic nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the buttock region, at the same level as the fourth posterior sacral foramen, 3 B-cun lateral to the median sacral crest. Note: 3 B-cun lateral to the sacral hiatus, at the same level as BL 30.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 1.5-2.0 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Zhibian</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0741680"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0741717"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795316"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013691"/>
        <TARA:hasSynonym>B 54</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 54</TARA:hasSynonym>
        <TARA:hasSynonym>UB 54</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 54</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The inferior gluteal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 54</rdfs:label>
    </owl:Class>
    


