        <TARA:hasLocationalDescription>On the veins on both sides of the frenulum of the tongue, Jinjin is on the left, Yuye, on the right.</TARA:hasLocationalDescription>
        <TARA:hasSynonym>EX-HN 13</TARA:hasSynonym>
        <TARA:hasSynonym>M-HN 13</TARA:hasSynonym>
        <TARA:hasSynonym>M-HN 20b</TARA:hasSynonym>
        <rdfs:label>Yuye</rdfs:label>
    </owl:Class>
    


