Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>大迎(迎)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Facial paralysis, trismus, swelling of the cheek, facial pain, toothache.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The facial and buccal nerves.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the face, anterior to the angle of the mandible, in the depression anterior to the masseter attachment, over the facial artery.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <TARA:hasMethodDescription>Avoid puncturing the artery. Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Daying</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001597"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001612"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001684"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <TARA:hasSynonym>S 5</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 5</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>Anteriorly, the facial artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 5</rdfs:label>
    </owl:Class>
    


