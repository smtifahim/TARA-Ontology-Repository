        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001421"/>
        <TARA:hasSynonym>Small Intestine 10</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior circumflex humeral artery and vein; deeper, the suprascapular artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>SI 10</rdfs:label>
    </owl:Class>
    


