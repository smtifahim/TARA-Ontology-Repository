        <OboInOwl:hasDbXref>MESH:D008406</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MFMO:0000075</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C13074</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:181738000</OboInOwl:hasDbXref>
