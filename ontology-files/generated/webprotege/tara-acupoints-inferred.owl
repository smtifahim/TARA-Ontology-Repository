D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>天牖</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Headache, neck rigidity, facial swelling, blurring of vision, sudden deafness.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lesser occipital nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the anterior region of the neck, at the same level as the angle of the mandible, in the depression posterior to the sternocleidomastoid muscle.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Tianyou</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001128"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001684"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <TARA:hasSynonym>SJ 16</TARA:hasSynonym>
        <TARA:hasSynonym>San Jiao 16</TARA:hasSynonym>
        <TARA:hasSynonym>TB 16</TARA:hasSynonym>
        <TARA:hasSynonym>TH 16</TARA:hasSynonym>
        <TARA:hasSynonym>TW 16</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 16</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 16</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 16</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 16</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior auricular artery.</TARA:hasVasculatureDescription>
        <rdfs:label>TE 16</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9857829 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9857829">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1787498"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointDesignation"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2478120"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1787498"/>
        <dc:description>The names of the five shu points image the flow of meridian q i as the flow of water. The Ying-Spring point is where the meridian qi starts to gush.</dc:description>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2478120"/>
        <rdfs:label>Ying-Spring Point</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9876402 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9876402">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6993030"/>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7932600"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointDesignation"/>
                <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2162578"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://uri.interlex.org/base/ilx_0795333"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedOnTheSurfaceOf"/>
