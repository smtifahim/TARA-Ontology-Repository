        <ilxtr:hasIlxPreferredId rdf:resource="http://uri.interlex.org/base/ilx_0795306"/>
        <rdfs:label>lateral thoracic region</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795307 -->

