    <!-- http://purl.obolibrary.org/obo/UBERON_0000043 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000043">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007846"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002204"/>
            </owl:Restriction>
