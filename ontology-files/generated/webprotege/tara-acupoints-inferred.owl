        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <TARA:hasSynonym>Small Intestine 15</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See lianwaishu (SI 14).</TARA:hasVasculatureDescription>
        <rdfs:label>SI 15</rdfs:label>
    </owl:Class>
    


