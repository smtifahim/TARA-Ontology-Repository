    <!-- http://purl.obolibrary.org/obo/UBERON_0013631 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0013631">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010911"/>
        <obo:IAO_0000115>Ossicle that develops within bands of dense, regular connective tissue (e.g., tendons and ligaments). Sesamoids are generally located proximate to a bony prominence, over which the dense regular connective tissue wraps, and/or a joint or articulation.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <OboInOwl:hasDbXref>VSAO:0000137</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>sesamoid</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:id>UBERON:0013631</OboInOwl:id>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#human_subset"/>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#mouse_subset"/>
        <rdfs:comment>Sesamoids are often endochondral replacement elements and in addition to bone tissue, may also be composed of articular cartilage, fibrocartilage, hyaline cartilage, and calcified cartilage.</rdfs:comment>
        <rdfs:label>sesamoid element</rdfs:label>
    </owl:Class>
    


