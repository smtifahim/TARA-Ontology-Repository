                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 49. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>下關(关,関)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Deafness, tinnitus, otorrhea, toothache, facial paralysis, pain of the face, motor impairment of the jaw.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The zygomatic branch of the facial nerve and the branches of the auriculotemporal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the face, in the depression between the midpoint of the inferior border of the zygomatic arch and the mandibular notch. Note: When the mouth is closed, ST7 is located at the depression inferior to the zygomatic arch, directly inferior to gB3.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.1- 0.5 cun. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Xiaguan</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002500"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795291"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <TARA:hasSynonym>S 7</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 7</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>Superficially, the transverse facial artery and vein; in the deepest layer, the maxillary artery and maxillary vein.</TARA:hasVasculatureDescription>
        <rdfs:label>ST 7</rdfs:label>
    </owl:Class>
    


