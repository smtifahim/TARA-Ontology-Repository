        <TARA:hasSynonym>RN 12</TARA:hasSynonym>
        <TARA:hasSynonym>Ren 12</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The superior epigastric artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>CV 12</rdfs:label>
