                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 173. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>頷(颔)厭(厌)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Migraine, vertigo, tinnitus, pain in the outer canthus, toothache, convulsion, epilepsy.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The temporal branch of the auriculotemporal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the head, at the junction of the upper one fourth and lower three fourths of the curved line from St8 to gB7.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Hanyan</TARA:hasPinyinLabel>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <TARA:hasSynonym>G 4</TARA:hasSynonym>
        <TARA:hasSynonym>Gallbladder 4</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The parietal branches of the superficial temporal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>GB 4</rdfs:label>
    </owl:Class>
    


