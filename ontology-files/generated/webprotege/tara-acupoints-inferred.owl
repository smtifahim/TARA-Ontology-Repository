        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 156. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>中衝(冲)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <TARA:hasIndicationsDescription>Cardiac pain, palpitation, loss of consciousness, aphasia with stiffness and swelling of the tongue, febrile diseases, heat stroke, convulsion, feverish sensation in the palm.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The palmar digital proprial nerve of the median nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the middle finger, at the centre of the tip of the middle finger. Remarks: Alternative location for PC9 - On the middle finger, 0.1 F-cun proximal to the radial corner of the middle fingernail, at the intersection of the vertical line of the radial side of the nail and the horizontal line of the base of the fingernail.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4694897"/>
        <TARA:hasMethodDescription>Puncture superficially 0.1 inch or prick with a three-edged needle to cause bleeding. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Zhongchong</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009565"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003623"/>
        <TARA:hasSynonym>P 9</TARA:hasSynonym>
        <TARA:hasSynonym>Pericardium 9</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The arterial and venous network formed by the palmar digital proprial artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>PC 9</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5151019 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1132428"/>
        <dc:description>Acupuncture points of the fourteen meridians, also known as &quot;meridian points,&quot; acupuncture points of the fourteen meridians are distributed along the twelve main meridian, the Governor Vessel and the Conception Vessel, totally amounting to 361.</dc:description>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Page 115. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasSynonym>Acupoint of meridian</TARA:hasSynonym>
        <TARA:hasSynonym>Meridian Acupuncture Point</TARA:hasSynonym>
        <TARA:hasSynonym>Meridian point</TARA:hasSynonym>
        <TARA:hasSynonym>meridian points</TARA:hasSynonym>
        <rdfs:label>Meridian Acupoint</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5153816 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5153816">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Scrofula, cough, asthma, whooping cough, neck rigidity.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>2 cun above Dazhui (GV 14), 1 cun lateral to the midline.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-HN 15</TARA:hasSynonym>
        <TARA:hasSynonym>M-HN 30</TARA:hasSynonym>
        <rdfs:label>Bailao</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5208890 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5208890">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2798650"/>
        <rdfs:label>Xi-Cleft Point of the Yang Link Vessel Role</rdfs:label>
    </owl:Class>
    


