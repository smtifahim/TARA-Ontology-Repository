        <ilxtr:hasIlxPreferredId rdf:resource="http://uri.interlex.org/base/ilx_0795310"/>
        <rdfs:label>cubital fossa</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795311 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008785"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The posterior axillary fold, also known as the posterior armpit fold, refers to the inferior border of the posterior wall of axilla.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008785"/>
        <ilxr:type rdf:resource="http://uri.interlex.org/base/readable/type/term"/>
