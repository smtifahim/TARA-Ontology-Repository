        <TARA:hasSynonym>B 5</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 5</TARA:hasSynonym>
        <TARA:hasSynonym>UB 5</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 5</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Quchai (BL 4).</TARA:hasVasculatureDescription>
        <rdfs:label>BL 5</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7315457 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7315457">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
