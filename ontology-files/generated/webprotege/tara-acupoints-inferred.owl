    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_4598552 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4598552">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4943316"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointDesignation"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2798650"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4943316"/>
        <dc:description>The Xi-Cleft Point is the site where the qi and blood of the meridian are deeply converged. Each of the twelve main meridians and the four extra meridians (Yin Heel Vessel. Yang Heel Vessel. Yin Link Vessel and Yang Link Vessel) has a Xi-Cleft Point on the limbs, amounting to sixteen in all. The Xi-Cleft Point is used to treat acute disorders in the area supplied by its pertaining meridian and those of its pertaining zang or fu organ.</dc:description>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2798650"/>
        <rdfs:label>Xi-Cleft Point</rdfs:label>
    </owl:Class>
    


