                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedOnTheSurfaceOf"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001460"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 164. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>臑會(会)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Goiter, pain in the shoulder and arm.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The posterior brachial cutaneous nerve, the muscular branch of the radial nerve; deeper, the radial nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the posterior aspect of the arm, posteroinferior to the border of the deltoid muscle, 3 B-cun inferior to the acromial angle.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Naohui</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001476"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001460"/>
        <TARA:hasSynonym>SJ 13</TARA:hasSynonym>
        <TARA:hasSynonym>San Jiao 13</TARA:hasSynonym>
        <TARA:hasSynonym>TB 13</TARA:hasSynonym>
        <TARA:hasSynonym>TH 13</TARA:hasSynonym>
        <TARA:hasSynonym>TW 13</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 13</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 13</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 13</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 13</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The median collateral artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>TE 13</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3683574 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3683574">
