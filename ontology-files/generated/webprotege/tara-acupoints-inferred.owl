                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000376"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 200. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>足五里</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Lower abdominal distension and fullness, retention of urine.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The genitofemoral nerve, the anterior femoral cutaneous nerve; deeper, the anterior branch of the obturator nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the medial aspect of the thigh, 3 B-cun distal to St30, over the artery.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5419503"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Zuwuli</TARA:hasPinyinLabel>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000376"/>
        <TARA:hasSynonym>LIV 10</TARA:hasSynonym>
        <TARA:hasSynonym>LV 10</TARA:hasSynonym>
        <TARA:hasSynonym>Liver 10</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The superficial branches of the medial circumflex femoral artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>LR 10</rdfs:label>
    </owl:Class>
    


