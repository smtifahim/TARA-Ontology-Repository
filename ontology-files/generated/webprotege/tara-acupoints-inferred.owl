        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795332"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001461"/>
        <TARA:hasSynonym>Large Intestine 11</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The branches of the radial recurrent artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>LI 11</rdfs:label>
    </owl:Class>
    


