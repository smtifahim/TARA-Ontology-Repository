        <TARA:hasChineseLabel>小腸(肠)兪(俞)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8784353"/>
        <TARA:hasInnervationDescription>The lateral branch of the posterior ramus of the first sacral nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the sacral region, at the same level as the first posterior sacral foramen, and 1.5 B-cun lateral to the median sacral crest. Note: At the same level as BL31.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Xiaochangshu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0741680"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795313"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <TARA:hasSynonym>B 27</TARA:hasSynonym>
        <TARA:hasSynonym>Back-Shu Point of the Small Intestine</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 27</TARA:hasSynonym>
        <TARA:hasSynonym>UB 27</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 27</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior branches of the lateral sacral artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 27</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6941032 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6941032">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Rubella, eczema, gastrointestinal parasitic diseases.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>1 cun above Xuehai (SP 10).</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Pu ncture perpendicularly 1.0-1.2 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-LE 13</TARA:hasSynonym>
        <rdfs:label>Baichongwo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6946713 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6946713">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Pain in the supraorbital region, twitching of the eyelids, ptosis, cloudiness of the cornea, redness, swelling and pain of the eyes.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>At the midpoint of the eyebrow, directly above the pupil.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-HN 4</TARA:hasSynonym>
        <TARA:hasSynonym>M-HN 6</TARA:hasSynonym>
        <rdfs:label>Yuyao</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6969962 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6969962">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1092703"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003699"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
                <owl:someValuesFrom>
