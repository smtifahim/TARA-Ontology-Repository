        <OboInOwl:hasDbXref>Wikipedia:Index_finger</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>2nd digit of hand</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>2nd finger</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>digit 2 of fore-paw</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>finger 2</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>fore digit II</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>fore limb digit 2</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>hand digit 2</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>manual digit II</OboInOwl:hasExactSynonym>
