        <TARA:hasChineseLabel>曲鬢(鬓)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Headache, swelling of the cheek, trismus, pain in the temporal region, infantile convulsion.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the head, at the junction of the vertical line of the posterior border of the temple hairline and the horizontal line of the apex of the auricle.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Qubin</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001690"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004104"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <TARA:hasSynonym>G 7</TARA:hasSynonym>
        <TARA:hasSynonym>Gallbladder 7</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Hanyan (GB 4).</TARA:hasVasculatureDescription>
        <rdfs:label>GB 7</rdfs:label>
    </owl:Class>
    


