        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <TARA:hasSynonym>B 9</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 9</TARA:hasSynonym>
        <TARA:hasSynonym>UB 9</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 9</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The occipital artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 9</rdfs:label>
    </owl:Class>
    


