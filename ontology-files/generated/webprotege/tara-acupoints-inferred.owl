        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795321"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795322"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <TARA:hasSynonym>Front-Mu Point of the Gallbladder</TARA:hasSynonym>
        <TARA:hasSynonym>G 24</TARA:hasSynonym>
        <TARA:hasSynonym>Gallbladder 24</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The seventh intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>GB 24 (Female)</rdfs:label>
    </owl:Class>
    


