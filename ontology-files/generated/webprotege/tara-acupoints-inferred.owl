        <OboInOwl:hasNarrowSynonym>shoulder girdle</OboInOwl:hasNarrowSynonym>
        <OboInOwl:hasNarrowSynonym>upper limb girdle</OboInOwl:hasNarrowSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:hasRelatedSynonym>pectoral girdle</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>pectoral region</OboInOwl:hasRelatedSynonym>
