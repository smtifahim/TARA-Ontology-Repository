        <TARA:hasIndicationsDescription>Knee pain, weakness of the foot and leg, paralysis.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>In the depression of the midpoint of the superior patellar border.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.1-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002446"/>
