        <TARA:hasSynonym>B 12</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 12</TARA:hasSynonym>
        <TARA:hasSynonym>UB 12</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 12</TARA:hasSynonym>
        <rdfs:label>BL 12</rdfs:label>
    </owl:Class>
    


