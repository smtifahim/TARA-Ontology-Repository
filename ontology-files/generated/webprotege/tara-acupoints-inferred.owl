        <TARA:hasSynonym>Gallbladder 43</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The dorsal digital artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>GB 43</rdfs:label>
    </owl:Class>
    


