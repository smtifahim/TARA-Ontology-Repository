        <obo:IAO_0000115>Skeletal subdivision that is a segment of the limb skeleton.</obo:IAO_0000115>
        <obo:IAO_0000116>note the distinction between this and skeleton of limb</obo:IAO_0000116>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
