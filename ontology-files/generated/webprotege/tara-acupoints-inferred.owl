        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009567"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003631"/>
        <TARA:hasSynonym>Spleen 1</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The dorsal digital artery.</TARA:hasVasculatureDescription>
        <rdfs:label>SP 1</rdfs:label>
    </owl:Class>
    


