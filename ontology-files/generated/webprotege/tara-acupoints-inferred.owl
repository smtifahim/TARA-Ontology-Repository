        <ilxtr:hasIlxPreferredId rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <OboInOwl:hasDbXref>AEO:0000091</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>BTO:0001356</OboInOwl:hasDbXref>
