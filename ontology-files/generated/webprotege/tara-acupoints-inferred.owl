        <TARA:hasChineseLabel>懸(悬)釐(厘)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Migraine, pain in the outer canthus, tinnitus, frequent sneezing.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the head, at the junction of the upper three fourths and lower one fourth of the curved line from St8 to gB7.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <TARA:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
