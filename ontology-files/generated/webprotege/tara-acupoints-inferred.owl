        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003634"/>
        <TARA:hasSynonym>G 44</TARA:hasSynonym>
        <TARA:hasSynonym>Gallbladder 44</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The arterial and venous network formed by the dorsal digital artery and vein and plantar digital artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>GB 44</rdfs:label>
    </owl:Class>
    


