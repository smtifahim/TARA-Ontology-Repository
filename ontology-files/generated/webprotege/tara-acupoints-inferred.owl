    <!-- http://uri.interlex.org/base/ilx_0795316 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795316">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
