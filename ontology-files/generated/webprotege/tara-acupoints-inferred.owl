        <TARA:hasChineseLabel>溫(温)溜</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4598552"/>
        <TARA:hasIndicationsDescription>Headache, swelling of the face, sore throat, borborygmus, abdominal pain, aching of the shoulder and arm.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The posterior antebrachial cutaneous nerve and the deep ramus of the radial nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the posterolateral aspect of the forearm, on the line connecting LI5 with LI11, 5 B- cun superior to the dorsal wrist crease.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Wenliu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795333"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <TARA:hasSynonym>Large Intestine 7</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The muscular branch of the radial artery, the cephalic vein.</TARA:hasVasculatureDescription>
        <rdfs:label>LI 7</rdfs:label>
    </owl:Class>
    


