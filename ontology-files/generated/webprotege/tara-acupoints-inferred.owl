        <OboInOwl:hasRelatedSynonym>distal tarsal bones 4 and 5</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>foot distal tarsal bone 4 and 5</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>os cuboideum</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>os tarsale IV et V</OboInOwl:hasRelatedSynonym>
        <OboInOwl:id>UBERON:0001455</OboInOwl:id>
        <OboInOwl:inSubset rdf:resource="http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#human_reference_atlas"/>
