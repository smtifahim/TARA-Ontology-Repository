        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001461"/>
        <TARA:hasSynonym>Large Intestine 12</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The radial collateral artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>LI 12</rdfs:label>
    </owl:Class>
    


