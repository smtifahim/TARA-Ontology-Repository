        <OboInOwl:hasExactSynonym>anal orifice</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>opening of terminal part of digestive tract</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
        <OboInOwl:hasRelatedSynonym>proctodeum</OboInOwl:hasRelatedSynonym>
        <OboInOwl:id>UBERON:0001245</OboInOwl:id>
