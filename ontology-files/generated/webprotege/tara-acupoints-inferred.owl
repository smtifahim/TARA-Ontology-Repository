        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 111. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>腎兪(俞)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2432731"/>
        <TARA:hasIndicationsDescription>Nocturnal emission, impotence, enuresis, irregular menstruation, leukorrhea, low back pain, weakness of the knee, blurring of vision, dizziness, tinnitus, deafness, edema, asthma, diarrhea.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lateral branch of the posterior ramus of the first lumbar nerve; deeper, its lateral branch.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the lumbar region, at the same level as the inferior border of the spinous process of the second lumbar vertebra (L2), 1.5 B- cun lateral to the posterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 1-1.2 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Shenshu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004618"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005462"/>
        <TARA:hasSynonym>B 23</TARA:hasSynonym>
        <TARA:hasSynonym>Back-Shu Point of the Kidney</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 23</TARA:hasSynonym>
        <TARA:hasSynonym>UB 23</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 23</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior branches of the second lumbar artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 23</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_0995552 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/isMemberAcupointOf"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Bladder Meridian of Foot-Taiyang (BL), which consists of 67 standardized acupoints beginning at BL 1 (Jingming) on the face in the depression just superior to the inner canthus of the eye, traveling up over the head, descending down the back in two parallel lines flanking the spine, and continuing along the posterior aspect of the leg, ending at BL 67 (Zhiyin) on the lateral side of the little toe near the corner of the nail.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</dcterms:bibliographicCitation>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasSynonym>Acupoint of the bladder meridian of foot-taiyang</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of the bladder meridian</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of the bladder meridian of foot-taiyang</TARA:hasSynonym>
        <TARA:hasSynonym>Acupuncture point of the urinary bladder meridian</TARA:hasSynonym>
        <TARA:hasSynonym>BL</TARA:hasSynonym>
        <TARA:hasSynonym>UB</TARA:hasSynonym>
        <rdfs:label>Acupoint of the Bladder Meridian</rdfs:label>
    </owl:Class>
    


