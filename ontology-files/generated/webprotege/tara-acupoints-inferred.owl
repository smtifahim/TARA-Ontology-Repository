        <obo:IAO_0000115>1st (preaxial) digit of the manus[Wikipedia].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:RO_0002173 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_8782"/>
        <obo:UBPROP_0000008>Not present in Anurans (Phenotype RCN Oct 2012)</obo:UBPROP_0000008>
        <obo:UBPROP_0000008>This class represents the standard tetrapod configuration. Wagner proposes that avian digits I,II,III develop from C2,C3,C4. To support this scheme we have separate classes representing the avian digits (here called alula, manual digit, major digit).</obo:UBPROP_0000008>
