                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 78. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>天谿(溪)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Fullness and pain in the chest and hypochondrium, cough, hiccup, mastitis, insufficient lactation.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lateral cutaneous branch of the fourth intercostal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the anterior thoracic region, in the fourth intercostal space, 6 B-cun lateral to the anterior median line. Note: SP18, ST17 and KI23 are located along the curve of the fourth intercostal space.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <TARA:hasMethodDescription>Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Tianxi</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795298"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <TARA:hasSynonym>Spleen 18</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The branches of the lateral thoracic artery and vein, the thoracoepigastric artery and vein, the fourth intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>SP 18</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5660399 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5660399">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Redness, swelling and pain of the eyes, febrile disease, nebula.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>Fold the auricle, the point is at the apex of the auricle.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.1-0.2 inch or prick to cause bleeding.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-HN 6</TARA:hasSynonym>
        <TARA:hasSynonym>M-HN 10</TARA:hasSynonym>
        <rdfs:label>Erjian</rdfs:label>
    </owl:Class>
    


