                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001470"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Paired endochondral long bone that extends between the pectoral girdle and the skeletal parts of the forelimb. [PHENOSCAPE:mah].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000001>Paired, elongate, cylindrical bones of endochondral origin that extend from the pectoral girdle to the elbows.[AAO]</obo:UBPROP_0000001>
        <obo:UBPROP_0000003>Most anatomists now agree that the three proximal bones of the tetrapod limbs are homologous to the two or three proximal elements of the paired fin skeleton of other sarcopterygians, that is the humerus-femur, radius-tibia, and ulna-fibula.[well established][VHOG]</obo:UBPROP_0000003>
        <obo:UBPROP_0000007>humeral</obo:UBPROP_0000007>
        <dc:contributor rdf:resource="https://github.com/cmungall"/>
        <dc:contributor rdf:resource="https://github.com/mellybelly"/>
        <OboInOwl:hasDbXref>AAO:0000679</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>CALOHA:TS-2202</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EFO:0001398</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EMAPA:19106</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:13303</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>GAID:183</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0001356</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MESH:D006811</OboInOwl:hasDbXref>
