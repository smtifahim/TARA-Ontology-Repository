                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedOnTheSurfaceOf"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 124. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>意舍(舎)</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Abdominal distension, borborygmus, vomiting, diarrhea, difficulty in swallowing.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The lateral branches of the posterior rami of the tenth and eleventh thoracic nerves.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the upper back region, at the same level as the inferior border of the spinous process of the 11th thoracic vertebra (T11), 3 B-cun lateral to the posterior median line. Note: BL49, BL20 and GV6 are located at the same level as the inferior border of the spinous process of the 11th thoracic vertebra (T11).</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Yishe</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004635"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <TARA:hasSynonym>B 49</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 49</TARA:hasSynonym>
        <TARA:hasSynonym>UB 49</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 49</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior branches of the intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 49</rdfs:label>
    </owl:Class>
    


