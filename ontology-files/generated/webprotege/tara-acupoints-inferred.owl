        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <TARA:hasSynonym>SJ 21</TARA:hasSynonym>
        <TARA:hasSynonym>San Jiao 21</TARA:hasSynonym>
        <TARA:hasSynonym>TB 21</TARA:hasSynonym>
        <TARA:hasSynonym>TH 21</TARA:hasSynonym>
        <TARA:hasSynonym>TW 21</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Burner 21</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Energizer 21</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Heater 21</TARA:hasSynonym>
        <TARA:hasSynonym>Triple Warmer 21</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The superficial temporal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>TE 21</rdfs:label>
    </owl:Class>
    


