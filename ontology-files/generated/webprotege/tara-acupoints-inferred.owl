    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2063814 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2063814">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Apoplexy, coma, epilepsy, high fever, acute tonsillitis, infantile convulsion, numbness of the finger tips.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the tips of the ten fingers, about 0.1 cun distal to the nails.</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture 0.1-0.2 inch superficially, or prick to cause bleeding.</TARA:hasMethodDescription>
        <TARA:hasSynonym>EX-UE 11</TARA:hasSynonym>
        <TARA:hasSynonym>M-UE 1</TARA:hasSynonym>
        <rdfs:label>Shixuan</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2065487 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2065487">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9507527"/>
        <rdfs:label>Back-Shu Point of the Heart Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2070107 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2070107">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8866697"/>
