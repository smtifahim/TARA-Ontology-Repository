        <ilxtr:hasIlxId rdf:resource="http://uri.interlex.org/base/ilx_0795295"/>
        <ilxtr:hasIlxPreferredId rdf:resource="http://uri.interlex.org/base/ilx_0795295"/>
        <rdfs:label>second intercostal space</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795296 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795296">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The sternal angle (angle of Louis, Ludwig, or Ludovicus) is the inclined junction between the anterior surfaces of the manubrium and body of the sternum.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
        <ilxr:type rdf:resource="http://uri.interlex.org/base/readable/type/term"/>
