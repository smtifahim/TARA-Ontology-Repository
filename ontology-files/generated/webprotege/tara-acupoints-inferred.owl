    <!-- http://purl.obolibrary.org/obo/UBERON_0003696 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003696">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
