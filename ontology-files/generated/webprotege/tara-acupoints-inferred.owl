        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795295"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795296"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <TARA:hasSynonym>L 15</TARA:hasSynonym>
        <TARA:hasSynonym>Stomach 1</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>See Kufang (ST 14).</TARA:hasVasculatureDescription>
        <rdfs:label>ST 15</rdfs:label>
    </owl:Class>
    


