                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasIndicationsDescription>Asthma, cough, neck rigidity, pain in the shoulder and back, rubella.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>0.5 cun lateral to Dazhui (GV 14).</TARA:hasLocationalDescription>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004616"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <TARA:hasSynonym>EX-B 1</TARA:hasSynonym>
        <TARA:hasSynonym>M-BW 1</TARA:hasSynonym>
        <rdfs:label>Dingchuan</rdfs:label>
    </owl:Class>
    


