        <TARA:hasChineseLabel>俠(侠)谿(溪)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9857829"/>
        <TARA:hasIndicationsDescription>Headache, dizziness and vertigo, pain of the outer canthus, tinnitus, deafness, swelling of the cheek, pain in the hypochondriac region, distending pain of the breast, febrile diseases.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The dorsal digital nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the dorsum of the foot, between the fourth and fifth toes, proximal to the web margin, at the border between the red and white flesh.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
