    <!-- http://purl.obolibrary.org/obo/UBERON_0001455 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001455">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010721"/>
        <obo:IAO_0000115>A tarsal bone that is formed from distal tarsals 4 and 5. [WP,modified].</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:RO_0002175 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_9606"/>
        <obo:UBPROP_0000013>NominaAnatomicaVeterinaria uses os cuboideum as an official synonym for distal tarsal IV, but some sources also use this as the label for the human cuboid bone which is regarded to be formed from tarsals IV and V. We therefore decline to use exact syns in either case.</obo:UBPROP_0000013>
        <OboInOwl:hasDbXref>BTO:0002357</OboInOwl:hasDbXref>
