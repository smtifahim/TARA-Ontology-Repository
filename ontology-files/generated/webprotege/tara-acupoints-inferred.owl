Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>小海(海)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <TARA:hasIndicationsDescription>Headache, swelling of the cheek, pain in the nape, shoulder, arm and elbow, epilepsy.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The branches of the medial antebrachial cutaneous nerve, the ulnar nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the posteromedial aspect of the elbow, in the depression between the olecranon and the medial epicondyle of the humerus bone. Note: When the elbow is slightly flexed, SI 8 is located in the groove for the ulnar nerve.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9093316"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Xiaohai</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000976"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001494"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006806"/>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006810"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001461"/>
        <TARA:hasSynonym>Small Intestine 8</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The superior and inferior ulnar collateral arteries and veins, the ulnar recurrent artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>SI 8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5873796 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5873796">
