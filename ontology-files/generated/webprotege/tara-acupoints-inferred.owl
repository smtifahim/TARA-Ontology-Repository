    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_4611734 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4611734">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5282844"/>
