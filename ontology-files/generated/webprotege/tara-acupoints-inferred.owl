        <obo:IAO_0000115>A bone spine that is part of a ilium.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <OboInOwl:hasDbXref>FMA:82509</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:272712007</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Iliac_spine</OboInOwl:hasDbXref>
