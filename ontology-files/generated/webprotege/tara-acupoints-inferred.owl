        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasStudiedConditionNote -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasStudiedConditionNote">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasSurfaceLocation -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasSurfaceLocation">
        <dc:description>An annotation property that relates an acupoint to the general body region on whose surface it is located. It provides a coarse-grained anatomical grouping for the acupoint (e.g., LU 1 is located on the Anterior Thoracic Region). This property is used together with hasRelatedLocation, which further specifies the particular anatomical structures within this general region.</dc:description>
        <rdfs:label>General Body Region</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointLocation"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasSynonym -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasSynonym">
        <rdfs:label>Synonym</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000118"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasTrialType -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasTrialType">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasUsedAcupoint -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasUsedAcupoint">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasVasculatureDescription -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasVasculatureDescription">
        <dc:description>An annotation property that describes the blood vessels in the vicinity of an acupoint relevant to safe needling (e.g., LU 1: &apos;Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein.&apos;).</dc:description>
        <rdfs:label>Vasculature</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointDescription"/>
    </owl:AnnotationProperty>
    


