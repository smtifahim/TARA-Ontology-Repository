        <TARA:hasSynonym>K 24</TARA:hasSynonym>
        <TARA:hasSynonym>Kidney 24</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The third intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>KI 24</rdfs:label>
    </owl:Class>
    


