        <TARA:hasSynonym>K 12</TARA:hasSynonym>
        <TARA:hasSynonym>Kidney 12</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The muscular branches of the inferior epigastric artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>KI 12</rdfs:label>
