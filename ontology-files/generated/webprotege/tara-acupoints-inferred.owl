        <OboInOwl:hasRelatedSynonym>os zygomaticum</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>os zygomaticus</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>zygoma</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>zygomatic</OboInOwl:hasRelatedSynonym>
        <OboInOwl:id>UBERON:0001683</OboInOwl:id>
