        <TARA:hasChineseLabel>委陽(阳)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1160697"/>
        <TARA:hasIndicationsDescription>Stiffness and pain of the lower back, distension and fullness of the lower abdomen, edema, dysuria, cramp of the leg and foot.</TARA:hasIndicationsDescription>
        <TARA:hasLocationalDescription>On the posterolateral aspect of the knee, just medial to the biceps femoris tendon in the popliteal crease. Note: The biceps femoris tendon is more prominent when the knee is slightly flexed.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Weiyang</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795317"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795330"/>
