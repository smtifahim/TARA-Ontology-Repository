                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 36. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>偏歷(历)</TARA:hasChineseLabel>
        <TARA:hasDesignatedSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6993030"/>
        <TARA:hasIndicationsDescription>Redness of the eye, tinnitus, deafness, epistaxis, aching of the hand and arm, sore throat, edema.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>On the radial side, the lateral antebrachial cutaneous nerve and the superficial ramus of the radial nerve; on the ulnar side, the posterior antebrachial cutaneous nerve and the posterior antebrachial interosseous nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the posterolateral aspect of the forearm, on the line connecting LI5 with LI11, 3 B- cun superior to the dorsal wrist crease. Note: LI6 is located at the junction of the upper three fourths and the lower one fourth of the line connecting LI5 with LI11.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <TARA:hasMethodDescription>Puncture perpendicularly or obliquely 0.5-0.8 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Pianli</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795333"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <TARA:hasSynonym>Large Intestine 6</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The cephalic vein.</TARA:hasVasculatureDescription>
        <rdfs:label>LI 6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9881298 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9881298">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7315457"/>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8866697"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointDesignation"/>
