        <OboInOwl:hasDbXref>galen:ShoulderJoint</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>articulatio humeri</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>humeral joint</OboInOwl:hasExactSynonym>
