    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1031890 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1031890">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1926756"/>
