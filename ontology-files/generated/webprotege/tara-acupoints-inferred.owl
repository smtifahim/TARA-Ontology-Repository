        <OboInOwl:hasDbXref>SCTID:263484006</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C0010323</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VHOG:0001308</OboInOwl:hasDbXref>
