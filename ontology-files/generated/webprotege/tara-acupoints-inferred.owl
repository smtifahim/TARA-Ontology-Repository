        <TARA:hasSynonym>B 51</TARA:hasSynonym>
        <TARA:hasSynonym>Bladder 51</TARA:hasSynonym>
        <TARA:hasSynonym>UB 51</TARA:hasSynonym>
        <TARA:hasSynonym>Urinary Bladder 51</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The posterior branches of the first lumbar artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>BL 51</rdfs:label>
    </owl:Class>
    


