        <dcterms:bibliographicCitation>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 149. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>兪(俞)府</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Cough, asthma, chest pain.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The medial supraclavicular nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the anterior thoracic region, just inferior to the clavicle, 2 B-cun lateral to the anterior median line.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <TARA:hasPinyinLabel>Shufu</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001105"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <TARA:hasSynonym>K 27</TARA:hasSynonym>
        <TARA:hasSynonym>Kidney 27</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The anterior perforating branches of the internal mammary artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>KI 27</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_4510130 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4510130">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8364824"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/locatedInRelationTo"/>
