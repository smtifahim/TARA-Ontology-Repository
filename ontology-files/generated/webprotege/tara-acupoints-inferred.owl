    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6221269 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6200120"/>
