        <ilxtr:hasIlxPreferredId rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001630"/>
        <OboInOwl:hasBroadSynonym>muscle</OboInOwl:hasBroadSynonym>
        <OboInOwl:hasDbXref>EMAPA:37474</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EV:0100146</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:5022</OboInOwl:hasDbXref>
