        <TARA:hasChineseLabel>極(极)泉</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Pain in the costal and cardiac regions, scrofula, cold pain of the elbow and arm, dryness of the throat.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The ulnar nerve, median nerve and medial brachial cutaneous nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>In the axilla, in the centre of the axillary fossa, over the axillary artery.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009"/>
        <TARA:hasMethodDescription>Avoid puncturing the axillary artery. Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Jiquan</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001394"/>
        <TARA:hasRelatedLocation rdf:resource="http://uri.interlex.org/base/ilx_0795309"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009472"/>
        <TARA:hasSynonym>H 1</TARA:hasSynonym>
        <TARA:hasSynonym>HE 1</TARA:hasSynonym>
        <TARA:hasSynonym>Heart 1</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>Laterally, the axillary artery.</TARA:hasVasculatureDescription>
        <rdfs:label>HT 1</rdfs:label>
    </owl:Class>
    


