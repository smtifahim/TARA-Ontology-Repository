Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>大橫</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Abdominal pain and distension, diarrhea, dysentery, constipation.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The tenth intercostal nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the upper abdomen, 4 B-cun lateral to the centre of the umbilicus. Note: At the same level and lateral to ST25, KI16 and CV8.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <TARA:hasMethodDescription>Puncture perpendicularly 0.7-1.2 inches. Moxibustion is applicable.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Daheng</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <TARA:hasSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795301"/>
        <TARA:hasSynonym>Spleen 15</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The tenth intercostal artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>SP 15</rdfs:label>
    </owl:Class>
    


