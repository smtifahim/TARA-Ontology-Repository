            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The Achilles tendon is a tendon of the posterior leg. It serves to attach the plantaris, gastrocnemius (calf) and soleus muscles to the calcaneus (heel) bone.</obo:IAO_0000115>
        <obo:IAO_0000412 rdf:resource="http://purl.obolibrary.org/obo/uberon.owl"/>
        <obo:UBPROP_0000008>reduced in non-human primates</obo:UBPROP_0000008>
        <obo:UBPROP_0000009>bipedalism, running</obo:UBPROP_0000009>
        <obo:UBPROP_0000012>in FMA this is a ligament, and part of the muscle</obo:UBPROP_0000012>
        <OboInOwl:hasDbXref>EMAPA:35853</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:51061</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>GAID:277</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0002993</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MESH:D000125</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C32043</OboInOwl:hasDbXref>
