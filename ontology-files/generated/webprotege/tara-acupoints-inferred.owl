Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <TARA:hasChineseLabel>兌(兑)端</TARA:hasChineseLabel>
        <TARA:hasIndicationsDescription>Mental disorders, lip twitching, lip stiffness, pain and swelling of the gums.</TARA:hasIndicationsDescription>
        <TARA:hasInnervationDescription>The buccal branch of the facial nerve, and the branch of the infraorbital nerve.</TARA:hasInnervationDescription>
        <TARA:hasLocationalDescription>On the face, at the midpoint of the tubercle of the upper lip.</TARA:hasLocationalDescription>
        <TARA:hasMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <TARA:hasMethodDescription>Puncture obliquely upward 0.2-0.3 inch.</TARA:hasMethodDescription>
        <TARA:hasPinyinLabel>Duiduan</TARA:hasPinyinLabel>
        <TARA:hasRelatedLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001834"/>
        <TARA:hasSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <TARA:hasSynonym>Du 27</TARA:hasSynonym>
        <TARA:hasSynonym>Governor Vessel 27</TARA:hasSynonym>
        <TARA:hasVasculatureDescription>The superior labial artery and vein.</TARA:hasVasculatureDescription>
        <rdfs:label>GV 27</rdfs:label>
    </owl:Class>
    


