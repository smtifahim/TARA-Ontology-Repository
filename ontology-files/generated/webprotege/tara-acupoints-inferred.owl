        <OboInOwl:hasDbXref>FMA:22432</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0002403</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C117736</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Vastus_medialis</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>galen:VastusMedialis</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>vastus medialis muscle</OboInOwl:hasExactSynonym>
        <OboInOwl:hasOBONamespace>uberon</OboInOwl:hasOBONamespace>
