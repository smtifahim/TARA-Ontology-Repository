        <ilxtr:hasIlxPreferredId rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001474"/>
        <OboInOwl:hasDbXref>AAO:0000047</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>AEO:0000082</OboInOwl:hasDbXref>
