            owl:someValuesFrom UBERON:0002470 ],
        UBERON:0002529 .

UBERON:0012151 a owl:Class ;
    rdfs:label "skeleton of manual digitopodium" ;
    IAO:0000115 "A subdivision of the manus skeleton consisting of both manual acropodial skeleton and metacarpal skeleton, but excluding the carpal skeleton." ;
    OboInOwl:hasRelatedSynonym "manual digitopodium" ;
    rdfs:seeAlso "https://github.com/obophenotype/uberon/wiki/Subdivisions-of-the-autopod"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001442 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002398 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012141 ],
        UBERON:0012150 .

UBERON:0012152 a owl:Class ;
    rdfs:label "skeleton of pedal digitopodium" ;
    IAO:0000115 "A subdivision of the pes skeleton consisting of both pedal acropodial skeleton and metatarsal skeleton, but excluding the tarsal skeleton." ;
    OboInOwl:hasRelatedSynonym "pedal digitopodium" ;
    rdfs:seeAlso "https://github.com/obophenotype/uberon/wiki/Subdivisions-of-the-autopod"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001445 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002387 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012142 ],
        UBERON:0012150 .

UBERON:0012322 a owl:Class ;
    rdfs:label "ascending cervical artery" ;
    IAO:0000115 "The ascending cervical artery is a small branch which arises from the inferior thyroid artery as that vessel is passing behind the carotid sheath; it runs up on the anterior tubercles of the transverse processes of the cervical vertebrC& in the interval between the Scalenus anterior and Longus capitis. To the muscles of the neck it gives twigs which anastomose with branches of the vertebral, and it sends one or two spinal branches into the vertebral canal through the intervertebral foramina to be distributed to the medulla spinalis and its membranes, and to the bodies of the vertebrC&, in the same manner as the spinal branches from the vertebral. It anastomoses with the ascending pharyngeal and occipital arteries." ;
    OboInOwl:hasDbXref "FMA:52489",
        "SCTID:161846001",
        "Wikipedia:Ascending_cervical_artery" ;
    OboInOwl:hasRelatedSynonym "ascending cervical" ;
    rdfs:subClassOf UBERON:0012320 .

UBERON:0012357 a owl:Class ;
    rdfs:label "digitopodium bone" ;
    IAO:0000115 "A bone that is part of a the digitopodium skeleton - i.e. the acropodial skeleton or the metapodial skeleton." ;
    OboInOwl:hasRelatedSynonym "digit bone" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012140 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012150 ],
        UBERON:0011250 .

UBERON:0013646 a owl:Class ;
    rdfs:label "buccal nerve" ;
    IAO:0000115 "The buccal nerve (also called the long buccal nerve) is a nerve in the face. It is a branch of the mandibular nerve (which is itself a branch of the trigeminal nerve) and transmits sensory information from skin over the buccal membrane (in general, the cheek) and from the second and third molar teeth." ;
    OboInOwl:hasDbXref "BAMS:bucn",
        "FMA:53066",
        "SCTID:280253000",
        "Wikipedia:Buccal_nerve" ;
    OboInOwl:hasExactSynonym "buccinator nerve",
        "long buccal nerve" ;
    OboInOwl:hasRelatedSynonym "buccinator branch",
        "long buccal nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000375 ],
        UBERON:0011779 .

UBERON:0014848 a owl:Class ;
    rdfs:label "tendon of quadriceps femoris" ;
    OboInOwl:hasDbXref "FMA:46900",
        "SCTID:245175008" ;
    OboInOwl:hasExactSynonym "common tendon of quadriceps femoris",
        "quadriceps femoris tendon",
        "quadriceps tendon" ;
    OboInOwl:hasRelatedSynonym "common quadriceps femoris tendon",
        "common quadriceps tendon",
        "common tendon of quadriceps femoris muscle complex" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001377 ],
        UBERON:0000043,
        UBERON:0003589 .

UBERON:0015050 a owl:Class ;
    rdfs:label "tarsus endochondral element" ;
    IAO:0000115 "A tarsus bone or its cartilage or pre-cartilage precursor." ;
    OboInOwl:hasBroadSynonym "tarsus skeletal element" ;
    OboInOwl:hasExactSynonym "tarsus element" ;
