        TARA:7932600 .

HP:0002013 a owl:Class ;
    rdfs:label "Vomiting" ;
    IAO:0000115 "Forceful ejection of the contents of the stomach through the mouth by means of a series of involuntary spasmic contractions." ;
    OboInOwl:hasDbXref "MEDDRA:10047700",
        "SNOMEDCT_US:249497008",
        "SNOMEDCT_US:300359004",
        "SNOMEDCT_US:422400008",
        "UMLS:C0042963" ;
    OboInOwl:hasExactSynonym "Emesis",
        "Throwing up",
        "Vomiting" ;
    rdfs:subClassOf HP:0002017 .

HP:0002315 a owl:Class ;
    rdfs:label "Headache" ;
    IAO:0000115 "Cephalgia, or pain sensed in various parts of the head, not confined to the area of distribution of any nerve." ;
    OboInOwl:hasAlternativeId "HP:0000266",
        "HP:0001354" ;
    OboInOwl:hasDbXref "SNOMEDCT_US:25064002",
        "UMLS:C0018681" ;
    OboInOwl:hasExactSynonym "Headache",
        "Headaches" ;
    rdfs:comment "Headache is one of the most common types of recurrent pain as well as one of the most frequent symptoms in neurology. In addition to occasional headaches, there are well-defined headache disorders that vary in incidence, prevalence and duration and can be divided into two broad categories. In secondary headache disorders, headaches are attributed to another condition, such as brain tumor or head injury; for the primary disorders the headache is not due to another condition." ;
    rdfs:subClassOf HP:0012638 .

MONDO:0005546 a owl:Class ;
    rdfs:label "fibromyalgia" ;
    IAO:0000115 "A chronic disorder of unknown etiology characterized by pain, stiffness, and tenderness in the muscles of neck, shoulders, back, hips, arms, and legs. Other signs and symptoms include headaches, fatigue, sleep disturbances, and painful menstruation." ;
    mondons:curated_content_resource "https://www.malacards.org/card/fibromyalgia"^^xsd:anyURI ;
    mondons:excluded_subClassOf MONDO:0021167 ;
    OboInOwl:hasDbXref "DOID:631",
        "EFO:0005687",
        "ICD10CM:M79.7",
        "ICD9:729.1",
        "MEDGEN:42018",
        "MESH:D005356",
        "NCIT:C87497",
        "Orphanet:41842",
        "SCTID:203082005",
        "UMLS:C0016053" ;
    OboInOwl:hasExactSynonym "fibromyalgia",
        "fibromyalgia syndrome" ;
    rdfs:subClassOf MONDO:0002254,
        MONDO:0024317,
        MONDO:0700007 ;
    skos:exactMatch <http://identifiers.org/medgen/42018>,
        <http://identifiers.org/mesh/D005356>,
