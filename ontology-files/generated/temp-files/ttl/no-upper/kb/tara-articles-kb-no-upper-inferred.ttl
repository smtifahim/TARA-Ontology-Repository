    tara-ap:hasChineseLabel "厲(厉)兌(兑)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003632 ;
    tara-ap:hasInnervationInformation "The dorsal digital nerve derived from the superficial peroneal nerve." ;
    tara-ap:hasListedIndications "facial swelling, deviation of the mouth, epistaxis, toothache, sore throat and hoarse voice, abdominal distension, coldness in the leg and foot, febrile diseases, dream-disturbed sleep, mania." ;
    tara-ap:hasLocationalDescription "On the second toe, lateral to the distal phalanx, 0.1 f-cun proximal-lateral to the lateral corner of the second toenail, at the intersection of the vertical line of the lateral border and the horizontal line of the base of the second toenail." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.1 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Lidui" ;
    tara-ap:hasRelatedArtery UBERON:0006145 ;
    tara-ap:hasRelatedNerve UBERON:0035526 ;
    tara-ap:hasRelatedVein ILX:0797503 ;
