        UBERON:0003633 ;
    tara-ap:hasSynonym "S 44",
        "Stomach 44" ;
    tara-ap:hasVasculatureInformation "The dorsal venous network of foot." ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
