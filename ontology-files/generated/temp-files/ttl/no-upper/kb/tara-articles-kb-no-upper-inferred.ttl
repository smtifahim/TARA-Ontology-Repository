MONDO:0004857 a owl:Class ;
    rdfs:label "tendinitis" ;
    IAO:0000115 "Inflammation of a tendon, usually resulting from an overuse injury. It is characterized by swelling of the tendon, tenderness around the inflamed tendon, and pain while moving the affected area of the body." ;
    mondons:curated_content_resource "https://www.malacards.org/card/tendinitis"^^xsd:anyURI ;
    dcterms:conformsTo <http://purl.obolibrary.org/obo/mondo/patterns/inflammatory_disease_by_site.yaml>,
