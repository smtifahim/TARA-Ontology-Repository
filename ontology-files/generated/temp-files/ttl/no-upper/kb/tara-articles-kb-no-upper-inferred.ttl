            owl:onProperty RO:0002170 ;
            owl:someValuesFrom UBERON:0011584 ],
        UBERON:0015063 .

UBERON:0019232 a owl:Class ;
    rdfs:label "manual digit 2, 3 or 4" ;
    OboInOwl:hasRelatedSynonym "medial manual digit",
