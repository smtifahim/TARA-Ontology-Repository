TARA:6969962 a owl:Class ;
    rdfs:label "CV 2" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 220. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "曲骨(骨)" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795303 ;
    tara-ap:hasInnervationInformation "The branch of the iliohypogastric nerve." ;
    tara-ap:hasListedIndications "retention and dribbling of urine, enuresis, nocturnal emission, impotence, morbid leukorrhea, irregular menstruation, dysmenorrhea, hernia." ;
    tara-ap:hasLocationalDescription "On the lower abdomen, superior to the pubic symphysis, on the anterior median line." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Great care should be taken to puncture the points from Qugu (CV 2) to Shangwan (CV 13) of this meridian in pregnant women. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Qugu" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003699,
        ILX:0795285 ;
    tara-ap:hasSynonym "Conception Vessel 2",
        "RN 2",
        "Ren 2",
        "VC 2" ;
    tara-ap:hasVasculatureInformation "The branches of the inferior epigastric artery and the obturator artery." ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003699 ] ],
