    rdfs:label "Date" ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata .

dc:identifier a owl:AnnotationProperty ;
    rdfs:label "Identifier" ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata .

