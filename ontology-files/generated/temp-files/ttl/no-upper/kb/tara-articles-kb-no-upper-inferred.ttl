            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003823 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003701 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795305 ] ],
        TARA:7315457,
        TARA:8866697 .

MONDO:0005178 a owl:Class ;
    rdfs:label "osteoarthritis" ;
    IAO:0000115 "A noninflammatory degenerative joint disease occurring chiefly in older persons, characterized by degeneration of the articular cartilage, hypertrophy of bone at the margins and changes in the synovial membrane. It is accompanied by pain and stiffness, particularly after prolonged activity." ;
    mondons:curated_content_resource "https://www.malacards.org/card/osteoarthritis"^^xsd:anyURI ;
    OboInOwl:hasDbXref "DOID:8398",
        "HP:0002758",
        "ICD10CM:M15-M19",
        "ICD10CM:M19",
        "ICD9:715.3",
        "MEDGEN:45244",
        "MESH:D010003",
        "NCIT:C3293",
        "SCTID:396275006",
        "UMLS:C0029408",
        "icd11.foundation:558562409" ;
    OboInOwl:hasExactSynonym "degenerative joint disease" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty RO:0004029 ;
            owl:someValuesFrom HP:0001369 ],
        MONDO:0005578 ;
    skos:exactMatch <http://id.who.int/icd/entity/558562409>,
