tara-ap:hasGeneralSurfaceLocation a owl:AnnotationProperty ;
    rdfs:label "General Surface Location"@en ;
    IAO:0000112 "'LU 1' tara:hasGeneralSurfaceLocation 'Anterior Thoracic Region'."@en ;
    dcterms:description "An annotation property that records the general body region on whose surface an Acupoint is located, as a simple textual/IRI annotation. Corresponds to the object property tara-op:hasGeneralSurfaceLocation, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasGeneralSurfaceLocation ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedSurfaceAnatomy .

tara-ap:hasRelatedInnervation a owl:AnnotationProperty ;
    rdfs:label "Related Innervation"@en ;
    dcterms:description "An annotation property that records the nerve(s) supplying an Acupoint's location, as simple textual/IRI annotations. Corresponds to the object property tara-op:hasRelatedInnervation, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedInnervation ;
    dcterms:requires tara-ap:hasInnervationInformation ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedSubSurfaceAnatomy .

tara-ap:hasRelatedSubSurfaceAnatomy a owl:AnnotationProperty ;
    rdfs:label "Related Subsurface Anatomy"@en ;
    dcterms:description "An annotation property that records the nerves, arteries, and veins occupying an Acupoint's location, as simple textual/IRI annotations. Corresponds to the object property tara-op:hasRelatedSubSurfaceAnatomy, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedSubSurfaceAnatomy ;
    rdfs:domain TARA:1132428 ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasTopographicalAnatomy .

tara-ap:hasRelatedSurfaceAnatomy a owl:AnnotationProperty ;
    rdfs:label "Related Surface Anatomy"@en ;
    IAO:0000112 "'LU 1' tara:hasRelatedSurfaceAnatomy 'Anterior Thoracic Region'."@en ;
    dcterms:description "An annotation property that records the surface anatomical regions and landmarks associated with an Acupoint's location, as simple textual/IRI annotations, without the mereological commitment of the corresponding object property. Corresponds to the object property tara-op:hasRelatedSurfaceAnatomy, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedSurfaceAnatomy ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasTopographicalAnatomy .

tara-ap:hasTopographicalAnatomy a owl:AnnotationProperty ;
    rdfs:label "Topographical Anatomy"@en ;
    dcterms:description "An annotation property that groups all textual/simple annotations relating an Acupoint to the surface and subsurface anatomical entities associated with its location and needling. Corresponds to the object property tara-op:hasTopographicalAnatomy, which is the root of the corresponding logical property hierarchy."@en ;
    dcterms:references tara-op:hasTopographicalAnatomy ;
    rdfs:domain TARA:1132428 ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-kb:hasEvaluativeResultsAndGlobalMetrics a owl:AnnotationProperty ;
    rdfs:label "Evaluative Results and Global Metrics" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "Category D: Evaluative Results & Global Metrics. Grouping property for mathematical evaluations, dataset scoring, and final percentage parameters." ;
    dcterms:type tara-kb:grouping ;
    tara-ap:hasCompactURI "tara-kb:hasEvaluativeResultsAndGlobalMetrics" ;
    rdfs:domain TARA:2825659 ;
    rdfs:subPropertyOf tara-kb:hasOCSIScoreMetadata ;
    skos:altLabel "Evaluative_Results_And_Global_Metrics" .

tara-kb:hasListedAcupoints a owl:AnnotationProperty ;
    rdfs:label "Listed Acupoint(s)" ;
    IAO:0000112 "E.g., \"BL 1, BL 2, BL 3\" (see rdfs:comment for normalization rules)."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A dual-purpose annotation property that serves as a super-property grouping the mapped and unmappable acupoint sub-properties, while simultaneously acting as a direct container for the comma-separated, normalized list of acupoints extracted from the article."@en ;
    tara-ap:hasCompactURI "tara-kb:hasListedAcupoints" ;
    rdfs:comment "The list should exclude sham acupoints from this field. Instruct the LLM to normalize the extracted acupoints as comma-separated values; e.g., BL 1, BL 2, BL 3. Instruct to exclude the texts inside parentheses/brackets (typically synonyms) to normalize the extracted list."@en ;
    rdfs:domain TARA:6701896 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description,
        tara-kb:hasAcupunctureProtocol ;
    skos:altLabel "Listed_Acupoints" .

tara-kb:hasPublicationLink a owl:AnnotationProperty ;
    rdfs:label "Publication Link" ;
    IAO:0000112 "e.g., \"https://doi.org/10.1089/acm.2021.0142\"."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A dual-purpose annotation property that both groups the specific typed publication link sub-properties (DOI, PubMed, and other links) and can directly hold a resolvable URI to the publication when no more specific link type applies."@en ;
    tara-ap:hasCompactURI "tara-kb:hasPublicationLink" ;
    rdfs:domain TARA:8223728 ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf dcterms:identifier,
        tara-kb:hasBibliographicMetadata ;
    skos:altLabel "Publication_Link" .

tara-kb:hasTARAArticlesMetadata a owl:AnnotationProperty ;
    rdfs:label "TARA-KB: Articles Metadata" ;
    dcterms:description "A grouping annotation property to organize all metadata annotation properties specific to TARA articles knowledgebase." ;
    dcterms:type tara-kb:grouping ;
    tara-ap:hasCompactURI "tara-kb:hasTARAArticlesMetadata" ;
    skos:altLabel "TARA_KB_Articles_Metadata" .

tara-op:hasRelatedInnervation a owl:ObjectProperty ;
    rdfs:label "hasRelatedInnervation" ;
    IAO:0000112 "Example: 'LU 1' tara-op:hasRelatedInnervation some 'Intermediate Supraclavicular Nerve'"@en ;
    IAO:0000115 "An Acupoint a hasRelatedInnervation b (a nerve) if and only if a hasRelatedSubSurfaceAnatomy b."@en ;
    dcterms:description "An object property that relates an Acupoint to the nerve(s) supplying the tissue at its location, relevant to safe needling."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedInnervation ;
    dcterms:requires tara-ap:hasInnervationInformation ;
    rdfs:comment "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its parent property hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
    rdfs:subPropertyOf tara-op:hasRelatedSubSurfaceAnatomy .

tara-op:hasRelatedSubSurfaceAnatomy a owl:ObjectProperty ;
    rdfs:label "hasRelatedSubSurfaceAnatomy" ;
    IAO:0000112 "'LU 1' tara-op:hasRelatedSubSurfaceAnatomy some 'Axillary Artery'."@en ;
    IAO:0000115 "An Acupoint a hasRelatedSubSurfaceAnatomy a material anatomical entity b if and only if a overlaps b, where b is a nerve, artery, or vein occupying the fiat volume of a."@en ;
    dcterms:description "An object property that relates an Acupoint to the nerves, arteries, and veins that occupy the same shallow tissue volume as the acupoint at the site of needle insertion."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedSubSurfaceAnatomy ;
    rdfs:comment "Declared as a subproperty of RO:0002131 (overlaps) because an Acupoint, modeled as a BFO:0000024 Fiat Object Part, and the nerves/vessels beneath it are both material entities; the segment of the nerve or vessel passing through the acupoint's fiat volume is a literal shared part, satisfying overlaps' requirement of a common part between the two continuants."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:subPropertyOf tara-op:hasTopographicalAnatomy .

tara-op:hasRelatedSurfaceAnatomy a owl:ObjectProperty ;
    rdfs:label "hasRelatedSurfaceAnatomy"@en ;
    IAO:0000115 "An Acupoint a hasRelatedSurfaceAnatomy an anatomical entity b if and only if a is located_in b, where b is a surface-level anatomical region, landmark, fossa, or line used to describe the position of a on the body surface."@en ;
    dcterms:description "An object property that relates an Acupoint to an anatomical region, fossa, line, or other surface landmark in the vicinity of its location on the body surface."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedSurfaceAnatomy ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:comment "Declared as a subproperty of RO:0001025 (located_in) rather than RO:0002131 (overlaps), because the anatomical entities used to describe surface location (e.g., regions, fossae, lines) span a mix of material and immaterial UBERON classes; located_in does not require the related entities to share a common part, so it remains valid across this mixed range, unlike overlaps."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:subPropertyOf tara-op:hasTopographicalAnatomy .

tara-op:hasTopographicalAnatomy a owl:ObjectProperty ;
    rdfs:label "hasTopographicalAnatomy" ;
    IAO:0000115 "A grouping relation between an Acupoint and any anatomical entity related to its surface or subsurface topography, holding whenever a more specific subproperty of hasTopographicalAnatomy holds between the same two entities."@en ;
    dcterms:description "An object property that groups all relations between an Acupoint and the surface and subsurface anatomical entities associated with its location and needling, including surface regions, landmarks, nerves, arteries, and veins. It is the root organizational property for the Acupoint topographical-anatomy property hierarchy and carries no independent logical commitment of its own."@en ;
    dcterms:isReferencedBy tara-ap:hasTopographicalAnatomy ;
    tara-ap:hasSynonym "hasRegionalAnatomy" ;
    rdfs:comment "Declared as a direct subproperty of owl:topObjectProperty rather than of any RO relation, because it is used purely to organize the Acupoint-specific property hierarchy for browsing and querying and does not itself assert overlap, location, or any other specific spatial relationship; that logical content is carried entirely by its subproperties."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:subPropertyOf tara-op:topTARAObjectProperty .

rdfs:label a owl:AnnotationProperty .

HP:0000020 a owl:Class ;
    rdfs:label "Urinary incontinence" ;
    IAO:0000115 "Loss of the ability to control the urinary bladder leading to involuntary urination." ;
    OboInOwl:hasAlternativeId "HP:0006942",
        "HP:0008681" ;
    OboInOwl:hasDbXref "SNOMEDCT_US:165232002",
        "UMLS:C0042024" ;
    OboInOwl:hasExactSynonym "Bladder incontinence",
        "Loss of bladder control" ;
    rdfs:comment "Urinary incontinence can be defined as the complaint of any involuntary leakage of urine." ;
    rdfs:subClassOf HP:0000009,
        HP:0031064 .

HP:0002015 a owl:Class ;
    rdfs:label "Dysphagia" ;
    IAO:0000115 "Difficulty in swallowing." ;
    OboInOwl:hasAlternativeId "HP:0002569" ;
    OboInOwl:hasDbXref "MEDDRA:10013950",
        "SNOMEDCT_US:288939007",
        "SNOMEDCT_US:40739000",
        "UMLS:C0011168" ;
    OboInOwl:hasExactSynonym "Difficulty swallowing",
        "Poor swallowing",
        "Swallowing difficulties",
        "Swallowing difficulty" ;
    OboInOwl:hasRelatedSynonym "Deglutition disorder" ;
    rdfs:subClassOf HP:0012638,
        HP:0025270 .

HP:0002027 a owl:Class ;
    rdfs:label "Abdominal pain" ;
    IAO:0000115 "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) and perceived to originate in the abdomen." ;
    OboInOwl:hasBroadSynonym "Gastro pain",
        "Gastrointestinal pain" ;
    OboInOwl:hasDbXref "MEDDRA:10000081",
        "SNOMEDCT_US:21522001",
        "UMLS:C0000737" ;
    OboInOwl:hasExactSynonym "Abdominal pain",
        "Pain in stomach",
        "Stomach pain" ;
    OboInOwl:hasRelatedSynonym "Abdominal discomfort",
        "Upset stomach" ;
    rdfs:comment "Abdominal pain can be crampy, achy, dull, intermittent or sharp. The terms stomach ache and stomach cramps are nonmedical terms often used to describe pain in the mid- or upper abdominal area, even though it is not the case that the (smooth) muscles of the stomach or the abdomen have cramps. Stomach pain is another layperson term commonly used to refer to abdominal pain." ;
    rdfs:subClassOf HP:0011458,
        HP:0012531 .

HP:0002829 a owl:Class ;
    rdfs:label "Arthralgia" ;
    IAO:0000115 "Joint pain." ;
    OboInOwl:hasDbXref "SNOMEDCT_US:57676002",
        "UMLS:C0003862" ;
    OboInOwl:hasExactSynonym "Arthralgias",
        "Joint pain" ;
    OboInOwl:hasRelatedSynonym "Arthritic pain",
        "Joint pains" ;
    rdfs:comment "Arthralgia is distinct from Arthritis, which is not a symptom but a diagnosis with articular inflammation or signs of osteoarthritis." ;
    rdfs:subClassOf HP:0012531 .

HP:0003470 a owl:Class ;
    rdfs:label "Paralysis" ;
    IAO:0000115 "Paralysis of voluntary muscles means loss of contraction due to interruption of one or more motor pathways from the brain to the muscle fibers. Although the word paralysis is often used interchangeably to mean either complete or partial loss of muscle strength, it is preferable to use paralysis or plegia for complete or severe loss of muscle strength, and paresis for partial or slight loss. Motor paralysis results from deficits of the upper motor neurons (corticospinal, corticobulbar, or subcorticospinal). Motor paralysis is often accompanied by an impairment in the facility of movement." ;
    OboInOwl:hasDbXref "SNOMEDCT_US:44695005",
        "UMLS:C0522224" ;
    OboInOwl:hasExactSynonym "Inability to move",
        "Paralysis" ;
    rdfs:subClassOf HP:0011442 .

HP:0011675 a owl:Class ;
    rdfs:label "Arrhythmia" ;
    IAO:0000115 "Any cardiac rhythm other than the normal sinus rhythm. Such a rhythm may be either of sinus or ectopic origin and either regular or irregular. An arrhythmia may be due to a disturbance in impulse formation or conduction or both." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2012-04-09T12:47:32+00:00"^^xsd:dateTime ;
    OboInOwl:hasAlternativeId "HP:0001656",
        "HP:0001661",
        "HP:0001665",
        "HP:0001666",
        "HP:0001675",
        "HP:0001687",
        "HP:0001721",
        "HP:0004351",
        "HP:0005158" ;
    OboInOwl:hasDbXref "SNOMEDCT_US:102594003",
        "SNOMEDCT_US:44808001",
        "SNOMEDCT_US:698247007",
        "UMLS:C0003811",
        "UMLS:C0264886",
        "UMLS:C0522055",
        "UMLS:C0855329",
        "UMLS:C1832603",
        "UMLS:C1842820" ;
    OboInOwl:hasExactSynonym "Abnormal heart rate",
        "Arrhythmias",
        "Cardiac arrhythmia",
        "Cardiac arrhythmias",
        "Cardiac rhythm disturbances",
        "Heart rhythm disorders",
        "Irregular heart beat",
        "Irregular heartbeat" ;
    rdfs:subClassOf HP:0030956 .

HP:0012649 a owl:Class ;
    rdfs:label "Increased inflammatory response" ;
    IAO:0000115 "A abnormal increase in the inflammatory response to injury or infection." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-02-01T01:29:58+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4022803" ;
    rdfs:subClassOf HP:0012647 .

HP:0012735 a owl:Class ;
    rdfs:label "Cough" ;
    IAO:0000115 "A sudden, audible expulsion of air from the lungs through a partially closed glottis, preceded by inhalation." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-03-23T03:19:50+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:263731006",
        "SNOMEDCT_US:272039006",
        "SNOMEDCT_US:49727002",
        "UMLS:C0010200" ;
    OboInOwl:hasExactSynonym "Cough",
        "Coughing" ;
    rdfs:comment "The European Respiratory Society Task Force recommended two possible definitions of cough: (1) A three-phase expulsive motor act characterized by an inspiratory effort (inspiratory phase) followed by a forced expiratory effort against a closed glottis (compressive phase) and then by opening of the glottis and rapid expiratory airflow (expulsive phase);and (2) A forced expiratory maneuver, usually against a closed glottis and associated with a characteristic sound. The term Cough or any of its more specific descendents can be modified by the terms Acute (HP:0011009), Subacute (HP:0011011), and Chronic (HP:0011010). In adults, an acute cough lasts less than 3 weeks, a subacute cough from 3 to 8 weeks, and a chronic cough longer than 8 weeks. In children aged less than 15 years a chronic cough is defined as a daily cough lasting for over 4 weeks." ;
    rdfs:subClassOf HP:0002795 .

HP:0025031 a owl:Class ;
    rdfs:label "Abnormality of the digestive system" ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-08-27T13:44:32+00:00"^^xsd:dateTime ;
    rdfs:comment "Any anomaly of the digestive system, a collection of organs that is made up of the gastrointestinal tract and the liver, pancreas, and gallbladder. The gastrointestinal tract is a series of hollow organs joined in a long, twisting tube from the mouth to the anus, including the mouth, esophagus, stomach, small intestine, large intestine and anus." ;
    rdfs:subClassOf HP:0000118 .

HP:0030839 a owl:Class ;
    rdfs:label "Knee pain" ;
    IAO:0000115 "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the knee." ;
    dcterms:date "2016-05-17T07:00:44+00:00"^^xsd:dateTime ;
    OboInOwl:hasBroadSynonym "Pain under knee cap" ;
    OboInOwl:hasDbXref "SNOMEDCT_US:30989003",
        "UMLS:C0231749" ;
    OboInOwl:hasExactSynonym "Knee pain" ;
    rdfs:subClassOf HP:0012514 .

HP:0033127 a owl:Class ;
    rdfs:label "Abnormality of the musculoskeletal system" ;
    IAO:0000115 "An anomaly of the musculoskeletal system, which consists of the bones of the skeleton, muscles, cartilage, tendons, ligaments, joints, and other connective tissue. The musculoskeletal system supports the weight of the body, maintains body position and produces movements of the body or of parts of the body." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2020-09-05T13:35:03+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0000118 .

HP:6000040 a owl:Class ;
    rdfs:label "Neuropathic pain" ;
    IAO:0000115 "Neuropathic pain is triggered by lesions to the somatosensory nervous system that alter its structure and function so that pain occurs spontaneously and responses to noxious and innocuous stimuli are pathologically amplified." ;
    dcterms:contributor <https://orcid.org/0009-0005-6714-5727> ;
    dcterms:date "2023-12-28T15:12:28+00:00"^^xsd:dateTime ;
    rdfs:comment "Neuropathic pain can be characterized by pain that is triggered when clothes touch the skin, spontaneous burning that feels like boiling water, bursts of pins and needles(paresthesias) in the feet upon walking , a continuous crushing pain after an amputation as if your phantom foot is being squeezed, or a band of searing pain around the body at the level at whichsensation was lost after a spinal cord injury." ;
    rdfs:subClassOf HP:0025280 .

