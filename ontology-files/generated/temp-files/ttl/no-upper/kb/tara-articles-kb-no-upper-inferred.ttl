        TARA:9921528 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:9921528\": \"CV 4\", \"TARA:0022762\": \"CV 3\", \"TARA:4254258\": \"Zigongxue\", \"TARA:6463344\": \"ST 36\", \"TARA:4385250\": \"SP 6\", \"TARA:0859695\": \"LI 4\", \"TARA:6499349\": \"LR 3\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition HP:0000789 ;
    tara-kb:hasNeedlingDetails "Not specified" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1802 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1802 ;
    tara-kb:hasSampleSizeDetails """Total sample size: 36
Control group: 19
Observation group: 17""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used)" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation (reinforcing reducing) after the arrival of qi" ;
    tara-kb:hasStudiedTCMCondition "Anovulatory infertility due to kidney essence deficiency, blood insufficiency, and qi stagnation with blood stasis." ;
    tara-kb:hasStudiedWesternCondition "Anovulatory infertility" ;
    tara-kb:hasStudyFindings "Yes, the acupuncture intervention was effective compared to the control group based on primary outcomes such as ovulation and conception rates, with statistical significance (P<0.05)." ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Ovulation rate,Pregnancy rate
Secondary outcome measures: Thickening of the endometrium, Absence of LUFS, Follicular maldevelopment rate""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: 1 hour (needles in place) + 30 minutes (lying position after needle removal)
Frequency: Daily until ovulation is confirmed by ultrasound""" ;
    tara-kb:hasTreatmentFrequency "The acupuncture treatment was conducted once every day until ovulation was confirmed by ultrasound, starting from the 8th day after the period. Each treatment session lasted for 1 hour, followed by 30 minutes of rest in a lying position." .

