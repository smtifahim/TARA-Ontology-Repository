tara-op:hasGeneralSurfaceLocation a owl:ObjectProperty ;
    rdfs:label "hasGeneralSurfaceLocation" ;
    IAO:0000112 "'LU 1' tara-op:hasGeneralSurfaceLocation some 'Anterior Thoracic Region'."@en ;
    IAO:0000115 "An Acupoint a hasGeneralSurfaceLocation a region b if and only if a hasRelatedSurfaceAnatomy b, and b is the coarse-grained body region within which a is situated."@en ;
    dcterms:description "An object property that relates an Acupoint to the general body region on whose surface it is located. It provides a coarse-grained anatomical grouping for the acupoint and is used together with hasSpecificReferenceLocation, which further specifies particular anatomical landmarks within this general region."@en ;
    dcterms:isReferencedBy tara-ap:hasGeneralSurfaceLocation ;
    dcterms:replaces "tara-op:locatedOnTheSurfaceOf" ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:comment "Inherits its subproperty-of relation to RO:0001025 (located_in) from its parent property hasRelatedSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:subPropertyOf tara-op:hasRelatedSurfaceAnatomy .

TARA:6463344 a owl:Class ;
    rdfs:label "ST 36" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 64. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "足三里" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "Superficially, the lateral sural cutaneous nerve and the cutaneous branch of the saphenous nerve; deeper, the deep peroneal nerve." ;
    tara-ap:hasListedIndications "gastric pain, vomiting, hiccup, abdominal distension, borborygmus, diarrhea, dysentery, constipation, mastitis, enteritis, aching of the knee joint and leg, beriberi, edema, cough, asthma, emaciation due to general deficiency, indigestion, apoplexy, hemiplegia, dizziness, insomnia, mania." ;
    tara-ap:hasLocationalDescription "On the anterior aspect of the leg, on the line connecting ST35 with ST41, 3 B-cun inferior to ST35. Note: ST36 is located on the tibialis anterior muscle." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zusanli" ;
    tara-ap:hasRelatedArtery UBERON:0001537 ;
    tara-ap:hasRelatedNerve UBERON:0002475,
        UBERON:0035207,
        ILX:0797521 ;
    tara-ap:hasRelatedVein UBERON:0001545 ;
    tara-ap:hasSpecialPointRole TARA:3815917,
        TARA:6594221 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001385 ;
    tara-ap:hasSynonym "S 36",
        "Stomach 36" ;
    tara-ap:hasVasculatureInformation "The anterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom UBERON:0002475 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:4109407 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedArtery ;
            owl:someValuesFrom UBERON:0001537 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001385 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:6392235 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedVein ;
            owl:someValuesFrom UBERON:0001545 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom ILX:0797521 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003823 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom UBERON:0035207 ],
        TARA:3815917,
        TARA:5282844 .

tara-op:hasSpecificReferenceLocation a owl:ObjectProperty ;
    rdfs:label "hasSpecificReferenceLocation" ;
    IAO:0000112 """The acupoint 'LU 1' has three specific reference locations within the general surface of 'Anterior Thoracic Region':
'LU 1' tara-op:hasSpecificReferenceLocation some 'First Intercostal Space'; 'LU 1' tara-op:hasSpecificReferenceLocation some 'Infraclavicular Fossa';
'LU 1' tara-op:hasSpecificReferenceLocation some 'Anterior Median Line'."""@en ;
    IAO:0000115 "An Acupoint a hasSpecificReferenceLocation a landmark b if and only if a hasRelatedSurfaceAnatomy b, and b is a specific anatomical landmark, fossa, or line used to further localize a within its general surface region."@en ;
    dcterms:description "An object property that relates an Acupoint to one or more specific anatomical landmarks within the general body region identified by hasGeneralSurfaceLocation, providing a finer-grained localization of the acupoint."@en ;
    dcterms:isReferencedBy tara-ap:hasSpecificReferenceLocation ;
    dcterms:replaces "tara-op:locatedInRelationTo" ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:comment "Inherits its subproperty-of relation to RO:0001025 (located_in) from its parent property hasRelatedSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:subPropertyOf tara-op:hasGeneralSurfaceLocation .

TARA:8223728 a owl:Class ;
    rdfs:label "Acupuncture Study Publication" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A specialized subclass of 'Research Study Publication' representing any formal written, digital, or multimedia artifact that documents, describes, or reports on an acupuncture research study. Unlike the active, physical execution of an acupuncture research study represented by the 'Acupuncture Research Study' class, this class encompasses the static conceptual and intellectual outputs, such as journal articles, books, conference proceedings, or preprints, created to communicate methodologies, data, and conclusions to the scientific community."@en ;
    rdfs:subClassOf TARA:3677977 ;
    skos:altLabel "Acupuncture_Research_Study_Publication" .

TARA:2825659 a owl:Class ;
    rdfs:label "Acupuncture Study OCSI Appraisal" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "An acupuncture study quality appraisal data item that captures, organizes, and structures the specific multi-item compliance metrics and qualitative evaluation scores defined by the Oregon CONSORT STRICTA Instrument (OCSI) for assessing the reporting quality of acupuncture clinical trials." ;
    rdfs:subClassOf TARA:9542913 .

TARA:6701896 a owl:Class ;
    rdfs:label "Acupuncture Research Study"@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A specialized study process wherein the primary intervention under investigation involves acupuncture therapeutics, including needle insertion, point selection logic, needle manipulation methods, and stimulation protocols (manual, electrical, or thermal). It encompasses the physical trial execution from participant recruitment and baseline grouping through the active administration of real or sham acupuncture procedures up to final endpoint evaluation."@en ;
    tara-ap:hasSynonym "Acupuncture Study" ;
    rdfs:subClassOf TARA:7008377 ;
    skos:altLabel "Acupuncture_Research_Study" .

partOf: a owl:ObjectProperty ;
    rdfs:label "part of",
        "part of"@en ;
    rdfs:subPropertyOf tara-op:bfoObjectProperty .

