TARA:9531666 a owl:Class ;
    rdfs:label "ST 40" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 66. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "豐(丰,豊)隆(隆)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "The superficial peroneal nerve." ;
    tara-ap:hasListedIndications "headache, dizziness and vertigo, cough, asthma, excessive sputum, pain in the chest, constipation, mania, epilepsy, muscular atrophy, motor impairment, pain, swelling or paralysis of the lower extremities." ;
    tara-ap:hasLocationalDescription "On the anterolateral aspect of the leg, lateral border of the tibialis anterior muscle, 8 B-cun superior to the prominence of the lateral malleolus. Note: ST40 is one fingerbreadth (middle finger) lateral to ST38." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Fenglong" ;
    tara-ap:hasRelatedArtery UBERON:0001537 ;
    tara-ap:hasRelatedNerve UBERON:0035526 ;
    tara-ap:hasRelatedVein UBERON:0001545 ;
    tara-ap:hasSpecialPointRole TARA:6993030 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001385,
        UBERON:0012291 ;
    tara-ap:hasSynonym "S 40",
        "Stomach 40" ;
    tara-ap:hasVasculatureInformation "The branches of the anterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedArtery ;
