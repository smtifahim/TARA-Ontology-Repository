TARA:2614885 a owl:Class ;
    rdfs:label "Special Point on the Head and Trunk" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "A special, specific acupoint located on the Head and Trunk. Specific points refer to those of the fourteen meridians that have special properties and are grouped under special names. Specific Points on the Head and Trunk include: (1) Back-Shu Points, (2) Front-Mu Points, and (3) Crossing Points." ;
    tara-ap:hasSpecialPointRole TARA:0886544 ;
    rdfs:subClassOf TARA:7852472 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7852472 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:0886544 ] ) ] .

TARA:2687954 a owl:Class ;
    rdfs:label "KI 9" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 140. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "築(筑)賓(宾)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "The medial sural and medial crural cutaneous nerves, deeper, the tibial nerve." ;
    tara-ap:hasListedIndications "mental disorder, pain in the foot and lower leg, hernia." ;
    tara-ap:hasLocationalDescription "On the posteromedial aspect of the leg, between the soleus muscle and the calcaneal tendon, 5 B-cun superior to the prominence of the medial malleolus. Note 1: With the knee flexed and the leg stretched (plantar flexion) against resistance, the soleus muscle can be seen more clearly along the medial border of the tibia bone. Note 2: At the same level as LR5, on the line connecting KI3 with KI10." ;
    tara-ap:hasPinyinLabel "Zhubin" ;
    tara-ap:hasSpecialPointRole TARA:8063120 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0000979,
        UBERON:0001389,
        UBERON:0003701,
        ILX:0795305 ;
    tara-ap:hasSynonym "K 9",
        "KD 9",
        "KID 9",
        "Kidney 9" ;
    tara-ap:hasVasculatureInformation "Deeper, the posterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4813389 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
