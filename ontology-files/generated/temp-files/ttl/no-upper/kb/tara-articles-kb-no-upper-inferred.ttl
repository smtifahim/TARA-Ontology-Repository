tara-ap:ilxAnnotationProperty a owl:AnnotationProperty ;
    rdfs:label "ilx:topAnnotationProperty" ;
    dcterms:description "An annotation property to group all ILX annotation properties specific to TARA Acupoints Ontology." .

tara-kb:hasAcupunctureStudyMetadata a owl:AnnotationProperty ;
    rdfs:label "Acupuncture Study Metadata" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A grouping annotation property that organizes the operational, methodological, and outcome-related metadata describing the acupuncture research study itself (as opposed to its reporting publication)."@en ;
    dcterms:type tara-kb:grouping ;
    tara-ap:hasCompactURI "tara-kb:hasAcupunctureStudyMetadata" ;
    rdfs:domain TARA:6701896 ;
    rdfs:subPropertyOf tara-kb:hasExtractedArticleMetadata ;
    skos:altLabel "Acupuncture_Study_Metadata" .

tara-kb:hasBibliographicMetadata a owl:AnnotationProperty ;
    rdfs:label "Bibliographic Metadata" ;
    IAO:0000112 "E.g., \"Smith J, et al. (2021). Acupuncture for chronic low back pain. J Altern Complement Med. 27(4):301-310.\" while also grouping hasArticleTitle, hasListedAuthors, hasPublicationDate, hasPublicationVenue, and hasPublicationLink."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A dual-purpose annotation property that serves as a super-property to logically group granular bibliographic sub-properties (e.g., titles, identifiers, and venues), while simultaneously acting as a direct container for a complete, pre-formatted human-readable citation string (such as APA, MLA, or Chicago styles)."@en ;
    tara-ap:hasCompactURI "tara-kb:hasBibliographicMetadata" ;
    tara-ap:hasSynonym "Publication Metadata" ;
    rdfs:domain TARA:8223728 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf tara-kb:hasExtractedArticleMetadata ;
    skos:altLabel "Bibliographic_Metadata" .

tara-op:topTARAObjectProperty a owl:ObjectProperty ;
    rdfs:label "tara-op:topObjectProperty" ;
    dcterms:description "A grouping relation that functions purely as an organizational root for browsing/querying the TARA-specific object property tree, and asserts no independent semantic commitment that a reasoner needs to satisfy."@en .

HP:0001257 a owl:Class ;
    rdfs:label "Spasticity" ;
    IAO:0000115 "A motor disorder characterized by a velocity-dependent increase in tonic stretch reflexes with increased muscle tone, exaggerated (hyperexcitable) tendon reflexes." ;
    OboInOwl:hasDbXref "SNOMEDCT_US:221360009",
        "SNOMEDCT_US:397790002",
        "UMLS:C0026838" ;
    OboInOwl:hasExactSynonym "Involuntary muscle stiffness, contraction, or spasm",
        "Muscle spasticity",
        "Muscular spasticity" ;
    rdfs:subClassOf HP:0001276,
        HP:0002493 .

MONDO:0001170 a owl:Class ;
    rdfs:label "hemiplegia" ;
    IAO:0000115 "Severe or complete loss of motor function on one side of the body. This condition is usually caused by brain diseases that are localized to the cerebral hemisphere opposite to the side of weakness. Less frequently, brain stem lesions; cervical spinal cord diseases; peripheral nervous system diseases; and other conditions may manifest as hemiplegia. The term hemiparesis (see paresis) refers to mild to moderate weakness involving one side of the body." ;
    mondons:curated_content_resource "https://www.malacards.org/card/hemiplegia"^^xsd:anyURI ;
    OboInOwl:hasDbXref "DOID:10969",
        "EFO:0009453",
        "ICD10WHO:G81",
        "ICD9:343.4",
        "MEDGEN:9196",
        "MESH:D006429",
        "SCTID:1593000",
        "UMLS:C0018991",
        "icd11.foundation:1641958762" ;
    rdfs:seeAlso "https://rarediseases.info.nih.gov/diseases/6583/hemiplegia"^^xsd:anyURI ;
    rdfs:subClassOf MONDO:0006496 ;
    skos:exactMatch <http://id.who.int/icd/entity/1641958762>,
        <http://identifiers.org/medgen/9196>,
