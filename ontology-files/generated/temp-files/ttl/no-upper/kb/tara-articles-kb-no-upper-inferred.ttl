TARA:1194553 a owl:Class ;
    rdfs:label "Heart Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Heart Meridian of Hand-Shaoyin (HT), which consists of 9 standardized acupoints beginning at HT 1 (Jiquan) in the center of the axillary fossa, traveling down the medial aspect of the arm, and ending at HT 9 (Shaochong) on the radial side of the little finger near the corner of the nail." ;
    tara-ap:hasSynonym "Acupoint of Heart Meridian",
        "Acupoint of the Heart Meridian",
        "Acupoint of the heart meridian of hand-shaoyin",
        "Acupuncture point of the heart meridian",
        "Acupuncture point of the heart meridian of hand-shaoyin",
        "HT Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:9474009 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:9474009 ] ) ] .

TARA:2849795 a owl:Class ;
    rdfs:label "GB 2" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 172. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "聽(听,聴)會(会)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasInnervationInformation "The great auricular nerve and facial nerve." ;
    tara-ap:hasListedIndications "deafness, tinnitus, toothache, motor impairment of the temporomandibular joint, mumps, deviation of the eye and mouth." ;
    tara-ap:hasLocationalDescription "On the face, in the depression between the intertragic notch and the condylar process of the mandible. Note: When the mouth is opened, GB2 is located in the depression anterior to the intertragic notch." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Tinghui" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004657,
        UBERON:0036212 ;
    tara-ap:hasSynonym "G 2",
        "Gallbladder 2" ;
    tara-ap:hasVasculatureInformation "The superficial temporal artery." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0036212 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001456 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004657 ] ],
        TARA:1926756 .

TARA:3114756 a owl:Class ;
    rdfs:label "KI 2" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 136. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "然谷" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "The terminal branch of the medial crural cutaneous nerve, the medial plantar nerve." ;
    tara-ap:hasListedIndications "pruritus vulvae, prolapse of the uterus, irregular menstruation, nocturnal emission, hemoptysis, thirst, diarrhea, swelling and pain of the dorsum of foot, acute infantile omphalitis." ;
    tara-ap:hasLocationalDescription "On the medial aspect of the foot, inferior to the tuberosity of the navicular bone, at the border between the red and white flesh." ;
