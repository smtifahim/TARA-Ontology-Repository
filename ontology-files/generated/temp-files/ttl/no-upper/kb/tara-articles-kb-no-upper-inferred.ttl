    OboInOwl:hasRelatedSynonym "aorta ascendens",
        "pars ascendens aortae" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001515 ],
        UBERON:0001515 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/e/e6/Gray506.svg"^^xsd:anyURI,
        "https://cdn.humanatlas.io/digital-objects/ref-organ/blood-vasculature-female/v1.3/assets/3d-vh-f-blood-vasculature.glb"^^xsd:anyURI,
