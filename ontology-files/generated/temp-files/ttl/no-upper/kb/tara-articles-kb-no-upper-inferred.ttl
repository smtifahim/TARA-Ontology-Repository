TARA:1459681 a owl:Class ;
    rdfs:label "Lung Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Lung Meridian of Hand-Taiyin (LU), which consists of 11 standardized acupoints beginning at LU 1 (Zhongfu) on the upper anterior chest lateral to the infraclavicular fossa, traveling down the anterior-lateral aspect of the arm, and ending at LU 11 (Shaoshang) on the radial side of the thumb near the corner of the nail." ;
    tara-ap:hasSynonym "Acupoint of Lung Meridian",
        "Acupoint of the Lung Meridian",
        "Acupoint of the lung meridian of hand-taiyin",
        "Acupuncture point of the lung meridian",
        "Acupuncture point of the lung meridian of hand-taiyin",
        "LU Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:9964503 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:9964503 ] ) ] .

TARA:1772472 a owl:Class ;
    rdfs:label "SI 19" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 97. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "聽(听,聴)宮(宫)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasInnervationInformation "The branch of the facial nerve, the auriculotemporal nerve." ;
    tara-ap:hasListedIndications "deafness, tinnitus, otorrhea, motor impairment of the mandibular joint, toothache." ;
    tara-ap:hasLocationalDescription "On the face, in the depression between the anterior border of the centre of the tragus and the posterior border of the condylar process of the mandible. Note: When the mouth is slightly opened, SI19 is located in the depression anterior to the centre of the tragus, between tE21 and gB2." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch when the mouth is open. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Tinggong" ;
    tara-ap:hasRelatedArtery UBERON:0001614 ;
