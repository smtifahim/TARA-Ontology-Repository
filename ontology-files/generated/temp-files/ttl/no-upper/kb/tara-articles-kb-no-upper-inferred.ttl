    rdfs:label "hereditary disease" ;
    IAO:0000115 "A disease that is caused by genetic modifications where those modifications are inherited from a parent's genome." ;
    dcterms:conformsTo <http://purl.obolibrary.org/obo/mondo/patterns/hereditary.yaml> ;
    OboInOwl:hasBroadSynonym "genetic condition",
