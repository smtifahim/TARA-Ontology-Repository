    tara-ap:hasChineseLabel "外關(关,関)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002386 ;
    tara-ap:hasInnervationInformation "The posterior antebrachial cutaneous nerve; deeper, the posterior interosseous nerve and the anterior interosseous nerve." ;
    tara-ap:hasListedIndications "febrile diseases, headache, pain in the cheek, strained neck, deafness, tinnitus, pain in the hypochondriac region, motor impairment of the elbow and arm, pain of the fingers, hand tremor." ;
    tara-ap:hasLocationalDescription "On the posterior aspect of the forearm, midpoint of the interosseous space between the radius and the ulna, 2 B-cun proximal to the dorsal wrist crease. Note: 2 B-cun proximal to TE4, in the depression between the radius and the ulna. The anterior point corresponding to TE5 is PC6." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Waiguan" ;
    tara-ap:hasSpecialPointRole TARA:6993030,
