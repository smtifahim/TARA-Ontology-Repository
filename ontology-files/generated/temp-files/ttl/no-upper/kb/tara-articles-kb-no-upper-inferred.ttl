tara-kb:S-112625-466 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-466" ;
    dc:title "Depressive Neurosis Treated by Acupuncture for Regulating the Liver - A Report of 176 Cases" ;
    tara-kb:hasAcupunctureProtocol """Siguan Points: bilateral Hegu (LI 4), Taichong (LR 3), Baihui (GV 20), Yintang (EX-HN3)
Ear points: Liver, Heart
