    tara-ap:hasChineseLabel "照海(海)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "The medial crural cutaneous nerve; deeper, the tibial nerve." ;
    tara-ap:hasListedIndications "irregular menstruation, morbid leukorrhea, prolapse of the uterus, pruritus vulvae, frequency of micturition, retention of urine, constipation, epilepsy, insomnia, sore throat, asthma." ;
    tara-ap:hasLocationalDescription "On the medial aspect of the foot, 1 B-cun inferior to the prominence of the medial malleolus, in the depression inferior to the medial malleolus. Note: The corresponding lateral point to KI6 is BL62." ;
    tara-ap:hasPinyinLabel "Zhaohai" ;
    tara-ap:hasSpecialPointRole TARA:9493899 ;
    tara-ap:hasSpecificReferenceLocation ILX:0795305 ;
    tara-ap:hasSynonym "K 6",
        "KD 6",
        "KID 6",
        "Kidney 6" ;
    tara-ap:hasVasculatureInformation "Posteriorly, the posterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4813389 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:3091322 ],
