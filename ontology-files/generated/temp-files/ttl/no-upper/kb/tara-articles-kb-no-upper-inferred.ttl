    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The branch of the great occipital nerve." ;
    tara-ap:hasListedIndications "dizziness, blurred vision, tinnitus, mania." ;
    tara-ap:hasLocationalDescription "On the head, 5.5 B-cun superior to the anterior hairline, 1.5 B-cun lateral to the anterior median line. Note: 0.5 B-cun posterior and 1.5 B-cun lateral to gV20." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch." ;
    tara-ap:hasPinyinLabel "Luoque" ;
