TARA:6993030 a owl:Class ;
    rdfs:label "Luo-Connecting Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "Each of twelve main meridians has, on the limbs, a Luo-Connecting Point to link its exteriorly-interiorly related meridian. Each of the Governor and Conception vessels, and the Major Collateral of the spleen has its Luo-Connecting Point on the trunk. They are termed \"the Fifteen Luo-Connecting Points\". A Luo-Connecting Point is used to treat disorders involving the two exteriorly-interiorly related meridians and those in the area supplied by the two meridians." ;
    tara-ap:hasSpecialPointRole TARA:2162578 ;
    rdfs:subClassOf TARA:4943316 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4943316 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:2162578 ] ) ] .

TARA:7407065 a owl:Class ;
    rdfs:label "SP 4" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 71. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "公孫(孙)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "The saphenous nerve and the branch of the superficial peroneal nerve." ;
    tara-ap:hasListedIndications "gastric pain, vomiting, abdominal pain and distension, diarrhea, dysentery, borborygmus." ;
    tara-ap:hasLocationalDescription "On the medial aspect of the foot, antero- inferior to the base of the first metatarsal bone, at the border between the red and white flesh. Note: A depression can be felt when mov- ing proximally from SP3. SP4 is located in the depression distal to the base of the first metatarsal bone." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Gongsun" ;
