TARA:4598552 a owl:Class ;
    rdfs:label "Xi-Cleft Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Xi-Cleft Point is the site where the qi and blood of the meridian are deeply converged. Each of the twelve main meridians and the four extra meridians (Yin Heel Vessel, Yang Heel Vessel, Yin Link Vessel and Yang Link Vessel) has a Xi-Cleft Point on the limbs, amounting to sixteen in all. The Xi-Cleft Point is used to treat acute disorders in the area supplied by its pertaining meridian and those of its pertaining zang or fu organ." ;
    tara-ap:hasSpecialPointRole TARA:2798650 ;
    rdfs:subClassOf TARA:4943316 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4943316 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:2798650 ] ) ] .

TARA:0829128 a owl:Class ;
    rdfs:label "GV 26" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 216. https://iris.who.int/handle/10665/353407",
