tara-kb:S-112625-1337 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1337" ;
    dc:title "Acupuncture Combined with Massage for Treatment of Cervical Spondylosis of Vertebral Artery Type" ;
    tara-kb:hasAcupunctureProtocol """Jiaji (EX B2): perpendicularly inserted one Cun deep
Baihui (GV 20): horizontally needled 1.2 Cun towards Houding (GV 19) along subcutaneous tissue
Fengchi (GB 20): needled 1 1.5 Cun towards the inner canthus of the opposite side
Futu (LI 18): added for patients with fluctuation of blood pressure
Neiguan (PC 6): added for patients with nausea and vomiting
Jingming (BL1) and Zanzhu (BL 2): added for patients with change of vision""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group consisted of 46 patients who received oral administration of Sibelium (5mg each time, twice daily) for 2 weeks." ;
    tara-kb:hasCountryOfStudy "Not specified" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "EX B2, GV 20, GB 20, LI 18, PC 6, BL 1, BL 2" ;
    tara-kb:hasListedAcupointsMapped TARA:1460220,
        TARA:2324295,
        TARA:3386254,
        TARA:3734471,
        TARA:4311153,
