    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:0859695\": \"LI 4\", \"TARA:6499349\": \"LR 3\", \"TARA:6463344\": \"ST 36\", \"TARA:2454652\": \"ST 35\", \"TARA:0926802\": \"Xiyan\", \"TARA:8433932\": \"SP 10\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition HP:0005086 ;
