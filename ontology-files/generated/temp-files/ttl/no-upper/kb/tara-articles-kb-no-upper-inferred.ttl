TARA:2108622 a owl:Class ;
    rdfs:label "KI 6" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 138. https://iris.who.int/handle/10665/353407",
