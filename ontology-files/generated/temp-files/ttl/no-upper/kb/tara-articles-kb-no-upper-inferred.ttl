TARA:8982235 a owl:Class ;
    rdfs:label "GV 9" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 208. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "至陽(阳)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasInnervationInformation "The medial branch of the posterior ramus of the seventh thoracic nerve." ;
    tara-ap:hasListedIndications "jaundice, cough, asthma, stiffness of the back, pain in the chest and back." ;
    tara-ap:hasLocationalDescription "In the upper back region, in the depression inferior to the spinous process of the seventh thoracic vertebra (T7), on the posterior median line. Note: The depression inferior to the spinous process of the seventh thoracic vertebra (T7) which is at the intersection of two imaginary lines: the posterior midline and the horizontal line of the inferior border of the inferior angle of the scapula." ;
    tara-ap:hasMethodDescription "Puncture obliquely upward 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhiyang" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004632,
        UBERON:0006849,
        ILX:0795312 ;
    tara-ap:hasSynonym "Du 9",
        "Governor Vessel 9",
        "VG 9" ;
    tara-ap:hasVasculatureInformation "The posterior branch of the seventh intercostal artery." ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
