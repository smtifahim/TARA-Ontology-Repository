TARA:1137686 a owl:Class ;
    rdfs:label "LR 9" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 200. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "陰(阴)包(包)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000376 ;
    tara-ap:hasInnervationInformation "The anterior femoral cutaneous nerve, on the pathway of the anterior branch of the obturator nerve." ;
    tara-ap:hasListedIndications "pain in the lumbosacral region, lower abdominal pain, enuresis, retention of urine, irregular menstruation." ;
    tara-ap:hasLocationalDescription "On the medial aspect of the thigh, between the gracilis and the sartorius muscles, 4 B- cun proximal to the base of the patella. Note: With the hip slightly flexed and ab- ducted and with the muscle under tension, the sartorius muscle becomes more distinct. Lr 9 is located posterior to the sartorius muscle." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Yinbao" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0000950,
        UBERON:0001373,
        UBERON:0002446 ;
    tara-ap:hasSynonym "LIV 9",
        "LV 9",
        "Liver 9" ;
    tara-ap:hasVasculatureInformation "Deeper, on the lateral side, the femoral artery and vein, the superficial branch of the medial circumflex femoral artery." ;
    tara-ap:isLocatedOnMeridian TARA:5419503 ;
