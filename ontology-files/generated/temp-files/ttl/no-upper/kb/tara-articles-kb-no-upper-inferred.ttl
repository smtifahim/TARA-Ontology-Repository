tara-kb:S-112625-1433 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1433" ;
    dc:title "Manual Acupuncture Reduces Hyperemesis Gravidarum: A Placebo-Controlled, Randomized, Single-Blind, Crossover Study" ;
    tara-kb:hasAcupunctureProtocol """Active Acupuncture: PC6, located between the tendons of the palmaris longus and flexor carpi radialis muscles, at a depth just above the median nerve, approximately 5 cm above the wrist crease on both forearms.
Placebo Acupuncture: Superficial insertion 10 cm from the wrist on the thumb side of both forearms.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT) Crossover Design" ;
    tara-kb:hasControlGroupsDetails "The control group used in this study was the placebo (superficial) acupuncture group, where needles were inserted superficially away from a traditional acupuncture point without seeking a \"de-qi\" sensation." ;
    tara-kb:hasCountryOfStudy "Sweden" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "PC 6" ;
    tara-kb:hasListedAcupointsMapped TARA:4311153 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:4311153\": \"PC 6\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition MONDO:0006791 ;
    tara-kb:hasNeedlingDetails """Active acupuncture: Not specified (described as "at a depth just above the median nerve")
Placebo acupuncture: 1-2 mm (intracutaneously or superficially subcutaneously)""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1433 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1433 ;
    tara-kb:hasSampleSizeDetails """Total participants initially: 33
Total participants analyzed: 26
Group A: 17
Group B: 16""" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: Real needles were used for both active and sham procedures.
Quantity: Not specified.
Size: Not specified.
Location: Sham procedure was performed 10 cm from the wrist on the thumb side of both forearms, away from a traditional acupuncture point.
Penetration: Superficial, with needles inserted only 1-2 mm in the skin.
Other details: No "de-qi" sensation was sought, and needles were twisted every 10 minutes.""" ;
    tara-kb:hasStimulationTypeDetails """Active (deep) acupuncture: Manual manipulation with a focus on achieving a "tingling sensation ('deqi') radiating to the hand and/or fingers."
Placebo (superficial) acupuncture: Manual manipulation with slight twisting every 10 minutes, no 'de-qi' sensation sought.""" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not provide a TCM term for hyperemesis gravidarum)" ;
    tara-kb:hasStudiedWesternCondition "Hyperemesis gravidarum" ;
    tara-kb:hasStudyFindings "Yes, the acupuncture intervention was effective compared to the control/sham group based on the primary outcome of nausea reduction (p = 0.032)." ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Degree of nausea on a visual analogue scale (VAS)
Daily number of emesis episodes
Secondary outcome measures:
Increase in food intake
Reduction in intravenous fluid""" ;
    tara-kb:hasTreatmentDuration "30 minutes (duration of each session); needles left in place for the duration of the session (30 minutes)" ;
    tara-kb:hasTreatmentFrequency "Three times daily on treatment days (days 1, 2, 5, and 6), with each treatment lasting 30 minutes." .

