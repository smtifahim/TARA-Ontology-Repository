tara-kb:S-112625-89 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-89" ;
    dc:title "Acupuncture for systemic lupus erythematosus: a pilot RCT feasibility and safety study" ;
    tara-kb:hasAcupunctureProtocol """First set of AC points: Hua Tuo Jai Ji points at thoracic levels T-3, T-7, T-11; LI-4, GV-14, KI-7, SP-6
Second set of AC points: Hua Tuo Jai Ji points at T-5, T-9, L-1; GB-20, MH-5, ST-36
Minimal needling areas: Bilateral points on scapulae (medial aspect, just inferior to scapular spine), gluteus maximus (posterior-lateral aspect, approximately 2 cm below the iliac crest), forearm (posterior medial forearm approximately 4 cm distal to the medial epicondyle), leg (posterior leg over the midpoint of lateral head of gastrocnemius)""" ;
    tara-kb:hasClinicalTrialType "Pilot Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Minimal needling (MN): Involves shallow insertion of needles in areas not corresponding to acupuncture points.
Usual care (UC): Standard medical care for SLE, including daily doses of corticosteroids (2-10 mg) and anti-inflammatory medicines.""" ;
    tara-kb:hasCountryOfStudy "United States" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Hua Tuo Jai Ji T-3, Hua Tuo Jai Ji T-7, Hua Tuo Jai Ji T-11, LI 4, GV 14, KI 7, SP 6, Hua Tuo Jai Ji T-5, Hua Tuo Jai Ji T-9, Hua Tuo Jai Ji L-1, GB 20, MH 5, ST 36" ;
