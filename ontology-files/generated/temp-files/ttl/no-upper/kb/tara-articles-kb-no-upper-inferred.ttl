UBERON:0013708 a owl:Class ;
    rdfs:label "anterior superior iliac spine" ;
    IAO:0000115 "The anterior superior iliac spine (ASIS) is an important landmark of surface anatomy. It refers to the anterior extremity of the iliac crest of the pelvis, which provides attachment for the inguinal ligament, the sartorius muscle, and the tensor fasciae latae. ASIS provides a clue in identifying some other clinical landmarks, including: McBurney's point Gardner's line Roser-NC)laton line A - Anterior (front, like the face) S - Superior (towards the head, opposite to feet) I - Iliac S - Spine." ;
    OboInOwl:hasDbXref "FMA:49465",
        "SCTID:182031001",
        "Wikipedia:Anterior_superior_iliac_spine" ;
    OboInOwl:hasExactSynonym "anterior superior iliac spine (volume)" ;
    OboInOwl:hasRelatedSynonym "anterior superior iliac spine",
        "anterior superior spine" ;
    rdfs:subClassOf UBERON:0013712 .

UBERON:0035207 a owl:Class ;
    rdfs:label "deep fibular nerve" ;
    IAO:0000115 "A branch of the common peroneal nerve. It innervates the ankle and toes." ;
    OboInOwl:hasDbXref "FMA:44771",
        "NCIT:C92602",
        "SCTID:181081007",
        "UMLS:C0228949",
        "Wikipedia:Deep_fibular_nerve" ;
    OboInOwl:hasExactSynonym "deep peroneal nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001324 ],
        UBERON:0003431,
        UBERON:0035652 .

TARA:1282828 a owl:Class ;
    rdfs:label "HT 5" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 84. https://iris.who.int/handle/10665/353407",
