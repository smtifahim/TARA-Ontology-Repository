UBERON:0010323 a owl:Class ;
    rdfs:label "cranial skeletal system" ;
    IAO:0000115 "Skeletal subdivision of the head including skull (cranium plus mandible), pharyngeal and/or hyoid apparatus." ;
    IAO:0000116 "we use 'cranial skeletal system', so that we can include the skull, which has joints/sutures as parts (recall, we follow FMA in distinguishing between the skeleton and skeletal system - only the latter includes joints)" ;
    IAO:0000232 "that the cranial skeleton includes the pharyngeal arch skeleton. It is thus more inclusive that the cranium itself, and extends beyond the head in tetrapods. The AAO class called 'skull' belongs here, as it includes the whole splanchnocranium" ;
    OboInOwl:hasDbXref "AAO:0000109",
        "AAO:0000971",
        "AAO:0010185",
        "TAO:0000737",
        "VSAO:0000049",
        "XAO:0003075",
        "ZFA:0000737" ;
    OboInOwl:hasNarrowSynonym "cranial skeleton",
        "osteocranium" ;
    OboInOwl:hasRelatedSynonym "cranium" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0011137 ],
        UBERON:0000075 .

UBERON:0010720 a owl:Class ;
    rdfs:label "hindlimb zeugopod skeleton" ;
    IAO:0000115 "Subdivision of skeleton consisting of all skeletal elements in an hindlimb zeugopod region. Typically consists of the tibia and the fibula." ;
    OboInOwl:hasDbXref "AAO:0000216",
        "VSAO:0005014" ;
    OboInOwl:hasExactSynonym "crural skeleton",
        "crus skeleton",
        "hindlimb zygopod skeleton",
        "posterior zeugopodium skeleton",
        "skeleton cruris" ;
    OboInOwl:hasRelatedSynonym "hind epipodium",
        "hindlimb epipodium",
        "mesomere 2 of pelvic appendage",
        "posterior zeugopodium" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0003823 ],
        UBERON:0011584 .

UBERON:0010740 a owl:Class ;
    rdfs:label "bone of appendage girdle complex" ;
    IAO:0000115 "A bone that is part of an appendage girdle complex (i.e. any bone in a limb, fin or girdle)." ;
    OboInOwl:hasDbXref "EMAPA:35494",
        "MA:0000688" ;
    OboInOwl:hasRelatedSynonym "bone of extended limb/fin region",
        "limb bone" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002091 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0010707 ],
        UBERON:0001474 .

UBERON:0010759 a owl:Class ;
    rdfs:label "equine distal sesamoid" ;
    IAO:0000115 "Lies on the palmar aspect of the coffin joint between the second phalanx and third phalanx. articulates closely with the distal phalanx, to which it is connected by the impar ligament of the navicular bone. The impar ligament is very strong and permits relatively little motion between the navicular bone and the distal phalanx." ;
    OboInOwl:hasDbXref "SCTID:370654009",
        "Wikipedia:Navicular_bone#Horse_anatomy" ;
    OboInOwl:hasRelatedSynonym "distal sesamoid bone",
        "navicular bone" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002470 ],
        UBERON:0001479,
        UBERON:0011141,
        UBERON:0011250 .

UBERON:0011187 a owl:Class ;
    rdfs:label "ventral tubercle of humerus" ;
    IAO:0000115 "The greater tubercle of the humerus is situated lateral to the head of the humerus and posteriolateral to the lesser tubercle. Its upper surface is rounded and marked by three flat impressions. the highest of these gives ('superior facet') insertion to the Supraspinatus the middle ('middle facet') to the Infraspinatus. the lowest one ('inferior facet'), and the body of the bone for about 2.5 cm. below it, to the Teres minor. The lateral surface of the greater tubercle is convex, rough, and continuous with the lateral surface of the body. Between the greater tubercle and the lesser tubercle is the intertubercular sulcus (bicipital groove)." ;
    OboInOwl:hasDbXref "FMA:23390",
        "NCIT:C32700",
        "SCTID:181934009",
        "UMLS:C1512275",
        "Wikipedia:Greater_tubercle" ;
    OboInOwl:hasExactSynonym "greater tubercle",
        "greater tubercle of humerus",
        "greater tuberosity of humerus",
        "tuberculum majus",
        "tuberculum majus humeri" ;
    OboInOwl:hasRelatedSynonym "greater tubercle of the humerus",
        "greater tuberosity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0004411 ],
        UBERON:0005813,
        UBERON:4100000 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/3/3b/Gray326.png"^^xsd:anyURI .

UBERON:0011582 a owl:Class ;
    rdfs:label "paired limb/fin skeleton" ;
    IAO:0000115 "The collection of all skeletal elements in an individual limb or fin." ;
    OboInOwl:hasDbXref "VSAO:0000301" ;
    OboInOwl:hasExactSynonym "limb/fin skeleton",
        "skeletal parts of limb/fin",
        "skeleton of limb/fin" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002091 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0004708 ],
        UBERON:0004120,
        UBERON:0010912 .

UBERON:0012139 a owl:Class ;
    rdfs:label "segment of autopod" ;
    rdfs:subClassOf [ a owl:Restriction ;
