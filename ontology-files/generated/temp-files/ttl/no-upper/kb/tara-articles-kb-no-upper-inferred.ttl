TARA:4589241 a owl:Class ;
    rdfs:label "BL 57" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 128. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "承山" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasListedIndications "low back pain, spasm of the gastrocnemius, hemorrhoids, constipation, beriberi." ;
    tara-ap:hasLocationalDescription "On the posterior aspect of the leg, at the connecting point of the calcaneal tendon with the two muscle bellies of the gastrocnemius muscle. Note: With the leg stretched (plantar flexion) or the heel up, BL57 is located at the sharp angled depression inferior to the muscle belly of the gastrocnemius muscle. the two heads of the gastrocnemius muscle are separated to make a lambda shape (Λ)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Chengshan" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001388,
        UBERON:0003701 ;
    tara-ap:hasSynonym "B 57",
        "Bladder 57",
        "UB 57",
        "Urinary Bladder 57" ;
    tara-ap:hasVasculatureInformation "The small saphenous vein; deeper, the posterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001388 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003701 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003823 ] ],
        TARA:0995552 .

TARA:5361067 a owl:Class ;
    rdfs:label "Triple Energizer Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Triple Energizer Meridian of Hand-Shaoyang (TE), which consists of 23 standardized acupoints beginning at TE 1 (Guanchong) on the ulnar side of the ring finger near the corner of the nail, traveling up the dorsal-middle aspect of the arm, ascending over the shoulder and the side of the neck, and circling around the ear, and ending at TE 23 (Sizhukong) in the depression at the lateral end of the eyebrow." ;
    tara-ap:hasSynonym "Acupoint of Triple Energizer Meridian",
        "Acupoint of the Triple Energizer Meridian",
        "Acupuncture point of triple energizer meridian",
        "Acupuncture point of triple energizer meridian of hand-shaoyang",
        "SJ Acupoint",
        "TB Acupoint",
        "TE Acupoint",
        "TW Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:3898257 ] ) ] .

TARA:6594221 a owl:Class ;
    rdfs:label "He-Sea Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the five Shu Points, the He-Sea point signifies the confluence of rivers in the sea, where the meridian qi is the most flourishing. In addition, each of the six fu organs has another He-Sea point in the three yang meridians of the foot, known as the Lower He-Sea point." ;
    tara-ap:hasSpecialPointRole TARA:4109407 ;
    rdfs:subClassOf TARA:1787498 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:1787498 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:4109407 ] ) ] .

TARA:6681003 a owl:Class ;
    rdfs:label "LI 20" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 43. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "迎(迎)香" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasInnervationInformation "The anastomotic branch of the facial nerve and infraorbital nerves." ;
    tara-ap:hasListedIndications "nasal obstruction, hyposmia, epistaxis, rhinorrhea, deviation of the mouth, itching and swelling of the face." ;
    tara-ap:hasLocationalDescription "On the face, in the nasolabial sulcus, at the same level as the midpoint of lateral border of the ala of the nose. Remarks: Alternative location for LI20 - On the face, in the nasolabial sulcus, at the level of the inferior border of the ala of the nose." ;
    tara-ap:hasMethodDescription "Puncture obliquely or subcutaneously 0.3-0.5 inch." ;
    tara-ap:hasPinyinLabel "Yingxiang" ;
    tara-ap:hasRelatedArtery UBERON:0001612,
        UBERON:0004646 ;
    tara-ap:hasRelatedNerve UBERON:0001647,
        UBERON:0018408 ;
    tara-ap:hasRelatedVein UBERON:0001653,
        ILX:0797500 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0006906,
        ILX:0795290 ;
    tara-ap:hasSynonym "CO 20",
        "Colon 20",
        "Large Intestine 20" ;
    tara-ap:hasVasculatureInformation "The facial artery and vein, the branches of the infraorbital artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4610474 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedArtery ;
            owl:someValuesFrom UBERON:0001612 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795290 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedVein ;
            owl:someValuesFrom UBERON:0001653 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0006906 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom UBERON:0018408 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedVein ;
            owl:someValuesFrom ILX:0797500 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedArtery ;
            owl:someValuesFrom UBERON:0004646 ],
