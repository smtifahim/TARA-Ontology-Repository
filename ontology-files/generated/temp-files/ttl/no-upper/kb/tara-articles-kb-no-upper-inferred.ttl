        "http://www.snomedbrowser.com/Codes/Details/181322008" ;
    OboInOwl:hasExactSynonym "brachial part of trunk of subclavian artery" ;
    OboInOwl:hasRelatedSynonym "arteria brachialis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001398 ],
