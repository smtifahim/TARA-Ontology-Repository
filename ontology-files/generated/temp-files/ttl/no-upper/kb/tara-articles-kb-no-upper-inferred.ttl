    tara-ap:hasChineseLabel "胃倉(仓)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasInnervationInformation "The lateral cutaneous branches of the posterior ramus of the eleventh thoracic nerve." ;
    tara-ap:hasListedIndications "abdominal distension, pain in the epigastric region and back, infantile indigestion." ;
    tara-ap:hasLocationalDescription "In the upper back region, at the same level as the inferior border of the spinous process of the 12th thoracic vertebra (T12), 3 B-cun lateral to the posterior median line. Note: BL50 and BL21 are located at the same level as the inferior border of the spinous process of the 12th thoracic vertebra (T12)." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Weicang" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004636,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 50",
        "Bladder 50",
        "UB 50",
        "Urinary Bladder 50" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the subcostal artery and vein." ;
