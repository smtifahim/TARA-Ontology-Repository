tara-kb:S-112625-1737 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1737" ;
    dc:title "Effect of Combined Acupuncture with Chinese Medicine on Overall Function of Patients with Post stroke Depression" ;
    tara-kb:hasAcupunctureProtocol """Baihui (GV 20): 1.0 cun, subcutaneously, even reinforcing reducing manipulation
Sishencong (Ex HN 1): 0.5 cun, subcutaneously, even reinforcing reducing manipulation
Taichong (LR 3): 0.5 1.0 cun, perpendicularly against the Liver Meridian, heavy reducing effect
Zusanli (ST 36): gently along the running course of the meridians, reinforcing effect
Sanyinjiao (SP 6): gently along the running course of the meridians, reinforcing effect
Points chosen based on TCM diagnosis for liver qi stagnation with spleen deficiency""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group in this study is the Western medication group (WMG), which received Fluoxetine Capsules as a standard treatment for post stroke depression." ;
    tara-kb:hasCountryOfStudy "Not specified" ;
    tara-kb:hasDatasetLink "Not specified" ;
