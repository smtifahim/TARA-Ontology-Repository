    tara-ap:hasChineseLabel "靈(灵,霊)墟(墟)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The anterior cutaneous branch of the third intercostal nerve; deeper, the third intercostal nerve." ;
    tara-ap:hasListedIndications "cough, asthma, fullness in the chest and hypochondriac region, mastitis." ;
    tara-ap:hasLocationalDescription "In the anterior thoracic region, in the third intercostal space, 2 B-cun lateral to the anterior median line." ;
    tara-ap:hasPinyinLabel "Lingxu" ;
    tara-ap:hasSpecificReferenceLocation ILX:0795285,
        ILX:0795297 ;
    tara-ap:hasSynonym "K 24",
