                    owl:someValuesFrom UBERON:0010163 ] ],
        TARA:0995552 .

TARA:8440155 a owl:Class ;
    rdfs:label "ST 44" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 68. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "内庭" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "Just where the lateral branch of the medial dorsal cutaneous nerve divides into dorsal digital nerves." ;
    tara-ap:hasListedIndications "toothache, pain in the face, deviation of the mouth, sore throat, epistaxis, gastric pain, acid regurgitation, abdominal distension, diarrhea, dysentery, constipation, swelling and pain of the dorsum of the foot, febrile diseases." ;
    tara-ap:hasLocationalDescription "On the dorsum of the foot, between the second and third toes, posterior to the web margin, at the border between the red and white flesh." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Neiting" ;
    tara-ap:hasRelatedNerve UBERON:0035526 ;
    tara-ap:hasRelatedVein UBERON:0008783 ;
    tara-ap:hasSpecialPointRole TARA:9857829 ;
