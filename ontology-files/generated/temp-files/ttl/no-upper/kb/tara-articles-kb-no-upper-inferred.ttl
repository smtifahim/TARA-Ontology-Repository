tara-op:hasRelatedArtery a owl:ObjectProperty ;
    rdfs:label "hasRelatedArtery" ;
    IAO:0000112 """'LU 1' tara-op:hasRelatedArtery some 'Axillary Artery'; 
'LU 1' tara-op:hasRelatedArtery some 'Thoracoacromial Artery'."""@en ;
    IAO:0000115 "An Acupoint a hasRelatedArtery b (an artery) if and only if a hasRelatedVasculature b and b is an artery."@en ;
    dcterms:description "An object property that associates an Acupoint to a specific related artery occupying its location."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedArtery ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:comment "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its ancestor properties hasRelatedVasculature and hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:subPropertyOf tara-op:hasRelatedVasculature .

tara-op:hasRelatedVein a owl:ObjectProperty ;
    rdfs:label "hasRelatedVein" ;
    IAO:0000112 """'LU 1' tara-op:hasRelatedVein some 'Axillary Vein'; 
'LU 1' tara-op:hasRelatedVein some 'Thoracoacromial Vein'."""@en ;
    IAO:0000115 "An Acupoint a hasRelatedVein b (a vein) if and only if a hasRelatedVasculature b and b is a vein."@en ;
    dcterms:description "An object property that associates an Acupoint to a specific related vein occupying its location."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedVein ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:comment "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its ancestor properties hasRelatedVasculature and hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:subPropertyOf tara-op:hasRelatedVasculature .

TARA:2324295 a owl:Class ;
    rdfs:label "GB 20" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 181. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "風(风)池" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasInnervationInformation "The branch of the lesser occipital nerve." ;
    tara-ap:hasListedIndications "headache, vertigo, insomnia, pain and stiffness of the neck, blurred vision, glaucoma, red and painful eyes, tinnitus, convulsion, epilepsy, infantile convulsion, febrile diseases, common cold, nasal obstruction, rhinorrhea." ;
    tara-ap:hasLocationalDescription "In the anterior region of the neck, inferior to the occipital bone, in the depression between the origins of sternocleidomastoid and the trapezius muscles. Note: GB20 is at the same level as GV16." ;
    tara-ap:hasMethodDescription "Puncture 0.5-0.8 inch towards the tip of the nose. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Fengchi" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001128,
        UBERON:0001676,
        UBERON:0002380 ;
    tara-ap:hasSynonym "G 20",
        "Gallbladder 20" ;
    tara-ap:hasVasculatureInformation "The branches of the occipital artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
