        UBERON:0000475 .

UBERON:0011779 a owl:Class ;
    rdfs:label "nerve of head region" ;
    IAO:0000115 "A nerve that is part of a head." ;
    ilxtr:hasExistingId UBERON:0011779,
        ILX:0735739 ;
    OboInOwl:hasRelatedSynonym "cephalic nerve",
        "head nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000033 ],
        UBERON:0001021 .

UBERON:0012140 a owl:Class ;
    rdfs:label "digitopodium region" ;
    IAO:0000115 "A segment of the autopod consisting of both acropodial region and metapodial region, but excluding the mesopodial/basopodial region." ;
    OboInOwl:hasRelatedSynonym "acropodium (Wagner)" ;
    rdfs:seeAlso "https://github.com/obophenotype/uberon/wiki/Subdivisions-of-the-autopod"^^xsd:anyURI ;
    rdfs:subClassOf UBERON:0012139 .

UBERON:0012141 a owl:Class ;
    rdfs:label "manual digitopodium region" ;
    IAO:0000115 "A digitopodium region that is part of a manus[Obol]. This includes the fingers and metacarpal region, but excludes the carpal region." ;
    rdfs:seeAlso "https://github.com/obophenotype/uberon/wiki/Subdivisions-of-the-autopod"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002398 ],
        UBERON:0005451,
        UBERON:0012140 .

UBERON:0012142 a owl:Class ;
    rdfs:label "pedal digitopodium region" ;
    IAO:0000115 "A digitopodium region that is part of a pes[Obol]. This includes the toes and metatarsal region, but excludes the tarsals region." ;
    rdfs:seeAlso "https://github.com/obophenotype/uberon/wiki/Subdivisions-of-the-autopod"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002387 ],
        UBERON:0005445,
        UBERON:0012140 .

UBERON:0012198 a owl:Class ;
    rdfs:label "intercostal space" ;
    IAO:0000115 "A space in the rib cage between two successive ribs." ;
    ilxtr:hasExistingId UBERON:0012198,
        FMA:12243,
        ILX:0733269 ;
    OboInOwl:hasDbXref "FMA:12243",
        "SCTID:243937005",
        "Wikipedia:Intercostal_space",
        "http://en.wikipedia.org/wiki/Intercostal_space",
        "http://www.snomedbrowser.com/Codes/Details/243937005" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0003252 ],
        UBERON:0000464 .

UBERON:0012324 a owl:Class ;
    rdfs:label "transverse cervical artery" ;
    IAO:0000115 "The transverse cervical artery (transverse artery of neck, transversa colli artery) is a branch of the thyrocervical trunk, running at a higher level than the suprascapular artery." ;
    OboInOwl:hasDbXref "FMA:10664",
        "MA:0001936",
        "SCTID:244224008",
        "Wikipedia:Transverse_cervical_artery" ;
    OboInOwl:hasRelatedSynonym "cervical artery",
        "cervical transverse artery",
        "descending branch of the transverse cervical",
        "transversalis artery colli",
        "transversalis colli artery",
        "transverse cervical",
        "transverse cervical vessels" ;
    rdfs:subClassOf UBERON:0012320 .

UBERON:0013469 a owl:Class ;
    rdfs:label "external occipital protuberance" ;
    IAO:0000115 "Near the middle of the occipital squama is the external occipital protuberance, and extending lateralward from it on either side is the superior nuchal line, and above this the faintly marked highest nuchal line. It is less pronounced in females. The inion is the highest point of the external occipital protuberance. a projection on the external surface of the squamous part of the occipital bone in the midline." ;
    OboInOwl:hasDbXref "FMA:75752",
        "SCTID:139582005",
        "Wikipedia:External_occipital_protuberance" ;
    OboInOwl:hasRelatedSynonym "inion" ;
    rdfs:seeAlso "https://github.com/obophenotype/uberon/issues/166"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0007170 ],
        UBERON:0005913 .

UBERON:0013765 a owl:Class ;
    rdfs:label "digestive system element" ;
    IAO:0000115 "Any of the organs or elements that are part of the digestive system. Examples: tongue, esophagus, spleen, crop, lunge feeding organ, tooth elements." ;
    OboInOwl:hasDbXref "EMAPA:37843",
        "SCTID:272627002" ;
    OboInOwl:hasExactSynonym "digestive organ",
        "digestive system organ" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001007 ],
        UBERON:0000062 .

UBERON:0015063 a owl:Class ;
    rdfs:label "autopod endochondral element" ;
    IAO:0000115 "An endochondral element that is part of a autopod region." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002470 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0006717 ],
        UBERON:0015061 .

UBERON:0016496 a owl:Class ;
    rdfs:label "tendon of palmaris longus" ;
    OboInOwl:hasDbXref "FMA:38594" ;
    OboInOwl:hasExactSynonym "palmaris longus tendon" ;
    OboInOwl:hasRelatedSynonym "tendon of palmaris longus muscle" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0004452 ],
        UBERON:0000043,
        UBERON:0003575 .

UBERON:0034929 a owl:Class ;
    rdfs:label "external soft tissue zone" ;
    IAO:0000115 "A region or zone on the surface of an organism that encompasses skin and any adnexa, down through muscles and bounded by underlying skeletal support structures." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000475 ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom UBERON:0000014 ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom UBERON:0001015 ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom UBERON:0001021 ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom UBERON:0002049 ],
        UBERON:0010000,
        UBERON:0010314 .

UBERON:0039187 a owl:Class ;
    rdfs:label "suprascapular vein" ;
    IAO:0000115 "The suprascapular vein is a vein running above the scapula. It empties into the external jugular vein." ;
    OboInOwl:hasDbXref "FMA:14319" ;
    rdfs:subClassOf UBERON:0001638 .

UBERON:0039835 a owl:Class ;
    rdfs:label "posterior intercostal artery" ;
    IAO:0000115 "The posterior intercostal arteries are a group of 11 paired segmental blood vessels that provide the primary arterial blood supply to the thoracic wall, intercostal muscles, overlying skin, parietal pleura, and structures surrounding the spinal cord. Source: Radiopaedia; https://radiopaedia.org/articles/posterior-intercostal-arteries" ;
    ilxtr:hasExistingId UBERON:0039835,
        ILX:0797545 ;
    rdfs:subClassOf UBERON:0005612 .

UBERON:0039847 a owl:Class ;
    rdfs:label "suprascapular artery" ;
    OboInOwl:hasDbXref "FMA:10663" ;
    OboInOwl:hasExactSynonym "transverse scapular artery" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0039260 ],
        UBERON:0004573 .

UBERON:5101466 a owl:Class ;
    rdfs:label "pedal digit digitopodial skeleton" ;
    IAO:0000115 "A subdivision of the skeleton of the autopod consisting of the phalanges of pedal digit plus the associated metapodial element." ;
    IAO:0000232 "this class represents a series of phalanges plus a metapodial element. In comparative anatomy terminology we would call this a 'digit', but the label 'digit' is sometimes used to exclude metapodials and to include soft tissue. This series of elements is hypothesized to be homologous to radials." ;
    OboInOwl:hasRelatedSynonym "pedal digit",
        "pedal digit skeleton" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012150 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:5001466 ],
        UBERON:5102544 .

UBERON:5102389 a owl:Class ;
    rdfs:label "manual digit digitopodial skeleton" ;
    IAO:0000115 "A subdivision of the skeleton of the autopod consisting of the phalanges of manual digit plus the associated metapodial element." ;
    IAO:0000232 "this class represents a series of phalanges plus a metapodial element. In comparative anatomy terminology we would call this a 'digit', but the label 'digit' is sometimes used to exclude metapodials and to include soft tissue. This series of elements is hypothesized to be homologous to radials." ;
    OboInOwl:hasRelatedSynonym "manual digit",
        "manual digit skeleton" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012150 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:5002389 ],
        UBERON:5102544 .

UBERON:5102544 a owl:Class ;
    rdfs:label "individual digit of digitopodial skeleton" ;
    IAO:0000115 "A subdivision of the skeleton of the autopod consisting of the phalanges of a single digit plus the associated metapodial element." ;
    IAO:0000232 "this class represents a series of phalanges plus a metapodial element. In comparative anatomy terminology we would call this a 'digit', but the label 'digit' is sometimes used to exclude metapodials and to include soft tissue. This series of elements is hypothesized to be homologous to radials." ;
    OboInOwl:hasRelatedSynonym "digit",
        "digit skeleton" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012150 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:5002544 ],
        UBERON:0010712 .

UBERON:8600092 a owl:Class ;
    rdfs:label "radial vein" ;
    IAO:0000115 "A vein that is tributary of the brachial vein and drains blood from the lateral structures of the forearm, carpal and metacarpal bones, joints of the hand, and lateral forearm muscles." ;
    dcterms:contributor <https://orcid.org/0000-0001-6677-8489> ;
    dcterms:date "2024-06-06T09:53:48Z" ;
    OboInOwl:hasDbXref "FMA:22947" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001460 ],
        UBERON:0001638,
        UBERON:0003507 .

ILX:0797474 a owl:Class ;
    rdfs:label "Supraclavicular nerve" ;
    IAO:0000115 "The supraclavicular nerve is a cutaneous (sensory) nerve of the cervical plexus that arises from the third and fourth cervical (spinal) nerves. It emerges from beneath the posterior border of the sternocleidomastoid muscle, then split into multiple branches. Together, these innervate the skin over the shoulder." ;
    isPartOf: UBERON:0003725 ;
    ilxtr:hasExistingId FMA:65414,
        ILX:0797474 ;
    OboInOwl:hasExactSynonym "cutaneous branches of the cervical plexus" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0003725 ],
        UBERON:0001027 .

TARA:0337120 a owl:Class ;
    rdfs:label "GB 42" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 192. https://iris.who.int/handle/10665/353407",
