    tara-kb:hasAcupunctureProtocol """Middle Line of Forehead (MS 1)
Middle Line of Vertex (MS 5)
Posterior Temporal Line (MS 11) of the affected side""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group received conventional neurological medication and physical training, but did not receive scalp acupuncture. They were observed for 3 months without any additional intervention." ;
