    tara-kb:hasStudiedWesternCondition "Postoperative pain" ;
    tara-kb:hasStudyFindings "Yes (auricular acupuncture was found to be effective in reducing postoperative pain compared to control/sham groups in most studies)" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Pain intensity, Analgesic requirements
