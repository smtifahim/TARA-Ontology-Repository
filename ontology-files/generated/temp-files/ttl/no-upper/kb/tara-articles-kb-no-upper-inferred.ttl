    tara-kb:hasNeedlingDetails """SP6 treatment group: 2.5-4.0 cm
GB39 control group: 1.25-2.0 cm""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-435 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-435 ;
    tara-kb:hasSampleSizeDetails """Total participants analyzed: 60
SP6 treatment group: 30
GB39 control group: 30""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used)" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation (lifting-thrusting and twirling) to induce needling sensation (de qi)" ;
    tara-kb:hasStudiedTCMCondition "Primary dysmenorrhea with TCM patterns: qi and Blood stagnation, Cold-Damp accumulation, Heat-Damp stagnation, qi and Blood deficiency, Liver and Kidney deficiency" ;
    tara-kb:hasStudiedWesternCondition "Primary Dysmenorrhea" ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Differences in pulsatility index (PI), resistance index (RI), and ratio of systolic peak and diastolic peak (A/B) in uterine arteries; Menstrual pain scores.
Secondary outcome measures: Not specified.""" ;
