tara-kb:S-112625-413 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-413" ;
    dc:title "Acupuncture for pain relief during induced labour in nulliparae: a randomised controlled study" ;
    tara-kb:hasAcupunctureProtocol """Hegu (LI 4): located at the midpoint of the first and second metacarpal bones
Sanyinjiao (Sp 6): located on the inner aspect of the lower leg, 3 cun above the top of the ankle, just behind the bone
Kunlun (BL 60): located in the depressed area behind the external malleolus
Zhiyin (BL 67): located on the lower lateral side of the little toe, 0.1 cun lateral to the corner of the nail
Sham acupuncture: needles inserted adjacent to these points, 1-1.5 mm deep, without stimulation""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Sham acupuncture: This group received sham acupuncture where needles were inserted but no actual stimulation was provided. It was further divided into "sham-manual" and "sham-electro" to mimic the real procedures.
No-treatment control group: This group did not receive any form of acupuncture.""" ;
    tara-kb:hasCountryOfStudy "United Kingdom" ;
    tara-kb:hasDatasetLink "Not specified" ;
