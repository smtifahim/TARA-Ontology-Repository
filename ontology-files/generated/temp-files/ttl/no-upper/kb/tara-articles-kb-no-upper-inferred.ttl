    OboInOwl:hasExactSynonym "greater saphenous vein" ;
    OboInOwl:hasRelatedSynonym "large saphenous vein",
        "long saphenous vein",
        "vena saphena magna" ;
    rdfs:subClassOf UBERON:0007318 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/5/51/Great_saphenous_vein.png"^^xsd:anyURI .

UBERON:0001396 a owl:Class ;
    rdfs:label "lateral thoracic artery" ;
    IAO:0000115 "A blood vessel that supplies oxygenated blood to the lateral structures of the thorax and breast. It originates from the axillary artery and follows the lower border of the Pectoralis minor muscle to the side of the chest, supplies the serratus ventralis muscle and the Pectoralis major muscle, and sends branches across the axilla to the axillary lymph nodes and Subscapularis muscle. It anastomoses with the internal thoracic artery, subscapular, and intercostal arteries, and with the pectoral branch of the thoracoacromial artery. In the female it supplies an external mammary branch which turns round the free edge of the Pectoralis major and supplies the breasts. [WP,unvetted]." ;
    OboInOwl:hasDbXref "EMAPA:37095",
        "FMA:22674",
        "MA:0001989",
        "NCIT:C52951",
        "SCTID:206135006",
        "UMLS:C0226421",
        "Wikipedia:Lateral_thoracic_artery" ;
    OboInOwl:hasExactSynonym "external mammary artery" ;
    OboInOwl:hasRelatedSynonym "arteria thoracalis lateralis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001467 ],
        [ a owl:Restriction ;
            owl:onProperty RO:0002170 ;
            owl:someValuesFrom UBERON:0001394 ],
        UBERON:0001637 ;
    foaf:depiction "https://upload.wikimedia.org/wikipedia/commons/4/4c/Axillary_branches.PNG"^^xsd:anyURI .

UBERON:0001537 a owl:Class ;
    rdfs:label "anterior tibial artery" ;
    IAO:0000115 "The anterior tibial artery of the lower limb carries blood to the anterior compartment of the leg and dorsal surface of the foot, from the popliteal artery. It is accompanied by a deep vein, the anterior tibial vein, along its course. It crosses the anterior aspect of the ankle joint, at which point it becomes the dorsalis pedis artery. [WP,unvetted]." ;
    OboInOwl:hasDbXref "EMAPA:37071",
        "FMA:43894",
        "MA:0002574",
        "NCIT:C12825",
        "SCTID:181357006",
        "UMLS:C0085816",
        "Wikipedia:Anterior_tibial_artery" ;
    OboInOwl:hasRelatedSynonym "arteria tibialis anterior" ;
    rdfs:subClassOf UBERON:0007610 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/8/81/Gray1247.png"^^xsd:anyURI .

UBERON:0001653 a owl:Class ;
    rdfs:label "facial vein" ;
    IAO:0000115 "The anterior facial vein (facial vein) commences at the side of the root of the nose, and is a direct continuation of the angular vein where it also receives a small nasal branch. It lies behind the facial artery and follows a less tortuous course. It receives blood from the external palatine vein before it either joins the anterior branch of the retromandibular vein to form the common facial vein, or drains directly into the internal jugular vein. [WP,unvetted]." ;
    OboInOwl:hasDbXref "AAO:0010513",
        "EMAPA:19220",
        "FMA:50874",
        "MA:0002115",
        "NCIT:C32579",
        "SCTID:181374006",
        "UMLS:C0226532",
        "Wikipedia:Facial_vein" ;
    OboInOwl:hasExactSynonym "face vein",
        "vein of face" ;
    OboInOwl:hasRelatedSynonym "anterior facial vein",
        "vena facialis anterior" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001456 ],
        UBERON:0003496,
        UBERON:0009141 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/8/8c/Gray557.png"^^xsd:anyURI .

