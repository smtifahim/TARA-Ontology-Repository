HP:0031217 a owl:Class ;
    rdfs:label "Hot flashes" ;
    IAO:0000115 "Sudden feelings of warmth that are generally most pronounced over the face, neck and chest." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-07-02T11:38:24+00:00"^^xsd:dateTime ;
    rdfs:comment "Hot flashes are most commonly due to menopause but may be observed with other conditions." ;
    rdfs:subClassOf HP:0025142 .

MONDO:0004979 a owl:Class ;
    rdfs:label "asthma" ;
    IAO:0000115 "A bronchial disease that is characterized by chronic inflammation and narrowing of the airways, which is caused by a combination of environmental and genetic factors resulting in recurring periods of wheezing (a whistling sound while breathing), chest tightness, shortness of breath, mucus production and coughing. The symptoms appear due to a variety of triggers such as allergens, irritants, respiratory infections, weather changes, exercise, stress, reflux disease, medications, foods and emotional anxiety." ;
    mondons:curated_content_resource "https://www.malacards.org/card/asthma"^^xsd:anyURI ;
    OboInOwl:hasDbXref "DOID:2841",
        "HP:0002099",
        "ICD10CM:J45",
        "ICD10WHO:J45",
        "ICD9:493",
        "ICD9:493.81",
        "ICD9:493.9",
        "MEDGEN:2109",
        "MESH:D001249",
        "NCIT:C28397",
        "SCTID:31387002",
        "UMLS:C0004096",
        "icd11.foundation:1656445230" ;
    OboInOwl:hasNarrowSynonym "chronic obstructive asthma",
        "chronic obstructive asthma with acute exacerbation",
        "chronic obstructive asthma with status asthmaticus",
        "exercise induced asthma",
        "exercise-induced asthma" ;
    rdfs:subClassOf MONDO:0001358 ;
    skos:exactMatch <http://id.who.int/icd/entity/1656445230>,
        <http://identifiers.org/medgen/2109>,
        <http://identifiers.org/mesh/D001249>,
        <http://identifiers.org/snomedct/31387002>,
        <http://linkedlifedata.com/resource/umls/id/C0004096>,
        <http://purl.bioontology.org/ontology/ICD10CM/J45>,
        obo:DOID_2841,
        obo:NCIT_C28397,
        <https://icd.who.int/browse10/2019/en#/J45> .

