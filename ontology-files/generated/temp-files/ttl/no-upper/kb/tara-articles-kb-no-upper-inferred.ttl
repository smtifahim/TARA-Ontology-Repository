TARA:5367032 a owl:Class ;
    rdfs:label "BL 43" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 121. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "膏肓" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasInnervationInformation "The medial cutaneous branches of the posterior rami of the second and third thoracic nerves; deeper, their lateral branches and the dorsoscapular nerve." ;
    tara-ap:hasListedIndications "pulmonary tuberculosis, cough, asthma, spitting of blood, night sweat, poor memory, nocturnal emission." ;
    tara-ap:hasLocationalDescription "In the upper back region, at the same level as the inferior border of the spinous pro- cess of the fourth thoracic vertebra (T4), 3 B-cun lateral to the posterior median line. Note: BL43 and BL14 are located at the same level as the inferior border of the spinous process of the fourth thoracic vertebra (T4)." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Gaohuang" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004629,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 43",
        "Bladder 43",
        "UB 43",
        "Urinary Bladder 43" ;
    tara-ap:hasVasculatureInformation "The posterior branch of the intercostal artery and the descending branch of the transverse cervical artery." ;
