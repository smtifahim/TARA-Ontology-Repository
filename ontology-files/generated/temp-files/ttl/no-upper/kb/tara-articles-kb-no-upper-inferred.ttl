                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002497 ] ],
        TARA:7932600 .

TARA:3515622 a owl:Class ;
    rdfs:label "LU 7" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 29. https://iris.who.int/handle/10665/353407",
