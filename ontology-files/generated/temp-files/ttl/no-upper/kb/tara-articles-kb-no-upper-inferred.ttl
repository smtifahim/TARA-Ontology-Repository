tara-kb:S-112625-773 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-773" ;
    dc:title "Acupuncture for Preventing Complications after Radical Hysterectomy: A Randomized Controlled Clinical Trial" ;
    tara-kb:hasAcupunctureProtocol """Sanyinjiao (SP6): Punctured at a depth of 20 mm vertically.
Shuidao (ST28): Punctured 20 mm obliquely towards symphysis pubica.
Epangxian III (MS4): Inserted 15 mm horizontally.
Zusanli (ST36): Punctured at a depth of 20 mm vertically.
Binao (LI14): Used as sham point with superficial needle insertion less than 3 mm.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group received sham acupuncture at the Binao (LI14) point without any stimulation. This group served as a baseline to evaluate postoperative complications and was used for comparison with the treatment group." ;
    tara-kb:hasCountryOfStudy "China" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "SP 6, ST 28, MS 4, ST 36, LI 14" ;
