TARA:1822260 a owl:Class ;
    rdfs:label "CV 10" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 224. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "下脘" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795301 ;
    tara-ap:hasInnervationInformation "The anterior cutaneous branch of the eighth intercostal nerve." ;
    tara-ap:hasListedIndications "epigastric pain, abdominal pain, borborygmus, indigestion, vomiting, diarrhea." ;
    tara-ap:hasLocationalDescription "On the upper abdomen, 2 B-cun superior to the centre of the umbilicus, on the anterior median line." ;
