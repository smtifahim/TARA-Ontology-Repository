TARA:5717468 a owl:Class ;
    rdfs:label "ST 25" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 58. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "天樞(枢)" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795301 ;
    tara-ap:hasInnervationInformation "The branch of the tenth intercostal nerve." ;
    tara-ap:hasListedIndications "abdominal pain and distension, borborygmus, pain around the umbilicus, constipation, diarrhea, dysentery, irregular menstruation, edema." ;
    tara-ap:hasLocationalDescription "On the upper abdomen, 2 B-cun lateral to the centre of the umbilicus." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.7-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Tianshu" ;
    tara-ap:hasRelatedArtery UBERON:0001354,
