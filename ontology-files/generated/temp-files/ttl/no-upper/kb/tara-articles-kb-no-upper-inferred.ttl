        UBERON:0011279 ;
    tara-ap:hasSynonym "S 45",
        "Stomach 45" ;
    tara-ap:hasVasculatureInformation "The arterial and venous network formed by the dorsal digital artery and vein of foot." ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
