HP:0000168 a owl:Class ;
    rdfs:label "Abnormality of the gingiva" ;
    IAO:0000115 "Any abnormality of the gingiva (also known as gums)." ;
    OboInOwl:hasDbXref "UMLS:C4021816" ;
    OboInOwl:hasExactSynonym "Abnormality of the gums",
        "Gingival abnormality" ;
    rdfs:comment "The gingiva consists of the mucosal tissue that lies over the alveolar bone and around the base of the teeth." ;
    rdfs:subClassOf HP:0011830 .

HP:0000230 a owl:Class ;
