tara-kb:S-112625-3 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-3" ;
    dc:title "Acupuncture accelerates recovery after general anesthesia: a prospective randomized controlled trial" ;
    tara-kb:hasAcupunctureProtocol """Yongquan (KI1): on the sole of the foot in the depression formed by flexing the foot toward the plants, between the second and third metatarsal bone to about one-third of the distance between the base of the second toe and the heel (perpendicular insertion, 0.5-0.7 cm deep).
Renzhong (DU26): above the upper lip along the midline at the junction of the upper third with the lower two-third of the depression between the root of the nose and the upper edge of the lip (oblique transverseup insertion, 0.2-0.5 cm deep).
Sham points: between KI1 and the lateral margin of the foot (perpendicular insertion, 0.5-0.7 cm deep), and at the apex of the chin (oblique transverse-up insertion, 0.2-0.5 cm deep).""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Group D: Sham acupuncture (bilateral sham points)
Group E: No acupuncture""" ;
    tara-kb:hasCountryOfStudy "Italy" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "KI 1, DU 26" ;
    tara-kb:hasListedAcupointsMapped TARA:0829128,
        TARA:4512048 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:4512048\": \"KI 1\", \"TARA:0829128\": \"GV 26\"}"^^rdf:JSON ;
    tara-kb:hasNeedlingDetails """Group A (KI1): 0.5-0.7 cm deep
Group B (DU26): 0.2-0.5 cm deep
Group C (KI1 + DU26): Same as Groups A and B
Group D (Sham acupuncture): 0.5-0.7 cm deep for KI1 sham, 0.2-0.5 cm deep for DU26 sham""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-3 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-3 ;
    tara-kb:hasSampleSizeDetails """Total participants analyzed: 47
Participants within groups:
Group A: 8
Group B: 10
Group C: 10
Group D: 9
Group E: 10""" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: Real needles (0.3 mm √ó 25 mm; Hwato, Suzhou Medical Appliance Factory, China; sterilized with ethylene oxide gas)
Quantity: Bilateral
Size: 0.3 mm √ó 25 mm
Location: Between KI1 and the lateral margin of the foot (perpendicular insertion, 0.5-0.7 cm deep), and at the apex of the chin (oblique transverse-up insertion, 0.2-0.5 cm deep)
Penetrating: Yes
Other details: Continuous manual stimulation according to traditional Chinese medicine (TCM)""" ;
    tara-kb:hasStimulationTypeDetails "Manual stimulation of the needles according to traditional Chinese medicine (TCM) techniques." ;
    tara-kb:hasStudiedTCMCondition "Loss of consciousness due to yin-deficiency or yang-deficiency syndrome or Jue syndrome" ;
    tara-kb:hasStudiedWesternCondition "Not specified (the primary condition is recovery from general anesthesia, not a specific Western medical condition or disease)" ;
