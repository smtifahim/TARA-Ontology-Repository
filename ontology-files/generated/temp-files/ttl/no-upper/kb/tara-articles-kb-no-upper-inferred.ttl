        UBERON:0010887 ;
    tara-ap:hasSynonym "Small Intestine 19" ;
    tara-ap:hasVasculatureInformation "The auricular branches of the superficial temporal artery and vein" ;
    tara-ap:isLocatedOnMeridian TARA:9093316 ;
