tara-kb:S-112625-1481 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1481" ;
    dc:title "A Controlled Trial of Acupuncture in Psoriasis: No Convincing Effect" ;
    tara-kb:hasAcupunctureProtocol """Active treatment: Deep intramuscular insertion at classical points according to traditional Chinese principles, about 20 named points, plus ear acupuncture on the outer aspect of one auricle.
Placebo treatment: Superficial insertion in subcutaneous tissue outside classical points, one needle on the medial aspect of the earlobe.
Specific acupoints not specified.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Active treatment group: electrostimulation by needles placed intramuscularly, plus ear-acupuncture
Placebo group: sham, 'minimal acupuncture' with superficial needle insertion outside classical points without electrostimulation""" ;
