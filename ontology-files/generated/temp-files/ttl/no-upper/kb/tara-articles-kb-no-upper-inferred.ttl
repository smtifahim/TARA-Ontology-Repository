TARA:6845331 a owl:Class ;
    rdfs:label "GB 44" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 193. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "足竅(窍)陰(阴)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003634 ;
    tara-ap:hasInnervationInformation "The dorsal digital nerve." ;
    tara-ap:hasListedIndications "migraine, deafness, tinnitus, ophthalmalgia, dream-disturbed sleep, febrile diseases." ;
    tara-ap:hasLocationalDescription "On the fourth toe, lateral to the distal phalanx, 0.1 f-cun proximal to the lateral corner of the toenail, at the intersection of the vertical line of the lateral side of the nail and the horizontal line of the base of the fourth toenail." ;
    tara-ap:hasMethodDescription "Puncture superficially about 0.1 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zuqiaoyin" ;
    tara-ap:hasSpecialPointRole TARA:2954517 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004300,
        UBERON:0009567,
        UBERON:0011281 ;
    tara-ap:hasSynonym "G 44",
        "Gallbladder 44" ;
    tara-ap:hasVasculatureInformation "The arterial and venous network formed by the dorsal digital artery and vein and plantar digital artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
