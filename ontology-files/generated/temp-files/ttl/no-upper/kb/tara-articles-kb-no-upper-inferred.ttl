    tara-kb:hasNeedlingDetails "0.6 mm" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-144 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-144 ;
    tara-kb:hasSampleSizeDetails """Total participants initially recruited: 90
Total participants analyzed: 81
Press needle group: 42
Placebo group: 39""" ;
    tara-kb:hasShamAcupunctureDetails """Sham procedure: Placebo device identical to press needle but without needle element.
Quantity: 45 participants received the placebo.
Size: Same as press needle but without needle element.
Location: Same as press needle, at the BL23 acupoint.
Penetration: Non-penetrating.
Other details: Administered in the same manner as press needles, with identical packaging.""" ;
    tara-kb:hasStimulationTypeDetails "The stimulation in this study involves the insertion of press needles, which are a type of shallow needling. The needles cause almost no sensation at the time of insertion, and there is no mention of additional stimulation methods such as manual manipulation or electrical stimulation. The focus is on the minimal sensation of penetration and de qi (dull sensation)." ;
    tara-kb:hasStudiedWesternCondition "Low back pain (LBP)" ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Applicability as measured by responses to a questionnaire-based assessment for confirming the applicability of the press needles to blind testing.
Secondary outcome measures: Efficacy measured using a VAS of LBP; Safety assessed by evaluating possible adverse effects of acupuncture.""" ;
    tara-kb:hasTreatmentDuration "Not specified (the paper does not provide explicit information on the duration of each acupuncture session or how long the needles were left in place)" ;
    tara-kb:hasTreatmentFrequency "Not specified (the paper does not provide information on the frequency of treatment administration)" .

tara-kb:S-112625-1440 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1440" ;
    dc:title "Comparison of Real and Placebo Acupuncture in Histamine-Induced Asthma A Double-Blind Crossover Study" ;
    tara-kb:hasAcupunctureProtocol """Real Acupuncture Points:
Dingchuan: located 0.5 cun from the midline between C7 and TI spinous processes
Ren 17 (Shanzhong): located on the front of the chest between the nipples
Lung 6 (Kongzui): located on the anterior aspect of the forearm, 7 cun above the wrist
Lung 7: located 1.5 cuns above the wrist crease
Placebo Acupuncture Points:
Triple energy 5: on the back of the wrist
Stomach 25: on the anterior abdominal wall next to the umbilicus
Gallbladder 34: on the front of the head of the fibula""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Control group: The study used a control day as a baseline for comparison.
Placebo group: Placebo acupuncture points (triple energy 5, stomach 25, and gallbladder 34) were used as a control to compare with real acupuncture.""" ;
    tara-kb:hasCountryOfStudy "Australia" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Dingchuan, Ren 17, Lung 6, Lung 7, Triple Energy 5, Stomach 25, Gallbladder 34" ;
