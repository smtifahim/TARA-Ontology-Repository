HP:0007550 a owl:Class ;
    rdfs:label "Hypohidrosis or hyperhidrosis" ;
    OboInOwl:hasDbXref "UMLS:C4021831" ;
    OboInOwl:hasExactSynonym "Lack of sweating or excessive sweating" ;
    rdfs:subClassOf HP:0025276 .

HP:0008066 a owl:Class ;
    rdfs:label "Abnormal blistering of the skin" ;
    IAO:0000115 "The presence of one or more bullae on the skin, defined as fluid-filled blisters more than 5 mm in diameter with thin walls." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-04-02T03:54:00+00:00"^^xsd:dateTime ;
    OboInOwl:hasAlternativeId "HP:0007467",
        "HP:0007496",
        "HP:0200038" ;
    OboInOwl:hasDbXref "UMLS:C0241054",
        "UMLS:C2132198",
        "UMLS:C2220104" ;
    OboInOwl:hasExactSynonym "Abnormal blistering of the skin",
        "Blister",
        "Blistering, generalised",
        "Blistering, generalized",
        "Blisters",
        "Skin bullae" ;
    OboInOwl:hasRelatedSynonym "Skin blisters" ;
    rdfs:comment "A bulla is a large vesicle described as a rounded or irregularly shaped blister containing serous or seropurulent fluid, equal to or greater than 10mm. In approaching blistering diseases, there are 3 fundamental criteria to consider: (1) the site or level of the blister (or the lowest level of vesiculation): subcorneal, midepidermis, suprabasal, subepidermal; (2) the findings that implicate the mechanism of blister formation (spongiosis, acantholysis, blistering degeneration, or epidermolysis); and (3) the type of inflammation (neutrophilic, lymphocytic, eosinophilic, mixed), if present." ;
    rdfs:subClassOf HP:0011121 .

HP:0008209 a owl:Class ;
    rdfs:label "Premature ovarian insufficiency" ;
    IAO:0000115 "Amenorrhea due to loss of ovarian function before the age of 40. Primary ovarian insuficiency (POI) is a state of female hypergonadotropic hypogonadism. It can manifest as primary amenorrhea with onset before menarche or secondary amenorrhea." ;
    OboInOwl:hasAlternativeId "HP:0001587",
        "HP:0100805" ;
    OboInOwl:hasDbXref "SNOMEDCT_US:373717006",
        "UMLS:C0025322",
        "UMLS:C0085215" ;
    OboInOwl:hasExactSynonym "Climacterium praecox",
        "Early menopause",
        "Hypergonadotropic amenorrhea",
        "Menopause praecox",
        "Premature menopause",
        "Premature ovarian failure",
        "Primary ovarian insufficiency" ;
    rdfs:comment "The causes of primary ovarian insufficiency (POI) include chromosomal and genetic defects, autoimmune processes, chemotherapy, radiation, infections and surgery, but many are unidentified (idiopathic). The age of 40 is set by convention but is supported by clinical observations. From a statistical point of view, the age limit of 40 is approximately two standard deviations (SD) below the average age at natural menopause (50 plus/minus 4 years)." ;
    rdfs:subClassOf HP:0031066 .

HP:0009121 a owl:Class ;
    rdfs:label "Abnormal axial skeleton morphology" ;
    IAO:0000115 "An abnormality of the axial skeleton, which comprises the skull, the vertebral column, the ribs and the sternum." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-04-05T11:16:00+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4020785",
        "UMLS:C4024586" ;
    OboInOwl:hasRelatedSynonym "Abnormality of the axial skeleton" ;
    rdfs:subClassOf HP:0011842 .

HP:0010280 a owl:Class ;
    rdfs:label "Stomatitis" ;
    IAO:0000115 "Stomatitis is an inflammation of the mucous membranes of any of the structures in the mouth." ;
    dcterms:contributor <https://orcid.org/0000-0001-7601-9822>,
        <https://orcid.org/0000-0001-9382-150X>,
        <https://orcid.org/0000-0002-2029-0733>,
        <https://orcid.org/0000-0002-3577-9021>,
        <https://orcid.org/0000-0002-4315-9105>,
        <https://orcid.org/0009-0004-8124-8864> ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2009-07-12T09:48:56+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:20607006",
        "SNOMEDCT_US:61170000",
        "UMLS:C0038362",
        "UMLS:C0149704" ;
    OboInOwl:hasExactSynonym "Inflammation of the mouth",
        "Stomatitis" ;
    OboInOwl:hasNarrowSynonym "Gingivostomatitis" ;
    rdfs:comment "Principal causative agents include herpes simplex virus (HSV), which causes recurrent herpetic stomatitis particularly in T-cell deficiencies, and Coxsackievirus (hand-foot-and-mouth disease), which may be unusually severe or prolonged in antibody deficiencies." ;
    rdfs:subClassOf HP:0011830,
        HP:0012649 .

HP:0010307 a owl:Class ;
    rdfs:label "Stridor" ;
    IAO:0000115 "Stridor is a high pitched sound resulting from turbulent air flow in the upper airway." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2009-07-12T02:16:48+00:00"^^xsd:dateTime ;
    OboInOwl:hasBroadSynonym "Noisy breathing" ;
    OboInOwl:hasDbXref "SNOMEDCT_US:248573009",
        "SNOMEDCT_US:70407001",
        "UMLS:C0038450",
        "UMLS:C0237304" ;
    rdfs:comment "Stridor is different from wheezing by the following reasons. It is louder over the neck than chest wall. Secondly; stridor is mainly inspiratory. If occurs in expiration, it is usually biphasic. On the other hand; wheeze is mainly expiratory and occurs during both phases. It indicates extrathoracic upper-airway obstruction (supraglottic lesions like laryngomalacia, vocal cord lesion) when heard on inspiration. It occurs in expiration if associated with intrathoracic tracheobronchial lesions (tracheomalacia, bronchomalacia, and extrinsic compression). It occurs in both phases if lesion is fixed, for example, stenosis. Stridor is caused by the turbulent flow passing through a narrowed segment of the upper respiratory tract." ;
    rdfs:subClassOf HP:0030829 .

HP:0010549 a owl:Class ;
    rdfs:label "Weakness due to upper motor neuron dysfunction" ;
    IAO:0000115 "Paralysis of voluntary muscles means loss of contraction due to interruption of one or more motor pathways from the brain to the muscle fibers. Although the word paralysis is often used interchangeably to mean either complete or partial loss of muscle strength, it is preferable to use paralysis or plegia for complete or severe loss of muscle strength, and paresis for partial or slight loss. Paralysis due to lesions of the principle motor tracts is related to a lesion in the corticospinal, corticobulbar or brainstem descending (subcorticospinal) neurons." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2009-10-01T08:30:25+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4021255" ;
    OboInOwl:hasExactSynonym "Paralysis due to lesions of the principle motor tracts" ;
    rdfs:subClassOf HP:0002493 .

HP:0010866 a owl:Class ;
    rdfs:label "Abdominal wall defect" ;
    IAO:0000115 "An incomplete closure of the abdominal wall." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2010-08-03T09:55:15+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C0238577" ;
    OboInOwl:hasExactSynonym "Abdominal wall defect",
        "Congenital anterior abdominal wall defect" ;
    rdfs:subClassOf HP:0004298 .

HP:0010935 a owl:Class ;
    rdfs:label "Abnormality of the upper urinary tract" ;
    IAO:0000115 "An abnormality of the upper urinary tract." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-01-16T11:37:29+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4023641" ;
    OboInOwl:hasExactSynonym "Abnormality of the upper urinary tract" ;
    rdfs:comment "The upper urinary tract is a subdivision of urinary system which consists of the kidney and the ureters." ;
    rdfs:subClassOf HP:0000079 .

HP:0010936 a owl:Class ;
    rdfs:label "Abnormality of the lower urinary tract" ;
    IAO:0000115 "An abnormality of the lower urinary tract." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-01-16T11:39:17+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4023640" ;
    rdfs:comment "The lower urinary tract is a subdivision of urinary system which consists of the urinary bladder and the urethra." ;
    rdfs:subClassOf HP:0000079 .

HP:0011028 a owl:Class ;
    rdfs:label "Abnormality of blood circulation" ;
    IAO:0000115 "An abnormality of blood circulation." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-03-03T10:25:21+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4020760",
        "UMLS:C4023585" ;
    OboInOwl:hasRelatedSynonym "Blood circulation disorder" ;
    rdfs:subClassOf HP:0011025 .

HP:0011029 a owl:Class ;
    rdfs:label "Internal hemorrhage" ;
    IAO:0000115 "The presence of hemorrhage within the body." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-03-03T10:26:26+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C1390214" ;
    OboInOwl:hasExactSynonym "Internal bleeding",
        "Internal haemorrhage" ;
    rdfs:subClassOf HP:0001892,
        HP:0011028 .

HP:0011032 a owl:Class ;
    rdfs:label "Abnormality of fluid regulation" ;
    IAO:0000115 "An abnormality of the regulation of body fluids." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-03-05T09:09:27+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:1860003",
        "SNOMEDCT_US:190902006",
        "UMLS:C2364164" ;
    OboInOwl:hasExactSynonym "Abnormality of fluid regulation",
        "Fluid imbalance" ;
    rdfs:subClassOf HP:0012337 .

HP:0011107 a owl:Class ;
    rdfs:label "Recurrent aphthous stomatitis" ;
    IAO:0000115 "Recurrent episodes of ulceration of the oral mucosa, typically presenting as painful, sharply circumscribed fibrin-covered mucosal defects with a hyperemic border." ;
    dcterms:contributor <https://orcid.org/0000-0001-7601-9822>,
        <https://orcid.org/0000-0001-9382-150X>,
        <https://orcid.org/0000-0002-2029-0733>,
        <https://orcid.org/0000-0002-3577-9021>,
        <https://orcid.org/0000-0002-4315-9105>,
        <https://orcid.org/0009-0004-8124-8864> ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-06-08T07:11:09+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:110426005",
        "SNOMEDCT_US:398870000",
        "SNOMEDCT_US:426965005",
        "SNOMEDCT_US:427617000",
        "UMLS:C0038363",
        "UMLS:C2937365" ;
    OboInOwl:hasExactSynonym "Recurrent canker sores",
        "Recurrent oral aphthae" ;
    OboInOwl:hasRelatedSynonym "Aphthous stomatitis",
        "Buccal aphthous ulcers",
        "Recurrent aphthous ulcers" ;
    rdfs:comment "Recurrent aphthous stomatitis can be classified into three forms, with minor ulcers (over 80% of RAS cases) being less than 1 cm in diameter and self-limiting; major ulcers being over 1 cm in diameter with potential scar formation; and herpetiform ulcers manifesting as recurrent episodes with multiple small ulcers throughout the oral mucosa." ;
    rdfs:subClassOf HP:0031446,
        HP:5210251 .

HP:0011110 a owl:Class ;
    rdfs:label "Recurrent tonsillitis" ;
    IAO:0000115 "Inflammation of the tonsils that has occurred repeatedly. The definition of recurrent may vary somewhat, but the criteria used recently as a measure of severity were five or more episodes of true tonsillitis per year, symptoms recurring for at least a year, and episodes that are disabling and that prevent normal functioning. In some cases recurrent tonsillitis may be related to immunosusceptibility. Evidence exists for a genetic predisposition for recurrent tonsillitis." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-06-10T07:46:38+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:90176007",
        "UMLS:C0040425" ;
    OboInOwl:hasExactSynonym "Recurrent inflammation of tonsils" ;
    rdfs:subClassOf HP:0002719,
        HP:0100765 .

HP:0011123 a owl:Class ;
    rdfs:label "Inflammatory abnormality of the skin" ;
    IAO:0000115 "The presence of inflammation of the skin. That is, an abnormality of the skin resulting from the local accumulation of fluid, plasma proteins, and leukocytes." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-06-12T10:06:04+00:00"^^xsd:dateTime ;
    OboInOwl:hasAlternativeId "HP:0002727",
        "HP:0007423" ;
    OboInOwl:hasDbXref "MP:0004947",
        "SNOMEDCT_US:703938007",
        "UMLS:C0011603",
        "UMLS:C3875321" ;
    OboInOwl:hasExactSynonym "Abnormal tendency to infections of the skin",
        "Inflammatory abnormality of the skin",
        "Skin inflammation" ;
    OboInOwl:hasRelatedSynonym "Inflammatory skin disease" ;
    rdfs:subClassOf HP:0011122,
        HP:0012649 .

HP:0011277 a owl:Class ;
    rdfs:label "Abnormality of the urinary system physiology" ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-12-30T02:51:16+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4023437" ;
    rdfs:subClassOf HP:0000079 .

HP:0011389 a owl:Class ;
    rdfs:label "Functional abnormality of the inner ear" ;
    IAO:0000115 "An abnormality of the function of the inner ear." ;
    dcterms:creator <https://orcid.org/0000-0002-6996-5279> ;
    dcterms:date "2012-03-09T04:58:30+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4023382" ;
    OboInOwl:hasExactSynonym "Functional abnormality of the inner ear" ;
    rdfs:comment "The inner ear comprises the cochlea, three semicircular canals and the vestibule (labyrinth), and is directly responsible for hearing. Additionally, the vestibule and semicircular canals function to maintain balance or equilibrium." ;
    rdfs:subClassOf HP:0031704 .

HP:0011420 a owl:Class ;
    rdfs:label "Age of death" ;
    IAO:0000115 "The age group when the cessation of life happens." ;
    OboInOwl:hasDbXref "UMLS:C1546180" ;
    rdfs:subClassOf HP:0040006 .

HP:0011702 a owl:Class ;
    rdfs:label "Abnormal electrophysiology of sinoatrial node origin" ;
    IAO:0000115 "An abnormality of the sinoatrial (SA) node in the right atrium. THe SA node acts as the pacemaker of the heart." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2012-04-10T11:22:43+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "Fyler:7010",
        "UMLS:C4023222" ;
    rdfs:subClassOf HP:0011675 .

HP:0011703 a owl:Class ;
    rdfs:label "Sinus tachycardia" ;
    IAO:0000115 "Heart rate of greater than 100 beats per minute." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2012-04-10T11:30:45+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:11092001",
        "UMLS:C0039239" ;
    OboInOwl:hasExactSynonym "Sinus tach",
        "Sinus tachy" ;
    rdfs:subClassOf HP:0001649,
        HP:0011702 .

HP:0011799 a owl:Class ;
    rdfs:label "Abnormality of facial soft tissue" ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
