TARA:1992799 a owl:Class ;
    rdfs:label "SP 14" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 76. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "腹結(结)" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795303 ;
    tara-ap:hasInnervationInformation "The eleventh intercostal nerve." ;
    tara-ap:hasListedIndications "pain around the umbilical region, abdominal distension, hernia, diarrhea, constipation." ;
    tara-ap:hasLocationalDescription "On the lower abdomen, 1.3 B-cun inferior to the centre of the umbilicus, 4 B-cun lateral to the anterior median line." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Fujie" ;
