TARA:7228895 a owl:Class ;
    rdfs:label "BL 52" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 125. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "志室" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0005462 ;
    tara-ap:hasInnervationInformation "The lateral branch of the posterior ramus of the twelfth thoracic nerve and the lateral branch of the first lumbar nerve." ;
    tara-ap:hasListedIndications "nocturnal emission, impotence, enuresis, frequency of urination, dysuria, irregular menstruation, pain in the back and knee, edema." ;
    tara-ap:hasLocationalDescription "In the lumbar region, at the same level as the inferior border of the spinous process of the second lumbar vertebra (L2), 3 B-cun lateral to the posterior median line. Note: BL52, BL23 and GV4 are located at the same level as the inferior border of the spinous process of the second lumbar vertebra (L2)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhishi" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004618,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 52",
        "Bladder 52",
        "UB 52",
        "Urinary Bladder 52" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the second lumbar artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
