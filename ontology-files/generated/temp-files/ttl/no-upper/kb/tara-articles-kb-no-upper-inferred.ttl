TARA:8937265 a owl:Class ;
    rdfs:label "BL 45" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 122. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "譩譆" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasInnervationInformation "The medial cutaneous branches of the posterior rami of the fifth and sixth thoracic nerves; deeper, their lateral branches." ;
    tara-ap:hasListedIndications "cough, asthma, pain of the shoulder and back." ;
    tara-ap:hasLocationalDescription "In the upper back region, at the same level as the inferior border of the spinous process of the sixth thoracic vertebra (T6), 3 B-cun lateral to the posterior median line. Note: BL45, BL16 and GV10 are located at the same level as the inferior border of the spinous process of the sixth thoracic vertebra (T6)." ;
    tara-ap:hasMethodDescription "Puncture obliquely downward 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Yixi" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004631,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 45",
        "Bladder 45",
        "UB 45",
        "Urinary Bladder 45" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
