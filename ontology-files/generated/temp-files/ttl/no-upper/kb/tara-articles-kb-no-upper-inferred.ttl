tara-kb:S-112625-1577 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1577" ;
    dc:title "Electroacupuncture for Nausea, Vomiting, and Myelosuppression in Women Receiving Adjuvant Chemotherapy for Early Breast Cancer: A Randomized Controlled Pilot Trial" ;
    tara-kb:hasAcupunctureProtocol "Not specified" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Pilot Trial" ;
    tara-kb:hasControlGroupsDetails "Sham EA: Patients in the sham EA group received a placebo acupuncture treatment using Streitberger's placebo needles and a false electrode." ;
    tara-kb:hasCountryOfStudy "Australia" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Not specified" ;
    tara-kb:hasMappedWesternCondition MONDO:0007254 ;
    tara-kb:hasNeedlingDetails "Not specified" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1577 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1577 ;
    tara-kb:hasSampleSizeDetails """Total participants analyzed: 30
True EA group: 14
Sham EA group: 16""" ;
    tara-kb:hasShamAcupunctureDetails """Sham procedure: Placebo acupuncture treatment
Needle type: Streitberger's placebo needles (0.30x 30mm)
Quantity: Not specified
Location: Not specified (but procedure was identical to true EA)
Penetration: Non penetrating (needle slid into handle)
Other details: False electrode used; provided pricking penetration sensation""" ;
    tara-kb:hasStimulationTypeDetails "Electrical stimulation (electroacupuncture) was used for the true EA group. The sham EA group received a placebo treatment with a pricking sensation but no actual electrical stimulation." ;
    tara-kb:hasStudiedTCMCondition "Not specified" ;
    tara-kb:hasStudiedWesternCondition "Breast Cancer" ;
    tara-kb:hasStudyFindings """Acupuncture was not effective for decreasing acute and delayed nausea and vomiting compared to sham EA.
Acupuncture appeared to provide some protection against neutropenia, with significantly higher adjusted WCC and neutrophil counts at week 6.
The study suggests that acupuncture may be a viable alternative to GCSF for improving neutrophil count and preventing febrile neutropenia.
Further investigation with a larger sample size is necessary to confirm these findings.""" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Feasibility andSafety of electroacupuncture (EA) in conjunction with chemotherapy.
Secondary outcome measures: Efficacy of EA for relieving chemotherapy induced vomiting, nausea, and neutropenia.""" ;
    tara-kb:hasTreatmentDuration "Not specified" ;
    tara-kb:hasTreatmentFrequency "Not specified" .

