ILX:0795285 a owl:Class ;
    rdfs:label "anterior median line" ;
    IAO:0000115 "A vertical line running along the midline of the anterior body surface, aligned with the sternum. On the anterior abdominal and chest walls, the anterior median line can be seen extending from the jugular notch, crossing over the sternum and linea alba in their midline, and reaching out to the midline pubic symphysis." ;
    isPartOf: UBERON:0000916 ;
    ILX:0777130 "https://www.imaios.com/en/e-anatomy/anatomical-structure/anterior-median-line-1536887700" ;
    ilxtr:hasExistingId FMA:20310,
        ILX:0795285 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000916 ],
        UBERON:0006800 .

TARA:3386254 a owl:Class ;
    rdfs:label "GV 20" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 213. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "百會(会)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The branch of the great occipital nerve." ;
    tara-ap:hasListedIndications "headache, vertigo, tinnitus, nasal obstruction, aphasia by apoplexy, coma, mental disorder, prolapse of the rectum and the uterus." ;
    tara-ap:hasLocationalDescription "On the head, 5 B-cun superior to the ante- rior hairline, on the anterior median line. Note 1: GV20 is located in the depression 1 B-cun anterior to the midpoint of the line from the anterior hairline to the posterior hairline. Note 2: When the ears are folded, GV 20 is located at the midpoint of the connecting line between the auricular apices." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Baihui" ;
    tara-ap:hasSpecificReferenceLocation ILX:0795285,
        ILX:0795292,
        ILX:0795326 ;
    tara-ap:hasSynonym "Du 20",
        "Governor Vessel 20",
        "VG 20" ;
    tara-ap:hasVasculatureInformation "The anastomotic network formed by the superficial temporal arteries and veins and the occipital arteries and veins on both sides." ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
