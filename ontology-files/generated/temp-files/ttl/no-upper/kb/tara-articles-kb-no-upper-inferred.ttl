        UBERON:0001522,
        ILX:0795333 ;
    tara-ap:hasSynonym "Small Intestine 7" ;
    tara-ap:hasVasculatureInformation "The terminal branches of the posterior interosseous artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:9093316 ;
