TARA:1926756 a owl:Class ;
    rdfs:label "Gallbladder Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Gallbladder Meridian of Foot-Shaoyang (GB), which consists of 44 standardized acupoints beginning at GB 1 (Tongziliao) on the head in the depression lateral to the outer canthus of the eye, zigzagging across the temporal and occipital regions of the head and descending along the lateral side of the neck, trunk, and leg, and ending at GB 44 (Zuqiaoyin) on the lateral side of the fourth toe near the corner of the nail." ;
    tara-ap:hasSynonym "Acupoint of Gallbladder Meridian",
        "Acupoint of the Gallbladder Meridian",
        "Acupoint of the gallbladder meridian of foot-shaoyang",
        "Acupuncture point of the gallbladder meridian",
        "Acupuncture point of the gallbladder meridian of foot-shaoyang",
        "GB Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:5283975 ] ) ] .

TARA:5282844 a owl:Class ;
    rdfs:label "Stomach Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Stomach Meridian of Foot-Yangming (ST), which consists of 45 standardized acupoints beginning at ST 1 (Chengqi) on the face between the eyeball and the infraorbital margin directly below the pupil, traveling down across the face, neck, chest, and abdomen and continuing along the anterior-lateral aspect of the leg, and ending at ST 45 (Lidui) on the lateral side of the second toe near the corner of the nail." ;
    tara-ap:hasSynonym "Acupoint of Stomach Meridian",
        "Acupoint of the Stomach Meridian",
        "Acupoint of the stomach meridian of foot-yangming",
        "Acupuncture point of the stomach meridian",
        "Acupuncture point of the stomach meridian of foot-yangming",
        "ST Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:6221269 ] ) ] .

TARA:9610280 a owl:Class ;
    rdfs:label "Sishencong" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Headache, vertigo, insomnia, poor memory, epilepsy." ;
    tara-ap:hasLocationalDescription "A group of 4 points, at the vertex, 1 cun respectively posterior, anterior and lateral to Baihui (GV 20). (See Fig. 119)" ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-HN 1",
        "M-HN 1" ;
    rdfs:subClassOf TARA:3535998 .

HP:0000716 a owl:Class ;
    rdfs:label "Depression" ;
    IAO:0000115 "Frequently experiencing feelings of being down, miserable, and/or hopeless; struggling to recover from these moods; having a pessimistic outlook on the future; feeling a pervasive sense of shame; having a low self-worth; experiencing thoughts of suicide and engaging in suicidal behavior." ;
