        ILX:0795309 ;
    tara-ap:hasSynonym "H 1",
        "HE 1",
        "Heart 1" ;
    tara-ap:hasVasculatureInformation "Laterally, the axillary artery." ;
    tara-ap:isLocatedOnMeridian TARA:9474009 ;
