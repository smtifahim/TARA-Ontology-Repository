    tara-kb:hasNeedlingDetails "15-35 mm" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-468 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-468 ;
    tara-kb:hasSampleSizeDetails """Total participants: 72
Acupuncture group: 28
Exercise group: 29
Control group: 15""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used)" ;
    tara-kb:hasStimulationTypeDetails """Manual stimulation: once when inserted and by rotating needles in hand/lower arm to evoke needle sensation every 10 minutes.
Electrical stimulation: low-frequency (2 Hz) for 30 minutes in abdominal and leg muscles, adjusted to produce local muscle contractions without pain or discomfort.""" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly translate PCOS into Traditional Chinese Medicine terminology)" ;
    tara-kb:hasStudiedWesternCondition "Polycystic ovary syndrome (PCOS)" ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcomes: Not specified (the paper is a secondary analysis and does not explicitly mention the primary outcomes of the original trial)
Secondary outcomes: Change in Montgomery √Ösberg Depression Rating Scale (MADRS-S)
Change in Brief Scale for Anxiety (BSA-S)
Change in Swedish Short-Form 36 (SF-36)
Change in PCOS Questionnaire (PCOSQ)""" ;
    tara-kb:hasTreatmentDuration """Duration of treatment: 16 weeks
Frequency of sessions: Twice weekly for 2 weeks, once weekly for 6 weeks, once every other week for 8 weeks
Duration of each session: Electrical stimulation for 30 minutes
Duration needles were left in place: Not specified""" ;
    tara-kb:hasTreatmentFrequency """Frequency: Twice weekly for 2 weeks, once weekly for 6 weeks, once every other week for 8 weeks.
Number of treatments: 14 over 16 weeks.
Duration of each treatment: 30 minutes with electrical stimulation.""" .

tara-kb:S-112625-469 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-469" ;
    dc:title "The Use of Auricular Acupuncture to Reduce Preoperative Anxiety" ;
    tara-kb:hasAcupunctureProtocol """TCM group: Kidney point at superior concha, Heart point at most central area of inferior concha, Shenmen point at inferior lateral wall of triangular fossa.
Relaxation group: Relaxation point at superior lateral wall of triangular fossa, Tranquilizer point at inferior tragus, Master cerebral point at joint of ear lobe and face.
Control group: Points with no documented effect on anxiety (locations not specified).""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The Control group received ear acupuncture needles at three points that have no documented effect on anxiety, serving as a sham acupuncture control." ;
