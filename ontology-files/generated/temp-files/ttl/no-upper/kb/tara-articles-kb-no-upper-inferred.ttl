TARA:6477399 a owl:Class ;
    rdfs:label "PC 5" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 154. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "間(间)使" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002386 ;
    tara-ap:hasInnervationInformation "The medial and lateral antebrachial cutaneous nerves, the palmar cutaneous branch of the median nerve; deeper, the anterior interosseous nerve." ;
    tara-ap:hasListedIndications "cardiac pain, palpitation, stomachache, vomiting, febrile diseases, irritability, malaria, mental disorder, epilepsy, swelling of the axilla, contracture of the elbow and arm." ;
    tara-ap:hasLocationalDescription "On the anterior aspect of the forearm, between the tendons of the palmaris longus and the flexor carpi radialis, 3 B-cun proximal to the palmar wrist crease. Note 1: With the fist clenched, the wrist supinated and the elbow slightly flexed, the two tendons become more prominent. PC5 is located 3 B-cun proximal to PC7. Note 2: If the palmaris longus tendon is not present, PC5 is medial to the flexor carpi radialis tendon." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Jianshi" ;
    tara-ap:hasSpecialPointRole TARA:7315457 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0016496,
        ILX:0795334,
        ILX:0795500 ;
    tara-ap:hasSynonym "HC 5",
        "P 5",
        "PE 5",
        "Per 5",
        "Pericardium 5" ;
    tara-ap:hasVasculatureInformation "The median artery and vein; deeper, the anterior interosseous artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4694897 ;
    rdfs:subClassOf [ a owl:Restriction ;
