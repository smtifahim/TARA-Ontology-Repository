    tara-ap:hasSpecificReferenceLocation UBERON:0000303 ;
    tara-ap:hasSynonym "LIV 11",
        "LV 11",
        "Liver 11" ;
    tara-ap:hasVasculatureInformation "The branches of the medial circumflex femoral artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5419503 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000376 ] ],
