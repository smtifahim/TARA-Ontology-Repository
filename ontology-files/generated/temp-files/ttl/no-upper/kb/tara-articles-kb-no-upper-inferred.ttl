    tara-kb:hasListedAcupointsUnmappable "MS 4" ;
    tara-kb:hasMappedWesternCondition HP:0000010 ;
    tara-kb:hasNeedlingDetails """SP6: 20 mm vertically
ST36: 20 mm vertically
ST28: 20 mm obliquely
MS4: 15 mm horizontally
LI14 (control): superficial, less than 3 mm""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-773 ;
