    tara-ap:hasSynonym "CO 13",
        "Colon 13",
        "Large Intestine 13" ;
    tara-ap:hasVasculatureInformation "The radial collateral artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4610474 ;
