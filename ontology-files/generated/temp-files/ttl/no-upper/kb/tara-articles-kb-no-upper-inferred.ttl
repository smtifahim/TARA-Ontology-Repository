UBERON:0005462 a owl:Class ;
    rdfs:label "lower back" ;
    IAO:0000115 "Subdivision of abdominal segment of trunk which in humans is demarcated from the front of the abdomen by the posterior surface of the anterior layer of the thoracolumbar fascia and the anterior surface of the lumbar vertebral column; together with the front of the abdomen, it constitutes the abdomen[Modified from FMA]." ;
    OboInOwl:hasBroadSynonym "lumbar region" ;
    OboInOwl:hasDbXref "BTO:0001505",
        "EMAPA:36623",
        "FMA:61681",
        "MA:0000027",
        "NCIT:C34004",
        "SCTID:182343007",
        "UMLS:C0024090" ;
    OboInOwl:hasExactSynonym "abdominal back",
        "back of abdomen",
        "dorsum of abdomen",
        "lower back",
        "lumbar part of back",
        "lumbar region of back",
        "posterior part of abdomen",
        "regio lumbalis" ;
    OboInOwl:hasRelatedSynonym "loin",
        "lombus",
        "lumbos" ;
    rdfs:comment "overlaps with region sometimes called 'loin'" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001137 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002417 ],
        UBERON:0009569 .

ILX:0795330 a owl:Class ;
    rdfs:label "popliteal crease" ;
    IAO:0000115 "This is the visible skin fold or line at the back of the knee, formed when the knee is flexed. It is a superficial feature and serves as a landmark for the location of the popliteal fossa beneath." ;
    isPartOf: UBERON:0000978 ;
    ILX:0777130 "https://en.wikipedia.org/wiki/Popliteal_fossa" ;
    ilxtr:hasExistingId ILX:0795330 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000978 ],
        UBERON:0001062 .

ILX:0795333 a owl:Class ;
    rdfs:label "dorsal wrist crease" ;
    IAO:0000115 "The dorsal wrist crease is the skin fold that forms on the back (dorsal) side of the wrist, often visible when the hand is extended. It marks the junction between the forearm and the hand and is located near the proximal ends of the metacarpal bones." ;
    ilxtr:hasExistingId ILX:0795333 ;
    rdfs:subClassOf UBERON:0019243 .

ILX:0797391 a owl:Class ;
    rdfs:label "superficial branch of radial nerve" ;
    IAO:0000115 "The superficial branch of the radial nerve passes along the front of the radial side of the forearm to the commencement of its lower third. It is a sensory nerve." ;
    isPartOf: UBERON:0001492 ;
    ilxtr:hasExistingId ILX:0797391 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001492 ],
        UBERON:0001021 .

TARA:5318530 a owl:Class ;
    rdfs:label "BL 28" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 113. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "膀胱兪(俞)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0005473 ;
    tara-ap:hasInnervationInformation "The lateral branches of the posterior rami of the first and second sacral nerves." ;
    tara-ap:hasLocationalDescription "In the sacral region, at the same level as the second posterior sacral foramen, and 1.5 B-cun lateral to the median sacral crest. Note: At the same level as BL32." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Pangguangshu" ;
    tara-ap:hasSpecialPointRole TARA:6484209 ;
    tara-ap:hasSpecificReferenceLocation ILX:0741680,
        ILX:0795314 ;
    tara-ap:hasSynonym "B 28",
        "Back-Shu Point of the Bladder",
        "Bladder 28",
        "UB 28",
        "Urinary Bladder 28" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the lateral sacral artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0741680 ] ],
