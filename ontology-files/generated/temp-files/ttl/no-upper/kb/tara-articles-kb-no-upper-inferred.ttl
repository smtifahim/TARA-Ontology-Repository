UBERON:0035550 a owl:Class ;
    rdfs:label "superficial vein" ;
    IAO:0000115 "Any of the veins carrying deoxygenated blood from the subcutaneous tissue layers." ;
    OboInOwl:hasDbXref "FMA:76719",
        "NCIT:C33666",
