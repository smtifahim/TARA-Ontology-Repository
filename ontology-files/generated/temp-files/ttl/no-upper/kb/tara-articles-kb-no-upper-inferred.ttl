        TARA:3283628,
        TARA:6050541,
        TARA:6463344,
        TARA:6681003,
        TARA:8122277,
        TARA:8833337 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:6681003\": \"LI 20\", \"TARA:2324295\": \"GB 20\", \"TARA:6050541\": \"BL 13\", \"TARA:8122277\": \"LU 9\", \"TARA:3283628\": \"BL 20\", \"TARA:6463344\": \"ST 36\", \"TARA:0992296\": \"BL 23\", \"TARA:8833337\": \"CV 6\"}"^^rdf:JSON ;
    tara-kb:hasListedAcupointsUnmappable "Extra point" ;
    tara-kb:hasMappedWesternCondition MONDO:0005324 ;
    tara-kb:hasNeedlingDetails """Yingxiang (LI 20): 20 mm
Yintang (EX 1): 15 mm
Fengchi (GB 20): 15 mm
Feishu (BL 13): 20 mm
Taiyuan (LU 9): 10 mm
Pishu (BL 20): 20 mm
Zusanli (ST 36): 40 mm
Shenshu (BL 23): 20 mm
Qihai (CV 6): 20 mm""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-828 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-828 ;
    tara-kb:hasSampleSizeDetails """Total participants analyzed: 26
Participants in Group A: 17
Participants in Group B: 13""" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: Sham needles were 0.26 mm in diameter and 15 mm in length.
Quantity: Same as real acupuncture, three times per week.
Location: Needles were inserted 1.5 cm lateral to the related points.
Penetration: Gentle insertion, not penetrating as deeply as real acupuncture.
Technique: No tonification, sedation, or even movement method was conducted.""" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation (even movement, reducing, tonification) for real acupuncture; no stimulation for sham acupuncture." ;
    tara-kb:hasStudiedTCMCondition "Lung Qi Deficiency, Spleen Qi Deficiency, Kidney Qi Deficiency" ;
    tara-kb:hasStudiedWesternCondition "Seasonal Allergic Rhinitis (SAR)" ;
    tara-kb:hasStudyFindings "Yes, the acupuncture intervention was found to be effective compared to the sham group based on the primary outcomes of symptom improvement. The statistical significance is indicated by p-values: p = 0.003 for nasal symptoms, p = 0.032 for non-nasal symptoms, and p = 0.012 for overall symptom severity." ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Subjective symptom scores using a five-point scale (FPS), overall assessment of severity of SAR symptoms
Secondary outcome measures: Relief medication scores (RMS), adverse effect records""" ;
    tara-kb:hasTreatmentDuration "25 minutes (duration of each session), 25 minutes (needles retained during a session)" ;
    tara-kb:hasTreatmentFrequency "Three times per week for four consecutive weeks, with each session lasting 25 minutes." .

