            owl:onProperty tara-op:hasRelatedVein ;
            owl:someValuesFrom ILX:0797498 ],
        TARA:7932600 .

TARA:3861175 a owl:Class ;
    rdfs:label "Back-Shu Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "Back-Shu points are specific points on the back where the qi of the respective zang-fu organs is infused. It is stated in Chapter 51 of Miraculous Pivot that \"in the Back-Shu Points you are looking for the reactionary spots of tenderness and soreness, or the points on which pressure exerted relieves pain and discomforts of the patient\". Situated close to their respectively related zang-fu organs, the Back-Shu points present abnormal reactions to the dysfunction of their corresponding zang-fu organs. They are often used for disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole TARA:9507527 ;
    rdfs:subClassOf TARA:2614885 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:2614885 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:9507527 ] ) ] .

TARA:5873796 a owl:Class ;
    rdfs:label "ST 29" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 60. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "歸(归,帰)來(来)" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795303 ;
    tara-ap:hasInnervationInformation "The iliohypogastric nerve." ;
    tara-ap:hasListedIndications "abdominal pain, hernia, dysmenorrhea, irregular menstruation, amenorrhea, leukorrhea, prolapse of the uterus." ;
    tara-ap:hasLocationalDescription "On the lower abdomen, 4 B-cun inferior to the centre of the umbilicus, 2 B-cun lateral to the anterior median line. Note: ST29 is 4 B-cun inferior to ST25, 1 B-cun inferior to St28, 2 B-cun lateral to CV3." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.7-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Guilai" ;
    tara-ap:hasRelatedArtery UBERON:0001354 ;
    tara-ap:hasRelatedNerve ILX:0795002 ;
    tara-ap:hasRelatedVein UBERON:0007154 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0007118,
        ILX:0795285 ;
    tara-ap:hasSynonym "S 29",
        "Stomach 29" ;
    tara-ap:hasVasculatureInformation "Laterally, the inferior epigastric artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom ILX:0795002 ],
