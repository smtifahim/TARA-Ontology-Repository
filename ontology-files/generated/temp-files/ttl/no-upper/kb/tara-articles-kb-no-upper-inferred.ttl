        <https://orcid.org/0000-0003-4618-6544> ;
    OboInOwl:hasDbXref "SNOMEDCT_US:277521002",
        "UMLS:C0456814" ;
    OboInOwl:hasExactSynonym "Diminished energy",
        "Diminished motivation",
        "Diminished volitional state",
        "Lack of initiative",
        "Lack of motivation",
        "Lacking in initiative",
        "Lacks initiative" ;
    rdfs:subClassOf HP:0025780 .

HP:0000750 a owl:Class ;
    rdfs:label "Delayed speech and language development" ;
    IAO:0000115 "A degree of language development that is significantly below the norm for a child of a specified age." ;
    OboInOwl:hasAlternativeId "HP:0002116",
        "HP:0002117",
        "HP:0002336",
        "HP:0002399",
        "HP:0002498",
        "HP:0006936",
        "HP:0007004",
        "HP:0007127",
