                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000916 ] ],
        TARA:1926756 .

TARA:9968219 a owl:Class ;
    rdfs:label "GB 38" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 190. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "陽(阳)輔(辅)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasListedIndications "migraine, pain of the outer canthus, pain in the axillary region, scrofula, lumbar pain, pain in the chest, hypochondriac region and lateral aspect of the lower extremities, malaria." ;
    tara-ap:hasLocationalDescription "On the fibular aspect of the leg, anterior to the fibula, 4 B-cun proximal to the prominence of the lateral malleolus." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Yangfu" ;
    tara-ap:hasSpecialPointRole TARA:7315457 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001446,
        UBERON:0012291 ;
    tara-ap:hasSynonym "G 38",
        "Gallbladder 38" ;
    tara-ap:hasVasculatureInformation "The branches of the anterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
