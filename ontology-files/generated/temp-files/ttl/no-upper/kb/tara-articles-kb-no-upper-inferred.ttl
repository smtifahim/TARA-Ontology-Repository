UBERON:0003711 a owl:Class ;
    rdfs:label "brachiocephalic vein" ;
    IAO:0000115 "The left and right brachiocephalic veins in the upper chest are formed by the union of each corresponding internal jugular vein and subclavian vein. This is at the level of the sternoclavicular joint. These great vessels merge to form the superior vena cava. The brachiocephalic veins are the major veins returning blood to the superior vena cava." ;
    OboInOwl:hasDbXref "EHDAA2:0000182",
        "EHDAA:9868",
        "FMA:4723",
        "GAID:529",
        "MESH:D016121",
        "NCIT:C32816",
