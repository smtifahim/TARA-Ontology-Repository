    tara-kb:hasReportingPublicationID tara-kb:A-112625-849 ;
    tara-kb:hasSampleSizeDetails "Total sample size: 23; Male: 10, Female: 13" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: Disposable 1 inch 30-gauge needle
Quantity: Single point
Size: 1 cm depth
Location: Non-specific point on the chest wall (not a traditional acupuncture point)
Penetrating: Yes
Other details: Patients were given the impression they were receiving real acupuncture at all times.""" ;
