TARA:1717280 a owl:Class ;
    rdfs:label "Lower He-Sea Point of the Large Intestine" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Lower He-Sea Point of the the Large Intestine meridian. One of the five Shu Points, the He-Sea point signifies the confluence of rivers in the sea, where the meridian qi is the most flourishing. In addition, each of the six fu organs has another He-Sea point in the three yang meridians of the foot, known as the Lower He-Sea point. The Lower He-Sea points are mostly employed to treat the disorders of the six fu organs in clinic." ;
    tara-ap:hasSpecialPointRole TARA:7870889 ;
    rdfs:subClassOf TARA:4830205 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4830205 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:7870889 ] ) ] .

TARA:2003524 a owl:Class ;
    rdfs:label "Influential Point of Tendons" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Tendons can be employed to treat disorders of tendons. Yanglingquan (GB 34) is the Influential Point of tendons." ;
    tara-ap:hasSpecialPointRole TARA:4591653 ;
    rdfs:subClassOf TARA:7010544 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:4591653 ] ) ] .

TARA:2041266 a owl:Class ;
    rdfs:label "Xi-Cleft Point of the Yang Heel Vessel" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Xi-Cleft Point of the Yang Heel Vessel (an extra meridian). The Xi-Cleft Point is the site where the qi and blood of the meridian are deeply converged. The Xi-Cleft Point is used to treat acute disorders in the area supplied by its pertaining meridian and those of its pertaining zang or fu organ." ;
    tara-ap:hasSpecialPointRole TARA:1317876 ;
    rdfs:subClassOf TARA:4598552 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4598552 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:1317876 ] ) ] .

