TARA:6703917 a owl:Class ;
    rdfs:label "Disease or Condition (TCM)" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A specialized subclass of 'Disease or Condition' representing health impairments conceptualized, diagnosed, and classified according to the principles of Traditional Chinese Medicine. This class categorizes illnesses based on holistic disharmony, encompassing visceral organ patterns (Zang-Fu), channel theories, and pathogenic factors (e.g., Wind, Dampness), where the focus is on the body's overall functional pattern (Zheng) rather than isolated anatomical lesions."@en ;
    rdfs:subClassOf TARA:3448356 .

TARA:7233436 a owl:Class ;
    rdfs:label "Luozhen" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Sore neck, pain in the shoulder and arm." ;
    tara-ap:hasLocationalDescription "On the dorsum of the hand, between the second and third metacarpal bones, about 0.5 cun posterior to metacarpophalangeal joint." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch." ;
    tara-ap:hasSynonym "M-UE 24" ;
    rdfs:subClassOf TARA:3535998 .

TARA:7793286 a owl:Class ;
    rdfs:label "CV 1 (Male)" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 220. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002356 ;
    tara-ap:hasInnervationInformation "The branch of the perineal nerve." ;
    tara-ap:hasListedIndications "vaginitis, retention of urine, hemorrhoids, nocturnal emission, enuresis, irregular menstruation, mental disorder." ;
    tara-ap:hasLocationalDescription "In the perineal region, at the midpoint of the line connecting the anus with the posterior border of the scrotum in males and the posterior commissure of labium majoris in females. Note: CV 1 is located midway between the anus and the genital organ, with the subject lying on the side or in knee-chest position." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001245,
        UBERON:0001300,
        UBERON:0003133 ;
    tara-ap:hasSynonym "Conception Vessel 1 (Male)" ;
    tara-ap:hasVasculatureInformation "The branches of the perineal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003133 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002356 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
