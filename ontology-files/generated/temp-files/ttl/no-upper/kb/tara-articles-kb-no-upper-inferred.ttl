    tara-ap:hasChineseLabel "地五會(会)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasListedIndications "pain of the canthus, tinnitus, distending pain of the breast, swelling and pain of the dorsum of foot." ;
    tara-ap:hasLocationalDescription "On the dorsum of the foot, between the fourth and fifth metatarsal bones, in the depression proximal to the fourth metatarsophalangeal joint." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch." ;
    tara-ap:hasPinyinLabel "Diwuhui" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003653,
        UBERON:0003654,
        UBERON:0007759 ;
    tara-ap:hasSynonym "G 42",
        "Gallbladder 42" ;
    tara-ap:hasVasculatureInformation "The dorsal arterial and venous network of foot, the fourth dorsal metatarsal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
