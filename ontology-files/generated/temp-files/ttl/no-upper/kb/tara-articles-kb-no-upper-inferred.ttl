    tara-kb:hasMappedWesternCondition MONDO:0043555 ;
    tara-kb:hasNeedlingDetails """Zusanli: 1 1.2 cun
Changqiang: 0.8 1.0 cun""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1254 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1254 ;
    tara-kb:hasSampleSizeDetails """Total participants: 930
Acupuncture group: 480
Control group: 450""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used)" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation: lifting thrusting and left right twisting rotating repeatedly 3 5 times." ;
