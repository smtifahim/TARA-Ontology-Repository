TARA:1124682 a owl:Class ;
    rdfs:label "BL 17" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 108. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "膈兪(俞)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasInnervationInformation "The medial branches of the posterior rami of the seventh and eighth thoracic nerves; deeper, their lateral branches." ;
    tara-ap:hasListedIndications "vomiting, hiccup, belching, difficulty in swallowing, asthma, cough, spitting of blood, afternoon fever, night sweat, measles." ;
    tara-ap:hasLocationalDescription "In the upper back region, at the same level as the inferior border of the spinous process of the seventh thoracic vertebra (T7), 1.5 B-cun lateral to the posterior median line. Note: The inferior angle of the scapula is at the same level as the spinous process of the seventh thoracic vertebra." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5-0.7 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Geshu" ;
