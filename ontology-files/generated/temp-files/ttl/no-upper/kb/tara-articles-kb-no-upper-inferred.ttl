tara-kb:S-112625-1485 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1485" ;
    dc:title "Auricular Point Sticking Combined with Acupuncture in the Treatment of 40 Patients with Insomnia" ;
    tara-kb:hasAcupunctureProtocol """Auricular Point Sticking:
Main points: frontal earlobe insomnia point (earlobe 4 region), posterior earlobe insomnia point (behind the ear and opposite to earlobe 4 region), anterior auricular insomnia region (antitragus 2, 3 regions), posterior auricular insomnia regions (region behind the ear and opposite to antitragus 2, 3 regions)
Supplementary points: Shenmen, Heart, Liver, Kidney, Subcortex
Routine Acupuncture:
Main points: Baihui (DU20), Shenmen (HT7), Neiguan (PC6), Anmian (EX HN18)
Supplementary points: Sishencong (EX HNO1), Sanyinjiao (SP6), Zusanli (ST36), Tianshu (ST25), Zhongwan (RN12), Guanyuan (RN4), Taixi (K13), Taichong (LR3)""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group received routine acupuncture as their therapy." ;
    tara-kb:hasCountryOfStudy "Not specified" ;
