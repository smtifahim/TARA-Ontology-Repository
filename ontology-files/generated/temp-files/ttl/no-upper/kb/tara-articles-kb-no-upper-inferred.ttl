TARA:0220496 a owl:Class ;
    rdfs:label "SI 3" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 89. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "後(后)谿(溪)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003625 ;
    tara-ap:hasInnervationInformation "The dorsal branch derived from the ulnar nerve." ;
    tara-ap:hasListedIndications "pain and rigidity of the neck, tinnitus, deafness, sore throat, mania, malaria, acute lumbar sprain, night sweat, febrile diseases, contracture and numbness of the fingers, pain in the shoulder and elbow." ;
    tara-ap:hasLocationalDescription "On the little finger, ulnar to the distal phalanx, 0.1 f-cun proximal-medial to the ulnar corner of the little fingernail, at the intersection of the vertical line of ulnar border of the nail and horizontal line of the base of the little fingernail." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Houxi" ;
    tara-ap:hasRelatedArtery UBERON:0006146 ;
    tara-ap:hasRelatedNerve ILX:0797491 ;
    tara-ap:hasRelatedVein UBERON:0004562 ;
    tara-ap:hasSpecialPointRole TARA:6705086,
        TARA:9493899 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004300,
        UBERON:0011277 ;
    tara-ap:hasSynonym "Small Intestine 3" ;
    tara-ap:hasVasculatureInformation "The dorsal digital artery and vein, the dorsal venous network of the hand." ;
    tara-ap:isLocatedOnMeridian TARA:9093316 ;
