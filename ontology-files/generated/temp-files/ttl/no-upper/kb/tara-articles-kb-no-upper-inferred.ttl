TARA:9268434 a owl:Class ;
    rdfs:label "Qiuhou" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Eye diseases." ;
    tara-ap:hasLocationalDescription "At the junction of the lateral 1/4 and the medial 3/4 of the infraorbital margin." ;
    tara-ap:hasMethodDescription "Push the eyeball upward gently, then puncture perpendicularly 0.5-1.2 inches along the orbital margin slowly without movements of lifting, thrusting, twisting and rotating." ;
    tara-ap:hasSynonym "EX-HN 7",
        "M-HN 8" ;
    rdfs:subClassOf TARA:3535998 .

TARA:9406515 a owl:Class ;
    rdfs:label "Influential Point of Qi" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Qi can be employed to treat disorders of the Zang organs. Tanzhong (CV 17) is the Influential Point of Qi." ;
    tara-ap:hasSpecialPointRole TARA:0521663 ;
    rdfs:subClassOf TARA:7010544 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:0521663 ] ) ] .

TARA:9657915 a owl:Class ;
    rdfs:label "Lower He-Sea Point of the Bladder" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Lower He-Sea Point of the the Bladder meridian. One of the five Shu Points, the He-Sea point signifies the confluence of rivers in the sea, where the meridian qi is the most flourishing. In addition, each of the six fu organs has another He-Sea point in the three yang meridians of the foot, known as the Lower He-Sea point. The Lower He-Sea points are mostly employed to treat the disorders of the six fu organs in clinic." ;
    tara-ap:hasSpecialPointRole TARA:4568236 ;
    rdfs:subClassOf TARA:4830205 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4830205 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:4568236 ] ) ] .

TARA:9695467 a owl:Class ;
    rdfs:label "Crossing Point Role" ;
    rdfs:subClassOf TARA:0886544 .

TARA:9719785 a owl:Class ;
    rdfs:label "Influential Point of Bone" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Bone can be employed to treat disorders of the bones. Dazhu (BL 11) is the Influential Point of bone." ;
    tara-ap:hasSpecialPointRole TARA:3049719 ;
    rdfs:subClassOf TARA:7010544 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:3049719 ] ) ] .

TARA:9763906 a owl:Class ;
    rdfs:label "Influential Point of Blood" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Blood can be employed to treat disorders of blood. Geshu (BL 17) is the Influential Point of blood." ;
    tara-ap:hasSpecialPointRole TARA:3965890 ;
    rdfs:subClassOf TARA:7010544 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:3965890 ] ) ] .

TARA:9924428 a owl:Class ;
    rdfs:label "Influential Point of the Marrow" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Marrow can be employed to treat disorders of the marrow. Xuanzhong (GB 39) is the Influential Point of marrow." ;
    tara-ap:hasSpecialPointRole TARA:5049050 ;
    rdfs:subClassOf TARA:7010544 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:5049050 ] ) ] .

tara-ap:hasRelatedArtery a owl:AnnotationProperty ;
    rdfs:label "Related Artery"@en ;
    IAO:0000112 "'LU 1' tara:hasRelatedArtery 'Axillary Artery'."@en ;
    dcterms:description "An annotation property that records a specific artery occupying an Acupoint's location, as a simple textual/IRI annotation. Corresponds to the object property tara-op:hasRelatedArtery, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedArtery ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedVasculature .

tara-ap:hasRelatedNerve a owl:AnnotationProperty ;
    rdfs:label "Related Nerve"@en ;
    IAO:0000112 "'LU 1' tara:hasRelatedNerve 'Intermediate Supraclavicular Nerve'."@en ;
    dcterms:description "An annotation property that records a specific nerve occupying an Acupoint's location, as a simple textual/IRI annotation. Corresponds to the object property tara-op:hasRelatedNerve, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedNerve ;
    dcterms:requires tara-ap:hasInnervationInformation ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedInnervation .

tara-ap:hasRelatedVein a owl:AnnotationProperty ;
    rdfs:label "Related Vein"@en ;
    IAO:0000112 "'LU 1' tara:hasRelatedVein 'Axillary Vein'."@en ;
    dcterms:description "An annotation property that records a specific vein occupying an Acupoint's location, as a simple textual/IRI annotation. Corresponds to the object property tara-op:hasRelatedVein, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedVein ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedVasculature .

tara-ap:hasSpecificReferenceLocation a owl:AnnotationProperty ;
    rdfs:label "Specific Reference Location"@en ;
    IAO:0000112 """The acupoint 'LU 1' has three specific reference locations within the general surface of 'Anterior Thoracic Region':
'LU 1' tara:hasSpecificReferenceLocation 'Infraclavicular Fossa' .
'LU 1' tara:hasSpecificReferenceLocation 'First Intercostal Space' .
'LU 1' tara:hasSpecificReferenceLocation  'Anterior Median Line' ."""@en ;
    dcterms:description "An annotation property that records the specific anatomical landmarks within the general surface region of an Acupoint, as simple textual/IRI annotations. Corresponds to the object property tara-op:hasSpecificReferenceLocation, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasSpecificReferenceLocation ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasGeneralSurfaceLocation .

