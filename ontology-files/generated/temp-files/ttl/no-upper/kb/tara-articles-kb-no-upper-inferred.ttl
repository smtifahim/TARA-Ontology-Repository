TARA:9534465 a owl:Class ;
    rdfs:label "Taiyang" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasListedIndications "Headache, eye diseases, deviation of the eyes and mouth." ;
    tara-ap:hasLocationalDescription "In the depression about one finger breadth posterior to the midpoint between the lateral end of the eyebrow and the outer canthus." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch, or prick to cause bleeding." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0006726,
        UBERON:0010163 ;
    tara-ap:hasSynonym "EX-HN 5",
        "M-HN 9" ;
