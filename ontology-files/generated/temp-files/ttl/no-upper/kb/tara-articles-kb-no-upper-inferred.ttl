tara-kb:S-112625-1060 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1060" ;
    dc:title "A systematic review and meta-analysis of Baihui (GV20)-based scalp acupuncture in experimental ischemic stroke" ;
    tara-kb:hasAcupunctureProtocol """Baihui (GV20): Located at the intersection of the line connecting the apexes of the two auricles and the median line of the head, 7 cun directly above the posterior hairline and 5 cun behind the anterior hairline.
Taiyang (EX-HN 5): Used in scalp penetration needling from Baihui (GV20).
Qubin (GB7): Used in scalp penetration needling from Baihui (GV20).
Shuigou: Used in combination with Baihui (GV20).
Other acupoints: Used in various combinations with Baihui (GV20), but specific points not detailed in the text.""" ;
    tara-kb:hasClinicalTrialType "Systematic Review and Meta-Analysis" ;
    tara-kb:hasControlGroupsDetails "The control group used in the studies was a middle cerebral artery occlusion (MCAO) group, where ischemia was induced without the application of scalp acupuncture." ;
    tara-kb:hasCountryOfStudy "Not specified (the paper does not explicitly state the country where the study was conducted)" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasMappedWesternCondition MONDO:1060198 ;
    tara-kb:hasNeedlingDetails "Not specified" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1060 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1060 ;
    tara-kb:hasSampleSizeDetails """Total sample size: 1816 animals
Infarct volume (IV): 478 rats
Neurological function score (NFS): 1736 animals
Permanent MCAO models: 681 animals
Temporary MCAO models: 1135 animals""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (the paper does not mention sham acupuncture details)" ;
    tara-kb:hasStimulationTypeDetails "The primary stimulation method was electroacupuncture (EA), with 46 out of 54 studies using EA. Eight studies used manual acupuncture (MA). No other forms of stimulation like thermal or laser were mentioned. No specific sensations were sought during stimulation." ;
    tara-kb:hasStudiedTCMCondition "Stroke" ;
    tara-kb:hasStudiedWesternCondition "Ischemic stroke" ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcomes: Infarct size (IV), Neurobehavioral outcome (NFS)
Secondary outcomes: Not specified""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: Varies (e.g., 5 minutes, 1 hour, 30 minutes)
Retention time: Varies (e.g., 30 minutes)""" ;
    tara-kb:hasTreatmentFrequency """Daily: "Acupuncture 30 min/d after occlusion until sacrifice"
Every 12 hours for 6 times: "Acupuncture 30 min after occlusion 5 h repeated in every 12 h interval, total 6 times"
For 3 days: "Acupuncture 30 min after occlusion 5 min for 3 days"
For 7 days: "Acupuncture 30 min after occlusion 1 h for 7 days"
For 21 days: "Acupuncture 30 min after reperfusion 90 min for 21 days"
For 2 weeks: "Acupuncture after occlusion 30 min (10:00 AM) qd for 2 w\"""" .

