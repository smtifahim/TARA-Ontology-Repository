        "EHDAA:8275",
        "EMAPA:17413",
        "GAID:52",
        "MA:0000033",
        "MESH:A01.378.800",
        "MESH:D001132",
        "OpenCyc:Mx4rvVjp5ZwpEbGdrcN5Y29ycA",
        "VHOG:0000339",
        "Wikipedia:Arm",
        "http://en.wikipedia.org/wiki/Arm" ;
    OboInOwl:hasRelatedSynonym "brachium",
        "upper extremity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001460 ],
