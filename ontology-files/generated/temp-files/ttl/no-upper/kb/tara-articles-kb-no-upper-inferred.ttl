    rdfs:label "Participants Score" ;
    IAO:0000112 "e.g., a score of 2 when age, sex, and enrollment/dropout flow are all reported, or 0 when none of this information is given."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "Category A: Study Foundation & Background Metrics (CONSORT). The structural quality score grading the transparency of reporting baseline participant demographics and flow data." ;
    tara-ap:hasCompactURI "tara-kb:hasParticipantsScore" ;
    rdfs:domain TARA:2825659 ;
    rdfs:range TARA:5972061 ;
    rdfs:subPropertyOf tara-kb:hasStudyFoundationAndBackgroundMetrics ;
    skos:altLabel "Participants_Score" .

