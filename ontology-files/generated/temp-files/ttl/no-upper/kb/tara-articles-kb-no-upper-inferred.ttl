    OboInOwl:hasDbXref "UMLS:C1535950" ;
    OboInOwl:hasExactSynonym "GI inflammation",
        "Gastrointestinal inflammation" ;
    rdfs:subClassOf HP:0012649,
        HP:0012719 .

HP:0005268 a owl:Class ;
    rdfs:label "Miscarriage" ;
    IAO:0000115 "A pregnancy that ends at a stage in which the fetus is incapable of surviving on its own, defined as the spontaneous loss of a fetus before the 22th week of pregnancy." ;
    OboInOwl:hasDbXref "SNOMEDCT_US:17369002",
        "UMLS:C0000786" ;
    OboInOwl:hasExactSynonym "Early fetal demise",
        "Early foetal demise",
        "Spontaneous abortion" ;
    rdfs:comment "The age at which fetal demise is legally classified asa a miscarriage varies between countries with the US being 20 gestational weeks and the UK being 24 gestational weeks. The HPO chooses the average of these age ranges." ;
    rdfs:subClassOf HP:0034241 .

HP:0006986 a owl:Class ;
    rdfs:label "Upper limb spasticity" ;
    OboInOwl:hasDbXref "SNOMEDCT_US:394680009",
        "UMLS:C1273957" ;
    OboInOwl:hasExactSynonym "Spastic upper extremities",
        "Spastic upper extremity",
        "Spastic upper limb",
        "Spastic upper limbs",
        "Spasticity in upper extremities",
        "Spasticity in upper extremity",
        "Spasticity in upper limb",
        "Spasticity in upper limbs",
        "Spasticity of upper extremities",
        "Spasticity of upper extremity",
        "Spasticity of upper limb",
        "Spasticity of upper limbs",
        "Uncontrollable movement in upper arms",
        "Upper extremities spasticity",
        "Upper extremity spasticity" ;
    rdfs:subClassOf HP:0034353 .

HP:0007024 a owl:Class ;
    rdfs:label "Pseudobulbar paralysis" ;
    IAO:0000115 "Bilateral impairment of the function of the cranial nerves 9-12, which control musculature involved in eating, swallowing, and speech. Pseudobulbar paralysis is characterized clinically by dysarthria, dysphonia, and dysphagia with bifacial paralysis, and may be accompanied by Pseudobulbar behavioral symptoms such as enforced crying and laughing." ;
    OboInOwl:hasAlternativeId "HP:0002201",
        "HP:0006819" ;
    OboInOwl:hasDbXref "SNOMEDCT_US:7379000",
        "UMLS:C0033790" ;
    OboInOwl:hasExactSynonym "Pseudobulbar palsy",
        "Pseudobulbar syndrome" ;
    rdfs:subClassOf HP:0001260,
        HP:0001618,
        HP:0002015,
        HP:0002200,
        HP:0003470 .

HP:0007313 a owl:Class ;
    rdfs:label "Cerebral degeneration" ;
    OboInOwl:hasAlternativeId "HP:0006874" ;
