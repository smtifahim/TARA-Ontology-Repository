MONDO:0008487 a owl:Class ;
    rdfs:label "polycystic ovary syndrome" ;
    IAO:0000115 "A disorder that manifests as multiple cysts on the ovaries. It results in hormonal imbalances and leads to irregular and abnormal menstrual periods, excess growth of hair, acne eruptions and obesity." ;
