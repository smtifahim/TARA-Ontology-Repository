TARA:7690229 a owl:Class ;
    rdfs:label "GV 23" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 215. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "上星" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The branch of the frontal nerve." ;
    tara-ap:hasListedIndications "headache, ophthalmalgia, epistaxis, rhinorrhea, mental disorder." ;
    tara-ap:hasLocationalDescription "On the head, 1 B-cun superior to the anterior hairline, on the anterior median line." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch or prick to cause bleeding. This point is prohibited in infants with metopism. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Shangxing" ;
    tara-ap:hasSpecificReferenceLocation ILX:0795285,
        ILX:0795292 ;
    tara-ap:hasSynonym "Du 23",
        "Governor Vessel 23",
        "VG 23" ;
    tara-ap:hasVasculatureInformation "The branches of the frontal artery and vein, and the branches of the superficial temporal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
