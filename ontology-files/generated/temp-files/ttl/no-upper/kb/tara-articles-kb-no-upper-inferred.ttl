UBERON:0008231 a owl:Class ;
    rdfs:label "dorsal thoracic segment of trunk" ;
    IAO:0000115 "Subdivision of thorax, which in humans is the posterior part of the thorax and is demarcated from the chest by the external surface of the posterolateral part of the rib cage and the anterior surface of the thoracic vertebral column; together with the chest, it constitutes the thorax." ;
    OboInOwl:hasDbXref "EMAPA:37234",
