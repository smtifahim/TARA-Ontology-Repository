    IAO:0000232 "this class represents a series of phalanges plus a metapodial element plus associated soft tissues. Instances of this class typically do not form a distinct unit." ;
    OboInOwl:hasBroadSynonym "digit 2",
        "digit 2 ( phalanges plus metapodial) plus soft tissue" ;
    OboInOwl:hasExactSynonym "digit 2 digitopodial subdivision",
        "digit 2 ray",
        "digit II plus metapodial segment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom UBERON:0006049 ],
        UBERON:5002544 .

