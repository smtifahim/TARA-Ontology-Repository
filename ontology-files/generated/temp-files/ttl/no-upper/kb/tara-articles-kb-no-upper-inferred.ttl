                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795314 ] ],
        TARA:0995552,
        TARA:6484209 .

TARA:5629511 a owl:Class ;
    rdfs:label "Spleen Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Spleen Meridian of Foot-Taiyin (SP), which consists of 21 standardized acupoints beginning at SP 1 (Yinbai) on the medial side of the great toe near the corner of the nail, traveling up along the medial aspect of the leg and continuing up the abdomen and chest, and ending at SP 21 (Dabao) on the lateral thorax in the sixth intercostal space on the midaxillary line." ;
    tara-ap:hasSynonym "Acupoint of Spleen Meridian",
        "Acupoint of the Spleen Meridian",
        "Acupoint of the spleen meridian of foot-taiyin",
        "Acupuncture point of the spleen meridian",
        "Acupuncture point of the spleen meridian of foot-taiyin",
        "SP Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:4167850 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:4167850 ] ) ] .

TARA:5894876 a owl:Class ;
    rdfs:label "TE 14" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 164. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "肩髎(髎)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001421 ;
    tara-ap:hasInnervationInformation "The muscular branch of the axillary nerve." ;
    tara-ap:hasListedIndications "pain and motor impairment of the shoulder and upper arm." ;
    tara-ap:hasLocationalDescription "On the shoulder girdle, in the depression between the acromial angle and the greater tubercle of the humerus. Note: When the elbow is flexed and the arm is abducted, two depressions appear respectively anterior and posterior to the acromion. LI15 is located in the anterior one, deeper than the posterior one, in which tE14 is located." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.7-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Jianliao" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002497,
        UBERON:0011187 ;
    tara-ap:hasSynonym "SJ 14",
        "San Jiao 14",
        "TB 14",
        "TH 14",
        "TW 14",
        "Triple Burner 14",
        "Triple Energizer 14",
        "Triple Heater 14",
        "Triple Warmer 14" ;
    tara-ap:hasVasculatureInformation "The muscular branch of the posterior circumflex humeral artery." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001421 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002497 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0011187 ] ],
        TARA:5361067 .

TARA:6019290 a owl:Class ;
    rdfs:label "ST 41" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 66. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "解谿(溪)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0004454 ;
    tara-ap:hasInnervationInformation "The superficial and deep peroneal nerves." ;
    tara-ap:hasListedIndications "pain of the ankle joint, muscular atrophy, motor impairment, pain and paralysis of the lower extremities, epilepsy, headache, dizziness and vertigo, abdominal distension, constipation." ;
    tara-ap:hasLocationalDescription "On the anterior aspect of the ankle, in the depression at the centre of the front surface of the ankle joint, between the tendons of extensor hallucis longus and extensor digitorum longus. Note: ST41 is located between two tendons on the dorsum of the foot which are more distinct when the ankle is in dorsiflexion, and is at the midpoint of the line connecting the prominences of the lateral malleolus and the medial malleolus." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Jiexi" ;
    tara-ap:hasRelatedArtery UBERON:0001537 ;
    tara-ap:hasRelatedNerve UBERON:0035207,
        UBERON:0035526 ;
    tara-ap:hasRelatedVein UBERON:0001545 ;
    tara-ap:hasSpecialPointRole TARA:7315457 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0012076,
        UBERON:0012291,
        ILX:0795503,
        ILX:0795504 ;
    tara-ap:hasSynonym "S 41",
        "Stomach 41" ;
    tara-ap:hasVasculatureInformation "The anterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom UBERON:0035207 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0012076 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795504 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:1758929 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedArtery ;
            owl:someValuesFrom UBERON:0001537 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0012291 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
