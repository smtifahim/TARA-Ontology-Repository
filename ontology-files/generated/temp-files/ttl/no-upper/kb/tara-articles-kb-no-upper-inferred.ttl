    tara-ap:hasChineseLabel "三焦兪(俞)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0005462 ;
    tara-ap:hasInnervationInformation "The lateral cutaneous branch of the posterior ramus of the tenth thoracic nerve; deeper, the lateral branch of the posterior ramus of the first lumbar nerve." ;
    tara-ap:hasListedIndications "borborygmus, abdominal distension, indigestion, vomiting, diarrhea, dysentery, edema, pain and stiffness of the lower back." ;
    tara-ap:hasLocationalDescription "In the lumbar region, at the same level as the inferior border of the spinous process of the first lumbar vertebra (L1), 1.5 B-cun lateral to the posterior median line." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Sanjiaoshu" ;
    tara-ap:hasSpecialPointRole TARA:4567959 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004617,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 22",
        "Back-Shu Point of Triple Energizer",
        "Bladder 22",
        "UB 22",
        "Urinary Bladder 22" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the first lumber artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:0109829 ],
