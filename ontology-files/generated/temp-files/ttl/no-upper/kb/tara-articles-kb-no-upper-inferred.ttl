tara-kb:S-112625-903 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-903" ;
    dc:title "Auricular acupuncture for insomnia: a systematic review" ;
    tara-kb:hasAcupunctureProtocol "Not specified (the paper does not provide specific needle locations or related acupoints used in the studies reviewed)" ;
    tara-kb:hasClinicalTrialType "Systematic Review of Randomized Controlled Trials (RCTs)" ;
    tara-kb:hasControlGroupsDetails """Placebo AA: Used in three studies to compare with magnetic pellets AA and in one study to compare with needle AA.
Conventional pharmacological drugs: Estazolam and diazepam were used as control interventions in four studies.
No treatment: Used in two studies as a control for thumbtack needle AA.
General care: Used in one study as a control for Semen Vaccariae (SV) AA.""" ;
    tara-kb:hasCountryOfStudy "China, Korea, USA" ;
    tara-kb:hasDatasetLink "Not specified (the paper does not mention the availability of or provide a link to related datasets)" ;
    tara-kb:hasListedAcupoints "Not specified" ;
    tara-kb:hasMappedWesternCondition MONDO:0013600 ;
    tara-kb:hasNeedlingDetails "Not specified" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-903 ;
