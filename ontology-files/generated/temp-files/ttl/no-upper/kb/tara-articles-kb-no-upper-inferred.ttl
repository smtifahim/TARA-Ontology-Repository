tara-kb:S-112625-144 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-144" ;
    dc:title "Applicability of Press Needles to a Double-blind Trial A Randomized, Double-blind, Placebo-controlled Trial" ;
    tara-kb:hasAcupunctureProtocol "BL23 (left side)" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Phase 1: Placebo group (n = 45) received a device identical to the press needle but without the needle element.
Phase 2: Local anesthesia (LA) group received a topical anesthetic patch before the insertion of the press needle to block peripheral nerve fibers.""" ;
    tara-kb:hasCountryOfStudy "Japan" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "BL 23" ;
    tara-kb:hasListedAcupointsMapped TARA:0992296 ;
