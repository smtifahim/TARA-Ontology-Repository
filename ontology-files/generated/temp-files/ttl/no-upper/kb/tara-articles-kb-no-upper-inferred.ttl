    tara-kb:hasListedAcupointsUnmappable "Ashi points" ;
    tara-kb:hasMappedWesternCondition HP:0005086 ;
    tara-kb:hasNeedlingDetails """TCA: 0.2-1.2 cun depending on tolerance
Sham: 0.2-0.5 cun deep""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-76 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-76 ;
    tara-kb:hasSampleSizeDetails """Total participants analyzed: 527 (455 treatment + 72 controls)
Waiting list: 72
TCA: 160
Sham: 320""" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: Thinner, shorter needles compared to TCA
Quantity: Not specified
Size: 36 gauge, 1.0 cun
Location: Nonmeridian points outside relevant meridians
Penetrating or non-penetrating: Penetrating but shallow (0.2-0.5 cun deep)
Other details: Minimal stimulation; TENS unit used with specific settings""" ;
    tara-kb:hasStimulationTypeDetails "Electrical stimulation (electroacupuncture) was used for both TCA and sham acupuncture. For TCA, a dense disperse wave impulse at 50 Hz was used, with voltage increased to maximal tolerance. For sham, a 40 Hz adjustable wave was used until the patient could feel it, then immediately turned off." ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not provide a TCM-specific term for the condition)" ;
    tara-kb:hasStudiedWesternCondition "Knee Osteoarthritis" ;
    tara-kb:hasStudyFindings "No" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures:
Joint-Specific Multidimensional Assessment of Pain (J-MAP)
Western Ontario and McMaster Universities Osteoarthritis Index (WOMAC)
Satisfaction scores
Secondary outcome measures:
WOMAC function subscale
Short-Form 12 (SF-12) health survey
SF-12 physical component summary and mental component summary scores
10-cm VAS for pain
Range of motion (ROM)
Timed Up and Go Test
Proportion of patients achieving at least 20%, 50%, and 70% improvement in WOMAC scores""" ;
    tara-kb:hasTreatmentDuration """Duration of treatment period: 6 weeks, with 2 sessions per week
Duration of each acupuncture session: 20 minutes
Duration needles were left in place during a session: 20 minutes""" ;
    tara-kb:hasTreatmentFrequency "Twice weekly for 6 weeks" .

tara-kb:S-112625-760 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-760" ;
    dc:title "A randomised trial of electro-acupuncture for arthralgia related to aromatase inhibitor use" ;
    tara-kb:hasAcupunctureProtocol """Local points: At least four points around the joint with the most pain.
Distant points: At least four points to address constitutional symptoms such as depression/anxiety and fatigue.
Sham acupuncture points: Non-acupuncture points at least 5 cm from the joint where pain was perceived to be maximal.
Specific acupuncture points or areas: Not specified.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Waitlist Control (WLC): Participants did not receive any intervention during the study period, serving as the "usual care" group.
Sham Acupuncture (SA): Participants received sham acupuncture using non-penetrating needles at non-traditional points without electro-stimulation.""" ;
    tara-kb:hasCountryOfStudy "United States" ;
    tara-kb:hasDatasetLink "http://dx.doi.org/ 10.1016/j.ejca.2013.09.022" ;
