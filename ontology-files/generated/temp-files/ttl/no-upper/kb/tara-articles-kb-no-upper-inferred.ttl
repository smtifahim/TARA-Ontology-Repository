TARA:8607646 a owl:Class ;
    rdfs:label "GV 12" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 209. https://iris.who.int/handle/10665/353407",
