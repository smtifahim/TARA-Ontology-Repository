                    owl:someValuesFrom UBERON:0000979 ] ],
        TARA:0739106,
        TARA:6993030 .

TARA:1698911 a owl:Class ;
    rdfs:label "TE 8" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 161. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "三陽(阳)絡(络)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002386 ;
    tara-ap:hasListedIndications "deafness, sudden hoarseness of the voice, pain in the chest and hypochondriac region, pain in the hand and arm, toothache." ;
    tara-ap:hasLocationalDescription "On the posterior aspect of the forearm, midpoint of the interosseous space between the radius and the ulna, 4 B-cun proximal to the dorsal wrist crease. Note: At the junction of the upper two thirds and lower one third of the line connecting tE4 with the tip of the elbow." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Sanyangluo" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001423,
        UBERON:0001424,
        UBERON:0001461,
        ILX:0795333 ;
    tara-ap:hasSynonym "SJ 8",
        "San Jiao 8",
        "TB 8",
        "TH 8",
        "TW 8",
        "Triple Burner 8",
        "Triple Energizer 8",
        "Triple Heater 8",
        "Triple Warmer 8" ;
    tara-ap:hasVasculatureInformation "The posterior antebrachial interosseous artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
