        "UB 59",
        "Urinary Bladder 59" ;
    tara-ap:hasVasculatureInformation "The small saphenous vein; deeper, the terminal branch of the peroneal artery." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
