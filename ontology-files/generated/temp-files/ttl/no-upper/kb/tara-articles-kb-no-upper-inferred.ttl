UBERON:0036295 a owl:Class ;
    rdfs:label "renal pelvis/ureter" ;
    IAO:0000115 "The upper tract of the renal system. The renal pelvis is the large cavity in the middle of each kidney. Urine drains from each kidney through a long tube called the ureter, into the bladder, where it is stored until it is passed from the body through the urethra." ;
    OboInOwl:hasDbXref "NCIT:C54419" ;
    OboInOwl:hasExactSynonym "renal pelvis and ureter",
        "renal pelvis plus ureter" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0011143 ],
        UBERON:0000477 .

