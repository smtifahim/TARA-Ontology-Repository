ILX:0795319 a owl:Class ;
    rdfs:label "scapular region" ;
    IAO:0000115 "The scapular region refers to the area on the posterior thoracic wall corresponding to the location of the scapula (shoulder blade). It encompasses the structures overlying and surrounding the scapula, including associated muscles such as the trapezius, deltoid, and rotator cuff muscles." ;
    isPartOf: UBERON:0001421,
        UBERON:0008785 ;
    ILX:0777130 "https://www.ncbi.nlm.nih.gov/books/NBK531475/#:~:text=The%20scapula%20forms%20the%20posterior,%2C%20teres%20minor%2C%20and%20infraspinatus." ;
    ilxtr:hasExistingId FMA:25200,
