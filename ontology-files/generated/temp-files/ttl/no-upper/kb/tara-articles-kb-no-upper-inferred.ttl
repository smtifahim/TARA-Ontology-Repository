tara-kb:S-112625-1254 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1254" ;
    dc:title "Swift Needling of Zusanli and Changqiang in Treating Infantile Diarrhea" ;
    tara-kb:hasAcupunctureProtocol """Zusanli (ST 36): Punctured bilaterally, needle inserted perpendicularly 1 1.2 cun, lifting thrusting and left right twisting rotating repeatedly 3 5 times.
Changqiang (DU 1): Puncture conducted upward 0.8 1.0 cun with the needle tip slanting, patient in kneeling prostrate position.
Duiduan (DU 27), Suliao (DU 25), and Chengjiang (RN 24): Used for bloodletting in cases of vomiting.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group consisted of 450 cases and received conventional medical treatment including medications such as gentamicin, haloperidol, SMZ Co., biofermin, fluid enzyme, vitamin B, or emol injection, and normal saline for mild dehydration." ;
    tara-kb:hasCountryOfStudy "Not specified" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "ST 36, DU 1, DU 27, DU 25, RN 24" ;
