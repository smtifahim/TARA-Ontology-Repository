UBERON:0001173 a owl:Class ;
    rdfs:label "biliary tree" ;
    IAO:0000115 "A complex network of conduits that begins with the canals of Hering (intralobar bile duct) and progressively merges into a system of interlobular, septal, and major ducts which then coalesce to form the extrahepatic bile ducts, which finally deliver bile to the intestine, and in some species to the gallbladder." ;
    OboInOwl:hasDbXref "AAO:0011020",
        "EMAPA:35172",
        "FMA:14665",
        "MESH:D001659",
        "SCTID:181267003",
        "UMLS:C0005423",
        "Wikipedia:Biliary_tract",
        "XAO:0000455" ;
    OboInOwl:hasRelatedSynonym "biliary tract" ;
    rdfs:comment "The path in many species is as follows: Bile canaliculi -> Canals of Hering (intralobar bile duct) -> interlobular bile ducts -> intrahepatic bile ducts -> left and right hepatic ducts merge to form -> common hepatic duct *exits liver* and joins -> cystic duct (from gall bladder) forming -> common bile duct -> joins with pancreatic duct -> forming ampulla of Vater -> enters duodenum [WP]" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002294 ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom UBERON:0001246 ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom UBERON:0001282 ],
        [ a owl:Restriction ;
            owl:onProperty BFO:0000051 ;
            owl:someValuesFrom UBERON:0003703 ],
        UBERON:0004119,
        UBERON:0013765 .

