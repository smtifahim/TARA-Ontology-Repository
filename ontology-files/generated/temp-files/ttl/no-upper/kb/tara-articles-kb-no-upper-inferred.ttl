    tara-ap:hasLocationalDescription "On the head, 0.5 B-cun superior to the anterior hairline, 3 B-cun lateral to the anterior median line. Note: GB13 is at the junction of the medial two thirds and lateral one third of the curved line from gV24 to St8." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Benshen" ;
    tara-ap:hasSpecificReferenceLocation ILX:0795285,
        ILX:0795292 ;
    tara-ap:hasSynonym "G 13",
        "Gallbladder 13" ;
    tara-ap:hasVasculatureInformation "The frontal branches of the superficial temporal artery and vein, and the lateral branches of the frontal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
