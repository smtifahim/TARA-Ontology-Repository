    tara-ap:hasRelatedVein UBERON:0001659,
        UBERON:0001660 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002500,
        ILX:0795291 ;
    tara-ap:hasSynonym "S 7",
        "Stomach 7" ;
    tara-ap:hasVasculatureInformation "Superficially, the transverse facial artery and vein; in the deepest layer, the maxillary artery and maxillary vein." ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
