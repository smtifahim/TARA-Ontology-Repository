TARA:9128934 a owl:Class ;
    rdfs:label "BL 30" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 114. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "白環(环)兪(俞)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0005473 ;
    tara-ap:hasInnervationInformation "The lateral branches of the posterior rami of the third and fourth sacral nerves, the inferior gluteal nerve." ;
    tara-ap:hasListedIndications "enuresis, pain due to hernia, morbid leukorrhea, irregular menstruation, cold sensation and pain of the lower back, dysuria, constipation, tenesmus, prolapse of the rectum." ;
    tara-ap:hasLocationalDescription "In the sacral region, at the same level as the fourth posterior sacral foramen, 1.5 B-cun lateral to the median sacral crest. Note: 1.5 B-cun lateral to the sacral hiatus, at the same level as BL34." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches." ;
    tara-ap:hasPinyinLabel "Baihuanshu" ;
    tara-ap:hasSpecificReferenceLocation ILX:0741680,
        ILX:0741717,
        ILX:0795316 ;
    tara-ap:hasSynonym "B 30",
        "Bladder 30",
