tara-kb:S-112625-343 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-343" ;
    dc:title "Acupuncture versus topiramate in chronic migraine prophylaxis: A randomized clinical trial" ;
    tara-kb:hasAcupunctureProtocol "Bilateral Cuanzhu (BL-2); Bilateral Fengchi (GB-20); Bilateral Taiyang (EX-HN-5); Midline Yintang (Ex-HN-3). Selected based on their location within the distribution of trigeminal and cervical dermatomes related to the trigeminal sensory pathway." ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "Not applicable (the study used an active comparator design with topiramate as the comparison group, but no sham control or traditional control group was used)" ;
