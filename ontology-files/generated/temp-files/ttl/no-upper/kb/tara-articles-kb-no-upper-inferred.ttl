UBERON:0016416 a owl:Class ;
    rdfs:label "anterior chest" ;
    IAO:0000115 "Subdivision of thorax which is anterior to the plane of the posterior boundary of the middle mediastinum." ;
    OboInOwl:hasDbXref "FMA:24816",
        "SCTID:182331006" ;
    OboInOwl:hasExactSynonym "anterior thoracic region",
        "front of chest",
        "ventral chest" ;
