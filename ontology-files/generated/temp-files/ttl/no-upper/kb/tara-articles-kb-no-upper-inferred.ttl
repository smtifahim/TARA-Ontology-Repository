UBERON:0001561 a owl:Class ;
    rdfs:label "subcostal artery" ;
    IAO:0000115 "An artery that runs along the bottom of the lowest rib. They constitute the lowest pair of branches derived from the thoracic aorta, and are in series with the intercostal arteries. Each passes along the lower border of the twelfth rib behind the kidney and in front of the Quadratus lumborum muscle, and is accompanied by the twelfth thoracic nerve. It then pierces the posterior aponeurosis of the Transversus abdominis, and, passing forward between this muscle and the Obliquus internus, anastomoses with the superior epigastric, lower intercostal, and lumbar arteries. Each subcostal artery gives off a posterior branch which has a similar distribution to the posterior ramus of an intercostal artery. [WP,unvetted]." ;
    OboInOwl:hasDbXref "EMAPA:19097",
        "FMA:4613",
        "MA:0002048",
        "NCIT:C53000",
        "SCTID:244243008",
        "UMLS:C0226293",
        "Wikipedia:Subcostal_artery" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty RO:0002170 ;
            owl:someValuesFrom UBERON:0002345 ],
