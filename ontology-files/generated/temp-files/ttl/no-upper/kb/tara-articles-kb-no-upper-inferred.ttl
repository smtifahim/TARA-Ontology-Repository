        "TW 7",
        "Triple Burner 7",
        "Triple Energizer 7",
        "Triple Heater 7",
        "Triple Warmer 7" ;
    tara-ap:hasVasculatureInformation "The posterior antebrachial interosseous artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
