tara-ap:foafAnnotationProperty a owl:AnnotationProperty ;
    rdfs:label "foaf:topAnnotationProperty" ;
    dcterms:description "An annotation property to group all foaf: annotation properties specific to TARA Acupoints Ontology." .

tara-ap:hasRelatedVasculature a owl:AnnotationProperty ;
    rdfs:label "Related Vasculature"@en ;
    IAO:0000112 "Example: 'LU 1' tara:hasRelatedVasculature 'Axillary Artery'."@en ;
    dcterms:description "An annotation property that records the blood vessel(s) present at an Acupoint's location, as simple textual/IRI annotations. Corresponds to the object property tara-op:hasRelatedVasculature, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedVasculature ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedSubSurfaceAnatomy .

tara-ap:mondoAnnotationProperty a owl:AnnotationProperty ;
    rdfs:label "mondo:topAnnotationProperty" ;
    dcterms:description "An annotation property to group all MONDO annotation properties specific to TARA Acupoints Ontology." .

tara-kb:hasMethodologicalAndStatisticalAllocationMetrics a owl:AnnotationProperty ;
    rdfs:label "Methodological and Statistical Allocation Metrics" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "Category C: Methodological & Statistical Allocation Metrics (CONSORT). Grouping property for trial management and statistical parameters." ;
    dcterms:type tara-kb:grouping ;
    tara-ap:hasCompactURI "tara-kb:hasMethodologicalAndStatisticalAllocationMetrics" ;
    rdfs:domain TARA:2825659 ;
    rdfs:subPropertyOf tara-kb:hasOCSIScoreMetadata ;
    skos:altLabel "Methodological_And_Statistical_Allocation_Metrics" .

tara-kb:hasOCSIScoreMetadata a owl:AnnotationProperty ;
    rdfs:label "OCSI Score Metadata" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description """An annotation property that serves as a master grouping property for capturing quality appraisal metrics mapped to individual reporting items within the Oregon CONSORT STRICTA Instrument (OCSI) for acupuncture trials. 

Crucially, the scores and details grouped under this property are not native metrics extracted directly or verbatim from the published articles. Instead, they represent secondary, derived appraisals generated, either algorithmically by automated computational models or manually judged by human domain experts by analyzing the extracted textual metadata of the trial against the specific compliance benchmarks defined by the OCSI framework."""@en ;
    dcterms:type tara-kb:grouping ;
    tara-ap:hasCompactURI "tara-kb:hasOCSIScoreMetadata" ;
    rdfs:comment "This sub-grouping property aggregates derived compliance values specifically tied to the combined CONSORT (Consolidated Standards of Reporting Trials) and STRICTA (Standards for Reporting Interventions in Clinical Trials of Acupuncture) guidelines. It organizes granular sub-properties tracking item-by-item compliance scores (e.g., needle stimulation details, control group rationale), separating the calculated evaluation of reporting quality from the raw extracted study parameters."@en ;
    rdfs:domain TARA:2825659 ;
    rdfs:subPropertyOf tara-kb:hasStudyQualityAppraisalMetadata ;
    skos:altLabel "OCSI_Score_Metadata" .

tara-kb:hasStudyFoundationAndBackgroundMetrics a owl:AnnotationProperty ;
    rdfs:label "Study Foundation and Background Metrics" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "Category A: Study Foundation & Background Metrics (CONSORT). Grouping property for foundational framework and scoping layout metrics." ;
    dcterms:type tara-kb:grouping ;
    tara-ap:hasCompactURI "tara-kb:hasStudyFoundationAndBackgroundMetrics" ;
    rdfs:domain TARA:2825659 ;
    rdfs:subPropertyOf tara-kb:hasOCSIScoreMetadata ;
    skos:altLabel "Study_Foundation_And_Background_Metrics" .

tara-op:hasRelatedVasculature a owl:ObjectProperty ;
    rdfs:label "hasRelatedVasculature" ;
    IAO:0000112 "'LU 1' tara-op:hasRelatedVasculature some 'Axillary Artery'; 'Axillary Vein'; 'Thoracoacromial Artery'; 'Thoracoacromial Vein'."@en ;
    IAO:0000115 "An Acupoint a hasRelatedVasculature b (a vessel) if and only if a hasRelatedSubSurfaceAnatomy b."@en ;
    dcterms:description "An object property that relates an Acupoint to the blood vessel(s) present at its location, relevant to safe needling."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedVasculature ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:comment "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its parent property hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:subPropertyOf tara-op:hasRelatedSubSurfaceAnatomy .

HP:0001342 a owl:Class ;
    rdfs:label "Cerebral hemorrhage" ;
    IAO:0000115 "Hemorrhage into the parenchyma of the brain." ;
    OboInOwl:hasAlternativeId "HP:0002137" ;
    OboInOwl:hasDbXref "SNOMEDCT_US:230706003",
        "SNOMEDCT_US:274100004",
        "UMLS:C0553692",
        "UMLS:C2937358" ;
    OboInOwl:hasExactSynonym "Bleeding in brain",
        "Cerebral haemorrhage",
        "Intracerebral haemorrhage",
        "Intracerebral hemorrhage" ;
    OboInOwl:hasRelatedSynonym "Hemorrhagic stroke" ;
    rdfs:comment "A cerebral hemorrhage (or intracerebral hemorrhage, ICH), is a type of intracranial hemorrhage that occurs within the brain tissue itself." ;
    rdfs:subClassOf HP:0002170 .

HP:0001369 a owl:Class ;
    rdfs:label "Arthritis" ;
    IAO:0000115 "Inflammation of a joint." ;
    OboInOwl:hasDbXref "SNOMEDCT_US:3723001",
        "UMLS:C0003864" ;
    OboInOwl:hasExactSynonym "Arthritis",
        "Joint inflammation" ;
    rdfs:subClassOf HP:0001367 .

HP:0025272 a owl:Class ;
    rdfs:label "Melasma" ;
    IAO:0000115 "Symmetrical, blotchy, brownish facial pigmentation." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-12-18T13:48:05+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "Chloasma",
        "Facial melanosis" ;
    rdfs:comment "Melasma can be seen in individuals who have had substantial exposure to the sun, in pregnant women, with hormone treatments or as a side effect of certain medications, or with hypothyroidism, among other causes." ;
    rdfs:subClassOf HP:0000953 .

HP:0100543 a owl:Class ;
