TARA:4176111 a owl:Class ;
    rdfs:label "Special Acupunture Point Role"@en ;
    IAO:0000115 "A Role, realized in acupuncture practice, that classifies an Acupoint according to a named functional category defined within traditional Chinese medicine theory (e.g., Front-Mu point, Back-Shu point, He-Sea point)."@en ;
    IAO:0000116 "'Special Point Role' is modeled as a subclass of 'role' (BFO:0000023): whether an acupoint counts as, e.g., a Front-Mu point is conferred entirely by TCM theory (an external, institutional/doctrinal context) rather than by the acupoint's own physical make-up, matching the defining Role/Disposition distinction given by BFO."@en ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7."@en ;
    dcterms:description "A special, specific role of an acupoint located on the main meridian. Specific points refer to those of the fourteen meridians that have special properties (roles) and are grouped under special names. This class is used to classify the acupoints based on their special point roles."@en ;
    tara-ap:hasSynonym "Special Acupoint Role" .

TARA:4254258 a owl:Class ;
    rdfs:label "Zigongxue" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Prolapse of the uterus, irregular menstruation." ;
    tara-ap:hasLocationalDescription "3 cun lateral to Zhongji (CV 3)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-CA 1",
        "M-CA 18",
        "Zigong" ;
    rdfs:subClassOf TARA:3535998 .

