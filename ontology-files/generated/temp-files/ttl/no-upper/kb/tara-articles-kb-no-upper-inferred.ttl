tara-kb:S-112625-1539 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1539" ;
    dc:title "Real Versus Sham Acupuncture in the Treatment of Paralysis in Acute Stroke Patients: A CT Scan Lesion Site Study" ;
    tara-kb:hasAcupunctureProtocol """Right arm (paralyzed side): LI (large intestine meridian): #4,11,15; TW (triple warmer meridian): #5,9; Three distal Baxie points
Right leg (paralyzed side): St (stomach meridian): #31,36; GB (gall bladder meridian): #34, 39; Li (liver meridian): #3
Left arm (nonparalyzed side): LI (large intestine meridian): #4,11
Left leg (nonparalyzed side): St (stomach meridian): #36
Right and left ears: Shenmen
Scalp acupuncture on side of hemispheric infarction (left): Four or five needles along the 'motor cortex line' on the scalp""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group used in this study was the sham acupuncture group, where patients received sham acupuncture treatments as a comparison to the real acupuncture group." ;
    tara-kb:hasCountryOfStudy "United States" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "LI 4, LI 11, LI 15, St 31, St 36, Ear Shenmen" ;
