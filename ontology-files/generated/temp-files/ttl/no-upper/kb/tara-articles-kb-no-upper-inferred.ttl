    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:8433932\": \"SP 10\", \"TARA:8773594\": \"ST 34\", \"TARA:5290080\": \"BL 40\", \"TARA:3966458\": \"LR 7\", \"TARA:6463344\": \"ST 36\", \"TARA:3386254\": \"GV 20\", \"TARA:7679931\": \"GV 24\"}"^^rdf:JSON ;
