tara-kb:S-112625-1407 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1407" ;
    dc:title "Acupuncture and chronic pain mechanisms" ;
    tara-kb:hasAcupunctureProtocol """Meridian Loci Needling (MLN): Classical acupuncture points associated with specific pain complaints.
Tender Area Needling (TAN): Tender or painful areas, or dermatomal distributions related to the pain.
Specific points or locations not specified.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "Not applicable (the study did not include a control group such as a waitlist or sham acupuncture)" ;
    tara-kb:hasCountryOfStudy "United States" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Not specified" ;
    tara-kb:hasMappedWesternCondition HP:0003418 ;
    tara-kb:hasNeedlingDetails "Not specified" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1407 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1407 ;
    tara-kb:hasSampleSizeDetails """Total sample size: 40
Participants within groups: MLN = 20, TAN = 20
Number of patients analyzed: 38""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used in the study)" ;
    tara-kb:hasStimulationTypeDetails "Not specified (the paper does not explicitly state how the needles were stimulated)" ;
    tara-kb:hasStudiedTCMCondition "Not specified" ;
    tara-kb:hasStudiedWesternCondition "Chronic pain below the waist level (including backache, lower abdominal, flank, and extremity pains)" ;
    tara-kb:hasStudyFindings """The study found no significant difference in the effectiveness of meridian loci needling (MLN) and tender area needling (TAN) methods of acupuncture.
Acupuncture was most effective in patients who responded to sympathetic and sensory blockade (Group II) and least effective in those with centralized pain (Group IV).
The effectiveness of acupuncture was related to the underlying pain mechanisms as identified by differential spinal block (DSB).
The Pearson correlation coefficient between DSB and acupuncture therapy was 0.89 (P < 0.01), indicating a strong relationship.
Yes, acupuncture was found to be effective in certain groups based on their response to DSB.""" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Global Pain Estimate, Change in Pain Estimate (CPE), Duration of Pain Relief (DPR)
Secondary outcome measure: North Carolina Pain Clinic Performance Profile""" ;
    tara-kb:hasTreatmentDuration "Duration of each acupuncture session: 30 to 35 minutes; Duration needles were left in place: Not specified" ;
    tara-kb:hasTreatmentFrequency "Treatment was performed once a day, Monday to Friday, with each session lasting from 30 to 35 minutes. Patients received a total of 7 treatments." .

