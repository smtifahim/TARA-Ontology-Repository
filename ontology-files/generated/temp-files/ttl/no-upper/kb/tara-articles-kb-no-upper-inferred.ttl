TARA:4157768 a owl:Class ;
    rdfs:label "ST 1" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 46. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "承泣" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasInnervationInformation "The branch of the infraorbital nerve, the inferior branch of the oculomotor nerve and the muscular branch of the facial nerve." ;
    tara-ap:hasListedIndications "redness, swelling and pain of the eye, lacrimation, night blindness, eyelid twitching, facial paralysis (bell's palsy)." ;
    tara-ap:hasLocationalDescription "On the face, between the eyeball and the infraorbital margin, directly inferior to the pupil." ;
    tara-ap:hasMethodDescription "Push the eyeball upward with the left thumb and puncture perpendicularly and slowly 0.5-1.0 inch along the infraorbital ridge. It is not advisable to manipulate the needle with large amplitude." ;
    tara-ap:hasPinyinLabel "Chengqi" ;
    tara-ap:hasRelatedArtery UBERON:0001619,
