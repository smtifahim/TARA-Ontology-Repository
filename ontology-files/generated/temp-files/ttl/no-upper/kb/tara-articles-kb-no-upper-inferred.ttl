TARA:6742407 a owl:Class ;
    rdfs:label "BL 32" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 115. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "次髎(髎)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0005473 ;
    tara-ap:hasInnervationInformation "The posterior ramus of the second sacral nerve." ;
    tara-ap:hasListedIndications "low back pain, hernia, irregular menstruation, leukorrhea, dysmenorrhea, nocturnal emission, impotence, enuresis, dysuria, muscular atrophy, pain, numbness and motor impairment of the lower extremities." ;
    tara-ap:hasLocationalDescription "In the sacral region, in the second posterior sacral foramen. Note: The second posterior sacral foramen is located in the depression, midway be- tween the posterior superior iliac spine and the spinous process of the second sacral vertebra." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Chiliao" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004623,
        UBERON:0013710,
        ILX:0795314 ;
    tara-ap:hasSynonym "B 32",
        "Bladder 32",
        "UB 32",
        "Urinary Bladder 32" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the lateral sacral artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004623 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795314 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0013710 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0005473 ] ],
        TARA:0995552 .

TARA:7829474 a owl:Class ;
    rdfs:label "LI 15" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 41. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "肩髃(髃)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001421 ;
    tara-ap:hasInnervationInformation "The lateral supraclavicular nerve and axillary nerve." ;
    tara-ap:hasListedIndications "pain in the shoulder and arm, motor impairment of the upper extremities, rubella, scrofula." ;
    tara-ap:hasLocationalDescription "On the shoulder girdle, in the depression between the anterior end of lateral border of the acromion and the greater tubercle of the humerus. Note: When the arm is abducted, two depressions appear, anterior and posterior to the acromion. LI15 is located in the deeper depression anterior to the acromion. tE14 is located in the posterior depression." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly or obliquely 0.8-1.5 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Jianyu" ;
    tara-ap:hasRelatedArtery ILX:0797496 ;
    tara-ap:hasRelatedNerve UBERON:0001493,
        ILX:0797475 ;
    tara-ap:hasRelatedVein UBERON:0006200 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002497,
        UBERON:0011187 ;
    tara-ap:hasSynonym "CO 15",
        "Colon 15",
        "Large Intestine 15" ;
    tara-ap:hasVasculatureInformation "The posterior circumflex artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4610474 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedVein ;
            owl:someValuesFrom UBERON:0006200 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom ILX:0797475 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001421 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0011187 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom UBERON:0001493 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedArtery ;
            owl:someValuesFrom ILX:0797496 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
