    tara-kb:hasMappedWesternCondition MONDO:0007275 ;
    tara-kb:hasNeedlingDetails "1 cun" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-603 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-603 ;
    tara-kb:hasSampleSizeDetails """Total participants: 98
Treatment group: 60
Control group: 38""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used in the study)" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation and thermal stimulation (moxibustion) were used. The sensation sought was the arrival of qi." ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not provide a TCM term or condition for Carpal Tunnel Syndrome)" ;
    tara-kb:hasStudiedWesternCondition "Carpal Tunnel Syndrome (CTS)" ;
    tara-kb:hasStudyFindings """"The cure rate was 81.7% in the treatment group and 47.4% in the control group, with a significant difference between the two groups (P<0.01)."
"Conclusion: Acupuncture plus Tuina manipulation is a simple therapy for carpal tunnel syndrome, but with remarkable therapeutic effects."
Yes""" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Cure rate
Secondary outcome measures: Clinically cured, Markedly relieved, Improved, Failed""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: Not specified
Needles retained for: 30 minutes""" ;
    tara-kb:hasTreatmentFrequency "The acupuncture treatments were administered once daily, with 10 sessions constituting one therapeutic course." .

