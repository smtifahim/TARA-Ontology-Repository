tara-kb:S-112625-508 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-508" ;
    dc:title "Acupuncture Treatment for Spontaneous Polyhidrosis" ;
    tara-kb:hasAcupunctureProtocol "Huatuojiaji points (EX-B2), located along the Governor Meridian, punctured perpendicularly to 0.5-1 cun deep one by one from top to bottom and with the alternation of left and right." ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Control Group: Western medicine (Estazolam)
Demographics: 26 cases, 19 males, 7 females, age range 36 to 75 years, average age 57 years, disease duration 2 weeks to 4 years
Treatment Protocol: Estazolam 1 mg orally, three times a day, ten days per course, one-day interval between courses
Outcomes: 6 cases cured, 9 cases improved, 11 cases failed, total effective rate 57.7%""" ;
    tara-kb:hasCountryOfStudy "Not specified (the paper does not mention the country where the study was conducted)" ;
    tara-kb:hasDatasetLink "Not specified" ;
