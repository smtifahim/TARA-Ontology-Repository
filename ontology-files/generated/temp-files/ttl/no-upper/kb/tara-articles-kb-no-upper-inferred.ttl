tara-kb:S-112625-1165 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1165" ;
    dc:title "A Systematic Review Effectiveness of Acupuncture for Low Back Pain" ;
    tara-kb:hasAcupunctureProtocol "Not specified (the paper does not provide specific acupoints or locations)" ;
    tara-kb:hasClinicalTrialType "Systematic Review of Randomized Controlled Trials (RCTs)" ;
    tara-kb:hasControlGroupsDetails """No treatment: No intervention was provided.
Sham interventions: Superficial needle insertion at nonacupoints without stimulation or placebo transcutaneous electrical nerve stimulation (TENS).
Conventional therapy: Standard GP care including medication, physiotherapy, etc.
Acupuncture or sham acupuncture in addition to conventional therapy: Adding acupuncture or sham acupuncture to conventional therapy.""" ;
    tara-kb:hasCountryOfStudy "Not specified" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasMappedWesternCondition HP:0003419 ;
    tara-kb:hasNeedlingDetails "Not specified" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1165 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1165 ;
    tara-kb:hasSampleSizeDetails """Total participants: 6359
Sample size range: 17 to 3093
Distribution: 9 studies with 50-100 subjects, 10 studies with more than 100 subjects""" ;
    tara-kb:hasShamAcupunctureDetails """Sham procedure: Superficial needle insertion at nonacupoints without stimulation.
Needle type: Non-penetrating.
Location: Non-acupoints.
Other details: Some studies used superficial needle insertion with 2% lidocaine injection as sham acupuncture.""" ;
    tara-kb:hasStimulationTypeDetails "Not specified (the paper does not provide specific details on the type of stimulation used in acupuncture treatments)" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly mention a TCM condition or symptom)" ;
    tara-kb:hasStudiedWesternCondition "Nonspecific low back pain (LBP)" ;
    tara-kb:hasStudyFindings """Acupuncture is more effective than no treatment for short-term pain relief.
There is no significant difference between acupuncture and sham acupuncture for short-term and intermediate pain relief and functional improvement.
Acupuncture is effective as a supplement to conventional therapy for pain relief and functional disability.
The effectiveness of acupuncture compared to other conventional therapies is inconclusive.""" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcomes: Pain, Functional disability
Secondary outcomes: Not specified""" ;
    tara-kb:hasTreatmentDuration "Not specified" ;
    tara-kb:hasTreatmentFrequency "Not specified (the paper does not provide explicit information on the frequency of acupuncture treatments)" .

