UBERON:0005473 a owl:Class ;
    rdfs:label "sacral region" ;
    IAO:0000115 "A subdivision of an organism along the anterior-posterior axis in the pelvic region immediately posterior to the lumbar region and anterior to the caudal region. Sometimes an intermediate region is defined between the sacral and caudal." ;
    isPartOf: UBERON:0005473 ;
    ilxtr:hasExistingId UBERON:0005473,
        FMA:24228,
        ILX:0729815 ;
