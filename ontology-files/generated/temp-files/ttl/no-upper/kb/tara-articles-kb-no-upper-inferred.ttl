    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:8104948\": \"BL 2\", \"TARA:2324295\": \"GB 20\", \"TARA:9534465\": \"Taiyang\", \"TARA:3135569\": \"Yintang\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition MONDO:0005277 ;
    tara-kb:hasNeedlingDetails "Not specified (the paper refers to a table for detailed needling information, but the content of the table is not provided)" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-343 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-343 ;
    tara-kb:hasSampleSizeDetails """Total participants: 66
Acupuncture group: 33
Topiramate group: 33
Subgroup with medication overuse: 49 (24 acupuncture, 25 topiramate)""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (the study did not use a sham acupuncture group)" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation by twirling with lifting-thrusting to elicit De Qi sensation; no electrical stimulation or moxibustion used." ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not provide TCM terminology for the condition)" ;
    tara-kb:hasStudiedWesternCondition "Chronic Migraine (CM)" ;
    tara-kb:hasStudyFindings """"A significantly larger decrease in the mean monthly number of moderate/severe headache days (primary end point) from 20.2 AE 1.5 days to 9.8 AE 2.8 days was observed in the acupuncture group compared with 19.8 AE 1.7 days to 12.0 AE 4.1 days in the topiramate group (p < .01)"
"Acupuncture treatment has a superior efficacy and less side effects when compared with topiramate treatment for patients with CM."
Yes""" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Mean monthly number of moderate/severe headache days
Secondary outcome measures:
1. Monthly number of headache days (any intensity)
2. Change of MIDAS scores from baseline to endpoint
3. Change of HADS scores from baseline to endpoint
4. Change of SF-36 scores from baseline to endpoint
5. Change of BDI-II scores from baseline to endpoint
6. Reduction from baseline in the number of days with acute headache medications
7. ‚â•50% reduction in monthly moderate/severe headache days
8. ‚â•50% reduction in monthly headache days""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: 30 minutes
Time needles were left in place during a session: 30 minutes""" ;
    tara-kb:hasTreatmentFrequency "Twice weekly for 12 weeks, with each session lasting 30 minutes, totaling 24 sessions." .

tara-kb:S-112625-344 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-344" ;
    dc:title "The `dry-needle technique': intramuscular stimulation in tension-type headache" ;
    tara-kb:hasAcupunctureProtocol """Two points behind the mastoid reaching the left and right m. splenius capitis
Two points at both sides of C-5 reaching the left and right m. splenius capitis and m. splenius cervicis
Two points into the mid-trapezius muscle reaching the left and right m. trapezius""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group consisted of 15 patients who received subcutaneous insertions of needles as a sham intervention, mimicking the procedure without targeting muscle tissue." ;
    tara-kb:hasCountryOfStudy "Not specified" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Not specified" ;
    tara-kb:hasMappedWesternCondition HP:0012228 ;
    tara-kb:hasNeedlingDetails "Intramuscular (specific depth not specified)" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-344 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-344 ;
    tara-kb:hasSampleSizeDetails "Total sample size: 30; Treatment group: 15; Placebo group: 15" ;
    tara-kb:hasShamAcupunctureDetails """Sham procedure: Subcutaneous insertions
Needle type: Same as treatment group (30-gauge, 1-inch long)
Quantity: Six insertions
Location: Subcutaneous, not at trigger points
Penetration: Subcutaneous, not intramuscular""" ;
    tara-kb:hasStimulationTypeDetails "The stimulation in the \"dry-needle technique\" is achieved through the mechanical insertion of 30-gauge, 1-inch needles into specific trigger points, generating electrical discharges that can cause muscle relaxation. No additional forms of stimulation such as manual manipulation, electrical stimulation, thermal stimulation, or laser stimulation are mentioned." ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly mention a TCM condition or disease)" ;
    tara-kb:hasStudiedWesternCondition "Tension-type headache (TTH)" ;
    tara-kb:hasStudyFindings "No (the dry-needle technique was not significantly more effective than the placebo in relieving headache itself, although it improved secondary outcomes like muscle tenderness and ROM limitation)" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Headache scores (calculated from headache indices and frequency)
Secondary outcome measures: Muscle tenderness, Neck ROM limitation""" ;
    tara-kb:hasTreatmentDuration """Duration of each session: 30 minutes
Frequency of sessions: Weeks 1, 2, 3, and 4
Total duration of treatment period: Not specified
Duration retained: Not specified""" ;
    tara-kb:hasTreatmentFrequency "The patients were treated once a week for four weeks (weeks 1, 2, 3, and 4)." .

