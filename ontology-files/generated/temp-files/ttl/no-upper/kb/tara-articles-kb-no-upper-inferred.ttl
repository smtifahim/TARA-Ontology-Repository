UBERON:0015212 a owl:Class ;
    rdfs:label "lateral structure" ;
    IAO:0000115 "Any structure that is placed on one side of the left-right axis of a bilaterian." ;
    IAO:0000232 "This class is primarily to implement taxon constraints. It may be removed in the future." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000465 ],
        UBERON:0000061 .

TARA:5151019 a owl:Class ;
    rdfs:label "Meridian Acupuncture Point" ;
    IAO:0000115 "An Acupoint that isLocatedOnMeridian one of the twelve principal meridians, the Governor Vessel, or the Conception Vessel." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points. ISBN 978-7-119-01758-7."@en ;
    dcterms:description "Acupuncture points of the fourteen meridians, also known as \"meridian points,\" acupuncture points of the fourteen meridians are distributed along the twelve main meridian, the Governor Vessel and the Conception Vessel, totally amounting to 361." ;
    tara-ap:hasSynonym "Acupoint of Meridian",
        "Meridian Acupoint",
        "Meridian Point",
        "Meridian Points" ;
    rdfs:subClassOf TARA:1132428 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:1132428 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:7226516 ] ) ] .

TARA:8104948 a owl:Class ;
    rdfs:label "BL 2" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 100. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "攢(攒,攅)竹" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The medial branch of the frontal nerve." ;
    tara-ap:hasListedIndications "headache, blurred and failing vision, pain in the supraorbital region, lacrimation, redness, swelling and pain of the eye, eyelid twitching, glaucoma." ;
    tara-ap:hasLocationalDescription "On the head, in the depression at the medial end of the eyebrow. Note: A depression, the frontal notch, can often be palpated on the medial end of the eyebrow directly superior to BL1." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch, or prick with three-edged needle to cause bleeding." ;
    tara-ap:hasPinyinLabel "Zanzhu" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0010163,
        ILX:0741726 ;
    tara-ap:hasSynonym "B 2",
        "Bladder 2",
        "UB 2",
        "Urinary Bladder 2" ;
    tara-ap:hasVasculatureInformation "The frontal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
