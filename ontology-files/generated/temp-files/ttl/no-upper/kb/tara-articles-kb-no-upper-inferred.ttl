TARA:3003448 a owl:Class ;
    rdfs:label "SP 3" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 71. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "太白" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "The branches of the saphenous nerve and superficial peroneal nerve." ;
    tara-ap:hasListedIndications "gastric pain, abdominal distension, constipation, dysentery, vomiting diarrhea, borborygmus, sluggishness, beriberi." ;
    tara-ap:hasLocationalDescription "On the medial aspect of the foot, in the depression proximal to the first metatarsophalangeal joint, at the border between the red and white flesh." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Taibai" ;
    tara-ap:hasRelatedArtery UBERON:0001541,
        UBERON:0001553 ;
    tara-ap:hasRelatedNerve UBERON:0002475,
        UBERON:0035526 ;
    tara-ap:hasRelatedVein ILX:0797503 ;
    tara-ap:hasSpecialPointRole TARA:1840369,
        TARA:6705086 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0007750 ;
    tara-ap:hasSynonym "Spleen 3" ;
    tara-ap:hasVasculatureInformation "The dorsal venous network of the foot, the medial plantar artery and the branches of the medial tarsal artery." ;
    tara-ap:isLocatedOnMeridian TARA:4167850 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom UBERON:0002475 ],
