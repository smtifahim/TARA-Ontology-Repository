    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasInnervationInformation "The great occipital nerve." ;
    tara-ap:hasListedIndications "headache, nasal obstruction, sore throat, neck rigidity, pain in the shoulder and back." ;
    tara-ap:hasLocationalDescription "In the posterior region of the neck, at the same level as the superior border of the spinous process of the second cervical vertebra (C2), in the depression lateral to the trapezius muscle." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch." ;
    tara-ap:hasPinyinLabel "Tianzhu" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001093,
