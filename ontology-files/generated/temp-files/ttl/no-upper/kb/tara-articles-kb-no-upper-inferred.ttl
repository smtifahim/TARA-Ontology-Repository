TARA:0739106 a owl:Class ;
    rdfs:label "Liver Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Liver Meridian of Foot-Jueyin (LR), which consists of 14 standardized acupoints beginning at LR 1 (Dadun) on the lateral side of the great toe near the corner of the nail, traveling up along the medial aspect of the leg and passing through the genital region and abdomen, and ending at LR 14 (Qimen) on the anterior chest in the sixth intercostal space." ;
    tara-ap:hasSynonym "Acupoint of Liver Meridian",
        "Acupoint of the Liver Meridian",
        "Acupoint of the liver meridian of foot-jueyin",
        "Acupuncture point of the liver meridian",
        "Acupuncture point of the liver meridian of foot-jueyin",
        "LR Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:5419503 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:5419503 ] ) ] .

TARA:1031890 a owl:Class ;
    rdfs:label "GB 12" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 177. https://iris.who.int/handle/10665/353407",
