    tara-ap:hasChineseLabel "條(条)口" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "Superficially, the lateral sural cutaneous nerve and the cutaneous branch of the saphenous nerve; deeper, the deep peroneal nerve." ;
    tara-ap:hasListedIndications "numbness, soreness and pain of the knee and leg, weakness and motor impairment of the foot, pain and motor impairment of the shoulder, abdominal pain." ;
    tara-ap:hasLocationalDescription "On the anterior aspect of the leg, on the line connecting ST35 with ST41, 8 B-cun inferior to ST35. Note: ST38 is located on the tibialis anterior muscle, at the same level as St40." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Tiaokou" ;
    tara-ap:hasRelatedArtery UBERON:0001537 ;
    tara-ap:hasRelatedNerve UBERON:0002475,
        UBERON:0035207,
        ILX:0797521 ;
    tara-ap:hasRelatedVein UBERON:0001545 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001385 ;
    tara-ap:hasSynonym "S 38",
        "Stomach 38" ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
