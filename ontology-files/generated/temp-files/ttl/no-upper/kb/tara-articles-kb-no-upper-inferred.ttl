    tara-ap:hasChineseLabel "行間(间)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "The site where the dorsal digital nerves split from the lateral dorsal metatarsal nerve of the deep peroneal nerve." ;
    tara-ap:hasListedIndications "pain in the hypochondrium, abdominal distension, headache, dizziness and vertigo, congestion, swelling and pain of the eye, deviation of the mouth, hernia, painful urination, retention of urine, irregular menstruation, epilepsy, insomnia, convulsion." ;
    tara-ap:hasLocationalDescription "On the dorsum of the foot, between the first and second toes, proximal to the web margin, at the border between the red and white flesh." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Xingjian" ;
    tara-ap:hasSpecialPointRole TARA:9857829 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003631,
        UBERON:0003632 ;
    tara-ap:hasSynonym "LIV 2",
        "LV 2",
        "Liver 2" ;
    tara-ap:hasVasculatureInformation "The dorsal venous network of the foot and the first dorsal digital artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5419503 ;
