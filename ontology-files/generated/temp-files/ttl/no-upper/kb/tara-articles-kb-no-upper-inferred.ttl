TARA:5653254 a owl:Class ;
    rdfs:label "Lower He-Sea Point of the Gallbladder" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Lower He-Sea Point of the the Gallbladder meridian. One of the five Shu Points, the He-Sea point signifies the confluence of rivers in the sea, where the meridian qi is the most flourishing. In addition, each of the six fu organs has another He-Sea point in the three yang meridians of the foot, known as the Lower He-Sea point. The Lower He-Sea points are mostly employed to treat the disorders of the six fu organs in clinic." ;
    tara-ap:hasSpecialPointRole TARA:0513340 ;
    rdfs:subClassOf TARA:4830205 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4830205 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:0513340 ] ) ] .

TARA:5656394 a owl:Class ;
    rdfs:label "SP 18" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 78. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "天谿(溪)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The lateral cutaneous branch of the fourth intercostal nerve." ;
    tara-ap:hasListedIndications "fullness and pain in the chest and hypochondrium, cough, hiccup, mastitis, insufficient lactation." ;
    tara-ap:hasLocationalDescription "In the anterior thoracic region, in the fourth intercostal space, 6 B-cun lateral to the anterior median line. Note: SP18, ST17 and KI23 are located along the curve of the fourth intercostal space." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Tianxi" ;
    tara-ap:hasRelatedArtery UBERON:0001395,
        UBERON:0001396,
        ILX:0789814 ;
    tara-ap:hasRelatedNerve ILX:0784694 ;
    tara-ap:hasRelatedVein UBERON:0002088,
        UBERON:0012197,
        ILX:0797505 ;
    tara-ap:hasSpecificReferenceLocation ILX:0795285,
