MONDO:0850230 a owl:Class ;
    rdfs:label "chronic urticaria" ;
    IAO:0000115 "An urticaria that is characterized by the presence of urticaria for a period exceeding 6 weeks, assuming symptoms for most days of the week." ;
    mondons:curated_content_resource "https://www.malacards.org/card/chronic_urticaria"^^xsd:anyURI ;
    OboInOwl:hasDbXref "DOID:0080747",
