TARA:0674193 a owl:Class ;
    rdfs:label "Pigen" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Hepatosplenomegaly, lumbar pain." ;
    tara-ap:hasLocationalDescription "3.5 cun lateral to the lower border of the spinous process of the first lumbar vertebra." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-B 4",
        "M-BW 16" ;
    rdfs:subClassOf TARA:3535998 .

TARA:1216325 a owl:Class ;
    rdfs:label "Zhongquan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Stuffy chest, gastric pain, spitting of blood." ;
    tara-ap:hasLocationalDescription "On the dorsal crease of the wrist, in the depression on the radial side of the tendon of common extensor muscle of fingers between Yangxi (Ll 5) and Yangchi (TE 4)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-UE 3",
        "M-UE 33" ;
    rdfs:subClassOf TARA:3535998 .

TARA:1317363 a owl:Class ;
    rdfs:label "Erbai" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Hemorrhoids, prolapse of the rectum." ;
    tara-ap:hasLocationalDescription "On the metacarpal aspect of the forearm, 4 cun above the transverse wrist crease, on the both sides of the tendon of m. flexor carpi radialis, two points on one hand." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5- 1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-UE 2",
        "M-UE 29" ;
    rdfs:subClassOf TARA:3535998 .

TARA:1338884 a owl:Class ;
    rdfs:label "Jiachengjiang" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Pain in the face, deviation of the eyes and mouth, spasm of facial muscle." ;
    tara-ap:hasLocationalDescription "1 cun lateral to Chengjiang (CV 24)." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5-1.0 inch.." ;
    tara-ap:hasSynonym "M-HN 18" ;
    rdfs:subClassOf TARA:3535998 .

TARA:2063814 a owl:Class ;
    rdfs:label "Shixuan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Apoplexy, coma, epilepsy, high fever, acute tonsillitis, infantile convulsion, numbness of the finger tips." ;
    tara-ap:hasLocationalDescription "On the tips of the ten fingers, about 0.1 cun distal to the nails." ;
    tara-ap:hasMethodDescription "Puncture 0.1-0.2 inch superficially, or prick to cause bleeding." ;
    tara-ap:hasSynonym "EX-UE 11",
        "M-UE 49",
        "Shiwang" ;
    rdfs:subClassOf TARA:3535998 .

TARA:2894731 a owl:Class ;
    rdfs:label "Acupuncture Study Journal Article" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A specialized subclass of 'Acupuncture Study Publication' representing a peer-reviewed paper published within a periodic scientific journal. This class specifically designates formalized, citable academic literature that has undergone rigorous editorial evaluation, differentiating it from broader publication types by its structural alignment with journal metadata standardizations and its role in official scholarly records."@en ;
    rdfs:subClassOf TARA:8223728 .

TARA:3145377 a owl:Class ;
    rdfs:label "Dannangxue" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Acute and chronic cholecystitis, cholelithiasis, biliary ascariasis, muscular atrophy and numbness of the lower extremities." ;
    tara-ap:hasLocationalDescription "The tender spot 1-2 cun directly below Yanglingquan (GB 34)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches." ;
    tara-ap:hasSynonym "EX-LE 6",
        "M-LE 23" ;
    rdfs:subClassOf TARA:3535998 .

TARA:3735582 a owl:Class ;
    rdfs:label "Huanzhong" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Lumbar pain, thigh pain." ;
    tara-ap:hasLocationalDescription "Midway between Huantiao (GB 30) and Yaoshu (GV 2)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 1.5-2.0 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "M-BW 34" ;
    rdfs:subClassOf TARA:3535998 .

TARA:4043356 a owl:Class ;
    rdfs:label "Crossing Point" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "Represents a Crossing Point. Crossing points are those at the intersections of two or more meridians. Distributed mainly on the head, face and trunk, and amounting to over ninety in total. They are key points used to treat meridian disorders of the areas where they are located." ;
    tara-ap:hasSpecialPointRole TARA:9695467 ;
    rdfs:subClassOf TARA:2614885 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:2614885 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:9695467 ] ) ] .

TARA:4613316 a owl:Class ;
    rdfs:label "Yaoqi" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Epilepsy, headache, inomnia, constipation." ;
    tara-ap:hasLocationalDescription "2 cun directly above the tip of the coccyx." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously upward 1.0-2.0 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-B 9",
        "M-BW 29" ;
    rdfs:subClassOf TARA:3535998 .

TARA:5220479 a owl:Class ;
    rdfs:label "Lateral Xiyan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001465 ;
    tara-ap:hasListedIndications "Knee pain, weakness of the lower extremities." ;
    tara-ap:hasLocationalDescription "A Xiyan point located in the depression, lateral to the patellar ligament, locating the point with the knee flexed. Lateral Xiyan overlaps with Dubi (ST 35)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5- 1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003676 ;
    tara-ap:hasSynonym "M-LE 26",
        "Xiwai" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003676 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001465 ] ],
        TARA:0926802 .

TARA:5660399 a owl:Class ;
    rdfs:label "Erjian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Redness, swelling and pain of the eyes, febrile disease, nebula." ;
    tara-ap:hasLocationalDescription "Fold the auricle, the point is at the apex of the auricle." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.1-0.2 inch or prick to cause bleeding." ;
    tara-ap:hasSynonym "EX-HN 6",
        "M-HN 10" ;
    rdfs:subClassOf TARA:3535998 .

TARA:6269212 a owl:Class ;
    rdfs:label "Zhongkui" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Nausea, vomiting, hiccup." ;
    tara-ap:hasLocationalDescription "On the midpoint of the proximal interphalangeal joint of the middle finger at dorsum aspect." ;
    tara-ap:hasMethodDescription "Moxibustion is applied with three moxa cones." ;
    tara-ap:hasSynonym "EX-UE 4",
        "M-UE 16" ;
    rdfs:subClassOf TARA:3535998 .

TARA:6560239 a rdfs:Datatype ;
    rdfs:comment "To represent the total OCSI Score percentage between 0.0 to 100.0."@en ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:float ;
            owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float ] [ xsd:maxInclusive "100.0"^^xsd:float ] ) ] .

TARA:6941032 a owl:Class ;
    rdfs:label "Baichongwo" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Rubella, eczema, gastrointestinal parasitic diseases." ;
    tara-ap:hasLocationalDescription "1 cun above Xuehai (SP 10)." ;
    tara-ap:hasMethodDescription "Pu ncture perpendicularly 1.0-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "M-LE 34" ;
    rdfs:subClassOf TARA:3535998 .

TARA:7532145 a owl:Class ;
    rdfs:label "Lanweixue" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Acute and chronic appendicitis, indigestion, paralysis of the lower extremities." ;
    tara-ap:hasLocationalDescription "The tender spot about 2 cun below Zusanli (ST 36)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 1.0-1.2 inches." ;
    tara-ap:hasSynonym "EX-LE 7",
        "M-LE 13" ;
    rdfs:subClassOf TARA:3535998 .

TARA:8819424 a owl:Class ;
    rdfs:label "Zhoujian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Scrofula" ;
    tara-ap:hasLocationalDescription "On the tip of the ulnar olecranon when the elbow is flexed." ;
    tara-ap:hasSynonym "EX-UE 1",
        "M-UE 46" ;
    rdfs:subClassOf TARA:3535998 .

tara:acupoints.owl a owl:Ontology ;
    dc:contributor "Fahim T. Imam, PhD - https://orcid.org/0000-0003-4752-543X",
        "Ilias Ziogas, PhD - https://orcid.org/0000-0002-9210-2455",
        "Maryann E. Martone, PhD - https://orcid.org/0000-0002-8406-3871",
        "Richard Harris, PhD - https://orcid.org/0000-0002-2067-8447" ;
    dc:creator "Fahim T. Imam, PhD - https://orcid.org/0000-0003-4752-543X" ;
    dc:description """The TARA Acupoints Ontology is an ontology developed as part of the Topological Atlas and Repository for Acupoint Research (TARA) project funded by the National Institute of Health (NIH). The goal of TARA is to establish a new comprehensive resource for the acupuncture research and clinician community. The ontology will be used to support semantic search and annotations for anatomical maps, atlases, and data sets relevant to the TARA project.
- About TARA Project: https://www.acupunctureresearch.org/tara
- TARA Ontology GitHub Repo: https://purl.org/tara/ontology/repo
- TARA Ontology Updates: https://purl.org/tara/ontology/updates
- TARA Ontology Files: https://purl.org/tara/ontology"""@en ;
    dc:source "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. ISBN 978-7-119-01758-7."@en,
        "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 26. https://iris.who.int/handle/10665/353407"@en ;
    dc:title "TARA Acupoints Ontology"@en ;
    owl:versionInfo "1.5.0" .

tara-ap:hasAbbreviation a owl:AnnotationProperty ;
    rdfs:label "Abbreviation" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasAcronym a owl:AnnotationProperty ;
    rdfs:label "Acronym" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasAuthor a owl:AnnotationProperty ;
    rdfs:label "Author(s)" ;
    rdfs:subPropertyOf dc:creator .

tara-ap:hasChineseLabel a owl:AnnotationProperty ;
    rdfs:label "Chinese Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasCompactURI a owl:AnnotationProperty ;
    rdfs:label "Compact URI"@en ;
    IAO:0000118 "CURIE" ;
    dcterms:description "A CURIE (Compact URI) for an ontology IRI is a shortened, human-readable abbreviation consisting of a prefix and a local identifier separated by a colon. For example, the full IRI http://purl.obolibrary.org/obo/UBERON_0000948 condenses into the CURIE UBERON:0000948."@en ;
    rdfs:subPropertyOf dcterms:identifier .

tara-ap:hasCurationSourceLink a owl:AnnotationProperty ;
    rdfs:label "Curation Source Link"@en ;
    dc:description "An annotation property that links an extracted metadata element, class, or individual to its precise origin in the data curation layer via a direct URL. For Google Sheets, the value must be a fully qualified, clickable URL containing specific worksheet identifier (gid) and target cell or row parameters (range), establishing strict machine-readable provenance down to the exact grid coordinate."@en ;
    rdfs:subPropertyOf dc:source,
        dcterms:source .

tara-ap:hasDOI a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:identifier .

tara-ap:hasEnglishLabel a owl:AnnotationProperty ;
    rdfs:label "English Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasFigureSourceLink a owl:AnnotationProperty ;
    rdfs:label "Figure Source Link"@en ;
    dc:description "An annotation property that links a figure from a web resource to enhance the information about an ontological class or entity."@en ;
    rdfs:subPropertyOf dc:source .

tara-ap:hasListedIndications a owl:AnnotationProperty ;
    rdfs:label "Listed Indication(s)"@en ;
    dcterms:description """An annotation property that lists the clinical conditions and symptoms for which an acupoint is indicated according to traditional Chinese medicine.

Example: 'LU 1' tara:hasListedIndications "Cough, asthma, pain in the chest, shoulder and back; fullness of the chest\""""@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:subPropertyOf tara-ap:hasAcupointInformation .

tara-ap:hasMethodDescription a owl:AnnotationProperty ;
    rdfs:label "Acupuncture Method"@en ;
    dcterms:description """An annotation property that describes the recommended needling method for an acupoint, including needle angle, depth, and applicability of moxibustion. 

Example: 'LU 1' tara:hasMethodDescription "Puncture obliquely 0.5-0.8 cun towards the lateral aspect of the chest. To avoid injuring the lung, never puncture deeply towards the medial aspect. Moxibustion is applicable.\""""@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:subPropertyOf tara-ap:hasAcupointInformation .

tara-ap:hasNextAcupoint a owl:AnnotationProperty ;
    rdfs:label "Next Acupoint"@en ;
    dcterms:description """An annotation property to link a meridian acupoint to its next acupoint along the same meridian.

Example: 'LU 1' tara:hasNextAcupoint 'LU 2'."""@en ;
    rdfs:domain TARA:5151019 ;
    rdfs:range TARA:5151019 ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-ap:hasPinyinLabel a owl:AnnotationProperty ;
    rdfs:label "Pinyin Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasPublicationDate a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:date .

tara-ap:hasPublicationVenue a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation .

tara-ap:hasSourceSheetColumnLabel a owl:AnnotationProperty ;
    rdfs:label "Source Sheet Column Label"@en ;
    dcterms:description "An annotation property used to link a formal concept, property, or class within an ontology to its exact literal string representation used as a column header in a data extraction spreadsheet or CSV file. As a subproperty of skos:hiddenLabel, it preserves the raw, unformatted, and informal terminology of the source data layer for ingestion and mapping purposes, without polluting the clean, formal vocabulary defined by skos:prefLabel."@en ;
    rdfs:subPropertyOf skos:hiddenLabel .

tara-ap:hasSynonym a owl:AnnotationProperty ;
    rdfs:label "Synonym" ;
    rdfs:subPropertyOf IAO:0000118 .

<http://www.acupunctureresearch.org/tara/ontology/imported/tara-mondo-hp-import.owl> a owl:Ontology ;
    rdfs:comment """This file includes a subset of terms imported from MONDO and HP, specifically needed to map extracted diseases and conditions for TARA Articles Metadata Knowledgebase.
- Hierarchy up to MONDO:0000001 (disease or disorder) and HP:0000001 (All)
- HP:0000001 grafted under BFO:0000001 as a post-processing step.
- CL, GO, NCBITaxon, PATO, RO, and CHEBI classes excluded.
- OWL axioms: named-class subClassOf with following properies:
   - disease-has-feature (RO:0004029) / mondo:disease_has_major_feature)
   - disease-has-location (RO:0004026 / RO:0004027) restrictions
   - disease-has-location fillers connecting with UBERON"""@en .

<http://www.acupunctureresearch.org/tara/ontology/imported/tara-uberon-import.owl> a owl:Ontology ;
    rdfs:comment """This file includes imported terms from InterLex used by the TARA Acupoints Ontology. It includes the basic hierarchy and the partnomy of the imported terms.
-  TARA Ontology Termset: http://uri.interlex.org/base/ilx_0795339""",
        """This file includes imported subset of UBERON, specific to the TARA Acupoints Ontology.
- Hierarchy up to UBERON:0001062 (anatomical entity) 
- CL, GO, NCBITaxon, and PATO classes excluded
- OWL Axioms: Only named-class subClassOf restrictions for:
    - BFO:0000050 (part_of), RO_0001025 (located_in)
    - RO:0002170 (connected_to), and BFO:0000051 (has_part)"""@en .

tara-kb:articles-metadata.owl a owl:Ontology ;
    dc:description """This file includes TARA Clinical Trials Knowledgebase - a structured metadata knowledgebase for acupuncture clinical trial studies developed as part of the TARA Acupoints Research project, encompassing randomized controlled trials, meta-analyses, and systematic reviews of clinical trials. The knowledgebase is derived from metadata extracted from full-text journal publications and is intended to support systematic retrieval, comparison, and quality assessment of acupuncture research studies. 

It includes following classes with a rich set of metadata annotation properties:
- Acupuncture Research Study: the physical execution of an acupuncture clinical trial, from participant recruitment and baseline grouping through administration of real or sham acupuncture procedures to final endpoint evaluation
- Acupuncture Study Publication: the documentary artifact (e.g., journal articles) that reports on an acupuncture trial study
- Acupuncture Study OCSI Appraisal: the structured quality appraisal of acupuncture trial reporting, based on the Oregon CONSORT STRICTA Instrument (OCSI)

Metadata for each publication instance is captured through a standard set of annotation properties organized into three categories:
- Bibliographic Metadata: article title, authorship, source, and publication identifiers
- Study Metadata: intervention design, participant characteristics, sample size, outcome measures, and study outcomes
- OCSI Score Appraisal Metadata: compliance with OCSI criteria for evaluating the completeness and quality of acupuncture trial reporting"""@en ;
    rdfs:comment """This file includes a set of standard annotation properties that serves as a data dictionary to capture the extracted metadata from acupuncure studies curated for the TARA Project.

Created by: Fahim Imam - https://orcid.org/0000-0003-4752-543X"""@en .

tara-kb:hasAcupointGrouping a owl:AnnotationProperty ;
    rdfs:label "Acupoint Grouping" ;
    IAO:0000112 "\"Three pairs of acupuncture points on the right side: LI 4 and PC 6, ST 36 and SP 9, LR 3 and SP 6; PC 6 was located approximately 1 cm radial to the traditional point.\"" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "An annotation property to capture acupoint grouping information, the structural combination, pairing, or categorization of multiple selected acupuncture points, including primary and secondary points, designed to work synergistically within a clinical trial treatment prescription." ;
    tara-ap:hasCompactURI "tara-kb:hasAcupointGrouping" ;
    rdfs:comment "Acupoint grouping is about organizing multiple points into a single treatment protocol, often divided into primary (core) points for the main condition and secondary (adjuvant) points for specific symptoms." ;
    rdfs:subPropertyOf tara-kb:hasAcupointSelectionAndGrouping .

tara-kb:hasAcupointSelection a owl:AnnotationProperty ;
    rdfs:label "Acupoint Selection" ;
    IAO:0000112 "\"Combination of scalp, body, and auricular acupuncture specific to the affected areas of the child and inclusive of both sides of the body.\"",
        "\"Trigger points in the gluteals isolated by palpation ensuring reproduction of symptoms, mostly in the region of the upper outer buttock quadrant, 3 to 5 points per subject.\"" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "An annotation property to capture specific choice of body sites (anatomical locations) targeted for acupuncture needle insertion within a clinical trial protocol." ;
    tara-ap:hasCompactURI "tara-kb:hasAcupointSelection" ;
    rdfs:comment "Acupoint selection is about deciding which exact body locations to target during an intervention, guided by traditional systems (like meridians and specific point attributes) or modern anatomical maps (like local trigger points or nerve distributions). Researchers standardize this to test if a specific set of points delivers reproducible health outcomes." ;
    rdfs:subPropertyOf tara-kb:hasAcupointSelectionAndGrouping .

tara-kb:hasAcupunctureDetailsScore a owl:AnnotationProperty ;
    rdfs:label "Acupuncture Details Score" ;
    IAO:0000112 "e.g., a score of 2 when the acupuncture style and its rationale are both fully described, 1 when only partially described, or 0 when neither is reported."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "Category B: Technical Intervention Quality Metrics (STRICTA). The STRICTA-aligned score evaluating the general description of the acupuncture style and rationale." ;
    tara-ap:hasCompactURI "tara-kb:hasAcupunctureDetailsScore" ;
    rdfs:domain TARA:2825659 ;
    rdfs:range TARA:5972061 ;
    rdfs:subPropertyOf tara-kb:hasTechnicalInterventionQualityMetrics ;
    skos:altLabel "Acupuncture_Details_Score" .

tara-kb:hasAdverseEffectsScore a owl:AnnotationProperty ;
    rdfs:label "Adverse Effects Score" ;
    IAO:0000112 "e.g., a score of 2 when adverse events and their monitoring are explicitly reported, or 0 when adverse events are not mentioned."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "Category C: Methodological & Statistical Allocation Metrics (CONSORT). The quality metric assessing the safety transparency and recording protocols for harmful events or patient side effects." ;
    tara-ap:hasCompactURI "tara-kb:hasAdverseEffectsScore" ;
    rdfs:domain TARA:2825659 ;
    rdfs:range TARA:5972061 ;
    rdfs:subPropertyOf tara-kb:hasMethodologicalAndStatisticalAllocationMetrics ;
    skos:altLabel "Adverse_Effects_Score" .

