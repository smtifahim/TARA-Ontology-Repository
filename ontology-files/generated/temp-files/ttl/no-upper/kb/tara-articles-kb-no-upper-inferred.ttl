TARA:4311153 a owl:Class ;
    rdfs:label "PC 6" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 154. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "內關(关,関)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002386 ;
    tara-ap:hasListedIndications "cardiac pain, palpitation, stuffy chest, pain in the hypochondriac region, stomachache, nausea, vomiting, hiccup, mental disorder, epilepsy, insomnia, febrile diseases, irritability, malaria, contracture and pain of the elbow and arm." ;
    tara-ap:hasLocationalDescription "On the anterior aspect of the forearm, between the tendons of the palmaris longus and the flexor carpi radialis, 2 B-cun proximal to the palmar wrist crease. Note 1: With the fist clenched, the wrist supinated and the elbow slightly flexed, the two tendons become more prominent. PC6 is located 2 B-cun proximal to PC7. the posterial point corresponding to PC6 is TE5. Note 2: If the palmaris longus tendon is not present, PC6 is medial to the flexor carpi radialis tendon." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Neiguan" ;
    tara-ap:hasSpecialPointRole TARA:6993030,
        TARA:9493899 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0016496,
        ILX:0795334,
        ILX:0795500 ;
    tara-ap:hasSynonym "HC 6",
        "P 6",
        "PE 6",
        "Per 6",
        "Pericardium 6" ;
    tara-ap:isLocatedOnMeridian TARA:4694897 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002386 ] ],
        [ a owl:Restriction ;
