TARA:2491709 a owl:Class ;
    rdfs:label "Baxie" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Excessive heat, finger numbness, spasm and contracture of the fingers, redness and swelling of the dorsum of the hand." ;
    tara-ap:hasLocationalDescription "On the dorsum of the hand, at the junction of the white and red skin of the hand webs, eight in all, making a loose fist to locate the points." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch, or prick to cause bleeding. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-UE 9",
        "M-UE 22" ;
    rdfs:subClassOf TARA:3535998 .

TARA:2678584 a owl:Class ;
    rdfs:label "BL 37" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 118. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "殷門(门)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000376 ;
    tara-ap:hasInnervationInformation "The posterior femoral cutaneous nerve; deeper, the sciatic nerve." ;
    tara-ap:hasListedIndications "pain in the lower back and thigh, muscular atrophy, pain, numbness and motor impairment of the lower extremities, hemiplegia." ;
    tara-ap:hasLocationalDescription "On the posterior aspect of the thigh, between the biceps femoris and the semitendinosus muscles, 6 B-cun inferior to the gluteal fold. Note 1: In the prone position, the semitendinosus and the biceps femoris muscles are more distinct when the knee is flexed against resistance. In addition, it is easier to find the two muscles with internal and external rotation of the hip. Note 2: 1 B-cun superior to the midpoint of the line connecting BL36 with BL40." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 1.0-2.0 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Yinmen" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001374,
        UBERON:0001375,
        UBERON:0036014 ;
    tara-ap:hasSynonym "B 37",
        "Bladder 37",
        "UB 37",
        "Urinary Bladder 37" ;
    tara-ap:hasVasculatureInformation "Laterally, the third perforating branches of the deep femoral artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001375 ] ],
