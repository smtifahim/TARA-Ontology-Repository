MONDO:0001266 a owl:Class ;
    rdfs:label "erysipelas" ;
    IAO:0000115 "An infection of the upper layers of the skin caused by species of streptococcus. Erysipelas results in a fiery red rash with raised edges that can easily be distinguished from the skin around it. The affected skin may be warm to the touch." ;
    mondons:curated_content_resource "https://www.malacards.org/card/erysipelas"^^xsd:anyURI ;
    OboInOwl:hasDbXref "DOID:11330",
