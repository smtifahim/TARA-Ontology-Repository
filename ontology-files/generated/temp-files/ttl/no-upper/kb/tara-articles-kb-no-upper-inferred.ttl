tara-kb:S-112625-1224 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1224" ;
    dc:title "Acupuncture in the Treatment of Diabetic Bladder Dysfunction" ;
    tara-kb:hasAcupunctureProtocol """Shensh (BL23): back-shu point of the Kidney, tonifies the Kidneys
Qihaishu (BL24): removes obstructions from the meridian
Ciliao (BL32): benefits urination, regulates the lower jiao, activates the meridian
Weiyang (BL39): benefits urination, harmonizes the San Jiao, opens the water passages
Zhibian (BL54): benefits urination, regulates the lower jiao, activates the meridian
Locations determined by anatomical landmarks and proportional measurements
Depth of insertion: BL23 (0.60-1.00cm), BL24 (0.80-1.10cm), BL32 (1.00-1.60cm), BL39 (1.05-1.70cm), BL54 (1.10-2.00cm)""" ;
    tara-kb:hasClinicalTrialType "Pilot Study (Randomized Controlled Trial)" ;
    tara-kb:hasControlGroupsDetails "Sham acupuncture group: The sham acupuncture group involved puncturing the same acupoints as the acupuncture group but with minimal needle insertion (0.3cm) and no manipulation to avoid the sensation of \"de qi.\"" ;
    tara-kb:hasCountryOfStudy "China" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "BL 23, BL 24, BL 32, BL 39, BL 54" ;
