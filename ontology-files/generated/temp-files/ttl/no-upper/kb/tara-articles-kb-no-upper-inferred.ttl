TARA:3553465 a owl:Class ;
    rdfs:label "SP 9" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 74. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "陰(阴)陵泉" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "Superficially, the medial crural cutaneous nerve; deeper, the tibial nerve." ;
    tara-ap:hasListedIndications "abdominal pain and distension, diarrhea, dysentery, edema, jaundice, dysuria, enuresis, urinary incontinence, pain in the external genitalia, dysmenorrhea, pain in the knee." ;
    tara-ap:hasLocationalDescription "On the tibial aspect of the leg, in the depression between the inferior border of the medial condyle of the tibia and the medial border of the tibia. Note: A depression can be felt inferior to the knee joint when moving proximally along the medial border of the tibia. SP9 is located in a depression at the angle formed by the inferior border of the medial condyle of the tibia and the posterior border of the tibia." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Yinlingquan" ;
    tara-ap:hasRelatedArtery UBERON:0001538,
        ILX:0797504 ;
    tara-ap:hasRelatedNerve UBERON:0001323,
        ILX:0797485 ;
    tara-ap:hasRelatedVein UBERON:0001363,
        UBERON:0001546 ;
    tara-ap:hasSpecialPointRole TARA:6594221 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0000979,
        UBERON:0001485,
        UBERON:0009990 ;
    tara-ap:hasSynonym "Spleen 9" ;
    tara-ap:hasVasculatureInformation "Anteriorly, the great saphenous vein, the genu suprema artery; deeper, the posterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4167850 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedVein ;
            owl:someValuesFrom UBERON:0001363 ],
