tara-kb:S-112625-603 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-603" ;
    dc:title "Warm-needling plus Tuina Relaxing for the Treatment of Carpal Tunnel Syndrome" ;
    tara-kb:hasAcupunctureProtocol """Quchi (LI 11): Used with a 2-cun moxa stick for warm-needling.
Waiguan (TE 5): Punctured perpendicularly and manipulated with the even method.
Daling (PC 7): Punctured at a 40¬∞ angle towards the distal end of the palm for 1 cun.
Yangchi (TE 4): Punctured perpendicularly and manipulated with the even method.
Baxie (EX-UE9): Punctured perpendicularly and manipulated with the even method.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group received hormone block therapy with 10 mg Triamcinolone A plus 1-2 ml 2% lidocaine injected into Daling (PC 7) once every 3-5 days, and drug medication consisting of Dibazol 10 mg and Vitamin B1 20 mg taken orally three times daily for 10 days." ;
    tara-kb:hasCountryOfStudy "Not specified" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "LI 11, TE 5, PC 7, TE 4, EX-UE9" ;
