TARA:1208891 a owl:Class ;
    rdfs:label "BL 50" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 124. https://iris.who.int/handle/10665/353407",
