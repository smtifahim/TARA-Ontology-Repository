tara-kb:S-112625-22 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-22" ;
    dc:title "Preoperative Intradermal Acupuncture Reduces Postoperative Pain, Nausea and Vomiting, Analgesic Requirement, and Sympathoadrenal Responses" ;
    tara-kb:hasAcupunctureProtocol """Upper abdominal surgery: BL18-24, located 2.5 cm to the left and right of T9-L3 spinal vertebrae.
Lower abdominal surgery: BL20-26, located 2.5 cm to the left and right of T11-L5 spinal vertebrae.
Total points per patient: 14.
Chosen based on association with visceral organs (TCM diagnosis).""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Control groups: Sham acupuncture where needles were positioned at acupoints but not inserted into the intradermal space.
Randomization: Patients were randomly assigned to either the acupuncture or control group using sequentially numbered, sealed opaque envelopes.
Blinding: Double-blinded; anesthesiologists, physicians evaluating pain, and investigators were unaware of group assignments.""" ;
    tara-kb:hasCountryOfStudy "Japan" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "BL 18, BL 19, BL 20, BL 21, BL 22, BL 23, BL 24, BL 25, BL 26" ;
