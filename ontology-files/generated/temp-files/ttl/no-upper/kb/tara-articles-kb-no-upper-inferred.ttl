tara-kb:S-112625-1051 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1051" ;
    dc:title "Acupuncture for Treating Whiplash Associated Disorder: A Systematic Review of Randomised Clinical Trials" ;
    tara-kb:hasAcupunctureProtocol """Kwak et al.: SI2, SI3, SI5, SI7, LI 11, SI 15, SI 14, BL10, BL12, BL13, BL14, BL60, BL62, BL66, GB20, GB21, GB40, GB41, TE15, TE5
Tobbackx et al.: GV14, C1‚ÄìC7, GB20, SI11, GB21, TE15, SI14, BL17, SP10, SI3, BL64, TE5, GB41, Ear Zero point, Ear Jerome point, Ear C0
Cameron et al.: GB39, GB20, LI14, SI6 bilaterally, and points 20--30 mm away from these
Han et al.: BL10, GB20, GB21, SI14, SI15, SI11
Tough et al.: Myofascial trigger points (MTrPs)
Aigner et al.: TB5, SI6 bilaterally""" ;
    tara-kb:hasClinicalTrialType "Systematic Review" ;
    tara-kb:hasControlGroupsDetails """Usual care (UC)
Relaxation
Sham electroacupuncture (EA)
Sham dry needling (DN) in addition to physiotherapy (PT)
Drugs plus physiotherapy (PT)""" ;
    tara-kb:hasCountryOfStudy "Australia, Austria, Belgium, Korea, UK" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasNeedlingDetails "1.0‚Äì2.0 cm" ;
