    tara-ap:hasSynonym "K 1",
        "KD 1",
        "KID 1",
        "Kidney 1" ;
    tara-ap:hasVasculatureInformation "Deeper, the plantar arterial arch." ;
    tara-ap:isLocatedOnMeridian TARA:4813389 ;
