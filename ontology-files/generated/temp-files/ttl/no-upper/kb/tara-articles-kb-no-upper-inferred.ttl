    tara-kb:hasMappedWesternCondition MONDO:0005277 ;
    tara-kb:hasNeedlingDetails "10 15 mm" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1727 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1727 ;
    tara-kb:hasSampleSizeDetails """Total sample size: 150
Verum acupuncture group: 75
Sham acupuncture group: 75""" ;
    tara-kb:hasShamAcupunctureDetails """Sham points were chosen based on Chinese acupuncture textbooks and were unrelated to headache treatment.
Points were selected near the elbow and knee joints, avoiding head, hands, feet, and trunk.
Sham points were randomly assigned to subgroups, with two points on arms and three on legs.
Sham points were punctured perpendicularly.
Disposable, sterile steel needles (1.5 in. filiform needle, 0.32 mm ¬• 40 mm) were used.
Needles were inserted to a depth of 10 15 mm and retained for 30 minutes.
Manual stimulation was used to elicit "DeQi.\"""" ;
    tara-kb:hasStimulationTypeDetails "The needles were stimulated manually by twirling and lifting thrusting to elicit \"DeQi\" sensation. No moxibustion or electrical stimulation was used." ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not provide TCM terminology for the condition)" ;
    tara-kb:hasStudiedWesternCondition "Migraine" ;
    tara-kb:hasStudyFindings "Yes, the acupuncture intervention was effective compared to the control/sham group based on the primary outcome of VAS scores for pain relief, with a significant difference (P = 0.001)." ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Visual analogScale (VAS)Scores forPain 24 hours after acupuncture.
Secondary outcome measures:
Short Form of McGillPain Questionnaire (SF MPQ)Scores at 24 hours after acupuncture.
The number ofPatients achieving freedom fromPain in 0 24 hours, 24 48 hours, and 48 72 hours.
The number ofPeople with acute medication and the dosage of medication.
The number ofPeople with nausea and vomiting at 24 hours, 48 hours, and 72 hours.
The recurrence of migraine attack.
The number ofPatients with adverse effects (AE) within 72 hours.""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: 30 minutes
Duration needles were left in place: 30 minutes""" ;
    tara-kb:hasTreatmentFrequency "Not specified (the paper only mentions a single session of acupuncture treatment lasting 30 minutes, with no information on frequency or repeated treatments)" .

tara-kb:S-112625-1728 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1728" ;
    dc:title "Effects of Electroacupuncture on Depression and the Production of Glial Cell Line-Derived Neurotrophic Factor Compared with Fluoxetine: A Randomized Controlled Pilot Study" ;
    tara-kb:hasAcupunctureProtocol """Treatment Group: Baihui (DU20), Zusanli (ST36)
Control Group: Taichong (LR3), Sanyinjiao (SP6), Neiguan (PC6), Shenmen (HT7)
Locations:
DU20: Vertex of the head
ST36: Conjunction point of the stomach channel of the foot-yangming
LR3: Liver meridian of the foot-jueyin
SP6: Intersection point of the liver, spleen, and kidneys
PC6: Contact point in the pericardium meridian of the hand-jueyin
HT7: Original point in the heart meridian of the hand-shaoyin
Selection Criteria: Long-term clinical experience and common use in China
Needle Insertion Depth: 0.25 cm to 0.40 cm
Technique: Reinforcing-reducing stimulation until "DeQi" sensation is obtained""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Pilot Study" ;
    tara-kb:hasControlGroupsDetails """EA control group: 16 patients treated with EA on acupoints Taichong (LR3), Sanyinjiao (SP6), Neiguan (PC6), and Shenmen (HT7).
Fluoxetine group: 25 patients treated with oral fluoxetine (20 mg/day) for 6 weeks.""" ;
    tara-kb:hasCountryOfStudy "China" ;
    tara-kb:hasDatasetLink "Not specified" ;
