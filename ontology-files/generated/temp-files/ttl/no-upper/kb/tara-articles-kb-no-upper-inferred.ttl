tara-kb:S-112625-1805 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1805" ;
    dc:title "Therapeutic Efficacy Observation on Electroacupuncture for Ovulatory Dysfunctional Infertility" ;
    tara-kb:hasAcupunctureProtocol """Major acupoints: Guanyuan (CV 4), Zhongji (CV 3), bilateral Zigong (Ex CA 1), Zusanli (ST 36), Sanyinjiao (SP 6)
Adjunct acupoints: Bilateral Shenshu (BL 23), Ciliao (BL 32) when follicle diameter is over 16 mm
Needle insertion: 1.5 cun perpendicularly using filiform needles of 50 mm in length
Rationale: Based on roles in traditional Chinese medicine, such as dominating yin blood and reinforcing the kidney""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Control group: 27 patients
Intervention: Oral Clomifene Citrate Tablets, 50 mg once a day for 5 days
Timing: Treatment started on the 5th day after menstruation and ceased on the 10th day
Cure rate: 48.1%""" ;
    tara-kb:hasCountryOfStudy "Not specified (the paper does not explicitly mention the country where the study was conducted)" ;
    tara-kb:hasDatasetLink "Not specified" ;
