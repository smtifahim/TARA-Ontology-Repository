        "intertragal incisure",
        "intertragic incisure",
        "intertragic notch" ;
    OboInOwl:hasRelatedSynonym "anterior auricular groove",
        "auricular notch",
        "incisura anterior auris",
        "intertragic incisure",
        "sulcus auriculae anterior" ;
    rdfs:comment "Measurement notes: The length is measured from the upper to the lower border (between tragus and antitragus)" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001757 ],
        UBERON:0006846 .

