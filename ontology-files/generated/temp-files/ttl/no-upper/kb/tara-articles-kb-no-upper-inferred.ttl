            owl:someValuesFrom UBERON:0035549 ],
        UBERON:0001638 .

UBERON:3000961 a owl:Class ;
    rdfs:label "external integument structure" ;
    IAO:0000115 "Structures of the dermis, epidermis, glands and pigment cells recognizable on the external surfaces of the integument." ;
