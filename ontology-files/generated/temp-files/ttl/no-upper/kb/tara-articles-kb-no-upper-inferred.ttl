UBERON:0017750 a owl:Class ;
    rdfs:label "proximal mesopodial endochondral element" ;
    IAO:0000115 "A mesopodial endochondral element that is in the most proximal part of the mesopodial skeleton, connected to the zeugopodial skeleton." ;
    IAO:0000116 "awaiting approval by phenoscape curators" ;
    rdfs:subClassOf [ a owl:Restriction ;
