UBERON:0011134 a owl:Class ;
    rdfs:label "nonsynovial joint" ;
    IAO:0000115 "Joint in which the articulating bones or cartilages are connected by ligaments or fibrocartilage without an intervening synovial cavity. Examples: sagittal suture, inferior tibiofibular syndesmosis, costochondral joint, pubic symphysis." ;
    OboInOwl:hasDbXref "FMA:7491" ;
    OboInOwl:hasExactSynonym "solid joint" ;
    rdfs:subClassOf UBERON:0000982 .

