TARA:4385250 a owl:Class ;
    rdfs:label "SP 6" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 72. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "三陰(阴)交" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "Superficially, the medial crural cutaneous nerve; deeper, in the posterior aspect, the tibial nerve." ;
    tara-ap:hasListedIndications "abdominal pain, borborygmus, abdominal distension, diarrhea, dysmenorrhea, irregular menstruation, uterine bleeding, morbid leukorrhea, prolapse of the uterus, infertility, delayed labor, nocturnal emission, impotence, enuresis, dysuria, edema, hernia, pain in the external genitalia, muscular atrophy, motor impairment, paralysis and pain of the lower extremities, headache, dizziness and vertigo, insomnia." ;
    tara-ap:hasLocationalDescription "On the tibial aspect of the leg, posterior to the medial border of the tibia, 3 B-cun superior to the prominence of the medial malleolus. Note: 1 B-cun superior to KI8." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable. Acupuncture on this point is contraindicated in pregnant women." ;
    tara-ap:hasPinyinLabel "Sanyinjiao" ;
    tara-ap:hasRelatedArtery UBERON:0001538 ;
    tara-ap:hasRelatedNerve UBERON:0001323,
        ILX:0797485 ;
    tara-ap:hasRelatedVein UBERON:0001363,
        UBERON:0001546 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0000979,
        ILX:0795305 ;
    tara-ap:hasSynonym "Spleen 6" ;
    tara-ap:hasVasculatureInformation "The great saphenous vein, the posterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4167850 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedArtery ;
            owl:someValuesFrom UBERON:0001538 ],
