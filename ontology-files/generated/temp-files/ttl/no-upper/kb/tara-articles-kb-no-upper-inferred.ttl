        "TB 21",
        "TH 21",
        "TW 21",
        "Triple Burner 21",
        "Triple Energizer 21",
        "Triple Heater 21",
        "Triple Warmer 21" ;
    tara-ap:hasVasculatureInformation "The superficial temporal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
