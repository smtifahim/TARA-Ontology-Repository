TARA:0780558 a owl:Class ;
    rdfs:label "LR 5" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 198. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "蠡溝(沟)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "The branch of the saphenous nerve." ;
    tara-ap:hasListedIndications "retention of urine, enuresis, hernia, irregular menstruation, leukorrhea, pruritus vulvae, weakness and atrophy of the leg." ;
    tara-ap:hasLocationalDescription "On the anteromedial aspect of the leg, at the centre of the medial border (surface) of the tibia, 5 B-cun proximal to the prominence of the medial malleolus. Note: LR5 is located at the same level as the upper two thirds and lower one third of the line connecting the apex of the patella with the prominence of the medial malleolus, at the centre of the medial border (surface) of the tibia, at the same level as KI9." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Ligou" ;
    tara-ap:hasSpecialPointRole TARA:6993030 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0000979,
        UBERON:0002446,
        ILX:0795305 ;
    tara-ap:hasSynonym "LIV 5",
        "LV 5",
        "Liver 5" ;
    tara-ap:hasVasculatureInformation "Posteriorly, the great saphenous vein." ;
    tara-ap:isLocatedOnMeridian TARA:5419503 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:2162578 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003823 ] ],
        [ a owl:Restriction ;
