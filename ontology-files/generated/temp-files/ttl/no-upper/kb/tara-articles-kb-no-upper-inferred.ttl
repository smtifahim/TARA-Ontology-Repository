        TARA:9020892 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:9020892\": \"PC 7\", \"TARA:0859695\": \"LI 4\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition MONDO:0004833 ;
    tara-kb:hasNeedlingDetails "10 mm" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-226 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-226 ;
    tara-kb:hasSampleSizeDetails """Total participants analyzed: 53
Treatment group (PC7): 28
Control group (LI4): 25""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (the study does not include a sham acupuncture group)" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation to obtain Deqi sensation (dull ache, numbness, or heaviness) using sterile acupuncture needles. Needles were inserted perpendicularly with slight rotation and thrusting, and manipulated every 5 minutes to maintain the Deqi sensation." ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not provide a TCM condition or disease name for plantar fasciitis)" ;
    tara-kb:hasStudiedWesternCondition "Plantar fasciitis" ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Morning pain on a 100-point visual analog scale (VAS) at one month post-treatment.
Secondary outcome measures: Activity pain (heel pain during activity) on a VAS.
Overall pain rating on a VAS.
Pressure pain threshold using algometry.""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: 30 minutes
Duration needles were left in place: Not specified (implied to be throughout the 30-minute session with manipulation every 5 minutes)""" ;
    tara-kb:hasTreatmentFrequency "Five times a week for 2 weeks; each session lasted 30 minutes." .

