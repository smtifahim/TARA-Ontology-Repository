        "Abnormally shaped kidney",
        "Kidney malformation",
        "Kidney structure issue",
        "Renal malformation",
        "Structural anomalies of the renal tract",
        "Structural kidney abnormalities",
        "Structural renal anomalies" ;
    rdfs:subClassOf HP:0000077 .

HP:0012318 a owl:Class ;
    rdfs:label "Occipital neuralgia" ;
    IAO:0000115 "A distinct type of headache characterized by piercing, throbbing, or electric-shock-like chronic pain in the upper neck, back of the head, and behind the ears, usually on one side." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2013-08-10T01:07:45+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:71760005",
        "UMLS:C0007863" ;
    rdfs:comment "Typically, the pain of occipital neuralgia begins at the base of the head and spreads upward within the distribution of the greater and lesser occipital nerves. Characteristically, it is neuropathic, with paroxysmal episodes of shooting electric shock-like symptoms." ;
    rdfs:subClassOf HP:0002315,
        HP:0033345 .

HP:0012372 a owl:Class ;
    rdfs:label "Abnormal eye morphology" ;
    IAO:0000115 "A structural anomaly of the globe of the eye, or bulbus oculi." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2013-10-13T03:44:43+00:00"^^xsd:dateTime ;
    OboInOwl:hasAlternativeId "HP:0000489",
        "HP:0012374" ;
    OboInOwl:hasDbXref "Fyler:4863",
        "UMLS:C4022925" ;
    OboInOwl:hasExactSynonym "Abnormal eye structure",
        "Abnormality of the globe",
        "Abnormally shaped eye" ;
    rdfs:comment "previously: Abnormal globe morphology" ;
    rdfs:subClassOf HP:0000478 .

HP:0012373 a owl:Class ;
    rdfs:label "Abnormal eye physiology" ;
    IAO:0000115 "A functional anomaly of the eye." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2013-10-13T03:45:37+00:00"^^xsd:dateTime ;
    OboInOwl:hasBroadSynonym "Abnormal vision physiology" ;
    OboInOwl:hasDbXref "UMLS:C4022924" ;
    OboInOwl:hasExactSynonym "Abnormal eye physiology" ;
    rdfs:subClassOf HP:0000478 .

HP:0012432 a owl:Class ;
    rdfs:label "Chronic fatigue" ;
    IAO:0000115 "Subjective feeling of tiredness characterized by a lack of energy and motivation that persists for six months or longer." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2013-11-13T07:49:08+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C0518656" ;
    OboInOwl:hasExactSynonym "Chronic extreme exhaustion",
        "Chronic fatigue" ;
    rdfs:comment "Note that chronic fatigue can be a symptom of chronic fatigue syndrome (CFS), which is characterized by profound fatigue that is not improved by bed rest and that may be worsened by physical or mental activity. Symptoms of CFS may include weakness, muscle pain, impaired memory, impaired mental concentration, and insomnia, which can result in reduced participation in daily activities." ;
    rdfs:subClassOf HP:0012378 .

HP:0012444 a owl:Class ;
    rdfs:label "Brain atrophy" ;
    IAO:0000115 "Partial or complete wasting (loss) of brain tissue that was once present." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2013-11-23T02:46:15+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:278849000",
        "SNOMEDCT_US:418143002",
        "SNOMEDCT_US:52522001",
        "UMLS:C0154671",
        "UMLS:C0235946" ;
    OboInOwl:hasExactSynonym "Brain degeneration",
        "Brain wasting" ;
    rdfs:subClassOf HP:0007367,
        HP:0012443 .

HP:0012450 a owl:Class ;
    rdfs:label "Chronic constipation" ;
    IAO:0000115 "Constipation for longer than three months with fewer than 3 bowel movements per week, straining, lumpy or hard stools, and a sensation of anorectal obstruction or incomplete defecation." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2013-11-23T04:03:43+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:236069009",
        "UMLS:C0401149" ;
    OboInOwl:hasExactSynonym "Chronic constipation",
        "Infrequent bowel movements" ;
    rdfs:subClassOf HP:0002019 .

HP:0012513 a owl:Class ;
    rdfs:label "Upper limb pain" ;
    IAO:0000115 "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the arm." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2013-12-08T09:07:11+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:102556003",
        "UMLS:C0239377" ;
    OboInOwl:hasExactSynonym "Upper limb pain" ;
    rdfs:subClassOf HP:0009763 .

HP:0012514 a owl:Class ;
    rdfs:label "Lower limb pain" ;
    IAO:0000115 "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the leg." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2013-12-08T09:10:29+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:10601006",
        "UMLS:C0023222" ;
    OboInOwl:hasExactSynonym "Leg pain",
        "Lower limb pain" ;
    rdfs:subClassOf HP:0009763 .

HP:0012639 a owl:Class ;
    rdfs:label "Abnormal nervous system morphology" ;
    IAO:0000115 "A structural anomaly of the nervous system." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-01-19T08:03:08+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "Fyler:4135",
        "Fyler:4300",
        "UMLS:C4022810" ;
    OboInOwl:hasExactSynonym "Abnormal shape of nervous system",
        "Abnormality of nervous system morphology" ;
    rdfs:subClassOf HP:0000707 .

HP:0012647 a owl:Class ;
    rdfs:label "Abnormal inflammatory response" ;
    IAO:0000115 "Any anomaly of the inflammatory response, a response to injury or infection characterized by local vasodilation, extravasation of plasma into intercellular spaces and accumulation of white blood cells and macrophages." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-02-01T01:25:42+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4022805" ;
    OboInOwl:hasExactSynonym "Abnormal inflammatory response" ;
    rdfs:subClassOf HP:0010978 .

HP:0012718 a owl:Class ;
    rdfs:label "Abnormal gastrointestinal tract morphology" ;
    IAO:0000115 "Abnormal structure of the gastrointestinal tract." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-03-23T01:09:02+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4021073" ;
    OboInOwl:hasExactSynonym "Abnormal shape of the digestive system",
        "Morphological abnormality of the GI tract",
        "Morphological abnormality of the gastrointestinal tract",
        "Morphological anomaly of the digestive system" ;
    rdfs:subClassOf HP:0011024,
        HP:0025033 .

HP:0012743 a owl:Class ;
    rdfs:label "Abdominal obesity" ;
    IAO:0000115 "Excessive fat around the stomach and abdomen." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-03-23T05:00:05+00:00"^^xsd:dateTime ;
