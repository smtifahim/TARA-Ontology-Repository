        TARA:3135569,
        TARA:4311153,
        TARA:4385250,
        TARA:6463344,
        TARA:6499349 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:0859695\": \"LI 4\", \"TARA:4385250\": \"SP 6\", \"TARA:4311153\": \"PC 6\", \"TARA:6463344\": \"ST 36\", \"TARA:6499349\": \"LR 3\", \"TARA:3135569\": \"Yintang\"}"^^rdf:JSON ;
    tara-kb:hasListedAcupointsUnmappable "auricular points" ;
    tara-kb:hasMappedWesternCondition MONDO:0004992 ;
    tara-kb:hasNeedlingDetails "1 fen to 3 tsun" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1350 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1350 ;
    tara-kb:hasSampleSizeDetails "Total participants analyzed: 138; Intervention group: 93; Control group: 45" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used)" ;
    tara-kb:hasStimulationTypeDetails "The needles were stimulated to achieve de qi, which is a sensation typically described as heaviness, numbness, or warmth at the needle site. The needles were inserted to a depth of 1 fen to 3 tsun and retained for 20 minutes. No additional stimulation methods such as manual manipulation, electrical stimulation, thermal stimulation, or laser stimulation were mentioned." ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly mention a TCM disease or condition)" ;
    tara-kb:hasStudiedWesternCondition "Cancer (postoperative symptoms)" ;
    tara-kb:hasStudyFindings "Yes, the acupuncture intervention was effective compared to the control group based on the primary outcome of pain reduction (p = 0.038) and depressive mood reduction (p = 0.003)." ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Between-group difference in pain scores on an 11-point (0-10) pain numeric rating scale (NRS) for severity of current pain and for pain during the previous 24 hours.
Secondary outcome measures:
Nausea on an 11-point (0-10) nausea NRS for current nausea intensity and nausea during the previous 24 hours.
Vomiting as the self-reported number of vomiting episodes during the previous 24 hours.
Mood by tension and depressive mood subscales of the Profile of Mood States Short Form (POMS-SF).
Costs of health care, as assessed by type of care for the postoperative stay, except for medications, which were compared for the three-day study period only.""" ;
    tara-kb:hasTreatmentDuration """Massage: Duration varied from 10 to 30 minutes; mean duration 20 minutes.
Acupuncture: Needles retained for 20 minutes.""" ;
    tara-kb:hasTreatmentFrequency "Massage and acupuncture were administered twice during the study period, on postoperative Days 1 and 2. Massage duration varied from 10 to 30 minutes (mean 20 minutes), and acupuncture needles were retained for 20 minutes." .

