TARA:1074531 a owl:Class ;
    rdfs:label "LR 8" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 199. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "曲泉" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001465 ;
    tara-ap:hasInnervationInformation "The saphenous." ;
    tara-ap:hasListedIndications "prolapse of the uterus, lower abdominal pain, retention of urine, nocturnal emission, pain in the external genitalia, pruritus vulvae, pain in the medial aspect of the knee and thigh." ;
    tara-ap:hasLocationalDescription "On the medial aspect of the knee, in the depression medial to the tendons of the semitendinosus and the semimembranosus muscles, at the medial end of the popliteal crease. Note: With the knee flexed, LR8 is located in the depression medial to the most prominent tendon on the medial end of the popliteal crease." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Ququan" ;
    tara-ap:hasSpecialPointRole TARA:6594221 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001381,
        UBERON:8480009,
        ILX:0795330 ;
    tara-ap:hasSynonym "LIV 8",
        "LV 8",
        "Liver 8" ;
    tara-ap:hasVasculatureInformation "Anteriorly, the great saphenous vein, on the pathway of the genu su prema artery." ;
    tara-ap:isLocatedOnMeridian TARA:5419503 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:8480009 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001381 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001465 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795330 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:4109407 ],
        TARA:0739106,
        TARA:6594221 .

TARA:1460220 a owl:Class ;
    rdfs:label "BL 1" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 100. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "睛(睛)明" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasInnervationInformation "Superficially, the supratrochlear and infratrochlear nerves; deeper, the branches of the oculomotor nerve, the ophthalmic nerve." ;
    tara-ap:hasListedIndications "redness, swelling and pain of the eye, itching of the canthus, lacrimation, night blindness, color blindness, blurred vision, myopia." ;
    tara-ap:hasLocationalDescription "On the face, in the depression between the superomedial parts of the inner canthus of the eye and the medial wall of the orbit. Note: When the eye is closed, BL1 is located in the depression 0.1 B-cun superior and medial to the inner canthus of the eye." ;
    tara-ap:hasMethodDescription "Ask the patient to close his eyes when pushing gently the eyeball to the lateral side. Puncture slowly perpendicularly 0.3-0.7 inch along the orbital wall. It is not advisable to twist of lift and thrust the needle vigorously. To avoid bleeding, press the puncturing site for a few seconds after withdrawal of the needle. Moxibustion is forbidden." ;
    tara-ap:hasPinyinLabel "Jingming" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0000019,
        UBERON:0004867,
        UBERON:0005611 ;
    tara-ap:hasSynonym "B 1",
        "Bladder 1",
        "UB 1",
        "Urinary Bladder 1" ;
    tara-ap:hasVasculatureInformation "The angular artery and vein, deeper, superiorly, the ophthalmic artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0005611 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001456 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004867 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000019 ] ],
        TARA:0995552 .

TARA:1594912 a owl:Class ;
    rdfs:label "TE 4" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 159. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "陽(阳)池" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0004452 ;
    tara-ap:hasInnervationInformation "The terminal branch of the posterior antebrachial cutaneous nerve and the dorsal branch of the ulnar nerve." ;
    tara-ap:hasListedIndications "pain in the arm, shoulder and wrist, malaria, deafness, thirst." ;
    tara-ap:hasLocationalDescription "On the posterior aspect of the wrist, in the depression ulnar to the extensor digitorum tendon, on the dorsal wrist crease. Note 1: TE4 can be palpated when moving proximally along the gap between the fifth and fourth metacarpal bones, at the same level as LI5 and SI5. Note 2: When the wrist is extended against resistance, the extensor digitorum tendon can be palpated more easily." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Yangchi" ;
    tara-ap:hasSpecialPointRole TARA:1840369 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003648,
        UBERON:0003649,
        ILX:0795333,
        ILX:0795502 ;
    tara-ap:hasSynonym "SJ 4",
        "San Jiao 4",
        "TB 4",
        "TH 4",
        "TW 4",
        "Triple Burner 4",
        "Triple Energizer 4",
        "Triple Heater 4",
        "Triple Warmer 4" ;
    tara-ap:hasVasculatureInformation "The dorsal venous network of the wrist and the posterior carpal artery." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
