    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham group was used in the study)" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation (lifting-thrusting and twirling) for about 30 seconds every 10 minutes." ;
    tara-kb:hasStudiedTCMCondition "Excess patterns of dysmenorrhea due to stagnation of the liver-qi" ;
    tara-kb:hasStudiedWesternCondition "Primary dysmenorrhea" ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Cox Menstrual Symptom Scale (CMSS)
