TARA:1628341 a owl:Class ;
    rdfs:label "BL 62" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 130. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "申脈(脉)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "The sural nerve." ;
    tara-ap:hasListedIndications "epilepsy, mania, headache, dizziness, insomnia, backache, aching of the leg." ;
    tara-ap:hasLocationalDescription "On the lateral aspect of the foot, directly inferior to the prominence of the lateral malleolus, in the depression between the inferior border of the lateral malleolus and the calcaneus. Note: BL62 is located in the depression distal to the inferior border of the lateral malleolus. the corresponding medial acupuncture point to BL 62 is KI6." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Shenmai" ;
    tara-ap:hasSpecialPointRole TARA:9493899 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001450,
        UBERON:0012291 ;
    tara-ap:hasSynonym "B 62",
        "Bladder 62",
        "UB 62",
        "Urinary Bladder 62" ;
    tara-ap:hasVasculatureInformation "The external malleolar arterial network." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001450 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0012291 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002387 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:3091322 ],
        TARA:0995552,
        TARA:9493899 .

TARA:4839095 a owl:Class ;
    rdfs:label "BL 21" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 110. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "胃兪(俞)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasInnervationInformation "The medial cutaneous branch of the posterior ramus of the twelfth thoracic nerve; deeper, its lateral branch." ;
    tara-ap:hasListedIndications "pain in the chest and hypochondriac and epigastric regions, anorexia, abdominal distension, borborygmus, diarrhea, nausea, vomiting." ;
    tara-ap:hasLocationalDescription "In the upper back region, at the same level as the inferior border of the spinous process of the 12th thoracic vertebra (T12), 1.5 B- cun lateral to the posterior median line." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5-0.8 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Weishu" ;
    tara-ap:hasSpecialPointRole TARA:1503026 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004636,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 21",
        "Back-Shu Point of the Stomach",
        "Bladder 21",
        "UB 21",
        "Urinary Bladder 21" ;
    tara-ap:hasVasculatureInformation "The medial branches of the posterior branches of the subcostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004636 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795312 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:6397214 ],
