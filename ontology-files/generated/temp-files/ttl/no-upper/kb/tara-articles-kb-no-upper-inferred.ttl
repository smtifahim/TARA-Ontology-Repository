    tara-ap:hasChineseLabel "中膂兪(俞)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0005473 ;
    tara-ap:hasInnervationInformation "The lateral branches of the posterior rami of the third and fourth sacral nerves." ;
    tara-ap:hasListedIndications "dysentery, hernia, stiffness and pain of the lower back." ;
    tara-ap:hasLocationalDescription "In the sacral region, at the same level as the third posterior sacral foramen, 1.5 B-cun lateral to the median sacral crest. Note: At the same level as BL33." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhonglushu" ;
    tara-ap:hasSpecificReferenceLocation ILX:0741680,
        ILX:0795315 ;
    tara-ap:hasSynonym "B 29",
        "Bladder 29",
        "UB 29",
        "Urinary Bladder 29" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the lateral sacral artery and vein, the branches of the inferior gluteal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
