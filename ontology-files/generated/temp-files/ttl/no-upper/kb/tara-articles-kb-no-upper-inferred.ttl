    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 176. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "天衝(冲)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The branch of the great occipital nerve." ;
    tara-ap:hasListedIndications "headache, epilepsy, swelling and pain of the gums, convulsion." ;
    tara-ap:hasLocationalDescription "On the head, directly superior to the posterior border of the auricular root, 2 B-cun superior to the hairline. Note: GB9 is 0.5 B-cun posterior to GB8." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch." ;
    tara-ap:hasPinyinLabel "Tianchong" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004104 ;
    tara-ap:hasSynonym "G 9",
        "Gallbladder 9" ;
    tara-ap:hasVasculatureInformation "The posterior auricular artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004104 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ],
        TARA:1926756 .

TARA:1051162 a owl:Class ;
    rdfs:label "SI 7" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 91. https://iris.who.int/handle/10665/353407",
