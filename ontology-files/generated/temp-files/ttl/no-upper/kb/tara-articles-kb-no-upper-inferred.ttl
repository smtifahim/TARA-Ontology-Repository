        "AT 3",
        "TF 4" ;
    tara-kb:hasNeedlingDetails "1-2 mm under the skin" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-20 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-20 ;
    tara-kb:hasSampleSizeDetails "Total participants: 10; Control group: 10; Acupuncture group: 10" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used)" ;
    tara-kb:hasStimulationTypeDetails "Not specified (the paper does not mention any additional stimulation methods beyond needle insertion)" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly mention a TCM disease or condition)" ;
    tara-kb:hasStudiedWesternCondition "Not specified (the paper focuses on anaesthetic requirement and analgesia during surgery, not a specific disease or condition)" ;
    tara-kb:hasStudyFindings "Yes, acupuncture was effective compared to the control group in reducing anaesthetic requirement, with a statistically significant reduction of 8.5% (p = 0.003)." ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Anaesthetic requirement determined by the Dixon up-and-down method, defined by the average desflurane concentration that prevents purposeful movement in response to noxious electrical stimulation.
Secondary outcome measures: Demographic characteristics (age, weight, height), duration of anesthesia, postoperative nausea and vomiting, physiological parameters (mean arterial pressure, heart rate, core temperature, end-tidal CO2 levels).""" ;
    tara-kb:hasTreatmentDuration "Not specified (the paper does not provide explicit information on the duration of each acupuncture session or how long the needles were left in place)" ;
    tara-kb:hasTreatmentFrequency "Not specified (the paper does not provide information on the frequency of acupuncture treatments beyond the two study days)" .

tara-kb:S-112625-200 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-200" ;
    dc:title "Acupuncture and Auricular Acupressure in Relieving Menopausal Hot Flashes of Bilaterally Ovariectomized Chinese Women: A Randomized Controlled Trial" ;
    tara-kb:hasAcupunctureProtocol """Sanyinjiao (SP6): Treats disorders of the spleen, liver, and kidney.
Fengchi (GB20): Regulates liver function and removes heat from the head and eye.
Hegu (LI4): Clears heat in the Upper and Middle Jiao.
Quchi (LI11): Produces hypothermia in normal subjects.
Guanyuan (CV4): Reinforces kidney Qi and replenishes Qi and blood.
Dazhui (GV14): Produces hypothermia in normal adults.
Fuliu (KI7): Regulates kidney Qi and sweating.
Zigong (EX-CA1): Treats female disorders.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Acupuncture and auricular acupressure group (n = 21)
Hormone replacement therapy (HRT) group (Tibolone, n = 25)
No sham-acupuncture control group was used.""" ;
