    tara-kb:hasMappedWesternCondition HP:0031217,
        MONDO:0007254 ;
    tara-kb:hasNeedlingDetails """Traditional Acupuncture: 0.5 to 3.0 cm
Sham Acupuncture: 2-3 mm""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-577 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-577 ;
    tara-kb:hasSampleSizeDetails "Total sample size: 59; Traditional Acupuncture (TA) group: 30; Sham Acupuncture (SA) group: 29" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: Real needles
Quantity: Eight points (four bilateral points)
Size: Identical needles to those used in traditional acupuncture
