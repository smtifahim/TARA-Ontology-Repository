    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:8393005\": \"TE 5\", \"TARA:8923096\": \"LI 11\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition HP:0012532 ;
    tara-kb:hasNeedlingDetails "subcutaneous layer (not specified in mm or cm)" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-872 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-872 ;
    tara-kb:hasSampleSizeDetails """Total participants: 20
Participants in each group: 10 (Acupuncture Group), 10 (Sham-Acupuncture Group)""" ;
    tara-kb:hasShamAcupunctureDetails """Sham procedure: Non-penetrating sham acupuncture
Needle type: Real acupuncture needle
Quantity: Not specified
Size: Not specified
Location: Marked point for acupuncture (similar to real points)
Penetration: Non-penetrating (inserted into a rubber connector)
Other details: Needle stayed in place without moving during treatment""" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation (screwing in-and-out technique) to induce De Qi effect (soreness or pain and/or local twitch responses)" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly mention a TCM term for the condition)" ;
    tara-kb:hasStudiedWesternCondition "Chronic pain associated with myofascial trigger points (MTrPs) in the upper trapezius muscle." ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Subjective pain intensity (numerical pain rating scale) and mean EPN amplitude in the MTrP of the upper trapezius muscle.
Secondary outcome measures: Not specified.""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: The in-and-out movement of the needle was performed for 15 seconds, followed by the needle being stationary for at least 3 minutes. The sequence involved manipulating the needles at two points with specific time frames for each manipulation and rest period.
Needles were left in place for at least 3 minutes after each manipulation.""" ;
    tara-kb:hasTreatmentFrequency "Not specified (the paper does not provide information on the frequency or duration of treatment sessions)" .

