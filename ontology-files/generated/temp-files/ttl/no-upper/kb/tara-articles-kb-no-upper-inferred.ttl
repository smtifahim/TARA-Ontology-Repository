    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:5717468\": \"ST 25\", \"TARA:1992799\": \"SP 14\", \"TARA:5918799\": \"ST 37\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition HP:0002019 ;
    tara-kb:hasNeedlingDetails """Deep puncture: Deep to the parietal peritoneum (ST25 and SP14), 1 cun (ST37)
Shallow puncture: 2 mm""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-237 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-237 ;
    tara-kb:hasSampleSizeDetails """Total sample size: 67
Control group: 37
EA group: 35""" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: Real needles were used for both groups.
Quantity: Not specified.
Size: HuaTuo 0.30 √ó 75 mm needles for EA group; HuaTuo 0.30 √ó 40 mm needles for control group.
Location: Control group received treatment at non-acupoints located one cun away from actual acupoints.
Penetrating or non-penetrating: Penetrating with shallow puncture (2 mm depth).
Other details: No lifting and twisting in the control group.""" ;
    tara-kb:hasStimulationTypeDetails """Deep EA group: Electrical stimulation using an electric stimulator (HANS-200A) with frequencies of 2/15 Hz alternately and currents strong enough to produce a slight tremor in abdominal muscles. Manual manipulation at ST37 with lifting and twisting to achieve Deqi.
Control group: Electrical stimulation with same parameters as deep EA group but with shallow puncture.""" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly mention the condition in Traditional Chinese Medicine terminology)" ;
    tara-kb:hasStudiedWesternCondition "Functional Constipation (FC)" ;
    tara-kb:hasStudyFindings "Yes, the acupuncture intervention was effective compared to the control/sham group based on the primary outcome of CSBM frequency and cure rate." ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Complete spontaneous bowel movements (CSBM)
Secondary outcome measures: Spontaneous bowel movements (SBM), Bristol stool scores (BSS), hard defecation score, Patient Assessment of Constipation Quality of Life (PAC-QOL)""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: 30 minutes
Duration needles were left in place: 30 minutes""" ;
    tara-kb:hasTreatmentFrequency "5 treatments per week for the first two weeks, then 3 treatments per week for the following six weeks; total of 28 treatments over 8 weeks" .

tara-kb:S-112625-238 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-238" ;
    dc:title "Comparative effect of electroacupuncture and moxibustion on the expression of substance P and vasoactive intestinal peptide in patients with irritable bowel syndrome" ;
    tara-kb:hasAcupunctureProtocol "Zusanli (ST 36) and Shangjuxu (ST 37) were selected as acupoints for electroacupuncture or warm moxibustion treatment once a day for 14 consecutive days. These acupoints were located using the national GB-12346-90 acupoint standard." ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
