        "TW 18",
        "Triple Burner 18",
        "Triple Energizer 18",
        "Triple Heater 18",
        "Triple Warmer 18" ;
    tara-ap:hasVasculatureInformation "The posterior auricular artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
