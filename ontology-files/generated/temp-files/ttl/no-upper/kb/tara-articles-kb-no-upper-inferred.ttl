tara-kb:S-112625-799 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-799" ;
    dc:title "Influence of acupuncture on the pregnancy rate in patients who undergo assisted reproduction therapy" ;
    tara-kb:hasAcupunctureProtocol """Before embryo transfer: Cx6 (Neiguan), Sp8 (Diji), Liv3 (Taichong), Gv20 (Baihui), S29 (Guilai)
After embryo transfer: S36 (Zusanli), Sp6 (Sanyinjiao), Sp10 (Xuehai), Li4 (Hegu)
Auricular acupuncture: ear point 55 (Shenmen), ear point 58 (Zhigong), ear point 22 (Neifenmi), ear point 34 (Naodian)
Chosen based on TCM principles to relax the uterus and improve blood perfusion.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group consisted of 80 patients who underwent embryo transfer without any supportive therapy, specifically without acupuncture. They received usual care and remained lying still for 25 minutes after embryo transfer, but did not receive any additional intervention like acupuncture." ;
    tara-kb:hasCountryOfStudy "Germany" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Cx 6, Sp 8, Liv 3, Gv 20, S 29, S 36, Sp 6, Sp 10, Li 4, ear point 55, ear point 58, ear point 22, ear point 34" ;
