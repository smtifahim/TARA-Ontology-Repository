                    owl:someValuesFrom UBERON:0001461 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:4109407 ],
        TARA:3761087,
        TARA:6594221 .

TARA:8088170 a owl:Class ;
    rdfs:label "GB 26" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 184. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "帶(带,帯)脈(脉)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000916 ;
    tara-ap:hasInnervationInformation "The subcostal nerve." ;
    tara-ap:hasListedIndications "irregular menstruation, amenorrhea, leukorrhea, abdominal pain, hernia, pain in the lumbar and hypochondriac region." ;
    tara-ap:hasLocationalDescription "On the lateral abdomen, inferior to the free extremity of the 11th rib, at the same level as the centre of umbilicus. Note 1: GB26 can be located by first locat- ing the tenth rib, then searching for the free extremity of the 11th rib that is situated immediately below the inferior border of the costal arch. Note 2: GB 26 is inferior to LR 13, at the same level as CV 8." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Daimai" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002225,
        UBERON:0004610,
        UBERON:0007118 ;
    tara-ap:hasSynonym "G 26",
        "Gallbladder 26" ;
    tara-ap:hasVasculatureInformation "The subcostal artery and vem." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002225 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
