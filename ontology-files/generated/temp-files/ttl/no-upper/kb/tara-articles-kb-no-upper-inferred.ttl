ILX:0794952 a owl:Class ;
    rdfs:label "Medial cutaneous nerve of the arm" ;
    IAO:0000115 "The medial cutaneous nerve of the arm (also known as the medial brachial cutaneous nerve and the lesser internal cutaneous nerve) is a sensory branch of the medial cord of the brachial plexus derived from spinal nerves C8-T1. It provides sensory innervation to the lower portion of the medial arm. It descends accompanied by the basilic vein." ;
    isPartOf: UBERON:0001814 ;
    ilxtr:hasExistingId ILX:0794952 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001814 ],
        UBERON:0003433 .

ILX:0794967 a owl:Class ;
    rdfs:label "posterior interosseous nerve" ;
    IAO:0000115 "The continuation of the deep branch of the radial nerve after traversing the supinator muscle, supplying most extensor muscles of the forearm." ;
    isPartOf: ILX:0794977 ;
    ilxtr:hasExistingId ILX:0794967 ;
    OboInOwl:hasExactSynonym "Posterior antebrachial interosseous nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom ILX:0794977 ],
        UBERON:0001021 .

ILX:0794979 a owl:Class ;
    rdfs:label "dorsal scapular nerve" ;
    IAO:0000115 "The dorsal scapular nerve is a branch of the brachial plexus, usually derived from the ventral ramus of cervical nerve C5. It provides motor innervation to the rhomboid major muscle, rhomboid minor muscle, and sometimes the levator scapulae muscle." ;
    isPartOf: UBERON:0001814 ;
    ilxtr:hasExistingId ILX:0794979 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001814 ],
        UBERON:0001021 .

ILX:0795002 a owl:Class ;
    rdfs:label "iliohypogastric nerve" ;
    IAO:0000115 "The iliohypogastric nerve is a nerve that originates from the lumbar plexus that supplies sensation to skin over the lateral gluteal and hypogastric regions and motor to the internal oblique muscles and transverse abdominal muscles. It is derived from the ventral ramus of L1. It is a branch of the lumbar plexus that provides sensory innervation to the skin of the gluteal region and lower abdomen, as well as motor control to key muscles of the lower abdominal wall" ;
    isPartOf: UBERON:0034987 ;
    ilxtr:hasExistingId ILX:0795002 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0034987 ],
        UBERON:0001021 .

ILX:0795005 a owl:Class ;
    rdfs:label "Posterior cutaneous nerve of arm" ;
    IAO:0000115 "The posterior cutaneous nerve of arm (also known as posterior brachial cutaneous nerve) is a branch of the radial nerve that provides sensory innervation for much of the skin on the back of the arm. It is derived from the ventral rami of C5, C6, C7, and C8." ;
    isPartOf: UBERON:0001492 ;
    ilxtr:hasExistingId ILX:0795005 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001492 ],
        UBERON:0003433 .

ILX:0795284 a owl:Class ;
    rdfs:label "infraclavicular fossa" ;
    IAO:0000115 "A small triangular depression located inferior to the clavicle, bounded by the clavicle, deltoid, and pectoralis major muscles." ;
    isPartOf: UBERON:0001443 ;
    ILX:0777130 "https://www.imaios.com/en/e-anatomy/anatomical-structure/infraclavicular-fossa-1536888660" ;
    ilxtr:hasExistingId FMA:61541,
        ILX:0795284 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001443 ],
        UBERON:0004704 .

ILX:0795290 a owl:Class ;
    rdfs:label "nasolabial sulcus" ;
    IAO:0000115 "A shallow groove extending from the lateral aspect of the nostril to the corner of the mouth." ;
    isPartOf: UBERON:0001456 ;
    ILX:0777130 "https://www.imaios.com/en/e-anatomy/anatomical-structure/nasolabial-sulcus-1536888784" ;
    ilxtr:hasExistingId FMA:75018,
        ILX:0795290 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001456 ],
        UBERON:0000093 .

ILX:0795311 a owl:Class ;
    rdfs:label "posterior axillary fold" ;
    IAO:0000115 "The posterior axillary fold, also known as the posterior armpit fold, refers to the inferior border of the posterior wall of axilla." ;
    isPartOf: UBERON:0008785 ;
    ILX:0777130 "https://www.imaios.com/en/e-anatomy/anatomical-structure/posterior-axillary-fold-1536887776" ;
    ilxtr:hasExistingId FMA:322185,
        ILX:0795311 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0008785 ],
        UBERON:0001062 .

ILX:0795313 a owl:Class ;
    rdfs:label "first posterior sacral foramen" ;
    IAO:0000115 "The first opening in the posterior sacrum, allowing passage of sacral nerves." ;
    isPartOf: UBERON:0005473 ;
    ILX:0777130 "https://www.elsevier.com/resources/anatomy/nervous-system/peripheral-nervous-system/posterior-root-of-first-sacral-nerve/17108" ;
    ilxtr:hasExistingId FMA:31769,
        ILX:0795313 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0005473 ],
        UBERON:0001062 .

ILX:0795315 a owl:Class ;
    rdfs:label "third posterior sacral foramen" ;
    IAO:0000115 "The third opening in the posterior sacrum for sacral nerve passage." ;
    isPartOf: UBERON:0005473 ;
    ILX:0777130 "https://www.elsevier.com/resources/anatomy/nervous-system/peripheral-nervous-system/posterior-root-of-first-sacral-nerve/17108" ;
    ilxtr:hasExistingId FMA:31771,
        ILX:0795315 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0005473 ],
        UBERON:0001062 .

ILX:0795331 a owl:Class ;
    rdfs:label "suprasternal fossa" ;
    IAO:0000115 "This is the depression on the skin surface of the neck between the sternal heads of the sternocleidomastoid muscles. This area is situated just above the manubrium of the sternum and is a visible landmark in the neck." ;
    isPartOf: UBERON:0000974 ;
    ILX:0777130 "https://en.wikipedia.org/wiki/Suprasternal_notch" ;
    ilxtr:hasExistingId ILX:0795331 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000974 ],
        UBERON:0004704 .

ILX:0795335 a owl:Class ;
    rdfs:label "abductor pollicis longus tendon" ;
    IAO:0000115 "The tendon of the muscle that abducts and extends the thumb, located in the posterior compartment of the forearm." ;
    ilxtr:hasExistingId ILX:0795335 ;
    rdfs:subClassOf UBERON:0000043 .

ILX:0797482 a owl:Class ;
    rdfs:label "Medial dorsal cutaneous nerve of foot" ;
    IAO:0000115 "A terminal branch of the superficial fibular nerve supplying the medial dorsum of the foot and adjacent toes." ;
    isPartOf: UBERON:0035526 ;
    ilxtr:hasExistingId ILX:0797482 ;
    OboInOwl:hasExactSynonym "Medial dorsal cutaneous nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0035526 ],
        UBERON:0001021 .

ILX:0797484 a owl:Class ;
    rdfs:label "Proper plantar digital nerve" ;
    IAO:0000115 "A terminal branch of a plantar digital nerve supplying sensation to the sides of individual toes and adjacent plantar skin." ;
    isPartOf: UBERON:0035109 ;
    ilxtr:hasExistingId FMA:44741,
        ILX:0797484 ;
    OboInOwl:hasExactSynonym "Proper digital nerve of foot" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0035109 ],
        UBERON:0001021 .

ILX:0797490 a owl:Class ;
    rdfs:label "Dorsal digital nerve of ulnar nerve" ;
    IAO:0000115 "A sensory branch derived from the dorsal cutaneous branch of the ulnar nerve supplying the dorsal medial digits." ;
    isPartOf: UBERON:0001494 ;
    ilxtr:hasExistingId ILX:0797490 ;
    OboInOwl:hasExactSynonym "Dorsal digital branch of ulnar nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001494 ],
        UBERON:0001027 .

ILX:0797493 a owl:Class ;
    rdfs:label "Cervical branch of the facial nerve" ;
    IAO:0000115 "The lowest branch of the facial nerve that innervates the platysma muscle in the neck." ;
    isPartOf: UBERON:0001647 ;
    ilxtr:hasExistingId ILX:0797493 ;
    OboInOwl:hasExactSynonym "Cervical ramus of facial nerve" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001647 ],
        UBERON:0001021 .

ILX:0797497 a owl:Class ;
    rdfs:label "Radial collateral artery" ;
    IAO:0000115 "A terminal branch of the profunda brachii artery contributing to the arterial network around the elbow." ;
    isPartOf: UBERON:0001399 ;
    ilxtr:hasExistingId FMA:23120,
        ILX:0797497 ;
    OboInOwl:hasExactSynonym "Anterior descending branch of profunda brachii artery" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001399 ],
        UBERON:0001637 .

ILX:0797502 a owl:Class ;
    rdfs:label "Lateral circumflex femoral vein" ;
    IAO:0000115 "A vein accompanying the lateral circumflex femoral artery that drains the lateral thigh into the profunda femoris vein." ;
    isPartOf: UBERON:0001361 ;
    ilxtr:hasExistingId FMA:44326,
        ILX:0797502 ;
    OboInOwl:hasExactSynonym "Vena circumflexa femoris lateralis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001361 ],
        UBERON:0001638 .

ILX:0797504 a owl:Class ;
    rdfs:label "Descending genicular artery" ;
    IAO:0000115 "The final branch of the femoral artery that descends medially toward the knee and contributes to the genicular anastomosis." ;
    isPartOf: UBERON:0002060 ;
    ilxtr:hasExistingId FMA:22506,
        ILX:0797504 ;
    OboInOwl:hasExactSynonym "Arteria genus descendens" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0002060 ],
        UBERON:0001637 .

ILX:0797505 a owl:Class ;
    rdfs:label "Thoracoepigastric vein" ;
    IAO:0000115 "A superficial vein of the trunk connecting the lateral thoracic and superficial epigastric veins, providing collateral venous drainage between the axillary and femoral systems." ;
    isPartOf: UBERON:0000985 ;
    ilxtr:hasExistingId FMA:13416,
        ILX:0797505 ;
    OboInOwl:hasExactSynonym "Vena thoracoepigastrica" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000985 ],
        UBERON:0001638 .

ILX:0797507 a owl:Class ;
    rdfs:label "Ulnar recurrent artery" ;
    IAO:0000115 "An artery arising from the proximal ulnar artery that ascends toward the elbow and participates in the periarticular arterial network." ;
    isPartOf: UBERON:0001406 ;
    ilxtr:hasExistingId FMA:77140,
        ILX:0797507 ;
    OboInOwl:hasExactSynonym "Anterior ulnar recurrent artery",
        "Posterior ulnar recurrent artery" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001406 ],
        UBERON:0001637 .

ILX:0797508 a owl:Class ;
    rdfs:label "Ulnar recurrent vein" ;
    IAO:0000115 "A vein accompanying the ulnar recurrent arteries that drains blood from the elbow region into the ulnar venous system." ;
    ilxtr:hasExistingId ILX:0797508 ;
    OboInOwl:hasExactSynonym "Vena recurrens ulnaris" ;
    rdfs:subClassOf UBERON:0004259 .

ILX:0797510 a owl:Class ;
    rdfs:label "Posterior interosseous artery" ;
    IAO:0000115 "A branch of the common interosseous artery that supplies the posterior compartment of the forearm and participates in wrist anastomoses." ;
    isPartOf: UBERON:0001406 ;
    ilxtr:hasExistingId FMA:22811,
        ILX:0797510 ;
    OboInOwl:hasExactSynonym "Arteria interossea posterior" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001406 ],
        UBERON:0004259 .

ILX:0797511 a owl:Class ;
    rdfs:label "Posterior interosseous vein" ;
    IAO:0000115 "A vein accompanying the posterior interosseous artery that drains the extensor compartment of the forearm." ;
    ilxtr:hasExistingId FMA:22980,
        ILX:0797511 ;
    OboInOwl:hasExactSynonym "Vena interossea posterior" ;
    rdfs:subClassOf UBERON:0004259 .

ILX:0797514 a owl:Class ;
    rdfs:label "Circumflex scapular artery" ;
    IAO:0000115 "A branch of the subscapular artery that passes through the triangular space to supply muscles and structures on the posterior surface of the scapula." ;
    isPartOf: UBERON:0001397 ;
    ilxtr:hasExistingId FMA:23179,
        ILX:0797514 ;
    OboInOwl:hasExactSynonym "Arteria circumflexa scapulae" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001397 ],
        UBERON:0003515 .

ILX:0797515 a owl:Class ;
    rdfs:label "Circumflex scapular vein" ;
    IAO:0000115 "A vein accompanying the circumflex scapular artery that drains the scapular region into the subscapular vein." ;
    isPartOf: UBERON:0000985 ;
    ilxtr:hasExistingId FMA:77498,
        ILX:0797515 ;
    OboInOwl:hasExactSynonym "Vena circumflexa scapulae" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0000985 ],
        UBERON:0003515 .

ILX:0797525 a owl:Class ;
    rdfs:label "Dorsal digital veins" ;
    IAO:0000115 "Small superficial veins that drain the dorsal surfaces of the fingers or toes and empty into the dorsal venous networks of the hand or foot." ;
    ilxtr:hasExistingId FMA:70917,
        ILX:0797525 ;
    OboInOwl:hasExactSynonym "Digital dorsal veins",
        "Dorsal veins of digits" ;
    rdfs:subClassOf UBERON:0004563 .

ILX:0797526 a owl:Class ;
    rdfs:label "Dorsal venous network of hand" ;
    IAO:0000115 "A superficial venous network on the dorsum of the hand that receives blood from the dorsal digital and metacarpal veins and contributes to the cephalic and basilic veins." ;
    ilxtr:hasExistingId FMA:67977,
        ILX:0797526 ;
    OboInOwl:hasExactSynonym "Dorsal venous arch of hand",
        "Dorsal venous rete of hand" ;
    rdfs:subClassOf UBERON:0001638 .

ILX:0797528 a owl:Class ;
    rdfs:label "Radial collateral vein" ;
    IAO:0000115 "A vein accompanying the radial collateral artery that drains the lateral arm and elbow region into the deep venous system of the arm." ;
    isPartOf: UBERON:0001399 ;
    ilxtr:hasExistingId ILX:0797528 ;
    OboInOwl:hasExactSynonym "Vena collateralis radialis" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001399 ],
        UBERON:0001638 .

TARA:0214009 a owl:Class ;
    rdfs:label "GB 24" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 183. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "日月" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The seventh intercostal nerve." ;
    tara-ap:hasListedIndications "pain in the hypochondriac region, vomiting, acid regurgitation, hiccup, jaundice, mastitis." ;
    tara-ap:hasLocationalDescription "In the anterior thoracic region, in the sev- enth intercostal space, 4 B-cun lateral to the anterior median line. Note 1: GB 24 is inferior to the centre of the nipple, one rib inferior to LR 14. Note 2: In females, GB24 can be found at the intersection of the midclavicular line and the seventh intercostal space." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Riyue" ;
    tara-ap:hasSpecialPointRole TARA:4192840 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002030,
        ILX:0795285,
        ILX:0795321,
        ILX:0795322 ;
    tara-ap:hasSynonym "Front-Mu Point of the Gallbladder",
        "G 24",
        "Gallbladder 24" ;
    tara-ap:hasVasculatureInformation "The seventh intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
