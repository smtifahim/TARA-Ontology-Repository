tara-kb:S-112625-1385 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1385" ;
    dc:title "The Effect of Auricular Acupuncture on Olfactory Acuity" ;
    tara-kb:hasAcupunctureProtocol """Lung Point: Located on the cavum conchae, supplied by the auricular branch of the vagus nerve.
Criteria for point selection: Tender regions on the outer ear.
Needle insertion: Subcutaneously into bilateral Lung Points in a posterior direction to a depth of 0.2-0.3 mm.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group underwent a placebo stimulation where the needle was inserted and then immediately removed. Adhesive tape was applied to maintain the illusion of receiving actual acupuncture. This was a sham procedure to compare with the actual acupuncture stimulation in the study group." ;
    tara-kb:hasCountryOfStudy "Not specified (the paper does not explicitly state the country where the study was conducted)" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Lung Point" ;
    tara-kb:hasListedAcupointsUnmappable "Lung Point" ;
    tara-kb:hasNeedlingDetails "0.2-0.3 mm" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1385 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1385 ;
    tara-kb:hasSampleSizeDetails "Total sample size: 23; Study group: 12; Control group: 11" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: Real needle (same as study group)
Quantity: Same as study group
Size: Same as study group (0.12 mm in diameter)
Location: Same points as study group (Lung Point)
Penetrating: Yes, but only briefly
Other details: Adhesive tape applied to maintain blinding""" ;
    tara-kb:hasStimulationTypeDetails "Manual acupuncture with sterile steel needles inserted subcutaneously into the bilateral Lung Points and fixed for 6-7 days. No additional stimulation methods like electrical or thermal stimulation were mentioned." ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly mention a TCM disease or condition)" ;
    tara-kb:hasStudiedWesternCondition "Not specified (the paper focuses on olfactory acuity and sensitivity in healthy volunteers)" ;
    tara-kb:hasStudyFindings "Yes, the acupuncture intervention was effective compared to the control group in decreasing olfactory recognition thresholds for two standard odors (P<0.05)." ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Change in olfactory recognition thresholds
Secondary outcome measure: Change in detection thresholds""" ;
    tara-kb:hasTreatmentDuration """Duration of needle retention: 6-7 days
Duration of each acupuncture session: Not specified""" ;
    tara-kb:hasTreatmentFrequency "Not specified (the paper only mentions a single treatment session with the needle fixed for 6-7 days)" .

