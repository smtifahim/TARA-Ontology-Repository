tara-kb:S-112625-737 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-737" ;
    dc:title "Acupuncture Treatment as Breastfeeding Support: Preliminary Data" ;
    tara-kb:hasAcupunctureProtocol """SI 1 Shaoze (specific acupoint for milk ejection)
ST 18 Rugen (local acupoint for breast stimulation)
CV 17 Shanzhong (local acupoint for breast stimulation)
ST 36 Zusanli (added for Qi and Blood deficiency)
SP 6 Sanyinjiao (added for Qi and Blood deficiency)
BL 20 Pishu (added for Qi and Blood deficiency)
LR 3 Taichong (added for Liver Qi Stagnation)
PC 6 Neiguan (added for Liver Qi Stagnation)
Needle insertion: 0.3-mm-diameter sterile disposable steel needles, inserted to a depth of 10-30 mm
Manipulation: until De Qi sensation was reported; specific manipulation techniques included "raising and thrusting" and "twirling or rotating\"""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group consisted of women who made weekly visits to the clinic where the midwife observed their breastfeeding and provided routine care, without receiving any additional interventions like acupuncture." ;
    tara-kb:hasCountryOfStudy "Italy" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "SI 1, ST 18, CV 17, ST 36, SP 6, BL 20, LR 3, PC 6" ;
