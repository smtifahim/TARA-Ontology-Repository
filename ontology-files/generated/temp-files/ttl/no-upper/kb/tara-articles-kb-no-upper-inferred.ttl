            owl:someValuesFrom UBERON:0000165 ],
        UBERON:0003729 .

UBERON:0036294 a owl:Class ;
    rdfs:label "mucosa of lip" ;
    IAO:0000115 "A mucosa that is part of a lip region [Automatically generated definition]." ;
    OboInOwl:hasDbXref "NCIT:C12226" ;
