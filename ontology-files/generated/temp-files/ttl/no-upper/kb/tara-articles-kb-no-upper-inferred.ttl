tara-kb:S-112625-786 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-786" ;
    dc:title "Acupuncture for low back pain in pregnancy -a prospective, quasi-randomised, controlled study" ;
    tara-kb:hasClinicalTrialType "Pragmatic Controlled Trial" ;
    tara-kb:hasControlGroupsDetails "The control group consisted of eight placebo points used in a randomized controlled double-blind cross-over study design to compare with the vision-related acupoints. Stimulation at these placebo points did not show increases in blood flow velocity in both arteries." ;
    tara-kb:hasCountryOfStudy "Brazil" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "K 13, S 13, BL 62, BL 40, TE 5, GB 30, GB 41, Huatojiaji points" ;
