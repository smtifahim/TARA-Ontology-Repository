tara-kb:S-112625-141 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-141" ;
    dc:title "Acupuncture treatment of chronic low-back pain -a randomized, blinded, placebo-controlled trial with 9-month follow-up" ;
    tara-kb:hasAcupunctureProtocol """Body-points: Yaoyangguan (GV 3), Mingmen (GV 4), Shenshu (BL 23), Dachangshu (BL 25), Shangliao (BL 31), Ciliao (BL 32), Weizhong (BL 40), Kunlun (BL 60), Yanglingquan (GB 34), Sanyinjiao (SP 6), Yautungdien (extra meridian, at the back of the hand)
Ear-points: Os sacrum (38), Parasympathicus (51), Nervus ischiadicus (52), Lumbosacrum (54), Shenmen (55), Kidney (95)
Depth of body needling: 10-30 mm
Needle characteristics: Body needles 0.3 mm thick, 40 mm long; Ear needles 0.23 mm thick, ring-shaped, fixed by plaster
Sham-acupuncture: Needles inserted superficially, 10-20 mm distant to verum-acupoints, outside meridians, no stimulation""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Control Group (CG): Received active physiotherapy as routine care.
Sham-Acupuncture Group (SG): Received minimal acupuncture as a placebo control.""" ;
    tara-kb:hasCountryOfStudy "Germany" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "GV 3, GV 4, BL 23, BL 25, BL 31, BL 32, BL 40, BL 60, GB 34, SP 6, Yautungdien, Os sacrum, Parasympathicus, Nervus ischiadicus, Lumbosacrum, Ear Shenmen, Kidney" ;
