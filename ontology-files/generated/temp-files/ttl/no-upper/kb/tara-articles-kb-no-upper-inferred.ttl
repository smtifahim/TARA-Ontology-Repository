        "Front-Mu Point of the Small Intestine",
        "RN 4",
        "Ren 4",
        "VC 4" ;
    tara-ap:hasVasculatureInformation "The branches of superficial epigastric artery and vein, and the branches of inferior epigastric artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
