TARA:8452754 a owl:Class ;
    rdfs:label "GV 14" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 210. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "大椎" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasInnervationInformation "The posterior ramus of the eighth cervical nerve and the medial branch of the posterior ramus of the first thoracic nerve." ;
    tara-ap:hasListedIndications "neck pain and rigidity, malaria, febrile diseases, epilepsy, afternoon fever, cough, asthma, common cold, back stiffness." ;
    tara-ap:hasLocationalDescription "In the posterior region of the neck, in the depression inferior to the spinous process of the seventh cervical vertebra (C7), on the posterior median line. Note 1: When the head is in a neutral position while the subject is seated, the most prominent site on the posterior aspect of the neck is the spinous process of the seventh cervical vertebra (C7). Forward flexion of the neck may facilitate palpation of the C7 spinous process. Note 2: Slight rotation of C7 can be pal- pated by rotating the head with the neck slightly flexed." ;
    tara-ap:hasMethodDescription "Puncture obliquely upward 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Dazhui" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004616,
        ILX:0795312 ;
    tara-ap:hasSynonym "Du 14",
        "Governor Vessel 14",
        "VG 14" ;
    tara-ap:hasVasculatureInformation "The branch of the transverse cervical artery." ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0004616 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795312 ] ],
        TARA:8364824 .

TARA:0995552 a owl:Class ;
    rdfs:label "Bladder Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Bladder Meridian of Foot-Taiyang (BL), which consists of 67 standardized acupoints beginning at BL 1 (Jingming) on the face in the depression just superior to the inner canthus of the eye, traveling up over the head, descending down the back in two parallel lines flanking the spine, and continuing along the posterior aspect of the leg, ending at BL 67 (Zhiyin) on the lateral side of the little toe near the corner of the nail." ;
    tara-ap:hasSynonym "Acupoint of Bladder Meridian",
        "Acupoint of the Bladder Meridian",
        "Acupoint of the bladder meridian of foot-taiyang",
        "Acupuncture point of the bladder meridian",
        "Acupuncture point of the bladder meridian of foot-taiyang",
        "Acupuncture point of the urinary bladder meridian",
        "BL Acupoint",
        "UB Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:7525476 ] ) ] .

TARA:3283628 a owl:Class ;
    rdfs:label "BL 20" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 109. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "脾兪(俞)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasInnervationInformation "The medial cutaneous branches of the posterior rami of the eleventh and twelfth thoracic nerves; deeper, their lateral branches." ;
    tara-ap:hasListedIndications "epigastric pain, abdominal distension, jaundice, vomiting, diarrhea, dysentery, bloody stools, profuse menstruation, edema, anorexia, backache." ;
    tara-ap:hasLocationalDescription "In the upper back region, at the same level as the inferior border of the spinous process of the 11th thoracic vertebra (T11), 1.5 B-cun lateral to the posterior median line." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5-0.7 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Pishu" ;
    tara-ap:hasSpecialPointRole TARA:0077876 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004635,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 20",
        "Back-Shu Point of the Spleen",
        "Bladder 20",
        "UB 20",
        "Urinary Bladder 20" ;
    tara-ap:hasVasculatureInformation "The medial branches of the posterior branches of the intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:4143036 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0008231 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795312 ] ],
        [ a owl:Restriction ;
