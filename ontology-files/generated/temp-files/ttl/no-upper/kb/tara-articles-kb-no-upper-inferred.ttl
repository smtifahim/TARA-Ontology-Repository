tara-kb:S-112625-1207 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1207" ;
    dc:title "Effects of acupuncture on hot flashes in perimenopausal and postmenopausal women-a multicenter randomized clinical trial" ;
    tara-kb:hasAcupunctureProtocol """Acupuncture points selected based on traditional Korean medicine (TKM) clinical experts' recommendations.
Specific points used: ST36, SP6, L14, PC6, HT7, HTS, and CV4.
Locations: Peripheral extremities and lower abdominal region.
Technique: Manual manipulation to elicit de-qi sensation, retained for 20 minutes with intermittent stimulation.
Needles: Sterile, disposable (40 x 0.25 mm).
Insertion depth: 3 to 15 mm depending on the point.""" ;
    tara-kb:hasClinicalTrialType "Pragmatic Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group underwent usual care alone, which included the use of over-the-counter drugs and supplements not related to hot flashes, but did not receive acupuncture until after the initial study period as part of a crossover treatment." ;
    tara-kb:hasCountryOfStudy "South Korea" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "ST 36, SP 6, L 14, PC 6, HT 7, HTS, CV 4" ;
