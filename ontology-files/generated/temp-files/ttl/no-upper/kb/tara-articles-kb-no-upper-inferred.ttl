            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001465 ] ],
        TARA:3535998 .

TARA:2385378 a owl:Class ;
    rdfs:label "HT 3" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 83. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "少海(海)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001461 ;
    tara-ap:hasInnervationInformation "The medial antebrachial cutaneous nerve." ;
    tara-ap:hasListedIndications "cardiac pain, spasmodic pain and numbness of the hand and arm, tremor of the hand, scrofula, pain in the axilla and hypochondriac region." ;
    tara-ap:hasLocationalDescription "On the anteromedial aspect of the elbow, just anterior to the medial epicondyle of the humerus, at the same level as the cubital crease. Note: With the elbow is flexed, HT3 is located at the midpoint of the line connecting the medial end of the cubital crease and the medial epicondyle of the humerus." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Shaohai" ;
    tara-ap:hasRelatedArtery ILX:0797506,
        ILX:0797507 ;
    tara-ap:hasRelatedNerve ILX:0794953 ;
    tara-ap:hasRelatedVein UBERON:0001411,
        ILX:0797508 ;
    tara-ap:hasSpecialPointRole TARA:6594221 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0006806,
        ILX:0795332 ;
    tara-ap:hasSynonym "H 3",
        "HE 3",
        "Heart 3" ;
    tara-ap:hasVasculatureInformation "The basilic vein, the inferior ulnar collateral artery, the ulnar recurrent artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:9474009 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedArtery ;
