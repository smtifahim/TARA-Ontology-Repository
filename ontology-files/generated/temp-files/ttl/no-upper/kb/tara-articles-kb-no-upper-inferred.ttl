UBERON:0002049 a owl:Class ;
    rdfs:label "vasculature" ;
    IAO:0000115 "An interconnected tubular multi-tissue structure contains fluid that is actively transported around the organism[ZFA]. Examples: vasculature of lung, vasculature of face." ;
    IAO:0000116 "see also: vascular system. Consider merging?" ;
