TARA:3761087 a owl:Class ;
    rdfs:label "Pericardium Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Pericardium Meridian of Hand-Jueyin (PC), which consists of 9 standardized acupoints beginning at PC 1 (Tianchi) on the anterior chest in the fourth intercostal space lateral to the nipple, traveling down the middle of the anterior aspect of the arm, and ending at PC 9 (Zhongchong) at the center of the tip of the middle finger." ;
    tara-ap:hasSynonym "Acupoint of Pericardium Meridian",
        "Acupoint of the Pericardium Meridian",
        "Acupoint of the pericardium meridian of hand-jueyin",
        "Acupuncture point of the pericardium meridian",
        "Acupuncture point of the pericardium meridian of hand-jueyin",
        "PC Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:4694897 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:4694897 ] ) ] .

TARA:4427404 a owl:Class ;
    rdfs:label "GV 15" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 211. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "瘂(哑)門(门)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasInnervationInformation "The third occipital nerve." ;
    tara-ap:hasListedIndications "mental disorder, epilepsy, deafness and mute, sudden hoarseness of the voice, apoplexy, stiffness of the tongue and aphasia, occipital headache, neck rigidity." ;
    tara-ap:hasLocationalDescription "In the posterior region of the neck, in the depression superior to the spinous process of the second cervical vertebra (C2), on the posterior median line. Note: After locating GV16, GV15 is located 0.5 B-cun inferior to GV16." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Neither upward obliquely nor deep puncture is advisable. It is near the medullary bulb in the deep layer, and the depth and angle of the puncture should be paid strict attention to." ;
    tara-ap:hasPinyinLabel "Yamen" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001093,
        ILX:0795312 ;
    tara-ap:hasSynonym "Du 15",
        "Governor Vessel 15",
        "VG 15" ;
    tara-ap:hasVasculatureInformation "The branches of the occipital artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001093 ] ],
