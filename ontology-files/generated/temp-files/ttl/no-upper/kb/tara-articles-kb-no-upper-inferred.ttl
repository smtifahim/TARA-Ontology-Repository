    tara-ap:hasChineseLabel "臑兪(俞)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001421 ;
    tara-ap:hasInnervationInformation "The posterior cutaneous nerve of the arm, the axillary nerve; deeper, the suprascapular nerve." ;
    tara-ap:hasListedIndications "swelling of the shoulder, aching and weakness of the shoulder and arm." ;
    tara-ap:hasLocationalDescription "On the shoulder girdle, superior to the posterior axillary fold, in the depression inferior to the spine of the scapula." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Naoshu" ;
