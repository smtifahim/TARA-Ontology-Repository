TARA:3135569 a owl:Class ;
    rdfs:label "Yintang" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Headache, head heaviness, epistaxis, rhinorrhea, infantile convulsion, frontal headache, insomnia." ;
    tara-ap:hasLocationalDescription "Midway between the medial ends of the two eyebrows." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-HN 3",
        "M-HN 3",
        "Yingtang" ;
    rdfs:subClassOf TARA:3535998 .

TARA:8833337 a owl:Class ;
    rdfs:label "CV 6" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 222. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "氣(气,気)海(海)" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795303 ;
    tara-ap:hasListedIndications "abdominal pain, enuresis, nocturnal emission, impotence, hernia, edema, diarrhea, dysentery, uterine bleeding, irregular menstruation, dysmenorrhea, amenorrhea, morbid leukorrhea, postpartum hemorrhage, constipation, flaccid type of apoplexy, asthma." ;
    tara-ap:hasLocationalDescription "On the lower abdomen, 1.5 B-cun inferior to the centre of the umbilicus, on the ante- rior median line." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. This is one of the important points for tonification. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Qihai" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0007118,
        ILX:0795285 ;
    tara-ap:hasSynonym "Conception Vessel 6",
        "RN 6",
        "Ren 6",
        "VC 6" ;
    tara-ap:hasVasculatureInformation "The branches of superficial epigastric artery and vein, and the branches of inferior epigastric artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795303 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0007118 ] ],
        TARA:1092703 .

TARA:0434959 a owl:Class ;
    rdfs:label "CV 12" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 225. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "中脘" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795301 ;
    tara-ap:hasInnervationInformation "The anterior cutaneous branch of the seventh intercostal nerve." ;
    tara-ap:hasListedIndications "stomachache, abdominal distension, borborygmus, nausea, vomiting, acid regurgitation, diarrhea, dysentery, jaundice, indigestion, insomnia." ;
    tara-ap:hasLocationalDescription "On the upper abdomen, 4 B-cun superior to the centre of the umbilicus, on the anterior median line. Note: CV12 is located at the midpoint of the line connecting the xiphisternal junction and the centre of umbilicus." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhongwan" ;
    tara-ap:hasSpecialPointRole TARA:4230489,
        TARA:7083740 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0007118,
        UBERON:0011124,
        ILX:0795285 ;
    tara-ap:hasSynonym "Conception Vessel 12",
        "Front-Mu Point of the Stomach",
        "RN 12",
        "Ren 12",
        "VC 12" ;
    tara-ap:hasVasculatureInformation "The superior epigastric artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
