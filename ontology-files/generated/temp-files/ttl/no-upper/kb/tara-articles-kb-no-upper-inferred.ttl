    tara-ap:hasChineseLabel "極(极)泉" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0009472 ;
    tara-ap:hasInnervationInformation "The ulnar nerve, median nerve and medial brachial cutaneous nerve." ;
    tara-ap:hasListedIndications "pain in the costal and cardiac regions, scrofula, cold pain of the elbow and arm, dryness of the throat." ;
    tara-ap:hasLocationalDescription "In the axilla, in the centre of the axillary fossa, over the axillary artery." ;
    tara-ap:hasMethodDescription "Avoid puncturing the axillary artery. Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Jiquan" ;
    tara-ap:hasRelatedArtery UBERON:0001394 ;
    tara-ap:hasRelatedNerve UBERON:0001148,
