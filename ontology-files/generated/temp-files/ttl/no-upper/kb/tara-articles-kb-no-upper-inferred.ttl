UBERON:5106048 a owl:Class ;
    rdfs:label "digit 1 digitopodial skeleton" ;
    IAO:0000115 "A subdivision of the skeleton of the autopod consisting of the phalanges of digit 1 plus the associated metapodial element." ;
    IAO:0000232 "this class represents a series of phalanges plus a metapodial element. In comparative anatomy terminology we would call this a 'digit', but the label 'digit' is sometimes used to exclude metapodials and to include soft tissue. This series of elements is hypothesized to be homologous to radials." ;
    OboInOwl:hasExactSynonym "digit I digitopodial skeleton" ;
    OboInOwl:hasRelatedSynonym "digit 1",
        "digit 1 skeleton" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012150 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:5006048 ],
        UBERON:5102544 .

