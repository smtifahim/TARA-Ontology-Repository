    tara-ap:hasChineseLabel "眉衝(冲)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasListedIndications "headache, giddiness, epilepsy, nasal obstruction." ;
    tara-ap:hasLocationalDescription "On the head, superior to the frontal notch, 0.5 B-cun superior to the anterior hairline. Note: Midway between GV24 and BL4." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch." ;
    tara-ap:hasPinyinLabel "Meichong" ;
