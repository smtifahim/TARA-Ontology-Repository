tara-kb:S-112625-1550 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1550" ;
    dc:title "Effects of Acupuncture at 7-9 am and 3-5 pm on Plasma Thromboxane and Prostaglandin in Patients with Ischemic Cerebrovascular Disease" ;
    tara-kb:hasAcupunctureProtocol """Shugu (BL 65): Vertically punctured 0.3-0.5 cun deep with twirling-reinforcing method, retained for 30 minutes.
Neiguan (PC 6): Punctured 1 cun deep with lifting, trusting, and twirling-reducing method, manipulated for 1 minute and retained for 30 minutes.
Fengchi (GB 20): Punctured 1-1.5 cun deep with twirling-reinforcing method, manipulated for 1 minute and retained for 30 minutes.
Fenglong (ST 40): Punctured 1.5 cun deep with twirling-reducing method, manipulated for 1 minute and retained for 30 minutes.
Zusanli (ST 36): Punctured 1-1.5 cun deep with lifting, trusting, and twirling-reinforcing method, moxa roll applied after needling sensation, retained for 30 minutes.
Yinxi (HT 6): Vertically inserted 1 cun deep with twirling-reinforcing method, manipulated for 1 minute and retained for 30 minutes.
Ximen (EC 4): Vertically inserted 1 cun deep with twirling-reinforcing method, manipulated for 1 minute and retained for 30 minutes.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group in this study was a drug control group, where participants received enteric soluble Aspirin 50 mg orally once a day as part of conventional treatment." ;
    tara-kb:hasCountryOfStudy "China" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "BL 65, PC 6, GB 20, ST 40, ST 36, HT 6, EC 4" ;
