tara-kb:S-112625-1112 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1112" ;
    dc:title "Therapeutic Efficacy Observation on Acupuncture plus Medication for Rheumatoid Arthritis" ;
    tara-kb:hasAcupunctureProtocol "Not specified (the paper does not provide information on needle locations or related acupoints)" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group received antirheumatic agents alone, without acupuncture, and had the same medication regimen as the observation group." ;
    tara-kb:hasCountryOfStudy "Not specified (the paper does not explicitly mention the country where the study was conducted)" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Not specified" ;
    tara-kb:hasMappedWesternCondition MONDO:0008383 ;
    tara-kb:hasNeedlingDetails "Not specified" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1112 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1112 ;
    tara-kb:hasSampleSizeDetails "Total: 80; Observation Group: 40; Control Group: 40" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used)" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation (reinforcing reducing) after arrival of qi, manipulated once every 10 minutes, retained for 30 minutes." ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not provide TCM terminology for the condition)" ;
    tara-kb:hasStudiedWesternCondition "Rheumatoid Arthritis (RA)" ;
    tara-kb:hasStudyFindings """Results: Significant improvements in morning stiffness time, average grip of both hands, joint tenderness, and joint swelling (P<0.01) in the acupuncture group. More significant improvements in joint tenderness and average grip of both hands compared to the control group (P<0.05). Significant reductions in ESR and CRP in both groups, with a more significant CRP decrease in the acupuncture group (P<0.05).
Conclusion: Acupuncture plus antirheumatic agents effectively increases RA patients' ADL and improves their quality of life.
Effectiveness: Yes""" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: MorningStiffness time, average grip of both hands, joint tenderness, jointSwelling
Secondary outcome measures: Health Assessment Questionnaire (HAQ)Points, erythrocyteSedimentation rate (ESR), C reactiveProtein (CRP) levels""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: 30 minutes
Needles retained for: 30 minutes""" ;
    tara-kb:hasTreatmentFrequency "The acupuncture treatment was conducted 5 times a week, with each session lasting 30 minutes. The treatment was administered over a period of 30 days, which is considered one session of treatment." .

