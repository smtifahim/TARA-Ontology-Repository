UBERON:0002446 a owl:Class ;
    rdfs:label "patella" ;
    IAO:0000115 "A large sesamoid bone found in the distal femur/proximal tibial region of the hindlimb of tetrapods. The patella is the attachment site for proximal hindlimb tendons.[PHENOSCAPE:ad]." ;
    OboInOwl:hasDbXref "EMAPA:35668",
        "FMA:24485",
        "GAID:203",
        "MA:0001374",
        "MESH:D010329",
        "NCIT:C33282",
        "SCTID:182083008",
        "UMLS:C0030647",
        "Wikipedia:Patella",
        "galen:Patella" ;
    OboInOwl:hasRelatedSynonym "knee bone",
        "knee cap",
        "patella" ;
    rdfs:comment "The patella, also known as the knee cap or kneepan, is the largest sesamoid bone in the human body. The primary functional role of the patella is knee extension. The patella has convergently evolved in placental mammals and birds; marsupials have only rudimentary, non-ossified patellae. In more primitive tetrapods, including living amphibians and reptiles, the muscle tendons from the upper leg are attached directly to the tibia, and the patella is not present. See also: fabella." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001441 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001465 ],
        [ a owl:Restriction ;
            owl:onProperty RO:0002170 ;
            owl:someValuesFrom UBERON:0000981 ],
        UBERON:0001479,
        UBERON:0005893,
        UBERON:0011141 ;
    foaf:depiction "https://upload.wikimedia.org/wikipedia/commons/9/9a/Knee_diagram.svg"^^xsd:anyURI .

UBERON:0012150 a owl:Class ;
    rdfs:label "skeleton of digitopodium" ;
    IAO:0000115 "A subdivision of the autopod skeleton consisting of both acropodial skeleon and metapodial skeleton, but excluding the mesopodial/basopodial skeleton." ;
    OboInOwl:hasRelatedSynonym "digitopodium",
        "skeleton of digits" ;
    rdfs:seeAlso "https://github.com/obophenotype/uberon/wiki/Subdivisions-of-the-autopod"^^xsd:anyURI ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0006717 ],
        [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0012140 ],
        UBERON:0010712 .

TARA:1092703 a owl:Class ;
    rdfs:label "Conception Vessel Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Conception Vessel (CV / Ren Mai), one of the eight extraordinary vessels, which consists of 24 standardized acupoints beginning at CV 1 (Huiyin) in the perineum at the midpoint of the perineal region, traveling up along the anterior midline of the body through the abdomen, chest, and neck, and ending at CV 24 (Chengjiang) on the face in the depression at the center of the mentolabial sulcus." ;
    tara-ap:hasSynonym "Acupoint of Conception Vessel",
        "Acupoint of Ren Channel",
        "Acupoint of the Conception Vessel",
        "Acupoint of the Ren channel",
        "Acupouncture point of the Conception Vessel",
        "Acupuncture point of the Ren channel",
        "CV Acupoint",
        "RN Acupoint",
        "Ren Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:6789717 ] ) ] .

TARA:1840369 a owl:Class ;
    rdfs:label "Yuan-Primary Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "Each of the twelve main meridians has a Yuan-Primary Point, which is located on the limbs. The Chinese character (Yuan) means primary qi in this context. The chapter \"The 66th Medical Problem\" in Classic of Medical Problems describes the relation between the Yuan-Primary Points and Yuan-Primary Qi. The Yuan-Primary Qi, originating below the umbilicus and between the kidneys, is dispersed to the zang-fu organs and further to the limbs via Triple Energizer. The sites where the Yuan-Primary Qi is retained are Yuan-Primary Points, which are used to treat disorders of the zang-fu organs. In the yin meridians, the Yuan-Primary Poims overlap with the Shu-Stream Points of the Five Shu Points. Each yang meridian, however, has its Yuan-Primary Point other than the Shu-Stream Point." ;
    tara-ap:hasSpecialPointRole TARA:3455429 ;
    rdfs:subClassOf TARA:4943316 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4943316 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:3455429 ] ) ] .

TARA:2954517 a owl:Class ;
    rdfs:label "Jing-Well Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the five Shu Points, the Jing-Well point is situated in the place where the meridian qi starts to bubble." ;
    tara-ap:hasSpecialPointRole TARA:3839815 ;
    rdfs:subClassOf TARA:1787498 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:1787498 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:3839815 ] ) ] .

TARA:3744150 a owl:Class ;
    rdfs:label "LI 14" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 40. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "臂臑" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001460 ;
    tara-ap:hasInnervationInformation "The posterior brachial cutaneous nerve; deeper, the radial nerve." ;
    tara-ap:hasListedIndications "pain in the shoulder and arm, rigidity of the neck, scrofula." ;
    tara-ap:hasLocationalDescription "On the lateral aspect of the arm, just anterior to the border of the deltoid muscle, 7 B-cun superior to LI11." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly or obliquely upward 0.8-1.5 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Binao" ;
    tara-ap:hasRelatedArtery UBERON:0001399,
        ILX:0797496 ;
    tara-ap:hasRelatedNerve UBERON:0001492,
        ILX:0795005 ;
    tara-ap:hasRelatedVein UBERON:0006200,
        ILX:0797498 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001476 ;
    tara-ap:hasSynonym "CO 14",
        "Colon 14",
        "Large Intestine 14" ;
    tara-ap:hasVasculatureInformation "The branches of posterior circumflex humeral artery and vein, the deep brachial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4610474 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom UBERON:0001492 ],
