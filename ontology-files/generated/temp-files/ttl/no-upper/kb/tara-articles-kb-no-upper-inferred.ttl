tara-kb:S-112625-340 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-340" ;
    dc:title "Ear acupuncture in the treatment of migraine attacks: a randomized trial on the efficacy of appropriate versus inappropriate acupoints" ;
    tara-kb:hasAcupunctureProtocol """Area M: Anterointernal part of the antitragus, on the same side of pain.
Area S: Lower branch of the anthelix, corresponding to the representation of the sciatic nerve.
Other effective points: Antero-internal part of the antitragus, anterior part of the lobe, upper auricular concha, all on the same side of pain.
Selection criteria: Needle Contact Test (NCT) for area M.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "Group B: Treatment on area S (representation of the sciatic nerve), which is considered an unsuitable area for treating migraine attacks." ;
    tara-kb:hasCountryOfStudy "Italy" ;
    tara-kb:hasDatasetLink "Not specified" ;
