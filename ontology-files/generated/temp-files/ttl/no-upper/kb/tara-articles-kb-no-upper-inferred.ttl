    tara-kb:hasListedAcupointsUnmappable "low back ashi point" ;
    tara-kb:hasMappedWesternCondition HP:0003419 ;
    tara-kb:hasNeedlingDetails "The penetration depth varied slightly, depending on the acupuncture point, but was generally between 1 and 3 cm." ;
