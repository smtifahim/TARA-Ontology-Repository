    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Control Group: Needling at nonchannel scalp points with sham electrostimulation.
Description: Needles were inserted at points remote from traditional acupuncture meridians, and no electrical current was applied.""" ;
