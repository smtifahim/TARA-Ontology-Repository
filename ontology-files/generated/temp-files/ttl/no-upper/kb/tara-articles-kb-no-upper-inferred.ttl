        UBERON:0005178 .

UBERON:0015790 a owl:Class ;
    rdfs:label "autopod skin" ;
    IAO:0000115 "A zone of skin that is part of a autopod region." ;
    OboInOwl:hasDbXref "EMAPA:32723",
        "MA:0003120" ;
    OboInOwl:hasRelatedSynonym "paw skin" ;
