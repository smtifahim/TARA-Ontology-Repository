TARA:7852472 a owl:Class ;
    rdfs:label "Special Acupuncture Point" ;
    IAO:0000115 "An Acupoint that hasSpecialPointRole some Special_Acupoint_Role." ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7."@en ;
    dcterms:description "Special points refer to the specific points of the fourteen meridians that have special properties and are grouped under special names. In view of their locations, they can be classified into two major groups: one on the limbs, and the other one on the head and the trunk." ;
    tara-ap:hasSynonym "Special Acupoint",
        "Special Point" ;
    rdfs:subClassOf TARA:1132428 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:1132428 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:4176111 ] ) ] .

TARA:8093645 a owl:Class ;
    rdfs:label "GV 8" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 207. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
