tara-kb:hasNeedlingDetails a owl:AnnotationProperty ;
    rdfs:label "Needling Details" ;
    IAO:0000112 "\"Sterile, single-use coated acupuncture needles, 0.25-0.30 mm thick, 25-40 mm long; 10 to 25 needles per treatment; inserted 2-20 mm in depth; retained for 30 min.\"",
        "\"0.30 mm diameter, 25 mm long stainless steel needles inserted to a depth of 15-20 mm and retained for 20 minutes.\""@en ;
