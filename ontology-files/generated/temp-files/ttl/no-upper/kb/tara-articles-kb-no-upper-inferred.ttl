HP:0000016 a owl:Class ;
    rdfs:label "Urinary retention" ;
    IAO:0000115 "Inability to completely empty the urinary bladder during the process of urination." ;
    OboInOwl:hasDbXref "SNOMEDCT_US:130951007",
        "SNOMEDCT_US:267064002",
        "SNOMEDCT_US:449491000124101",
        "UMLS:C0080274" ;
    OboInOwl:hasExactSynonym "Increased post-void residual urine volume" ;
    rdfs:comment "Urinary retention is the inability of the urinary bladder to empty. The cause may be neurologic or nonneurologic." ;
    rdfs:subClassOf HP:0000009 .

