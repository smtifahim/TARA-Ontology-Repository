ILX:0792339 a owl:Class ;
    rdfs:label "Third posterior intercostal artery" ;
    ilxtr:hasExistingId FMA:12286,
        ILX:0792339 ;
    rdfs:subClassOf UBERON:0039835 .

ILX:0794900 a owl:Class ;
    rdfs:label "supraclavicular nerve" ;
    IAO:0000115 "Cutaneous nerve of the neck originating from nerve point of the neck and providing sensory innervation to skin over the clavicle, shoulder and chest. REVA annotation term." ;
    ilxtr:hasExistingId ILX:0794900 ;
    rdfs:subClassOf UBERON:0001021 .

ILX:0795007 a owl:Class ;
    rdfs:label "superior lateral cutaneous nerve of arm" ;
    IAO:0000115 "The superior lateral cutaneous nerve of arm (or superior lateral brachial cutaneous nerve) is the continuation of the posterior branch of the axillary nerve, after it pierces the deep fascia. It is derived from the ventral rami of C5 and C6." ;
    isPartOf: UBERON:0001493 ;
    ilxtr:hasExistingId ILX:0795007 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001493 ],
        ILX:0797544 .

ILX:0795021 a owl:Class ;
    rdfs:label "Inferior lateral cutaneous nerve of arm" ;
    IAO:0000115 "The inferior lateral cutaneous nerve of arm is a nerve found in humans and other animals. It is also called the inferior lateral brachial cutaneous nerve. It is a branch of the radial nerve that provides sensory and vasomotor innervation to the lower, lateral aspect of the arm.  It is derived from the ventral rami of C5 and C6." ;
    isPartOf: UBERON:0001492 ;
    ilxtr:hasExistingId ILX:0795021 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001492 ],
        ILX:0797544 .

ILX:0795288 a owl:Class ;
    rdfs:label "dorsal wrist" ;
    IAO:0000115 "The posterior aspect of the wrist, containing the extensor tendons and underlying carpal bones." ;
    isPartOf: UBERON:0008785 ;
    ILX:0777130 "https://www.uptodate.com/contents/anatomy-and-basic-biomechanics-of-the-wrist" ;
    ilxtr:hasExistingId FMA:24924,
        ILX:0795288 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0008785 ],
        UBERON:0001062 .

ILX:0795310 a owl:Class ;
    rdfs:label "cubital fossa" ;
    IAO:0000115 "A triangular depression on the anterior aspect of the elbow, containing important neurovascular structures." ;
    isPartOf: UBERON:0001460 ;
    ILX:0777130 "https://en.wikipedia.org/wiki/Cubital_fossa" ;
    ilxtr:hasExistingId FMA:39848,
        ILX:0795310 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001460 ],
        UBERON:0004704 .

ILX:0795318 a owl:Class ;
    rdfs:label "fourth metacarpal bone" ;
    IAO:0000115 "The long bone in the hand that connects the fourth finger to the carpal bones of the wrist. The fourth metacarpal bone is shorter and smaller than the third. The base is small and quadrilateral." ;
    isPartOf: UBERON:0001442 ;
    ILX:0777130 "https://www.imaios.com/en/e-anatomy/anatomical-structure/metacarpal-iv-121123560" ;
    ilxtr:hasExistingId ILX:0795318 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty partOf: ;
            owl:someValuesFrom UBERON:0001442 ],
        UBERON:0001474 .

TARA:1317028 a owl:Class ;
    rdfs:label "LR 14 (Male)" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 202. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The sixth intercostal nerve." ;
    tara-ap:hasListedIndications "hypochondriac pain, abdominal distension, hiccup, acid regurgitation, mastitis, depression, febrile diseases." ;
    tara-ap:hasLocationalDescription "In the anterior thoracic region, in the sixth intercostal space, 4 B-cun lateral to the anterior median line. Note: LR 14 is inferior to the centre of the nipple, 2 B-cun lateral to ST 19. In females, LR 14 is located at the intersection of the midclavicular line and the sixth intercostal space." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002030,
        ILX:0795285,
        ILX:0795307 ;
    tara-ap:hasSynonym "Liver 14 (Male)" ;
    tara-ap:hasVasculatureInformation "The sixth intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5419503 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016416 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002030 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795307 ] ],
        TARA:7479763 .

TARA:2358051 a owl:Class ;
    rdfs:label "Shanglianquan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Alalia, salivation with stiff tongue, sore throat, difficulty in swallowing, loss of voice." ;
    tara-ap:hasLocationalDescription "1 cun below the midpoint of the lower jaw, in the depression between the hyoid bone and the lower border of the jaw." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.8-1.2 inches toward the tongue root." ;
    tara-ap:hasSynonym "M-HN 21" ;
    rdfs:subClassOf TARA:3535998 .

TARA:2581598 a owl:Class ;
    rdfs:label "Qianzheng" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Deviation of the eyes and mouth, ulceration on tongue and mouth." ;
    tara-ap:hasLocationalDescription "0.5-1.0 cun anterior to the auricular lobe." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5- 1.0 inch." ;
    tara-ap:hasSynonym "N-HN 20" ;
    rdfs:subClassOf TARA:3535998 .

TARA:2630570 a owl:Class ;
    rdfs:label "Yaoyan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Lumbar pain, frequency of urine, irregular menstruation." ;
    tara-ap:hasLocationalDescription "About 3.5-4 cun lateral to the lower border of the spinous process of the 4th lumbar vertebra. The point is in the depression appearing in prone position." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-B 7",
        "M-BW 24" ;
    rdfs:subClassOf TARA:3535998 .

TARA:4684195 a owl:Class ;
    rdfs:label "ST 18 (Male)" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 54. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The branch of the fifth intercostal nerve." ;
    tara-ap:hasListedIndications "pain in the chest, cough, asthma, mastitis, insufficient lactation." ;
    tara-ap:hasLocationalDescription "In the anterior thoracic region, in the fifth intercostal space, 4 B-cun lateral to the anterior median line. Note: In males, ST 18 is located at the intersection of nipple line and the fifth intercostal space. In females, ST 18 is located at the midpoint of the inferior crease of the breast." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasRelatedArtery UBERON:0005612 ;
    tara-ap:hasRelatedNerve ILX:0787443 ;
