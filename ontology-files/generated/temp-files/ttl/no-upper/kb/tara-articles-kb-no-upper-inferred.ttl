tara-kb:S-112625-468 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-468" ;
    dc:title "Acupuncture and physical exercise for affective symptoms and health-related quality of life in polycystic ovary syndrome: secondary analysis from a randomized controlled trial" ;
    tara-kb:hasAcupunctureProtocol """Four acupuncture points in abdominal muscles
Four acupuncture points in muscles below the knee, bilaterally
Points correspond to innervation of ovaries (Th12-L2, S2-S4)
Two extrasegmental points in muscles of hand and lower arm, bilaterally
Needles inserted to a depth of 15-35 mm
Electrical stimulation with low-frequency (2 Hz) for 30 min
Manual stimulation for hand/lower arm points every 10 min""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group consisted of 15 women with PCOS who received no active intervention during the study period. They were provided with oral information about the benefits of regular physical exercise and information about their condition at the baseline visit." ;
    tara-kb:hasCountryOfStudy "Sweden" ;
    tara-kb:hasDatasetLink "Not specified (the paper provides a Clinical Trials Government Identifier number but does not explicitly mention or provide a link to a dataset)" ;
    tara-kb:hasListedAcupoints "Not specified" ;
