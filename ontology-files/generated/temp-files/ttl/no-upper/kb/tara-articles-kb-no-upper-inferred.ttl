tara-kb:S-112625-5 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-5" ;
    dc:title "Acupuncture as an Adjunct for Sedation During Lithotripsy" ;
    tara-kb:hasAcupunctureProtocol """Auricular Acupuncture Points:
Acupuncture Group: Relaxation, Master Cerebral, Valium points
Sham Group: Wrist, Shoulder, Extraauricular sham points
Body Acupuncture Points:
Acupuncture Group: Bilateral Liver 3 (dorsum of the foot in the depression distal to the junctions of the first and second metatarsals), Bilateral Large Intestine 4 (radial side of the middle of the second metacarpal)
Sham Group: Bilateral Liver 3 and Large Intestine 4 (same locations as acupuncture group but with superficial insertion)""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "Sham control group: Preprocedural sham auricular acupuncture intervention combined with intraprocedural sham electroacupuncture stimulation (n = 27)." ;
    tara-kb:hasCountryOfStudy "United States" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Relaxation, Master Cerebral, Valium, Wrist, Shoulder, Extraauricular sham, Liver 3, Large Intestine 4" ;
