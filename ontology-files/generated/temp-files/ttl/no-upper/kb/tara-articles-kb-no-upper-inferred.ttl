    tara-kb:hasTreatmentFrequency "Twice weekly; 12 treatments per session, 3 sessions in total, with a 2 week interval between sessions; total of 36 treatments" .

tara-kb:S-112625-400 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-400" ;
    dc:title "Acupuncture and Acupressure in Labor" ;
    tara-kb:hasAcupunctureProtocol """GB 21: Located at the crest of the trapezius muscle halfway between the prominent spinous process of the seventh cervical vertebra (C7) and the tip of the acromion process of the scapula. Used for release and descent, facilitating fetal descent in active phase and second stage of labor.
LI 4: Located on the dorsum of the hand. Used for reduction of labor pain and promoting stronger and/or more coordinated contractions.
BL 32: Located at the second of the sacrum‚Äôs 8 foramen. Used for reduction of labor pain and induction of labor.
SP 6: Located on the medial aspect of the lower leg, 3 cun superior to the medial malleolus (ankle bone) in a slight depression next to the tibia. Used for labor augmentation, irregular contractions, reducing a persistent cervical lip, reduction of labor pain, and reduction of the length of labor.
BL 60: Located on the foot. Used for relieving lower back pain.
BL 67: Located on the dorsum of the little toe at the corner formed 0.1 cun from where the lateral aspect and the base of the nail meet. Used for version of breech to a cephalic presentation, reducing labor pain, and stimulating uterine contractions.
LV 3: Located on the dorsum of the foot in the hollow between the bodies of the first and second metacarpal bones. Used for softening the cervix and reducing pain in labor.
ST 36: Located on the lower leg, 3 cun below the kneecap in the hollow created when the knee is flexed, one fingerbreadth lateral to the crest of the tibia. Used for relief of maternal exhaustion in labor and relief of nausea and vomiting.""" ;
    tara-kb:hasClinicalTrialType "Systematic Review" ;
    tara-kb:hasControlGroupsDetails """No treatment
Placebo
Sham acupuncture
Usual care
Touch control""" ;
    tara-kb:hasCountryOfStudy "Not specified (the paper is a review of literature from multiple countries)" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "GB 21, LI 4, BL 32, SP 6, BL 60, BL 67, LV 3, ST 36" ;
    tara-kb:hasListedAcupointsMapped TARA:0859695,
        TARA:4385250,
        TARA:5047947,
        TARA:5389461,
        TARA:6463344,
        TARA:6499349,
        TARA:6742407,
        TARA:7218725 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:5389461\": \"GB 21\", \"TARA:0859695\": \"LI 4\", \"TARA:6742407\": \"BL 32\", \"TARA:4385250\": \"SP 6\", \"TARA:5047947\": \"BL 60\", \"TARA:7218725\": \"BL 67\", \"TARA:6499349\": \"LR 3\", \"TARA:6463344\": \"ST 36\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition HP:0012531 ;
    tara-kb:hasNeedlingDetails "Not specified" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-400 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-400 ;
    tara-kb:hasSampleSizeDetails """Cochrane review for acupuncture: Not specified
Cochrane review for acupressure: 549 women
Specific RCTs:
2014 Turkish RCT: 100 women
2015 UK RCT: 130 women
Total sample size across all studies: Not specified""" ;
    tara-kb:hasShamAcupunctureDetails """Sham procedure involved inserting needles shallowly next to actual acupuncture points (LI4, SP6, BL60, and BL67).
For electroacupuncture, needles were attached to an electric stimulation device that was not turned on.""" ;
    tara-kb:hasStimulationTypeDetails "Electroacupuncture was used, involving electrical stimulation. Manual acupuncture was also mentioned, but the specific method of stimulation was not specified. No mention of thermal, laser, or other types of stimulation." ;
    tara-kb:hasStudiedTCMCondition "Not specified" ;
    tara-kb:hasStudiedWesternCondition "Labor pain and labor duration" ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcomes: Reduction of labor pain, labor induction and/or augmentation
Secondary outcomes: Reduced use of pharmacologic agents, shorter labor duration""" ;
    tara-kb:hasTreatmentDuration """MacKenzie et al.: 30 minutes
Chinese multicenter RCT: 1 hour
2014 single-blinded RCT (acupressure): 60 seconds on and off for 30 minutes
2012 Iranian RCT (acupressure): 20 minutes""" ;
    tara-kb:hasTreatmentFrequency "Not specified (the paper does not provide specific information on the frequency of acupuncture treatments)" .

