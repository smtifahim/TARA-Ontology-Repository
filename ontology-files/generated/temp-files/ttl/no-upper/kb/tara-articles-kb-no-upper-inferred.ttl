UBERON:8480069 a owl:Class ;
    rdfs:label "temporofacial region" ;
    IAO:0000115 "The region at each side of the face comprising the temple and the cheek." ;
    dcterms:contributor <https://orcid.org/0000-0002-0819-0473> ;
    dcterms:date "2023-09-18T06:03:43+00:00"^^xsd:dateTime ;
    rdfs:comment "This term is used to map the tissue from which the Muraoka cell line (CVCL_E042) originates." ;
    rdfs:subClassOf UBERON:0001444 .

