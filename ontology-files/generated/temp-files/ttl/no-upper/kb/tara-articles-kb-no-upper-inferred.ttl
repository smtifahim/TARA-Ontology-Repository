TARA:8866697 a owl:Class ;
    rdfs:label "Kidney Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Kidney Meridian of Foot-Shaoyin (KI), which consists of 27 standardized acupoints beginning at KI 1 (Yongquan) on the sole of the foot in the depression formed when the toes are flexed, traveling up along the medial aspect of the leg and continuing up the abdomen and chest close to the midline, and ending at KI 27 (Shufu) on the anterior chest in the depression at the inferior border of the clavicle." ;
    tara-ap:hasSynonym "Acupoint of Kidney Meridian",
        "Acupoint of the Kidney Meridian",
        "Acupoint of the kidney meridian of foot-shaoyin",
        "Acupuncture point of the kidney meridian",
        "Acupuncture point of the kidney meridian of foot-shaoyin",
        "KI Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:4813389 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:4813389 ] ) ] .

