TARA:7010544 a owl:Class ;
    rdfs:label "Influential Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. Ch. 16, General Introduction to Acupuncture Treatment, Page 392. ISBN 978-7-119-01758-7." ;
    dcterms:description "Represents one of the Eight lnfluential Points. The Eight Influential Points refer to the specific points which have particular effects in treatment of disorders relating to the zang-fu organs, qi, blood, tendon, pulse and vessels, bone and marrow. Each of the Eight Influential Points overlaps the other point. It is said in Classic on Medical Problems, \"Zhongwan (CV 12) is the Influential Point of the fu organs; Zhangmen (LR 13) is the Influential Point of the zang organs; Yanglingquan (GB 34) is the Influential Point of tendons; Xuanzhong (GB 39) is the Influential Point of marrow; Geshu (BL 17) is the Influential Point of blood; Dazhu (BL 11) is the Influential Point of bone; Taiyuan (LU 9) is the Influential Point of pulse and vessels; and Tanzhong (CV 17) is the Influential Point of Qi." ;
    tara-ap:hasSpecialPointRole TARA:4235924 ;
    rdfs:subClassOf TARA:7852472 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7852472 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:4235924 ] ) ] .

TARA:9294655 a owl:Class ;
    rdfs:label "ST 31" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 61. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "髀(髀)關(关,関)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000376 ;
    tara-ap:hasInnervationInformation "The lateral femoral cutaneous nerve." ;
    tara-ap:hasListedIndications "pain in the thigh, muscular atrophy, motor impairment, numbness and pain of the lower extremities." ;
    tara-ap:hasLocationalDescription "On the anterior aspect of the thigh, in the depression among three muscles: the proximal portion of the rectus femoris muscle, the sartorius muscle and the tensor fasciae latae muscle. Note 1: With the hip and the knee in slight flexion, and the thigh slightly abducted when resistance is placed against the anteromedial aspect of the thigh, a triangular depression appears. the proximal portion of the rectus femoris muscle is found in the depression between the sartorius muscle medially and the tensor fascia latae muscle laterally. St31 is located at the deepest point in the depression inferior to the apex of this triangle. Note 2: ST31 is located at the intersection of the line connecting the lateral end of the base of the patella with the anterior superior iliac spine, and the horizontal line of the inferior border of the pubic symphysis." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 1.0-1.5 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Biguan" ;
    tara-ap:hasRelatedArtery ILX:0797501 ;
    tara-ap:hasRelatedNerve ILX:0794999 ;
    tara-ap:hasRelatedVein ILX:0797502 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001373,
        UBERON:0001376,
        UBERON:0002446,
        UBERON:0003699,
        UBERON:0013708,
        ILX:0795304 ;
    tara-ap:hasSynonym "S 31",
        "Stomach 31" ;
    tara-ap:isLocatedOnMeridian TARA:6221269 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000376 ] ],
        [ a owl:Restriction ;
