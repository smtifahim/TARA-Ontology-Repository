tara-kb:S-112625-1702 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1702" ;
    dc:title "Acupuncture for the Treatment of Dry Eye: A Multicenter Randomised Controlled Trial with Active Comparison Intervention (Artificial Teardrops)" ;
    tara-kb:hasAcupunctureProtocol "Bilateral BL2; Bilateral GB14; Bilateral TE 23; Bilateral Ex1; Bilateral ST1; Bilateral GB20; Bilateral LI4; Bilateral LI11; Single GV23. Depths of insertion: Face and head: 0.6 to 3 cm; Hand (LI4): 3 to 4.5 cm; Arm (LI11): 3 to 4.5 cm. Needles twisted to achieve 'deqi' sensation and retained for 20 minutes." ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group used in the study was the \"artificial tears group,\" which received preservative-free single-use artificial teardrops containing 0.5% sodium carboxymethylcellulose. Participants were advised to use them as needed, at least once per day, for four weeks." ;
    tara-kb:hasCountryOfStudy "South Korea" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "BL 2, GB 14, TE 23, ST 1, GB 20, LI 4, LI 11, GV 23" ;
