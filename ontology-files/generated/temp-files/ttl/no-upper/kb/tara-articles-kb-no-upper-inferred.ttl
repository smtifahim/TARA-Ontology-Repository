TARA:7406349 a owl:Class ;
    rdfs:label "Lower He-Sea Point of the Small Intestine" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Lower He-Sea Point of the the Small Intestine meridian. One of the five Shu Points, the He-Sea point signifies the confluence of rivers in the sea, where the meridian qi is the most flourishing. In addition, each of the six fu organs has another He-Sea point in the three yang meridians of the foot, known as the Lower He-Sea point. The Lower He-Sea points are mostly employed to treat the disorders of the six fu organs in clinic." ;
    tara-ap:hasSpecialPointRole TARA:7154478 ;
    rdfs:subClassOf TARA:4830205 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4830205 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:7154478 ] ) ] .

TARA:7524444 a owl:Class ;
    rdfs:label "Xi-Cleft Point of the Yin Heel Vessel" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Xi-Cleft Point of the Yin Heel Vessel (an extra meridian). The Xi-Cleft Point is the site where the qi and blood of the meridian are deeply converged. The Xi-Cleft Point is used to treat acute disorders in the area supplied by its pertaining meridian and those of its pertaining zang or fu organ." ;
    tara-ap:hasSpecialPointRole TARA:9345451 ;
    rdfs:subClassOf TARA:4598552 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4598552 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:9345451 ] ) ] .

TARA:7546644 a owl:Class ;
    rdfs:label "Influential Point of the Zang Organs" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of the Zang Organs can be employed to treat disorders of the Zang organs. Zhangmen (LR 13) is the Influential Point of the Zang organs." ;
    tara-ap:hasSpecialPointRole TARA:1028514 ;
    rdfs:subClassOf TARA:7010544 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:7010544 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:1028514 ] ) ] .

TARA:7589061 a owl:Class ;
    rdfs:label "GV 18" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 212. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "強間(间)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasListedIndications "headache, neck rigidity, blurred vision, mania." ;
    tara-ap:hasLocationalDescription "On the head, 4 B-cun superior to the posterior hairline, on the posterior median line. Note: GV18 is located in the depression 1.5 B-cun superior to gV17." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Qiangjian" ;
    tara-ap:hasSpecificReferenceLocation ILX:0795312,
        ILX:0795326 ;
    tara-ap:hasSynonym "Du 18",
        "Governor Vessel 18",
        "VG 18" ;
    tara-ap:hasVasculatureInformation "The branches of the occipital arteries and veins of the both sides." ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
