TARA:6848518 a owl:Class ;
    rdfs:label "SP 8" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 73. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "地機(机)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "Superficially, the medial crural cutaneous nerve; deeper, in the posterior aspect, the tibial nerve." ;
    tara-ap:hasListedIndications "abdominal pain and distension, diarrhea, edema, dysuria, nocturnal emission, irregular menstruation, dysmenorrhea." ;
    tara-ap:hasLocationalDescription "On the tibial aspect of the leg, posterior to the medial border of the tibia, 3 B-cun inferior to SP9. Note: SP8 is located at the junction of the upper one third and lower two thirds of the line connecting the apex of the patella with the prominence of the medial malleolus." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Diji" ;
    tara-ap:hasRelatedArtery UBERON:0001538,
        ILX:0797504 ;
    tara-ap:hasRelatedNerve UBERON:0001323,
        ILX:0797485 ;
    tara-ap:hasRelatedVein UBERON:0001363,
        UBERON:0001546 ;
    tara-ap:hasSpecialPointRole TARA:4598552 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0000979,
        UBERON:0002446,
        ILX:0795305 ;
    tara-ap:hasSynonym "Spleen 8" ;
    tara-ap:hasVasculatureInformation "Anteriorly, the great saphenous vein and the branch of the genu suprema artery; deeper, the posterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4167850 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom ILX:0797485 ],
