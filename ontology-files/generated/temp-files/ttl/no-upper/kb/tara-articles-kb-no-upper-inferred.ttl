    tara-ap:hasChineseLabel "束骨(骨)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "The fourth common plantar digital nerve and the lateral dorsal cutaneous nerve of foot." ;
    tara-ap:hasListedIndications "mania, headache, neck rigidity, blurred vision, backache, pain in the lower extremities." ;
    tara-ap:hasLocationalDescription "On the lateral aspect of the foot, in the depression proximal to the fifth metatarsophalangeal joint, at the border between the red and white flesh." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Shugu" ;
    tara-ap:hasSpecialPointRole TARA:6705086 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0007762 ;
    tara-ap:hasSynonym "B 65",
        "Bladder 65",
        "UB 65",
        "Urinary Bladder 65" ;
    tara-ap:hasVasculatureInformation "The fourth common plantar digital artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
