    tara-kb:hasTreatmentFrequency "Twice weekly for 10 weeks, with each session lasting 30 minutes, totaling 20 sessions." .

tara-kb:S-112625-1087 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1087" ;
    dc:title """Evaluating the efficacy of acupuncture
in defined aspects of stroke recovery
A randomised, placebo controlled single blind study""" ;
    tara-kb:hasAcupunctureProtocol """LI 10, SJ 5, GB 31, GB 34, GB 20 (for expelling "Wind"), ST 36 (for general recovery).
Scalp points: superior and inferior ends of the motor line, junctions between upper and lower limb and head and upper limb sections.
Depth of needling according to the State Standard of the People's Republic of China.
Electro-acupuncture with a current of 2 Hz at LI 10, SJ 5, GB 31, GB 34.
Scalp acupuncture with a current of 100 Hz.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group received a placebo intervention, which was a mock TENS treatment. Body and scalp points were attached to TENS machines with red flashing lights and deactivated leads so that no current could flow." ;
    tara-kb:hasCountryOfStudy "United Kingdom" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "LI 10, SJ 5, GB 31, GB 34, GB 20, ST 36" ;
