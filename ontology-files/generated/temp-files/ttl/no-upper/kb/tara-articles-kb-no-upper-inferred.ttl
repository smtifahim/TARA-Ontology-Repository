        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1754" ;
    dc:title "Evaluating validity of various acupuncture device types: a random sequence clinical trial" ;
    tara-kb:hasAcupunctureProtocol "Left ST 36 acupuncture point" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT), Pilot Study" ;
    tara-kb:hasControlGroupsDetails """Park Sham device
Needle and foam
Insertion and removal
Real + Park Sham
Real + Needle and foam
Real + Insertion and removal""" ;
    tara-kb:hasCountryOfStudy "South Korea" ;
    tara-kb:hasDatasetLink "http://www.ensaiosclinicos.gov.br/rg/step_4/3557/ yung_maciel@hotmail.com" ;
    tara-kb:hasListedAcupoints "ST 36" ;
    tara-kb:hasListedAcupointsMapped TARA:6463344 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:6463344\": \"ST 36\"}"^^rdf:JSON ;
    tara-kb:hasNeedlingDetails "15 mm" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1754 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1754 ;
    tara-kb:hasSampleSizeDetails """Total participants: 321
Participants within groups: Not specified (minimum of 21 subjects per group as calculated from pilot study)""" ;
    tara-kb:hasShamAcupunctureDetails """Park Sham device: Uses a blunt needle that does not penetrate the skin, simulating the sensation of acupuncture.
Needle and foam: Uses a self-adhesive foam that prevents the needle from penetrating the skin.
Insertion and removal: Uses real needles but removes them immediately after insertion.
Locations: Applied at both abdominal (ST25) and lumbar (BL52) points.
Non-penetrating: Park Sham and needle and foam methods are non-penetrating.
Penetrating: Insertion and removal method uses real needles but removes them immediately.""" ;
    tara-kb:hasStimulationTypeDetails """Real Acupuncture: Needles inserted bilaterally to a depth of 10 mm and left in place for 30 minutes.
Park Sham: No actual skin penetration.
Needle + Foam: Needles penetrated foam but not skin.
Insertion and Removal: Real needles inserted and then immediately removed.
No additional stimulation methods mentioned (e.g., manual manipulation, electrical stimulation, thermal stimulation, laser).""" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not mention a specific disease or condition being studied in TCM terminology)" ;
    tara-kb:hasStudiedWesternCondition "Not specified (the paper does not mention a specific disease or condition being studied)" ;
    tara-kb:hasStudyFindings """Direct quote: "All placebo acupuncture methods proposed in this study were equally effective for bliding the study participants using either abdominal or lumbar acupoints, and none of the placebo methods presented benefit compared to the other to be used in future clinical trials."
Effectiveness compared to control/sham: No (the study focused on the effectiveness of placebo methods in blinding participants rather than comparing therapeutic outcomes between real and placebo acupuncture).""" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Blinding test questionnaire 1 (BTQ 1)
Secondary outcome measures:
Bang's blinding index
Massachusetts General Hospital Acupuncture Sensation Scale index
Physiological data: heart rate, heart rate variability, skin conductance response""" ;
    tara-kb:hasTreatmentDuration "30 minutes" ;
    tara-kb:hasTreatmentFrequency "Not specified (the paper only describes a single session of treatment with a duration of 30 minutes, but does not provide information on the frequency of treatments)" .

