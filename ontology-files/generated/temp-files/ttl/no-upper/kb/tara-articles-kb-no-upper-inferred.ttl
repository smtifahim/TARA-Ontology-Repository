        "Bladder 11",
        "Influential Point of Bone",
        "UB 11",
        "Urinary Bladder 11" ;
    tara-ap:hasVasculatureInformation "The medial cutaneous branches of the posterior branches of the intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
