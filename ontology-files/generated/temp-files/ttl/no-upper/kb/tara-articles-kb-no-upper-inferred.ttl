TARA:1787498 a owl:Class ;
    rdfs:label "Shu Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "Represents one of the five Shu Points. Each of the twelve main meridians has, below the elbow or knee, five specific points, namely, Jing-Well, Ying-Spring, Shu-Stream, Jing-River and He-Sea, which are termed Five Shu points in general. They are situated in the above order from the distal end of extremities to the elbow or knee. It is said in the first chapter of Miraculous Pivot that \"the qi of the twelve main meridians and fifteen collaterals flow all over the body. The flow of qi running in the meridians from the extremities to the elbow or knee is flourishing gradually.\" The names of the five shu points image the flow of meridian qi as the flow of water." ;
    tara-ap:hasSpecialPointRole TARA:1375080 ;
    rdfs:subClassOf TARA:4943316 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4943316 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:1375080 ] ) ] .

TARA:3091322 a owl:Class ;
    rdfs:label "Confluent Point Role" ;
    rdfs:subClassOf TARA:8173108 .

