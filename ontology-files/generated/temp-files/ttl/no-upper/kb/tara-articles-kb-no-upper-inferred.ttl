MONDO:0001357 a owl:Class ;
    rdfs:label "hypochromic anemia" ;
    IAO:0000115 "Anemia caused by the reduction of hemoglobin in relation to the red cell volume. As a result, the red cells have an area of central pallor which is increased in size. The leading cause is iron deficiency." ;
    IAO:0000589 "hypochromic anemia (disease)" ;
