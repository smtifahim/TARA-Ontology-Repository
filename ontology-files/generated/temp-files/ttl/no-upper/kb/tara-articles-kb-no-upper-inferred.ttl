tara-kb:S-112625-279 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-279" ;
    dc:title "Impact of electro-acupuncture and physical exercise on hyperandrogenism and oligo/amenorrhea in women with polycystic ovary syndrome: a randomized controlled trial" ;
    tara-kb:hasAcupunctureProtocol """Segmental acupuncture points: CV 3, CV 6, ST 29, SP 6, SP 9 (located in abdominal muscles with innervations corresponding to the ovaries)
Extrasegmental acupuncture points: LI 4, PC 6 (alternating between muscles in the hand and/or lower arm)
Needle depth: 15-35 mm
Electrical stimulation: CV 3, CV 6, ST 29, SP 6, SP 9 with low-frequency EA of 2 Hz for 30 min
Manual stimulation: LI 4/PC 6 by rotating the needle every 10 min""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """No active intervention: This group received no active treatment but was provided with general information about the benefits of regular physical exercise.
Physical exercise: This group participated in a physical exercise program consisting of regular aerobic exercise.""" ;
    tara-kb:hasCountryOfStudy "Sweden" ;
    tara-kb:hasDatasetLink "Not specified" ;
