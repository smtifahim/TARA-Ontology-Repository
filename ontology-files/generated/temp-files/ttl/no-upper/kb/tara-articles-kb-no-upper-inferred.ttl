        "UMLS:C0311277" ;
    OboInOwl:hasExactSynonym "Abdominal obesity",
        "Central obesity" ;
    rdfs:subClassOf HP:0001513 .

HP:0012758 a owl:Class ;
    rdfs:label "Neurodevelopmental delay" ;
    IAO:0000115 "Neurodevelopmental delay (NDD) refers to delays in the maturation of the brain and central nervous system; infants and young children with NDD may experience delays in the development of one or more skills including gross motor abilities, fine-motor coordination, language abilities and ability to solve increasingly complex problems." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-04-03T12:16:19+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4022738" ;
    OboInOwl:hasExactSynonym "NDD" ;
    rdfs:comment "Though the definitions of NDD vary broadly in the literature, all are used to signify a delay in one or more developmental domains compared to typical development." ;
    rdfs:subClassOf HP:0012759 .

HP:0012759 a owl:Class ;
    rdfs:label "Neurodevelopmental abnormality" ;
    IAO:0000115 "A deviation from normal of the neurological development of a child, which may include any or all of the aspects of the development of personal, social, gross or fine motor, and cognitive abilities." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-04-03T12:20:28+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "UMLS:C4022737" ;
    rdfs:comment "This term should be used to describe abnormalities with onset in the developmental period." ;
    rdfs:subClassOf HP:0012638 .

HP:0012786 a owl:Class ;
    rdfs:label "Recurrent cystitis" ;
    IAO:0000115 "Repeated infections of the urinary bladder." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-04-22T09:18:06+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:197853008",
        "UMLS:C0581366" ;
    OboInOwl:hasExactSynonym "Recurrent bladder infections" ;
    rdfs:comment "One definition of recurrent cystitis involves 3 or more diagnosed cystitis episodes (ICD-9 codes 595.0, 595.9, 597.81, 599.0 with episodes separated by 30 days or more) within a 12-month period or 2 episodes within 6 months." ;
    rdfs:subClassOf HP:0000010,
        HP:5210191 .

HP:0012875 a owl:Class ;
    rdfs:label "Abnormal ejaculation" ;
    IAO:0000115 "Abnormality in the process of ejection of semen (usually carrying sperm) from the male reproductive tract." ;
    dcterms:creator <https://orcid.org/0000-0002-6996-5279> ;
    dcterms:date "2014-06-09T11:21:29+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:386674000",
        "UMLS:C2937350" ;
    rdfs:subClassOf HP:0012874 .

HP:0012877 a owl:Class ;
    rdfs:label "Retrograde ejaculation" ;
    IAO:0000115 "The emission of semen and seminal fluid into the bladder instead of through the penis during orgasm." ;
    dcterms:creator <https://orcid.org/0000-0002-6996-5279> ;
    dcterms:date "2014-06-09T11:25:24+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:50112006",
        "UMLS:C0403673" ;
    rdfs:subClassOf HP:0012875 .

HP:0020342 a owl:Class ;
    rdfs:label "Unusual stomatitis" ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2026-05-22T11:17:28+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "Unusual infectious stomatitis",
        "Unusual oral mucosal infection" ;
    rdfs:subClassOf HP:0010280,
        HP:5210280 ;
    owl:incompatibleWith "Stomatitis is an inflammation of the mucous membranes of any of the structures in the mouth. An unusual stomatitis is characterized by an increased susceptibility to infectious stomatitis, as manifested by recurrent or severe oral mucosal infection." .

HP:0025015 a owl:Class ;
    rdfs:label "Abnormal vascular morphology" ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-08-12T11:24:56+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0002597,
        HP:0030680 .

HP:0025033 a owl:Class ;
    rdfs:label "Abnormal digestive system morphology" ;
    IAO:0000115 "A structural anomaly of the digestive system." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-08-27T13:58:23+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "Abnormality of digestive system morphology" ;
    rdfs:subClassOf HP:0025031 .

HP:0025085 a owl:Class ;
    rdfs:label "Bloody diarrhea" ;
    IAO:0000115 "Passage of many stools containing blood." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-10-15T13:58:14+00:00"^^xsd:dateTime ;
    OboInOwl:hasBroadSynonym "Blood in stool",
        "Bloody stool" ;
    OboInOwl:hasExactSynonym "Bloody bowel movement",
        "Bloody diarrhea" ;
    rdfs:comment "Diarrhea that contains bright red or maroon-colored blood may be referred to as hematochezia, while melena is used to describe black, tarry, and smelly diarrhea." ;
    rdfs:subClassOf HP:0002014 .

HP:0025276 a owl:Class ;
    rdfs:label "Abnormality of skin adnexa physiology" ;
    IAO:0000115 "Any functional anomaly of the skin adnexa (skin appendages), which are specialized skin structures located within the dermis and focally within the subcutaneous fatty tissue, comprising three histologically distinct structures: (1) the pilosebaceous unit (hair follicle and sebaceous glands); (2) the eccrine sweat glands; and (3) the apocrine glands." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-12-18T14:51:16+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0001574 .

HP:0025280 a owl:Class ;
    rdfs:label "Pain characteristic" ;
    IAO:0000115 "A pain characteristic is defined as a subjective category or type of pain." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-12-18T15:21:51+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0012823 .

HP:0025323 a owl:Class ;
    rdfs:label "Abnormal arterial physiology" ;
    IAO:0000115 "An anomaly of arterial function." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-02-03T12:08:38+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0030163 .

HP:0025424 a owl:Class ;
    rdfs:label "Abnormal larynx physiology" ;
    IAO:0000115 "Any anomaly of the function of the larynx." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-04-23T12:46:36+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0001600 .

HP:0025425 a owl:Class ;
    rdfs:label "Laryngospasm" ;
    IAO:0000115 "A spasm (involuntary contraction) of the vocal cords that can make it difficult to speak or breathe." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-04-23T12:48:07+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0025424 .

HP:0025502 a owl:Class ;
    rdfs:label "Overweight" ;
    IAO:0000115 "Increased body weight with a body mass index of 25-29.9 kg per square meter." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-05-14T20:12:36+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0004324 .

HP:0025780 a owl:Class ;
    rdfs:label "Abnormal volitional state" ;
    IAO:0000115 "An abnormality of internal states of motivation or drive that compromise, or interfere with, the ability of the person to attend to basic personal, social, or vocational activities." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2024-07-21T16:05:20+00:00"^^xsd:dateTime ;
    OboInOwl:hasAlternativeId "HP:5200275" ;
    OboInOwl:hasRelatedSynonym "Abnormal energy",
        "Abnormal motivation" ;
    rdfs:subClassOf HP:0025766 .

HP:0025783 a owl:Class ;
    rdfs:label "Diagnostic behavioral phenotype" ;
    IAO:0000115 "The Human Phenotype Ontology provides terms to describe specific phenotypic abnormalities rather than disease diagnoses. Nevertheless, it is common for descriptions such as 'Autism' to be used to describe individuals affected with Mendelian forms of neurodevelopmental disease and many other conditions. If possible, we recommend annotation using specific terms in other branchs of the Atypical behavior subontology, but if this is not possible, then terms from this branch may be used." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2024-08-03T10:05:59+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0000708 .

HP:0025792 a owl:Class ;
    rdfs:label "Abnormal cognitive process" ;
    IAO:0000115 "An abnormal cognitive process can be defined as a deviation from the typical development, structural organization, or functional execution of mental operations that connect informational inputs to behavioral outputs, typically involve at least one of the following processes: perception, memory, learning, emotion, intentionality, self-representation, rationality, and decision-making." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2024-08-07T17:25:08+00:00"^^xsd:dateTime ;
    rdfs:comment "Definition adapted from Newen A (2017) What are cognitive processes? An example-based approach. Synthese 194:4251-4268." ;
    rdfs:subClassOf HP:0011446 .

HP:0030012 a owl:Class ;
    rdfs:label "Abnormal female reproductive system physiology" ;
    OboInOwl:hasDbXref "UMLS:C4020714",
        "UMLS:C4022678" ;
    OboInOwl:hasExactSynonym "Abnormal female reproductive system physiology" ;
    OboInOwl:hasRelatedSynonym "Abnormal female genital system physiology" ;
    rdfs:subClassOf HP:0000080 .

HP:0030163 a owl:Class ;
    rdfs:label "Abnormal vascular physiology" ;
    IAO:0000115 "Abnormality of vascular function." ;
    OboInOwl:hasDbXref "UMLS:C4022603" ;
    rdfs:subClassOf HP:0002597,
        HP:0011025 .

HP:0030166 a owl:Class ;
    rdfs:label "Night sweats" ;
    IAO:0000115 "Occurrence of excessive sweating during sleep." ;
    OboInOwl:hasDbXref "SNOMEDCT_US:42984000",
        "UMLS:C0028081" ;
    OboInOwl:hasExactSynonym "Night sweats",
        "Nocturnal hyperhidrosis" ;
    rdfs:comment "Nighttime sweating is a symptom linked to menopause, malignancies, autoimmune diseases, and infections." ;
    rdfs:subClassOf HP:0025142 .

HP:0030828 a owl:Class ;
    rdfs:label "Wheezing" ;
    IAO:0000115 "A high-pitched whistling sound associated with labored breathing." ;
    dcterms:date "2016-05-09T07:51:16+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:56018004",
        "UMLS:C0043144" ;
    OboInOwl:hasExactSynonym "Wheezing" ;
    rdfs:comment "Wheezes and rhonchi are continuous musical lung sounds. The American Thoracic Society (ATS) Committee on pulmonary nomenclature defines wheezes as high-pitched continuous sounds with a dominant frequency of 400 Hz or more, and rhonchi as low-pitched continuous musical sounds with a dominant frequency of about 200 Hz or less" ;
    rdfs:subClassOf HP:0030829 .

HP:0030835 a owl:Class ;
    rdfs:label "Elbow pain" ;
    IAO:0000115 "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the elbow." ;
    dcterms:date "2016-05-17T07:00:44+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:74323005",
        "UMLS:C0239266" ;
    OboInOwl:hasExactSynonym "Elbow pain" ;
    rdfs:subClassOf HP:0012513 .

HP:0030956 a owl:Class ;
    rdfs:label "Abnormality of cardiovascular system electrophysiology" ;
    IAO:0000115 "An anomaly of the electrical conduction physiology of the heart." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-03-17T17:47:04+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0011025 .

HP:0030972 a owl:Class ;
    rdfs:label "Abnormal systemic blood pressure" ;
    IAO:0000115 "A chronic deviation from normal pressure in the systemic arterial system." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-04-18T13:55:40+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "Abnormal systemic BP" ;
    rdfs:subClassOf HP:0011025 .

HP:0031058 a owl:Class ;
    rdfs:label "Impairment of activities of daily living" ;
    IAO:0000115 "Difficulty in performing one or more activities normally performed every day, such as eating, bathing, dressing, grooming, work, homemaking, and leisure." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-05-28T22:14:33+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0025142 .

HP:0031064 a owl:Class ;
    rdfs:label "Impaired continence" ;
    IAO:0000115 "Partial or total incontinence of bowel or bladder." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-05-28T22:29:13+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0031058 .

HP:0031066 a owl:Class ;
    rdfs:label "Abnormal ovarian physiology" ;
    IAO:0000115 "Any anomaly of ovarian function." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-05-28T22:33:50+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0030012 .

HP:0031169 a owl:Class ;
    rdfs:label "Postterm pregnancy" ;
    IAO:0000115 "A pregnancy that extends to 42 weeks of gestation or beyond." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-06-18T19:54:05+00:00"^^xsd:dateTime ;
    rdfs:comment "This term can apply to a child born of a postterm pregnancy." ;
    rdfs:subClassOf HP:0001197 .

HP:0031446 a owl:Class ;
    rdfs:label "Erosion of oral mucosa" ;
    IAO:0000115 "Loss of the superficial layer of the oral mucosa usually resulting in a shallow or crusted lesion." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-09-17T14:19:12+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0011830 .

HP:0031704 a owl:Class ;
    rdfs:label "Abnormal ear physiology" ;
    IAO:0000115 "Any functional anomaly of the ear." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-12-18T00:20:24+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0000598 .

HP:0031797 a owl:Class ;
    rdfs:label "Clinical course" ;
    IAO:0000115 "The course a disease typically takes from its onset, progression in time, and eventual resolution or death of the affected individual." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2018-02-25T14:55:46+00:00"^^xsd:dateTime ;
    OboInOwl:hasRelatedSynonym "Natural history of disease" ;
    rdfs:subClassOf HP:0012823 .

HP:0031816 a owl:Class ;
    rdfs:label "Abnormal oral morphology" ;
    IAO:0000115 "Any structural anomaly of the mouth, which is also known as the oral cavity." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2018-04-29T14:55:47+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0000153 .

HP:0032016 a owl:Class ;
    rdfs:label "Abnormal sputum" ;
    IAO:0000115 "Abnormal appearance of material expectorated (coughed up) from the respiratory system and that is composed of mucus but may contain other substances such as pus, blood, microorganisms, and fibrin." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2018-08-25T12:36:36+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "Abnormal sputum morphology" ;
    rdfs:subClassOf HP:0012252 .

HP:0032153 a owl:Class ;
    rdfs:label "Joint subluxation" ;
    IAO:0000115 "A partial dislocation of a joint." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2018-12-02T13:55:17+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0001367 .

HP:0032180 a owl:Class ;
    rdfs:label "Abnormal circulating metabolite concentration" ;
    IAO:0000115 "An abnormal level of an analyte measured in the blood." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2019-01-12T13:45:59+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0001939 .

HP:0032263 a owl:Class ;
    rdfs:label "Increased blood pressure" ;
    IAO:0000115 "Abnormal increase in blood pressure. An individual measurement of increased blood pressure does not necessarily imply hypertension. In practical terms, multiple measurements are recommended to diagnose the presence of hypertension." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2019-01-27T20:07:59+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "Increased BP" ;
    rdfs:subClassOf HP:0030972 .

HP:0032654 a owl:Class ;
    rdfs:label "Impaired flow-mediated arterial dilatation" ;
    IAO:0000115 "Flow-mediated dilatation is a noninvasive tests of endothelial function that leverages ultrasound to measure arterial diameter and its response to an increase in shear stress, which normally causes endothelium-dependent dilatation. This term pertains to an abnormal reduction in the magnitude of dilatation. Flow-mediated dilatation is usually measured at the brachial artery." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2020-02-16T11:50:52+00:00"^^xsd:dateTime ;
    OboInOwl:hasRelatedSynonym "Endothelial dysfunction" ;
    rdfs:comment "The diameter of the target artery is measured by high-resolution external vascular ultrasound in response to an increase in blood flow (causing shear-stress) during reactive hyperaemia (induced by cuff inflation and then deflation). This leads to endothelium-dependent dilatation; the response is contrasted with that to sublingual nitroglycerin, an endothelium-independent dilator. The artery is scanned and the diameter measured during three conditions; at baseline, during reactive hyperaemia (induced by inflation and then deflation of a sphygmomanometer cuff around the limb, distal to the scanned part of the artery) and finally after administration of sublingual nitroglycerin using a normal antianginal dose of 400 microgram (which causes endothelium-independent smooth muscle mediated vasodilatation)." ;
    rdfs:subClassOf HP:0025323 .

HP:0032892 a owl:Class ;
    rdfs:label "Infection-related seizure" ;
    IAO:0000115 "Seizure associated with a presumed or proven infection (excluding infection of the central nervous system) or inflammatory state without an alternative precipitant such as metabolic derangement, and regardless of the presence or absence of a fever." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2020-03-18T14:01:49+00:00"^^xsd:dateTime ;
    rdfs:comment "This includes seizures in the context of febrile or afebrile infection." ;
    rdfs:subClassOf HP:0001250 .

HP:0032894 a owl:Class ;
    rdfs:label "Seizure precipitated by febrile infection" ;
    IAO:0000115 "Any form of seizure occurring at the time of a fever (temperature at or above 38.0 degrees Celcius) without infection of the central nervous system, and without an alternative cause such as severe metabolic derangement, occurring at any age." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2020-03-18T14:01:49+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "Fever induced seizure" ;
    rdfs:comment "Typically febrile seizures are limited to the age range of 3 months to 6 years and not accompanied or preceded by afebrile seizures; in this case febrile seizures are not considered indicative of epilepsy. When febrile seizures occur prior to the age of 3 months, or continue beyond the 6th birthday, or when a person has both febrile seizures and afebrile generalized tonic-clonic seizures then a diagnosis of Febrile Seizures Plus (an epilepsy syndrome) may be made." ;
    rdfs:subClassOf HP:0032892 .

HP:0033345 a owl:Class ;
    rdfs:label "Neuralgia" ;
    IAO:0000115 "Pain (An unpleasant sensory and emotional experience) along the course of a nerve." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2020-11-30T17:57:46+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0012531 .

HP:0033676 a owl:Class ;
    rdfs:label "Posttraumatic stress symptom" ;
    IAO:0000115 "A behavioral or psychological symptom that typically occurs following exposure to one or more traumatic events is posttraumatic stress disorder (PTSD). Symptoms of PTSD include intrusive recollections, such as re-experiencing the trauma through flashbacks, memories, or nightmares. Additionally, individuals may experience avoidant and numbing symptoms, which can include diminished emotions and avoidance of situations that serve as reminders of the traumatic event. Hyperarousal is another symptom, characterized by increased irritability, exaggerated startle reactions, and difficulties with sleeping or concentrating." ;
    dcterms:contributor <https://orcid.org/0000-0001-8430-6039>,
        <https://orcid.org/0000-0002-0692-412X>,
        <https://orcid.org/0000-0002-7405-0954>,
        <https://orcid.org/0000-0003-0072-5522>,
        <https://orcid.org/0000-0003-0224-647X>,
        <https://orcid.org/0000-0003-3398-7270>,
        <https://orcid.org/0009-0004-0873-4444> ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2021-03-02T00:54:28+00:00"^^xsd:dateTime ;
    OboInOwl:hasRelatedSynonym "PTSD" ;
    rdfs:comment "This term is intended to be used when no additional information is available. If possible, more specific terms should be used." ;
    rdfs:subClassOf HP:5200230 .

HP:0033747 a owl:Class ;
    rdfs:label "Abnormal exteroceptive sensation" ;
    IAO:0000115 "A type of somatic sensory dysfunction characterized by abnormality of superficial sensation that is mediated by receptors in skin and mucous membranes." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2021-04-21T10:58:44+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0003474 .

HP:0034241 a owl:Class ;
    rdfs:label "Prenatal death" ;
    IAO:0000115 "Death of a fetus in the uterus." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2022-04-10T17:51:32+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "Death before birth",
        "Intrauterine death" ;
    rdfs:subClassOf HP:0011420 .

HP:0034353 a owl:Class ;
    rdfs:label "Appendicular spasticity" ;
    IAO:0000115 "A type of spasticity that affects one or more limbs (arms or legs)." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2022-09-04T18:49:24+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "Extremity spasticity",
        "Limb spasticity",
        "Spastic extremities",
        "Spastic limb",
        "Spastic limbs",
        "Spasticity of extremities",
        "Spasticity of extremity",
        "Spasticity of limbs" ;
    rdfs:subClassOf HP:0001257 .

HP:0034669 a owl:Class ;
    rdfs:label "Abnormal knee morphology" ;
    IAO:0000115 "A structural abnormality of the knee joint or surrounding structures." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2023-03-25T13:22:12+00:00"^^xsd:dateTime ;
    OboInOwl:hasAlternativeId "HP:0041064" ;
    rdfs:subClassOf HP:0002815 .

HP:0034674 a owl:Class ;
    rdfs:label "Abnormal ankle physiology" ;
    IAO:0000115 "A functional anomaly of the ankle." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2023-03-25T13:31:03+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0003028 .

HP:0040006 a owl:Class ;
    rdfs:label "Mortality/Aging" ;
    dcterms:creator <https://orcid.org/0000-0002-5316-1399> ;
    OboInOwl:hasDbXref "UMLS:C4022499" ;
    rdfs:subClassOf HP:0031797 .

HP:0040064 a owl:Class ;
    rdfs:label "Abnormality of limbs" ;
    dcterms:creator <https://orcid.org/0000-0002-5316-1399> ;
    OboInOwl:hasDbXref "SNOMEDCT_US:445144002",
        "UMLS:C0239337",
        "UMLS:C4073131" ;
    OboInOwl:hasExactSynonym "Abnormal limbs",
        "Abnormality of limbs",
        "Limb anomaly" ;
    OboInOwl:hasRelatedSynonym "Dysmelia" ;
    rdfs:subClassOf HP:0000118 .

HP:0040270 a owl:Class ;
    rdfs:label "Impaired glucose tolerance" ;
    IAO:0000115 "An abnormal resistance to glucose, i.e., a reduction in the ability to maintain glucose levels in the blood stream within normal limits following oral or intravenous administration of glucose." ;
