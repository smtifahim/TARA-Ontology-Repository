        "Anterior ramus of third thoracic nerve",
        "Third thoracic anterior ramus",
        "Ventral ramus of third thoracic spinal nerve" ;
    rdfs:subClassOf UBERON:0003727 .

ILX:0789482 a owl:Class ;
    rdfs:label "Second intercostal nerve" ;
    ilxtr:hasExistingId FMA:8602,
        ILX:0789482 ;
    OboInOwl:hasExactSynonym "Anterior ramus of T2",
        "Anterior ramus of second thoracic nerve",
        "Second thoracic anterior ramus",
        "Ventral ramus of second thoracic spinal nerve" ;
