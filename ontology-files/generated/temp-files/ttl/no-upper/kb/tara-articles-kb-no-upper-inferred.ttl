tara-kb:S-112625-619 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-619" ;
    dc:title "Effects of acupuncture to treat fibromyalgia: A preliminary randomised controlled trial" ;
    tara-kb:hasAcupunctureProtocol """Sternocleidomastoideus
Trapezius
Pectoralis major
Quadratus lumborum
Erector spinae
Gluteus medius
Hamstrings
Other
Trigger points chosen based on patient's symptoms and pain pattern
Four common acupuncture points used for electroacupuncture (not specified)""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "Group A served as a control group, receiving standard medication during a five-week control period before starting acupuncture treatments. Group B received continuous acupuncture. The control group was not a traditional waitlist or sham acupuncture group but rather a delayed intervention group receiving standard medication initially." ;
    tara-kb:hasCountryOfStudy "Japan" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Sternocleidomastoideus, Trapezius, Pectoralis major, Quadratus lumborum, Erector spinae, Gluteus medius, Hamstrings" ;
    tara-kb:hasListedAcupointsUnmappable "Erector spinae",
        "Gluteus medius",
        "Hamstrings",
        "Pectoralis major",
        "Quadratus lumborum",
        "Sternocleidomastoideus",
        "Trapezius" ;
    tara-kb:hasMappedWesternCondition MONDO:0005546 ;
    tara-kb:hasNeedlingDetails """Standard acupuncture points: 5-20 mm
Trigger points: 10-20 mm""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-619 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-619 ;
    tara-kb:hasSampleSizeDetails """Total sample size analyzed: 13
Group A: 6
Group B: 7""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (the study compares acupuncture to standard medication, not to a sham acupuncture group)" ;
    tara-kb:hasStimulationTypeDetails """Electroacupuncture: Electrical stimulation using a pulse generator with a rectangular current, biphasic top, and a frequency of 4 Hz. Intensity was set to induce a visible muscular contraction.
Trigger point acupuncture: Manual stimulation to elicit a local muscle twitch response.""" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not provide a TCM-specific diagnosis or terminology for the condition)" ;
    tara-kb:hasStudiedWesternCondition "Fibromyalgia" ;
    tara-kb:hasStudyFindings "Yes, the acupuncture intervention was found to be effective compared to the control group based on the primary outcomes of pain intensity and quality of life, with statistical significance (P = 0.022 for pain intensity and P = 0.026 for QoL)." ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Pain intensity (visual analogue scale, VAS), Pain disability (fibromyalgia impact questionnaire, FIQ)
Secondary outcome measures: Not specified""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: 30 minutes
Duration needles were left in place: 10 minutes (after trigger point acupuncture)""" ;
    tara-kb:hasTreatmentFrequency "The frequency of treatment was once a week. Group A received five treatments after a five-week control period, while Group B received ten treatments. Each session lasted for 30 minutes." .

