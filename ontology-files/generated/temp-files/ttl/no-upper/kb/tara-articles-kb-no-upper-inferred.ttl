    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/8/8d/Male_Knee_by_David_Shankbone.jpg"^^xsd:anyURI .

UBERON:0001814 a owl:Class ;
    rdfs:label "brachial nerve plexus" ;
    IAO:0000115 "An arrangement of nerve fibers, running from the spine where it proceeds through the neck then the axilla and into the arm where it innervates skin and muscle. [WP,modified]." ;
