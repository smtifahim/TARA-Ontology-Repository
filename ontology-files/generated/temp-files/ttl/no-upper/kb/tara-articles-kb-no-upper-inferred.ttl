TARA:7819406 a owl:Class ;
    rdfs:label "Major Luo-Connecting Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Major Luo-Connecting Point is a Luo-Connecting point. Each of twelve main meridians has, on the limbs, a Luo-Connecting Point to link its exteriorly-interiorly related meridian. Each of the Governor and Conception vessels, and the Major Collateral of the spleen has its Luo-Connecting Point on the trunk. A Luo-Connecting Point is used to treat disorders involving the two exteriorly-interiorly related meridians and those in the area supplied by the two meridians." ;
    tara-ap:hasSpecialPointRole TARA:6035619 ;
    rdfs:subClassOf TARA:6993030 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:6993030 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:6035619 ] ) ] .

