                    owl:someValuesFrom ILX:0795285 ] ],
        TARA:1092703 .

TARA:7226516 a owl:Class ;
    rdfs:label "Acupuncture Meridian"@en ;
    IAO:0000115 "A one-dimensional continuant fiat boundary, demarcated by convention within traditional Chinese medicine theory rather than by any natural physical discontinuity in the body, along which Acupoints are located."@en ;
    IAO:0000116 "Acupuncture Meridian is modeled as a subclass of 'one-dimensional continuant fiat boundary' (BFO:0000009): a TCM meridian is a channel/line demarcated by convention within acupuncture theory, not by any natural physical discontinuity, matching the fiat-line character of BFO:0000009 class's own examples (e.g. the Equator, lines of latitude/longitude)."@en ;
    dcterms:bibliographicCitation "Maurer, N., Nissel, H., Egerbacher, M., Gornik, E., Schuller, P., & Traxler, H. (2019). Anatomical evidence of acupuncture meridians in the human extracellular matrix: results from a macroscopic and microscopic interdisciplinary multicentre study on human corpses. Evidence-Based Complementary and Alternative Medicine, 2019. https://doi.org/10.1155/2019/6976892" ;
    dcterms:description "In traditional Chinese Medicine (TCM), meridians are strings connecting acupuncture points, which are considered as passageways through which energy flows throughout the body. The meridian system is composed of 12 principal meridians, each of which connects to an organ system and extends to an extremity and eight collaterals."@en ;
    tara-ap:hasSynonym "Acupuncture Channel",
        "Acupuncture Pathway",
        "Meridian" .

TARA:7634323 a owl:Class ;
    rdfs:label "PC 3" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 153. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "曲澤(泽,沢)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001461 ;
    tara-ap:hasInnervationInformation "The median nerve." ;
    tara-ap:hasListedIndications "cardiac pain, palpitation, febrile diseases, irritability, stomachache, vomiting, pain in the elbow and arm, tremor of the hand and arm." ;
    tara-ap:hasLocationalDescription "On the anterior aspect of the elbow, at the cubital crease, in the depression medial to the biceps brachii tendon. Note: When the elbow is flexed at 45 degrees, PC3 is located medial to the biceps brachii tendon." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.7 inch, or prick with a three-edged needle to cause bleeding. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Quze" ;
    tara-ap:hasSpecialPointRole TARA:6594221 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0008188,
        ILX:0795332 ;
    tara-ap:hasSynonym "HC 3",
        "P 3",
        "PE 3",
        "Per 3",
        "Pericardium 3" ;
    tara-ap:hasVasculatureInformation "On the pathway of the brachial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4694897 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795332 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0008188 ] ],
