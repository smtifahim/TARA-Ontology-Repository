TARA:1468221 a owl:Class ;
    rdfs:label "Front-Mu Point of the Large Intestine" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Front-Mu Point of the Large Intestine meridian. Front-Mu points are those points on the chest and abdomen where the qi of the respective zang-fu organs is infused and converged. Located close to their corresponding zang-fu organs, the Front-Mu points play a significant role in the diagnosis and treatment of the disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole TARA:4713556 ;
    rdfs:subClassOf TARA:8746709 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:8746709 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:4713556 ] ) ] .

TARA:1503026 a owl:Class ;
    rdfs:label "Back-Shu Point of the Stomach" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Back-Shu Point of the Stomach meridian. Back-Shu points are specific points on the back where the qi of the respective zang-fu organs is infused. Situated close to their respectively related zang-fu organs, the Back-Shu points present abnormal reactions to the dysfunction of their corresponding zang-fu organs. They are often used for disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole TARA:6397214 ;
    rdfs:subClassOf TARA:3861175 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:3861175 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:6397214 ] ) ] .

TARA:1632803 a owl:Class ;
    rdfs:label "BL 3" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 101. https://iris.who.int/handle/10665/353407",
