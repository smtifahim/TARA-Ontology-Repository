TARA:8807122 a owl:Class ;
    rdfs:label "GV 3" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 205. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "腰陽(阳)關(关,関)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0005462 ;
    tara-ap:hasInnervationInformation "The medial branch of the posterior ramus of the lumbar nerve." ;
    tara-ap:hasLocationalDescription "In the lumbar region, in the depression inferior to the spinous process of the fourth lumbar vertebra (L4), on the posterior median line. Note: GV 3 can be located by first palpating the highest points of the iliac crests and the spinous process of the fourth lumbar vertebra (L4) can then be found at the midpoint of the highest points of both iliac crests." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Yaoyangguan" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004620,
        UBERON:0014437,
        ILX:0795312 ;
    tara-ap:hasSynonym "Du 3",
        "Governor Vessel 3",
        "VG 3" ;
    tara-ap:hasVasculatureInformation "The posterior branch of the lumbar artery." ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
