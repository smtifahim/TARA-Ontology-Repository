tara-ap:hasLocationalDescription a owl:AnnotationProperty ;
    rdfs:label "Locational Description"@en ;
    dcterms:description """An annotation property that provides the canonical textual description of an acupoint's anatomical location on the body surface. Values follow the WHO Standard Acupuncture Point Locations where available.

Example: 'LU 1' tara:hasLocationalDescription "On the anterior thoracic region, at the same level as the first intercostal space, lateral to the infraclavicular fossa, 6 B-cun lateral to the anterior median line.\""""@en ;
    dcterms:isRequiredBy tara-ap:hasGeneralSurfaceLocation,
        tara-ap:hasRelatedSurfaceAnatomy,
        tara-ap:hasSpecificReferenceLocation,
        tara-op:hasGeneralSurfaceLocation,
        tara-op:hasRelatedSurfaceAnatomy,
        tara-op:hasSpecificReferenceLocation ;
    rdfs:domain TARA:1132428 ;
    rdfs:subPropertyOf tara-ap:hasAcupointInformation .

