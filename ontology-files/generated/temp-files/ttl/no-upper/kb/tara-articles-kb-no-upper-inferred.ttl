    tara-ap:hasGeneralSurfaceLocation UBERON:0005462 ;
    tara-ap:hasListedIndications "pain and stiffness of the lower back, diarrhea, indigestion." ;
    tara-ap:hasLocationalDescription "In the lumbar region, in the depression inferior to the spinous process of the first lumbar vertebra (L1), on the posterior median line." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Xuanshu" ;
