            owl:someValuesFrom UBERON:0001354 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedVein ;
            owl:someValuesFrom UBERON:0007154 ],
        TARA:5282844 .

TARA:6615149 a owl:Class ;
    rdfs:label "TE 17" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 166. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "翳風(风)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasInnervationInformation "The great auricular nerve; deeper, the site where the facial nerve perforates out of the stylomastoid foramen." ;
    tara-ap:hasListedIndications "tinnitus, deafness, otorrhea, facial paralysis, toothache, swelling of the cheek, scrofula, trismus." ;
    tara-ap:hasLocationalDescription "In the anterior region of the neck, posterior to the ear lobe, in the depression anterior to the inferior end of the mastoid process." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Yifeng" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001847,
        UBERON:0011220 ;
    tara-ap:hasSynonym "SJ 17",
        "San Jiao 17",
        "TB 17",
        "TH 17",
        "TW 17",
        "Triple Burner 17",
        "Triple Energizer 17",
        "Triple Heater 17",
        "Triple Warmer 17" ;
    tara-ap:hasVasculatureInformation "The posterior auricular artery and vein, the external jugular vein." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001847 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000974 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0011220 ] ],
        TARA:5361067 .

TARA:6705086 a owl:Class ;
    rdfs:label "Shu-Stream Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the five Shu Points, the Shu-Stream point is where the meridian qi flourishes. In the yin meridians, the Yuan-Primary Points overlap with the Shu-Stream points of the five Shu Points. Each yang meridian, however, has its Yuan-Primary Point other than the Shu-Stream Point." ;
    tara-ap:hasSpecialPointRole TARA:1716565 ;
    rdfs:subClassOf TARA:1787498 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:1787498 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:1716565 ] ) ] .

TARA:7315457 a owl:Class ;
    rdfs:label "Jing-River Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the five Shu Points, the Jing-River point is where the meridian qi is pouring abundantly." ;
    tara-ap:hasSpecialPointRole TARA:1758929 ;
    rdfs:subClassOf TARA:1787498 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:1787498 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:1758929 ] ) ] .

TARA:8746709 a owl:Class ;
    rdfs:label "Front-Mu Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "Front-Mu points are those points on the chest and abdomen where the qi of the respective zang-fu organs is infused and converged. Located close to their corresponding zang-fu organs, the Front-Mu points play a significant role in the diagnosis and treatment of the disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole TARA:7571236 ;
    rdfs:subClassOf TARA:2614885 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:2614885 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:7571236 ] ) ] .

TARA:9857829 a owl:Class ;
    rdfs:label "Ying-Spring Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the five Shu Points, the Ying-Spring point is where the meridian qi starts to gush." ;
    tara-ap:hasSpecialPointRole TARA:2478120 ;
    rdfs:subClassOf TARA:1787498 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:1787498 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:2478120 ] ) ] .

TARA:9881298 a owl:Class ;
    rdfs:label "KI 7" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 139. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "復(复)溜" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "The medial sural and medial crural cutaneous nerves; deeper, the tibial nerve." ;
    tara-ap:hasListedIndications "edema, abdominal distension, diarrhea, borborygmus, muscular atrophy of the leg, night sweat, spontaneous sweating, febrile diseases without sweating." ;
    tara-ap:hasLocationalDescription "On the posteromedial aspect of the leg, anterior to the calcaneal tendon, 2 B-cun superior to the prominence of the medial malleolus. Note: At the same level and posterior to KI8." ;
    tara-ap:hasPinyinLabel "Fuliu" ;
    tara-ap:hasSpecialPointRole TARA:7315457 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003701,
        ILX:0795305 ;
    tara-ap:hasSynonym "K 7",
        "KD 7",
        "KID 7",
        "Kidney 7" ;
    tara-ap:hasVasculatureInformation "Deeper, anteriorly, the posterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:4813389 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:1758929 ],
