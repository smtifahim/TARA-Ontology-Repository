    tara-ap:hasChineseLabel "完骨(骨)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasInnervationInformation "The lesser occipital nerve." ;
    tara-ap:hasListedIndications "headache, insomnia, swelling of the cheek, retroauricular pain, deviation of the eye and mouth, toothache." ;
    tara-ap:hasLocationalDescription "In the anterior region of the neck, in the depression posteroinferior to the mastoid process." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Wangu" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0011220 ;
    tara-ap:hasSynonym "G 12",
        "Gallbladder 12" ;
    tara-ap:hasVasculatureInformation "The posterior auricular artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
