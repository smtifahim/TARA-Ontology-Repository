tara-kb:S-112625-1235 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1235" ;
    dc:title "True Acupuncture vs. Sham Acupuncture and Conventional Sports Medicine Therapy for Plantar Fascitis Pain: A Controlled, Double-blind Study" ;
    tara-kb:hasAcupunctureProtocol """K 1: Located halfway between the medial and lateral borders of the sole of the foot and one third of the way from the anterior to the posterior border of the sole.
K 3: Located between the medial malleolus and the Achilles tendon.
Tender point near the calcaneus.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Sham acupuncture: Superficial puncturing up to 3 millimeters on the sole(s) of the affected feet without actual acupuncture stimulation.
Conventional sports medicine therapy: Reduction in activity, stretching exercises, icing after exercise, and salsalate (Disalcid) 1500 mg. twice daily with food.""" ;
    tara-kb:hasCountryOfStudy "Not specified" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "K 1, K 3" ;
    tara-kb:hasListedAcupointsMapped TARA:4362146,
        TARA:4512048 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:4512048\": \"KI 1\", \"TARA:4362146\": \"KI 3\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition MONDO:0004833 ;
    tara-kb:hasNeedlingDetails "Not specified (the paper does not provide a specific depth for true acupuncture)" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1235 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1235 ;
    tara-kb:hasSampleSizeDetails """Total sample size: 43
True acupuncture: 15
Sham acupuncture: 15
Sports medicine therapy: 10""" ;
    tara-kb:hasShamAcupunctureDetails """Type: Superficial puncturing
Location: Sole(s) of the affected feet, 3 centimeters from the base of the first and second toe, and 3 centimeters from the base of the fourth and fifth toe (non points/off meridian)
Penetration: Non penetrating (up to 3 millimeters)
Electrostimulation: Minimal intensity, below threshold of perception""" ;
    tara-kb:hasStimulationTypeDetails """True Acupuncture: Electrostimulation (alternating 5 Hz and 80 Hz) for 20 minutes, intensity adjusted to tolerance.
Sham Acupuncture: Minimal intensity electrostimulation (below threshold of perception) for 20 minutes.""" ;
