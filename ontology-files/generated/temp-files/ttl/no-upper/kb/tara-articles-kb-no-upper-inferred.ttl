TARA:3668538 a owl:Class ;
    rdfs:label "GB 41" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 192. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "足臨(临)泣" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "The branch of the intermediate dorsal cutaneous nerve of the foot." ;
    tara-ap:hasListedIndications "headache, vertigo, pain of the outer canthus, scrofula, pain in the hypochondriac region, distending pain of the breast, irregular menstruation, pain and swelling of the dorsum of foot, spastic pain of the foot and toe." ;
    tara-ap:hasLocationalDescription "On the dorsum of the foot, distal to the junction of the bases of the fourth and fifth metatarsal bones, in the depression lateral to the fifth extensor digitorum longus tendon." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zulinqi" ;
    tara-ap:hasSpecialPointRole TARA:6705086,
        TARA:9493899 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003653,
        UBERON:0003654,
        ILX:0795504 ;
    tara-ap:hasSynonym "G 41",
        "Gallbladder 41" ;
    tara-ap:hasVasculatureInformation "The dorsal arterial and venous network of foot, the fourth dorsal metatarsal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:3091322 ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
