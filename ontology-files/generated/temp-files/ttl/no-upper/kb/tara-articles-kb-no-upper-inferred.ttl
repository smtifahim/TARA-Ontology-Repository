    tara-kb:hasListedAcupointsUnmappable "Cx 6",
        "ear point 22",
        "ear point 34",
        "ear point 55",
        "ear point 58" ;
    tara-kb:hasNeedlingDetails "10 to 20 mm" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-799 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-799 ;
    tara-kb:hasSampleSizeDetails """Total participants: 160
Acupuncture group: 80
Control group: 80""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used in this study)" ;
    tara-kb:hasStimulationTypeDetails "Manual manipulation through rotation to maintain Deqi sensation (soreness, numbness, or distention around the point)." ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly state a TCM disease or condition)" ;
    tara-kb:hasStudiedWesternCondition "Not specified (the paper does not explicitly mention a specific Western medical condition or disease beyond the context of infertility and assisted reproduction)" ;
    tara-kb:hasStudyFindings """"Clinical pregnancies were documented in 34 of 80 patients (42.5%) in the acupuncture group, whereas pregnancy rate was only 26.3% (21 out of 80 patients) in the control group."
"The analysis shows that the pregnancy rate for the acupuncture group is considerably higher than for the control group (42.5% vs 26.3%; Pœ≠.03)."
"Conclusion(s): Acupuncture seems to be a useful tool for improving pregnancy rate after ART."
"The results demonstrate that acupuncture therapy improves pregnancy rate."
Yes""" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Clinical pregnancy rate (defined as the presence of a fetal sac during an ultrasound examination 6 weeks after embryo transfer)
Secondary outcome measures: Not specified""" ;
    tara-kb:hasTreatmentDuration "25 minutes (duration of each acupuncture session), 25 minutes (duration needles were left in place)" ;
    tara-kb:hasTreatmentFrequency "Acupuncture was performed twice: 25 minutes before and after embryo transfer, with each session lasting 25 minutes." .

