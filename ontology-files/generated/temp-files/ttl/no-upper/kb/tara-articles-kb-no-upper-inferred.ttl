TARA:7932600 a owl:Class ;
    rdfs:label "Large Intestine Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Large Intestine Meridian of Hand-Yangming (LI), which consists of 20 standardized acupoints beginning at LI 1 (Shangyang) on the radial side of the index finger near the corner of the nail, traveling up the dorsal-radial aspect of the arm and across the shoulder and side of the neck to the face, and ending at LI 20 (Yingxiang) in the nasolabial sulcus beside the ala of the nose." ;
    tara-ap:hasSynonym "Acupoint of Large Intestine Meridian",
        "Acupoint of the Large Intestine Meridian",
        "Acupoint of the large intestine meridian of hand-yangming",
        "Acupuncture point of the large intestine meridian",
        "Acupuncture point of the large intestine meridian of hand-yangming",
        "LI Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:4610474 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:4610474 ] ) ] .

TARA:8122277 a owl:Class ;
    rdfs:label "LU 9" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 30. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "太淵(渊)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0004452 ;
    tara-ap:hasInnervationInformation "The lateral antebrachial cutaneous nerve and superficial branch of the radial nerve." ;
    tara-ap:hasListedIndications "cough, asthma, hemoptysis, sore throat, palpitation, pain in the chest, wrist and arm." ;
    tara-ap:hasLocationalDescription "On the anterolateral aspect of the wrist, between the radial styloid process and the scaphoid bone, in the depression ulnar to the abductor pollicis longus tendon. Note: On the radial side of the palmar wrist crease, over the radial artery." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.2-0.3 inch. Avoid puncturing the radial artery. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Taiyuan" ;
