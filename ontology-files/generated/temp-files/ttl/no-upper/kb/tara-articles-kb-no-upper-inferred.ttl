        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016416 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom ILX:0784694 ],
        TARA:9460971 .

TARA:8343475 a owl:Class ;
    rdfs:label "Bitong" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Rhinitis, nasal obstruction, nasal boils." ;
    tara-ap:hasLocationalDescription "At the highest point of the nasolabial groove." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously upward 0.3-0.5 inch." ;
    tara-ap:hasSynonym "M-HN 14" ;
    rdfs:subClassOf TARA:3535998 .

TARA:8574156 a owl:Class ;
    rdfs:label "Bizhong" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Paralysis, spasm and contracture of the upper extremities, pain of the forearm." ;
    tara-ap:hasLocationalDescription "On the lateral aspect of the forearm, midway between the transverse wrist crease and elbow crease, between the radius and the ulna." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 1.0-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "M-UE 30" ;
    rdfs:subClassOf TARA:3535998 .

TARA:9492402 a owl:Class ;
    rdfs:label "Jianqian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Pain in the shoulder and arm, paralysis of the upper extremities." ;
    tara-ap:hasLocationalDescription "Midway between the end of the anterior axillary fold and Jianyu (LI 15)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "Jianneiling",
        "M-UE 48" ;
    rdfs:subClassOf TARA:3535998 .

TARA:9542913 a owl:Class ;
    rdfs:label "Acupuncture Study Qualty Appraisal" ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A study quality appraisal data item specifically designed or adapted to evaluate the methodological rigor and reporting completeness of clinical trials or systematic reviews evaluating acupuncture interventions, capturing specific operational variables unique to needle-based therapeutics." ;
    rdfs:subClassOf TARA:7227329 ;
    skos:altLabel "Acupuncture_Study_Qualty_Appraisal" .

tara-ap:hasAssociatedOrgan a owl:AnnotationProperty ;
    rdfs:label "Associated Organ"@en ;
    dcterms:description """An annotation property that records the organ a Meridian is associated with according to traditional Chinese medicine theory, as a simple textual/IRI annotation. Corresponds to the object property tara-op:hasAssociatedOrgan, which is used for logical axioms.

Example: 'Lung Meridian' tara:hasAssociateOrgan 'Lung'."""@en ;
    dcterms:references tara-op:hasAssociatedOrgan ;
    rdfs:domain TARA:7226516 ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-ap:hasSpecialPointRole a owl:AnnotationProperty ;
    rdfs:label "Special Point Role"@en ;
    dcterms:description """An annotation property that records the named special point role(s) designated to an acupoint as a textual annotation. Corresponds to the object property tara-op:hasSpecialPointRole, which is used for the logical classification of Special Points.

Example: 'LU 1' tara:hasSpecialPointRole 'Front-Mu Point of the Lung'."""@en ;
    dcterms:references tara-op:hasSpecialPointRole ;
    rdfs:domain TARA:1132428 ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-ap:isLocatedOnMeridian a owl:AnnotationProperty ;
    rdfs:label "Acupoint of Meridian"@en ;
    dcterms:description """An annotation property that records the Meridian along which an Acupoint is located, as a simple textual/IRI annotation. Corresponds to the object property tara-op:isLocatedOnMeridian, which is used for logical axioms.

Example: 'LU 1' tara:isLocatedOnMeridian 'Lung Meridian'."""@en ;
    dcterms:references tara-op:isLocatedOnMeridian ;
    rdfs:domain TARA:1132428 ;
    rdfs:range TARA:7226516 ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-ap:isMeridianLocationOf a owl:AnnotationProperty ;
    rdfs:label "Meridian of Acupoint"@en ;
    dcterms:description """An annotation property that relates a Meridian to an Acupoint that is located along its linear trajectory, as a simple textual/IRI annotation. Corresponds to the object property tara-op:isMeridianLocationOf, which is used for logical axioms.

Example: 'Lung Meridian' tara:isMeridianLocationOf 'LU 1'"""@en ;
    dcterms:references tara-op:isMeridianLocationOf ;
    rdfs:domain TARA:7226516 ;
    rdfs:range TARA:5151019 ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-kb:hasPublicationDate a owl:AnnotationProperty ;
    rdfs:label "Publication Date" ;
    IAO:0000112 "e.g., \"2021-08-15\" or \"August 2021\"."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "The publication date of the article as reported by the journal, recorded in its original granularity (which may be a full date, a month and year, or a year alone)."@en ;
    tara-ap:hasCompactURI "tara-kb:hasPublicationDate" ;
    rdfs:domain TARA:8223728 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:date,
        tara-kb:hasBibliographicMetadata ;
    skos:altLabel "Publication_Date" .

tara-kb:hasStudiedTCMCondition a owl:AnnotationProperty ;
    rdfs:label "Studied Condition (TCM)" ;
    IAO:0000112 "e.g., \"Qi and Blood Stagnation\" or \"Kidney Yang Deficiency\"."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A dual-purpose annotation property that captures the raw, as-reported Traditional Chinese Medicine (TCM) condition or pattern-differentiation label from the article, while also serving as a super-property for its mapped, standardized counterpart (hasMappedTCMCondition)."@en ;
    tara-ap:hasCompactURI "tara-kb:hasStudiedTCMCondition" ;
    rdfs:domain TARA:6701896 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description,
        tara-kb:hasStudiedCondition ;
    skos:altLabel "Studied_TCM_Condition" .

tara-kb:hasStudiedWesternCondition a owl:AnnotationProperty ;
    rdfs:label "Studied Condition (Western)" ;
    IAO:0000112 "e.g., \"Chronic Low Back Pain\" or \"Migraine without Aura\"."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A dual-purpose annotation property that captures the raw, as-reported Western/biomedical condition label from the article, while also serving as a super-property for its mapped, standardized counterpart (hasMappedWesternCondition)."@en ;
    tara-ap:hasCompactURI "tara-kb:hasStudiedWesternCondition" ;
    rdfs:domain TARA:6701896 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:description,
        tara-kb:hasStudiedCondition ;
    skos:altLabel "Studied_Western_Condition" .

tara-kb:hasStudyLocation a owl:AnnotationProperty ;
    rdfs:label "Study Location" ;
    IAO:0000112 "e.g., \"Seoul National University Hospital, Seoul, South Korea\"."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A dual-purpose annotation property that captures the general, as-reported location or site(s) where the trial was conducted, while also serving as a super-property for the normalized hasCountryOfStudy."@en ;
    tara-ap:hasCompactURI "tara-kb:hasStudyLocation" ;
    rdfs:domain TARA:6701896 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:relation,
        tara-kb:hasAcupunctureStudyMetadata ;
    skos:altLabel "Study_Location" .

tara-kb:hasStudyQualityAppraisalMetadata a owl:AnnotationProperty ;
    rdfs:label "Study Appraisal Metadata"@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "An annotation property that serves as a high-level grouping property under which specific quality appraisal properties are defined to record evaluative quality data, risk-of-bias scores, and methodological rigor metrics calculated for a clinical trial study."@en ;
    dcterms:type tara-kb:grouping ;
    tara-ap:hasCompactURI "tara-kb:hasStudyAppraisalMetadata" ;
    rdfs:comment "Crucially, the values asserted by the sub-properties under this property are not raw data elements directly extracted or verbatim copied from the published journal article. Instead, they represent secondary, derived appraisals generated, either algorithmically by automated computational models or manually by human domain experts, by evaluating an extracted set of primary metadata against standardized scoring frameworks and quality assessment criteria (such as OCSI)." ;
    rdfs:domain TARA:7227329 ;
    rdfs:subPropertyOf tara-kb:hasTARAArticlesMetadata ;
    skos:altLabel "Study_Appraisal_Metadata"@en .

tara-kb:hasStudyType a owl:AnnotationProperty ;
    rdfs:label "Study Type" ;
    IAO:0000112 "e.g., \"Randomized Controlled Trial\", \"Crossover Trial\", \"Meta analysis\", \"Systematic Review\"."@en ;
    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "A dual-purpose annotation property that serves as a super-property for the more granular hasClinicalTrialType, while simultaneously acting as a direct container for the high-level study type categorization."@en ;
    tara-ap:hasCompactURI "tara-kb:hasStudyType" ;
    rdfs:comment "For the high-level study type categorization (e.g., \"Randomized Controlled Trial\", \"Crossover Trial\", \"Meta analysis\", \"Systemetic Review\" )." ;
    rdfs:domain TARA:6701896 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf dcterms:type,
        tara-kb:hasStudyDesignMetadata ;
    skos:altLabel "Study_Type" .

tara-op:hasAssociatedOrgan a owl:ObjectProperty ;
    rdfs:label "hasAssociatedOrgan" ;
    IAO:0000112 "'Lung Meridian' tara-op:hasAssociatedOrgan some 'Lung'."@en ;
    IAO:0000115 "A Meridian a hasAssociatedOrgan an organ b if and only if traditional Chinese medicine theory designates b as the organ system with which a is affiliated."@en ;
    dcterms:description "An object property that relates a Meridian to the organ it is associated with according to traditional Chinese medicine theory. Used to express the organ affiliation of a meridian as an OWL axiom."@en ;
    dcterms:isReferencedBy tara-ap:hasAssociatedOrgan ;
    rdfs:comment "Not declared as a subproperty of any RO relation, because the organ affiliation of a meridian is a doctrinal/functional association defined by TCM theory rather than a spatial or mereological relationship; located_in, overlaps, and part_of do not accurately describe it, so the property is left ungrounded at the top of the object-property hierarchy."@en ;
    rdfs:domain TARA:7226516 ;
    rdfs:subPropertyOf tara-op:topTARAObjectProperty .

tara-op:isSpecialPointRoleOf a owl:ObjectProperty ;
    rdfs:label "isSpecialPointRoleOf" ;
    IAO:0000115 "A role a isSpecialPointRoleOf an Acupoint b if and only if b hasSpecialPointRole a."@en ;
    dcterms:description "An object property that relates a special acupoint role to the Acupoint that bears it. It is the inverse of hasSpecialPointRole."@en ;
    rdfs:comment "Declared as a subproperty of RO:0000081 (role_of) as the inverse counterpart of has_role, consistent with hasSpecialPointRole being a subproperty of RO:0000087 (has_role)."@en ;
    rdfs:domain TARA:4176111 ;
    rdfs:range TARA:1132428 ;
    rdfs:subPropertyOf tara-op:topTARAObjectProperty .

rdfs:comment a owl:AnnotationProperty .

xsd:gYear a rdfs:Datatype .

skos:hiddenLabel a owl:AnnotationProperty ;
    rdfs:label "hidden label" ;
    rdfs:subPropertyOf tara-ap:skosAnntotationProperty,
        rdfs:label ;
    skos:definition "The property skos:hiddenLabel is used to assign a hidden lexical label to a resource. A hidden lexical label is a string of characters that a Knowledge Organization System (KOS) designer would like to be accessible to applications performing text-based indexing and search operations, but would not like to be visible to users on visual displays." .

HP:0000001 a owl:Class ;
    rdfs:label "HPO Root Term" ;
    IAO:0000116 "Please Note: The original rdfs:label for this term (HP:0000001) is called 'All' in HPO. The original rdfs:label is replaced with the current one to avoid ambiguity for the TARA acupoints ontology." ;
    OboInOwl:hasDbXref "UMLS:C0444868" ;
    rdfs:comment "Root of all terms in the Human Phenotype Ontology." ;
