    tara-ap:hasChineseLabel "玉堂" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The anterior cutaneous branch of the third intercostal nerve." ;
    tara-ap:hasListedIndications "pain in the chest, cough, asthma, vomiting." ;
    tara-ap:hasLocationalDescription "In the anterior thoracic region, at the same level as the third intercostal space, on the anterior median line." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Yutang" ;
    tara-ap:hasSpecificReferenceLocation ILX:0795285,
        ILX:0795297 ;
    tara-ap:hasSynonym "Conception Vessel 18",
        "RN 18",
        "Ren 18",
        "VC 18" ;
    tara-ap:hasVasculatureInformation "The anterior perforating branches of the internal mammary artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
    rdfs:subClassOf [ a owl:Restriction ;
