    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dcterms:description "Category B: Technical Intervention Quality Metrics (STRICTA). The sub-score assessing whether the practitioners' background, training, and experience administering acupuncture are reported."@en ;
