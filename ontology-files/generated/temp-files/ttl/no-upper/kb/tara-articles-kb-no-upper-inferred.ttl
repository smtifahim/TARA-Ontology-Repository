TARA:3452202 a owl:Class ;
    rdfs:label "Small Intestine Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Small Intestine Meridian of Hand-Taiyang (SI), which consists of 19 standardized acupoints beginning at SI 1 (Shaoze) on the ulnar side of the little finger near the corner of the nail, traveling up the dorsal-ulnar aspect of the arm, across the scapular region, and ascending along the lateral neck and cheek, and ending at SI 19 (Tinggong) in the depression between the tragus and the mandibular condyloid process." ;
    tara-ap:hasSynonym "Acupoint of Small Intestine Meridian",
        "Acupoint of the Small Intestine Meridian",
        "Acupoint of the small intestine meridian of hand-taiyang",
        "Acupuncture point of the small intestine meridian",
        "Acupuncture point of the small intestine meridian of hand-taiyang",
        "SI Acupoint" ;
    tara-ap:isLocatedOnMeridian TARA:9093316 ;
    rdfs:subClassOf TARA:5151019 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:5151019 [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom TARA:9093316 ] ) ] .

