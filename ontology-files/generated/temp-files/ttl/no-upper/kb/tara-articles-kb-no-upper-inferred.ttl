    tara-ap:hasChineseLabel "淵(渊)液" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795306 ;
    tara-ap:hasInnervationInformation "The lateral cutaneous branch of the fifth intercostal nerve, the branch of the long thoracic nerve." ;
    tara-ap:hasListedIndications "fullness in the chest, swelling of the axillary region, pain in the hypochondriac region, pain and motor impairment of the arm." ;
    tara-ap:hasLocationalDescription "In the lateral thoracic region, in the fourth intercostal space, on the midaxillary line." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch." ;
    tara-ap:hasPinyinLabel "Yuanye" ;
    tara-ap:hasSpecificReferenceLocation ILX:0795298,
        ILX:0795308 ;
    tara-ap:hasSynonym "G 22",
        "Gallbladder 22" ;
    tara-ap:hasVasculatureInformation "The thoracoepigastric vein, the lateral thoracic artery and vein, the fifth intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
