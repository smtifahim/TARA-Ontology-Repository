tara-kb:S-112625-1316 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1316" ;
    dc:title "Randomized Clinical Trial Comparing the Effects of Electro acupuncture and Maprotiline in Treating Depression" ;
    tara-kb:hasAcupunctureProtocol """Primary acupoints: Baihui (DU 20), Yintang (EX)
Insertion technique: Baihuiobliquely in an anterior direction beneath the scalp to 2 3cm; Yintangobliquely and superior, 2 3 cm beneath the skin
Additional points based on TCM diagnosis:
Liver Qi stagnation with Spleen deficiency: Yanglingquan (GB 34), Sanyinjiao (SP 6)
Heart Spleen deficiency: Neiguan (PC 6), Sanyinjiao (SP 6)
Liver kidney yin deficiency: Taixi (KI 3), Sanyinjiao (SP 6)
Sanyinjiao used for all patients as a crossing point for Liver, Kidney, and Spleen meridians""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "Maprotiline (MP) is used as the control group in this study. It is a positive controlled drug used to compare the efficacy of electro acupuncture (EA)." ;
    tara-kb:hasCountryOfStudy "China" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Baihui, Yintang, GB 34, SP 6, PC 6, KI 3" ;
