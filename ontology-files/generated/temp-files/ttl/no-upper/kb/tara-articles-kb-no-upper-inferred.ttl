tara-ap:dctermsMetadata a owl:AnnotationProperty ;
    rdfs:label "dcterms:topMetadataProperty" ;
    dcterms:description "An annotation property to group all dcterms metadata properties specific to TARA Acupoints Ontology."@en .

HP:0012228 a owl:Class ;
    rdfs:label "Tension-type headache" ;
    IAO:0000115 "A type of headache that last hours with continuous pain of mild or moderate intensity, bilateral location, a pressing/tightening (non-pulsating) quality and that is not aggravated by routine physical activity such as walking or climbing stairs." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2013-03-30T07:50:13+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "ICD-10:G44.2",
        "SNOMEDCT_US:398057008",
        "SNOMEDCT_US:66551002",
        "UMLS:C0033893" ;
    OboInOwl:hasExactSynonym "Tension-type headache" ;
    rdfs:subClassOf HP:0002315 .

MONDO:1060198 a owl:Class ;
    rdfs:label "ischemic stroke" ;
    IAO:0000115 "A stroke disorder caused by obstruction of blood flow to the brain, due to thrombotic (local blood clot formation) or embolic (due to a blood clot or other material traveling from another site) event." ;
    dcterms:creator <https://orcid.org/0000-0002-7638-4659> ;
    OboInOwl:hasDbXref "DOID:0051062",
        "MEDGEN:215292",
        "UMLS:C0948008" ;
    OboInOwl:hasExactSynonym "ischaemic stroke" ;
    rdfs:subClassOf MONDO:0005098 ;
    skos:exactMatch <http://identifiers.org/medgen/215292>,
        <http://linkedlifedata.com/resource/umls/id/C0948008>,
        obo:DOID_0051062 .

