        "Chien-yii",
        "Chii-Chih",
        "Chii-ku",
        "Nao-yii" ;
    tara-kb:hasMappedWesternCondition HP:0030834 ;
    tara-kb:hasNeedlingDetails "0.5 to 1.0 inches" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1469 ;
