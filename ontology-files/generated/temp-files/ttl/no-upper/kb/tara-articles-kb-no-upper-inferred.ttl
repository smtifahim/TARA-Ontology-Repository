    OboInOwl:hasExactSynonym "Genital abnormalities",
        "Genital abnormality",
        "Genital anomalies",
        "Genital defects" ;
    OboInOwl:hasRelatedSynonym "Abnormality of the reproductive system" ;
    rdfs:subClassOf HP:0000119 .

HP:0000144 a owl:Class ;
