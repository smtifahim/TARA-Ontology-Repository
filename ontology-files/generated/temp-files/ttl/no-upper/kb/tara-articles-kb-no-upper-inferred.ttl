    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasListedIndications "headache, neck rigidity, pain in the lower back and thigh, epilepsy." ;
    tara-ap:hasLocationalDescription "On the lateral aspect of the foot, distal to the tuberosity of the fifth metatarsal bone, at the border between the red and white flesh. Note: The tuberosity of the fifth metatarsal bone is located approximately midway be- tween the heel and the fifth metatarsophalangeal joint." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Jinggu" ;
    tara-ap:hasSpecialPointRole TARA:1840369 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003654,
        UBERON:0007762 ;
    tara-ap:hasSynonym "B 64",
        "Bladder 64",
        "UB 64",
        "Urinary Bladder 64" ;
    tara-ap:hasVasculatureInformation "The lateral plantar artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom TARA:3455429 ],
        [ a owl:Restriction ;
