tara-kb:S-112625-1050 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1050" ;
    dc:title "Acupuncture for Patients with Spinal Cord Injuries" ;
    tara-kb:hasAcupunctureProtocol """Bilateral Hou Hsi (SI3): Located at the end of the transverse crease of the fifth metacarpophalangeal joint when the hand is in a fisted position.
Bilateral Shen Mo (B62): Located near the inferior lateral malleoli areas of the feet.
Four auricular acupoints related to the spinal cord: Located at the antihelix, helix, and lower portion of the ear-back areas, related to multiple levels of the spinal cord including the lumbar cord level.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group received only rehabilitation therapy, without any acupuncture intervention." ;
    tara-kb:hasCountryOfStudy "Not specified" ;
