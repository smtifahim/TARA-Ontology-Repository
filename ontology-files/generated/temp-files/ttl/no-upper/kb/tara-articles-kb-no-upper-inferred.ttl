TARA:6752232 a owl:Class ;
    rdfs:label "TE 23" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 169. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "絲(丝)竹空" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The zygomatic branch of the facial nerve and the branch of the auriculotemporal nerve." ;
    tara-ap:hasListedIndications "headache, redness and pain of the eye, blurred vision, eyelid twitching, toothache, facial paralysis." ;
    tara-ap:hasLocationalDescription "On the head, in the depression at the lateral end of the eyebrow. Note: TE23 is superior to GB1." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch." ;
    tara-ap:hasPinyinLabel "Sizhukong" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0010163 ;
    tara-ap:hasSynonym "SJ 23",
        "San Jiao 23",
        "TB 23",
        "TH 23",
        "TW 23",
        "Triple Burner 23",
        "Triple Energizer 23",
        "Triple Heater 23",
        "Triple Warmer 23" ;
    tara-ap:hasVasculatureInformation "The frontal branches of the superficial temporal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0010163 ] ],
        TARA:5361067 .

TARA:7218725 a owl:Class ;
    rdfs:label "BL 67" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 133. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "至陰(阴)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003635 ;
    tara-ap:hasInnervationInformation "The plantar digital proprial nerve and the lateral dorsal cutaneous nerve of foot." ;
    tara-ap:hasListedIndications "headache, nasal obstruction, epistaxis, ophthalmalgia, malposition of fetus, difficult labor, detention of after birth, feverish sensation in the sole." ;
    tara-ap:hasLocationalDescription "On the little toe, lateral to the distal pha- lanx, 0.1 f-cun proximal to the lateral corner of the toenail; at the intersection of the vertical line of the lateral side of the nail and the horizontal line of the base of the toenail." ;
    tara-ap:hasMethodDescription "Puncture superficially 0.1 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhiyin" ;
    tara-ap:hasSpecialPointRole TARA:2954517 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0009567 ;
    tara-ap:hasSynonym "B 67",
        "Bladder 67",
        "UB 67",
        "Urinary Bladder 67" ;
    tara-ap:hasVasculatureInformation "The network formed by the dorsal digital artery and plantar digital proprial artery." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0009567 ] ],
