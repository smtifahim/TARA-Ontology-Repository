    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "Sham acupuncture group: received sham acupuncture sessions over a 2-day period before planned medical/pharmacological induction. Sham acupuncture points were selected on the sacral area, hand, foot, a point below the knee, and lower leg with minimal insertion and stimulation." ;
    tara-kb:hasCountryOfStudy "Australia" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "LI 4, SP 6, UB 31, UB 32, ST 36, LIV 3, KI 7, BL 20, BL 21" ;
