    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly state a TCM disease or condition name)" ;
    tara-kb:hasStudiedWesternCondition "Ovulatory Dysfunctional Infertility" ;
    tara-kb:hasStudyFindings """"Ê≤ªÁñó 6 ‰∏™Êúà(2 ‰∏™ÁñóÁ®ã)ÂêéÔºåÊ≤ªÁñóÁªÑÊ≤ªÊÑàÁéá‰∏∫ 76.3%,ÂØπÁÖßÁªÑ‰∏∫ 48.1%,‰∏§ÁªÑÂ∑ÆÂºÇÊúâÁªüËÆ° Â≠¶ÊÑè‰πâ(P<0.05)„ÄÇ"
"The cure rate in the treatment group was 76.3%, versus 48.1% in the control group, showing a significant difference between the two groups (P<0.05)."
"Electroacupuncture can obtain better cure rate than oral Clomifene Citrate Tablets for infertility via ovulation stimulation."
Yes""" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Cure rate (patients becomingPregnant)
Secondary outcome measures: Improvement (1 2 regular menstrual cycles, atypical biphasic BBT,Presence of ovulation by ultrasound examination)""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: 30 minutes
Duration needles were left in place: 30 minutes
Overall treatment duration: 3 months per session, analyzed after 2 sessions""" ;
    tara-kb:hasTreatmentFrequency "Not specified (the paper does not provide explicit details on the frequency of acupuncture treatments)" .

tara-kb:S-112625-1806 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1806" ;
    dc:title "The effectiveness of acupuncture for plantar heel pain: a systematic review" ;
    tara-kb:hasAcupunctureProtocol """PC7, LI4, KI3, BL60, SP6, GB39, ST7, BL61, Ah shi.
Local trigger points.
Classical acupuncture points chosen from a list of 18 points. Points chosen according to the traditional 'eight principles' approach.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT), Non-randomised comparative studies" ;
    tara-kb:hasControlGroupsDetails """Karagounis et al: Standard clinical approach (ice, stretching, NSAIDs)
Zhang et al: LI4
Vrchota et al: Sham acupuncture, sports medicine therapy
