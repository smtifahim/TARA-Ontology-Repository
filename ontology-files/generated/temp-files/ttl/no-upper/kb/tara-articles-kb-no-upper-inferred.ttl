TARA:7646636 a owl:Class ;
    rdfs:label "BL 44" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 121. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "神(神)堂" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasInnervationInformation "The medial cutaneous branches of the posterior rami of the fourth and fifth thoracic nerves; deeper, their lateral branches and the dorsoscapular nerve." ;
    tara-ap:hasListedIndications "asthma, cardiac pain, palpitation, stuffy chest, cough, stiffness and pain of the back." ;
    tara-ap:hasLocationalDescription "In the upper back region, at the same level as the inferior border of the spinous process of the fifth thoracic vertebra (T5), 3 B-cun lateral to the posterior median line. Note: BL44, BL15 and GV11 are located at the same level as the inferior border of the spinous process of the fifth thoracic vertebra (T5)." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Shentang" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004630,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 44",
        "Bladder 44",
        "UB 44",
        "Urinary Bladder 44" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the intercostal artery and vein, the descending branch of the transverse cervical artery." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
