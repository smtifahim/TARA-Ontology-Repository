TARA:0316650 a owl:Class ;
    rdfs:label "GB 6" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 174. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "懸(悬)釐(厘)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasListedIndications "migraine, pain in the outer canthus, tinnitus, frequent sneezing." ;
    tara-ap:hasLocationalDescription "On the head, at the junction of the upper three fourths and lower one fourth of the curved line from St8 to gB7." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Xuanli" ;
    tara-ap:hasSynonym "G 6",
        "Gallbladder 6" ;
    tara-ap:hasVasculatureInformation "The parietal branches of the superficial temporal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0000033 ] ],
        TARA:1926756 .

TARA:0427594 a owl:Class ;
    rdfs:label "GB 29" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 186. https://iris.who.int/handle/10665/353407",
