tara-kb:S-112625-1350 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1350" ;
    dc:title "Symptom Management with Massage and Acupuncture in Postoperative Cancer Patients: A Randomized Controlled Trial" ;
    tara-kb:hasAcupunctureProtocol """For pain: large intestine-4, spleen-6, auricular points corresponding to the area of pain
For nausea: pericardium-6, stomach-36
For anxiety: liver-3, large intestine-4, Yin Tang
Needle specifications: 34 gauge needles, placed bilaterally in symmetrical points and unilaterally for auricular points, to a depth of 1 fen to 3 tsun until de qi was obtained, retained for 20 minutes""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group received usual care alone and was offered a 30-minute massage after completion of the questionnaire on postoperative day 3." ;
    tara-kb:hasCountryOfStudy "United States" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "LI 4, SP 6, auricular points, P 6, ST 36, LV 3, LI 4, Yin Tang" ;
