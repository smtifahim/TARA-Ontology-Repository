TARA:9493899 a owl:Class ;
    rdfs:label "Confluent Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "Confluent Points refer to the eight points on the limbs where the main meridians communicate with the eight extra meridians. They are Neiguan (PC 6). Gongsun (SP 4), Houxi (SJ 3), Shenmai (BL 62). Waiguan (TE 5), Zulinqi (GB 41 ), Lieque (LU 7) and Zhaohai (KI 6), which are respectively connected with the Yin Link Vessel. Thoroughfare Vessel, governor Vessel, Yang Heel Vessel. Yang Link Vessel, Belt Vessel, Conception Vessel and Yin Heel Vessel. The Eight Confluent Points are used to treat a variety of disorders of the corresponding eight extra meridians." ;
    tara-ap:hasSpecialPointRole TARA:3091322 ;
    rdfs:subClassOf TARA:4943316 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:4943316 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:3091322 ] ) ] .

tara-op:isLocatedOnMeridian a owl:ObjectProperty ;
    rdfs:label "isLocatedOnMeridian" ;
    IAO:0000112 "'LU 1' tara-op:isLocatedOnMeridian some 'Lung Meridian'."@en ;
    IAO:0000115 "An Acupoint a isLocatedOnMeridian a Meridian b if and only if a is located_in b, where b is the one-dimensional fiat channel along which a is conventionally situated."@en ;
    dcterms:description "An object property that relates an Acupoint to the Meridian along which it is located."@en ;
    dcterms:isReferencedBy tara-ap:isLocatedOnMeridian ;
    rdfs:comment "Declared as a subproperty of RO:0001025 (located_in) rather than RO:0002350 (member_of), because a Meridian is modeled as a BFO:0000009 (one-dimensional continuant fiat boundary), a channel that acupoints are located along, rather than as an aggregate whose identity is exhausted by the sum of its acupoints; located_in correctly expresses this geometric relationship without implying that the meridian is merely a collection of its acupoints."@en ;
    rdfs:domain TARA:1132428 ;
    rdfs:range TARA:7226516 ;
    rdfs:subPropertyOf tara-op:topTARAObjectProperty ;
    owl:inverseOf tara-op:isMeridianLocationOf .

