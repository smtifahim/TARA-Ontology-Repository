    tara-kb:hasStudiedWesternCondition "Arterial hypertension (high blood pressure)" ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Mean 24-hour ambulatory systolic and diastolic blood pressure levels.
Secondary outcome measures: Average daytime and nighttime systolic and diastolic blood pressures, reduction in blood pressure at peak stress during bicycle stress testing.""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: 30 minutes
Duration needles were left in place: 20 minutes""" ;
    tara-kb:hasTreatmentFrequency """Total sessions: 22
Frequency: 5 sessions/week for the first 2 weeks, 3 sessions/week for the next 4 weeks
Duration per session: approximately 30 minutes""" .

