MONDO:0850282 a owl:Class ;
    rdfs:label "chronic asthma" ;
    IAO:0000115 "An asthma that is characterized by the development of persistent airway inflammation and recurrent attacks of breathlessness and wheezing, which vary in severity and frequency." ;
    mondons:curated_content_resource "https://www.malacards.org/card/chronic_asthma"^^xsd:anyURI ;
    OboInOwl:hasDbXref "DOID:0080809",
