UBERON:0014892 a owl:Class ;
    rdfs:label "skeletal muscle organ, vertebrate" ;
    IAO:0000115 "A muscle organ that consists of skeletal muscle tissue ensheathed in epimysium, that develops from myotome and that is innervated by some somatic motor neuron. Skeletal muscles are typically attached (via a tendon) to a bone but there are exceptions (e.g. intrinsic tongue muscles)." ;
    OboInOwl:hasBroadSynonym "skeletal muscle" ;
