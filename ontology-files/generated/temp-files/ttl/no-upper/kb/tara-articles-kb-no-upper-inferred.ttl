    tara-kb:hasMappedWesternCondition MONDO:0005015 ;
    tara-kb:hasNeedlingDetails """Acupuncture group: BL23: 0.60-1.00 cm
BL24: 0.80-1.10 cm
BL32: 1.00-1.60 cm
BL39: 1.05-1.70 cm
BL54: 1.10-2.00 cm
Sham acupuncture group: 0.3 cm""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1224 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1224 ;
    tara-kb:hasSampleSizeDetails "Total: 45; Acupuncture group: 30; Sham acupuncture group: 15" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: Same as real acupuncture
Quantity: Same as real acupuncture
Size: Same as real acupuncture
Location: Same acupoints as real acupuncture
Penetration: Non-penetrating (inserted to a depth of only 0.3cm)
Manipulation: No manipulation to avoid de qi""" ;
    tara-kb:hasStimulationTypeDetails "The stimulation involved manual manipulation of the needles, with rotation in a clockwise or counterclockwise manner every 5 minutes, aiming to achieve de qi. In the sham acupuncture group, no manipulation was performed to avoid de qi." ;
