    OboInOwl:hasDbXref "SNOMEDCT_US:386806002",
        "UMLS:C0338656",
        "UMLS:C0683322" ;
    OboInOwl:hasExactSynonym "Abnormality of cognition",
        "Cognitive abnormality",
        "Cognitive defects",
        "Cognitive deficits",
        "Cognitive impairment",
        "Intellectual impairment" ;
