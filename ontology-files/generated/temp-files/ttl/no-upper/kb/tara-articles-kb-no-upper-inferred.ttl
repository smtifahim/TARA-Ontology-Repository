    tara-ap:hasChineseLabel "會(会)陰(阴)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002356 ;
    tara-ap:hasInnervationInformation "The branch of the perineal nerve." ;
    tara-ap:hasListedIndications "vaginitis, retention of urine, hemorrhoids, nocturnal emission, enuresis, irregular menstruation, mental disorder." ;
    tara-ap:hasLocationalDescription "In the perineal region, at the midpoint of the line connecting the anus with the posterior border of the scrotum in males and the posterior commissure of labium majoris in females. Note: CV 1 is located midway between the anus and the genital organ, with the subject lying on the side or in knee-chest position." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Huiyin" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001245,
        UBERON:0003133 ;
    tara-ap:hasSynonym "Conception Vessel 1",
        "RN 1",
        "Ren 1",
        "VC 1" ;
    tara-ap:hasVasculatureInformation "The branches of the perineal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:6789717 ;
    rdfs:subClassOf [ a owl:Restriction ;
