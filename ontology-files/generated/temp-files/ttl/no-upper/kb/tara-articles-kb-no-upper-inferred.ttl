HP:0012532 a owl:Class ;
    rdfs:label "Chronic pain" ;
    IAO:0000115 "Persistent pain, usually defined as pain that has lasted longer than 3 to 6 months." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2013-12-15T09:46:55+00:00"^^xsd:dateTime ;
