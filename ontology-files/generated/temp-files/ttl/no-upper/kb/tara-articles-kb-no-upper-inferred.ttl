    tara-ap:hasSynonym "G 29",
        "Gallbladder 29" ;
    tara-ap:hasVasculatureInformation "The branches of the superficial circumflex iliac artery and vein, the ascending branches of the lateral circumflex femoral artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
