tara-kb:S-112625-1802 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1802" ;
    dc:title "Therapeutic Effect Observation on Combined Acupuncture and Medication for Ovulation" ;
    tara-kb:hasAcupunctureProtocol """Guanyuan (CV 4): Regulates essence and blood.
Zhongji (CV 3): Regulates yin blood.
Bilateral Zigong (Ex CA 1): Benefits the female reproductive system.
Zusanli (ST 36): Warms and supplements inborn and acquired qi.
Sanyinjiao (SP 6): Regulates the Liver, Spleen and Kidney Meridians.
Hegu (LI 4): Tonifies qi and invigorates blood.
Taichong (LR 3): Tonifies and regulates blood.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group consisted of 19 cases treated with 50 mg of oral Clomiphene once a day for 5 days, with observations over 50 menstrual cycles. Outcomes included ovulation rate, LUFS prevalence, follicular maldevelopment rate, endometrium thickness, and conception rate." ;
    tara-kb:hasCountryOfStudy "Not specified (the paper does not explicitly mention the country where the study was conducted)" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "CV 4, CV 3, EX CA 1, ST 36, SP 6, LI 4, LR 3" ;
