    tara-kb:hasTreatmentFrequency "Not specified (the paper does not provide information on the frequency of treatment beyond a single application during the study)" .

tara-kb:S-112625-1033 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1033" ;
    dc:title "Electroacupuncture for Control of Myeloablative Chemotherapy-Induced Emesis A Randomized Controlled Trial" ;
    tara-kb:hasAcupunctureProtocol """Electroacupuncture Group: PC6 (located between the tendons of palmaris longus and flexor carpii radialis at 2 body-inches above the wrist crease), ST36 (located between the tibialis anterior muscle and the tendon of the extensor digitorum longus pedis at 1-finger's breadth lateral to the lower border of tibia tuberosity)
Minimal Needling Group: LU7 (located on the lateral aspect of the radius proximal to the styloid process), GB34 (located in the depression anterior and inferior to the head of the fibula)""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails """Antiemetic drugs alone: This group received standard pharmacotherapy without any acupuncture or minimal needling intervention.
Minimal needling: This group involved minimal needling with mock stimulation, serving as a sham control.""" ;
    tara-kb:hasCountryOfStudy "Not specified" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "PC 6, ST 36, LU 7, GB 34" ;
    tara-kb:hasListedAcupointsMapped TARA:3515622,
        TARA:4311153,
        TARA:6463344,
        TARA:8758950 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:4311153\": \"PC 6\", \"TARA:6463344\": \"ST 36\", \"TARA:3515622\": \"LU 7\", \"TARA:8758950\": \"GB 34\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition HP:0002013 ;
    tara-kb:hasNeedlingDetails """Electroacupuncture: 1 body-inch at PC6, 1.5 body-inches at ST36
Minimal Needling: Subcutaneously with no manipulation or stimulation (depth not specified)""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1033 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1033 ;
    tara-kb:hasSampleSizeDetails """Total participants analyzed: 104
Electroacupuncture group: 37
Minimal needling group: 33
Pharmacotherapy alone group: 34""" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: 36-gauge disposable acupuncture needle
Quantity: Two needles
Size: Same as electroacupuncture needles
Location: Near LU7 and GB34 points, not indicated for nausea and emesis control
Penetrating: Yes, subcutaneously
Stimulation: No manipulation or stimulation; mock stimulation with audiovisual stimuli only""" ;
    tara-kb:hasStimulationTypeDetails """Electroacupuncture group: Manual manipulation (twirling, thrusting, lifting, initial flicking) to achieve "de Qi" sensation, followed by electrical stimulation (electroacupuncture) with a pulse generator.
Minimal needling group: No manual manipulation or electrical stimulation; mock stimulation with audiovisual stimuli only.""" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not provide a specific TCM diagnosis or condition related to the emesis being studied)" ;
    tara-kb:hasStudiedWesternCondition "Emesis associated with myeloablative chemotherapy in breast cancer patients" ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measure: Total number of emesis episodes during the 5-day study period.
Secondary outcome measure: Proportion of emesis-free days across the 3 treatment groups.""" ;
    tara-kb:hasTreatmentDuration """Duration of each acupuncture session: 30 minutes
Duration needles were left in place during electroacupuncture session: 20 minutes
Duration needles were left in place during minimal needling session: 20 minutes""" ;
    tara-kb:hasTreatmentFrequency "The frequency of treatment was daily for a total of 5 treatments, with each session lasting 30 minutes. The first treatment was administered within 2 hours before the initial chemotherapy infusion, and subsequent treatments were given at the same time each day." .

