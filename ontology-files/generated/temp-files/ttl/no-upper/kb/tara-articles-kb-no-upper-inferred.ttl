        TARA:6752232,
        TARA:7867167,
        TARA:8393005,
        TARA:9534465 ;
    tara-kb:hasListedAcupointsMappedCurie "{\"TARA:0859695\": \"LI 4\", \"TARA:6463344\": \"ST 36\", \"TARA:8393005\": \"TE 5\", \"TARA:3668538\": \"GB 41\", \"TARA:0220496\": \"SI 3\", \"TARA:1628341\": \"BL 62\", \"TARA:3386254\": \"GV 20\", \"TARA:2324295\": \"GB 20\", \"TARA:9534465\": \"Taiyang\", \"TARA:6752232\": \"TE 23\", \"TARA:7867167\": \"LI 3\", \"TARA:4362146\": \"KI 3\"}"^^rdf:JSON ;
    tara-kb:hasMappedWesternCondition MONDO:0005277 ;
    tara-kb:hasNeedlingDetails "Not specified (the paper does not provide explicit depth measurements for needle insertion)" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1671 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1671 ;
    tara-kb:hasSampleSizeDetails """Total participants initially included: 35
Participants in verum acupuncture group: 18
Participants in placebo acupuncture group: 17
Participants included in final analysis:
Verum acupuncture: 13
Placebo acupuncture: 14""" ;
    tara-kb:hasShamAcupunctureDetails """Needle type: Real needles
Quantity: Same as verum acupuncture
Size: Not specified
Location: Areas outside traditional acupuncture points (minimum 1-2 cm beside)
Penetration: Superficially into the subcutaneous layer (non-penetrating or minimally penetrating)
Duration: Needles left in place for 30 minutes without further stimulation""" ;
    tara-kb:hasStimulationTypeDetails """Verum Acupuncture (VA): Needles were manually rotated to achieve a "de qi sensation."
Placebo Acupuncture (PA): Needles were inserted superficially and remained in place without further stimulation.""" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly mention a TCM term for the condition)" ;
    tara-kb:hasStudiedWesternCondition "Migraine" ;
    tara-kb:hasStudyFindings """Result: "Pre-/post-acupuncture treatment comparisons between verum-and placebo-acupuncture groups demonstrated a significant decrease of days with migraine headache in the verum group (-52.5%; p < 0.001), whereas placebo-acupuncture patients profited to a smaller extent and the duration of headache attack (hours/ month) did not decrease significantly."
Conclusion: "The findings indicate that prophylactic treatment of migraineurs by standardized acupuncture might positively influence the dysfunction of the cerebrovascular response to autonomic stimuli, but not the cerebral vasotonus during rest."
Effectiveness: Yes""" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: days with migraine/month, duration of migraine attacks in hours/month
Secondary outcome measures: vasotonus (systolic and mean flow velocities, pulsality index), cerebrovascular response (cerebrovascular Valsalva ratio, centroperipheral Valsalva ratio)""" ;
    tara-kb:hasTreatmentDuration """Duration of treatment: 8 weeks
Duration of each session: 30 minutes
Needles left in place: 30 minutes""" ;
    tara-kb:hasTreatmentFrequency "Once weekly for 8 weeks" .

