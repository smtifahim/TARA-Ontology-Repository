tara-kb:S-112625-435 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-435" ;
    dc:title "Immediate Effect of Acupuncture at Sanyinjiao (SP6) and Xuanzhong (GB39) on Uterine Arterial Blood Flow in Primary Dysmenorrhea" ;
    tara-kb:hasAcupunctureProtocol """SP6: Located 3 cun above the medial malleolus, at the posterior border of the medial aspect of the tibia. Used for its key functions in TCM patterns related to dysmenorrhea.
GB39: Located 3 cun above the tip of the external malleolus, at the anterior part of the fibula. Used as a control point due to its lack of direct relation to menstrual issues.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT), Pilot Study" ;
    tara-kb:hasControlGroupsDetails "The control group in this study was the GB39 group, where participants received acupuncture at the GB39 point for 5 minutes. This group was used as a comparison to the SP6 treatment group to assess the efficacy of SP6 in improving uterine arterial blood flow and relieving menstrual pain." ;
    tara-kb:hasCountryOfStudy "China" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "SP 6, GB 39" ;
