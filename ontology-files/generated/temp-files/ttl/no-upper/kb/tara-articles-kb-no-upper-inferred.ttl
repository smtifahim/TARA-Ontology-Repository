    tara-kb:hasReportingPublicationID tara-kb:A-112625-850 ;
    tara-kb:hasSampleSizeDetails "Total sample size: 23; Acupuncture group: 11; Placebo group: 12" ;
    tara-kb:hasShamAcupunctureDetails """Sham procedure: Sham laser acupuncture
Details: Laser (Minilaser 2000 Helbo) placed on randomly selected points without contact or activation
Duration: Maintained for 20 minutes
Additional details: Therapist and patients wore protective goggles; laserlight was demonstrated before treatment""" ;
    tara-kb:hasStimulationTypeDetails "Manual stimulation using the very-point technique, aiming for an electrifying sensation (dechi). Needles were not stimulated beyond this manual technique." ;
    tara-kb:hasStudiedTCMCondition "Not specified" ;
    tara-kb:hasStudiedWesternCondition "Allergic rhinitis (AR)" ;
    tara-kb:hasStudyFindings "Yes, the acupuncture intervention was found to be effective compared to the control/sham group based on the primary outcome of pain reduction, with a statistically significant p-value of 0.03." ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Symptom reporting (subjective patient reports)
Secondary outcome measures: Objective outcomes (IgE and cytokines), responder rate, cumulative symptoms score, disease-specific and general quality of life""" ;
    tara-kb:hasTreatmentDuration "Duration of each session: 20 minutes; Duration needles were left in place: Not specified" ;
    tara-kb:hasTreatmentFrequency "Not specified (the paper does not provide information on the frequency or duration of acupuncture treatments)" .

