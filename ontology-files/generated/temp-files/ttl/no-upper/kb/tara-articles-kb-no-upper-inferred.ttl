tara-kb:S-112625-237 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-237" ;
    dc:title "The Effectiveness of Electroacupuncture for Functional Constipation: A Randomized, Controlled, Clinical Trial" ;
    tara-kb:hasAcupunctureProtocol """EA Group: ST25 (Tianshu), SP14 (Fujie), ST37 (Shangjuxu) bilaterally
Control Group: Points located one cun away from ST25, SP14, and ST37 on the median between Stomach Meridian of Foot Yang-ming and Spleen Meridian of Foot Tai-yin""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group received electroacupuncture (EA) with shallow puncture at nonacupoints, with a depth of 2 mm and without lifting and twisting, for 30 minutes. This was used as a comparison to the EA group with deep puncture." ;
    tara-kb:hasCountryOfStudy "China" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "ST 25, SP 14, ST 37" ;
    tara-kb:hasListedAcupointsMapped TARA:1992799,
