    tara-ap:hasChineseLabel "府舍(舎)" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795303 ;
    tara-ap:hasInnervationInformation "The ilioinguinal nerve." ;
    tara-ap:hasListedIndications "lower abdominal pain, hernia." ;
    tara-ap:hasLocationalDescription "On the lower abdomen, 4.3 B-cun inferior to the centre of the umbilicus, 4 B-cun lateral to the anterior median line." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Fushe" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0007118,
        ILX:0795285 ;
