tara-kb:S-112625-1412 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1412" ;
    dc:title "Acupuncture Therapy for Chronic Pain A RANDOMIZED COMPARISON BETWEEN ACUPUNCTURE AND PSEUDO-ACUPUNCTURE WITH MINIMAL PERIPHERAL STIMULUS" ;
    tara-kb:hasAcupunctureProtocol """Headaches: LG 13, G 20, B 12, B 60
Neck and shoulder pain: LG 13, G 20, B 12, G 34, M 36, B 60
Low back pain: B 27, B 28, B 29, B 54, LG 13, B 60
Arthritis and osteoarthritis: G 29, G 30, G 31, G 34, B 60, B 54, LG 13, B 12
Points selected based on the most painful joints
Patient position: Prone""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "Pseudo acupuncture: The skin of the patient was jabbed about an inch away from the traditional acupuncture points for a second with the nail of the little finger to bring about a painful sensation." ;
    tara-kb:hasCountryOfStudy "Finland" ;
    tara-kb:hasDatasetLink "Not specified" ;
