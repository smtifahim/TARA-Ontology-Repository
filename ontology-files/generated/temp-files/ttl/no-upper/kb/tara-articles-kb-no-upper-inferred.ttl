    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-08-27T13:58:05+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0025031 .

HP:0025270 a owl:Class ;
    rdfs:label "Abnormal esophagus physiology" ;
    IAO:0000115 "Any physiological abnormality of the esophagus." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-12-18T13:39:06+00:00"^^xsd:dateTime ;
    OboInOwl:hasExactSynonym "Abnormality of esophagus physiology",
        "Abnormality of oesophagus physiology",
        "Functional abnormality of the esophagus",
        "Functional abnormality of the oesophagus" ;
    rdfs:subClassOf HP:0012719 .

HP:0025766 a owl:Class ;
    rdfs:label "Abnormal affect" ;
    IAO:0000115 "An anomaly in intensity, frequency, or duration of the verbal or behavioral expression of emotions, feelings, or thoughts." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2024-07-21T12:00:05+00:00"^^xsd:dateTime ;
    rdfs:comment "Affect includes a combination of emotion in terms of feelings and its expression either in the verbal or behavioral (action) level. Normal expressions are often relatively short lived and familiar to the person while pathological expressions may be intense and extended and considered out of character for the individual. Affect encompasses: 1) emotions, 2) volition, and 3) what is termed the intellect or cognitive elements expressing (communicating) emotion and volition. Affect includes an internal feeling (emotion), an internal drive (will), and a motor component expression (typically speech, but also reflected in thoughts)." ;
    rdfs:subClassOf HP:0011446 .

HP:0030680 a owl:Class ;
    rdfs:label "Abnormal cardiovascular system morphology" ;
    IAO:0000115 "Any structural anomaly of the heart and blood vessels." ;
    dcterms:date "2015-12-28T18:00:14+00:00"^^xsd:dateTime ;
    OboInOwl:hasAlternativeId "HP:0001632",
        "HP:0002564",
        "HP:0002565" ;
    OboInOwl:hasDbXref "UMLS:C4049796" ;
    OboInOwl:hasExactSynonym "Abnormality of cardiovascular system morphology",
        "Cardiovascular malformations" ;
    rdfs:subClassOf HP:0001626 .

HP:0030829 a owl:Class ;
    rdfs:label "Abnormal breath sound" ;
    IAO:0000115 "An anomalous (adventitious) sound produced by the breathing process." ;
    dcterms:date "2016-05-09T07:56:43+00:00"^^xsd:dateTime ;
    OboInOwl:hasDbXref "SNOMEDCT_US:301273002",
        "UMLS:C0231856" ;
