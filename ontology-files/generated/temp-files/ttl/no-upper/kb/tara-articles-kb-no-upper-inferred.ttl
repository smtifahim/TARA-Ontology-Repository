tara-kb:S-112625-1154 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1154" ;
    dc:title "Importance of modes of acupuncture in the treatment of chronic nociceptive low back pain" ;
    tara-kb:hasAcupunctureProtocol """Six local points (three pairs of paraspinal points)
Three to four distal points (between the upper or lower limbs)
Needle insertion depth: 1 to 5 cm
Technique: Rapid rotation backward and forwards (180¬∞) to produce a local or radiating sensation (t√© chhi)
Specific acupoints and their locations: Not specified""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group consisted of 10 patients who were placed on a waiting list for later treatment, serving as untreated controls. They did not receive any acupuncture treatment during the study period and were used to compare outcomes with the treated groups." ;
    tara-kb:hasCountryOfStudy "Not specified" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Not specified" ;
    tara-kb:hasMappedWesternCondition HP:0003419 ;
    tara-kb:hasNeedlingDetails "1 to 5 cm, depending on the thickness of underlying muscle" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1154 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1154 ;
    tara-kb:hasSampleSizeDetails """Total participants: 43
Participants in treatment groups: 33
Participants in control group: 10
Participants available for comparison between modes: 27
Distribution within treatment groups: MS=7, LF=9, HF=11""" ;
    tara-kb:hasShamAcupunctureDetails "Not applicable (no sham acupuncture group was used)" ;
    tara-kb:hasStimulationTypeDetails """Manual Stimulation (MS): Needles were rapidly rotated backward and forwards to produce a local or radiating sensation known as "t√© chhi."
Low Frequency Electrical Stimulation (LF): Used at 2 Hz, often evoking visible muscle contractions.
High Frequency Electrical Stimulation (HF): Used at 80 Hz.""" ;
    tara-kb:hasStudiedTCMCondition "Not specified (the paper does not explicitly mention a TCM term for the condition)" ;
    tara-kb:hasStudiedWesternCondition "Chronic nociceptive low back pain" ;
    tara-kb:hasStudyFindings "Yes" ;
    tara-kb:hasStudyOutcomesMeasure """Primary outcome measures: Mobility (lateral flexion, extension, forward flexion,Straight leg raise),Pain descriptors
Secondary outcome measure: Activities of daily life (ADL) related toPain""" ;
    tara-kb:hasTreatmentDuration """Duration of electrical stimulation session: 30 minutes
Duration of needle placement: Not specified""" ;
    tara-kb:hasTreatmentFrequency "twice weekly; total of ten treatments recommended; actual number of treatments: MS=7.3+1.6, LF=7.1+1.4, HF=7.3+2.6" .

