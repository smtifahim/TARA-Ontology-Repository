    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The branch of the frontal nerve." ;
    tara-ap:hasListedIndications "epilepsy, anxiety, palpitation, insomnia, headache, vertigo, rhinorrhea." ;
    tara-ap:hasLocationalDescription "On the head, 0.5 B-cun superior to the anterior hairline, on the anterior median line. Note: When the anterior hairline is unclear or changed, GV 24 is located 3.5 B-cun superior to the midpoint between the medial ends of the eyebrows." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch, or prick to cause bleeding." ;
    tara-ap:hasPinyinLabel "Shenting" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0010163,
        ILX:0795285,
        ILX:0795292 ;
    tara-ap:hasSynonym "Du 24",
        "Governor Vessel 24",
        "VG 24" ;
    tara-ap:hasVasculatureInformation "The branch of the frontal artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:0386099 ;
