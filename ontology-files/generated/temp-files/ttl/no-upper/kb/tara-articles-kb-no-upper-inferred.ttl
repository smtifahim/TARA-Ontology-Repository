    tara-ap:hasSpecificReferenceLocation UBERON:0003650 ;
    tara-ap:hasSynonym "Spleen 4" ;
    tara-ap:hasVasculatureInformation "The medial tarsal artery and the dorsal venous network of the foot." ;
    tara-ap:isLocatedOnMeridian TARA:4167850 ;
