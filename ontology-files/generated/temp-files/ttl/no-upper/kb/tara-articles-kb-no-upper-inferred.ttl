    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/3/3e/Gray539.png"^^xsd:anyURI .

UBERON:0001316 a owl:Class ;
    rdfs:label "external iliac vein" ;
    IAO:0000115 "A large vein that connects the femoral vein to the common iliac vein. Their origin is at the inferior margin of the inguinal ligaments and they terminate when they join the internal iliac veins (to form the common iliac veins). Both external iliac veins are accompanied along their course by external iliac arteries. [WP,modified]." ;
