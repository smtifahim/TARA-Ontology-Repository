HP:0000975 a owl:Class ;
    rdfs:label "Hyperhidrosis" ;
    IAO:0000115 "Abnormal excessive perspiration (sweating) despite the lack of appropriate stimuli like hot and humid weather." ;
    OboInOwl:hasAlternativeId "HP:0001011",
        "HP:0001064",
        "HP:0007424" ;
    OboInOwl:hasDbXref "MEDDRA:10020642",
        "SNOMEDCT_US:161857006",
        "SNOMEDCT_US:312230002",
        "SNOMEDCT_US:364538006",
