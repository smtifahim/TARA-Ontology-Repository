TARA:5389461 a owl:Class ;
    rdfs:label "GB 21" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 182. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "肩井" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000974 ;
    tara-ap:hasInnervationInformation "The posterior branch of the supraclavicular nerve, the accessory nerve." ;
    tara-ap:hasListedIndications "pain and rigidity of the neck, pain in the shoulder and back, motor impairment of the arm, insufficient lactation, mastitis, scrofula, apoplexy, difficult labor." ;
    tara-ap:hasLocationalDescription "In the posterior region of the neck, at the midpoint of the line connecting the spinous process of the seventh cervical vertebra (C7) with the lateral end of the acromion." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Jianjing" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002497,
        UBERON:0004616 ;
    tara-ap:hasSynonym "G 21",
        "Gallbladder 21" ;
    tara-ap:hasVasculatureInformation "The transverse cervical artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:5283975 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
