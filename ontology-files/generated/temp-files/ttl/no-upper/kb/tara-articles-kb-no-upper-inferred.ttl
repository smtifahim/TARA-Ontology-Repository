    dc:title "Effectiveness of Dry Needling for Upper-Quarter Myofascial Pain: A Systematic Review and Meta-analysis" ;
    tara-kb:hasAcupunctureProtocol "Not specified (the paper does not provide specific details about needle locations or acupoints)" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "Not applicable (the study involved a single group design with baseline measurements and experimental conditions, but no separate control group)" ;
    tara-kb:hasCountryOfStudy "Not specified" ;
    tara-kb:hasDatasetLink "Not specified" ;
