tara-kb:S-112625-713 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-713" ;
    dc:title "Acupuncture for the induction of labour: a double-blind randomised controlled study" ;
    tara-kb:hasAcupunctureProtocol """BL67: Located on the little toe, near the edge of the nail; needle inserted to a depth of 0.1-0.2 cm; claimed to stimulate uterine contractions.
LI4: Located in the middle of interosseous I; needle inserted to a depth of 1-2 cm; claimed to help push downwards and stimulate uterine contractions.
SP6: Located 3 cm above the medial malleoli; needle inserted to a depth of 1.5-2.5 cm; claimed to promote ripening of the cervix.
GV20: Located 7 cun (11-14 cm) from the central part of the posterior hairline; needle inserted to a depth of 0.5-1 cm; claimed to be used for calming.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group used Park-Sham acupuncture needles, which are sham needles that do not penetrate the skin, to mimic the appearance of real acupuncture needles. This is a sham intervention used to control for placebo effects." ;
    tara-kb:hasCountryOfStudy "Denmark" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "BL 67, LI 4, SP 6, GV 20" ;
