TARA:7471145 a owl:Class ;
    rdfs:label "Yuye" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Swelling of the tongue, vomiting, aphasia with stiffness of tongue." ;
    tara-ap:hasLocationalDescription "On the veins on both sides of the frenulum of the tongue, Jinjin is on the left, Yuye, on the right." ;
    tara-ap:hasSynonym "EX-HN 13",
        "M-HN 20b" ;
    rdfs:subClassOf TARA:3535998 .

TARA:7641637 a owl:Class ;
    rdfs:label "BL 56" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 127. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "承筋" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003823 ;
    tara-ap:hasInnervationInformation "The medial sural cutaneous nerve; deeper, the tibial nerve." ;
    tara-ap:hasListedIndications "spasm of the gastrocnemius, hemorrhoids, acute lower back pain." ;
    tara-ap:hasLocationalDescription "On the posterior aspect of the leg, between the two muscle bellies of the gastrocne- mius muscle, 5 B-cun distal to the popliteal crease. Note: Midway between BL55 and BL57." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Chengjin" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001388,
        ILX:0795330 ;
    tara-ap:hasSynonym "B 56",
        "Bladder 56",
        "UB 56",
        "Urinary Bladder 56" ;
    tara-ap:hasVasculatureInformation "The small saphenous vein; deeper, the posterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
