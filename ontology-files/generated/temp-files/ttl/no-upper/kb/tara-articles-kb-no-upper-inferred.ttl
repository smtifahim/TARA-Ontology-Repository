        "Triple Burner 2",
        "Triple Energizer 2",
        "Triple Heater 2",
        "Triple Warmer 2" ;
    tara-ap:hasVasculatureInformation "The dorsal digital artery of the ulnar artery." ;
    tara-ap:isLocatedOnMeridian TARA:3898257 ;
