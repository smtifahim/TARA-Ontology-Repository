UBERON:0007845 a owl:Class ;
    rdfs:label "regular connective tissue" ;
    IAO:0000115 "Connective tissue, which consists of fibroblasts, the intercellular matrix of which contains a regular network of collagen and elastic fiber bundles. Examples: bone (tissue), cartilage (tissue), dense regular connective tissue." ;
    IAO:0000116 "the connective tissue hierarchy largely follows FMA with definitions from VSAO. Note that in FMA, loose-CT is irregular-CT. This means regular-CT is necessarily equivalent to dense-regular-CT (assuming a JEPD classification)." ;
    ilxtr:hasExistingId UBERON:0007845,
        FMA:20103,
        ILX:0730249 ;
    OboInOwl:hasDbXref "FMA:20103" ;
    rdfs:subClassOf [ a owl:Restriction ;
