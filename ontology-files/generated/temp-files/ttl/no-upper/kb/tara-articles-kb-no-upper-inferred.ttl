TARA:5047947 a owl:Class ;
    rdfs:label "BL 60" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 129. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "崑(昆)崙(侖,仑)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0004454 ;
    tara-ap:hasInnervationInformation "The sural nerve." ;
    tara-ap:hasListedIndications "headache, blurred vision, neck rigidity, epistaxis, pain in the shoulder, back and arm, swelling and pain of the heel, difficult labor, epilepsy." ;
    tara-ap:hasLocationalDescription "On the posterolateral aspect of the ankle, in the depression between the prominence of the lateral malleolus and the calcaneal tendon." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Kunlun" ;
    tara-ap:hasSpecialPointRole TARA:7315457 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003701,
        UBERON:0012291 ;
    tara-ap:hasSynonym "B 60",
        "Bladder 60",
        "UB 60",
        "Urinary Bladder 60" ;
    tara-ap:hasVasculatureInformation "The small saphenous vein, the posteroexternal malleolar artery and vein." ;
    tara-ap:isLocatedOnMeridian TARA:7525476 ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
