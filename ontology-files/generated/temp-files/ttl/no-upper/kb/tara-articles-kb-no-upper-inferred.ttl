MONDO:0001627 a owl:Class ;
    rdfs:label "dementia" ;
    IAO:0000115 "Loss of intellectual abilities interfering with an individual's social and occupational functions. Causes include Alzheimer's disease, brain injuries, brain tumors, and vascular disorders." ;
    IAO:0000589 "dementia (disease)" ;
    mondons:curated_content_resource "https://www.malacards.org/card/dementia"^^xsd:anyURI ;
    OboInOwl:hasDbXref "DOID:1307",
