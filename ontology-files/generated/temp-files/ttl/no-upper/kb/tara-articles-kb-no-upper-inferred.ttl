UBERON:0034923 a owl:Class ;
    rdfs:label "disconnected anatomical group" ;
    IAO:0000115 "Material anatomical entity consisting of multiple anatomical structures that are not connected to each other." ;
    OboInOwl:hasDbXref "CARO:0020000",
        "FBbt:00007276" ;
    rdfs:subClassOf UBERON:0000465 .

UBERON:0035398 a owl:Class ;
    rdfs:label "branch of external carotid artery" ;
    OboInOwl:hasDbXref "FMA:70505",
        "NCIT:C32552",
        "SCTID:244216003",
        "UMLS:C0447038" ;
    OboInOwl:hasExactSynonym "external carotid arterial subdivision",
        "subdivision of external carotid artery" ;
