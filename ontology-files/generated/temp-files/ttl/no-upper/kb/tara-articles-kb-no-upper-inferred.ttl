    tara-ap:hasChineseLabel "大都(都)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003631 ;
    tara-ap:hasInnervationInformation "The proper plantar digital nerve derived from the medial plantar nerve." ;
    tara-ap:hasListedIndications "abdominal distension, gastric pain, constipation, febrile diseases with anhidrosis." ;
    tara-ap:hasLocationalDescription "On the great toe, in the depression distal to the first metatarsophalangeal joint, at the border between the red and white flesh." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.1-0.3 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Dadu" ;
