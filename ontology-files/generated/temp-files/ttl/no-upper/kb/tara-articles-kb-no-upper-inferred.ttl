    rdfs:label "Relation" ;
    rdfs:subPropertyOf tara-ap:dctermsMetadata .

dcterms:coverage a owl:AnnotationProperty ;
    rdfs:label "Coverage"@en ;
    rdfs:comment "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended best practice is to use a controlled vocabulary such as the Thesaurus of Geographic Names [TGN]. Where appropriate, named places or time periods can be used in preference to numeric identifiers such as sets of coordinates or date ranges."@en ;
    rdfs:range dcterms:LocationPeriodOrJurisdiction ;
    rdfs:subPropertyOf dc:coverage ;
    skos:definition "The spatial or temporal topic of the resource, the spatial applicability of the resource, or the jurisdiction under which the resource is relevant."@en .

dcterms:format a owl:AnnotationProperty ;
    rdfs:label "Format"@en ;
    dcterms:bibliographicCitation "[MIME] http://www.iana.org/assignments/media-types/" ;
    rdfs:comment "Examples of dimensions include size and duration. Recommended best practice is to use a controlled vocabulary such as the list of Internet Media Types [MIME]."@en ;
    rdfs:range dc:contributor ;
    rdfs:seeAlso <http://www.iana.org/assignments/media-types/> ;
    rdfs:subPropertyOf dc:format ;
    skos:definition "The file format, physical medium, or dimensions of the resource."@en .

dcterms:rights a owl:AnnotationProperty ;
    rdfs:label "Rights"@en ;
    rdfs:comment "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights."@en ;
    rdfs:range dcterms:RightsStatement ;
    rdfs:subPropertyOf dc:rights ;
    skos:definition "Information about rights held in and over the resource."@en .

dcterms:title a owl:AnnotationProperty ;
    rdfs:label "Title"@en ;
    rdfs:subPropertyOf dc:title ;
    skos:definition "A name given to the resource."@en ;
    skos:note "In current practice, this term is used primarily with literal values; however, there are important uses with non-literal values as well. As of December 2007, the DCMI Usage Board is leaving this range unspecified pending an investigation of options."@en .

TARA:0077876 a owl:Class ;
    rdfs:label "Back-Shu Point of the Spleen" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Back-Shu Point of the Spleen meridian. Back-Shu points are specific points on the back where the qi of the respective zang-fu organs is infused. Situated close to their respectively related zang-fu organs, the Back-Shu points present abnormal reactions to the dysfunction of their corresponding zang-fu organs. They are often used for disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole TARA:4143036 ;
    rdfs:subClassOf TARA:3861175 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:3861175 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:4143036 ] ) ] .

TARA:0220312 a owl:Class ;
    rdfs:label "Front-Mu Point of the Pericardium" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Front-Mu Point of the Pericardium meridian. Front-Mu points are those points on the chest and abdomen where the qi of the respective zang-fu organs is infused and converged. Located close to their corresponding zang-fu organs, the Front-Mu points play a significant role in the diagnosis and treatment of the disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole TARA:5568565 ;
    rdfs:subClassOf TARA:8746709 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:8746709 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:5568565 ] ) ] .

TARA:0284940 a owl:Class ;
    rdfs:label "Front-Mu Point of the Liver" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Front-Mu Point of the Liver meridian. Front-Mu points are those points on the chest and abdomen where the qi of the respective zang-fu organs is infused and converged. Located close to their corresponding zang-fu organs, the Front-Mu points play a significant role in the diagnosis and treatment of the disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole TARA:6173621 ;
    rdfs:subClassOf TARA:8746709 ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( TARA:8746709 [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom TARA:6173621 ] ) ] .

