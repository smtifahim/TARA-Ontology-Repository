tara-kb:S-112625-1828 a TARA:6701896,
        owl:NamedIndividual ;
    dc:identifier "tara-kb:S-112625-1828" ;
    dc:title "Randomized Controlled Trial of Acupuncture Versus Sham Acupuncture in Autism Spectrum Disorder" ;
    tara-kb:hasAcupunctureProtocol """TAC #1: Run Ze', located 1 cm from the tongue tip, punctured obliquely to a depth of 1 cm.
TAC #2: Guan Zhu', located 0.5 cm from the tongue tip, punctured obliquely to a depth of 0.3 cm.
TAC #3: Tian Men', located at the center of the tongue base, punctured perpendicularly to a depth of 0.5-1 cm.
TAC #4 and TAC #5: Di You', located 0.5 cm from the tongue base on both sides, punctured perpendicularly to a depth of 0.5 cm.""" ;
    tara-kb:hasClinicalTrialType "Randomized Controlled Trial (RCT)" ;
    tara-kb:hasControlGroupsDetails "The control group received sham tongue acupuncture to nonacupoints in the tongue, where the practitioner used the rough end of the acupuncture needle to touch the points instead of puncturing them." ;
    tara-kb:hasCountryOfStudy "Hong Kong" ;
    tara-kb:hasDatasetLink "Not specified" ;
    tara-kb:hasListedAcupoints "Run Ze', Guan Zhu', Tian Men', Di You'" ;
    tara-kb:hasListedAcupointsUnmappable "Di You'",
        "Guan Zhu'",
        "Run Ze'",
        "Tian Men'" ;
    tara-kb:hasMappedWesternCondition MONDO:0005258 ;
    tara-kb:hasNeedlingDetails """Tongue surface TAC #1: 1 cm depth obliquely
Tongue surface TAC #2: 0.3 cm depth obliquely
Bottom of the tongue TAC #3: 0.5-1 cm depth perpendicularly
Bottom of the tongue TAC #4 and TAC #5: 0.5 cm depth perpendicularly""" ;
    tara-kb:hasOCSIAppraisalID tara-kb:O-112625-1828 ;
    tara-kb:hasReportingPublicationID tara-kb:A-112625-1828 ;
    tara-kb:hasSampleSizeDetails """Total participants: 50
Control group: 25
Treatment group: 25""" ;
    tara-kb:hasShamAcupunctureDetails """Sham procedure: Used a sterile acupuncture needle to touch five sham points on the tongue.
Needle type: Real needle used, but only the rough end was used to touch the points.
Quantity: Five sham points.
Location: Same as real treatment group, on the tongue.
Penetration: Non-penetrating; the rough end of the needle was used to touch the points.""" ;
    tara-kb:hasStimulationTypeDetails "Manual insertion of needles; no additional stimulation techniques mentioned." ;
    tara-kb:hasStudiedTCMCondition "Autism is considered part of a spectrum with lower intelligence due to 'Heart meridian and Kidney meridian yinyang imbalance,' resulting in communication problems and 'Liver meridian yin-yang imbalance' leading to behavioral problems." ;
    tara-kb:hasStudiedWesternCondition "Autism Spectrum Disorder" ;
    tara-kb:hasStudyFindings "Yes, the acupuncture intervention was effective compared to the control/sham group(s) based on the primary outcome(s), with statistically significant improvements in self-care and cognition domains of the Functional Independence Measure for children." ;
