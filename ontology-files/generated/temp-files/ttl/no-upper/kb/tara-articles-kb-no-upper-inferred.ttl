        "UMLS:C1261084",
        "Wikipedia:Common_iliac_artery" ;
    OboInOwl:hasExactSynonym "common iliac arterial tree" ;
    OboInOwl:hasRelatedSynonym "arteria iliaca communis" ;
    rdfs:comment "See notes for parent class" ;
    rdfs:subClassOf UBERON:0005609,
        UBERON:0012254 ;
    foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/6/6e/Iliac_artery_bifurcation_and_aorta.PNG"^^xsd:anyURI .

