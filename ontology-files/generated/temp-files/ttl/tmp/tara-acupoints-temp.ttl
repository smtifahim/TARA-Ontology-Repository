    tara-ap:hasChineseLabel "耳門(门)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasInnervationInformation "The branches of the auriculotemporal nerve and facial nerve." ;
    tara-ap:hasListedIndications "tinnitus, deafness, otorrhea, toothache, stiffness of the lip." ;
    tara-ap:hasLocationalDescription "On the face, in the depression between the supratragic notch and the condylar process of the mandible. Note: When the mouth is slightly opened, tE21 is located in the depression anterior to the supratragic notch, directly superior to SI19." ;
    tara-ap:hasPinyinLabel "Ermen" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004657 ;
    tara-ap:hasSynonym "SJ 21",
        "San Jiao 21",
        "TB 21",
        "TH 21",
        "TW 21",
        "Triple Burner 21",
        "Triple Energizer 21",
        "Triple Heater 21",
        "Triple Warmer 21" ;
    tara-ap:hasVasculatureInformation "The superficial temporal artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_3898257> ;
    rdfs:subClassOf [ a owl:Restriction ;
