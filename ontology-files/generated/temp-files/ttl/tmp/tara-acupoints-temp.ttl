<http://www.acupunctureresearch.org/tara/ontology/TARA_0831517> a owl:Class ;
    rdfs:label "LU 11" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 31. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "少商" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001463 ;
    tara-ap:hasInnervationInformation "The terminal nerve network formed by the mixed branches of the lateral antebrachial cutaneous nerve and the superficial ramus of the radial nerve as well as the palmar digital proprial nerve of the median nerve." ;
    tara-ap:hasListedIndications "sore throat, cough, asthma, epistaxis, fever, loss of consciousness, mania, spasmodic pain of the thumb." ;
    tara-ap:hasLocationalDescription "On the thumb, radial to the distal phalanx, 0.1 f-cun proximal-lateral to the radial corner of the thumb nail, at the intersection of the vertical line of the radial border and the horizontal line of the base of the thumb nail." ;
    tara-ap:hasMethodDescription "Puncture 0.1 inch, or prick the point to cause bleeding." ;
    tara-ap:hasPinyinLabel "Shaoshang" ;
    tara-ap:hasRelatedArtery UBERON:0006137 ;
