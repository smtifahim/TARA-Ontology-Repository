        "Triple Heater 12",
        "Triple Warmer 12" ;
    tara-ap:hasVasculatureInformation "The median collateral artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_3898257> ;
