<http://www.acupunctureresearch.org/tara/ontology/TARA_8343475> a owl:Class ;
    rdfs:label "Bitong" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Rhinitis, nasal obstruction, nasal boils." ;
    tara-ap:hasLocationalDescription "At the highest point of the nasolabial groove." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously upward 0.3-0.5 inch." ;
    tara-ap:hasSynonym "M-HN 14" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_8364824> a owl:Class ;
    rdfs:label "Governor Vessel Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Governor Vessel (GV / Du Mai), one of the eight extraordinary vessels, which consists of 28 standardized acupoints beginning at GV 1 (Changqiang) in the perineal region midway between the tip of the coccyx and the anus, traveling up along the posterior midline of the body over the spine and across the top of the head, and ending at GV 28 (Yinjiao) in the oral cavity at the frenulum of the upper lip." ;
    tara-ap:hasSynonym "Acupoint of Governor Vessel",
        "Acupoint of the Du channel",
        "Acupoint of the Governor Vessel",
        "Acupuncture point of the Du channel",
        "Acupuncture point of the Governor Vessel",
        "Du Acupoint",
        "Du Channel Acupoint",
        "GV Acupoint" ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_0386099> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_5151019> [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_0386099> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_8574156> a owl:Class ;
    rdfs:label "Bizhong" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Paralysis, spasm and contracture of the upper extremities, pain of the forearm." ;
    tara-ap:hasLocationalDescription "On the lateral aspect of the forearm, midway between the transverse wrist crease and elbow crease, between the radius and the ulna." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 1.0-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "M-UE 30" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_8759132> a owl:Class ;
    rdfs:label "Medial Xiyan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001465 ;
    tara-ap:hasListedIndications "Knee pain, weakness of the lower extremities." ;
    tara-ap:hasLocationalDescription "A Xiyan point located in the depression, medial to the patellar ligament, locating the point with the knee flexed." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5- 1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003676 ;
    tara-ap:hasSynonym "EX-LE 4",
        "Neixiyan" ;
