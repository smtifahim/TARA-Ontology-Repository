        "Bladder 25",
        "UB 25",
        "Urinary Bladder 25" ;
    tara-ap:hasVasculatureInformation "The posterior branch of the fourth lumbar artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_7525476> ;
