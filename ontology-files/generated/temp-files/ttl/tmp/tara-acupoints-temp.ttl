    tara-ap:hasSpecificReferenceLocation UBERON:0004300,
        UBERON:0011274 ;
    tara-ap:hasSynonym "CO 1",
        "Colon 1",
        "Large Intestine 1" ;
    tara-ap:hasVasculatureInformation "The arterial and venous network formed by the dorsal digital arteries and veins." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_4610474> ;
