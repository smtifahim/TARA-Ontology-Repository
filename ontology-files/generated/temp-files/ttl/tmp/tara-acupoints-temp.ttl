    dcterms:description "An annotation property that records a specific nerve occupying an Acupoint's location, as a simple textual/IRI annotation. Corresponds to the object property tara-op:hasRelatedNerve, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedNerve ;
    dcterms:requires tara-ap:hasInnervationInformation ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedInnervation .

tara-ap:hasRelatedVein a owl:AnnotationProperty ;
    rdfs:label "Related Vein"@en ;
    IAO:0000112 "'LU 1' tara:hasRelatedVein 'Axillary Vein'."@en ;
    dcterms:description "An annotation property that records a specific vein occupying an Acupoint's location, as a simple textual/IRI annotation. Corresponds to the object property tara-op:hasRelatedVein, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedVein ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
