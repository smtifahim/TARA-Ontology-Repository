<http://www.acupunctureresearch.org/tara/ontology/TARA_0022762> a owl:Class ;
    rdfs:label "CV 3" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 221. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "中極(极)" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795303 ;
    tara-ap:hasInnervationInformation "The branch of the iliohypogastric nerve." ;
    tara-ap:hasListedIndications "enuresis, nocturnal emission, impotence, hernia, uterine bleeding, irregular menstruation, dysmenorrhea, morbid leukorrhea, frequency of urination, retention of urine, pain in the lower abdomen, prolapse of the uterus, vaginitis." ;
    tara-ap:hasLocationalDescription "On the lower abdomen, 4 B-cun inferior to the centre of the umbilicus, on the anterior median line." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhongji" ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_5308180> ;
    tara-ap:hasSpecificReferenceLocation UBERON:0007118,
        ILX:0795285 ;
    tara-ap:hasSynonym "Conception Vessel 3",
        "Front-Mu Point of the Bladder",
        "RN 3",
        "Ren 3",
        "VC 3" ;
    tara-ap:hasVasculatureInformation "The branches of superficial epigastric artery and vein, and the branches of inferior epigastric artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_6789717> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795303 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecialPointRole ;
            owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_1670028> ],
        [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_5151019> [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_6789717> ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom ILX:0795285 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0007118 ] ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_0093665> a owl:Class ;
    rdfs:label "BL 61" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 130. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "僕(仆)參(参)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "The external calcaneal branch of the sural nerve." ;
    tara-ap:hasListedIndications "muscular atrophy and weakness of the lower extremities, pain in the heel." ;
    tara-ap:hasLocationalDescription "On the lateral aspect of the foot, distal to BL60, lateral to the calcaneus, at the border between the red and white flesh." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Pucan",
        "Pushen" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001450 ;
    tara-ap:hasSynonym "B 61",
        "Bladder 61",
        "UB 61",
        "Urinary Bladder 61" ;
    tara-ap:hasVasculatureInformation "The external calcaneal branches of the peroneal artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_7525476> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001450 ] ],
        [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_5151019> [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_7525476> ] ) ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002387 ] ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_0095074> a owl:Class ;
    rdfs:label "ST 5" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 48. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "大迎(迎)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasInnervationInformation "The facial and buccal nerves." ;
    tara-ap:hasListedIndications "facial paralysis, trismus, swelling of the cheek, facial pain, toothache." ;
    tara-ap:hasLocationalDescription "On the face, anterior to the angle of the mandible, in the depression anterior to the masseter attachment, over the facial artery." ;
    tara-ap:hasMethodDescription "Avoid puncturing the artery. Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Daying" ;
    tara-ap:hasRelatedArtery UBERON:0001612 ;
    tara-ap:hasRelatedNerve UBERON:0001647,
        UBERON:0013646 ;
    tara-ap:hasRelatedVein UBERON:0001653 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001597,
        UBERON:0001612,
        UBERON:0001684 ;
    tara-ap:hasSynonym "S 5",
        "Stomach 5" ;
    tara-ap:hasVasculatureInformation "Anteriorly, the facial artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_6221269> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
