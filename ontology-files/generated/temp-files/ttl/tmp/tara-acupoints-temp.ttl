    tara-ap:hasChineseLabel "少衝(冲)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003625 ;
    tara-ap:hasInnervationInformation "The palmar digital proprial nerve derived from the ulnar nerve." ;
    tara-ap:hasListedIndications "palpitation, cardiac pain, pain in the chest and hypochondriac regions, mania, febrile diseases, loss of consciousness." ;
    tara-ap:hasLocationalDescription "On the little finger, radial to the distal phalanx, 0.1 f-cun proximal-lateral to the radial corner of the little fingernail, at the intersection of the vertical line of the radial border of the nail and horizontal line of the base of the little fingernail." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.1 inch, or prick with a three-edged needle to cause bleeding. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Shaochong" ;
    tara-ap:hasRelatedArtery UBERON:0006137 ;
    tara-ap:hasRelatedNerve UBERON:0001494,
