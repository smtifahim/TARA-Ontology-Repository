<http://www.acupunctureresearch.org/tara/ontology/TARA_3761087> a owl:Class ;
    rdfs:label "Pericardium Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Pericardium Meridian of Hand-Jueyin (PC), which consists of 9 standardized acupoints beginning at PC 1 (Tianchi) on the anterior chest in the fourth intercostal space lateral to the nipple, traveling down the middle of the anterior aspect of the arm, and ending at PC 9 (Zhongchong) at the center of the tip of the middle finger." ;
    tara-ap:hasSynonym "Acupoint of Pericardium Meridian",
        "Acupoint of the Pericardium Meridian",
        "Acupoint of the pericardium meridian of hand-jueyin",
        "Acupuncture point of the pericardium meridian",
        "Acupuncture point of the pericardium meridian of hand-jueyin",
        "PC Acupoint" ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_4694897> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_5151019> [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_4694897> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_4043356> a owl:Class ;
    rdfs:label "Crossing Point" ;
    dcterms:bibliographicCitation "D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "Represents a Crossing Point. Crossing points are those at the intersections of two or more meridians. Distributed mainly on the head, face and trunk, and amounting to over ninety in total. They are key points used to treat meridian disorders of the areas where they are located." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_9695467> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_2614885> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_9695467> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_4242691> a owl:Class ;
    rdfs:label "Weiwanxiashu" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Diabetes, vomiting, abdominal pain, pain in the chest and hypochondriac region." ;
    tara-ap:hasLocationalDescription "1.5 cun lateral to the lower border of the spinous process of the eighth thoracic vertebra. (See Fig. 123)" ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.5-0.7 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-B 3",
        "M-BW 12",
        "Yishu" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_4254258> a owl:Class ;
    rdfs:label "Zigongxue" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Prolapse of the uterus, irregular menstruation." ;
    tara-ap:hasLocationalDescription "3 cun lateral to Zhongji (CV 3)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-CA 1",
        "M-CA 18",
        "Zigong" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_4613316> a owl:Class ;
    rdfs:label "Yaoqi" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Epilepsy, headache, inomnia, constipation." ;
    tara-ap:hasLocationalDescription "2 cun directly above the tip of the coccyx." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously upward 1.0-2.0 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-B 9",
        "M-BW 29" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_5153816> a owl:Class ;
    rdfs:label "Bailao" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Scrofula, cough, asthma, whooping cough, neck rigidity." ;
    tara-ap:hasLocationalDescription "2 cun above Dazhui (GV 14), 1 cun lateral to the midline." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-HN 15",
        "M-HN 30" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_5220479> a owl:Class ;
    rdfs:label "Lateral Xiyan" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001465 ;
    tara-ap:hasListedIndications "Knee pain, weakness of the lower extremities." ;
    tara-ap:hasLocationalDescription "A Xiyan point located in the depression, lateral to the patellar ligament, locating the point with the knee flexed. Lateral Xiyan overlaps with Dubi (ST 35)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5- 1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003676 ;
    tara-ap:hasSynonym "M-LE 26",
        "Xiwai" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0003676 ] ],
