    tara-ap:hasSpecificReferenceLocation UBERON:0000979,
        UBERON:0001485,
        UBERON:0009990 ;
    tara-ap:hasSynonym "Spleen 9" ;
    tara-ap:hasVasculatureInformation "Anteriorly, the great saphenous vein, the genu suprema artery; deeper, the posterior tibial artery and vein." ;
