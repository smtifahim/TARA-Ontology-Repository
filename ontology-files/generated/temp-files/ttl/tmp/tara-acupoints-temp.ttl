    tara-ap:hasChineseLabel "絲(丝)竹空" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The zygomatic branch of the facial nerve and the branch of the auriculotemporal nerve." ;
    tara-ap:hasListedIndications "headache, redness and pain of the eye, blurred vision, eyelid twitching, toothache, facial paralysis." ;
    tara-ap:hasLocationalDescription "On the head, in the depression at the lateral end of the eyebrow. Note: TE23 is superior to GB1." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch." ;
    tara-ap:hasPinyinLabel "Sizhukong" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0010163 ;
