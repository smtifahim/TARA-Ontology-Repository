tara-ap:hasGeneralSurfaceLocation a owl:AnnotationProperty ;
    rdfs:label "General Surface Location"@en ;
    IAO:0000112 "'LU 1' tara:hasGeneralSurfaceLocation 'Anterior Thoracic Region'."@en ;
    dcterms:description "An annotation property that records the general body region on whose surface an Acupoint is located, as a simple textual/IRI annotation. Corresponds to the object property tara-op:hasGeneralSurfaceLocation, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasGeneralSurfaceLocation ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedSurfaceAnatomy .

