    tara-ap:hasInnervationInformation "The anterior and lateral cutaneous branch of the fourth intercostal nerve." ;
    tara-ap:hasLocationalDescription "In the anterior thoracic region, at the centre of the nipple. Note: In males, the centre of the nipple is located in the fourth intercostal space." ;
    tara-ap:hasRelatedNerve ILX:0784694 ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002030 ;
    tara-ap:hasSynonym "Stomach 17 (Female)" ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_6221269> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0002030 ] ],
