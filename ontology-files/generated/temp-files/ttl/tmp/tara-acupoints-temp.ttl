    tara-ap:hasChineseLabel "關(关,関)衝(冲)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003624 ;
    tara-ap:hasInnervationInformation "The palmar digital proprial nerve derived from the ulnar nerve." ;
    tara-ap:hasListedIndications "headache, redness of the eye, sore throat, stiffness of the tongue, febrile diseases, irritability." ;
    tara-ap:hasLocationalDescription "On the ring finger, ulnar to the distal phalanx, 0.1 f-cun proximal to the ulnar corner of the fingernail, at the intersection of the vertical line of the ulnar side of the nail and the horizontal line of the base of the fingernail." ;
    tara-ap:hasMethodDescription "Puncture superficially 0.1 inch, or prick with a three-edged needle to cause bleeding. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Guanchong" ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_2954517> ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004300,
        UBERON:0011276 ;
    tara-ap:hasSynonym "SJ 1",
        "San Jiao 1",
        "TB 1",
        "TH 1",
        "TW 1",
        "Triple Burner 1",
        "Triple Energizer 1",
        "Triple Heater 1",
        "Triple Warmer 1" ;
    tara-ap:hasVasculatureInformation "The arterial and venous network formed by the palmar digital proprial artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_3898257> ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty tara-op:hasSpecificReferenceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
