    tara-ap:hasChineseLabel "合谷" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0794954 ;
    tara-ap:hasInnervationInformation "The superficial ramus of the radial nerve." ;
    tara-ap:hasListedIndications "headache, pain in the neck, redness, swelling and pain of the eye, epistaxis, nasal obstruction, rhinorrhea, toothache, deafness, swelling of the face, sore throat, parotitis, trismus, facial paralysis, febrile diseases with anhidrosis, hyperhidrosis, abdominal pain, dysentery, constipation, amenorrhea, delayed labor, infantile convulsion, pain, weakness and motor impairment of the upper limbs." ;
    tara-ap:hasLocationalDescription "On the dorsum of the hand, radial to the midpoint of the second metacarpal bone." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Hegu",
        "Hoku" ;
    tara-ap:hasRelatedNerve ILX:0797391 ;
    tara-ap:hasRelatedVein ILX:0797526 ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_1840369> ;
    tara-ap:hasSpecificReferenceLocation UBERON:0003646 ;
    tara-ap:hasSynonym "CO 4",
        "Colon 4",
        "Large Intestine 4" ;
    tara-ap:hasVasculatureInformation "The venous network of the dorsum of the hand." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_4610474> ;
