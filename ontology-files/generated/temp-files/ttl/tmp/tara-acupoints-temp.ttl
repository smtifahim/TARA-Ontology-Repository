        UBERON:0012291 ;
    tara-ap:hasSynonym "B 63",
        "Bladder 63",
        "UB 63",
        "Urinary Bladder 63" ;
    tara-ap:hasVasculatureInformation "The lateral plantar artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_7525476> ;
