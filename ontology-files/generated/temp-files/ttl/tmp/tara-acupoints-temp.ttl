    tara-ap:hasSynonym "K 9",
        "KD 9",
        "KID 9",
        "Kidney 9" ;
    tara-ap:hasVasculatureInformation "Deeper, the posterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_4813389> ;
