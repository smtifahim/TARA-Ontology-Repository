    tara-ap:hasVasculatureInformation "The posterior branch of the lumbar artery." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_0386099> ;
    rdfs:subClassOf [ a owl:Class ;
