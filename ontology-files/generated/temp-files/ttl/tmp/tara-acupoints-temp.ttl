    tara-ap:hasSpecificReferenceLocation UBERON:0004300,
        UBERON:0011273 ;
    tara-ap:hasSynonym "L 11",
        "Lung 11" ;
    tara-ap:hasVasculatureInformation "The arterial and venous network formed by the proper palmar digital artery and veins." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_9964503> ;
