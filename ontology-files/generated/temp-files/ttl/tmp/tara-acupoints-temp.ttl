    tara-ap:hasChineseLabel "然谷" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002387 ;
    tara-ap:hasInnervationInformation "The terminal branch of the medial crural cutaneous nerve, the medial plantar nerve." ;
    tara-ap:hasListedIndications "pruritus vulvae, prolapse of the uterus, irregular menstruation, nocturnal emission, hemoptysis, thirst, diarrhea, swelling and pain of the dorsum of foot, acute infantile omphalitis." ;
    tara-ap:hasLocationalDescription "On the medial aspect of the foot, inferior to the tuberosity of the navicular bone, at the border between the red and white flesh." ;
    tara-ap:hasPinyinLabel "Rangu" ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_9857829> ;
