        ILX:0795333 ;
    tara-ap:hasSynonym "Small Intestine 6" ;
    tara-ap:hasVasculatureInformation "The terminal branches of the posterior interosseous artery and vein, the dorsal venous network of the wrist." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_9093316> ;
