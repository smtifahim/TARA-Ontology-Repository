    tara-ap:hasSynonym "S 1",
        "Stomach 1" ;
    tara-ap:hasVasculatureInformation "The branches of the infraorbital artery and infraorbital vein, and ophthalmic artery and ophthalmic veins." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_6221269> ;
