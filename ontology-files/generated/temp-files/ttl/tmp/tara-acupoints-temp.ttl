                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_5283975> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_4362146> a owl:Class ;
    rdfs:label "KI 3" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 137. https://iris.who.int/handle/10665/353407",
