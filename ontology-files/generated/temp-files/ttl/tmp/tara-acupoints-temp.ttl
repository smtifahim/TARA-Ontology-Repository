    tara-ap:hasChineseLabel "會(会)陽(阳)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0013691 ;
    tara-ap:hasInnervationInformation "The coccygeal nerve." ;
    tara-ap:hasListedIndications "dysentery, bloody stools, diarrhea, hemorrhoids, impotence, morbid leukorrhea." ;
    tara-ap:hasLocationalDescription "In the buttock region, 0.5 B-cun lateral to the extremity of the coccyx. Note: The subject may be in prone position or knee-chest position. BL35 is located at the soft depression lateral to the extremity of the coccyx." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Huiyang" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001350 ;
    tara-ap:hasSynonym "B 35",
        "Bladder 35",
        "UB 35",
        "Urinary Bladder 35" ;
    tara-ap:hasVasculatureInformation "The branches of the inferior gluteal artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_7525476> ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_5151019> [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
