    tara-ap:hasSynonym "K 3",
        "KD 3",
        "KID 3",
        "Kidney 3" ;
    tara-ap:hasVasculatureInformation "Anteriorly, the posterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_4813389> ;
