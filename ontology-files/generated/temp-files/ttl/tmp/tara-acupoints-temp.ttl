    tara-ap:hasChineseLabel "(浮)郄" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001465 ;
    tara-ap:hasInnervationInformation "The posterior femoral cutaneous nerve and the common peroneal nerve." ;
    tara-ap:hasListedIndications "numbness of the gluteal and femoral regions, contracture of the tendons in the popliteal fossa." ;
    tara-ap:hasLocationalDescription "On the posterior aspect of the knee, just medial to the biceps femoris tendon, 1 B-cun proximal to the popliteal crease. Note: With the knee in slight flexion, BL38 is located medial to the biceps femoris ten- don, 1 B-cun proximal to BL39." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Fuxi" ;
