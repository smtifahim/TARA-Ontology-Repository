<http://www.acupunctureresearch.org/tara/ontology/TARA_4352504> a owl:Class ;
    rdfs:label "GB 4" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 173. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "頷(颔)厭(厌)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The temporal branch of the auriculotemporal nerve." ;
    tara-ap:hasListedIndications "migraine, vertigo, tinnitus, pain in the outer canthus, toothache, convulsion, epilepsy." ;
    tara-ap:hasLocationalDescription "On the head, at the junction of the upper one fourth and lower three fourths of the curved line from St8 to gB7." ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Hanyan" ;
    tara-ap:hasSynonym "G 4",
        "Gallbladder 4" ;
    tara-ap:hasVasculatureInformation "The parietal branches of the superficial temporal artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_5283975> ;
