    rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedSubSurfaceAnatomy .

tara-ap:hasRelatedSubSurfaceAnatomy a owl:AnnotationProperty ;
    rdfs:label "Related Subsurface Anatomy"@en ;
    dcterms:description "An annotation property that records the nerves, arteries, and veins occupying an Acupoint's location, as simple textual/IRI annotations. Corresponds to the object property tara-op:hasRelatedSubSurfaceAnatomy, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedSubSurfaceAnatomy ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasTopographicalAnatomy .

tara-ap:hasRelatedSurfaceAnatomy a owl:AnnotationProperty ;
    rdfs:label "Related Surface Anatomy"@en ;
    IAO:0000112 "'LU 1' tara:hasRelatedSurfaceAnatomy 'Anterior Thoracic Region'."@en ;
    dcterms:description "An annotation property that records the surface anatomical regions and landmarks associated with an Acupoint's location, as simple textual/IRI annotations, without the mereological commitment of the corresponding object property. Corresponds to the object property tara-op:hasRelatedSurfaceAnatomy, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedSurfaceAnatomy ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasTopographicalAnatomy .

tara-ap:hasTopographicalAnatomy a owl:AnnotationProperty ;
    rdfs:label "Topographical Anatomy"@en ;
    dcterms:description "An annotation property that groups all textual/simple annotations relating an Acupoint to the surface and subsurface anatomical entities associated with its location and needling. Corresponds to the object property tara-op:hasTopographicalAnatomy, which is the root of the corresponding logical property hierarchy."@en ;
    dcterms:references tara-op:hasTopographicalAnatomy ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-op:hasRelatedInnervation a owl:ObjectProperty ;
    rdfs:label "hasRelatedInnervation" ;
    IAO:0000112 "Example: 'LU 1' tara-op:hasRelatedInnervation some 'Intermediate Supraclavicular Nerve'"@en ;
    IAO:0000115 "An Acupoint a hasRelatedInnervation b (a nerve) if and only if a hasRelatedSubSurfaceAnatomy b."@en ;
    dcterms:description "An object property that relates an Acupoint to the nerve(s) supplying the tissue at its location, relevant to safe needling."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedInnervation ;
    dcterms:requires tara-ap:hasInnervationInformation ;
    rdfs:comment "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its parent property hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here."@en ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
    rdfs:subPropertyOf tara-op:hasRelatedSubSurfaceAnatomy .

tara-op:hasRelatedSubSurfaceAnatomy a owl:ObjectProperty ;
    rdfs:label "hasRelatedSubSurfaceAnatomy" ;
    IAO:0000112 "'LU 1' tara-op:hasRelatedSubSurfaceAnatomy some 'Axillary Artery'."@en ;
    IAO:0000115 "An Acupoint a hasRelatedSubSurfaceAnatomy a material anatomical entity b if and only if a overlaps b, where b is a nerve, artery, or vein occupying the fiat volume of a."@en ;
    dcterms:description "An object property that relates an Acupoint to the nerves, arteries, and veins that occupy the same shallow tissue volume as the acupoint at the site of needle insertion."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedSubSurfaceAnatomy ;
    rdfs:comment "Declared as a subproperty of RO:0002131 (overlaps) because an Acupoint, modeled as a BFO:0000024 Fiat Object Part, and the nerves/vessels beneath it are both material entities; the segment of the nerve or vessel passing through the acupoint's fiat volume is a literal shared part, satisfying overlaps' requirement of a common part between the two continuants."@en ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:subPropertyOf tara-op:hasTopographicalAnatomy .

tara-op:hasRelatedSurfaceAnatomy a owl:ObjectProperty ;
    rdfs:label "hasRelatedSurfaceAnatomy"@en ;
    IAO:0000115 "An Acupoint a hasRelatedSurfaceAnatomy an anatomical entity b if and only if a is located_in b, where b is a surface-level anatomical region, landmark, fossa, or line used to describe the position of a on the body surface."@en ;
    dcterms:description "An object property that relates an Acupoint to an anatomical region, fossa, line, or other surface landmark in the vicinity of its location on the body surface."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedSurfaceAnatomy ;
    dcterms:requires tara-ap:hasLocationalDescription ;
    rdfs:comment "Declared as a subproperty of RO:0001025 (located_in) rather than RO:0002131 (overlaps), because the anatomical entities used to describe surface location (e.g., regions, fossae, lines) span a mix of material and immaterial UBERON classes; located_in does not require the related entities to share a common part, so it remains valid across this mixed range, unlike overlaps."@en ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
    rdfs:subPropertyOf tara-op:hasTopographicalAnatomy .

tara-op:hasTopographicalAnatomy a owl:ObjectProperty ;
    rdfs:label "hasTopographicalAnatomy" ;
    IAO:0000115 "A grouping relation between an Acupoint and any anatomical entity related to its surface or subsurface topography, holding whenever a more specific subproperty of hasTopographicalAnatomy holds between the same two entities."@en ;
    dcterms:description "An object property that groups all relations between an Acupoint and the surface and subsurface anatomical entities associated with its location and needling, including surface regions, landmarks, nerves, arteries, and veins. It is the root organizational property for the Acupoint topographical-anatomy property hierarchy and carries no independent logical commitment of its own."@en ;
    dcterms:isReferencedBy tara-ap:hasTopographicalAnatomy ;
    tara-ap:hasSynonym "hasRegionalAnatomy" ;
    rdfs:comment "Declared as a direct subproperty of owl:topObjectProperty rather than of any RO relation, because it is used purely to organize the Acupoint-specific property hierarchy for browsing and querying and does not itself assert overlap, location, or any other specific spatial relationship; that logical content is carried entirely by its subproperties."@en ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:subPropertyOf tara-op:topTARAObjectProperty .

