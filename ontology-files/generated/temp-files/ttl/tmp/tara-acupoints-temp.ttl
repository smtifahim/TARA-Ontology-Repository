    tara-ap:hasChineseLabel "水溝(沟)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasInnervationInformation "The buccal branch of the facial nerve, and the branch of the intraorbital nerve." ;
    tara-ap:hasLocationalDescription "On the face, at the midpoint of the philtrum midline. Remarks: Alternative location for GV26 at the junction of the upper one third and lower two thirds of the philtrum midline." ;
    tara-ap:hasMethodDescription "Puncture obliquely upward OJ-0.5 inch." ;
    tara-ap:hasPinyinLabel "Renzhong",
        "Shuigou" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0005402 ;
    tara-ap:hasSynonym "Du 26",
        "Governor Vessel 26",
        "VG 26" ;
    tara-ap:hasVasculatureInformation "The superior labial artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_0386099> ;
