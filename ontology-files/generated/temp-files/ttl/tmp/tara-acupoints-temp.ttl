                    owl:someValuesFrom ILX:0795324 ] ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_5290080> a owl:Class ;
    rdfs:label "BL 40" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 119. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "委中" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001465 ;
    tara-ap:hasInnervationInformation "The posterior femoral cutaneous nerve, the tibial nerve." ;
    tara-ap:hasListedIndications "low back pain, motor impairment of the hip joint, contracture of the tendons in the popliteal fossa, muscular atrophy, pain, numbness and motor impairment of the lower extremities, hemiplegia, abdominal pain, vomiting, diarrhea, erysipelas." ;
    tara-ap:hasLocationalDescription "On the posterior aspect of the knee, at the midpoint of the popliteal crease." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch, or prick the popliteal vein with three-edged needle to cause bleedmg." ;
    tara-ap:hasPinyinLabel "Weizhong" ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_6594221>,
        <http://www.acupunctureresearch.org/tara/ontology/TARA_9657915> ;
    tara-ap:hasSpecificReferenceLocation ILX:0795330 ;
    tara-ap:hasSynonym "B 40",
        "Bladder 40",
        "UB 40",
        "Urinary Bladder 40" ;
    tara-ap:hasVasculatureInformation "Superficially, the femoro-popliteal vein; deeper and medially, the popliteal vein; deepest, the popliteal artery." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_7525476> ;
