        "Triple Burner 11",
        "Triple Energizer 11",
        "Triple Heater 11",
        "Triple Warmer 11" ;
    tara-ap:hasVasculatureInformation "The terminal branches of the median collateral artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_3898257> ;
