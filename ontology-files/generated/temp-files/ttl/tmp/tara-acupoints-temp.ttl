    tara-ap:hasChineseLabel "商陽(阳)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0003622 ;
    tara-ap:hasInnervationInformation "The palmar digital proprial nerve derived from the median nerve." ;
    tara-ap:hasListedIndications "toothache, sore throat, swelling of the submandibular region, numbness of fingers, febrile diseases with anhidrosis, loss of consciousness." ;
    tara-ap:hasLocationalDescription "On the index finger, radial to the distal phalanx, 0.1 f-cun proximal-lateral to the radial corner of the index fingernail, at the intersection of the vertical line of the radial border of the fingernail and the horizontal line of the base of the index fingernail." ;
    tara-ap:hasMethodDescription "Puncture 0.1 inch, or prick the point to cause bleeding." ;
    tara-ap:hasPinyinLabel "Shangyang" ;
