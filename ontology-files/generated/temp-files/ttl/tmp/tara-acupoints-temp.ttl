<http://www.acupunctureresearch.org/tara/ontology/TARA_0794971> a owl:Class ;
    rdfs:label "LR 13" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 202. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "章門(门)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000916 ;
    tara-ap:hasInnervationInformation "Slightly inferiorly, the tenth intercostal nerve." ;
    tara-ap:hasListedIndications "abdominal distension, borborygmus, pain in the hypochondriac region, vomiting, diarrhea, indigestion." ;
    tara-ap:hasLocationalDescription "On the lateral abdomen, inferior to the free extremity of the 11th rib. Note: LR13 can be located while the subject is lying on the side with the shoulder flexed. The free extremity of the 11th rib can be palpated below the inferior border of the costal arch." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Zhangmen" ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_7546644>,
