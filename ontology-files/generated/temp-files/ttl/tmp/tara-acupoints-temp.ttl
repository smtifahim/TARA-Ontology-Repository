                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0001465 ] ],
        <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_0992296> a owl:Class ;
    rdfs:label "BL 23" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 111. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "腎兪(俞)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0005462 ;
    tara-ap:hasInnervationInformation "The lateral branch of the posterior ramus of the first lumbar nerve; deeper, its lateral branch." ;
    tara-ap:hasListedIndications "nocturnal emission, impotence, enuresis, irregular menstruation, leukorrhea, low back pain, weakness of the knee, blurred vision, dizziness, tinnitus, deafness, edema, asthma, diarrhea." ;
    tara-ap:hasLocationalDescription "In the lumbar region, at the same level as the inferior border of the spinous process of the second lumbar vertebra (L2), 1.5 B- cun lateral to the posterior median line." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 1-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Shenshu" ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_2432731> ;
    tara-ap:hasSpecificReferenceLocation UBERON:0004618,
        ILX:0795312 ;
    tara-ap:hasSynonym "B 23",
        "Back-Shu Point of the Kidney",
        "Bladder 23",
        "UB 23",
        "Urinary Bladder 23" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the second lumbar artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_7525476> ;
