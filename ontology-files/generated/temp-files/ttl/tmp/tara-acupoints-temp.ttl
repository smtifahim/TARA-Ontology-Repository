    tara-ap:hasGeneralSurfaceLocation UBERON:0001460 ;
    tara-ap:hasInnervationInformation "The posterior brachial cutaneous nerve and the muscular branch of the radial nerve." ;
    tara-ap:hasLocationalDescription "On the posterior aspect of the arm, on the line connecting the prominence of olecranon with the acromial angle, 2 B-cun proximal to the prominence of the olecranon. Note: With the elbow extended, 2 B-cun superior to the prominence of the olecranon." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Qinglengyuan" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0001461,
