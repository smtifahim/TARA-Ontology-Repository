    tara-ap:hasSpecificReferenceLocation UBERON:0001446,
        UBERON:0012291,
        ILX:0795330 ;
    tara-ap:hasSynonym "G 36",
        "Gallbladder 36" ;
    tara-ap:hasVasculatureInformation "The branches of the anterior tibial artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_5283975> ;
