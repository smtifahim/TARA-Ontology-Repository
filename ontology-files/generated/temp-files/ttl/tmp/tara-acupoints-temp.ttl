        "Bladder 46",
        "UB 46",
        "Urinary Bladder 46" ;
    tara-ap:hasVasculatureInformation "The posterior branches of the intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_7525476> ;
