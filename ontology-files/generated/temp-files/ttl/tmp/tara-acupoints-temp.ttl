tara-ap:hasRelatedVasculature a owl:AnnotationProperty ;
    rdfs:label "Related Vasculature"@en ;
    IAO:0000112 "Example: 'LU 1' tara:hasRelatedVasculature 'Axillary Artery'."@en ;
    dcterms:description "An annotation property that records the blood vessel(s) present at an Acupoint's location, as simple textual/IRI annotations. Corresponds to the object property tara-op:hasRelatedVasculature, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedVasculature ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedSubSurfaceAnatomy .

tara-op:hasRelatedVasculature a owl:ObjectProperty ;
    rdfs:label "hasRelatedVasculature" ;
    IAO:0000112 "'LU 1' tara-op:hasRelatedVasculature some 'Axillary Artery'; 'Axillary Vein'; 'Thoracoacromial Artery'; 'Thoracoacromial Vein'."@en ;
    IAO:0000115 "An Acupoint a hasRelatedVasculature b (a vessel) if and only if a hasRelatedSubSurfaceAnatomy b."@en ;
    dcterms:description "An object property that relates an Acupoint to the blood vessel(s) present at its location, relevant to safe needling."@en ;
    dcterms:isReferencedBy tara-ap:hasRelatedVasculature ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:comment "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its parent property hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here."@en ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:subPropertyOf tara-op:hasRelatedSubSurfaceAnatomy .

<http://www.acupunctureresearch.org/tara/ontology/TARA_0886544> a owl:Class ;
    rdfs:label "Special Point on the Head and Trunk Role" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_4176111> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_1787498> a owl:Class ;
    rdfs:label "Shu Point" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "Represents one of the five Shu Points. Each of the twelve main meridians has, below the elbow or knee, five specific points, namely, Jing-Well, Ying-Spring, Shu-Stream, Jing-River and He-Sea, which are termed Five Shu points in general. They are situated in the above order from the distal end of extremities to the elbow or knee. It is said in the first chapter of Miraculous Pivot that \"the qi of the twelve main meridians and fifteen collaterals flow all over the body. The flow of qi running in the meridians from the extremities to the elbow or knee is flourishing gradually.\" The names of the five shu points image the flow of meridian qi as the flow of water." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_1375080> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_4943316> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_1375080> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_4943316> a owl:Class ;
    rdfs:label "Special Point on the Limbs" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "A special, specific acupoint located on the Limbs. Specific points refer to those of the fourteen meridians that have special properties and are grouped under special names. Specific Points on the Limbs include: (1) Five Shu Points, (2) Yuan-Primary Points, (3) Luo-Conneetiog Points, (4) Xi-Cleft Points, and (5) Eight Confluent Points." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_8173108> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_7852472> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_8173108> ] ) ] .

tara-ap:hasAcupointInformation a owl:AnnotationProperty ;
    rdfs:label "Acupoint Information"@en ;
    dcterms:description "An annotation property grouping all textual descriptive attributes of an acupoint, including its anatomical location, needling method, indications, vasculature, and innervation. Subproperties further specialize the type of description."@en ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

IAO:0000118 a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en .

