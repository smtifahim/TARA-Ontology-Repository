    tara-ap:hasSynonym "S 39",
        "Stomach 39",
        "The Lower He-Sea Point of the Small Intestine" ;
    tara-ap:hasVasculatureInformation "The anterior tibial artery and anterior tibial vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_6221269> ;
