tara-ap:hasRelatedArtery a owl:AnnotationProperty ;
    rdfs:label "Related Artery"@en ;
    IAO:0000112 "'LU 1' tara:hasRelatedArtery 'Axillary Artery'."@en ;
    dcterms:description "An annotation property that records a specific artery occupying an Acupoint's location, as a simple textual/IRI annotation. Corresponds to the object property tara-op:hasRelatedArtery, which is used for logical axioms."@en ;
    dcterms:references tara-op:hasRelatedArtery ;
    dcterms:requires tara-ap:hasVasculatureInformation ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:hasRelatedVasculature .

tara-ap:hasRelatedNerve a owl:AnnotationProperty ;
