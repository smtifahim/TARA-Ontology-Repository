<http://www.acupunctureresearch.org/tara/ontology/TARA_9610280> a owl:Class ;
    rdfs:label "Sishencong" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Headache, vertigo, insomnia, poor memory, epilepsy." ;
    tara-ap:hasLocationalDescription "A group of 4 points, at the vertex, 1 cun respectively posterior, anterior and lateral to Baihui (GV 20). (See Fig. 119)" ;
    tara-ap:hasMethodDescription "Puncture subcutaneously 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-HN 1",
        "M-HN 1" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_9907701> a owl:Class ;
    rdfs:label "Shiqizhui" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Lumbar Pain, thigh pain, paralysis of the lower extremities, irregular menstruation, dysmenorrhea." ;
    tara-ap:hasLocationalDescription "Below the spinous process of the fifth lumbar vertebra." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "EX-B 8",
        "M-BW 25",
        "Shiqizhuixia" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/acupoints.owl> a owl:Ontology ;
    dc:contributor "Fahim T. Imam, PhD - https://orcid.org/0000-0003-4752-543X",
        "Ilias Ziogas, PhD - https://orcid.org/0000-0002-9210-2455",
        "Maryann E. Martone, PhD - https://orcid.org/0000-0002-8406-3871",
        "Richard Harris, PhD - https://orcid.org/0000-0002-2067-8447" ;
    dc:creator "Fahim T. Imam, PhD - https://orcid.org/0000-0003-4752-543X" ;
    dc:description """The TARA Acupoints Ontology is an ontology developed as part of the Topological Atlas and Repository for Acupoint Research (TARA) project funded by the National Institute of Health (NIH). The goal of TARA is to establish a new comprehensive resource for the acupuncture research and clinician community. The ontology will be used to support semantic search and annotations for anatomical maps, atlases, and data sets relevant to the TARA project.
- About TARA Project: https://www.acupunctureresearch.org/tara
- TARA Ontology GitHub Repo: https://purl.org/tara/ontology/repo
- TARA Ontology Updates: https://purl.org/tara/ontology/updates
- TARA Ontology Files: https://purl.org/tara/ontology"""@en ;
    dc:source "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. ISBN 978-7-119-01758-7."@en,
        "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 26. https://iris.who.int/handle/10665/353407"@en ;
    dc:title "TARA Acupoints Ontology"@en ;
    owl:versionInfo "1.5.0" .

tara-ap:hasAbbreviation a owl:AnnotationProperty ;
    rdfs:label "Abbreviation" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasAcronym a owl:AnnotationProperty ;
    rdfs:label "Acronym" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasAuthor a owl:AnnotationProperty ;
    rdfs:label "Author(s)" ;
    rdfs:subPropertyOf dc:creator .

tara-ap:hasChineseLabel a owl:AnnotationProperty ;
    rdfs:label "Chinese Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasCurationSourceLink a owl:AnnotationProperty ;
    rdfs:label "Curation Source Link"@en ;
    dc:description "An annotation property that links an extracted metadata element, class, or individual to its precise origin in the data curation layer via a direct URL. For Google Sheets, the value must be a fully qualified, clickable URL containing specific worksheet identifier (gid) and target cell or row parameters (range), establishing strict machine-readable provenance down to the exact grid coordinate."@en ;
    rdfs:subPropertyOf dc:source .

tara-ap:hasDOI a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:identifier .

tara-ap:hasEnglishLabel a owl:AnnotationProperty ;
    rdfs:label "English Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasFigureSourceLink a owl:AnnotationProperty ;
    rdfs:label "Figure Source Link"@en ;
    dc:description "An annotation property that links a figure from a web resource to enhance the information about an ontological class or entity."@en ;
    rdfs:subPropertyOf dc:source .

tara-ap:hasListedIndications a owl:AnnotationProperty ;
    rdfs:label "Listed Indication(s)"@en ;
    dcterms:description """An annotation property that lists the clinical conditions and symptoms for which an acupoint is indicated according to traditional Chinese medicine.

Example: 'LU 1' tara:hasListedIndications "Cough, asthma, pain in the chest, shoulder and back; fullness of the chest\""""@en ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:subPropertyOf tara-ap:hasAcupointInformation .

tara-ap:hasMethodDescription a owl:AnnotationProperty ;
    rdfs:label "Acupuncture Method"@en ;
    dcterms:description """An annotation property that describes the recommended needling method for an acupoint, including needle angle, depth, and applicability of moxibustion. 

Example: 'LU 1' tara:hasMethodDescription "Puncture obliquely 0.5-0.8 cun towards the lateral aspect of the chest. To avoid injuring the lung, never puncture deeply towards the medial aspect. Moxibustion is applicable.\""""@en ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:subPropertyOf tara-ap:hasAcupointInformation .

tara-ap:hasNextAcupoint a owl:AnnotationProperty ;
    rdfs:label "Next Acupoint"@en ;
    dcterms:description """An annotation property to link a meridian acupoint to its next acupoint along the same meridian.

Example: 'LU 1' tara:hasNextAcupoint 'LU 2'."""@en ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_5151019> ;
    rdfs:range <http://www.acupunctureresearch.org/tara/ontology/TARA_5151019> ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-ap:hasPinyinLabel a owl:AnnotationProperty ;
    rdfs:label "Pinyin Label" ;
    rdfs:subPropertyOf IAO:0000118 .

tara-ap:hasPublicationDate a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:date .

tara-ap:hasPublicationVenue a owl:AnnotationProperty ;
    rdfs:subPropertyOf dc:relation .

tara-ap:hasSynonym a owl:AnnotationProperty ;
    rdfs:label "Synonym" ;
    rdfs:subPropertyOf IAO:0000118 .

OboInOwl:creation_date a owl:AnnotationProperty .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

dc:identifier a owl:AnnotationProperty .

dc:relation a owl:AnnotationProperty .

<http://www.acupunctureresearch.org/tara/ontology/TARA_0077876> a owl:Class ;
    rdfs:label "Back-Shu Point of the Spleen" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Back-Shu Point of the Spleen meridian. Back-Shu points are specific points on the back where the qi of the respective zang-fu organs is infused. Situated close to their respectively related zang-fu organs, the Back-Shu points present abnormal reactions to the dysfunction of their corresponding zang-fu organs. They are often used for disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_4143036> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_3861175> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_4143036> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_0220312> a owl:Class ;
    rdfs:label "Front-Mu Point of the Pericardium" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Front-Mu Point of the Pericardium meridian. Front-Mu points are those points on the chest and abdomen where the qi of the respective zang-fu organs is infused and converged. Located close to their corresponding zang-fu organs, the Front-Mu points play a significant role in the diagnosis and treatment of the disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_5568565> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_8746709> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_5568565> ] ) ] .

