    tara-ap:hasSpecificReferenceLocation UBERON:0002225,
        UBERON:0004610 ;
    tara-ap:hasSynonym "Front-Mu Point of the Spleen",
        "Influential Point of Zang Organs",
        "LIV 13",
        "LV 13",
        "Liver 13" ;
    tara-ap:hasVasculatureInformation "The terminal branch of the tenth intercostal artery." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_5419503> ;
