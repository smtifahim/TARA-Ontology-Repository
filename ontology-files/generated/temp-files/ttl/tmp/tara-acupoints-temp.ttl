    tara-ap:hasChineseLabel "上關(关,関)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0000033 ;
    tara-ap:hasInnervationInformation "The zygomatic branch of the facial nerve and the zygomaticofacial nerve." ;
    tara-ap:hasListedIndications "headache, deafness, tinnitus, diplacusis, deviation of the eye and mouth, toothache." ;
    tara-ap:hasLocationalDescription "On the head, in the depression superior to the midpoint of the zygomatic arch Note: In the depression superior to the zygomatic arch, superior to St7." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Deep puncture is not advisable. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Shangguan" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002500 ;
    tara-ap:hasSynonym "G 3",
        "Gallbladder 3" ;
    tara-ap:hasVasculatureInformation "The zygomaticoorbital artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_5283975> ;
