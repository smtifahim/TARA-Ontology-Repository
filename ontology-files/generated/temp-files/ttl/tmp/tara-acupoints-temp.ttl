    tara-ap:hasChineseLabel "下廉" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0002386 ;
    tara-ap:hasInnervationInformation "The posterior antebrachial cutaneous nerve and the deep ramus of the radial nerve." ;
    tara-ap:hasListedIndications "abdominal pain, borborygmus, pain in the elbow and arm, motor impairment of the upper limbs." ;
    tara-ap:hasLocationalDescription "On the posterolateral aspect of the forearm, on the line connecting LI5 with LI11, 4 B- cun inferior to the cubital crease. Note: LI8 is located at the junction of the upper one third and lower two thirds of the line connecting LI5 with LI11, 1 B-cun inferior to LI9." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Xialian" ;
    tara-ap:hasRelatedArtery UBERON:0001404 ;
    tara-ap:hasRelatedNerve ILX:0794977,
        ILX:0797477 ;
    tara-ap:hasRelatedVein UBERON:0001106 ;
    tara-ap:hasSpecificReferenceLocation ILX:0795332 ;
    tara-ap:hasSynonym "CO 8",
        "Colon 8",
        "Large Intestine 8" ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_4610474> ;
    rdfs:subClassOf [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_5151019> [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
