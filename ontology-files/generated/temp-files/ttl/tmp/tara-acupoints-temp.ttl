<http://www.acupunctureresearch.org/tara/ontology/TARA_0214009> a owl:Class ;
    rdfs:label "GB 24" ;
    dcterms:bibliographicCitation "[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 183. https://iris.who.int/handle/10665/353407",
        "[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7." ;
    tara-ap:hasChineseLabel "日月" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0016416 ;
    tara-ap:hasInnervationInformation "The seventh intercostal nerve." ;
    tara-ap:hasListedIndications "pain in the hypochondriac region, vomiting, acid regurgitation, hiccup, jaundice, mastitis." ;
    tara-ap:hasLocationalDescription "In the anterior thoracic region, in the sev- enth intercostal space, 4 B-cun lateral to the anterior median line. Note 1: GB 24 is inferior to the centre of the nipple, one rib inferior to LR 14. Note 2: In females, GB24 can be found at the intersection of the midclavicular line and the seventh intercostal space." ;
    tara-ap:hasMethodDescription "Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Riyue" ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_4192840> ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002030,
        ILX:0795285,
        ILX:0795321,
        ILX:0795322 ;
    tara-ap:hasSynonym "Front-Mu Point of the Gallbladder",
        "G 24",
        "Gallbladder 24" ;
    tara-ap:hasVasculatureInformation "The seventh intercostal artery and vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_5283975> ;
