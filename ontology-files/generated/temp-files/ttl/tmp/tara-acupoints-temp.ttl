        "KID 2",
        "Kidney 2" ;
    tara-ap:hasVasculatureInformation "The branches of the medial plantar and medial tarsal arteries." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_4813389> ;
    rdfs:subClassOf [ a owl:Restriction ;
