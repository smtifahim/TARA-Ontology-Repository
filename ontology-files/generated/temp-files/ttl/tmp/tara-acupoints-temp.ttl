    tara-ap:hasChineseLabel "筋縮(缩)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0008231 ;
    tara-ap:hasInnervationInformation "The medial branch of the posterior ramus of the ninth thoracic nerve." ;
    tara-ap:hasListedIndications "epilepsy, stiffness of the back, gastric pain." ;
    tara-ap:hasLocationalDescription "In the upper back region, in the depression inferior to the spinous process of the ninth thoracic vertebra (T9), on the posterior median line." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Jinsuo" ;
