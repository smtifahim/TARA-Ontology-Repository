            owl:onProperty tara-op:hasGeneralSurfaceLocation ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty partOf: ;
                    owl:someValuesFrom UBERON:0016416 ] ],
        [ a owl:Restriction ;
            owl:onProperty tara-op:hasRelatedNerve ;
            owl:someValuesFrom ILX:0784694 ],
        <http://www.acupunctureresearch.org/tara/ontology/TARA_9460971> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_8260776> a owl:Class ;
    rdfs:label "Front-Mu Point of the Kidney" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Front-Mu Point of the Kidney meridian. Front-Mu points are those points on the chest and abdomen where the qi of the respective zang-fu organs is infused and converged. Located close to their corresponding zang-fu organs, the Front-Mu points play a significant role in the diagnosis and treatment of the disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_1915339> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_8746709> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_1915339> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_8784353> a owl:Class ;
    rdfs:label "Back-Shu Point of the Small Intestine" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Back-Shu Point of the Small Intestine meridian. Back-Shu points are specific points on the back where the qi of the respective zang-fu organs is infused. Situated close to their respectively related zang-fu organs, the Back-Shu points present abnormal reactions to the dysfunction of their corresponding zang-fu organs. They are often used for disorders of the internal organs." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_2510634> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_3861175> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_2510634> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_9406515> a owl:Class ;
    rdfs:label "Influential Point of Qi" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Qi can be employed to treat disorders of the Zang organs. Tanzhong (CV 17) is the Influential Point of Qi." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_0521663> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_7010544> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_0521663> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_9657915> a owl:Class ;
    rdfs:label "Lower He-Sea Point of the Bladder" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "The Lower He-Sea Point of the the Bladder meridian. One of the five Shu Points, the He-Sea point signifies the confluence of rivers in the sea, where the meridian qi is the most flourishing. In addition, each of the six fu organs has another He-Sea point in the three yang meridians of the foot, known as the Lower He-Sea point. The Lower He-Sea points are mostly employed to treat the disorders of the six fu organs in clinic." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_4568236> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_4830205> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_4568236> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_9719785> a owl:Class ;
    rdfs:label "Influential Point of Bone" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Bone can be employed to treat disorders of the bones. Dazhu (BL 11) is the Influential Point of bone." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_3049719> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_7010544> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_3049719> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_9763906> a owl:Class ;
    rdfs:label "Influential Point of Blood" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Blood can be employed to treat disorders of blood. Geshu (BL 17) is the Influential Point of blood." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_3965890> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_7010544> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_3965890> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_9924428> a owl:Class ;
    rdfs:label "Influential Point of the Marrow" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7." ;
    dcterms:description "One of the eight influential points, the Influential Point of Marrow can be employed to treat disorders of the marrow. Xuanzhong (GB 39) is the Influential Point of marrow." ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_5049050> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_7010544> [ a owl:Restriction ;
                        owl:onProperty tara-op:hasSpecialPointRole ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_5049050> ] ) ] .

tara-ap:hasAssociatedOrgan a owl:AnnotationProperty ;
    rdfs:label "Associated Organ"@en ;
    dcterms:description """An annotation property that records the organ a Meridian is associated with according to traditional Chinese medicine theory, as a simple textual/IRI annotation. Corresponds to the object property tara-op:hasAssociatedOrgan, which is used for logical axioms.

Example: 'Lung Meridian' tara:hasAssociateOrgan 'Lung'."""@en ;
    dcterms:references tara-op:hasAssociatedOrgan ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_7226516> ;
    rdfs:range UBERON:0001062 ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-ap:hasSpecialPointRole a owl:AnnotationProperty ;
    rdfs:label "Special Point Role"@en ;
    dcterms:description """An annotation property that records the named special point role(s) designated to an acupoint as a textual annotation. Corresponds to the object property tara-op:hasSpecialPointRole, which is used for the logical classification of Special Points.

Example: 'LU 1' tara:hasSpecialPointRole 'Front-Mu Point of the Lung'."""@en ;
    dcterms:references tara-op:hasSpecialPointRole ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-ap:isLocatedOnMeridian a owl:AnnotationProperty ;
    rdfs:label "Acupoint of Meridian"@en ;
    dcterms:description """An annotation property that records the Meridian along which an Acupoint is located, as a simple textual/IRI annotation. Corresponds to the object property tara-op:isLocatedOnMeridian, which is used for logical axioms.

Example: 'LU 1' tara:isLocatedOnMeridian 'Lung Meridian'."""@en ;
    dcterms:references tara-op:isLocatedOnMeridian ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:range <http://www.acupunctureresearch.org/tara/ontology/TARA_7226516> ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-ap:isMeridianLocationOf a owl:AnnotationProperty ;
    rdfs:label "Meridian of Acupoint"@en ;
    dcterms:description """An annotation property that relates a Meridian to an Acupoint that is located along its linear trajectory, as a simple textual/IRI annotation. Corresponds to the object property tara-op:isMeridianLocationOf, which is used for logical axioms.

Example: 'Lung Meridian' tara:isMeridianLocationOf 'LU 1'"""@en ;
    dcterms:references tara-op:isMeridianLocationOf ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_7226516> ;
    rdfs:range <http://www.acupunctureresearch.org/tara/ontology/TARA_5151019> ;
    rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .

tara-op:isSpecialPointRoleOf a owl:ObjectProperty ;
    rdfs:label "isSpecialPointRoleOf" ;
    IAO:0000115 "A role a isSpecialPointRoleOf an Acupoint b if and only if b hasSpecialPointRole a."@en ;
    dcterms:description "An object property that relates a special acupoint role to the Acupoint that bears it. It is the inverse of hasSpecialPointRole."@en ;
    rdfs:comment "Declared as a subproperty of RO:0000081 (role_of) as the inverse counterpart of has_role, consistent with hasSpecialPointRole being a subproperty of RO:0000087 (has_role)."@en ;
    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_4176111> ;
    rdfs:range <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
    rdfs:subPropertyOf tara-op:topTARAObjectProperty .

