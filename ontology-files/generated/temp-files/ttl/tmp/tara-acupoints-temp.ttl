    tara-ap:hasChineseLabel "大赫" ;
    tara-ap:hasGeneralSurfaceLocation ILX:0795303 ;
    tara-ap:hasInnervationInformation "The branches of subcostal nerve and the iliohypogastric nerve." ;
    tara-ap:hasListedIndications "nocturnal emission, impotence, morbid leukorrhea, pain in the external genitalia, prolapse of the uterus." ;
    tara-ap:hasLocationalDescription "On the lower abdomen, 4 B-cun inferior to the centre of the umbilicus, 0.5 B-cun lateral to the anterior median line." ;
    tara-ap:hasPinyinLabel "Dahe" ;
    tara-ap:hasSpecificReferenceLocation UBERON:0007118,
