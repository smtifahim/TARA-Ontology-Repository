    tara-ap:hasSynonym "Conception Vessel 2",
        "RN 2",
        "Ren 2",
        "VC 2" ;
    tara-ap:hasVasculatureInformation "The branches of the inferior epigastric artery and the obturator artery." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_6789717> ;
