    tara-ap:hasChineseLabel "腕骨(骨)" ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0004452 ;
    tara-ap:hasInnervationInformation "The dorsal branch of the ulnar nerve." ;
    tara-ap:hasListedIndications "febrile diseases with anhidrosis, headache, rigidity of the neck, contracture of the fingers, pain in the wrist, jaundice." ;
    tara-ap:hasLocationalDescription "On the posteromedial aspect of the wrist, in the depression between the base of the fifth metacarpal bone and the triquetrum bone, at the border between the red and white flesh. Note: With one finger placed on SI3, push and slide proximally along the fifth metacarpal bone to the bony projection, SI4 is located in the depression between these two bones." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable." ;
    tara-ap:hasPinyinLabel "Wangu" ;
    tara-ap:hasRelatedArtery UBERON:0002454 ;
    tara-ap:hasRelatedNerve ILX:0797491 ;
    tara-ap:hasSpecialPointRole <http://www.acupunctureresearch.org/tara/ontology/TARA_1840369> ;
    tara-ap:hasSpecificReferenceLocation UBERON:0002445,
        UBERON:0003649 ;
    tara-ap:hasSynonym "Small Intestine 4" ;
    tara-ap:hasVasculatureInformation "The posterior carpal artery (the branch of the ulnar artery), the dorsal venous network of the hand." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_9093316> ;
