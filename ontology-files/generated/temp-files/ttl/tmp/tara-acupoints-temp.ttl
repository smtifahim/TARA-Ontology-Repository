<http://www.acupunctureresearch.org/tara/ontology/TARA_8819424> a owl:Class ;
    rdfs:label "Zhoujian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Scrofula" ;
    tara-ap:hasLocationalDescription "On the tip of the ulnar olecranon when the elbow is flexed." ;
    tara-ap:hasSynonym "EX-UE 1",
        "M-UE 46" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_8866697> a owl:Class ;
    rdfs:label "Kidney Meridian Acupoint" ;
    dcterms:bibliographicCitation "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407" ;
    dcterms:description "An acupuncture point that is located along the Kidney Meridian of Foot-Shaoyin (KI), which consists of 27 standardized acupoints beginning at KI 1 (Yongquan) on the sole of the foot in the depression formed when the toes are flexed, traveling up along the medial aspect of the leg and continuing up the abdomen and chest close to the midline, and ending at KI 27 (Shufu) on the anterior chest in the depression at the inferior border of the clavicle." ;
    tara-ap:hasSynonym "Acupoint of Kidney Meridian",
        "Acupoint of the Kidney Meridian",
        "Acupoint of the kidney meridian of foot-shaoyin",
        "Acupuncture point of the kidney meridian",
        "Acupuncture point of the kidney meridian of foot-shaoyin",
        "KI Acupoint" ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_4813389> ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/TARA_5151019> [ a owl:Restriction ;
                        owl:onProperty tara-op:isLocatedOnMeridian ;
                        owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/TARA_4813389> ] ) ] .

<http://www.acupunctureresearch.org/tara/ontology/TARA_9268434> a owl:Class ;
    rdfs:label "Qiuhou" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Eye diseases." ;
    tara-ap:hasLocationalDescription "At the junction of the lateral 1/4 and the medial 3/4 of the infraorbital margin." ;
    tara-ap:hasMethodDescription "Push the eyeball upward gently, then puncture perpendicularly 0.5-1.2 inches along the orbital margin slowly without movements of lifting, thrusting, twisting and rotating." ;
    tara-ap:hasSynonym "EX-HN 7",
        "M-HN 8" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_9492402> a owl:Class ;
    rdfs:label "Jianqian" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasListedIndications "Pain in the shoulder and arm, paralysis of the upper extremities." ;
    tara-ap:hasLocationalDescription "Midway between the end of the anterior axillary fold and Jianyu (LI 15)." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable." ;
    tara-ap:hasSynonym "Jianneiling",
        "M-UE 48" ;
    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3535998> .

<http://www.acupunctureresearch.org/tara/ontology/TARA_9534465> a owl:Class ;
    rdfs:label "Taiyang" ;
    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.",
        "[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O'Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points." ;
    tara-ap:hasGeneralSurfaceLocation UBERON:0001456 ;
    tara-ap:hasListedIndications "Headache, eye diseases, deviation of the eyes and mouth." ;
    tara-ap:hasLocationalDescription "In the depression about one finger breadth posterior to the midpoint between the lateral end of the eyebrow and the outer canthus." ;
    tara-ap:hasMethodDescription "Puncture perpendicularly 0.3-0.5 inch, or prick to cause bleeding." ;
    tara-ap:hasSpecificReferenceLocation UBERON:0006726,
