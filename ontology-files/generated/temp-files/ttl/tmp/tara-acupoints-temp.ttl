        "TH 17",
        "TW 17",
        "Triple Burner 17",
        "Triple Energizer 17",
        "Triple Heater 17",
        "Triple Warmer 17" ;
    tara-ap:hasVasculatureInformation "The posterior auricular artery and vein, the external jugular vein." ;
    tara-ap:isLocatedOnMeridian <http://www.acupunctureresearch.org/tara/ontology/TARA_3898257> ;
