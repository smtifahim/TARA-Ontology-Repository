        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795308"/>
        <rdfs:label>midaxillary line</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795309 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795309">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004704"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008785"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A pyramidal depression located at the junction of the upper limb and thorax, commonly referred to as the armpit.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008785"/>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/axillary-fossa-1536889648</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma61464"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795309"/>
        <rdfs:label>axillary fossa</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795310 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795310">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004704"/>
