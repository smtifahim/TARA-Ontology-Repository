    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1330972 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1330972">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0739106"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasGeneralSurfaceLocation"/>
                <owl:someValuesFrom>
