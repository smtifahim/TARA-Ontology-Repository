        <OboInOwl:hasDbXref>NCIT:C53079</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:181696007</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C1710423</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Tibialis_anterior_muscle</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>galen:TibialisAnterior</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>tibialis anterior muscle</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>tibialis cranialis</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>tibilais cranialis</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>anterior tibialis</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>ibialis anticus</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>musculus tibialis anterior</OboInOwl:hasRelatedSynonym>
        <rdfs:label>tibialis anterior</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/9/9c/Gray1240.png</foaf:depiction>
    </owl:Class>
    


