        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 119. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>委中</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001465"/>
        <tara:hasIndicationsDescription>low back pain, motor impairment of the hip joint, contracture of the tendons in the popliteal fossa, muscular atrophy, pain, numbness and motor impairment of the lower extremities, hemiplegia, abdominal pain, vomiting, diarrhea, erysipelas.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The posterior femoral cutaneous nerve, the tibial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posterior aspect of the knee, at the midpoint of the popliteal crease.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch, or prick the popliteal vein with three-edged needle to cause bleedmg.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Weizhong</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9657915"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795330"/>
        <tara:hasSynonym>B 40</tara:hasSynonym>
        <tara:hasSynonym>Bladder 40</tara:hasSynonym>
        <tara:hasSynonym>UB 40</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 40</tara:hasSynonym>
        <tara:hasVasculatureDescription>Superficially, the femoro-popliteal vein; deeper and medially, the popliteal vein; deepest, the popliteal artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 40</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5308180 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5308180">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_8746709"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1670028"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8746709"/>
        <dc:description>The Front-Mu Point of the Bladder meridian. Front-Mu points are those points on the chest and abdomen where the qi of the respective zang-fu organs is infused and converged. Located close to their corresponding zang-fu organs, the Front-Mu points play a significant role in the diagnosis and treatment of the disorders of the internal organs.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1670028"/>
        <rdfs:label>Front-Mu Point of the Bladder</rdfs:label>
    </owl:Class>
    


