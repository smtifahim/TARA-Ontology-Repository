        <OboInOwl:hasDbXref>MESH:D015050</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MFMO:0000108</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C33897</OboInOwl:hasDbXref>
