        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 148. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>彧中</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <tara:hasIndicationsDescription>cough, asthma, accumulation of phlegm, fullness in the chest and hypochondriac region.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anterior cutaneous branch of the first intercostal nerve, the medial supraclavicular nerve; the first intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior thoracic region, in the first intercostal space, 2 B-cun lateral to the anterior median line.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Yuzhong</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795283"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSynonym>K 26</tara:hasSynonym>
        <tara:hasSynonym>KD 26</tara:hasSynonym>
        <tara:hasSynonym>KID 26</tara:hasSynonym>
        <tara:hasSynonym>Kidney 26</tara:hasSynonym>
        <tara:hasVasculatureDescription>The first intercostal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <rdfs:label>KI 26</rdfs:label>
