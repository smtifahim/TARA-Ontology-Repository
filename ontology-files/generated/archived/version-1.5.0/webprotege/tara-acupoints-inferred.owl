            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010703"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The major preaxial endochondral bone in the anterior zeugopod[Phenoscape].</obo:IAO_0000115>
        <OboInOwl:hasDbXref>AAO:0000788</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>CALOHA:TS-2199</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EMAPA:19103</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:23463</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>GAID:185</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0001357</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MESH:D011884</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C12777</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:181940002</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C0034627</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VSAO:0005012</OboInOwl:hasDbXref>
