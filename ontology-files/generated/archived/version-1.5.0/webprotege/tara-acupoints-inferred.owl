        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <tara:hasIndicationsDescription>enuresis, pain due to hernia, morbid leukorrhea, irregular menstruation, cold sensation and pain of the lower back, dysuria, constipation, tenesmus, prolapse of the rectum.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The lateral branches of the posterior rami of the third and fourth sacral nerves, the inferior gluteal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the sacral region, at the same level as the fourth posterior sacral foramen, 1.5 B-cun lateral to the median sacral crest. Note: 1.5 B-cun lateral to the sacral hiatus, at the same level as BL34.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Baihuanshu</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0741680"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0741717"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795316"/>
        <tara:hasSynonym>B 30</tara:hasSynonym>
        <tara:hasSynonym>Bladder 30</tara:hasSynonym>
        <tara:hasSynonym>UB 30</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 30</tara:hasSynonym>
        <tara:hasVasculatureDescription>The inferior gluteal artery and vein; deeper, the internal pudendal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 30</rdfs:label>
    </owl:Class>
    


