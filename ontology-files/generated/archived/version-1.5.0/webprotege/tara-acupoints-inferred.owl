        <tara:hasChineseLabel>肓門(门)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005462"/>
        <tara:hasIndicationsDescription>abdominal pain, constipation, abdominal mass.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The lateral branch of the posterior ramus of the twelfth thoracic nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the lumbar region, at the same level as the inferior border of the spinous process of the first lumbar vertebra (L1), 3 B-cun lateral to the posterior median line. Note: BL51, BL22 and GV5 are located at the same level as the inferior border of the spinous process of the first lumbar vertebra (L1).</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Huangmen</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004617"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSynonym>B 51</tara:hasSynonym>
        <tara:hasSynonym>Bladder 51</tara:hasSynonym>
        <tara:hasSynonym>UB 51</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 51</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior branches of the first lumbar artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 51</rdfs:label>
    </owl:Class>
    


