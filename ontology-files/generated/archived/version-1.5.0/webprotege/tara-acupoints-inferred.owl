        <tara:hasSynonym>KD 5</tara:hasSynonym>
        <tara:hasSynonym>KID 5</tara:hasSynonym>
        <tara:hasSynonym>Kidney 5</tara:hasSynonym>
        <tara:hasVasculatureDescription>The medial calcaneal branch of the posterior tibial artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
