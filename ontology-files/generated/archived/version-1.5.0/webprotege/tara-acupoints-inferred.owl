    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_4176111 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4176111">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <obo:IAO_0000115>A Role, realized in acupuncture practice, that classifies an Acupoint according to a named functional category defined within traditional Chinese medicine theory (e.g., Front-Mu point, Back-Shu point, He-Sea point).</obo:IAO_0000115>
        <dc:description xml:lang="en">A special, specific role of an acupoint located on the main meridian. Specific points refer to those of the fourteen meridians that have special properties (roles) and are grouped under special names. This class is used to classify the acupoints based on their special point roles.</dc:description>
        <dcterms:bibliographicCitation xml:lang="en">Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSynonym>Special Acupoint Role</tara:hasSynonym>
        <rdfs:label>Special Point Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_4192840 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4192840">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_8746709"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9940480"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8746709"/>
        <dc:description>The Front-Mu Point of the Gallbladder meridian. Front-Mu points are those points on the chest and abdomen where the qi of the respective zang-fu organs is infused and converged. Located close to their corresponding zang-fu organs, the Front-Mu points play a significant role in the diagnosis and treatment of the disorders of the internal organs.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9940480"/>
        <rdfs:label>Front-Mu Point of the Gallbladder</rdfs:label>
    </owl:Class>
    


