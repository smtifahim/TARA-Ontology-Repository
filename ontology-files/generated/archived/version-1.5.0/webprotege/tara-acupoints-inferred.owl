                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003690"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A ring of bone formed by the sacrum and the first few coccygeal vertebrae as the roof, the pubis and ischia as the floor and the ilia and the acetabular part of the ischia as the walls.</obo:IAO_0000115>
        <obo:IAO_0000116>TODO add taxon-specific part of relations connecting sub-structures to this.</obo:IAO_0000116>
        <OboInOwl:hasDbXref>FMA:16580</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:46633002</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>pelvis ossea</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>skeletal system of pelvis</OboInOwl:hasExactSynonym>
        <rdfs:label>bony pelvis</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdn.humanatlas.io/digital-objects/ref-organ/pelvis-female/v1.3/assets/3d-vh-f-pelvis.glb</foaf:depiction>
