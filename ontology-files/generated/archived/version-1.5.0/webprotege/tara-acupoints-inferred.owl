        <tara:hasInnervationDescription>The facial and buccal nerves.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the face, anterior to the angle of the mandible, in the depression anterior to the masseter attachment, over the facial artery.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Avoid puncturing the artery. Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Daying</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001612"/>
