        <OboInOwl:hasDbXref>FMA:24922</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>GAID:59</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0000039</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MESH:D014953</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C111033</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:361289009</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Wrist</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>galen:Wrist</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>carpal limb segment</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>carpal segment</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>fore basipodium</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>fore mesopodium</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>hand mesopodium</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>manus mesopodium</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>regio carpalis</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>wrist</OboInOwl:hasExactSynonym>
