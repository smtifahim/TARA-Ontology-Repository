        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>孔最</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <tara:hasIndicationsDescription>cough, pain in the chest, asthma, hemoptysis, sore throat, spasmodic pain of the elbow and arm.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The lateral antebrachial cutaneous nerve and the superficial ramus of the radial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the anterolateral aspect of the forearm, on the line connecting LU5 with LU9, 7 B- cun superior to the palmar wrist crease. 
Note: LU6 is 5 B-cun inferior to LU5, 1 B-cun superior to the midpoint of the line connecting LU5 with LU9.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Kongzui</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001404"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794951"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797391"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001106"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_8600092"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4598552"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795334"/>
        <tara:hasSynonym>L 6</tara:hasSynonym>
        <tara:hasSynonym>Lung 6</tara:hasSynonym>
        <tara:hasVasculatureDescription>The cephalic vein, the radial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9964503"/>
        <rdfs:label>LU 6</rdfs:label>
    </owl:Class>
    


