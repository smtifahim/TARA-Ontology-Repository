    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0009989 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009989">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005055"/>
