                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecificSurfaceLocation"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://uri.interlex.org/base/ilx_0795313"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 115. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>上髎(髎)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <tara:hasIndicationsDescription>low back pain, dysuria, constipation, irregular menstruation, morbid leukorrhea, prolapse of the uterus.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>At the site where the posterior ramus of the first sacral nerve passes.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the sacral region, in the first posterior sacral foramen. Note: The first posterior sacral foramen is palpated in the depression, moving superiorly from BL32.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Shangliao</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795313"/>
        <tara:hasSynonym>B 31</tara:hasSynonym>
        <tara:hasSynonym>Bladder 31</tara:hasSynonym>
        <tara:hasSynonym>UB 31</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 31</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior branches of the lateral sacral artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 31</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2478120 -->

