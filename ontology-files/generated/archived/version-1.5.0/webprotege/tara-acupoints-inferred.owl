    <!-- http://purl.obolibrary.org/obo/UBERON_0011595 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011595">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000475"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010314"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000165"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A subdivision of the head that corresponds to the jaw skeleton, containing both soft tissue, skeleton and teeth (when present). The jaw region is divided into upper and lower regions.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>EMAPA:32905</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C114916</OboInOwl:hasDbXref>
        <rdfs:label>jaw region</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://eol.org/collections/11578</rdfs:seeAlso>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0011597 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011597">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012360"/>
