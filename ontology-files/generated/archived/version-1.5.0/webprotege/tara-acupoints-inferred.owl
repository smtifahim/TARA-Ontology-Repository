        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>曲澤(泽,沢)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001461"/>
        <tara:hasIndicationsDescription>cardiac pain, palpitation, febrile diseases, irritability, stomachache, vomiting, pain in the elbow and arm, tremor of the hand and arm.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The median nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the anterior aspect of the elbow, at the cubital crease, in the depression medial to the biceps brachii tendon. Note: When the elbow is flexed at 45 degrees, PC3 is located medial to the biceps brachii tendon.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-0.7 inch, or prick with a three-edged needle to cause bleeding. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Quze</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008188"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795332"/>
        <tara:hasSynonym>P 3</tara:hasSynonym>
        <tara:hasSynonym>Pericardium 3</tara:hasSynonym>
        <tara:hasVasculatureDescription>On the pathway of the brachial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4694897"/>
        <rdfs:label>PC 3</rdfs:label>
    </owl:Class>
    


