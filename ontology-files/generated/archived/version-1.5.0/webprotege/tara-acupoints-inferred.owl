        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001545"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7406349"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001385"/>
        <tara:hasSynonym>S 39</tara:hasSynonym>
        <tara:hasSynonym>Stomach 39</tara:hasSynonym>
        <tara:hasSynonym>The Lower He-Sea Point of the Small Intestine</tara:hasSynonym>
        <tara:hasVasculatureDescription>The anterior tibial artery and anterior tibial vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 39</rdfs:label>
    </owl:Class>
    


