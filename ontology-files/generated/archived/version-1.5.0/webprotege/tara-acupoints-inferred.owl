        <rdfs:label>Lateral sural cutaneous nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797522 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797522">
