        <tara:hasSynonym>RN 21</tara:hasSynonym>
        <tara:hasSynonym>Ren 21</tara:hasSynonym>
        <tara:hasSynonym>VC 21</tara:hasSynonym>
        <tara:hasVasculatureDescription>See Zhongting (CV 16).</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>CV 21</rdfs:label>
    </owl:Class>
    


