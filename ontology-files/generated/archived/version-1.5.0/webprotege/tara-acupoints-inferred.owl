        <OboInOwl:hasExactSynonym>musculus</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>muscle</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>muscle element</OboInOwl:hasRelatedSynonym>
        <rdfs:label>muscle structure</rdfs:label>
    </owl:Class>
    


