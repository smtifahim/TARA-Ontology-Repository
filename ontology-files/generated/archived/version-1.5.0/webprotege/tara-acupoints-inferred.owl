        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001546"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4598552"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000979"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002446"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795305"/>
        <tara:hasSynonym>Spleen 8</tara:hasSynonym>
        <tara:hasVasculatureDescription>Anteriorly, the great saphenous vein and the branch of the genu suprema artery; deeper, the posterior tibial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <rdfs:label>SP 8</rdfs:label>
    </owl:Class>
    


