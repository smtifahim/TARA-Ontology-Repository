                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005409"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An organ of the digestive tract that is capable of retaining and storing food.</obo:IAO_0000115>
        <obo:IAO_0000232>This is a very broad functionally defined grouping class that collects disparate structures from insects to vertebrates</obo:IAO_0000232>
        <OboInOwl:hasDbXref>BSA:0000123</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>TADS:0000172</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>TGMA:0001041</OboInOwl:hasDbXref>
        <rdfs:label>food storage organ</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010163 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010163">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010165"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035639"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The eyebrow is an area of thick, delicate hairs above the eye that follows the shape of the lower margin of the brow ridges. Their main function is to protect the eye, but they are also important to human communication and facial expression. It is not uncommon for people to modify their eyebrows by means of hair addition or removal, make up, or piercings.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>FMA:54237</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MESH:D005138</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C32575</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:265781000</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C0015420</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Eyebrow</OboInOwl:hasDbXref>
        <OboInOwl:hasRelatedSynonym>supercilium</OboInOwl:hasRelatedSynonym>
        <rdfs:label>eyebrow</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/2/29/Eyes_chris.jpg</foaf:depiction>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010164">
