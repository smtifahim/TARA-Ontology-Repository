    <!-- http://purl.obolibrary.org/obo/UBERON_0001136 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000487"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012275"/>
