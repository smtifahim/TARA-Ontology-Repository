        <tara:hasIndicationsDescription>fullness and pain in the chest and the costal region, cough, asthma, mastitis.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>On the course of the branch of m. pectoralis major derived from the anterior thoracic nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior thoracic region, in the sec- ond intercostal space, 4 B-cun lateral to the anterior median line. Note: The second intercostal space is in- ferior to the second rib which is located at the same level as the sternal angle.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Wuyi</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001395"/>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001396"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003726"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794975"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002088"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_8600074"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004602"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795295"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795296"/>
        <tara:hasSynonym>S 15</tara:hasSynonym>
        <tara:hasSynonym>Stomach 1</tara:hasSynonym>
        <tara:hasVasculatureDescription>The thoracoacromial artery and vein and the branches of the lateral thoracic artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 15</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_4771986 -->

