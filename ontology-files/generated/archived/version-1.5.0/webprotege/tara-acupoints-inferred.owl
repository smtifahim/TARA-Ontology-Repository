        <tara:hasChineseLabel>申脈(脉)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002387"/>
        <tara:hasIndicationsDescription>epilepsy, mania, headache, dizziness, insomnia, backache, aching of the leg.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The sural nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lateral aspect of the foot, directly inferior to the prominence of the lateral malleolus, in the depression between the inferior border of the lateral malleolus and the calcaneus. Note: BL62 is located in the depression distal to the inferior border of the lateral malleolus. the corresponding medial acupuncture point to BL 62 is KI6.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Shenmai</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9493899"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001450"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012291"/>
        <tara:hasSynonym>B 62</tara:hasSynonym>
        <tara:hasSynonym>Bladder 62</tara:hasSynonym>
        <tara:hasSynonym>UB 62</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 62</tara:hasSynonym>
        <tara:hasVasculatureDescription>The external malleolar arterial network.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 62</rdfs:label>
    </owl:Class>
    


