        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 40. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>臂臑</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001460"/>
        <tara:hasIndicationsDescription>pain in the shoulder and arm, rigidity of the neck, scrofula.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The posterior brachial cutaneous nerve; deeper, the radial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lateral aspect of the arm, just anterior to the border of the deltoid muscle, 7 B-cun superior to LI11.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly or obliquely upward 0.8-1.5 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Binao</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001399"/>
        <tara:hasRelatedArtery rdf:resource="http://uri.interlex.org/base/ilx_0797496"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001492"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0795005"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006200"/>
        <tara:hasRelatedVein rdf:resource="http://uri.interlex.org/base/ilx_0797498"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001476"/>
        <tara:hasSynonym>CO 14</tara:hasSynonym>
        <tara:hasSynonym>Colon 14</tara:hasSynonym>
        <tara:hasSynonym>Large Intestine 14</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of posterior circumflex humeral artery and vein, the deep brachial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <rdfs:label>LI 14</rdfs:label>
    </owl:Class>
    


