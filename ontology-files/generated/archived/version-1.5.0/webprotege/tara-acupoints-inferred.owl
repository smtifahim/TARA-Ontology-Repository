        <tara:hasChineseLabel>僕(仆)參(参)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002387"/>
        <tara:hasIndicationsDescription>muscular atrophy and weakness of the lower extremities, pain in the heel.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The external calcaneal branch of the sural nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lateral aspect of the foot, distal to BL60, lateral to the calcaneus, at the border between the red and white flesh.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Pucan</tara:hasPinyinLabel>
        <tara:hasPinyinLabel>Pushen</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001450"/>
        <tara:hasSynonym>B 61</tara:hasSynonym>
        <tara:hasSynonym>Bladder 61</tara:hasSynonym>
        <tara:hasSynonym>UB 61</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 61</tara:hasSynonym>
        <tara:hasVasculatureDescription>The external calcaneal branches of the peroneal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 61</rdfs:label>
    </owl:Class>
    


