    <!-- http://purl.obolibrary.org/obo/UBERON_0003729 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0003729">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000344"/>
