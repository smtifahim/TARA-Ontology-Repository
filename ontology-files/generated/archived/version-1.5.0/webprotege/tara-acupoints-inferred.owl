        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>曲泉</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001465"/>
        <tara:hasIndicationsDescription>prolapse of the uterus, lower abdominal pain, retention of urine, nocturnal emission, pain in the external genitalia, pruritus vulvae, pain in the medial aspect of the knee and thigh.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The saphenous.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the medial aspect of the knee, in the depression medial to the tendons of the semitendinosus and the semimembranosus muscles, at the medial end of the popliteal crease. Note: With the knee flexed, LR8 is located in the depression medial to the most prominent tendon on the medial end of the popliteal crease.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Ququan</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001381"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_8480009"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795330"/>
        <tara:hasSynonym>LIV 8</tara:hasSynonym>
        <tara:hasSynonym>LV 8</tara:hasSynonym>
        <tara:hasSynonym>Liver 8</tara:hasSynonym>
        <tara:hasVasculatureDescription>Anteriorly, the great saphenous vein, on the pathway of the genu su prema artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5419503"/>
        <rdfs:label>LR 8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1092703 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1092703">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/isLocatedOnMeridian"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Conception Vessel (CV / Ren Mai), one of the eight extraordinary vessels, which consists of 24 standardized acupoints beginning at CV 1 (Huiyin) in the perineum at the midpoint of the perineal region, traveling up along the anterior midline of the body through the abdomen, chest, and neck, and ending at CV 24 (Chengjiang) on the face in the depression at the center of the mentolabial sulcus.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <tara:hasSynonym>Acupoint of the Ren channel</tara:hasSynonym>
        <tara:hasSynonym>Acupuncture point of the Ren channel</tara:hasSynonym>
        <tara:hasSynonym>CV</tara:hasSynonym>
        <tara:hasSynonym>RN</tara:hasSynonym>
        <tara:hasSynonym>Ren</tara:hasSynonym>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>Acupoint of the Conception Vessel</rdfs:label>
    </owl:Class>
    


