        <tara:hasSynonym>VG 25</tara:hasSynonym>
        <tara:hasVasculatureDescription>The lateral nasal branches of the facial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <rdfs:label>GV 25</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6927551 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6927551">
