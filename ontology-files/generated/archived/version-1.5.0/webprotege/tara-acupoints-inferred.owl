        <tara:hasChineseLabel>缺盆</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <tara:hasIndicationsDescription>cough, asthma, sore throat, pain in the supraclavicular fossa.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>Superficially, the intermediate supraclavicular nerve; deeper, the supraclavicular portion of brachial plexus.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior region of the neck, in the greater supraclavicular fossa, 4 B-cun lateral to the anterior median line, in the depression superior to the clavicle.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Avoid puncturing the artery. Puncture perpendicularly 0.3-0.5 inch.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Quepen</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012324"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001814"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797476"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001105"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795294"/>
        <tara:hasSynonym>S 12</tara:hasSynonym>
        <tara:hasSynonym>Stomach 12</tara:hasSynonym>
        <tara:hasVasculatureDescription>Superiorly, the transverse cervical artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 12</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2041266 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2041266">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4598552"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1317876"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4598552"/>
        <dc:description>The Xi-Cleft Point of the Yang Heel Vessel (an extra meridian). The Xi-Cleft Point is the site where the qi and blood of the meridian are deeply converged. The Xi-Cleft Point is used to treat acute disorders in the area supplied by its pertaining meridian and those of its pertaining zang or fu organ.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1317876"/>
        <rdfs:label>Xi-Cleft Point of the Yang Heel Vessel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2063814 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2063814">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Apoplexy, coma, epilepsy, high fever, acute tonsillitis, infantile convulsion, numbness of the finger tips.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the tips of the ten fingers, about 0.1 cun distal to the nails.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture 0.1-0.2 inch superficially, or prick to cause bleeding.</tara:hasMethodDescription>
        <tara:hasSynonym>EX-UE 11</tara:hasSynonym>
        <tara:hasSynonym>M-UE 49</tara:hasSynonym>
        <tara:hasSynonym>Shiwang</tara:hasSynonym>
        <rdfs:label>Shixuan</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2065487 -->

