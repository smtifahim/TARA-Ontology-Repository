        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>支正</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <tara:hasIndicationsDescription>neck rigidity, headache, dizziness, spasmodic pain in the elbow and fingers, febrile diseases, mania.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>Superficially, the branch of the medial antebrachial cutaneous nerve; deeper, on the radial side, the posterior interosseous nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posteromedial aspect of the forearm, between the medial border of the ulnar bone and the flexor carpi ulnaris muscle, 5 B-cun proximal to the dorsal wrist crease. Note: 1 B-cun distal to the midpoint of the line connecting SI5 with SI8.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Zhizheng</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://uri.interlex.org/base/ilx_0797510"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794953"/>
