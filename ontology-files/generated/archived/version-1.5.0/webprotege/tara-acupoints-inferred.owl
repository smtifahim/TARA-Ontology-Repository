        <tara:hasChineseLabel>承扶</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013691"/>
        <tara:hasIndicationsDescription>pain in the lower back and gluteal region, constipation, muscular atrophy, pain, numbness and motor impairment of the lower extremities.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The posterior femoral cutaneous nerve; deeper, the sciatic nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the buttock region, at the midpoint of the gluteal fold.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 1.0-1.5 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Chengfu</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0036014"/>
        <tara:hasSynonym>B 36</tara:hasSynonym>
