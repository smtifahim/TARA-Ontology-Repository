        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000165"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795290"/>
        <tara:hasSynonym>S 4</tara:hasSynonym>
        <tara:hasSynonym>Stomach 4</tara:hasSynonym>
        <tara:hasVasculatureDescription>The facial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 4</rdfs:label>
    </owl:Class>
    


