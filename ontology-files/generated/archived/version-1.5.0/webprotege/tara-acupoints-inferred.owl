        <tara:hasSynonym>VG 21</tara:hasSynonym>
        <tara:hasVasculatureDescription>The anastomotic network formed by the right and left superficial temporal arteries and veins.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <rdfs:label>GV 21</rdfs:label>
    </owl:Class>
    


