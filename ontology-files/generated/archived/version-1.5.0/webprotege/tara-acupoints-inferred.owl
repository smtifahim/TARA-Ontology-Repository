        <OboInOwl:hasExactSynonym>acromiothoracic artery</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>thoracoacromial artery</OboInOwl:hasExactSynonym>
        <rdfs:label>thoraco-acromial artery</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/4/4c/Axillary_branches.PNG</foaf:depiction>
