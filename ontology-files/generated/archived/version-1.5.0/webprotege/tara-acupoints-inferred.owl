            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002224"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The pair of anatomical structures comprised of a left lung and right lung.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>FMA:68877</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>lungs</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>lungs pair</OboInOwl:hasExactSynonym>
