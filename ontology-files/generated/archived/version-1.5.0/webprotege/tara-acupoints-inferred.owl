        <tara:hasChineseLabel>中庭</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <tara:hasIndicationsDescription>distension and fullness in the chest and intercostal region, hiccup, nausea, anorexia.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial branch of the anterior cutaneous branch of the sixth intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior thoracic region, at the midpoint of the xiphisternal junction, on the anterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
