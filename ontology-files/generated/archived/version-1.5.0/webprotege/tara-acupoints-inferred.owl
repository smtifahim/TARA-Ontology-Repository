        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_8600092"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1840369"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4105303"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6705086"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001404"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001427"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_7500078"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795334"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795335"/>
        <tara:hasSynonym>Influential Point of Vessels</tara:hasSynonym>
        <tara:hasSynonym>L 9</tara:hasSynonym>
        <tara:hasSynonym>Lung 9</tara:hasSynonym>
        <tara:hasVasculatureDescription>The radial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9964503"/>
        <rdfs:label>LU 9</rdfs:label>
    </owl:Class>
    


