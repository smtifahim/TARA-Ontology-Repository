    <!-- http://purl.obolibrary.org/obo/UBERON_0000945 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000945">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004921"/>
