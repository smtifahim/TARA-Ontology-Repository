        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 168. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>耳和髎(髎)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>migraine, tinnitus, lockjaw.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branch of the auriculotemporal nerve, on the course of the temporal branch of the facial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, posterior to the temple hairline, anterior to the auricular root, posterior to the superficial temporal artery.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Avoid puncturing the artery, puncture obliquely 0.1-0.3 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Erheliao</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001614"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004104"/>
        <tara:hasSynonym>SJ 22</tara:hasSynonym>
        <tara:hasSynonym>San Jiao 22</tara:hasSynonym>
