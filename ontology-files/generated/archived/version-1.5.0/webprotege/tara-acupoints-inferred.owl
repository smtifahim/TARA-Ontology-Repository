        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>聽(听,聴)會(会)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <tara:hasIndicationsDescription>deafness, tinnitus, toothache, motor impairment of the temporomandibular joint, mumps, deviation of the eye and mouth.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The great auricular nerve and facial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the face, in the depression between the intertragic notch and the condylar process of the mandible. Note: When the mouth is opened, GB2 is located in the depression anterior to the intertragic notch.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Tinghui</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004657"/>
