        <tara:hasChineseLabel>支溝(沟)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <tara:hasIndicationsDescription>tinnitus, deafness, pain in the hypochondriac region, vomiting, constipation, febrile diseases, aching and heavy sensation of the shoulder and back, sudden hoarseness of the voice.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the posterior aspect of the forearm, midpoint of the interosseous space between the radius and the ulna, 3 B-cun proximal to the dorsal wrist crease. Note: 1 B-cun proximal to TE5, between the radius and the ulna, at the same level as tE7.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Zhigou</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7315457"/>
