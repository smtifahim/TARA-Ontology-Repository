        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795333"/>
        <tara:hasSynonym>CO 7</tara:hasSynonym>
        <tara:hasSynonym>Colon 7</tara:hasSynonym>
        <tara:hasSynonym>Large Intestine 7</tara:hasSynonym>
        <tara:hasVasculatureDescription>The muscular branch of the radial artery, the cephalic vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <rdfs:label>LI 7</rdfs:label>
    </owl:Class>
    


