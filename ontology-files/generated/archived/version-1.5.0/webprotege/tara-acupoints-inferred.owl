        <tara:hasAbbreviation>ST</tara:hasAbbreviation>
        <tara:hasAssociatedOrgan rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000945"/>
        <tara:hasChineseLabel>足陽(阳)明胃經(经,経)</tara:hasChineseLabel>
        <tara:hasSynonym>ST</tara:hasSynonym>
        <tara:hasSynonym>Stomach Meridian of Foot-Yangming</tara:hasSynonym>
        <tara:hasSynonym>meridan of the stomach</tara:hasSynonym>
        <rdfs:label>Stomach Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_6269212 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6269212">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Nausea, vomiting, hiccup.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the midpoint of the proximal interphalangeal joint of the middle finger at dorsum aspect.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Moxibustion is applied with three moxa cones.</tara:hasMethodDescription>
        <tara:hasSynonym>EX-UE 4</tara:hasSynonym>
        <tara:hasSynonym>M-UE 16</tara:hasSynonym>
        <rdfs:label>Zhongkui</rdfs:label>
    </owl:Class>
    


