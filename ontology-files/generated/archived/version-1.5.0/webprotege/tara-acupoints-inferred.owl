        <tara:hasSynonym>M-LE 27</tara:hasSynonym>
        <rdfs:label>Heding</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3761087 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3761087">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/isLocatedOnMeridian"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4694897"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Pericardium Meridian of Hand-Jueyin (PC), which consists of 9 standardized acupoints beginning at PC 1 (Tianchi) on the anterior chest in the fourth intercostal space lateral to the nipple, traveling down the middle of the anterior aspect of the arm, and ending at PC 9 (Zhongchong) at the center of the tip of the middle finger.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <tara:hasSynonym>Acupoint of the pericardium meridian of hand-jueyin</tara:hasSynonym>
        <tara:hasSynonym>Acupuncture point of the pericardium meridian</tara:hasSynonym>
        <tara:hasSynonym>Acupuncture point of the pericardium meridian of hand-jueyin</tara:hasSynonym>
        <tara:hasSynonym>PC</tara:hasSynonym>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4694897"/>
        <rdfs:label>Acupoint of the Pericardium Meridian</rdfs:label>
    </owl:Class>
    


