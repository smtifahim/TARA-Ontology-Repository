            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Subdivision of skeleton consisting of all skeletal elements in an hindlimb zeugopod region. Typically consists of the tibia and the fibula.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>AAO:0000216</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VSAO:0005014</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>crural skeleton</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>crus skeleton</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>hindlimb zygopod skeleton</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>posterior zeugopodium skeleton</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>skeleton cruris</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>hind epipodium</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>hindlimb epipodium</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>mesomere 2 of pelvic appendage</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>posterior zeugopodium</OboInOwl:hasRelatedSynonym>
        <rdfs:label>hindlimb zeugopod skeleton</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010721 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010721">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001447"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015099"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0018102"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009879"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>There are three cuneiform bones in the human foot: the medial cuneiform the intermediate cuneiform also known as the middle the lateral cuneiform. They are located between the navicular bone and the first, second and third metatarsal bones and are medial to the cuboid bone[WP, unvetted, human specific].</obo:IAO_0000115>
        <OboInOwl:hasDbXref>AAO:0000914</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:24517</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C32416</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:182102002</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C1511560</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Cuneiform_(anatomy)</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>cuneiform bone</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>distal tarsal</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>distal tarsal bone</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>os cuneiform</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>os cuneiforme</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>cuneiform</OboInOwl:hasRelatedSynonym>
        <rdfs:label>distal tarsal bone</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/9/9e/Gray268.png</foaf:depiction>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010740 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010740">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001474"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002091"/>
