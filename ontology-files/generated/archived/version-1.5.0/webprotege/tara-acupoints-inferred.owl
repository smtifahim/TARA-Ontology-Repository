    <!-- http://purl.obolibrary.org/obo/UBERON_0001361 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001361">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001638"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003516"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001361"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002103"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002170"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001316"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>In the human body, the femoral vein is a blood vessel that accompanies the femoral artery in the femoral sheath. It begins at the adductor canal (also known as Hunter&apos;s canal) and is a continuation of the popliteal vein. It ends at the inferior margin of the inguinal ligament, where it becomes the external iliac vein. [WP,unvetted].</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001361"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001361"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma21185"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0735948"/>
