        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>陽(阳)池</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004452"/>
        <tara:hasIndicationsDescription>pain in the arm, shoulder and wrist, malaria, deafness, thirst.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The terminal branch of the posterior antebrachial cutaneous nerve and the dorsal branch of the ulnar nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posterior aspect of the wrist, in the depression ulnar to the extensor digitorum tendon, on the dorsal wrist crease. Note 1: TE4 can be palpated when moving proximally along the gap between the fifth and fourth metacarpal bones, at the same level as LI5 and SI5. Note 2: When the wrist is extended against resistance, the extensor digitorum tendon can be palpated more easily.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Yangchi</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1840369"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003648"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003649"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795333"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795502"/>
        <tara:hasSynonym>SJ 4</tara:hasSynonym>
        <tara:hasSynonym>San Jiao 4</tara:hasSynonym>
        <tara:hasSynonym>TB 4</tara:hasSynonym>
        <tara:hasSynonym>TH 4</tara:hasSynonym>
        <tara:hasSynonym>TW 4</tara:hasSynonym>
        <tara:hasSynonym>Triple Burner 4</tara:hasSynonym>
        <tara:hasSynonym>Triple Energizer 4</tara:hasSynonym>
        <tara:hasSynonym>Triple Heater 4</tara:hasSynonym>
        <tara:hasSynonym>Triple Warmer 4</tara:hasSynonym>
        <tara:hasVasculatureDescription>The dorsal venous network of the wrist and the posterior carpal artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <rdfs:label>TE 4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1628341 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1628341">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552"/>
