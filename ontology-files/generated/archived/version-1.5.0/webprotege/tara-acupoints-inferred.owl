        <tara:hasChineseLabel>素髎(髎)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <tara:hasIndicationsDescription>loss of consciousness, nasal obstruction, epistaxis, rhinorrhea, rosacea.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The external nasal branch of the anterior ethmoidal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the face, at the tip of the nose.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.2-0.3 inch, or prick to cause bleeding.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Suliao</tara:hasPinyinLabel>
