                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 64. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>足三里</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003823"/>
        <tara:hasIndicationsDescription>gastric pain, vomiting, hiccup, abdominal distension, borborygmus, diarrhea, dysentery, constipation, mastitis, enteritis, aching of the knee joint and leg, beriberi, edema, cough, asthma, emaciation due to general deficiency, indigestion, apoplexy, hemiplegia, dizziness, insomnia, mania.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>Superficially, the lateral sural cutaneous nerve and the cutaneous branch of the saphenous nerve; deeper, the deep peroneal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the anterior aspect of the leg, on the line connecting ST35 with ST41, 3 B-cun inferior to ST35. Note: ST36 is located on the tibialis anterior muscle.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.2 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Zusanli</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001537"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002475"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035207"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797521"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001545"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3815917"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001385"/>
        <tara:hasSynonym>S 36</tara:hasSynonym>
        <tara:hasSynonym>Stomach 36</tara:hasSynonym>
        <tara:hasVasculatureDescription>The anterior tibial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 36</rdfs:label>
    </owl:Class>
    


