            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004151"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A myogenic muscular circulatory organ found in the vertebrate cardiovascular system composed of chambers of cardiac muscle. It is the primary circulatory organ.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>AAO:0010210</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>BILA:0000020</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>BTO:0000562</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>CALOHA:TS-0445</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EFO:0000815</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EHDAA2:0000738</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EHDAA:420</OboInOwl:hasDbXref>
