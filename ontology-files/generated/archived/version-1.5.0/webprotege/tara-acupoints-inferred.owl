        <tara:hasChineseLabel>巨闕(阙)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795301"/>
        <tara:hasIndicationsDescription>pain in the cardiac region and the chest, nausea, acid regurgitation, difficulty in swallowing, vomiting, mental disorder, epilepsy, palpitation.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the upper abdomen, 6 B-cun superior to the centre of the umbilicus, on the anterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.8 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Juque</tara:hasPinyinLabel>
