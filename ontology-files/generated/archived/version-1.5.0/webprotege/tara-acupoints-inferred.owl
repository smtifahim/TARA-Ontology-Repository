        <OboInOwl:hasDbXref>galen:Clavicle</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>clavicle</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>clavicula</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>collar bone</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>collarbone</OboInOwl:hasExactSynonym>
