        <tara:hasSynonym>TW 13</tara:hasSynonym>
        <tara:hasSynonym>Triple Burner 13</tara:hasSynonym>
        <tara:hasSynonym>Triple Energizer 13</tara:hasSynonym>
        <tara:hasSynonym>Triple Heater 13</tara:hasSynonym>
        <tara:hasSynonym>Triple Warmer 13</tara:hasSynonym>
        <tara:hasVasculatureDescription>The median collateral artery and vein.</tara:hasVasculatureDescription>
