                        <owl:someValuesFrom rdf:resource="http://uri.interlex.org/base/ilx_0795305"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 139. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>復(复)溜</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003823"/>
        <tara:hasIndicationsDescription>edema, abdominal distension, diarrhea, borborygmus, muscular atrophy of the leg, night sweat, spontaneous sweating, febrile diseases without sweating.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial sural and medial crural cutaneous nerves; deeper, the tibial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posteromedial aspect of the leg, anterior to the calcaneal tendon, 2 B-cun superior to the prominence of the medial malleolus. Note: At the same level and posterior to KI8.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Fuliu</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7315457"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003701"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795305"/>
        <tara:hasSynonym>K 7</tara:hasSynonym>
        <tara:hasSynonym>KD 7</tara:hasSynonym>
        <tara:hasSynonym>KID 7</tara:hasSynonym>
        <tara:hasSynonym>Kidney 7</tara:hasSynonym>
        <tara:hasVasculatureDescription>Deeper, anteriorly, the posterior tibial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <rdfs:label>KI 7</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9907701 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9907701">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Lumbar Pain, thigh pain, paralysis of the lower extremities, irregular menstruation, dysmenorrhea.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>Below the spinous process of the fifth lumbar vertebra.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasSynonym>EX-B 8</tara:hasSynonym>
        <tara:hasSynonym>M-BW 25</tara:hasSynonym>
        <tara:hasSynonym>Shiqizhuixia</tara:hasSynonym>
        <rdfs:label>Shiqizhui</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9921528 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9921528">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1092703"/>
