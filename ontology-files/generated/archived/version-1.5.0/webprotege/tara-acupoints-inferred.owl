        <tara:hasChineseLabel>紫宮(宫)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <tara:hasIndicationsDescription>pain in the chest, asthma, cough.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anterior cutaneous branch of the second intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior thoracic region, at the same level as the second intercostal space, on the anterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Zigong</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
