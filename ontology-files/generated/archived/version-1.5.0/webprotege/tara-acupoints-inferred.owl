    <!-- http://purl.obolibrary.org/obo/UBERON_0002067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010314"/>
