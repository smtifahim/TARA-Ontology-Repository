    <!-- http://purl.obolibrary.org/obo/UBERON_0001130 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001130">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000075"/>
