        <tara:hasChineseLabel>急脈(脉)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008337"/>
        <tara:hasIndicationsDescription>lower abdominal pain, hernia, pain in the external genitalia.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The ilioinguinal nerve; deeper, in the inferior aspect, the anterior branch of the obturator nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the groin region, at the same level as the superior border of the pubic symphysis, and 2.5 B-cun lateral to the anterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Jimai</tara:hasPinyinLabel>
