        <tara:hasChineseLabel>四滿(满,満)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <tara:hasIndicationsDescription>abdominal pain and distension, diarrhea, nocturnal emission, irregular menstruation, dysmenorrhea, postpartum abdominal pain.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The eleventh intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lower abdomen, 2 B-cun inferior to the centre of the umbilicus, 0.5 B-cun lateral to the anterior median line.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Siman</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSynonym>K 14</tara:hasSynonym>
        <tara:hasSynonym>KD 14</tara:hasSynonym>
        <tara:hasSynonym>KID 14</tara:hasSynonym>
        <tara:hasSynonym>Kidney 14</tara:hasSynonym>
        <tara:hasVasculatureDescription>The muscular branches of the inferior epigastric artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <rdfs:label>KI 14</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7471145 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7471145">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Swelling of the tongue, vomiting, aphasia with stiffness of tongue.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the veins on both sides of the frenulum of the tongue, Jinjin is on the left, Yuye, on the right.</tara:hasLocationalDescription>
        <tara:hasSynonym>EX-HN 13</tara:hasSynonym>
        <tara:hasSynonym>M-HN 20b</tara:hasSynonym>
        <rdfs:label>Yuye</rdfs:label>
    </owl:Class>
    


