        <tara:hasInnervationDescription>The iliohypogastric nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lower abdomen, 3 B-cun inferior to the centre of umbilicus, medial to the anterior superior iliac spine. Note: GB 27 is 3 B-cun inferior to GB 26, at the same level as CV 4.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Wushu</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013708"/>
        <tara:hasSynonym>G 27</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 27</tara:hasSynonym>
        <tara:hasVasculatureDescription>The superficial and deep circumflex iliac arteries and veins.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 27</rdfs:label>
    </owl:Class>
    


