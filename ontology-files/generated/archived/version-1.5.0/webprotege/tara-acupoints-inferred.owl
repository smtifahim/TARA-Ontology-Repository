            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Malleolus is the name for the bony prominence on each side of the ankle.</obo:IAO_0000115>
        <OboInOwl:hasBroadSynonym>lateral malleolus</OboInOwl:hasBroadSynonym>
        <OboInOwl:hasDbXref>EMAPA:37893</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:35502</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:361795009</OboInOwl:hasDbXref>
