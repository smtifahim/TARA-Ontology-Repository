        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012197"/>
        <tara:hasRelatedVein rdf:resource="http://uri.interlex.org/base/ilx_0797505"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795298"/>
        <tara:hasSynonym>Spleen 18</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the lateral thoracic artery and vein, the thoracoepigastric artery and vein, the fourth intercostal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <rdfs:label>SP 18</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5660399 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5660399">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Redness, swelling and pain of the eyes, febrile disease, nebula.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>Fold the auricle, the point is at the apex of the auricle.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.1-0.2 inch or prick to cause bleeding.</tara:hasMethodDescription>
        <tara:hasSynonym>EX-HN 6</tara:hasSynonym>
        <tara:hasSynonym>M-HN 10</tara:hasSynonym>
        <rdfs:label>Erjian</rdfs:label>
    </owl:Class>
    


