            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Anatomical space that is an opening in a bone of the skull.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013685"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma53165"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0735289"/>
        <OboInOwl:hasDbXref>FMA:53165</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:276742007</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Foramina_of_the_skull</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>http://en.wikipedia.org/wiki/Foramina_of_the_skull</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>http://www.snomedbrowser.com/Codes/Details/276742007</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>foramen of skull</OboInOwl:hasExactSynonym>
        <OboInOwl:hasNarrowSynonym>cranial conduit</OboInOwl:hasNarrowSynonym>
        <OboInOwl:hasNarrowSynonym>cranial foramen</OboInOwl:hasNarrowSynonym>
        <OboInOwl:hasRelatedSynonym>foramina of the skull</OboInOwl:hasRelatedSynonym>
        <rdfs:label>foramen of skull</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0013686 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0013686">
