    <!-- http://purl.obolibrary.org/obo/UBERON_0010720 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010720">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011584"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
