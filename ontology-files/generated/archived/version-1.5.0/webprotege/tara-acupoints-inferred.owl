        <tara:hasSynonym>B 14</tara:hasSynonym>
        <tara:hasSynonym>Back-Shu Point of the Pericardium</tara:hasSynonym>
        <tara:hasSynonym>Bladder 14</tara:hasSynonym>
        <tara:hasSynonym>UB 14</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 14</tara:hasSynonym>
        <tara:hasVasculatureDescription>The medial cutaneous branches of the posterior branches of the intercostal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 14</rdfs:label>
    </owl:Class>
    


