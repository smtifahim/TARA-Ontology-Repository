        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795310"/>
        <rdfs:label>cubital fossa</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795311 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008785"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The posterior axillary fold, also known as the posterior armpit fold, refers to the inferior border of the posterior wall of axilla.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008785"/>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/posterior-axillary-fold-1536887776</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma322185"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795311"/>
        <rdfs:label>posterior axillary fold</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795312 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795312">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006800"/>
        <obo:IAO_0000115>A vertical line running along the posterior midline of the back, aligned with the spinous processes of the vertebrae.</obo:IAO_0000115>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/posterior-median-line-1536888480</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma20311"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <rdfs:label>posterior median line</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795313 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795313">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The first opening in the posterior sacrum, allowing passage of sacral nerves.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <base:ilx_0777130>https://www.elsevier.com/resources/anatomy/nervous-system/peripheral-nervous-system/posterior-root-of-first-sacral-nerve/17108</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma31769"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795313"/>
        <rdfs:label>first posterior sacral foramen</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795314 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795314">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The second opening in the posterior sacrum for sacral nerve passage.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <base:ilx_0777130>https://www.elsevier.com/resources/anatomy/nervous-system/peripheral-nervous-system/posterior-root-of-first-sacral-nerve/17108</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma31770"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795314"/>
        <rdfs:label>second posterior sacral foramen</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795315 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795315">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The third opening in the posterior sacrum for sacral nerve passage.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <base:ilx_0777130>https://www.elsevier.com/resources/anatomy/nervous-system/peripheral-nervous-system/posterior-root-of-first-sacral-nerve/17108</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma31771"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795315"/>
        <rdfs:label>third posterior sacral foramen</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795316 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795316">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The fourth opening in the posterior sacrum for sacral nerve passage.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <base:ilx_0777130>https://www.elsevier.com/resources/anatomy/nervous-system/peripheral-nervous-system/posterior-root-of-first-sacral-nerve/17108</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma31772"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795316"/>
        <rdfs:label>fourth posterior sacral foramen</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795317 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795317">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008784"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The biceps femoris tendon is the rounded tendon that attaches the muscle bellies of the long and short heads of the biceps femoris muscle to the head of the fibula.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008784"/>
        <base:ilx_0777130>https://www.elsevier.com/resources/anatomy/muscular-system/muscles-of-lower-limb/biceps-femoris-tendon/22415</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma45930"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795317"/>
        <rdfs:label>biceps femoris tendon</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795318 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001474"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001442"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The long bone in the hand that connects the fourth finger to the carpal bones of the wrist. The fourth metacarpal bone is shorter and smaller than the third. The base is small and quadrilateral.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001442"/>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/metacarpal-iv-121123560</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795318"/>
        <rdfs:label>fourth metacarpal bone</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795319 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795319">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001421"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008785"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The scapular region refers to the area on the posterior thoracic wall corresponding to the location of the scapula (shoulder blade). It encompasses the structures overlying and surrounding the scapula, including associated muscles such as the trapezius, deltoid, and rotator cuff muscles.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001421"/>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008785"/>
        <base:ilx_0777130>https://www.ncbi.nlm.nih.gov/books/NBK531475/#:~:text=The%20scapula%20forms%20the%20posterior,%2C%20teres%20minor%2C%20and%20infraspinatus.</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma25200"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795319"/>
        <rdfs:label>scapular region</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795321 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795321">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012198"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The anatomical space between the seventh and eighth ribs, containing intercostal muscles, vessels, and nerves.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
        <base:ilx_0777130>https://en.wikipedia.org/wiki/Intercostal_space</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma321204"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795321"/>
        <rdfs:label>seventh intercostal space</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795322 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795322">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006800"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Midclavicular line is an important vertical reference line on the anterior chest wall. It connects the midclavicular point (superiorly) with the middle of the inguinal ligament (inferiorly).</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/midclavicular-line-15368877400</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma20251"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795322"/>
        <rdfs:label>midclavicular line</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795323 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795323">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006800"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Posterior axillary line is an imaginary reference line which can be drawn on the posterior torso. It extends vertically downwards from the posterior axillary fold. The posterior axillary line runs in parallel to the midaxillary and anterior axillary lines.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/posterior-axillary-line-1536888360</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma20260"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795323"/>
        <rdfs:label>posterior axillary line</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795324 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795324">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008784"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Your iliotibial band is a strong, thick band of tissue that runs down the outside of your thigh. It extends all the way from the hip bone to the top of the shinbone.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008784"/>
        <base:ilx_0777130>https://en.wikipedia.org/wiki/Iliotibial_tract</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma51048"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795324"/>
        <rdfs:label>iliotibial band</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795325 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795325">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000978"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The tibialis anterior tendon is the tendon of the tibialis anterior muscle, located on the front of the lower leg. It passes along the ankle and inserts on the medial cuneiform and the first metatarsal. This tendon enables dorsiflexion and inversion of the foot. The tibialis anterior tendon (TAT) begins at the distal one-third of the tibia. It is the most medial tendon of the ankle and foot.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000978"/>
        <base:ilx_0777130>https://en.wikipedia.org/wiki/Tibialis_anterior_muscle</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma47050"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795325"/>
        <rdfs:label>tibialis anterior tendon</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795326 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795326">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006800"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The demarcation at the posterior margin of the scalp where hair growth begins, near the nape of the neck.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <base:ilx_0777130>https://www.ncbi.nlm.nih.gov/medgen/868215</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma285422"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795326"/>
        <rdfs:label>posterior hairline</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795327 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795327">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000093"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The mentolabial sulcus is the vertical groove or fold that forms between the lower lip and the chin, marking the transition between the lower lip and the mental region of the face.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/mentolabial-sulcus-1536888420</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma75019"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795327"/>
        <rdfs:label>mentolabial sulcus</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795328 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795328">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A small prominence on the posterior end of the greater horn of hyoid bone, serving as an attachment point for muscles and ligaments. Each tubercle of hyoid bone provides an attachment site for a lateral thyrohyoid ligament.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <base:ilx_0777130>https://en.wikipedia.org/wiki/Hyoid_bone</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795328"/>
        <rdfs:label>hyoid tubercle</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795329 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000916"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The inguinal crease refers to the skin fold or line that forms where the lower abdomen meets the thigh, often most noticeable when the hip is flexed. It marks the boundary between the abdominal and thigh regions.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000916"/>
        <base:ilx_0777130>https://www.sciencedirect.com/topics/medicine-and-dentistry/inguinal-region</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795329"/>
        <rdfs:label>inguinal crease</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795330 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795330">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000978"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>This is the visible skin fold or line at the back of the knee, formed when the knee is flexed. It is a superficial feature and serves as a landmark for the location of the popliteal fossa beneath.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000978"/>
        <base:ilx_0777130>https://en.wikipedia.org/wiki/Popliteal_fossa</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795330"/>
        <rdfs:label>popliteal crease</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795331 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004704"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>This is the depression on the skin surface of the neck between the sternal heads of the sternocleidomastoid muscles. This area is situated just above the manubrium of the sternum and is a visible landmark in the neck.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <base:ilx_0777130>https://en.wikipedia.org/wiki/Suprasternal_notch</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795331"/>
        <rdfs:label>suprasternal fossa</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795332 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795332">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0019243"/>
        <obo:IAO_0000115>The anterior skin fold of the elbow, marking the transition between the upper arm and forearm, overlying the cubital fossa.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795332"/>
        <rdfs:label>cubital crease</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795333 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0019243"/>
        <obo:IAO_0000115>The dorsal wrist crease is the skin fold that forms on the back (dorsal) side of the wrist, often visible when the hand is extended. It marks the junction between the forearm and the hand and is located near the proximal ends of the metacarpal bones.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795333"/>
        <rdfs:label>dorsal wrist crease</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795334 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0019243"/>
        <obo:IAO_0000115>The palmar wrist crease is the transverse skin fold that appears on the palm side of the wrist when the hand is flexed. It marks the boundary between the forearm and the palm and is located approximately at the level of the distal radius and ulna.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795334"/>
        <rdfs:label>palmar wrist crease</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795335 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <obo:IAO_0000115>The tendon of the muscle that abducts and extends the thumb, located in the posterior compartment of the forearm.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795335"/>
        <rdfs:label>abductor pollicis longus tendon</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795336 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <obo:IAO_0000115>The tendon of the muscle extending the proximal phalanx of the thumb, positioned laterally in the forearm.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795336"/>
        <rdfs:label>extensor pollicis brevis tendon</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795337 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <obo:IAO_0000115>The tendon of the muscle responsible for extending the thumb at the interphalangeal joint.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795337"/>
        <rdfs:label>extensor pollicis longus tendon</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795338 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <obo:IAO_0000115>The lateral supracondylar ridge (lateral supraepicondylar ridge or lateral supracondylar crest) is the sharp, prominent margin located along the lateral aspect of the distal end of the body of the humerus. It is the less curved of the two supracondylar ridges of the humerus, the other being the medial supracondylar ridge.</obo:IAO_0000115>
        <base:ilx_0777130>https://www.elsevier.com/resources/anatomy/skeletal-system/appendicular-skeleton/lateral-supracondylar-ridge/18104</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma75078"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795338"/>
        <rdfs:label>lateral supraepicondylar ridge</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795339 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000102"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://uri.interlex.org/base/ilx_0794975"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795500 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <obo:IAO_0000115>The tendon of the muscle that flexes and abducts the wrist, located in the anterior forearm.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma38582"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795500"/>
        <rdfs:label>tendon of flexor carpi radialis</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795501 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <obo:IAO_0000115>The tendon of the muscle that flexes and adducts the hand at the wrist.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma38606"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795501"/>
        <rdfs:label>Tendon of flexor carpi ulnaris</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795502 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <obo:IAO_0000115>The tendon of the muscle that extends the fingers and assists in wrist extension, located on the posterior forearm.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma40734"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795502"/>
        <rdfs:label>tendon of extensor digitorum</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795503 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795503">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <obo:IAO_0000115>The tendon of the muscle extending the big toe and assisting in dorsiflexion of the foot.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma47065"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795503"/>
        <rdfs:label>tendon of extensor hallucis longus</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795504 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000043"/>
        <obo:IAO_0000115>The tendon of the muscle that extends the lateral four toes and dorsiflexes the foot.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma47080"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795504"/>
        <rdfs:label>tendon of extensor digitorum longus</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797391 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797391">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001021"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001492"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The superficial branch of the radial nerve passes along the front of the radial side of the forearm to the commencement of its lower third. It is a sensory nerve.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001492"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797391"/>
        <rdfs:label>superficial branch of radial nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797451 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797451">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003726"/>
        <obo:IAO_0000115>The anterior division (rami anteriores; ventral divisions) of the twelfth thoracic spinal nerve. It emerges below the twelfth</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797451"/>
        <rdfs:label>subcostal nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797461 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797461">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001492"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sensory branch of the superficial radial nerve supplying the dorsal aspect of the lateral digits of the hand.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001492"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797461"/>
        <OboInOwl:hasExactSynonym>Dorsal digital branch of radial nerve</OboInOwl:hasExactSynonym>
        <rdfs:label>dorsal digital nerve of radial nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797474 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797474">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The supraclavicular nerve is a cutaneous (sensory) nerve of the cervical plexus that arises from the third and fourth cervical (spinal) nerves. It emerges from beneath the posterior border of the sternocleidomastoid muscle, then split into multiple branches. Together, these innervate the skin over the shoulder.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma65414"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797474"/>
        <OboInOwl:hasExactSynonym>cutaneous branches of the cervical plexus</OboInOwl:hasExactSynonym>
        <rdfs:label>Supraclavicular nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797475 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797475">
        <rdfs:subClassOf rdf:resource="http://uri.interlex.org/base/ilx_0797474"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A terminal cutaneous branch of the supraclavicular nerves (C3-C4) that supplies sensation to the skin over the acromion, upper deltoid region, and posterior shoulder.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma78654"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797475"/>
        <OboInOwl:hasExactSynonym>Posterior supraclavicular nerve</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>Supra-acromial nerve</OboInOwl:hasExactSynonym>
        <rdfs:label>Lateral supraclavicular nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797476 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797476">
        <rdfs:subClassOf rdf:resource="http://uri.interlex.org/base/ilx_0797474"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cutaneous branch of the cervical plexus that descends across the clavicle to supply the skin over the upper pectoral and deltoid regions.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma78651"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797476"/>
        <OboInOwl:hasExactSynonym>Middle supraclavicular nerve</OboInOwl:hasExactSynonym>
        <rdfs:label>Intermediate supraclavicular nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797477 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001492"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sensory branch of the radial nerve that innervates the skin of the posterior forearm.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001492"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma39145"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797477"/>
        <OboInOwl:hasExactSynonym>Posterior cutaneous nerve of forearm</OboInOwl:hasExactSynonym>
        <rdfs:label>Posterior antebrachial cutaneous nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797478 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797478">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A branch of the cervical plexus (primarily C2) that supplies sensation to the scalp posterior and superior to the ear.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma6871"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797478"/>
        <OboInOwl:hasExactSynonym>Small occipital nerve</OboInOwl:hasExactSynonym>
        <rdfs:label>Lesser occipital nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797479 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001021"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001647"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A branch of the facial nerve that innervates muscles of facial expression in the zygomatic and orbital regions.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001647"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797479"/>
        <OboInOwl:hasExactSynonym>Malar branch of facial nerve</OboInOwl:hasExactSynonym>
        <rdfs:label>Zygomatic branch of the facial nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797480 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797480">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A superficial branch of the cervical plexus (C2-C3) providing sensory innervation to the skin of the anterior neck.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma6873"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797480"/>
        <OboInOwl:hasExactSynonym>Cervical cutaneous nerve</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>Transverse cutaneous nerve of neck</OboInOwl:hasExactSynonym>
        <rdfs:label>Transverse cervical nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797481 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797481">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001267"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cutaneous branch of the femoral nerve supplying sensation to the anterior and medial thigh.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001267"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma45250"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797481"/>
        <OboInOwl:hasExactSynonym>Anterior femoral cutaneous nerve</OboInOwl:hasExactSynonym>
        <rdfs:label>Anterior cutaneous branch of femoral nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797482 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797482">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001021"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035526"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A terminal branch of the superficial fibular nerve supplying the medial dorsum of the foot and adjacent toes.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035526"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797482"/>
        <OboInOwl:hasExactSynonym>Medial dorsal cutaneous nerve</OboInOwl:hasExactSynonym>
        <rdfs:label>Medial dorsal cutaneous nerve of foot</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797483 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797483">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003435"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001466"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A digital sensory nerve supplying the dorsal surface of one or more toes. These nerves arise primarily from the superficial fibular, deep fibular, or sural nerves.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001466"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797483"/>
        <OboInOwl:hasExactSynonym>Dorsal digital nerve of pes</OboInOwl:hasExactSynonym>
        <rdfs:label>Dorsal digital nerve of foot</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797484 -->

