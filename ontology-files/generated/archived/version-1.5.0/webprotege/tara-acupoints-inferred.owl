        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>居髎(髎)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013691"/>
        <tara:hasIndicationsDescription>pain and numbness in the thigh and lumbar region, paralysis, muscular atrophy of the lower limbs.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The lateral femoral cutaneous nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the buttock region, midpoint of the line connecting the anterior superior iliac spine and the prominence of the greater trochanter.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Juliao</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002503"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013708"/>
        <tara:hasSynonym>G 29</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 29</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the superficial circumflex iliac artery and vein, the ascending branches of the lateral circumflex femoral artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 29</rdfs:label>
    </owl:Class>
    


