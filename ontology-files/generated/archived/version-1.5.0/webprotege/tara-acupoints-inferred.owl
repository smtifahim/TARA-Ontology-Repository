        <tara:hasVasculatureDescription>The branches of the occipital artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 19</rdfs:label>
    </owl:Class>
    


