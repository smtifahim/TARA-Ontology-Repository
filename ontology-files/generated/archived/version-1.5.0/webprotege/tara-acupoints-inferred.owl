        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>兌(兑)端</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <tara:hasIndicationsDescription>mental disorder, lip twitching, lip stiffness, pain and swelling of the gums.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The buccal branch of the facial nerve, and the branch of the infraorbital nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the face, at the midpoint of the tubercle of the upper lip.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely upward 0.2-0.3 inch.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Duiduan</tara:hasPinyinLabel>
