        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795301"/>
        <rdfs:label>upper abdomen</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795302 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795302">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000916"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The infrasternal angle (subcostal angle) is formed in front of thoracic cage by the cartilages of the tenth, ninth, eighth, and seventh ribs, which ascend on either side, where the apex of which the xiphoid process projects.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000916"/>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/infrasternal-angle-1537019816</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma7573"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795302"/>
        <rdfs:label>infrasternal angle</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795303 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795303">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000916"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The inferior portion of the abdomen, located below the umbilicus and above the pelvic region.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000916"/>
        <base:ilx_0777130>https://www.britannica.com/science/abdominal-cavity</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma20365"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <rdfs:label>lower abdomen</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795304 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795304">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001630"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008784"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The rectus femoris is a muscle in the anterior compartment of the thigh. It forms part of the quadriceps femoris muscle complex, and is the only muscle in this group to cross both the hip joint and the knee joints.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008784"/>
        <base:ilx_0777130>https://en.wikipedia.org/wiki/Rectus_femoris_muscle</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795304"/>
        <rdfs:label>rectus femoris muscle</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795305 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008784"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A prominent bony projection on the medial aspect of the distal tibia, forming part of the ankle joint.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008784"/>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/medial-malleolus-1537020872</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma35451"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795305"/>
        <rdfs:label>medial malleolus</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795306 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001062"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The area of the thorax on the lateral body wall, containing portions of the serratus anterior and intercostal muscles.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/lateral-region-of-thorax-1536888820</base:ilx_0777130>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma61533"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0795306"/>
        <rdfs:label>lateral thoracic region</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795307 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795307">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012198"/>
