        <OboInOwl:hasDbXref>AEO:0000114</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EHDAA2:0003114</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FBbt:00007474</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>epithelial or endothelial tube</OboInOwl:hasExactSynonym>
        <rdfs:label>epithelial tube</rdfs:label>
    </owl:Class>
    


