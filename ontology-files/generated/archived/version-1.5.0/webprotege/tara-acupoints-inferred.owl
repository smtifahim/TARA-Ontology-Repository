        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 221. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>關(关,関)元</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <tara:hasIndicationsDescription>enuresis, nocturnal emission, frequency of urination, retention of urine, hernia, irregular menstruation, morbid leukorrhea, dysmenorrhea, uterine bleeding, postpartum hemorrhage, lower abdominal pain, indigestion, diarrhea, prolapse of the rectum, flaccid type of apoplexy.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial branch of the anterior cutaneous branch of the twelfth intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lower abdomen, 3 B-cun inferior to the centre of the umbilicus, on the anterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. This is one of the important points for tonification. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Guanyuan</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3092014"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSynonym>Conception Vessel 4</tara:hasSynonym>
        <tara:hasSynonym>Front-Mu Point of the Small Intestine</tara:hasSynonym>
        <tara:hasSynonym>RN 4</tara:hasSynonym>
        <tara:hasSynonym>Ren 4</tara:hasSynonym>
        <tara:hasSynonym>VC 4</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of superficial epigastric artery and vein, and the branches of inferior epigastric artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>CV 4</rdfs:label>
    </owl:Class>
    


