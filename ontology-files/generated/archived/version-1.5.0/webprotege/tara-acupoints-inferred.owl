        <tara:hasSynonym>K 1</tara:hasSynonym>
        <tara:hasSynonym>KD 1</tara:hasSynonym>
        <tara:hasSynonym>KID 1</tara:hasSynonym>
        <tara:hasSynonym>Kidney 1</tara:hasSynonym>
        <tara:hasVasculatureDescription>Deeper, the plantar arterial arch.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <rdfs:label>KI 1</rdfs:label>
    </owl:Class>
    


