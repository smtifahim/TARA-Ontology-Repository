        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004561"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004300"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011277"/>
        <tara:hasSynonym>H 9</tara:hasSynonym>
        <tara:hasSynonym>HE 9</tara:hasSynonym>
        <tara:hasSynonym>Heart 9</tara:hasSynonym>
        <tara:hasVasculatureDescription>The arterial and venous network formed by the palmar digital proprial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009"/>
        <rdfs:label>HT 9</rdfs:label>
    </owl:Class>
    


