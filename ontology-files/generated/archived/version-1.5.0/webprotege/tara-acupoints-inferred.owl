        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSynonym>B 42</tara:hasSynonym>
        <tara:hasSynonym>Bladder 42</tara:hasSynonym>
        <tara:hasSynonym>UB 42</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 42</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior branch of the intercostal artery, the descending branch of the transverse cervical artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 42</rdfs:label>
    </owl:Class>
    


