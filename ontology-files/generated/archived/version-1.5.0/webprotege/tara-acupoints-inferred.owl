        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006810"/>
        <tara:hasSynonym>SJ 11</tara:hasSynonym>
        <tara:hasSynonym>San Jiao 11</tara:hasSynonym>
        <tara:hasSynonym>TB 11</tara:hasSynonym>
        <tara:hasSynonym>TH 11</tara:hasSynonym>
        <tara:hasSynonym>TW 11</tara:hasSynonym>
        <tara:hasSynonym>Triple Burner 11</tara:hasSynonym>
        <tara:hasSynonym>Triple Energizer 11</tara:hasSynonym>
        <tara:hasSynonym>Triple Heater 11</tara:hasSynonym>
        <tara:hasSynonym>Triple Warmer 11</tara:hasSynonym>
        <tara:hasVasculatureDescription>The terminal branches of the median collateral artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <rdfs:label>TE 11</rdfs:label>
    </owl:Class>
    


