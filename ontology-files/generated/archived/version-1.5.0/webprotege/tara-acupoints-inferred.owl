        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>命門(门)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005462"/>
        <tara:hasIndicationsDescription>stiffness of the back, lumbago, impotence, nocturnal emission, irregular menstruation, diarrhea, indigestion, leukorrhea.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>In the lumbar region, in the depression inferior to the spinous process of the second lumbar vertebra (L2), on the posterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Mingmen</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004618"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSynonym>Du 4</tara:hasSynonym>
        <tara:hasSynonym>Governor Vessel 4</tara:hasSynonym>
        <tara:hasSynonym>Mingmen</tara:hasSynonym>
        <tara:hasSynonym>VG 4</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior branch of the lumbar artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <rdfs:label>GV 4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_8574156 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_8574156">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Paralysis, spasm and contracture of the upper extremities, pain of the forearm.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the lateral aspect of the forearm, midway between the transverse wrist crease and elbow crease, between the radius and the ulna.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 1.0-1.2 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasSynonym>M-UE 30</tara:hasSynonym>
        <rdfs:label>Bizhong</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_8607646 -->

