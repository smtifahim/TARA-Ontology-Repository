        <tara:hasChineseLabel>附分</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <tara:hasIndicationsDescription>stiffness and pain of the shoulder, back and neck, numbness of the elbow and arm.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The lateral branches of the posterior rami of the first and second thoracic nerves; deeper, the dorsal scapular nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the upper back region, at the same level as the inferior border of the spinous process of the second thoracic vertebra (T2), 3 B-cun lateral to the posterior median line. Note: BL41 and BL12 are located at the same level as the inferior border of the spinous process of the second thoracic vertebra (T2).</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Fufen</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004627"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSynonym>B 41</tara:hasSynonym>
        <tara:hasSynonym>Bladder 41</tara:hasSynonym>
        <tara:hasSynonym>UB 41</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 41</tara:hasSynonym>
        <tara:hasVasculatureDescription>The descending branch of the transverse cervical artery, the posterior branches of the intercostal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 41</rdfs:label>
    </owl:Class>
    


