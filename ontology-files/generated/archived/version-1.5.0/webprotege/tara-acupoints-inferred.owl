        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>兪(俞)府</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <tara:hasIndicationsDescription>cough, asthma, chest pain.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial supraclavicular nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior thoracic region, just inferior to the clavicle, 2 B-cun lateral to the anterior median line.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Shufu</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001105"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSynonym>K 27</tara:hasSynonym>
        <tara:hasSynonym>KD 27</tara:hasSynonym>
        <tara:hasSynonym>KID 27</tara:hasSynonym>
        <tara:hasSynonym>Kidney 27</tara:hasSynonym>
        <tara:hasVasculatureDescription>The anterior perforating branches of the internal mammary artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <rdfs:label>KI 27</rdfs:label>
    </owl:Class>
    


