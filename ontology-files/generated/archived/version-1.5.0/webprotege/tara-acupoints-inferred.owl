        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>勞(劳,労)宮(宫)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002398"/>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008878"/>
        <tara:hasIndicationsDescription>cardiac pain, mental disorder, epilepsy, gastritis, foul breath, fungus infection of the hand and foot, vomiting, nausea.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The second common palmar digital nerve of the median nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the palm of the hand, in the depression between the second and third metacarpal bones, proximal to the metacarpophalangeal joints. Remarks: Alternative location for PC8 - On the palm of the hand, in the depression, between the third and fourth metacarpal bones, proximal to the metacarpophalangeal joints.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Laogong</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9857829"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003646"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003647"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003648"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003695"/>
        <tara:hasSynonym>P 8</tara:hasSynonym>
        <tara:hasSynonym>Pericardium 8</tara:hasSynonym>
        <tara:hasVasculatureDescription>The Common palmar digital artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4694897"/>
        <rdfs:label>PC 8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5220479 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5220479">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0926802"/>
        <rdfs:subClassOf>
