        <tara:hasSynonym>Ren 24</tara:hasSynonym>
        <tara:hasSynonym>VC 24</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the inferior labial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>CV 24</rdfs:label>
    </owl:Class>
    


