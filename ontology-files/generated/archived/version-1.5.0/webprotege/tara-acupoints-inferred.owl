        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006356"/>
        <obo:IAO_0000115>The superficial epigastric vein is a vein which travels with the superficial epigastric artery. It joins the accessory saphenous vein near the fossa ovalis.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>FMA:44318</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:286971006</OboInOwl:hasDbXref>
