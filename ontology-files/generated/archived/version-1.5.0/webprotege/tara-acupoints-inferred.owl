                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cutaneous branch of the cervical plexus that supplies sensation to the skin over the sternoclavicular region and upper chest near the midline.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003725"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma0329233"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797523"/>
        <OboInOwl:hasExactSynonym>Anterior supraclavicular nerve</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>Medial branch of supraclavicular nerve</OboInOwl:hasExactSynonym>
        <rdfs:label>Medial supraclavicular nerve</rdfs:label>
    </owl:Class>
    


