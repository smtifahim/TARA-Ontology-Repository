        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>偏歷(历)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <tara:hasIndicationsDescription>redness of the eye, tinnitus, deafness, epistaxis, aching of the hand and arm, sore throat, edema.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>On the radial side, the lateral antebrachial cutaneous nerve and the superficial ramus of the radial nerve; on the ulnar side, the posterior antebrachial cutaneous nerve and the posterior antebrachial interosseous nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posterolateral aspect of the forearm, on the line connecting LI5 with LI11, 3 B- cun superior to the dorsal wrist crease. Note: LI6 is located at the junction of the upper three fourths and the lower one fourth of the line connecting LI5 with LI11.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly or obliquely 0.5-0.8 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Pianli</tara:hasPinyinLabel>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794951"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794967"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797391"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797477"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001106"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6993030"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795333"/>
        <tara:hasSynonym>CO 6</tara:hasSynonym>
        <tara:hasSynonym>Colon 6</tara:hasSynonym>
        <tara:hasSynonym>Large Intestine 6</tara:hasSynonym>
        <tara:hasVasculatureDescription>The cephalic vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <rdfs:label>LI 6</rdfs:label>
    </owl:Class>
    


