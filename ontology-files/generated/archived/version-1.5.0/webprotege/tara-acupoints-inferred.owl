        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 173. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>上關(关,関)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>headache, deafness, tinnitus, diplacusis, deviation of the eye and mouth, toothache.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The zygomatic branch of the facial nerve and the zygomaticofacial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, in the depression superior to the midpoint of the zygomatic arch Note: In the depression superior to the zygomatic arch, superior to St7.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Deep puncture is not advisable. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Shangguan</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002500"/>
        <tara:hasSynonym>G 3</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 3</tara:hasSynonym>
        <tara:hasVasculatureDescription>The zygomaticoorbital artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 3</rdfs:label>
    </owl:Class>
    


