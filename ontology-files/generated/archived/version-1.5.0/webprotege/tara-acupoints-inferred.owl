        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 54. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>(乳)中</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <tara:hasInnervationDescription>The anterior and lateral cutaneous branch of the fourth intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior thoracic region, at the centre of the nipple. Note: In males, the centre of the nipple is located in the fourth intercostal space.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Ruzhong</tara:hasPinyinLabel>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0784694"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002030"/>
        <tara:hasSynonym>S 17</tara:hasSynonym>
        <tara:hasSynonym>Stomach 17</tara:hasSynonym>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 17</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9474009 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6200120"/>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <tara:hasAbbreviation>HT</tara:hasAbbreviation>
        <tara:hasAssociatedOrgan rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000948"/>
        <tara:hasChineseLabel>手少陰(阴)心經(经,経)</tara:hasChineseLabel>
        <tara:hasSynonym>HT</tara:hasSynonym>
        <tara:hasSynonym>Heart Meridian of Hand-Shaoyin</tara:hasSynonym>
        <tara:hasSynonym>meridian of the heart</tara:hasSynonym>
        <rdfs:label>Heart Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9492402 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9492402">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Pain in the shoulder and arm, paralysis of the upper extremities.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>Midway between the end of the anterior axillary fold and Jianyu (LI 15).</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasSynonym>Jianneiling</tara:hasSynonym>
        <tara:hasSynonym>M-UE 48</tara:hasSynonym>
        <rdfs:label>Jianqian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9493899 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9493899">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4943316"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3091322"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4943316"/>
        <dc:description>Confluent Points refer to the eight points on the limbs where the main meridians communicate with the eight extra meridians. They are Neiguan (PC 6). Gongsun (SP 4), Houxi (SJ 3), Shenmai (BL 62). Waiguan (TE 5), Zulinqi (GB 41 ), Lieque (LU 7) and Zhaohai (KI 6), which are respectively connected with the Yin Link Vessel. Thoroughfare Vessel, governor Vessel, Yang Heel Vessel. Yang Link Vessel, Belt Vessel, Conception Vessel and Yin Heel Vessel. The Eight Confluent Points are used to treat a variety of disorders of the corresponding eight extra meridians.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3091322"/>
        <rdfs:label>Confluent Point</rdfs:label>
    </owl:Class>
    


