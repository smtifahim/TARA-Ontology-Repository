        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795292"/>
        <tara:hasSynonym>G 16</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 16</tara:hasSynonym>
        <tara:hasVasculatureDescription>The frontal branches of the superficial temporal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 16</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1338884 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1338884">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Pain in the face, deviation of the eyes and mouth, spasm of facial muscle.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>1 cun lateral to Chengjiang (CV 24).</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely 0.5-1.0 inch..</tara:hasMethodDescription>
        <tara:hasSynonym>M-HN 18</tara:hasSynonym>
        <rdfs:label>Jiachengjiang</rdfs:label>
    </owl:Class>
    


