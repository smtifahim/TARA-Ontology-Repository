        <obo:IAO_0000115>A proximal mesopodial endochondral element that is composed primarily of a bone tissue.</obo:IAO_0000115>
        <rdfs:label>proximal mesopodial bone</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0014437 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0014437">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005913"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001273"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Is part of the pelvis on the edge of the wing of the ilium. Round in shape, dorsal to the pubis and ischium. Acts as structrure that muscles can attach too.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>EMAPA:37602</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:16914</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0003053</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C103818</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:182034009</OboInOwl:hasDbXref>
        <rdfs:label>iliac crest</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0014477 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0014477">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010912"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000915"/>
            </owl:Restriction>
        </rdfs:subClassOf>
