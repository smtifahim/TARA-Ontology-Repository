        <tara:hasSynonym>SJ 16</tara:hasSynonym>
        <tara:hasSynonym>San Jiao 16</tara:hasSynonym>
        <tara:hasSynonym>TB 16</tara:hasSynonym>
        <tara:hasSynonym>TH 16</tara:hasSynonym>
        <tara:hasSynonym>TW 16</tara:hasSynonym>
        <tara:hasSynonym>Triple Burner 16</tara:hasSynonym>
        <tara:hasSynonym>Triple Energizer 16</tara:hasSynonym>
        <tara:hasSynonym>Triple Heater 16</tara:hasSynonym>
        <tara:hasSynonym>Triple Warmer 16</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior auricular artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <rdfs:label>TE 16</rdfs:label>
    </owl:Class>
    


