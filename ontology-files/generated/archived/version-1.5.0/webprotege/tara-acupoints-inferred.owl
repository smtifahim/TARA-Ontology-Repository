        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 114. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>中膂兪(俞)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005473"/>
        <tara:hasIndicationsDescription>dysentery, hernia, stiffness and pain of the lower back.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The lateral branches of the posterior rami of the third and fourth sacral nerves.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the sacral region, at the same level as the third posterior sacral foramen, 1.5 B-cun lateral to the median sacral crest. Note: At the same level as BL33.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Zhonglushu</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0741680"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795315"/>
        <tara:hasSynonym>B 29</tara:hasSynonym>
        <tara:hasSynonym>Bladder 29</tara:hasSynonym>
        <tara:hasSynonym>UB 29</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 29</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior branches of the lateral sacral artery and vein, the branches of the inferior gluteal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 29</rdfs:label>
    </owl:Class>
    


