        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795305"/>
        <tara:hasSynonym>LIV 6</tara:hasSynonym>
        <tara:hasSynonym>LV 6</tara:hasSynonym>
        <tara:hasSynonym>Liver 6</tara:hasSynonym>
        <tara:hasVasculatureDescription>The great saphenous vem.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5419503"/>
        <rdfs:label>LR 6</rdfs:label>
    </owl:Class>
    


