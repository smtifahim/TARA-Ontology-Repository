        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 67. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>衝(冲)陽(阳)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002387"/>
        <tara:hasIndicationsDescription>pain of the upper teeth, redness and swelling of the dorsum of the foot, facial paralysis, muscular atrophy and motor impairment of the foot.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>Superficially, the medial dorsal cutaneous nerve of foot derived from the superficial peroneal nerve; deeper, the deep peroneal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the dorsum of the foot, at the joint of the base of the second metatarsal bone and the intermediate cuneiform bone, over the dorsalis pedis artery.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Avoid puncturing the artery.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Chongyang</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001539"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035207"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797482"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008783"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1840369"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001453"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001539"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003651"/>
        <tara:hasSynonym>S 42</tara:hasSynonym>
        <tara:hasSynonym>Stomach 42</tara:hasSynonym>
        <tara:hasVasculatureDescription>The dorsal artery and vein of foot, the dorsal venous network of foot.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 42</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7218725 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7218725">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552"/>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasGeneralSurfaceLocation"/>
                <owl:someValuesFrom>
