        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001463"/>
        <tara:hasIndicationsDescription>sore throat, cough, asthma, epistaxis, fever, loss of consciousness, mania, spasmodic pain of the thumb.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The terminal nerve network formed by the mixed branches of the lateral antebrachial cutaneous nerve and the superficial ramus of the radial nerve as well as the palmar digital proprial nerve of the median nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the thumb, radial to the distal phalanx, 0.1 f-cun proximal-lateral to the radial corner of the thumb nail, at the intersection of the vertical line of the radial border and the horizontal line of the base of the thumb nail.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture 0.1 inch, or prick the point to cause bleeding.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Shaoshang</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006137"/>
