        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 118. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>(浮)郄</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001465"/>
        <tara:hasIndicationsDescription>numbness of the gluteal and femoral regions, contracture of the tendons in the popliteal fossa.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The posterior femoral cutaneous nerve and the common peroneal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posterior aspect of the knee, just medial to the biceps femoris tendon, 1 B-cun proximal to the popliteal crease. Note: With the knee in slight flexion, BL38 is located medial to the biceps femoris ten- don, 1 B-cun proximal to BL39.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Fuxi</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001374"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795317"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795330"/>
        <tara:hasSynonym>B 38</tara:hasSynonym>
        <tara:hasSynonym>Bladder 38</tara:hasSynonym>
        <tara:hasSynonym>UB 38</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 38</tara:hasSynonym>
        <tara:hasVasculatureDescription>The superolateral genicular artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 38</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3361879 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3361879">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5361067"/>
