                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecificSurfaceLocation"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://uri.interlex.org/base/ilx_0795297"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 228. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>玉堂</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <tara:hasIndicationsDescription>pain in the chest, cough, asthma, vomiting.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anterior cutaneous branch of the third intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior thoracic region, at the same level as the third intercostal space, on the anterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Yutang</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795297"/>
        <tara:hasSynonym>Conception Vessel 18</tara:hasSynonym>
        <tara:hasSynonym>RN 18</tara:hasSynonym>
        <tara:hasSynonym>Ren 18</tara:hasSynonym>
        <tara:hasSynonym>VC 18</tara:hasSynonym>
        <tara:hasVasculatureDescription>The anterior perforating branches of the internal mammary artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>CV 18</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7819406 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7819406">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_6993030"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6035619"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6993030"/>
        <dc:description>The Major Luo-Connecting Point is a Luo-Connecting point. Each of twelve main meridians has, on the limbs, a Luo-Connecting Point to link its exteriorly-interiorly related meridian. Each of the Governor and Conception vessels, and the Major Collateral of the spleen has its Luo-Connecting Point on the trunk. A Luo-Connecting Point is used to treat disorders involving the two exteriorly-interiorly related meridians and those in the area supplied by the two meridians.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6035619"/>
        <rdfs:label>Major Luo-Connecting Point</rdfs:label>
    </owl:Class>
    


