        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 231. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>廉泉</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <tara:hasIndicationsDescription>swelling and pain of the subglossal region, salivation with glossoplegia, aphasia with stiffness of tongue by apoplexy, sudden hoarseness of the voice, difficulty in swallowing.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branch of the cutaneous cervical nerve, the hypoglossal nerve, and the branch of the glossopharyngeal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior region of the neck, superior to superior border to thyroid cartilage, in the depression superior to the hyoid bone, on the anterior median line. Note: With the head slightly extended, the hyoid tubercle can be palpated between the mandible and the thyroid cartilage.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely 0.5-1.0 inch toward the tongue root. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Lianquan</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001684"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001685"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001738"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795328"/>
        <tara:hasSynonym>Conception Vessel 23</tara:hasSynonym>
        <tara:hasSynonym>RN 23</tara:hasSynonym>
        <tara:hasSynonym>Ren 23</tara:hasSynonym>
        <tara:hasSynonym>VC 23</tara:hasSynonym>
        <tara:hasVasculatureDescription>The anterior jugular vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>CV 23</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5828993 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5828993">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5361067"/>
