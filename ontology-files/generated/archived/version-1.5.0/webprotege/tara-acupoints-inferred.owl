        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008337"/>
        <tara:hasIndicationsDescription>abdominal pain, borborygmus, hernia, swelling and pain of the external genitalia, impotence, dysmenorrhea, irregular menstruation.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The pathway of the ilioinguinal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the groin region, at the same level as the superior border of the pubic symphysis, 2 B-cun lateral to the anterior median line, over the femoral artery. Note: ST30 is 5 B-cun inferior to ST25, 2 B-cun lateral to CV2.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Qichong</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001354"/>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034964"/>
