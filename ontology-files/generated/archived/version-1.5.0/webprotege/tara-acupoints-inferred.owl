        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>天柱</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <tara:hasIndicationsDescription>headache, nasal obstruction, sore throat, neck rigidity, pain in the shoulder and back.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The great occipital nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the posterior region of the neck, at the same level as the superior border of the spinous process of the second cervical vertebra (C2), in the depression lateral to the trapezius muscle.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch.</tara:hasMethodDescription>
