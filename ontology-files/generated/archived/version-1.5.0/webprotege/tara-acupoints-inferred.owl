        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://sourceforge.net/tracker/?func=detail&amp;aid=3486863&amp;group_id=76834&amp;atid=1127722</rdfs:seeAlso>
