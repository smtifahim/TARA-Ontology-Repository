                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002090"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Subdivision of skeletal system that consists of all skeletal elements in the thoracic region of the trunk. In most vertebrates this is the rib cage and sternum.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>EHDAA2:0002013</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:77169</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Thoracic_skeleton</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>skeleton of thorax</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>thoracic part of axial skeleton</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>thoracic skeleton</OboInOwl:hasExactSynonym>
        <rdfs:label>thoracic skeleton</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0014478 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0014478">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000075"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011138"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003252"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Subdivision of skeletal system that consists of all ribs and rib joints in an organism. In many vertebrates this consists of the combination of the rib cage and all rib joints, but some vertebrates have ribs outside the thoracic rib cage.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>FMA:265719</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>TAO:0002100</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>rib series</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>rib skeleton</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>set of all ribs</OboInOwl:hasRelatedSynonym>
        <rdfs:label>rib skeletal system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0014692 -->

