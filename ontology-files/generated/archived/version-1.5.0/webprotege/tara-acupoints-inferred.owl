        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 161. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>三陽(阳)絡(络)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <tara:hasIndicationsDescription>deafness, sudden hoarseness of the voice, pain in the chest and hypochondriac region, pain in the hand and arm, toothache.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the posterior aspect of the forearm, midpoint of the interosseous space between the radius and the ulna, 4 B-cun proximal to the dorsal wrist crease. Note: At the junction of the upper two thirds and lower one third of the line connecting tE4 with the tip of the elbow.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Sanyangluo</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001423"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001424"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001461"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795333"/>
        <tara:hasSynonym>SJ 8</tara:hasSynonym>
        <tara:hasSynonym>San Jiao 8</tara:hasSynonym>
        <tara:hasSynonym>TB 8</tara:hasSynonym>
        <tara:hasSynonym>TH 8</tara:hasSynonym>
        <tara:hasSynonym>TW 8</tara:hasSynonym>
        <tara:hasSynonym>Triple Burner 8</tara:hasSynonym>
        <tara:hasSynonym>Triple Energizer 8</tara:hasSynonym>
        <tara:hasSynonym>Triple Heater 8</tara:hasSynonym>
        <tara:hasSynonym>Triple Warmer 8</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior antebrachial interosseous artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <rdfs:label>TE 8</rdfs:label>
    </owl:Class>
    


