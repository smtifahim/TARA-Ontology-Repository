        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002375"/>
        <tara:hasSynonym>CO 17</tara:hasSynonym>
        <tara:hasSynonym>Colon 17</tara:hasSynonym>
        <tara:hasSynonym>Large Intestine 17</tara:hasSynonym>
        <tara:hasVasculatureDescription>The external jugular vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <rdfs:label>LI 17</rdfs:label>
    </owl:Class>
    


