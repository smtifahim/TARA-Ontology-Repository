        <rdfs:label>Jing-River Point</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7357260 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7357260">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552"/>
        <rdfs:subClassOf>
            <owl:Restriction>
