        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 30. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>魚(鱼)際(际)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008878"/>
        <tara:hasIndicationsDescription>cough, hemoptysis, sore throat, loss of voice, fever, feverish sensation in the palm.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The superficial ramus of the radial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the palm, radial to the midpoint of the first metacarpal bone, at the border between the red and white flesh.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Yuji</tara:hasPinyinLabel>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797391"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001106"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9857829"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003645"/>
        <tara:hasSynonym>L 10</tara:hasSynonym>
        <tara:hasSynonym>Lung 10</tara:hasSynonym>
        <tara:hasVasculatureDescription>Venules of the thumb draining to the cephalic vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9964503"/>
        <rdfs:label>LU 10</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2465151 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2465151">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552"/>
