        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 123. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>陽(阳)綱(纲)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <tara:hasIndicationsDescription>borborygmus, abdominal pain, diarrhea, pain in the hypochondriac region, jaundice.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>In the upper back region, at the same level as the inferior border of the spinous pro- cess of the tenth thoracic vertebra (T10), 3 B-cun lateral to the posterior median line. Note: BL48, BL19 and GV7 are located at the same level as the inferior border of the spinous process of the tenth thoracic vertebra (T10).</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Yanggang</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004634"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSynonym>B 48</tara:hasSynonym>
        <tara:hasSynonym>Bladder 48</tara:hasSynonym>
        <tara:hasSynonym>UB 48</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 48</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior branches of the intercostal artery and vein. Innervation: The lateral cutaneous branches of the posterior rami of the eighth and ninth thoracic nerves.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 48</rdfs:label>
    </owl:Class>
    


