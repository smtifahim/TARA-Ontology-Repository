            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 95. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>天窗(窓)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <tara:hasIndicationsDescription>sore throat, sudden loss of voice, deafness, tinnitus, stiffness and pain of the neck.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The cutaneous cervical nerve, the emerging portion of the great auricular nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior region of the neck, posterior to the sternocleidomastoid muscle, at the same level as the superior border of the thyroid cartilage. Note 1: The sternocleidomastoid muscle is more distinct when the head is turned to the opposite side against resistance. Note 2: SI16 is located at the same level as St9, LI18 and the superior border of the thyroid cartilage. St9 is located anterior to the sternocleidomastoid muscle, SI16, posterior to the sternocleidomastoid muscle and LI18, midway between the anterior and posterior borders of the sternocleidomastoid muscle.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.7 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Tianchuang</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012322"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008833"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797480"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001128"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001738"/>
        <tara:hasSynonym>Small Intestine 16</tara:hasSynonym>
        <tara:hasVasculatureDescription>The ascending cervical artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9093316"/>
        <rdfs:label>SI 16</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5264783 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5264783">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1926756"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasGeneralSurfaceLocation"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000376"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecificSurfaceLocation"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://uri.interlex.org/base/ilx_0795324"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 187. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>風(风)市</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000376"/>
        <tara:hasIndicationsDescription>pain and soreness in the thigh and lumbar region, paralysis of the lower limbs, beriberi, general pruritus.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The lateral femoral cutaneous nerve, the muscular branch of the femoral nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lateral aspect of the thigh, in the depression posterior to the iliotibial band where the tip of the middle finger rests, when standing up with the arms hanging alongside the thigh. Note: GB31 is located by first finding the iliotibial band when the knee is slightly flexed and the hip is abducted against resis- tance.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.7-1.2 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Fengshi</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795324"/>
        <tara:hasSynonym>G 31</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 31</tara:hasSynonym>
        <tara:hasVasculatureDescription>The muscular branches of the lateral circumflex femoral artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 31</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5282844 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5282844">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/isLocatedOnMeridian"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Stomach Meridian of Foot-Yangming (ST), which consists of 45 standardized acupoints beginning at ST 1 (Chengqi) on the face between the eyeball and the infraorbital margin directly below the pupil, traveling down across the face, neck, chest, and abdomen and continuing along the anterior-lateral aspect of the leg, and ending at ST 45 (Lidui) on the lateral side of the second toe near the corner of the nail.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <tara:hasSynonym>Acupoint of the stomach meridian of foot-yangming</tara:hasSynonym>
        <tara:hasSynonym>Acupuncture point of the stomach meridian</tara:hasSynonym>
        <tara:hasSynonym>Acupuncture point of the stomach meridian of foot-yangming</tara:hasSynonym>
        <tara:hasSynonym>ST</tara:hasSynonym>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>Acupoint of the Stomach Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5283975 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6200120"/>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <tara:hasAbbreviation>GB</tara:hasAbbreviation>
        <tara:hasAssociatedOrgan rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002110"/>
        <tara:hasChineseLabel>足少陽(阳)膽(胆)經(经,経)</tara:hasChineseLabel>
        <tara:hasSynonym>GB</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder Meridian of Foot-Shaoyang</tara:hasSynonym>
        <tara:hasSynonym>gall bladder meridian</tara:hasSynonym>
        <tara:hasSynonym>meridian of the gall bladder</tara:hasSynonym>
        <tara:hasSynonym>meridian of the gallbladder</tara:hasSynonym>
        <rdfs:label>Gallbladder Meridian</rdfs:label>
    </owl:Class>
    


