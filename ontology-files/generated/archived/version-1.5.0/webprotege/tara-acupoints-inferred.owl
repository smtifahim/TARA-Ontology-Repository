        <tara:hasChineseLabel>前頂(顶)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>epilepsy, dizziness, blurred vision, vertical headache, rhinorrhea.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>On the communicating site of the branch of the frontal nerve with the branch of the great occipital nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, 3.5 B-cun superior to the anterior hairline, on the anterior median line. Note: GV21 is located at the midpoint of the line connecting GV 20 and GV 22.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Qianding</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
