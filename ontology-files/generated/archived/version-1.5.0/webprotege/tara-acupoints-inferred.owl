    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3092014 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3092014">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_8746709"/>
