        <tara:hasSynonym>TB 2</tara:hasSynonym>
        <tara:hasSynonym>TH 2</tara:hasSynonym>
        <tara:hasSynonym>TW 2</tara:hasSynonym>
        <tara:hasSynonym>Triple Burner 2</tara:hasSynonym>
