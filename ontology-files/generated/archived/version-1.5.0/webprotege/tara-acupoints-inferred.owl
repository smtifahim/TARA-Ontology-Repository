    <!-- http://purl.obolibrary.org/obo/UBERON_0007150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003847"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035398"/>
        <obo:IAO_0000115>The superior thyroid artery arises from the external carotid artery just below the level of the greater cornu of the hyoid bone and ends in the thyroid gland.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>EMAPA:18624</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:49472</OboInOwl:hasDbXref>
