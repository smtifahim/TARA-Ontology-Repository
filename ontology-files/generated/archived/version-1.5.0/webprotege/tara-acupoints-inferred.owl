        <tara:hasChineseLabel>水溝(沟)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <tara:hasInnervationDescription>The buccal branch of the facial nerve, and the branch of the intraorbital nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the face, at the midpoint of the philtrum midline. Remarks: Alternative location for GV26 at the junction of the upper one third and lower two thirds of the philtrum midline.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely upward OJ-0.5 inch.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Renzhong</tara:hasPinyinLabel>
        <tara:hasPinyinLabel>Shuigou</tara:hasPinyinLabel>
