    <!-- http://purl.obolibrary.org/obo/UBERON_0009564 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009564">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013703"/>
