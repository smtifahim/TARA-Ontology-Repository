        <OboInOwl:hasRelatedSynonym>loose connective tissue</OboInOwl:hasRelatedSynonym>
        <rdfs:label>areolar connective tissue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0006822 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006822">
