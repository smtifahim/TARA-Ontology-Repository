        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 105. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>大杼</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <tara:hasIndicationsDescription>headache, pain in the neck and back, pain and soreness in the scapular region, cough, fever, neck rigidity.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial cutaneous branches of the posterior rami of the first and second thoracic nerves; deeper, their lateral cutaneous branches.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the upper back region, at the same level as the inferior border of the spinous process of the first thoracic vertebra (T1), 1.5 B-cun lateral to the posterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely 0.5-0.7 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Dazhu</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9719785"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004626"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSynonym>B 11</tara:hasSynonym>
        <tara:hasSynonym>Bladder 11</tara:hasSynonym>
        <tara:hasSynonym>Influential Point of Bone</tara:hasSynonym>
        <tara:hasSynonym>UB 11</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 11</tara:hasSynonym>
        <tara:hasVasculatureDescription>The medial cutaneous branches of the posterior branches of the intercostal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 11</rdfs:label>
    </owl:Class>
    


