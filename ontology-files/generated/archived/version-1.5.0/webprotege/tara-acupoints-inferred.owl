        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6200120"/>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <tara:hasAbbreviation>BL</tara:hasAbbreviation>
        <tara:hasAbbreviation>UB</tara:hasAbbreviation>
        <tara:hasAssociatedOrgan rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001255"/>
        <tara:hasChineseLabel>足太陽(阳)膀胱經(经,経)</tara:hasChineseLabel>
        <tara:hasSynonym>BL</tara:hasSynonym>
        <tara:hasSynonym>Bladder Meridian of Foot-Taiyang</tara:hasSynonym>
        <tara:hasSynonym>UB</tara:hasSynonym>
        <tara:hasSynonym>meridan of the urinary bladder</tara:hasSynonym>
        <tara:hasSynonym>meridian of the bladder</tara:hasSynonym>
        <tara:hasSynonym>urinary bladder meridian</tara:hasSynonym>
        <rdfs:label>Bladder Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7532145 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7532145">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Acute and chronic appendicitis, indigestion, paralysis of the lower extremities.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>The tender spot about 2 cun below Zusanli (ST 36).</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 1.0-1.2 inches.</tara:hasMethodDescription>
        <tara:hasSynonym>EX-LE 7</tara:hasSynonym>
        <tara:hasSynonym>M-LE 13</tara:hasSynonym>
        <rdfs:label>Lanweixue</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7546644 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7546644">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7010544"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1028514"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7010544"/>
        <dc:description>One of the eight influential points, the Influential Point of the Zang Organs can be employed to treat disorders of the Zang organs. Zhangmen (LR 13) is the Influential Point of the Zang organs.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1028514"/>
        <rdfs:label>Influential Point of the Zang Organs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7571236 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7571236">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0886544"/>
