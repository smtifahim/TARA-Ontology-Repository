        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004300"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011273"/>
        <tara:hasSynonym>L 11</tara:hasSynonym>
        <tara:hasSynonym>Lung 11</tara:hasSynonym>
        <tara:hasVasculatureDescription>The arterial and venous network formed by the proper palmar digital artery and veins.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9964503"/>
        <rdfs:label>LU 11</rdfs:label>
    </owl:Class>
    


