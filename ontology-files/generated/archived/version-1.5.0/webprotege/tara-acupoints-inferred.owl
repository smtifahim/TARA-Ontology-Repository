        <tara:hasChineseLabel>步(歩)廊</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <tara:hasIndicationsDescription>cough, asthma, distension and fullness in the chest and hypochondriac region, vomiting, anorexia.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anterior cutaneous branch of the fifth intercostal nerve; deeper, the fifth intercostal nerve.</tara:hasInnervationDescription>
