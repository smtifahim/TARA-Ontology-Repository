        <tara:hasChineseLabel>長(长)強</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002356"/>
        <tara:hasIndicationsDescription>diarrhea, bloody stools, hemorrhoids, prolapse of the rectum, constipation, pain in the lower back, epilepsy.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The posterior ramus of the coccygeal nerve, the hemorrhoid nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the perineal region, inferior to the coccyx, midway between the tip of the coccyx and the anus. Note: The subject may be in prone position or knee-chest position.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-0.1 inch. Moxibustion is applicable.</tara:hasMethodDescription>
