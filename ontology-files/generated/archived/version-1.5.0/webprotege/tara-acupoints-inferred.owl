    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2432731 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2432731">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3861175"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5288936"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3861175"/>
        <dc:description>The Back-Shu Point of the Kidney meridian. Back-Shu points are specific points on the back where the qi of the respective zang-fu organs is infused. Situated close to their respectively related zang-fu organs, the Back-Shu points present abnormal reactions to the dysfunction of their corresponding zang-fu organs. They are often used for disorders of the internal organs.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5288936"/>
        <rdfs:label>Back-Shu Point of the Kidney</rdfs:label>
    </owl:Class>
    


