        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 85. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>少府</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002398"/>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008878"/>
        <tara:hasIndicationsDescription>palpitation, pain in the chest, spasmodic pain of the little finger, feverish sensation in the palm, enuresis, dysuria, pruritus of the external genitalia.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The fourth common palmar digital nerve derived from the ulnar nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the palm of the hand, in the depression between the fourth and fifth metacarpal bones, proximal to the fifth metacarpophalangeal joint. Note: Between the fourth and fifth metacarpal bones, where the tip of the little finger rests when a fist is made, at the same level as PC8.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Shaofu</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001410"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001494"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797488"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001412"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9857829"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003625"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003648"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003649"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007747"/>
        <tara:hasSynonym>H 8</tara:hasSynonym>
        <tara:hasSynonym>HE 8</tara:hasSynonym>
        <tara:hasSynonym>Heart 8</tara:hasSynonym>
        <tara:hasVasculatureDescription>The common palmar digital artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009"/>
        <rdfs:label>HT 8</rdfs:label>
    </owl:Class>
    


