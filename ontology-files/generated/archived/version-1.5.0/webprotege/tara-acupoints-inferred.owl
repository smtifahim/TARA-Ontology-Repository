            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A bone that is part of an appendage girdle complex (i.e. any bone in a limb, fin or girdle).</obo:IAO_0000115>
        <OboInOwl:hasDbXref>EMAPA:35494</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0000688</OboInOwl:hasDbXref>
        <OboInOwl:hasRelatedSynonym>bone of extended limb/fin region</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>limb bone</OboInOwl:hasRelatedSynonym>
        <rdfs:label>bone of appendage girdle complex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010741 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010741">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010740"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002091"/>
            </owl:Restriction>
