        <tara:hasChineseLabel>正營(营,営)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>migraine, vertigo.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anastomotic branch of the frontal and great occipital nerves.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, 2.5 B-cun within the anterior hairline, directly superior to the centre of the pupil. Note: GB17 is 2 B-cun superior to GB15.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0‚Ä¢.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
