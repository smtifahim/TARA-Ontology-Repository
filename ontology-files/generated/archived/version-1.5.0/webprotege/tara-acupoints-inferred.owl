        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0725143"/>
        <OboInOwl:hasDbXref>FBbt:00007330</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:67509</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:91690000</OboInOwl:hasDbXref>
