                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 222. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>氣(气,気)海(海)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <tara:hasIndicationsDescription>abdominal pain, enuresis, nocturnal emission, impotence, hernia, edema, diarrhea, dysentery, uterine bleeding, irregular menstruation, dysmenorrhea, amenorrhea, morbid leukorrhea, postpartum hemorrhage, constipation, flaccid type of apoplexy, asthma.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the lower abdomen, 1.5 B-cun inferior to the centre of the umbilicus, on the ante- rior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. This is one of the important points for tonification. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Qihai</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSynonym>Conception Vessel 6</tara:hasSynonym>
        <tara:hasSynonym>RN 6</tara:hasSynonym>
        <tara:hasSynonym>Ren 6</tara:hasSynonym>
        <tara:hasSynonym>VC 6</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of superficial epigastric artery and vein, and the branches of inferior epigastric artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>CV 6</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_8854888 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_8854888">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5361067"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasGeneralSurfaceLocation"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
