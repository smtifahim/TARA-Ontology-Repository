        <OboInOwl:hasDbXref>MA:0001167</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MESH:D005267</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C52816</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>OpenCyc:Mx4rwGC03JwpEbGdrcN5Y29ycA</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:181051004</OboInOwl:hasDbXref>
