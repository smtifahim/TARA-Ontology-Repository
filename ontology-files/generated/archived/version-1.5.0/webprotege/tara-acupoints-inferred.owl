    <!-- http://purl.obolibrary.org/obo/UBERON_0001460 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001460">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006058"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008785"/>
