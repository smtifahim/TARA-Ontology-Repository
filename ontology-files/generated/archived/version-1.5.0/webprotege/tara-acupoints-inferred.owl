        <tara:hasChineseLabel>交信</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003823"/>
        <tara:hasIndicationsDescription>irregular menstruation, dysmenorrhea, uterine bleeding, prolapse of the uterus, diarrhea, constipation, pain and swelling of testis.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial crural cutaneous nerve; deeper, the tibial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the medial aspect of the leg, in the depression posterior to the medial border of the tibial bone, 2 B-cun superior to the prominence of the medial malleolus. Note: 0.5 B-cun anterior to KI7.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Jiaoxin</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7524444"/>
