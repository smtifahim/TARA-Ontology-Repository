        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 168. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>耳門(门)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <tara:hasIndicationsDescription>tinnitus, deafness, otorrhea, toothache, stiffness of the lip.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branches of the auriculotemporal nerve and facial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the face, in the depression between the supratragic notch and the condylar process of the mandible. Note: When the mouth is slightly opened, tE21 is located in the depression anterior to the supratragic notch, directly superior to SI19.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Ermen</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004657"/>
        <tara:hasSynonym>SJ 21</tara:hasSynonym>
        <tara:hasSynonym>San Jiao 21</tara:hasSynonym>
        <tara:hasSynonym>TB 21</tara:hasSynonym>
        <tara:hasSynonym>TH 21</tara:hasSynonym>
        <tara:hasSynonym>TW 21</tara:hasSynonym>
        <tara:hasSynonym>Triple Burner 21</tara:hasSynonym>
        <tara:hasSynonym>Triple Energizer 21</tara:hasSynonym>
        <tara:hasSynonym>Triple Heater 21</tara:hasSynonym>
        <tara:hasSynonym>Triple Warmer 21</tara:hasSynonym>
        <tara:hasVasculatureDescription>The superficial temporal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <rdfs:label>TE 21</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3361967 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3361967">
