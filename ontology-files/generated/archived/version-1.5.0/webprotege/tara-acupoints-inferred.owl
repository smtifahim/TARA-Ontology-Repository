        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003699"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSynonym>S 30</tara:hasSynonym>
        <tara:hasSynonym>Stomach 30</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the superficial epigastric artery and vein; laterally, the inferior epigastric artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 30</rdfs:label>
    </owl:Class>
    


