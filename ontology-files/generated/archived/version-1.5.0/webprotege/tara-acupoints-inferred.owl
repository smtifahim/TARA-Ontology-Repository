    <!-- http://purl.obolibrary.org/obo/UBERON_5101463 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_5101463">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_5102389"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_5106048"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012150"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_5001463"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A subdivision of the skeleton of the autopod consisting of the phalanges of manual digit 1 plus the associated metapodial element.</obo:IAO_0000115>
        <obo:IAO_0000232>this class represents a series of phalanges plus a metapodial element. In comparative anatomy terminology we would call this a &apos;digit&apos;, but the label &apos;digit&apos; is sometimes used to exclude metapodials and to include soft tissue. This series of elements is hypothesized to be homologous to radials.</obo:IAO_0000232>
        <OboInOwl:hasExactSynonym>manual digit I digitopodial skeleton</OboInOwl:hasExactSynonym>
