    <!-- http://purl.obolibrary.org/obo/UBERON_0001705 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001705">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009564"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A horn-like keratin structure covering the dorsal aspect of the terminal phalanges of fingers and toes[WP].</obo:IAO_0000115>
        <obo:IAO_0000232>Use this class for both the nails of primates and the homologous claws of mammals such as mouse.</obo:IAO_0000232>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0001-9114-8737"/>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <OboInOwl:hasDbXref>BTO:0001719</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>CALOHA:TS-2034</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EFO:0000956</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EMAPA:35580</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EV:0100159</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:54326</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>GAID:1320</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0002703</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MAT:0000158</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MESH:D009262</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MIAA:0000158</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C33156</OboInOwl:hasDbXref>
