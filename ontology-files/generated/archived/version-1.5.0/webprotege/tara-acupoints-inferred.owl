        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797506"/>
        <OboInOwl:hasExactSynonym>Arteria collateralis ulnaris superior</OboInOwl:hasExactSynonym>
        <rdfs:label>Superior ulnar collateral artery</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797507 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797507">
