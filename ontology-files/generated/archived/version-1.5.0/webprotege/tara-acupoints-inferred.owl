        <tara:hasChineseLabel>束骨(骨)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002387"/>
        <tara:hasIndicationsDescription>mania, headache, neck rigidity, blurred vision, backache, pain in the lower extremities.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The fourth common plantar digital nerve and the lateral dorsal cutaneous nerve of foot.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lateral aspect of the foot, in the depression proximal to the fifth metatarsophalangeal joint, at the border between the red and white flesh.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
