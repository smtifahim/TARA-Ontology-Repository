        <tara:hasChineseLabel>筋縮(缩)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <tara:hasIndicationsDescription>epilepsy, stiffness of the back, gastric pain.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial branch of the posterior ramus of the ninth thoracic nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the upper back region, in the depression inferior to the spinous process of the ninth thoracic vertebra (T9), on the posterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Jinsuo</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004633"/>
