        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <tara:hasIndicationsDescription>facial paralysis, eyelid twitching, epistaxis, toothache, swelling of lips and cheek.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branches of the facial and infraorbital nerves.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the face, directly inferior to the pupil, at the same level as the inferior border of the ala of the nose. Note: When looking straight ahead, ST3 is located at the intersection of the vertical line of the pupil and the horizontal line of the inferior border of the ala of the nose.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Juliao</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001612"/>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004646"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001647"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0018408"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001653"/>
        <tara:hasRelatedVein rdf:resource="http://uri.interlex.org/base/ilx_0797500"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001771"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006906"/>
        <tara:hasSynonym>S 3</tara:hasSynonym>
        <tara:hasSynonym>Stomach 3</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the facial and infraorbital arteries and veins.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 3</rdfs:label>
    </owl:Class>
    


