        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001546"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000979"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001485"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009990"/>
        <tara:hasSynonym>Spleen 9</tara:hasSynonym>
        <tara:hasVasculatureDescription>Anteriorly, the great saphenous vein, the genu suprema artery; deeper, the posterior tibial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <rdfs:label>SP 9</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3566953 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3566953">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3861175"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2065487"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3861175"/>
        <dc:description>The Back-Shu Point of the Heart meridian. Back-Shu points are specific points on the back where the qi of the respective zang-fu organs is infused. Situated close to their respectively related zang-fu organs, the Back-Shu points present abnormal reactions to the dysfunction of their corresponding zang-fu organs. They are often used for disorders of the internal organs.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2065487"/>
        <rdfs:label>Back-Shu Point of the Heart</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3606292 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3606292">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7571236"/>
        <rdfs:label>Front-Mu Point of Triple Energizer Role</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_3641900 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_3641900">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Swelling of the tongue, vomiting, aphasia with stiffness of tongue.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the veins on both sides of the frenulum of the tongue, Jinjin is on the left, Yuye, on the right.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Prick to cause bleeding.</tara:hasMethodDescription>
        <tara:hasSynonym>EX-HN 12</tara:hasSynonym>
        <tara:hasSynonym>Jinjin</tara:hasSynonym>
        <tara:hasSynonym>M-HN 20a</tara:hasSynonym>
        <rdfs:label>Jinjing</rdfs:label>
    </owl:Class>
    


