        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 30. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>太淵(渊)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004452"/>
        <tara:hasIndicationsDescription>cough, asthma, hemoptysis, sore throat, palpitation, pain in the chest, wrist and arm.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The lateral antebrachial cutaneous nerve and superficial branch of the radial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the anterolateral aspect of the wrist, between the radial styloid process and the scaphoid bone, in the depression ulnar to the abductor pollicis longus tendon. Note: On the radial side of the palmar wrist crease, over the radial artery.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.2-0.3 inch. Avoid puncturing the radial artery. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Taiyuan</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001404"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794951"/>
