        <tara:hasChineseLabel>厥陰(阴)兪(俞)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <tara:hasIndicationsDescription>cough, cardiac pain, palpitation, stuffy chest, vomiting.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial cutaneous branches of the posterior rami of the fourth or fifth thoracic nerves; deeper, their lateral branches.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the upper back region, at the same level as the inferior border of the spinous process of the fourth thoracic vertebra (T4), 1.5 B-cun lateral to the posterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely 0.5-0.7 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Jueyinshu</tara:hasPinyinLabel>
