    <!-- http://purl.obolibrary.org/obo/UBERON_0001550 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001638"/>
        <obo:IAO_0000115>A continuation of the Dorsal venous arch of the foot and is the origin of the long saphenous vein.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>EMAPA:37170</OboInOwl:hasDbXref>
