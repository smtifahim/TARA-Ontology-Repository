        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 49. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>下關(关,関)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <tara:hasIndicationsDescription>deafness, tinnitus, otorrhea, toothache, facial paralysis, pain of the face, motor impairment of the jaw.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The zygomatic branch of the facial nerve and the branches of the auriculotemporal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the face, in the depression between the midpoint of the inferior border of the zygomatic arch and the mandibular notch. Note: When the mouth is closed, ST7 is located at the depression inferior to the zygomatic arch, directly inferior to gB3.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.1- 0.5 cun. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Xiaguan</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001615"/>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001616"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0793723"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797479"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001659"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001660"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002500"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795291"/>
        <tara:hasSynonym>S 7</tara:hasSynonym>
        <tara:hasSynonym>Stomach 7</tara:hasSynonym>
        <tara:hasVasculatureDescription>Superficially, the transverse facial artery and vein; in the deepest layer, the maxillary artery and maxillary vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 7</rdfs:label>
    </owl:Class>
    


