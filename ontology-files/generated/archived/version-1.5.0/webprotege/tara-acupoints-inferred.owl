        <tara:hasChineseLabel>攢(攒,攅)竹</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>headache, blurred and failing vision, pain in the supraorbital region, lacrimation, redness, swelling and pain of the eye, eyelid twitching, glaucoma.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial branch of the frontal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, in the depression at the medial end of the eyebrow. Note: A depression, the frontal notch, can often be palpated on the medial end of the eyebrow directly superior to BL1.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch, or prick with three-edged needle to cause bleeding.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Zanzhu</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010163"/>
