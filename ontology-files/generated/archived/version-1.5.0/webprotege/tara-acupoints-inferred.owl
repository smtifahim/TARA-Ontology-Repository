        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006849"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_4200020"/>
        <tara:hasSynonym>CO 16</tara:hasSynonym>
        <tara:hasSynonym>Colon 16</tara:hasSynonym>
        <tara:hasSynonym>Large Intestine 16</tara:hasSynonym>
        <tara:hasVasculatureDescription>Deeper, the suprascapular artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <rdfs:label>LI 16</rdfs:label>
    </owl:Class>
    


