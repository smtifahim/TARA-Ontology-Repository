        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>神(神)門(门)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004452"/>
        <tara:hasIndicationsDescription>cardiac pain, irritability, palpitation, hysteria, amnesia, insomnia, mania, epilepsy, dementia, pain in the hypochondriac region, feverish sensation in the palm, yellowish sclera.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial antebrachial cutaneous nerve; on the ulnar side, the ulnar nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the anteromedial aspect of the wrist, radial to the flexor carpi ulnaris tendon, on the palmar wrist crease. Note: In the depression radial to the proximal border of the pisiform bone, on the palmar wrist crease.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Shenmen</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001406"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001494"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794953"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1840369"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6705086"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001429"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795334"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795501"/>
        <tara:hasSynonym>H 7</tara:hasSynonym>
        <tara:hasSynonym>HE 7</tara:hasSynonym>
        <tara:hasSynonym>Heart 7</tara:hasSynonym>
        <tara:hasVasculatureDescription>The ulnar artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009"/>
        <rdfs:label>HT 7</rdfs:label>
    </owl:Class>
    


