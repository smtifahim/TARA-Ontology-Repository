        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>華(华)蓋(盖)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0016416"/>
        <tara:hasIndicationsDescription>pain and fullness in the chest and intercostal region, asthma, cough.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anterior cutaneous branch of the first intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior thoracic region, at the same level as the first intercostal space, on the anterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Huagai</tara:hasPinyinLabel>
