    <!-- http://purl.obolibrary.org/obo/UBERON_0001148 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001148">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003433"/>
