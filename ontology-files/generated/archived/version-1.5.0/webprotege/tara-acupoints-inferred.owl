                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001815"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A large nerve that supplies nearly the whole of the skin of the leg, the muscles of the back of the thigh, and those of the leg and foot. It begins in the lower back and runs through the buttock and down the lower limb.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>BIRNLEX:1133</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>BTO:0001221</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>CALOHA:TS-0899</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EFO:0001417</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EHDAA2:0001779</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EHDAA:5659</OboInOwl:hasDbXref>
