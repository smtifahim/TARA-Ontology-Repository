        <tara:hasSynonym>Spleen 17</tara:hasSynonym>
        <tara:hasVasculatureDescription>The thoracoepigastric vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <rdfs:label>SP 17</rdfs:label>
    </owl:Class>
    


