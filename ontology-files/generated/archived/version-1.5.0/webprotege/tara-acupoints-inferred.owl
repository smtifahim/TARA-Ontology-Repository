        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012197"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3779268"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795307"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795308"/>
        <tara:hasSynonym>Spleen 21</tara:hasSynonym>
        <tara:hasVasculatureDescription>The thoracodorsal artery and vein, the seventh intercostal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <rdfs:label>SP 21</rdfs:label>
    </owl:Class>
    


