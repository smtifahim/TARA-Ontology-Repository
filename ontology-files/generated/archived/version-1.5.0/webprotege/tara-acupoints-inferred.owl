        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>關(关,関)元兪(俞)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005462"/>
        <tara:hasInnervationDescription>The posterior ramus of the fifth lumbar nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the lumbar region, at the same level as the inferior border of the spinous process of the fifth lumbar vertebra (L5), 1.5 B-cun lateral to the posterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.8-1.2 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Guanyuanshu</tara:hasPinyinLabel>
