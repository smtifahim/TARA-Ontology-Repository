        <OboInOwl:hasExactSynonym>proximal end of humerus</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>proximal humeral epiphysis</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>upper end of humerus</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>head of the humerus</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>humeral head</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>proximal humerus</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>upper extremity of humerus</OboInOwl:hasRelatedSynonym>
        <rdfs:label>proximal epiphysis of humerus</rdfs:label>
