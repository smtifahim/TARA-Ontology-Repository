        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795305"/>
        <tara:hasSynonym>K 8</tara:hasSynonym>
        <tara:hasSynonym>KD 8</tara:hasSynonym>
        <tara:hasSynonym>KID 8</tara:hasSynonym>
        <tara:hasSynonym>Kidney 8</tara:hasSynonym>
        <tara:hasVasculatureDescription>Deeper, the posterior tibial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <rdfs:label>KI 8</rdfs:label>
    </owl:Class>
    


