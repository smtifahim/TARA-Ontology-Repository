    <!-- http://purl.obolibrary.org/obo/UBERON_0000947 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000947">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003509"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003519"/>
