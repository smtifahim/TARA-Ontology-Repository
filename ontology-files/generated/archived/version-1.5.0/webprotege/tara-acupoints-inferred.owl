        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 198. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>中都(都)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003823"/>
        <tara:hasIndicationsDescription>abdominal pain, hypochondriac pain, diarrhea, hernia, uterine bleeding, prolonged lochia.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branch of the saphenous nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the anteromedial aspect of the leg, at the centre of the medial border (surface) of the tibia, 7 B-cun proximal to the prominence of the medial malleolus. Note: LR6 is located at 0.5 B-cun inferior to the midpoint of the line connecting the apex of the patella with the prominence of the medial malleolus, at the centre of the medial border (surface) of the tibia.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.5-0.8 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Zhongdu</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4598552"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000979"/>
