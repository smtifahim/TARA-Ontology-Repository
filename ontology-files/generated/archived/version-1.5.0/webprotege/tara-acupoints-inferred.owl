        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6200120"/>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <tara:hasAbbreviation>LU</tara:hasAbbreviation>
        <tara:hasAssociatedOrgan rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002048"/>
        <tara:hasChineseLabel>手太陰(阴)肺經(经,経)</tara:hasChineseLabel>
        <tara:hasSynonym>LU</tara:hasSynonym>
        <tara:hasSynonym>Lung Meridian of Hand-Taiyin</tara:hasSynonym>
        <tara:hasSynonym>meridian of the lung</tara:hasSynonym>
        <rdfs:label>Lung Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9968219 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9968219">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1926756"/>
