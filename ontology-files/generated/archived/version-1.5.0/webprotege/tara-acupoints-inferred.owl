        <tara:hasChineseLabel>大赫</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <tara:hasIndicationsDescription>nocturnal emission, impotence, morbid leukorrhea, pain in the external genitalia, prolapse of the uterus.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branches of subcostal nerve and the iliohypogastric nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lower abdomen, 4 B-cun inferior to the centre of the umbilicus, 0.5 B-cun lateral to the anterior median line.</tara:hasLocationalDescription>
