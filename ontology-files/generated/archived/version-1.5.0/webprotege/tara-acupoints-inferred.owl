    <!-- http://purl.obolibrary.org/obo/UBERON_0006200 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0006200">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001638"/>
