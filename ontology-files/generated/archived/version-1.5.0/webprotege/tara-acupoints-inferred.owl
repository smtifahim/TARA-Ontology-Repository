    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0000170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034925"/>
