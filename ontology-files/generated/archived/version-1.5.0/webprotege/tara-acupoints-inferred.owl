    <!-- http://purl.obolibrary.org/obo/UBERON_0001355 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001637"/>
