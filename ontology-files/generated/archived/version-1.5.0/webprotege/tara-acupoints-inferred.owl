        <tara:hasSynonym>VG 8</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior branch of the ninth intercostal artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <rdfs:label>GV 8</rdfs:label>
    </owl:Class>
    


