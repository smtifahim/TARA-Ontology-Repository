        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>承漿(浆)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001456"/>
        <tara:hasIndicationsDescription>facial puffiness, swelling of the gums, toothache, salivation, mental disorder, deviation of the eye and mouth.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branch of the facial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the face, in the depression in the centre of the mentolabial sulcus.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely upward 0.2-0.3 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Chengjiang</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795327"/>
