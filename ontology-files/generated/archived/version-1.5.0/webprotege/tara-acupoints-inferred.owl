    <!-- http://purl.obolibrary.org/obo/UBERON_0002072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
