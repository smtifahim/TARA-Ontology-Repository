        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003676"/>
        <tara:hasSynonym>S 35</tara:hasSynonym>
        <tara:hasSynonym>Stomach 35</tara:hasSynonym>
        <tara:hasVasculatureDescription>The arterial and venous network around the knee joint.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 35</rdfs:label>
    </owl:Class>
    


