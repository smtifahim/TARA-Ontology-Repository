        <OboInOwl:hasDbXref>Wikipedia:Systemic_venous_system</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>systemic venous circulatory system</OboInOwl:hasExactSynonym>
        <rdfs:label>systemic venous system</rdfs:label>
    </owl:Class>
    


