            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002170"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001657"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A tributary of the superficial temporal or retromandibular veins, anastomosing with the facial vein.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>EMAPA:37200</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:50938</OboInOwl:hasDbXref>
