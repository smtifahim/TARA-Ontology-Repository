            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 200. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>陰(阴)包(包)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000376"/>
        <tara:hasIndicationsDescription>pain in the lumbosacral region, lower abdominal pain, enuresis, retention of urine, irregular menstruation.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anterior femoral cutaneous nerve, on the pathway of the anterior branch of the obturator nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the medial aspect of the thigh, between the gracilis and the sartorius muscles, 4 B- cun proximal to the base of the patella. Note: With the hip slightly flexed and ab- ducted and with the muscle under tension, the sartorius muscle becomes more distinct. Lr 9 is located posterior to the sartorius muscle.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-0.7 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Yinbao</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000950"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001373"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002446"/>
        <tara:hasSynonym>LIV 9</tara:hasSynonym>
        <tara:hasSynonym>LV 9</tara:hasSynonym>
        <tara:hasSynonym>Liver 9</tara:hasSynonym>
        <tara:hasVasculatureDescription>Deeper, on the lateral side, the femoral artery and vein, the superficial branch of the medial circumflex femoral artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5419503"/>
        <rdfs:label>LR 9</rdfs:label>
    </owl:Class>
    


