    <!-- http://purl.obolibrary.org/obo/UBERON_0002418 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002418">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004755"/>
        <rdfs:subClassOf>
            <owl:Restriction>
