        <tara:hasChineseLabel>腹結(结)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <tara:hasIndicationsDescription>pain around the umbilical region, abdominal distension, hernia, diarrhea, constipation.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The eleventh intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lower abdomen, 1.3 B-cun inferior to the centre of the umbilicus, 4 B-cun lateral to the anterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Fujie</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://uri.interlex.org/base/ilx_0791079"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0792132"/>
