            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A skin crease (anatomically known as a flexure line or skin furrow) is a permanent, fixed linear depression on the surface of the skin that is directly attached to the underlying deep tissues, fascia, or joints. Source: https://pubmed.ncbi.nlm.nih.gov/27081433/</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://purl.obolibrary.org/obo/UBERON_0019243"/>
