        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003646"/>
        <tara:hasSynonym>CO 4</tara:hasSynonym>
        <tara:hasSynonym>Colon 4</tara:hasSynonym>
        <tara:hasSynonym>Large Intestine 4</tara:hasSynonym>
        <tara:hasVasculatureDescription>The venous network of the dorsum of the hand.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <rdfs:label>LI 4</rdfs:label>
