        <OboInOwl:hasDbXref>http://www.snomedbrowser.com/Codes/Details/280385004</OboInOwl:hasDbXref>
        <OboInOwl:hasRelatedSynonym>skin groove</OboInOwl:hasRelatedSynonym>
        <rdfs:label>skin crease</rdfs:label>
    </owl:Class>
    


