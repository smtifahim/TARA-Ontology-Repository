            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An exocrine gland that is part of a integumental system.</obo:IAO_0000115>
        <OboInOwl:hasExactSynonym>integumental exocrine gland</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>integumental system exocrine gland</OboInOwl:hasExactSynonym>
        <rdfs:label>exocrine gland of integumental system</rdfs:label>
    </owl:Class>
    


