    <!-- http://purl.obolibrary.org/obo/UBERON_0011145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0011145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014892"/>
        <obo:IAO_0000115>A muscle capable of adduction. Adduction is a movement which brings a part of the anatomy closer to the middle sagittal plane of the body. It is opposed to abduction.</obo:IAO_0000115>
