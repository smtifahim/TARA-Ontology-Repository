        <obo:IAO_0000115>Circulating fluid that is part of the hemolymphoid system. Blood, lymph, interstitial fluid or its analogs.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-6601-2165"/>
        <OboInOwl:creation_date>2009-04-08T04:38:19Z</OboInOwl:creation_date>
