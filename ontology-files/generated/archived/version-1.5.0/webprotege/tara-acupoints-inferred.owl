        <tara:hasRelatedVein rdf:resource="http://uri.interlex.org/base/ilx_0797525"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9857829"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003695"/>
        <tara:hasSynonym>CO 2</tara:hasSynonym>
        <tara:hasSynonym>Colon 2</tara:hasSynonym>
        <tara:hasSynonym>Large Intestine 2</tara:hasSynonym>
        <tara:hasVasculatureDescription>The dorsal digital and plamar digital proper arteries and veins derived from the radial artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <rdfs:label>LI 2</rdfs:label>
    </owl:Class>
    


