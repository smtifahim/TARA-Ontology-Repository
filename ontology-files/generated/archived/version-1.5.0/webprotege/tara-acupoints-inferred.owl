    <!-- http://purl.obolibrary.org/obo/UBERON_0000948 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0000948">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
