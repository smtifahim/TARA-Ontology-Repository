            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001460"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A triangular depression on the anterior aspect of the elbow, containing important neurovascular structures.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001460"/>
        <base:ilx_0777130>https://en.wikipedia.org/wiki/Cubital_fossa</base:ilx_0777130>
