        <tara:hasSynonym>Bladder 27</tara:hasSynonym>
        <tara:hasSynonym>UB 27</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 27</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior branches of the lateral sacral artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
