        <tara:hasChineseLabel>湧(涌)泉</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008338"/>
        <tara:hasIndicationsDescription>headache, blurred vision, dizziness, sore throat, dryness of the tongue, loss of voice, dysuria, infantile convulsion, feverish sensation in the sole, loss of consciousness.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The second common plantar digital nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the sole of the foot, in the deepest depression of the sole when the toes are flexed. Note: When the toes are flexed, KI1 is located approximately in the depression at the junction of the anterior one third and the posterior two thirds of the line connecting the heel with the web margin between the bases of the second and third toes.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Yongquan</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003632"/>
