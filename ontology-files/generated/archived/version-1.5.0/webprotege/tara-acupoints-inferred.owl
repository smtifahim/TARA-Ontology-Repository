        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 101. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>曲差</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>headache, nasal obstruction, epistaxis, blurred and failing vision.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The lateral branch of the frontal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, 0.5 B-cun superior to the anterior hairline, 1.5 B-cun lateral to the anterior median line. Note: At the junction of the medial one third and lateral two thirds of the line connecting gV24 with St8.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Qucha</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795292"/>
        <tara:hasSynonym>B 4</tara:hasSynonym>
        <tara:hasSynonym>Bladder 4</tara:hasSynonym>
        <tara:hasSynonym>UB 4</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 4</tara:hasSynonym>
        <tara:hasVasculatureDescription>The frontal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_0607588 -->

