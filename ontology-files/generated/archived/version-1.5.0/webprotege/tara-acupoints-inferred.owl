        <rdfs:label>condyle of tibia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0009990 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0009990">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009989"/>
        <obo:IAO_0000115>The medial condyle is the medial portion of the upper extremity of tibia. It is the site of insertion for the Semimembranosus muscle[WP].</obo:IAO_0000115>
        <OboInOwl:hasDbXref>FMA:35445</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:182066004</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Medial_condyle_of_tibia</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>galen:MedialTibialCondyle</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>condylus medialis (tibia)</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>condylus medialis tibiae</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>c. medialis tibiae</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>medial condyle of the tibia</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>medial tibial condyle</OboInOwl:hasRelatedSynonym>
        <rdfs:label>medial condyle of tibia</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/8/8b/Gray257.png</foaf:depiction>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000061"/>
