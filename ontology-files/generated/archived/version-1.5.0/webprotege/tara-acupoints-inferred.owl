            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>One of the lateral or medial condyles of the tibia.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>AAO:0000899</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:182062002</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Tibial_condyle</OboInOwl:hasDbXref>
