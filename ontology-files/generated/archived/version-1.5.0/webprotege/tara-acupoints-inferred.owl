        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 109. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>脾兪(俞)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <tara:hasIndicationsDescription>epigastric pain, abdominal distension, jaundice, vomiting, diarrhea, dysentery, bloody stools, profuse menstruation, edema, anorexia, backache.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial cutaneous branches of the posterior rami of the eleventh and twelfth thoracic nerves; deeper, their lateral branches.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the upper back region, at the same level as the inferior border of the spinous process of the 11th thoracic vertebra (T11), 1.5 B-cun lateral to the posterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely 0.5-0.7 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Pishu</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0077876"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004635"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSynonym>B 20</tara:hasSynonym>
        <tara:hasSynonym>Back-Shu Point of the Spleen</tara:hasSynonym>
        <tara:hasSynonym>Bladder 20</tara:hasSynonym>
        <tara:hasSynonym>UB 20</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 20</tara:hasSynonym>
        <tara:hasVasculatureDescription>The medial branches of the posterior branches of the intercostal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 20</rdfs:label>
    </owl:Class>
    


