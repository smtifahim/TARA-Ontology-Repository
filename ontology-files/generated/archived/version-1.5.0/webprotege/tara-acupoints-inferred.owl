                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010708"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A bone that is part of a pectoral complex. Examples: scapula, manus phalanx, any carpal bone, any bone of the pectoral fin.</obo:IAO_0000115>
        <obo:IAO_0000116>considering adding pectoral and pelvic complex skeleton classes</obo:IAO_0000116>
        <OboInOwl:hasDbXref>EMAPA:35933</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0000612</OboInOwl:hasDbXref>
        <OboInOwl:hasNarrowSynonym>wing bone</OboInOwl:hasNarrowSynonym>
        <OboInOwl:hasRelatedSynonym>bone of forelimb or pectoral fin or pectoral girdle</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>forelimb bone</OboInOwl:hasRelatedSynonym>
        <rdfs:label>bone of pectoral complex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010742 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010742">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010740"/>
