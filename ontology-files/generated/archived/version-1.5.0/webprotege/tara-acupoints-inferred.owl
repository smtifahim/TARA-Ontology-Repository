        <tara:hasChineseLabel>神(神)庭</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>epilepsy, anxiety, palpitation, insomnia, headache, vertigo, rhinorrhea.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branch of the frontal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, 0.5 B-cun superior to the anterior hairline, on the anterior median line. Note: When the anterior hairline is unclear or changed, GV 24 is located 3.5 B-cun superior to the midpoint between the medial ends of the eyebrows.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch, or prick to cause bleeding.</tara:hasMethodDescription>
