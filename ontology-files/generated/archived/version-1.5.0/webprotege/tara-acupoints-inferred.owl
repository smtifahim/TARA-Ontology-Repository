        <OboInOwl:hasRelatedSynonym>arteria thyreoidea superior</OboInOwl:hasRelatedSynonym>
        <rdfs:label>superior thyroid artery</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/5/5a/Plate_16_Zuckerkandl.jpg</foaf:depiction>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007153 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006349"/>
        <obo:IAO_0000115>An artery that arises from the internal thoracic arteryand anastomoses with the inferior epigastric artery at the umbilicus and supplies the anterior part of the abdominal wall and some of the diaphragm.</obo:IAO_0000115>
        <OboInOwl:hasBroadSynonym>superior epigastric</OboInOwl:hasBroadSynonym>
        <OboInOwl:hasBroadSynonym>superior epigastric branch</OboInOwl:hasBroadSynonym>
