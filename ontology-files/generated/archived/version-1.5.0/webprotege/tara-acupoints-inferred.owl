        <tara:hasChineseLabel>橫骨(骨)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <tara:hasIndicationsDescription>fullness and pain of the lower abdomen, dysuria, enuresis, nocturnal emission, impotence, pain of genitalia.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branch of the iliohypogastric nerve.</tara:hasInnervationDescription>
