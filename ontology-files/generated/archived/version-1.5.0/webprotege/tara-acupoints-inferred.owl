        <OboInOwl:hasRelatedSynonym>ciliary process</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>processus ciliares</OboInOwl:hasRelatedSynonym>
        <rdfs:label>ciliary processes</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/b/b2/Gray875.png</foaf:depiction>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdn.humanatlas.io/digital-objects/ref-organ/eye-female-left/v1.3/assets/3d-vh-f-eye-l.glb</foaf:depiction>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdn.humanatlas.io/digital-objects/ref-organ/eye-female-right/v1.3/assets/3d-vh-f-eye-r.glb</foaf:depiction>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdn.humanatlas.io/digital-objects/ref-organ/eye-male-left/v1.3/assets/3d-vh-m-eye-l.glb</foaf:depiction>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://cdn.humanatlas.io/digital-objects/ref-organ/eye-male-right/v1.3/assets/3d-vh-m-eye-r.glb</foaf:depiction>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001474"/>
        <obo:IAO_0000115>A bone that is shaped as a broad flat plate and composed of two thin layers of compact tissue enclosing between them a variable quantity of cancellous tissue, which is the location of red bone marrow.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>FMA:7476</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C32616</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:332907008</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C0222649</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Flat_bone</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>galen:FlatBone</OboInOwl:hasDbXref>
        <OboInOwl:hasRelatedSynonym>os planum</OboInOwl:hasRelatedSynonym>
        <rdfs:comment>Examples: cranium, the ilium, sternum, rib cage, the sacrum and the scapula; the occipital, parietal, frontal, nasal, lacrimal, vomer, scapula, os coxC&amp;, sternum, and ribs</rdfs:comment>
        <rdfs:label>flat bone</rdfs:label>
    </owl:Class>
    


