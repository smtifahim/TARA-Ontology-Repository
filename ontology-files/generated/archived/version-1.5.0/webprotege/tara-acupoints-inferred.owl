        <tara:hasChineseLabel>腰陽(阳)關(关,関)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005462"/>
        <tara:hasInnervationDescription>The medial branch of the posterior ramus of the lumbar nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the lumbar region, in the depression inferior to the spinous process of the fourth lumbar vertebra (L4), on the posterior median line. Note: GV 3 can be located by first palpating the highest points of the iliac crests and the spinous process of the fourth lumbar vertebra (L4) can then be found at the midpoint of the highest points of both iliac crests.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Yaoyangguan</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004620"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014437"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSynonym>Du 3</tara:hasSynonym>
        <tara:hasSynonym>Governor Vessel 3</tara:hasSynonym>
        <tara:hasSynonym>VG 3</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior branch of the lumbar artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <rdfs:label>GV 3</rdfs:label>
    </owl:Class>
    


