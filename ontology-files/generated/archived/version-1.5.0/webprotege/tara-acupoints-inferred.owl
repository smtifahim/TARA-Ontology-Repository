        <OboInOwl:hasExactSynonym>hip bone</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>innominate bone</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>os coxa</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>os coxae</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>pelvic bone</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>basipterygium</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>os innominatum</OboInOwl:hasRelatedSynonym>
        <rdfs:label>innominate bone</rdfs:label>
