        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>建里</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795301"/>
        <tara:hasIndicationsDescription>stomachache, vomiting, abdominal distension, borborygmus, edema, anorexia.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anterior cutaneous branch of the eighth intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the upper abdomen, 3 B-cun superior to the centre of the umbilicus, on the anterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.2 inches. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Jianli</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSynonym>Conception Vessel 11</tara:hasSynonym>
        <tara:hasSynonym>RN 11</tara:hasSynonym>
        <tara:hasSynonym>Ren 11</tara:hasSynonym>
        <tara:hasSynonym>VC 11</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the superior and inferior epigastric arteries.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>CV 11</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_4943316 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4943316">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7852472"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8173108"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7852472"/>
        <dc:description>A special, specific acupoint located on the Limbs. Specific points refer to those of the fourteen meridians that have special properties and are grouped under special names. Specific Points on the Limbs include: (1) Five Shu Points, (2) Yuan-Primary Points, (3) Luo-Conneetiog Points, (4) Xi-Cleft Points, and (5) Eight Confluent Points.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_8173108"/>
        <rdfs:label>Special Point on the Limbs</rdfs:label>
    </owl:Class>
    


