            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 117. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>會(会)陽(阳)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013691"/>
        <tara:hasIndicationsDescription>dysentery, bloody stools, diarrhea, hemorrhoids, impotence, morbid leukorrhea.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The coccygeal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the buttock region, 0.5 B-cun lateral to the extremity of the coccyx. Note: The subject may be in prone position or knee-chest position. BL35 is located at the soft depression lateral to the extremity of the coccyx.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Huiyang</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001350"/>
        <tara:hasSynonym>B 35</tara:hasSynonym>
        <tara:hasSynonym>Bladder 35</tara:hasSynonym>
        <tara:hasSynonym>UB 35</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 35</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the inferior gluteal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 35</rdfs:label>
    </owl:Class>
    


