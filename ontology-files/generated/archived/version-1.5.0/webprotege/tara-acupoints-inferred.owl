        <tara:hasChineseLabel>目窗(窓)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>headache, vertigo, red and painful eyes, nasal obstruction.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anastomotic branch of the medial and lateral branches of the frontal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, 1.5 B-cun within the anterior hairline, directly superior to the centre of the pupil. Note: GB16 is 1 B-cun superior to GB15.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Muchuang</tara:hasPinyinLabel>
