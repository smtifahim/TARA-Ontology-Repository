        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795301"/>
        <tara:hasIndicationsDescription>abdominal pain and distension, diarrhea, dysentery, constipation.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The tenth intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the upper abdomen, 4 B-cun lateral to the centre of the umbilicus. Note: At the same level and lateral to ST25, KI16 and CV8.</tara:hasLocationalDescription>
