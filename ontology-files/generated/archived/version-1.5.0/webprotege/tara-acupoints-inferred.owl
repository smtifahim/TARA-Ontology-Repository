        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 181. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>風(风)池</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <tara:hasIndicationsDescription>headache, vertigo, insomnia, pain and stiffness of the neck, blurred vision, glaucoma, red and painful eyes, tinnitus, convulsion, epilepsy, infantile convulsion, febrile diseases, common cold, nasal obstruction, rhinorrhea.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branch of the lesser occipital nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior region of the neck, inferior to the occipital bone, in the depression between the origins of sternocleidomastoid and the trapezius muscles. Note: GB20 is at the same level as GV16.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture 0.5-0.8 inch towards the tip of the nose. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Fengchi</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001128"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001676"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002380"/>
        <tara:hasSynonym>G 20</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 20</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the occipital artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 20</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2358051 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2358051">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3535998"/>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Additional Synonyms] Acupuncture: A Comprehensive Text. Shanghai College of Traditional Medicine. Translated and edited by J. O&apos;Connor and D. Bensky. Chicago: Eastland Press, 1981. Section II, Ch. 8: Other New and Miscellaneous Points.</dcterms:bibliographicCitation>
        <tara:hasIndicationsDescription>Alalia, salivation with stiff tongue, sore throat, difficulty in swallowing, loss of voice.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>1 cun below the midpoint of the lower jaw, in the depression between the hyoid bone and the lower border of the jaw.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely 0.8-1.2 inches toward the tongue root.</tara:hasMethodDescription>
        <tara:hasSynonym>M-HN 21</tara:hasSynonym>
        <rdfs:label>Shanglianquan</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2385378 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2385378">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1194553"/>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasGeneralSurfaceLocation"/>
