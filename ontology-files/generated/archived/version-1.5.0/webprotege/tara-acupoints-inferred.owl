        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001738"/>
        <tara:hasSynonym>CO 18</tara:hasSynonym>
        <tara:hasSynonym>Colon 18</tara:hasSynonym>
        <tara:hasSynonym>Large Intestine 18</tara:hasSynonym>
        <tara:hasVasculatureDescription>Deeper, on the medial side, the ascending cervical artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
