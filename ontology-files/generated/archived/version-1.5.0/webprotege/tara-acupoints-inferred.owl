        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006810"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012130"/>
        <tara:hasSynonym>SJ 10</tara:hasSynonym>
        <tara:hasSynonym>San Jiao 10</tara:hasSynonym>
        <tara:hasSynonym>TB 10</tara:hasSynonym>
        <tara:hasSynonym>TH 10</tara:hasSynonym>
        <tara:hasSynonym>TW 10</tara:hasSynonym>
