        <OboInOwl:hasDbXref>FMA:10646</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:244287004</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Superior_epigastric_artery</OboInOwl:hasDbXref>
        <OboInOwl:hasRelatedSynonym>a. epigastrica superior</OboInOwl:hasRelatedSynonym>
        <rdfs:label>superior epigastric artery</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0007154 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0007154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006356"/>
        <obo:IAO_0000115>The blood vessel carrying deoxygenated blood that arises from the superior epigastric vein and empties into the external iliac vein.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>EMAPA:18760</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:21162</OboInOwl:hasDbXref>
