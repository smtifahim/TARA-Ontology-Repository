        <tara:hasSynonym>B 66</tara:hasSynonym>
        <tara:hasSynonym>Bladder 66</tara:hasSynonym>
        <tara:hasSynonym>UB 66</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 66</tara:hasSynonym>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 66</rdfs:label>
    </owl:Class>
    


