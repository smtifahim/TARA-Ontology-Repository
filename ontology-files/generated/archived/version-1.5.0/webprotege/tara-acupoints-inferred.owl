        <OboInOwl:hasExactSynonym>proximal end of ulna</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>upper end of ulna</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>caput ulnae</OboInOwl:hasRelatedSynonym>
        <rdfs:label>proximal epiphysis of ulna</rdfs:label>
    </owl:Class>
    


