    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1926756 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1926756">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/isLocatedOnMeridian"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Gallbladder Meridian of Foot-Shaoyang (GB), which consists of 44 standardized acupoints beginning at GB 1 (Tongziliao) on the head in the depression lateral to the outer canthus of the eye, zigzagging across the temporal and occipital regions of the head and descending along the lateral side of the neck, trunk, and leg, and ending at GB 44 (Zuqiaoyin) on the lateral side of the fourth toe near the corner of the nail.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <tara:hasSynonym>Acupoint of the gallbladder meridian of foot-shaoyang</tara:hasSynonym>
        <tara:hasSynonym>Acupuncture point of the gallbladder meridian</tara:hasSynonym>
        <tara:hasSynonym>Acupuncture point of the gallbladder meridian of foot-shaoyang</tara:hasSynonym>
        <tara:hasSynonym>GB</tara:hasSynonym>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>Acupoint of the Gallbladder Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1985889 -->

