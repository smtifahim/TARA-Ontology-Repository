        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>懸(悬)顱(颅)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>migraine, pain in the outer canthus, facial swelling.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the head, at the midpoint of the curved line from St8 to gB7.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Xuanlu</tara:hasPinyinLabel>
        <tara:hasSynonym>G 5</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 5</tara:hasSynonym>
        <tara:hasVasculatureDescription>The parietal branches of the superficial temporal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 5</rdfs:label>
    </owl:Class>
    


