            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any bone that is part of the upper jaw skeleton. This includes (when present): the maxilla, the quadrate (in some species).</obo:IAO_0000115>
        <obo:IAO_0000116>Do not manually classify under here - bones are automatically classified</obo:IAO_0000116>
        <OboInOwl:hasExactSynonym>upper jaw bone</OboInOwl:hasExactSynonym>
        <rdfs:label>bone of upper jaw</rdfs:label>
    </owl:Class>
    


