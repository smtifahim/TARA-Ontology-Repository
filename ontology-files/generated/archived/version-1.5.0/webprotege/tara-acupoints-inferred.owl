        <OboInOwl:hasRelatedSynonym>medial manual digit</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>mesoaxial manual digit</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>mesoxaxial finger</OboInOwl:hasRelatedSynonym>
        <rdfs:label>manual digit 2, 3 or 4</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://github.com/obophenotype/uberon/issues/592</rdfs:seeAlso>
    </owl:Class>
    


