        <tara:hasChineseLabel>大敦</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003631"/>
        <tara:hasIndicationsDescription>hernia, enuresis, uterine bleeding, prolapse of the uterus, epilepsy.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The dorsal digital nerve derived from the deep peroneal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the great toe, lateral to the distal phalanx, 0.1 f-cun proximal to the lateral corner of the toenail, at the intersection of the vertical line of the lateral side of the nail and the horizontal line of the base of the toenail.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.1-0.2 inch. Moxibustion is applicable.</tara:hasMethodDescription>
