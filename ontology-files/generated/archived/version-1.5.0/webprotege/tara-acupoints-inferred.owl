        <tara:hasChineseLabel>通(通)天</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>headache, giddiness, nasal obstruction, epistaxis, rhinorrhea.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branch of the great occipital nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, 4 B-cun superior to the anterior hairline, 1.5 B-cun lateral to the anterior median line. Note: Midway between BL6 and BL8.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
