            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sympathetic cardiac nerve arising from the superior cervical ganglion that contributes to the cardiac plexus and autonomic innervation of the heart.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001989"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma6578"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797522"/>
        <OboInOwl:hasExactSynonym>Superior cardiac branch of sympathetic trunk</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>Superior cervical cardiac nerve</OboInOwl:hasExactSynonym>
        <rdfs:label>Superior cardiac nerve</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797523 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797523">
        <rdfs:subClassOf rdf:resource="http://uri.interlex.org/base/ilx_0797474"/>
        <rdfs:subClassOf>
