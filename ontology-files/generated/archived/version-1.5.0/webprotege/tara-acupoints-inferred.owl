            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A branch of the brachial artery that accompanies the ulnar nerve posterior to the medial epicondyle and contributes to the arterial anastomosis around the elbow.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001398"/>
