        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>膝陽(阳)關(关,関)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001465"/>
        <tara:hasIndicationsDescription>swelling and pain of the knee, contracture of the tendons in popliteal fossa, numbness of the leg.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The terminal branch of the lateral femoral cutaneous nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lateral aspect of the knee, in the depression between the biceps femoris tendon and the iliotibial band, posterior and proximal to the lateral epicondyle of the femur.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Xiyangguan</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000981"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795317"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795324"/>
        <tara:hasSynonym>G 33</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 33</tara:hasSynonym>
        <tara:hasVasculatureDescription>The superior lateral genicular artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 33</rdfs:label>
    </owl:Class>
    


