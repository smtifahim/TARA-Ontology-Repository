        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001545"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1717280"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001385"/>
        <tara:hasSynonym>S 37</tara:hasSynonym>
        <tara:hasSynonym>Stomach 37</tara:hasSynonym>
        <tara:hasSynonym>The Lower He-Sea Point of the Large Intestine</tara:hasSynonym>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 37</rdfs:label>
    </owl:Class>
    


