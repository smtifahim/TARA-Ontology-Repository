            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 230. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>天突</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000974"/>
        <tara:hasIndicationsDescription>asthma, cough, sore throat, dry throat, hiccup, sudden hoarseness of the voice, difficulty in swallowing, goiter.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anterior branch of the supraclavicular nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior region of the neck, in the centre of the suprasternal fossa, on the anterior median line. Note: CV22 is located in the depression midway between the medial ends of each clavicle.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>First puncture perpendicularly 0.2 inch and then insert the needle tip downward along the posterior aspect of the sternum 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Tiantu</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001105"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795331"/>
        <tara:hasSynonym>Conception Vessel 22</tara:hasSynonym>
        <tara:hasSynonym>RN 22</tara:hasSynonym>
        <tara:hasSynonym>Ren 22</tara:hasSynonym>
        <tara:hasSynonym>VC 22</tara:hasSynonym>
        <tara:hasVasculatureDescription>Superficially, the jugular arch and the branch of the inferior thyroid artery; deeper, the trachea; inferiorly, at the posterior aspect of the sternum, the inominate vein at aortic arch.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>CV 22</rdfs:label>
    </owl:Class>
    


