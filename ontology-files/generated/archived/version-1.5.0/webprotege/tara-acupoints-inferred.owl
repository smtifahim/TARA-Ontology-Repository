        <tara:hasSynonym>TH 22</tara:hasSynonym>
        <tara:hasSynonym>TW 22</tara:hasSynonym>
        <tara:hasSynonym>Triple Burner 22</tara:hasSynonym>
        <tara:hasSynonym>Triple Energizer 22</tara:hasSynonym>
        <tara:hasSynonym>Triple Heater 22</tara:hasSynonym>
        <tara:hasSynonym>Triple Warmer 22</tara:hasSynonym>
        <tara:hasVasculatureDescription>The superficial temporal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <rdfs:label>TE 22</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1766712 -->

