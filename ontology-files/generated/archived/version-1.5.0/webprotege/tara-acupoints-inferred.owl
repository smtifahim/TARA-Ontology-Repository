        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 175. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>率谷</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>migraine, vertigo, vomiting, infantile convulsion.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anastomotic branch of the auriculotemporal nerve and great occipital nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, directly superior to the auricular apex, 1.5 B-cun superior to the temporal hairline. Note: Superior to TE20, 1.5 B-cun within the hairline, it is easier to palpate the point while the subject is chewing.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Shuaigu</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001690"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004104"/>
        <tara:hasSynonym>G 8</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 8</tara:hasSynonym>
        <tara:hasVasculatureDescription>The parietal branches of the superficial temporal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 8</rdfs:label>
    </owl:Class>
    


