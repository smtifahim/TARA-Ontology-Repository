                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004755"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Dermis-derived entity that is made of skeletal tissue.</obo:IAO_0000115>
        <OboInOwl:hasExactSynonym>dermal element</OboInOwl:hasExactSynonym>
