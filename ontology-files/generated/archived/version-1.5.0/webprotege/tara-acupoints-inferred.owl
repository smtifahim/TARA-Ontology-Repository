        <OboInOwl:hasDbXref>GAID:852</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MA:0001172</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>MESH:D012584</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C52810</OboInOwl:hasDbXref>
