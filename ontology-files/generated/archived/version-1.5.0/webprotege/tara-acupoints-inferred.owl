        <rdfs:label>sixth intercostal space</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0795308 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0795308">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006800"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A vertical line running down the lateral thorax from the apex of the axilla to the hip.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001443"/>
        <base:ilx_0777130>https://www.imaios.com/en/e-anatomy/anatomical-structure/midaxillary-line-1536888352</base:ilx_0777130>
