        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 89. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>腕骨(骨)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004452"/>
        <tara:hasIndicationsDescription>febrile diseases with anhidrosis, headache, rigidity of the neck, contracture of the fingers, pain in the wrist, jaundice.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The dorsal branch of the ulnar nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posteromedial aspect of the wrist, in the depression between the base of the fifth metacarpal bone and the triquetrum bone, at the border between the red and white flesh. Note: With one finger placed on SI3, push and slide proximally along the fifth metacarpal bone to the bony projection, SI4 is located in the depression between these two bones.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Wangu</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002454"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797491"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1840369"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002445"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003649"/>
        <tara:hasSynonym>Small Intestine 4</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior carpal artery (the branch of the ulnar artery), the dorsal venous network of the hand.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9093316"/>
        <rdfs:label>SI 4</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_1194553 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_1194553">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/isLocatedOnMeridian"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Heart Meridian of Hand-Shaoyin (HT), which consists of 9 standardized acupoints beginning at HT 1 (Jiquan) in the center of the axillary fossa, traveling down the medial aspect of the arm, and ending at HT 9 (Shaochong) on the radial side of the little finger near the corner of the nail.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <tara:hasSynonym>Acupoint of the heart meridian of hand-shaoyin</tara:hasSynonym>
        <tara:hasSynonym>Acupuncture point of the heart meridian</tara:hasSynonym>
        <tara:hasSynonym>Acupuncture point of the heart meridian of hand-shaoyin</tara:hasSynonym>
        <tara:hasSynonym>HT</tara:hasSynonym>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009"/>
        <rdfs:label>Acupoint of the Heart Meridian</rdfs:label>
    </owl:Class>
    


