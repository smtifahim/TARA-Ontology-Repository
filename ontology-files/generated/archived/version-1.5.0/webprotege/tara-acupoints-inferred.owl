        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSynonym>Spleen 14</tara:hasSynonym>
        <tara:hasVasculatureDescription>The eleventh intercostal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <rdfs:label>SP 14</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2003524 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2003524">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7010544"/>
