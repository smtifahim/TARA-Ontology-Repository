        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012197"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002228"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795302"/>
        <tara:hasSynonym>S 19</tara:hasSynonym>
        <tara:hasSynonym>Stomach 19</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the seventh intercostal artery and vein, the branches of the superior epigastric artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 19</rdfs:label>
    </owl:Class>
    


