        <tara:hasSynonym>Gallbladder 34</tara:hasSynonym>
        <tara:hasVasculatureDescription>The inferior lateral genicular artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
