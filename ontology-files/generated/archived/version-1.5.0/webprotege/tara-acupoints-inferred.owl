        <tara:hasChineseLabel>漏谷</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003823"/>
        <tara:hasIndicationsDescription>abdominal distension, borborygmus, coldness, numbness and paralysis of the knee and leg.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>Superficially, the medial crural cutaneous nerve; deeper, in the posterior aspect, the tibial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the tibial aspect of the leg, posterior to the medial border of the tibia, 6 B-cun superior to the prominence of the medial malleolus. Note: 3 B-cun superior to SP6.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Lougu</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001538"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001323"/>
