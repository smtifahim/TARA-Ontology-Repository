        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 62. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 7, Acupuncture Points of the Taiyin and Yangming Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>陰(阴)市</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000376"/>
        <tara:hasIndicationsDescription>numbness, soreness, motor impairment of the leg and knee, motor impairment of the lower extremities.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anterior and lateral femoral cutaneous nerves.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the anterolateral aspect of the thigh, lateral to the rectus femoris tendon, 3 B-cun superior to the base of the patella. Note: ST33 is at the midpoint of the line connecting St32 with the lateral end of the base of the patella.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.7-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Yinshi</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://uri.interlex.org/base/ilx_0797501"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794999"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0797481"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002446"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0014848"/>
        <tara:hasSynonym>S 33</tara:hasSynonym>
        <tara:hasSynonym>Stomach 33</tara:hasSynonym>
        <tara:hasVasculatureDescription>The descending branch of the lateral circumflex femoral artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 33</rdfs:label>
    </owl:Class>
    


