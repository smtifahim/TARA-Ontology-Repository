    <!-- http://www.acupunctureresearch.org/tara/ontology/hasAcupointDescription -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasAcupointDescription">
        <dc:description>An annotation property grouping all textual descriptive attributes of an acupoint, including its anatomical location, needling method, indications, vasculature, and innervation. Subproperties further specialize the type of description.</dc:description>
        <rdfs:label>Acupoint Description</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointAnnotaionProperty"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureModality -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureModality">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasAssociatedOrgan -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasAssociatedOrgan">
        <dc:description>An annotation property that records the organ a Meridian is associated with according to traditional Chinese medicine theory, as a simple textual/IRI annotation (e.g., Lung Meridian: Lung). Corresponds to the object property tara-op:hasAssociatedOrgan, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: Lung Meridian hasAssociatedOrgan &apos;Lung&apos;.</rdfs:comment>
        <rdfs:label>Associated Organ</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointAnnotaionProperty"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasAuthor -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasAuthor">
        <rdfs:label>Author(s)</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/creator"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasChineseLabel -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasChineseLabel">
        <rdfs:label>Chinese Label</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000118"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasControlsInformation -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasControlsInformation">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasCountryInformation -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasCountryInformation">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasDOI -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasDOI">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/identifier"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasEnglishLabel -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasEnglishLabel">
        <rdfs:label>English Label</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000118"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasFigureSource -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasFigureSource">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/source"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasGeneralSurfaceLocation -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasGeneralSurfaceLocation">
        <dc:description>An annotation property that records the general body region on whose surface an Acupoint is located, as a simple textual/IRI annotation (e.g., LU 1: Anterior Thoracic Region). Corresponds to the object property tara-op:hasGeneralSurfaceLocation, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: LU1 hasGeneralSurfaceLocation &apos;Anterior Thoracic Region&apos;.</rdfs:comment>
        <rdfs:label>General Surface Location</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasRelatedSurfaceAnatomy"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasIndicationsDescription -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasIndicationsDescription">
        <dc:description>An annotation property that lists the clinical conditions and symptoms for which an acupoint is indicated according to traditional Chinese medicine (e.g., LU 1: &apos;Cough, asthma, pain in the chest, shoulder and back; fullness of the chest.&apos;).</dc:description>
        <rdfs:label>Indications</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointDescription"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasInnervationDescription -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasInnervationDescription">
        <dc:description>An annotation property that describes the nerve supply in the vicinity of an acupoint relevant to safe needling (e.g., LU 1: &apos;The intermediate supraclavicular nerve, the branches of the anterior thoracic nerve, and the lateral cutaneous branch of the first intercostal nerve.&apos;).</dc:description>
        <rdfs:label>Innervation</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointDescription"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasListedAcupointsUsed -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasListedAcupointsUsed">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasLocationalDescription -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasLocationalDescription">
        <dc:description>An annotation property that provides the canonical textual description of an acupoint&apos;s anatomical location on the body surface (e.g., LU 1: &apos;On the anterior thoracic region, at the same level as the first intercostal space, lateral to the infraclavicular fossa, 6 B-cun lateral to the anterior median line.&apos;). Values follow the WHO Standard Acupuncture Point Locations where available.</dc:description>
        <rdfs:label>Acupuncture Location</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointDescription"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasMethodDescription -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasMethodDescription">
        <dc:description>An annotation property that describes the recommended needling method for an acupoint, including needle angle, depth, and applicability of moxibustion (e.g., LU 1: &apos;Puncture obliquely 0.5-0.8 cun towards the lateral aspect of the chest. To avoid injuring the lung, never puncture deeply towards the medial aspect. Moxibustion is applicable.&apos;).</dc:description>
        <rdfs:label>Acupuncture Method</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointDescription"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasNeedlingInformation -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasNeedlingInformation">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasPinyinLabel -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasPinyinLabel">
        <rdfs:label>Pinyin Label</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000118"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasPublicationDate -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasPublicationDate">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/date"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasPublicationVenue -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasPublicationVenue">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/relation"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasReference -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasReference">
        <rdfs:label>Reference</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/bibliographicCitation"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasRelatedArtery -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasRelatedArtery">
        <dc:description>An annotation property that records a specific artery occupying an Acupoint&apos;s location, as a simple textual/IRI annotation (e.g., LU 1: Axillary Artery). Corresponds to the object property tara-op:hasRelatedArtery, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: LU1 hasRelatedArtery &apos;Axillary Artery&apos;.</rdfs:comment>
        <rdfs:label>Related Artery</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasRelatedVasculature"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasRelatedInnervation -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasRelatedInnervation">
        <dc:description>An annotation property that records the nerve(s) supplying an Acupoint&apos;s location, as simple textual/IRI annotations. Corresponds to the object property tara-op:hasRelatedInnervation, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: LU1 hasRelatedInnervation &apos;Intermediate Supraclavicular Nerve&apos;.</rdfs:comment>
        <rdfs:label>Related Innervation</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasRelatedSubSurfaceAnatomy"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasRelatedNerve -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasRelatedNerve">
        <dc:description>An annotation property that records a specific nerve occupying an Acupoint&apos;s location, as a simple textual/IRI annotation (e.g., LU 1: Intermediate Supraclavicular Nerve). Corresponds to the object property tara-op:hasRelatedNerve, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: LU1 hasRelatedNerve &apos;Intermediate Supraclavicular Nerve&apos;.</rdfs:comment>
        <rdfs:label>Related Nerve</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasRelatedInnervation"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasRelatedSubSurfaceAnatomy -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasRelatedSubSurfaceAnatomy">
        <dc:description>An annotation property that records the nerves, arteries, and veins occupying an Acupoint&apos;s location, as simple textual/IRI annotations. Corresponds to the object property tara-op:hasRelatedSubSurfaceAnatomy, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: LU1 hasRelatedSubSurfaceAnatomy &apos;Axillary Artery&apos;.</rdfs:comment>
        <rdfs:label>Related Subsurface Anatomy</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasTopographicalAnatomy"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasRelatedSurfaceAnatomy -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasRelatedSurfaceAnatomy">
        <dc:description>An annotation property that records the surface anatomical regions and landmarks associated with an Acupoint&apos;s location, as simple textual/IRI annotations, without the mereological commitment of the corresponding object property. Corresponds to the object property tara-op:hasRelatedSurfaceAnatomy, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: LU1 hasRelatedSurfaceAnatomy &apos;Anterior Thoracic Region&apos;.</rdfs:comment>
        <rdfs:label>Related Surface Anatomy</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasTopographicalAnatomy"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasRelatedVasculature -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasRelatedVasculature">
        <dc:description>An annotation property that records the blood vessel(s) present at an Acupoint&apos;s location, as simple textual/IRI annotations. Corresponds to the object property tara-op:hasRelatedVasculature, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: LU1 hasRelatedVasculature &apos;Axillary Artery&apos;.</rdfs:comment>
        <rdfs:label>Related Vasculature</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasRelatedSubSurfaceAnatomy"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasRelatedVein -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasRelatedVein">
        <dc:description>An annotation property that records a specific vein occupying an Acupoint&apos;s location, as a simple textual/IRI annotation (e.g., LU 1: Axillary Vein). Corresponds to the object property tara-op:hasRelatedVein, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: LU1 hasRelatedVein &apos;Axillary Vein&apos;.</rdfs:comment>
        <rdfs:label>Related Vein</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasRelatedVasculature"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasSampleSizeInformation -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasSampleSizeInformation">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointDesignation -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointDesignation">
        <dc:description>An annotation property, reserved for potential future use, that would record a special point designation for an Acupoint as a textual annotation, distinct from the realized role recorded by hasSpecialPointRole. Not currently populated in this ontology. Corresponds to the reserved object property tara-op:hasSpecialPointDesignation.</dc:description>
        <rdfs:comment>Reserved; not currently used. If used: LU1 hasSpecialPointDesignation &apos;Front-Mu Point of the Lung&apos;.</rdfs:comment>
        <rdfs:label>Special Point Designation</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointAnnotaionProperty"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointRole -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasSpecialPointRole">
        <dc:description>An annotation property that records the named special point role(s) designated to an acupoint as a textual annotation (e.g., LU 1: Front-Mu Point of the Lung; LU 5: He-Sea Point). Corresponds to the object property tara-op:hasSpecialPointRole, which is used for the logical classification of Special Points.</dc:description>
        <rdfs:comment>Example: LU1 hasSpecialPointRole &apos;Front-Mu Point of the Lung&apos;.</rdfs:comment>
        <rdfs:label>Special Point Role</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointAnnotaionProperty"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasSpecificSurfaceLocation -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasSpecificSurfaceLocation">
        <dc:description>An annotation property that records the specific anatomical landmarks within the general surface region of an Acupoint, as simple textual/IRI annotations (e.g., LU 1: Infraclavicular Fossa, First Intercostal Space, Anterior Median Line). Corresponds to the object property tara-op:hasSpecificSurfaceLocation, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: LU1 hasSpecificSurfaceLocation &apos;Infraclavicular Fossa&apos;.</rdfs:comment>
        <rdfs:label>Specific Surface Location</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasRelatedSurfaceAnatomy"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasStimulationType -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasStimulationType">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasStudiedCondition -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasStudiedCondition">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasStudiedConditionContext -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasStudiedConditionContext">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasStudiedConditionNote -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasStudiedConditionNote">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasSynonym -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasSynonym">
        <rdfs:label>Synonym</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000118"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasTopographicalAnatomy -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasTopographicalAnatomy">
        <dc:description>An annotation property that groups all textual/simple annotations relating an Acupoint to the surface and subsurface anatomical entities associated with its location and needling. Corresponds to the object property tara-op:hasTopographicalAnatomy, which is the root of the corresponding logical property hierarchy.</dc:description>
        <rdfs:comment>Example: LU1 hasTopographicalAnatomy &apos;Anterior Thoracic Region&apos;.</rdfs:comment>
        <rdfs:label>Topographical Anatomy</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointAnnotaionProperty"/>
        <rdfs:domain rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1132428"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasTrialType -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasTrialType">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasUsedAcupoint -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasUsedAcupoint">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/hasVasculatureDescription -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/hasVasculatureDescription">
        <dc:description>An annotation property that describes the blood vessels in the vicinity of an acupoint relevant to safe needling (e.g., LU 1: &apos;Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein.&apos;).</dc:description>
        <rdfs:label>Vasculature</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointDescription"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/isLocatedOnMeridian -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/isLocatedOnMeridian">
        <dc:description>An annotation property that records the Meridian along which an Acupoint is located, as a simple textual/IRI annotation (e.g., LU 1: Lung Meridian). Corresponds to the object property tara-op:isLocatedOnMeridian, which is used for logical axioms.</dc:description>
        <rdfs:comment>Example: LU1 isLocatedOnMeridian &apos;Lung Meridian&apos;.</rdfs:comment>
        <rdfs:label>Located On Meridian</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupointAnnotaionProperty"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/isStudiedInArticle -->

    <owl:AnnotationProperty rdf:about="http://www.acupunctureresearch.org/tara/ontology/isStudiedInArticle">
        <rdfs:subPropertyOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/hasAcupunctureSpecificMetadata"/>
        <rdfs:domain rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1132428"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#created_by -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#created_by">
        <rdfs:label>created by</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#creation_date -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#creation_date">
        <rdfs:label>creation date</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#hasAlternativeId -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasAlternativeId">
        <rdfs:label>has_alternative_id</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym">
        <obo:IAO_0000115>An alternative label for a class or property which has a more general meaning than the preferred name/primary label.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has broad synonym</rdfs:label>
        <rdfs:label>has_broad_synonym</rdfs:label>
        <rdfs:seeAlso>https://github.com/information-artifact-ontology/ontology-metadata/issues/18</rdfs:seeAlso>
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000118"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#hasDbXref -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasDbXref">
        <obo:IAO_0000112>disease characteristic (MONDO:0021125) has cross-reference (http://www.geneontology.org/formats/oboInOwl#hasDbXref) &quot;NCIT:C41009&quot;^^xsd:string</obo:IAO_0000112>
        <obo:IAO_0000115>An annotation property that links an ontology entity or a statement to a prefixed identifier or URI.</obo:IAO_0000115>
        <dcterms:contributor rdf:resource="https://orcid.org/0000-0002-7356-1779"/>
        <rdfs:label>database_cross_reference</rdfs:label>
        <rdfs:label>has cross-reference</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://www.geneontology.org/formats/oboInOwl#hasExactSynonym -->

    <owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym">
        <obo:IAO_0000115>An alternative label for a class or property which has the exact same meaning than the preferred name/primary label.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has exact synonym</rdfs:label>
        <rdfs:label>has_exact_synonym</rdfs:label>
