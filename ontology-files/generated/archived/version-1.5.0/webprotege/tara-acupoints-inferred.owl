    <!-- http://purl.obolibrary.org/obo/UBERON_0001423 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001423">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003466"/>
