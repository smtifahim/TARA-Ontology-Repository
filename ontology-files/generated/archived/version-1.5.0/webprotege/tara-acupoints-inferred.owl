            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any synovial joint that is part of a (free) limb.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>FMA:258776</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>synovial joint of free limb segment</OboInOwl:hasExactSynonym>
        <rdfs:comment>Most limb joints are synovial, but a few such as the tibiofibular joints are syndesmoses.</rdfs:comment>
        <rdfs:label>synovial limb joint</rdfs:label>
    </owl:Class>
    


