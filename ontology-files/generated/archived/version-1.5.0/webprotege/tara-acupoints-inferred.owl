        <tara:hasChineseLabel>二間(间)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003622"/>
        <tara:hasIndicationsDescription>blurred vision, epistaxis, toothache, sore throat, febrile diseases.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The dorsal digital nerve of the radial nerve, and the palmar digital proper nerve of the median nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the index finger, in the depression distal to the radial side of the second metacarpophalangeal joint, at the border between the red and white flesh.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.2-0.3 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Erjian</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006137"/>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006163"/>
