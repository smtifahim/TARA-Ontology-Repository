        <tara:hasSynonym>Triple Energizer 10</tara:hasSynonym>
        <tara:hasSynonym>Triple Heater 10</tara:hasSynonym>
        <tara:hasSynonym>Triple Warmer 10</tara:hasSynonym>
        <tara:hasVasculatureDescription>The arterial and venous network of the elbow.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <rdfs:label>TE 10</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7524444 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7524444">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_4598552"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9345451"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4598552"/>
        <dc:description>The Xi-Cleft Point of the Yin Heel Vessel (an extra meridian). The Xi-Cleft Point is the site where the qi and blood of the meridian are deeply converged. The Xi-Cleft Point is used to treat acute disorders in the area supplied by its pertaining meridian and those of its pertaining zang or fu organ.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9345451"/>
        <rdfs:label>Xi-Cleft Point of the Yin Heel Vessel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7525476 -->

