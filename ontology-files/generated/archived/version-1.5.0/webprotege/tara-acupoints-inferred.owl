        <tara:hasSynonym>RN 19</tara:hasSynonym>
        <tara:hasSynonym>Ren 19</tara:hasSynonym>
        <tara:hasSynonym>VC 19</tara:hasSynonym>
        <tara:hasVasculatureDescription>The anterior perforating branches of the internal mammary artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>CV 19</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_5996486 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_5996486">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_8746709"/>
