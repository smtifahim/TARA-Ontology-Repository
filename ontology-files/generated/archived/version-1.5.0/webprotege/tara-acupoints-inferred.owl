        <tara:hasInnervationDescription>The anterior and lateral cutaneous branch of the fourth intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the anterior thoracic region, at the centre of the nipple. Note: In males, the centre of the nipple is located in the fourth intercostal space.</tara:hasLocationalDescription>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0784694"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002030"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795298"/>
        <tara:hasSynonym>Stomach 17 (Male)</tara:hasSynonym>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
        <rdfs:label>ST 17 (Male)</rdfs:label>
    </owl:Class>
    


