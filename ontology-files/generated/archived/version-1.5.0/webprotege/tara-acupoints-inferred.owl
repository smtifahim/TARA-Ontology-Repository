        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 160. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>外關(关,関)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002386"/>
        <tara:hasIndicationsDescription>febrile diseases, headache, pain in the cheek, strained neck, deafness, tinnitus, pain in the hypochondriac region, motor impairment of the elbow and arm, pain of the fingers, hand tremor.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The posterior antebrachial cutaneous nerve; deeper, the posterior interosseous nerve and the anterior interosseous nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posterior aspect of the forearm, midpoint of the interosseous space between the radius and the ulna, 2 B-cun proximal to the dorsal wrist crease. Note: 2 B-cun proximal to TE4, in the depression between the radius and the ulna. The anterior point corresponding to TE5 is PC6.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Waiguan</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6993030"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9493899"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001423"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001424"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006508"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795333"/>
        <tara:hasSynonym>SJ 5</tara:hasSynonym>
        <tara:hasSynonym>San Jiao 5</tara:hasSynonym>
        <tara:hasSynonym>TB 5</tara:hasSynonym>
        <tara:hasSynonym>TH 5</tara:hasSynonym>
        <tara:hasSynonym>TW 5</tara:hasSynonym>
        <tara:hasSynonym>Triple Burner 5</tara:hasSynonym>
        <tara:hasSynonym>Triple Energizer 5</tara:hasSynonym>
        <tara:hasSynonym>Triple Heater 5</tara:hasSynonym>
        <tara:hasSynonym>Triple Warmer 5</tara:hasSynonym>
        <tara:hasVasculatureDescription>Deeper, the posterior and anterior antebrachial interosseous arteries and veins.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <rdfs:label>TE 5</rdfs:label>
    </owl:Class>
    


