    <!-- http://purl.obolibrary.org/obo/UBERON_0001300 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001300">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0005156"/>
