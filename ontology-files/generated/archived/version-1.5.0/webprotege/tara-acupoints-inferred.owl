        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001373"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002060"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002446"/>
        <tara:hasSynonym>Spleen 11</tara:hasSynonym>
        <tara:hasVasculatureDescription>Superficially, the great saphenous vein; deeper on the lateral side, the femoral artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4167850"/>
        <rdfs:label>SP 11</rdfs:label>
    </owl:Class>
    


