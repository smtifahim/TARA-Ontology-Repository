        <OboInOwl:hasExactSynonym>flexor carpi ulnaris</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>musculus flexor carpi ulnaris</OboInOwl:hasRelatedSynonym>
