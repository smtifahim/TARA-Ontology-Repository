        <tara:hasSynonym>UB 36</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 36</tara:hasSynonym>
        <tara:hasVasculatureDescription>The artery and vein running alongside the sciatic nerve.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 36</rdfs:label>
    </owl:Class>
    


