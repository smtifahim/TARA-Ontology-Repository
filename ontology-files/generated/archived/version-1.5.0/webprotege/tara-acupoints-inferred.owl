        <OboInOwl:hasDbXref>Wikipedia:Sacrum</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>galen:Sacrum</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>os sacrum [vertebrae sacrales I - V]</OboInOwl:hasExactSynonym>
