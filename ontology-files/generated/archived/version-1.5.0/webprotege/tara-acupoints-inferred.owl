        <tara:hasChineseLabel>陰(阴)谷</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001465"/>
        <tara:hasIndicationsDescription>impotence, hernia, uterine bleeding, dysuria, pain in the knee and popliteal fossa, mental disorder.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial femoral cutaneous nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posteromedial aspect of the knee, just lateral to the semitendinosus tendon, in the popliteal crease.</tara:hasLocationalDescription>
        <tara:hasPinyinLabel>Yingu</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
