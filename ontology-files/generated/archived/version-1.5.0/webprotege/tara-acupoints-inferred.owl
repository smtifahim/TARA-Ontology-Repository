        <tara:hasSynonym>LV 12</tara:hasSynonym>
        <tara:hasSynonym>Liver 12</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the external pudendal artery and vein, the pubic branches of the inferior epigastric artery and vein; laterally, the femoral veIn.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5419503"/>
        <rdfs:label>LR 12</rdfs:label>
    </owl:Class>
    


