        <tara:hasSynonym>G 17</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 17</tara:hasSynonym>
        <tara:hasVasculatureDescription>The anastomotic plexus formed by the parietal branches of the superficial temporal artery and vein and the occipital artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 17</rdfs:label>
    </owl:Class>
    


