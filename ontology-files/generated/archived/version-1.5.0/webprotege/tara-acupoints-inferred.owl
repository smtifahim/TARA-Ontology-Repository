        <tara:hasChineseLabel>維(维)道(道)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795303"/>
        <tara:hasIndicationsDescription>leukorrhea, lower abdominal pain, hernia, prolapse of the uterus.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The ilioinguinal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the lower abdomen, 0.5 B-cun medioin- ferior to the anterior superior iliac spine. Note: GB28 is 0.5 B-cun medioinferior to gB27.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Weidao</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0013708"/>
        <tara:hasSynonym>G 28</tara:hasSynonym>
        <tara:hasSynonym>Gallbladder 28</tara:hasSynonym>
        <tara:hasVasculatureDescription>The superficial and deep circumflex iliac arteries and veins.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5283975"/>
        <rdfs:label>GB 28</rdfs:label>
    </owl:Class>
    


