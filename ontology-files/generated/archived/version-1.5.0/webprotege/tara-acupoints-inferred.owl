        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795326"/>
        <tara:hasSynonym>Du 18</tara:hasSynonym>
        <tara:hasSynonym>Governor Vessel 18</tara:hasSynonym>
        <tara:hasSynonym>VG 18</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the occipital arteries and veins of the both sides.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <rdfs:label>GV 18</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7596288 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7596288">
