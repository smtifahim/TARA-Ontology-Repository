        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795300"/>
        <tara:hasSynonym>Stomach 18 (Female)</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the intercostal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6221269"/>
