        </rdfs:subClassOf>
        <obo:IAO_0000115>The subdivision of the skeleton that consists of all the skeletal elements at the distalmost end of the pedal autopodium - i.e. the bones of the foot or their cartilaginous precursors[cjm].</obo:IAO_0000115>
        <OboInOwl:hasDbXref>FMA:78512</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VSAO:0005030</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Phalanges_of_the_foot</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>all phalanges in hindlimb autopod</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>foot digit skeleton</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>hind acropodium skeleton</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>pedal phalanges</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>phalanges of foot</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>phalanges of pes</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>posterior acropodium skeleton</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>set of pedal phalanges</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>set of phalanges of foot</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>set of phalanges of pes</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>posterior acropodium</OboInOwl:hasRelatedSynonym>
        <rdfs:label>skeleton of pedal acropodium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0010703 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0010703">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011584"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
