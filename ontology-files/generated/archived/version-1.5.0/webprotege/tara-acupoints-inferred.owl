        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 196. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>行間(间)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002387"/>
        <tara:hasIndicationsDescription>pain in the hypochondrium, abdominal distension, headache, dizziness and vertigo, congestion, swelling and pain of the eye, deviation of the mouth, hernia, painful urination, retention of urine, irregular menstruation, epilepsy, insomnia, convulsion.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The site where the dorsal digital nerves split from the lateral dorsal metatarsal nerve of the deep peroneal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the dorsum of the foot, between the first and second toes, proximal to the web margin, at the border between the red and white flesh.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Xingjian</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9857829"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003631"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003632"/>
        <tara:hasSynonym>LIV 2</tara:hasSynonym>
        <tara:hasSynonym>LV 2</tara:hasSynonym>
        <tara:hasSynonym>Liver 2</tara:hasSynonym>
        <tara:hasVasculatureDescription>The dorsal venous network of the foot and the first dorsal digital artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5419503"/>
        <rdfs:label>LR 2</rdfs:label>
    </owl:Class>
    


