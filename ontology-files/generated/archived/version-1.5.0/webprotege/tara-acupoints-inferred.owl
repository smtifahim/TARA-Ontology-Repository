        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSynonym>B 22</tara:hasSynonym>
        <tara:hasSynonym>Back-Shu Point of Triple Energizer</tara:hasSynonym>
        <tara:hasSynonym>Bladder 22</tara:hasSynonym>
        <tara:hasSynonym>UB 22</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 22</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior branches of the first lumber artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 22</rdfs:label>
    </owl:Class>
    


