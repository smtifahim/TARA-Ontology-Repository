        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 129. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>崑(昆)崙(侖,仑)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004454"/>
        <tara:hasIndicationsDescription>headache, blurred vision, neck rigidity, epistaxis, pain in the shoulder, back and arm, swelling and pain of the heel, difficult labor, epilepsy.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The sural nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posterolateral aspect of the ankle, in the depression between the prominence of the lateral malleolus and the calcaneal tendon.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Kunlun</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7315457"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003701"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0012291"/>
        <tara:hasSynonym>B 60</tara:hasSynonym>
        <tara:hasSynonym>Bladder 60</tara:hasSynonym>
        <tara:hasSynonym>UB 60</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 60</tara:hasSynonym>
        <tara:hasVasculatureDescription>The small saphenous vein, the posteroexternal malleolar artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 60</rdfs:label>
    </owl:Class>
    


