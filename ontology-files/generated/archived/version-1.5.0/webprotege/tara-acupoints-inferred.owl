        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002387"/>
        <tara:hasIndicationsDescription>pain of the canthus, tinnitus, distending pain of the breast, swelling and pain of the dorsum of foot.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the dorsum of the foot, between the fourth and fifth metatarsal bones, in the depression proximal to the fourth metatarsophalangeal joint.</tara:hasLocationalDescription>
