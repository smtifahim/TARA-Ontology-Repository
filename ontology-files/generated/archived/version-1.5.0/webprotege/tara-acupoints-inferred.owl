        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma23879"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0736512"/>
        <OboInOwl:hasDbXref>FMA:23879</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:129140006</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VSAO:0000042</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>http://www.snomedbrowser.com/Codes/Details/129140006</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>skeletal subdivision</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>subdivision of skeleton (in vivo)</OboInOwl:hasRelatedSynonym>
