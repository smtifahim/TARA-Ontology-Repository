        <OboInOwl:hasRelatedSynonym>canthorum</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>canthus (anatomy)</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>canthus of eye</OboInOwl:hasRelatedSynonym>
        <rdfs:label>canthus</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/a/a9/Gray892.png</foaf:depiction>
