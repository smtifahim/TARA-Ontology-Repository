    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797524">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001021"/>
        <obo:IAO_0000115>A motor branch arising from the ansa cervicalis that innervates one or more infrahyoid muscles of the anterior neck.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma82555"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797524"/>
        <OboInOwl:hasExactSynonym>Muscular branch of ansa cervicalis</OboInOwl:hasExactSynonym>
        <rdfs:label>Branch of ansa cervicalis</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797525 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004563"/>
        <obo:IAO_0000115>Small superficial veins that drain the dorsal surfaces of the fingers or toes and empty into the dorsal venous networks of the hand or foot.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma70917"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797525"/>
        <OboInOwl:hasExactSynonym>Digital dorsal veins</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>Dorsal veins of digits</OboInOwl:hasExactSynonym>
        <rdfs:label>Dorsal digital veins</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797526 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001638"/>
        <obo:IAO_0000115>A superficial venous network on the dorsum of the hand that receives blood from the dorsal digital and metacarpal veins and contributes to the cephalic and basilic veins.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma67977"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797526"/>
        <OboInOwl:hasExactSynonym>Dorsal venous arch of hand</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>Dorsal venous rete of hand</OboInOwl:hasExactSynonym>
        <rdfs:label>Dorsal venous network of hand</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797527 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001637"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001404"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The first branch of the dorsal metacarpal arterial system, supplying the thumb, index finger, and adjacent dorsal hand. It commonly arises from the radial artery near the anatomical snuffbox.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001404"/>
        <ilxtr:hasExistingId rdf:resource="http://purl.org/sig/ont/fma/fma22761"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797527"/>
        <OboInOwl:hasExactSynonym>Arteria metacarpalis dorsalis prima</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>First dorsal metacarpal branch</OboInOwl:hasExactSynonym>
        <rdfs:label>First dorsal metacarpal artery</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797528 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001638"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001399"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A vein accompanying the radial collateral artery that drains the lateral arm and elbow region into the deep venous system of the arm.</obo:IAO_0000115>
        <base:ilx_0112785 rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001399"/>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797528"/>
        <OboInOwl:hasExactSynonym>Vena collateralis radialis</OboInOwl:hasExactSynonym>
        <rdfs:label>Radial collateral vein</rdfs:label>
    </owl:Class>
    


    <!-- http://uri.interlex.org/base/ilx_0797544 -->

    <owl:Class rdf:about="http://uri.interlex.org/base/ilx_0797544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004217"/>
        <obo:IAO_0000115>The lateral brachial cutaneous nerve is a collective anatomical term for two distinct sensory nerves—the superior and inferior lateral brachial cutaneous nerves—that provide somatic sensation to the skin on the lateral (outer) aspect of the upper arm.</obo:IAO_0000115>
        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0797544"/>
        <rdfs:label>Lateral brachial cutaneous nerve</rdfs:label>
    </owl:Class>
    


