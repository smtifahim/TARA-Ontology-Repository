                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001757"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A small pointed eminence of the external ear, situated in front of the concha, and projecting backward over the meatus.</obo:IAO_0000115>
        <OboInOwl:hasDbXref>FMA:60998</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C33801</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:362541003</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C0229312</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Tragus_(ear)</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>tragal part of pinna</OboInOwl:hasExactSynonym>
        <rdfs:label>tragus</rdfs:label>
    </owl:Class>
    


