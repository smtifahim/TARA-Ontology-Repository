        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 82. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>靑(青)靈(灵,霊)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001460"/>
        <tara:hasIndicationsDescription>pain in the cardiac and hypochondriac regions, shoulder and arm.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial antebrachial cutaneous nerve, the medial brachial cutaneous nerve and the ulnar nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the medial aspect of the arm, just medial to the biceps brachii muscle, 3 B-cun superior to the cubital crease. Note: With the elbow flexed and the arm abducted, Ht2 is located at the junction of the upper two thirds and lower one third of the line connecting Ht1 with Ht3.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Qingling</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://uri.interlex.org/base/ilx_0797506"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001494"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794952"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794953"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001411"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001507"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795332"/>
        <tara:hasSynonym>H 2</tara:hasSynonym>
        <tara:hasSynonym>HE 2</tara:hasSynonym>
        <tara:hasSynonym>Heart 2</tara:hasSynonym>
        <tara:hasVasculatureDescription>The basilic vein, the superior ulnar collateral artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009"/>
        <rdfs:label>HT 2</rdfs:label>
    </owl:Class>
    


