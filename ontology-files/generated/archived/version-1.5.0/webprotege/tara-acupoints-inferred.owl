        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006726"/>
        <tara:hasSynonym>Small Intestine 18</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the transverse facial artery and vein.</tara:hasVasculatureDescription>
