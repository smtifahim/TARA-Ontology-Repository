        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002497"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011187"/>
        <tara:hasSynonym>CO 15</tara:hasSynonym>
        <tara:hasSynonym>Colon 15</tara:hasSynonym>
        <tara:hasSynonym>Large Intestine 15</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior circumflex artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4610474"/>
        <rdfs:label>LI 15</rdfs:label>
    </owl:Class>
    


