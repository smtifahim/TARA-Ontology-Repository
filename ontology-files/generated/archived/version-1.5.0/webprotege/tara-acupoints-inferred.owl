        <ilxtr:hasExistingId rdf:resource="http://uri.interlex.org/base/ilx_0735438"/>
        <OboInOwl:hasDbXref>AAO:0011126</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EFO:0000881</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>EMAPA:32725</OboInOwl:hasDbXref>
