        <tara:hasSynonym>Bladder 2</tara:hasSynonym>
        <tara:hasSynonym>UB 2</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 2</tara:hasSynonym>
        <tara:hasVasculatureDescription>The frontal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 2</rdfs:label>
    </owl:Class>
    


