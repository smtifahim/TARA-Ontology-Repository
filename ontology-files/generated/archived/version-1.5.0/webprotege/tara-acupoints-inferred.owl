        <tara:hasSynonym>LI</tara:hasSynonym>
        <tara:hasSynonym>Large Intestine Meridian of Hand-Yangming</tara:hasSynonym>
        <tara:hasSynonym>meridian of the large intestine</tara:hasSynonym>
        <rdfs:label>Large Intestine Meridian</rdfs:label>
    </owl:Class>
    


