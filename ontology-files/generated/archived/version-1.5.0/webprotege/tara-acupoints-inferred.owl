        <tara:hasSynonym>Pericardium 1</tara:hasSynonym>
        <tara:hasVasculatureDescription>The thoracoepigastric vein, the branches of the lateral thoracic artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4694897"/>
        <rdfs:label>PC 1</rdfs:label>
    </owl:Class>
    


