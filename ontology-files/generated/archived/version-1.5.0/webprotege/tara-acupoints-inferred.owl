        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 166. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 9, Acupuncture Points of the Jueyin and Shaoyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>瘈脈(脉)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>headache, tinnitus, deafness, infantile convulsion.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The posterior auricular branch of the great auricular nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, at the centre of the mastoid process, at the junction of the upper two thirds and lower one third of the curved line from tE17 to tE20.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch or prick with a three-edged needle to cause bleeding. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Chimai</tara:hasPinyinLabel>
        <tara:hasPinyinLabel>Qimai</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011220"/>
        <tara:hasSynonym>SJ 18</tara:hasSynonym>
        <tara:hasSynonym>San Jiao 18</tara:hasSynonym>
        <tara:hasSynonym>TB 18</tara:hasSynonym>
        <tara:hasSynonym>TH 18</tara:hasSynonym>
        <tara:hasSynonym>TW 18</tara:hasSynonym>
        <tara:hasSynonym>Triple Burner 18</tara:hasSynonym>
        <tara:hasSynonym>Triple Energizer 18</tara:hasSynonym>
        <tara:hasSynonym>Triple Heater 18</tara:hasSynonym>
        <tara:hasSynonym>Triple Warmer 18</tara:hasSynonym>
        <tara:hasVasculatureDescription>The posterior auricular artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3898257"/>
        <rdfs:label>TE 18</rdfs:label>
    </owl:Class>
    


