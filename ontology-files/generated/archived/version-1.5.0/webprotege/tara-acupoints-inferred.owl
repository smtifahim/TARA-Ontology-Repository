        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>上星</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>headache, ophthalmalgia, epistaxis, rhinorrhea, mental disorder.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branch of the frontal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the head, 1 B-cun superior to the anterior hairline, on the anterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch or prick to cause bleeding. This point is prohibited in infants with metopism. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Shangxing</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795285"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795292"/>
        <tara:hasSynonym>Du 23</tara:hasSynonym>
        <tara:hasSynonym>Governor Vessel 23</tara:hasSynonym>
        <tara:hasSynonym>VG 23</tara:hasSynonym>
        <tara:hasVasculatureDescription>The branches of the frontal artery and vein, and the branches of the superficial temporal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <rdfs:label>GV 23</rdfs:label>
    </owl:Class>
    


