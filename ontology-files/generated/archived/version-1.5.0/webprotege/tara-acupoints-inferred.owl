        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 91. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>小海(海)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001461"/>
        <tara:hasIndicationsDescription>headache, swelling of the cheek, pain in the nape, shoulder, arm and elbow, epilepsy.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branches of the medial antebrachial cutaneous nerve, the ulnar nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posteromedial aspect of the elbow, in the depression between the olecranon and the medial epicondyle of the humerus bone. Note: When the elbow is slightly flexed, SI 8 is located in the groove for the ulnar nerve.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Xiaohai</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://uri.interlex.org/base/ilx_0797506"/>
        <tara:hasRelatedArtery rdf:resource="http://uri.interlex.org/base/ilx_0797507"/>
        <tara:hasRelatedArtery rdf:resource="http://uri.interlex.org/base/ilx_0797509"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001494"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794953"/>
        <tara:hasRelatedVein rdf:resource="http://uri.interlex.org/base/ilx_0797508"/>
        <tara:hasRelatedVein rdf:resource="http://uri.interlex.org/base/ilx_0797512"/>
        <tara:hasRelatedVein rdf:resource="http://uri.interlex.org/base/ilx_0797513"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000976"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001494"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006806"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006810"/>
        <tara:hasSynonym>Small Intestine 8</tara:hasSynonym>
        <tara:hasVasculatureDescription>The superior and inferior ulnar collateral arteries and veins, the ulnar recurrent artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9093316"/>
        <rdfs:label>SI 8</rdfs:label>
    </owl:Class>
    


