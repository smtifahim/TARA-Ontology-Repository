                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/isLocatedOnMeridian"/>
                        <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_5151019"/>
        <dc:description>An acupuncture point that is located along the Governor Vessel (GV / Du Mai), one of the eight extraordinary vessels, which consists of 28 standardized acupoints beginning at GV 1 (Changqiang) in the perineal region midway between the tip of the coccyx and the anus, traveling up along the posterior midline of the body over the spine and across the top of the head, and ending at GV 28 (Yinjiao) in the oral cavity at the frenulum of the upper lip.</dc:description>
        <dcterms:bibliographicCitation>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <tara:hasSynonym>Acupoint of the Du channel</tara:hasSynonym>
        <tara:hasSynonym>Acupuncture point of the Du channel</tara:hasSynonym>
        <tara:hasSynonym>Du</tara:hasSynonym>
        <tara:hasSynonym>GV</tara:hasSynonym>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0386099"/>
        <rdfs:label>Acupoint of the Governor Vessel</rdfs:label>
    </owl:Class>
    


