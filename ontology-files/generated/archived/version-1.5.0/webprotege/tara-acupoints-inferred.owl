        <OboInOwl:hasRelatedSynonym>arteria subscapularis</OboInOwl:hasRelatedSynonym>
        <rdfs:label>subscapular artery</rdfs:label>
        <foaf:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/4/4c/Axillary_branches.PNG</foaf:depiction>
