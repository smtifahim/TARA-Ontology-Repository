        <OboInOwl:hasExactSynonym>finger distal segment</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>finger tip</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>fingertip</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>forelimb digit tip</OboInOwl:hasExactSynonym>
