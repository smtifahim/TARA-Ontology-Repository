            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7010544"/>
        <dc:description>One of the eight influential points, the Influential Point of Tendons can be employed to treat disorders of tendons. Yanglingquan (GB 34) is the Influential Point of tendons.</dc:description>
        <dcterms:bibliographicCitation>Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4591653"/>
        <rdfs:label>Influential Point of Tendons</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_2016600 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_2016600">
