                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 223. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>神(神)闕(阙)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795301"/>
        <tara:hasIndicationsDescription>abdominal pain, borborygmus, flaccid type of apoplexy, prolapse of the rectum, unchecked diarrhea.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The anterior cutaneous branch of the tenth intercostal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the upper abdomen, in the centre of the umbilicus.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture is prohibited! Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Shenque</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007118"/>
        <tara:hasSynonym>Conception Vessel 8</tara:hasSynonym>
        <tara:hasSynonym>RN 8</tara:hasSynonym>
        <tara:hasSynonym>Ren 8</tara:hasSynonym>
        <tara:hasSynonym>VC 8</tara:hasSynonym>
        <tara:hasVasculatureDescription>The inferior epigastric artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6789717"/>
        <rdfs:label>CV 8</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_9406515 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_9406515">
        <owl:equivalentClass>
            <owl:Class>
