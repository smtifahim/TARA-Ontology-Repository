        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>胃兪(俞)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0008231"/>
        <tara:hasIndicationsDescription>pain in the chest and hypochondriac and epigastric regions, anorexia, abdominal distension, borborygmus, diarrhea, nausea, vomiting.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial cutaneous branch of the posterior ramus of the twelfth thoracic nerve; deeper, its lateral branch.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>In the upper back region, at the same level as the inferior border of the spinous process of the 12th thoracic vertebra (T12), 1.5 B- cun lateral to the posterior median line.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture obliquely 0.5-0.8 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Weishu</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_1503026"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004636"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795312"/>
        <tara:hasSynonym>B 21</tara:hasSynonym>
        <tara:hasSynonym>Back-Shu Point of the Stomach</tara:hasSynonym>
        <tara:hasSynonym>Bladder 21</tara:hasSynonym>
        <tara:hasSynonym>UB 21</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 21</tara:hasSynonym>
        <tara:hasVasculatureDescription>The medial branches of the posterior branches of the subcostal artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 21</rdfs:label>
    </owl:Class>
    


