        <tara:hasChineseLabel>下巨虛(虚)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003823"/>
        <tara:hasIndicationsDescription>lower abdominal pain, backache referring to the testis, mastitis, numbness and paralysis of the lower extremities.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The branches of the superficial peroneal nerve and the deep peroneal nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the anterior aspect of the leg, on the line connecting ST35 with ST41, 9 B-cun inferior to ST35. Note: ST39 is located on the tibialis anterior muscle, at the same level as GB35 and gB36.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Xiajuxu</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001537"/>
        <tara:hasRelatedNerve rdf:resource="http://purl.obolibrary.org/obo/UBERON_0035207"/>
