        <OboInOwl:hasDbXref>SCTID:181300001</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VHOG:0001196</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>Wikipedia:Arch_of_aorta</OboInOwl:hasDbXref>
        <OboInOwl:hasExactSynonym>arcus aortae</OboInOwl:hasExactSynonym>
