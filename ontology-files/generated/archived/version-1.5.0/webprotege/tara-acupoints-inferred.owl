        <tara:hasVasculatureDescription>The branches of the superior epigastric artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_4813389"/>
        <rdfs:label>KI 18</rdfs:label>
    </owl:Class>
    


