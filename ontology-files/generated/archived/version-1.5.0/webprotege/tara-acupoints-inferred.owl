    <!-- http://purl.obolibrary.org/obo/UBERON_0001271 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001271">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007823"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015212"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002355"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010709"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The organism subdivision that includes the pelvic girdle skeleton and associated soft tissue. Note that this includes both the skeletal elements and associated tissues (integument, muscle, etc). Examples: There are only two instances in an organism, right and left pelvic girdle regions.</obo:IAO_0000115>
        <obo:IAO_0000232>this class describes the subdivision of the limb/fin, NOT the skeleton within. See also: skeleton of pectoral girdle (UBERON:0007831). See also comments on obo-anatomy mail list. Note that even though the class includes soft tissue it is more restrictive than &apos;pelvis&apos; which also includes structures in cavities etc. TODO this needs to be better documented</obo:IAO_0000232>
        <OboInOwl:hasDbXref>EMAPA:37862</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>FMA:16581</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C33291</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:360010001</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>UMLS:C0684083</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>VSAO:0000304</OboInOwl:hasDbXref>
        <OboInOwl:hasRelatedSynonym>girdle - pelvic</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>pelvic girdle</OboInOwl:hasRelatedSynonym>
        <rdfs:label>pelvic girdle region</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0001272 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001272">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007830"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0010428"/>
