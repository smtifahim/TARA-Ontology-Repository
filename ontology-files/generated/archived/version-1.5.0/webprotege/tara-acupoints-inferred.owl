        <tara:hasChineseLabel>強間(间)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000033"/>
        <tara:hasIndicationsDescription>headache, neck rigidity, blurred vision, mania.</tara:hasIndicationsDescription>
        <tara:hasLocationalDescription>On the head, 4 B-cun superior to the posterior hairline, on the posterior median line. Note: GV18 is located in the depression 1.5 B-cun superior to gV17.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture subcutaneously 0.3-0.5 inch. Moxibustion is applicable.</tara:hasMethodDescription>
