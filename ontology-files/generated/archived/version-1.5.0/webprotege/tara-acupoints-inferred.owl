        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 83. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>少海(海)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001461"/>
        <tara:hasIndicationsDescription>cardiac pain, spasmodic pain and numbness of the hand and arm, tremor of the hand, scrofula, pain in the axilla and hypochondriac region.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The medial antebrachial cutaneous nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the anteromedial aspect of the elbow, just anterior to the medial epicondyle of the humerus, at the same level as the cubital crease. Note: With the elbow is flexed, HT3 is located at the midpoint of the line connecting the medial end of the cubital crease and the medial epicondyle of the humerus.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-1.0 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Shaohai</tara:hasPinyinLabel>
        <tara:hasRelatedArtery rdf:resource="http://uri.interlex.org/base/ilx_0797506"/>
        <tara:hasRelatedArtery rdf:resource="http://uri.interlex.org/base/ilx_0797507"/>
        <tara:hasRelatedNerve rdf:resource="http://uri.interlex.org/base/ilx_0794953"/>
        <tara:hasRelatedVein rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001411"/>
        <tara:hasRelatedVein rdf:resource="http://uri.interlex.org/base/ilx_0797508"/>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_6594221"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0006806"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://uri.interlex.org/base/ilx_0795332"/>
        <tara:hasSynonym>H 3</tara:hasSynonym>
        <tara:hasSynonym>HE 3</tara:hasSynonym>
        <tara:hasSynonym>Heart 3</tara:hasSynonym>
        <tara:hasVasculatureDescription>The basilic vein, the inferior ulnar collateral artery, the ulnar recurrent artery and vein.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_9474009"/>
        <rdfs:label>HT 3</rdfs:label>
    </owl:Class>
    


