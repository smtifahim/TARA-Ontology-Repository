    <!-- http://purl.obolibrary.org/obo/UBERON_0001533 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0001533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004120"/>
