        <tara:hasChineseLabel>臑會(会)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001460"/>
        <tara:hasIndicationsDescription>goiter, pain in the shoulder and arm.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The posterior brachial cutaneous nerve, the muscular branch of the radial nerve; deeper, the radial nerve.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the posterior aspect of the arm, posteroinferior to the border of the deltoid muscle, 3 B-cun inferior to the acromial angle.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture perpendicularly 0.5-0.8 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Naohui</tara:hasPinyinLabel>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001476"/>
