        <OboInOwl:hasDbXref>MA:0002217</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>NCIT:C33546</OboInOwl:hasDbXref>
        <OboInOwl:hasDbXref>SCTID:181404009</OboInOwl:hasDbXref>
