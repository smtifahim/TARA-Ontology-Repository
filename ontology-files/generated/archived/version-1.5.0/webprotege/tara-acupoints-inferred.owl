    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0013691 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0013691">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015212"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0034929"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001271"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
