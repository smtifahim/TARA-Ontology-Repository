        <OboInOwl:hasExactSynonym>pelvic girdle plus pelvic limb or fin</OboInOwl:hasExactSynonym>
        <OboInOwl:hasExactSynonym>pelvic girdle plus posterior limb or fin</OboInOwl:hasExactSynonym>
        <OboInOwl:hasRelatedSynonym>lower limb</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>lower limb and pelvic girdle</OboInOwl:hasRelatedSynonym>
        <OboInOwl:hasRelatedSynonym>lower limb and pelvis</OboInOwl:hasRelatedSynonym>
        <rdfs:label>pelvic complex</rdfs:label>
    </owl:Class>
    


