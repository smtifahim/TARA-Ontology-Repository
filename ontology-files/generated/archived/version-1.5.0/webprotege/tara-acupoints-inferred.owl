    <!-- http://purl.obolibrary.org/obo/UBERON_0002500 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0002500">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003462"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011164"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015212"/>
        <obo:IAO_0000115>The bony arch in vertebrates that extends along the side or front of the skull beneath the eye socket and is formed by the temporal process of the zygomatic bone and the zygomatic process of the temporal bone.</obo:IAO_0000115>
