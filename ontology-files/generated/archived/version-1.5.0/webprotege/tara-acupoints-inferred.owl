                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003635"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole"/>
                <owl:someValuesFrom rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_3839815"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecificSurfaceLocation"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009567"/>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <dcterms:bibliographicCitation>[Acupoint Location, Pinyin Label, Chinese Label] WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 133. https://iris.who.int/handle/10665/353407</dcterms:bibliographicCitation>
        <dcterms:bibliographicCitation>[Acupuncture Method, Vasculature, Innervation, Indications] Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 8, Acupuncture Points of the Shaoyin and Taiyang Meridians. ISBN 978-7-119-01758-7.</dcterms:bibliographicCitation>
        <tara:hasChineseLabel>至陰(阴)</tara:hasChineseLabel>
        <tara:hasGeneralSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003635"/>
        <tara:hasIndicationsDescription>headache, nasal obstruction, epistaxis, ophthalmalgia, malposition of fetus, difficult labor, detention of after birth, feverish sensation in the sole.</tara:hasIndicationsDescription>
        <tara:hasInnervationDescription>The plantar digital proprial nerve and the lateral dorsal cutaneous nerve of foot.</tara:hasInnervationDescription>
        <tara:hasLocationalDescription>On the little toe, lateral to the distal pha- lanx, 0.1 f-cun proximal to the lateral corner of the toenail; at the intersection of the vertical line of the lateral side of the nail and the horizontal line of the base of the toenail.</tara:hasLocationalDescription>
        <tara:hasMethodDescription>Puncture superficially 0.1 inch. Moxibustion is applicable.</tara:hasMethodDescription>
        <tara:hasPinyinLabel>Zhiyin</tara:hasPinyinLabel>
        <tara:hasSpecialPointRole rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_2954517"/>
        <tara:hasSpecificSurfaceLocation rdf:resource="http://purl.obolibrary.org/obo/UBERON_0009567"/>
        <tara:hasSynonym>B 67</tara:hasSynonym>
        <tara:hasSynonym>Bladder 67</tara:hasSynonym>
        <tara:hasSynonym>UB 67</tara:hasSynonym>
        <tara:hasSynonym>Urinary Bladder 67</tara:hasSynonym>
        <tara:hasVasculatureDescription>The network formed by the dorsal digital artery and plantar digital proprial artery.</tara:hasVasculatureDescription>
        <tara:isLocatedOnMeridian rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_7525476"/>
        <rdfs:label>BL 67</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7226516 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7226516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000009"/>
        <obo:IAO_0000115>A one-dimensional continuant fiat boundary, demarcated by convention within traditional Chinese medicine theory rather than by any natural physical discontinuity in the body, along which Acupoints are located.</obo:IAO_0000115>
        <dc:description>In traditional Chinese Medicine (TCM), meridians are strings connecting acupuncture points, which are considered as passageways through which energy flows throughout the body. The meridian system is composed of 12 principal meridians, each of which connects to an organ system and extends to an extremity and eight collaterals.</dc:description>
        <dcterms:bibliographicCitation>Maurer, N., Nissel, H., Egerbacher, M., Gornik, E., Schuller, P., &amp; Traxler, H. (2019). Anatomical evidence of acupuncture meridians in the human extracellular matrix: results from a macroscopic and microscopic interdisciplinary multicentre study on human corpses. Evidence-Based Complementary and Alternative Medicine, 2019. https://doi.org/10.1155/2019/6976892</dcterms:bibliographicCitation>
        <tara:hasSynonym>Acupuncture meridian</tara:hasSynonym>
        <rdfs:label>Meridian</rdfs:label>
    </owl:Class>
    


    <!-- http://www.acupunctureresearch.org/tara/ontology/TARA_7228895 -->

    <owl:Class rdf:about="http://www.acupunctureresearch.org/tara/ontology/TARA_7228895">
        <rdfs:subClassOf rdf:resource="http://www.acupunctureresearch.org/tara/ontology/TARA_0995552"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.acupunctureresearch.org/tara/ontology/object-property/hasGeneralSurfaceLocation"/>
                <owl:someValuesFrom>
