    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795324</IRI>
        <Literal>Your iliotibial band is a strong, thick band of tissue that runs down the outside of your thigh. It extends all the way from the hip bone to the top of the shinbone.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://uri.interlex.org/base/ilx_0112785"/>
        <IRI>http://uri.interlex.org/base/ilx_0795324</IRI>
        <AbbreviatedIRI>obo:UBERON_0008784</AbbreviatedIRI>
