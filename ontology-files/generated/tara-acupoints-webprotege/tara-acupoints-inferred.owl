        <AbbreviatedIRI>TARA:TARA_2687954</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0003701</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_2687954</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0003823</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_2687954</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795305</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_2687954</AbbreviatedIRI>
