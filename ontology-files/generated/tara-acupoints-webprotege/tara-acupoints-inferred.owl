        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_2187225</AbbreviatedIRI>
        <Literal>Small Intestine 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
