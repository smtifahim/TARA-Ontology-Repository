        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0003632</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0002387</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>LIV 2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>LV 2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>Liver 2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>The dorsal venous network of the foot and the first dorsal digital artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>LR 2</Literal>
