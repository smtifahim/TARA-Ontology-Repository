        <AbbreviatedIRI>TARA:TARA_3668538</AbbreviatedIRI>
        <Literal>Gallbladder 41</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_3668538</AbbreviatedIRI>
        <Literal>The dorsal arterial and venous network of foot, the fourth dorsal metatarsal artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
