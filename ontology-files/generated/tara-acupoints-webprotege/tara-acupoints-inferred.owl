        <AbbreviatedIRI>TARA:TARA_8120328</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0002060</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
