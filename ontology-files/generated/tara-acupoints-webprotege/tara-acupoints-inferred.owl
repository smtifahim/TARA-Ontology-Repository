        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_5047947</AbbreviatedIRI>
        <Literal>Headache, blurring of vision, neck rigidity, epistaxis, pain in the shoulder, back and arm, swelling and pain of the heel, difficult labour, epilepsy.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_5047947</AbbreviatedIRI>
