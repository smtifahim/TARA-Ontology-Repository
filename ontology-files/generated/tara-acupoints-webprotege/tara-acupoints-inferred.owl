        <IRI>http://uri.interlex.org/base/ilx_0795502</IRI>
        <Literal>tendon of extensor digitorum</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795503</IRI>
        <Literal>The tendon of the muscle extending the big toe and assisting in dorsiflexion of the foot.</Literal>
    </AnnotationAssertion>
