        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <Literal>RN 23</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <Literal>Ren 23</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <Literal>The anterior jugular vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
