    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_1697302</AbbreviatedIRI>
        <Literal>In the lumbar region, in the depression inferior to the spinous process of the first lumbar vertebra (L1), on the posterior median line.</Literal>
    </AnnotationAssertion>
