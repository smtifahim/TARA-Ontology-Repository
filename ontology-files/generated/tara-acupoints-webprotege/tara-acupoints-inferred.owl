        <AbbreviatedIRI>TARA:TARA_1357729</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001461</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1357729</AbbreviatedIRI>
        <Literal>L 5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1357729</AbbreviatedIRI>
        <Literal>Lung 5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_1357729</AbbreviatedIRI>
        <Literal>The branches of the radial recurrent artery and vein, the cephalic vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_1357729</AbbreviatedIRI>
        <Literal>LU 5</Literal>
    </AnnotationAssertion>
