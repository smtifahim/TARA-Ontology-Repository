        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1074531</AbbreviatedIRI>
        <Literal>LIV 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1074531</AbbreviatedIRI>
        <Literal>LV 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1074531</AbbreviatedIRI>
        <Literal>Liver 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_1074531</AbbreviatedIRI>
        <Literal>Anteriorly, the great saphenous vein, on the pathway of the genu su prema artery.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_1074531</AbbreviatedIRI>
        <Literal>LR 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <AbbreviatedIRI>TARA:TARA_1092703</AbbreviatedIRI>
        <Literal>An acupuncture point that is located along the Conception Vessel (CV / Ren Mai), one of the eight extraordinary vessels, which consists of 24 standardized acupoints beginning at CV 1 (Huiyin) in the perineum at the midpoint of the perineal region, traveling up along the anterior midline of the body through the abdomen, chest, and neck, and ending at CV 24 (Chengjiang) on the face in the depression at the center of the mentolabial sulcus.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_1092703</AbbreviatedIRI>
        <Literal>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_1092703</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_6789717</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1092703</AbbreviatedIRI>
        <Literal>Acupoint of the Ren channel</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1092703</AbbreviatedIRI>
        <Literal>Acupuncture point of the Ren channel</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1092703</AbbreviatedIRI>
        <Literal>CV</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
