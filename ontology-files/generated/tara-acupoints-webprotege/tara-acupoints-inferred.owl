        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>SJ 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>San Jiao 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>TB 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>TH 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>TW 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>Triple Burner 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>Triple Energizer 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>Triple Heater 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>Triple Warmer 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>The descending branch of the transverse cervical artery; deeper, the muscular branch of the suprascapular artery.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_5828993</AbbreviatedIRI>
        <Literal>TE 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_5850983</AbbreviatedIRI>
        <Literal>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_5850983</AbbreviatedIRI>
        <Literal>Malnutrition and indigestion syndrome in children, whooping cough.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_5850983</AbbreviatedIRI>
        <Literal>On the palmar surface, in the midpoint of the transverse creases of the proximal interphalangeal joints of the index, middle, ring and little fingers.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_5850983</AbbreviatedIRI>
        <Literal>Prick to cause bleeding, or squeeze out a small amount of yellowish viscous fluid locally.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5850983</AbbreviatedIRI>
        <Literal>EX-UE 10</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5850983</AbbreviatedIRI>
        <Literal>M-UE 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_5850983</AbbreviatedIRI>
        <Literal>Sifeng</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_5859631</AbbreviatedIRI>
        <Literal>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 91. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasChineseLabel"/>
        <AbbreviatedIRI>TARA:TARA_5859631</AbbreviatedIRI>
        <Literal>小海(海)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasDesignatedSpecialPointRole"/>
        <AbbreviatedIRI>TARA:TARA_5859631</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_6594221</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_5859631</AbbreviatedIRI>
        <Literal>Headache, swelling of the cheek, pain in the nape, shoulder, arm and elbow, epilepsy.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_5859631</AbbreviatedIRI>
        <Literal>The branches of the medial antebrachial cutaneous nerve, the ulnar nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_5859631</AbbreviatedIRI>
        <Literal>On the posteromedial aspect of the elbow, in the depression between the olecranon and the medial epicondyle of the humerus bone. Note: When the elbow is slightly flexed, SI 8 is located in the groove for the ulnar nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_5859631</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_9093316</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_5859631</AbbreviatedIRI>
        <Literal>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasPinyinLabel"/>
        <AbbreviatedIRI>TARA:TARA_5859631</AbbreviatedIRI>
        <Literal>Xiaohai</Literal>
    </AnnotationAssertion>
