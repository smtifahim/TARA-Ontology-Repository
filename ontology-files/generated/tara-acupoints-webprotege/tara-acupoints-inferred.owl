        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_3452202</AbbreviatedIRI>
        <Literal>SI</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
