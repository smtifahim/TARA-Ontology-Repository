        <Literal>Headache, eye diseases, deviation of the eyes and mouth.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_9534465</AbbreviatedIRI>
        <Literal>In the depression about one finger breadth posterior to the midpoint between the lateral end of the eyebrow and the outer canthus.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_9534465</AbbreviatedIRI>
