        <AbbreviatedIRI>TARA:TARA_0992296</AbbreviatedIRI>
        <Literal>Urinary Bladder 23</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_0992296</AbbreviatedIRI>
        <Literal>The posterior branches of the second lumbar artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_0992296</AbbreviatedIRI>
        <Literal>BL 23</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <AbbreviatedIRI>TARA:TARA_0995552</AbbreviatedIRI>
        <Literal>An acupuncture point that is located along the Bladder Meridian of Foot-Taiyang (BL), which consists of 67 standardized acupoints beginning at BL 1 (Jingming) on the face in the depression just superior to the inner canthus of the eye, traveling up over the head, descending down the back in two parallel lines flanking the spine, and continuing along the posterior aspect of the leg, ending at BL 67 (Zhiyin) on the lateral side of the little toe near the corner of the nail.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_0995552</AbbreviatedIRI>
        <Literal>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_0995552</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_7525476</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0995552</AbbreviatedIRI>
        <Literal>Acupoint of the bladder meridian of foot-taiyang</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0995552</AbbreviatedIRI>
        <Literal>Acupuncture point of the bladder meridian</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0995552</AbbreviatedIRI>
        <Literal>Acupuncture point of the bladder meridian of foot-taiyang</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0995552</AbbreviatedIRI>
        <Literal>Acupuncture point of the urinary bladder meridian</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0995552</AbbreviatedIRI>
        <Literal>BL</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0995552</AbbreviatedIRI>
        <Literal>UB</Literal>
    </AnnotationAssertion>
