    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0003699</AbbreviatedIRI>
        <Literal>The firm fibrocartilaginous joint in the median plane between the two opposing surfaces of the pubic bones, which are united by an interpubic disc of fibrocartilage as well as the superior and arcuate pubic ligaments.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
