        <AbbreviatedIRI>TARA:TARA_9020892</AbbreviatedIRI>
        <Literal>Pericardium 7</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_9020892</AbbreviatedIRI>
        <Literal>The palmar arterial and venous network of the wrist.</Literal>
    </AnnotationAssertion>
