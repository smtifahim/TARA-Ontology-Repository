        <AbbreviatedIRI>TARA:TARA_9655874</AbbreviatedIRI>
        <Literal>The medial branches of the posterior branches of the intercostal artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_9655874</AbbreviatedIRI>
        <Literal>BL 18</Literal>
    </AnnotationAssertion>
