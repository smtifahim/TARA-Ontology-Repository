        <AbbreviatedIRI>obo:UBERON_0004657</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_1772472</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0010887</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
