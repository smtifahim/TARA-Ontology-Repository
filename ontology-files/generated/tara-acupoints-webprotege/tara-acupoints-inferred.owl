    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795283</IRI>
        <Literal>The anatomical space between the first and second ribs, containing intercostal muscles, vessels, and nerves.</Literal>
    </AnnotationAssertion>
