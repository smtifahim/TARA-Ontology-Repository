        <AbbreviatedIRI>TARA:TARA_6893448</AbbreviatedIRI>
        <Literal>B 48</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6893448</AbbreviatedIRI>
        <Literal>Bladder 48</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6893448</AbbreviatedIRI>
        <Literal>UB 48</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6893448</AbbreviatedIRI>
        <Literal>Urinary Bladder 48</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_6893448</AbbreviatedIRI>
        <Literal>The posterior branches of the intercostal artery and vein. Innervation: The lateral cutaneous branches of the posterior rami of the eighth and ninth thoracic nerves.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_6893448</AbbreviatedIRI>
        <Literal>BL 48</Literal>
    </AnnotationAssertion>
