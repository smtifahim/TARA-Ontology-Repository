        <AbbreviatedIRI>TARA:TARA_5797983</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0004630</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
