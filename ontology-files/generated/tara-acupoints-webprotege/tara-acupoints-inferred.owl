        <AbbreviatedIRI>TARA:TARA_6846652</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0008231</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
