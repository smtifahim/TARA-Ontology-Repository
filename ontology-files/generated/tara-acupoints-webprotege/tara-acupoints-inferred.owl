    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0013631</AbbreviatedIRI>
        <Literal>Ossicle that develops within bands of dense, regular connective tissue (e.g., tendons and ligaments). Sesamoids are generally located proximate to a bony prominence, over which the dense regular connective tissue wraps, and/or a joint or articulation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:UBERON_0013631</AbbreviatedIRI>
        <AbbreviatedIRI>obo:uberon.owl</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="OboInOwl:hasDbXref"/>
        <AbbreviatedIRI>obo:UBERON_0013631</AbbreviatedIRI>
        <Literal>VSAO:0000137</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="OboInOwl:hasExactSynonym"/>
        <AbbreviatedIRI>obo:UBERON_0013631</AbbreviatedIRI>
        <Literal>sesamoid</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="OboInOwl:hasOBONamespace"/>
        <AbbreviatedIRI>obo:UBERON_0013631</AbbreviatedIRI>
        <Literal>uberon</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="OboInOwl:id"/>
        <AbbreviatedIRI>obo:UBERON_0013631</AbbreviatedIRI>
        <Literal>UBERON:0013631</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
