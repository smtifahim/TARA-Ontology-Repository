    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795497</IRI>
        <Literal>Pain during the period after surgery.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://uri.interlex.org/base/ilx_0795497</IRI>
        <Literal>postoperative pain</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795498</IRI>
        <Literal>Τhe pain experienced during childbirth caused by uterine contractions and cervical dilation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://uri.interlex.org/base/ilx_0795498</IRI>
        <Literal>labor pain</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795499</IRI>
        <Literal>Refers to pain in the teeth or gums, often caused by cavities, infection, injury, or dental surgical procedures.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://uri.interlex.org/base/ilx_0795499</IRI>
        <Literal>dental pain</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795500</IRI>
        <Literal>The tendon of the muscle that flexes and abducts the wrist, located in the anterior forearm.</Literal>
    </AnnotationAssertion>
