        <AbbreviatedIRI>TARA:TARA_8651539</AbbreviatedIRI>
        <Literal>Heart 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_8651539</AbbreviatedIRI>
        <Literal>The arterial and venous network formed by the palmar digital proprial artery and vein.</Literal>
    </AnnotationAssertion>
