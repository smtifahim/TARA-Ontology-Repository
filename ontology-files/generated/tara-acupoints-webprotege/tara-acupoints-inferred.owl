        <AbbreviatedIRI>TARA:TARA_6269212</AbbreviatedIRI>
        <Literal>Nausea, vomiting, hiccup.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_6269212</AbbreviatedIRI>
        <Literal>On the midpoint of the proximal interphalangeal joint of the middle finger at dorsum aspect.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_6269212</AbbreviatedIRI>
        <Literal>Moxibustion is applied with three moxa cones.</Literal>
