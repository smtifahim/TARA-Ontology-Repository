    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0001373</AbbreviatedIRI>
        <Literal>The Sartorius muscle - the longest muscle in the human body - is a long thin muscle that runs down the length of the thigh. Its upper portion forms the lateral border of the femoral triangle.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000116"/>
        <AbbreviatedIRI>obo:UBERON_0001373</AbbreviatedIRI>
        <Literal>We do NOT group this AAO class here at this stage until further evidence of shared attachments</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
