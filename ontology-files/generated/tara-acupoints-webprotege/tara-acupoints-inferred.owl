    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_7517723</AbbreviatedIRI>
        <Literal>Migraine, pain in the neck, shoulder and arm, epilepsy, scrofula, goiter.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_7517723</AbbreviatedIRI>
        <Literal>The posterior brachial cutaneous nerve and the muscular branch of the radial nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_7517723</AbbreviatedIRI>
        <Literal>On the posterior aspect of the elbow, in the depression 1 B-cun proximal to the prominence of the olecranon. Note: When the elbow is flexed, TE10 is located in the olecranon fossa.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
