        <Literal>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 138. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasChineseLabel"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <Literal>水泉</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasDesignatedSpecialPointRole"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_4598552</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <Literal>Amenorrhea, irregular menstruation, dysmenorrhea, prolapse of uterus, dysuria, blurring of vision.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <Literal>On the medial aspect of the foot, 1 B-cun inferior to KI3, in the depression anterior to the calcaneal tuberosity.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_4813389</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasPinyinLabel"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <Literal>Shuiquan</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0002387</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_7500094</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0002387</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <Literal>K 5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <Literal>Kidney 5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_5122409</AbbreviatedIRI>
        <Literal>See Dazhong (KI 4).</Literal>
    </AnnotationAssertion>
