        <AbbreviatedIRI>TARA:TARA_4125415</AbbreviatedIRI>
        <Literal>Small Intestine 6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_4125415</AbbreviatedIRI>
        <Literal>The terminal branches of the posterior interosseous artery and vein, the dorsal venous network of the wrist.</Literal>
    </AnnotationAssertion>
