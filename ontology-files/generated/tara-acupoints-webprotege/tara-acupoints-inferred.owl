    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_7596288</AbbreviatedIRI>
        <Literal>Eye diseases, tinnitus, insomma.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_7596288</AbbreviatedIRI>
        <Literal>1 cun posterior to Yifeng (TE 17).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_7596288</AbbreviatedIRI>
        <Literal>Puncture perpendicularly 0.5-0.8 inch.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
