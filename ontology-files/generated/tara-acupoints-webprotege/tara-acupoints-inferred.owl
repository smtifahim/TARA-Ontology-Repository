        <AbbreviatedIRI>TARA:TARA_1654197</AbbreviatedIRI>
        <Literal>Puncture perpendicularly 0.8-1.0 inch. Moxibustion is applicable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
