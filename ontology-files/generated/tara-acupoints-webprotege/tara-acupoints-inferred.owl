        <AbbreviatedIRI>TARA:TARA_6846652</AbbreviatedIRI>
        <Literal>Urinary Bladder 49</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_6846652</AbbreviatedIRI>
        <Literal>The posterior branches of the intercostal artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
