        <AbbreviatedIRI>TARA:TARA_1074531</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001381</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
