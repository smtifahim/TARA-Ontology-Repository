        <AbbreviatedIRI>TARA:TARA_1051162</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001424</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
