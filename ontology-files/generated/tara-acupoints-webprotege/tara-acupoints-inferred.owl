        <AbbreviatedIRI>TARA:TARA_2187225</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001476</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
