        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#dateTime">2016-11-29T11:02:54+00:00</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:creator"/>
