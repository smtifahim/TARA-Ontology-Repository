        <Literal>K 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_2687954</AbbreviatedIRI>
        <Literal>Kidney 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_2687954</AbbreviatedIRI>
        <Literal>Deeper, the posterior tibial artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
