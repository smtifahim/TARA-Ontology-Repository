        <Literal>posterior hairline</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795327</IRI>
        <Literal>The mentolabial sulcus is the vertical groove or fold that forms between the lower lip and the chin, marking the transition between the lower lip and the mental region of the face.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://uri.interlex.org/base/ilx_0112785"/>
        <IRI>http://uri.interlex.org/base/ilx_0795327</IRI>
        <AbbreviatedIRI>obo:UBERON_0001456</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
