    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBPROP_0000101</AbbreviatedIRI>
        <Literal>A property used in conjunction with repeated_element_number to indicate an axis and directionality along that axis. If P preceding_element_is R, and P is_count_of S, and X P N, and X&apos; P N+1, then it follows that every X R some X&apos;, and the class expression [S and R some X&apos; and inv(R) some X] is empty (i.e. X is followed by X&apos;, with no intermediates).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="OboInOwl:hasDbXref"/>
        <AbbreviatedIRI>obo:UBPROP_0000101</AbbreviatedIRI>
        <Literal>UBPROP:0000101</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="OboInOwl:hasOBONamespace"/>
        <AbbreviatedIRI>obo:UBPROP_0000101</AbbreviatedIRI>
        <Literal>uberon</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="OboInOwl:id"/>
        <AbbreviatedIRI>obo:UBPROP_0000101</AbbreviatedIRI>
        <Literal>preceding_element_is</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="OboInOwl:is_metadata_tag"/>
        <AbbreviatedIRI>obo:UBPROP_0000101</AbbreviatedIRI>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#boolean">true</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="OboInOwl:shorthand"/>
        <AbbreviatedIRI>obo:UBPROP_0000101</AbbreviatedIRI>
        <Literal>preceding_element_is</Literal>
    </AnnotationAssertion>
