        <AbbreviatedIRI>TARA:TARA_0742938</AbbreviatedIRI>
        <Literal>Abdominal pain, diarrhea, toothache, swelling of the cheek, motor impairment of the upper limbs, pain in the shoulder and back.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_0742938</AbbreviatedIRI>
        <Literal>See Wenliu (LI 7).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
