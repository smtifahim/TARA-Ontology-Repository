        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0220496</AbbreviatedIRI>
        <Literal>Small Intestine 3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_0220496</AbbreviatedIRI>
        <Literal>The dorsal digital artery and vein, the dorsal venous network of the hand.</Literal>
    </AnnotationAssertion>
