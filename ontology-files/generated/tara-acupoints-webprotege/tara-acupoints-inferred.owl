        <AbbreviatedIRI>TARA:TARA_7634323</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001461</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_7634323</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0008188</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_7634323</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795332</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_7634323</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001461</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_7634323</AbbreviatedIRI>
        <Literal>P 3</Literal>
    </AnnotationAssertion>
