        <Literal>Muscular atrophy and weakness of the lower extremities, pain in the heel.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_0093665</AbbreviatedIRI>
