        <AbbreviatedIRI>obo:UBERON_0004452</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_1172977</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0004452</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1172977</AbbreviatedIRI>
        <Literal>Small Intestine 4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_1172977</AbbreviatedIRI>
        <Literal>The posterior carpal artery (the branch of the ulnar artery), the dorsal venous network of the hand.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_1172977</AbbreviatedIRI>
        <Literal>SI 4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <AbbreviatedIRI>TARA:TARA_1194553</AbbreviatedIRI>
        <Literal>An acupuncture point that is located along the Heart Meridian of Hand-Shaoyin (HT), which consists of 9 standardized acupoints beginning at HT 1 (Jiquan) in the center of the axillary fossa, traveling down the medial aspect of the arm, and ending at HT 9 (Shaochong) on the radial side of the little finger near the corner of the nail.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_1194553</AbbreviatedIRI>
        <Literal>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_1194553</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_9474009</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1194553</AbbreviatedIRI>
        <Literal>Acupoint of the heart meridian of hand-shaoyin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1194553</AbbreviatedIRI>
        <Literal>Acupuncture point of the heart meridian</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1194553</AbbreviatedIRI>
        <Literal>Acupuncture point of the heart meridian of hand-shaoyin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1194553</AbbreviatedIRI>
        <Literal>HT</Literal>
    </AnnotationAssertion>
