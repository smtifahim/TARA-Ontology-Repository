        <AbbreviatedIRI>TARA:TARA_1330972</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0000303</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_1330972</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0000376</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_1330972</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0000376</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1330972</AbbreviatedIRI>
        <Literal>LIV 11</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1330972</AbbreviatedIRI>
        <Literal>LV 11</Literal>
    </AnnotationAssertion>
