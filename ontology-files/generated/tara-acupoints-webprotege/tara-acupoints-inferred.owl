        <AnnotationProperty abbreviatedIRI="obo:IAO_0000111"/>
        <AbbreviatedIRI>obo:RO_0000057</AbbreviatedIRI>
        <Literal xml:lang="en">has participant</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:RO_0000057</AbbreviatedIRI>
        <Literal xml:lang="en">this blood coagulation has participant this blood clot</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
