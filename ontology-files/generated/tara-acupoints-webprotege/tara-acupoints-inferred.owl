        <Literal>popliteal crease</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795331</IRI>
        <Literal>This is the depression on the skin surface of the neck between the sternal heads of the sternocleidomastoid muscles. This area is situated just above the manubrium of the sternum and is a visible landmark in the neck.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://uri.interlex.org/base/ilx_0112785"/>
        <IRI>http://uri.interlex.org/base/ilx_0795331</IRI>
