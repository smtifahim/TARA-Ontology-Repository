        <AbbreviatedIRI>TARA:TARA_1144697</AbbreviatedIRI>
        <Literal>外丘(邱)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasDesignatedSpecialPointRole"/>
