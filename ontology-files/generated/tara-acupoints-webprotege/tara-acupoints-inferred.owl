        <AbbreviatedIRI>obo:UBERON_0000033</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_7589061</AbbreviatedIRI>
        <Literal>Du 18</Literal>
    </AnnotationAssertion>
