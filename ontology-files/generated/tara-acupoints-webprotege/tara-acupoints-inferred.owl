        <AbbreviatedIRI>TARA:TARA_6515979</AbbreviatedIRI>
        <Literal>輒(辄)筋</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_6515979</AbbreviatedIRI>
        <Literal>Fullness of the chest, pain in the hypochondriac region, asthma.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_6515979</AbbreviatedIRI>
        <Literal>The lateral cutaneous branch of the fifth intercostal nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_6515979</AbbreviatedIRI>
        <Literal>In the lateral thoracic region, in the fourth intercostal space, 1 B-cun anterior to the midaxillary line.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_6515979</AbbreviatedIRI>
