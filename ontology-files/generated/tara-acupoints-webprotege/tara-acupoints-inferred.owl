        <AbbreviatedIRI>TARA:TARA_5362994</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0003823</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
