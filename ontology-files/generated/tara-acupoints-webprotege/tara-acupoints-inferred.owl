    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_7423288</AbbreviatedIRI>
        <Literal>Stiffness and pain of the shoulder, back and neck, numbness of the elbow and arm.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_7423288</AbbreviatedIRI>
        <Literal>The lateral branches of the posterior rami of the first and second thoracic nerves; deeper, the dorsal scapular nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_7423288</AbbreviatedIRI>
        <Literal>In the upper back region, at the same level as the inferior border of the spinous process of the second thoracic vertebra (T2), 3 B-cun lateral to the posterior median line. Note: BL41 and BL12 are located at the same level as the inferior border of the spinous process of the second thoracic vertebra (T2).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_7423288</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_7525476</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_7423288</AbbreviatedIRI>
        <Literal>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
