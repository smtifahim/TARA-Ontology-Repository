        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_2454652</AbbreviatedIRI>
        <Literal>The arterial and venous network around the knee joint.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_2454652</AbbreviatedIRI>
        <Literal>ST 35</Literal>
    </AnnotationAssertion>
