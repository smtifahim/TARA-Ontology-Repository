    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_5389461</AbbreviatedIRI>
        <Literal>pain and rigidity of the neck, pain in the shoulder and back, motor impairment of the arm, insufficient lactation, mastitis, scrofula, apoplexy, difficult labour.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_5389461</AbbreviatedIRI>
        <Literal>The posterior branch of the supraclavicular nerve, the accessory nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_5389461</AbbreviatedIRI>
        <Literal>In the posterior region of the neck, at the midpoint of the line connecting the spinous process of the seventh cervical vertebra (C7) with the lateral end of the acromion.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
