    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_8907823</AbbreviatedIRI>
        <Literal>The branch of the great occipital nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_8907823</AbbreviatedIRI>
        <Literal>On the head, 4 B-cun within the anterior hairline, directly superior to the centre of the pupil. Note: GB18 is 1.5 B-cun posterior to gB17, at the same level as BL7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
