        <Literal>Urinary Bladder 54</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_0488267</AbbreviatedIRI>
        <Literal>The inferior gluteal artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_0488267</AbbreviatedIRI>
        <Literal>BL 54</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
