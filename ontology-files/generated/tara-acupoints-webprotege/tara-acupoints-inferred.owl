        <AbbreviatedIRI>TARA:TARA_2187225</AbbreviatedIRI>
        <Literal>The circumflex scapular artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_2187225</AbbreviatedIRI>
        <Literal>SI 9</Literal>
