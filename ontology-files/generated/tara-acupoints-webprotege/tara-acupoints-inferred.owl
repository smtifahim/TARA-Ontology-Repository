    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_0427594</AbbreviatedIRI>
