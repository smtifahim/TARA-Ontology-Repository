        <AbbreviatedIRI>TARA:TARA_9493899</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_3515622</AbbreviatedIRI>
        <Literal>Headache, migraine, neck rigidity, cough, asthma, sore throat, facial paralysis, toothache, pain and weakness of the wrist.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_3515622</AbbreviatedIRI>
        <Literal>The lateral antebrachial cutaneous nerve and the superficial ramus of the radial nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_3515622</AbbreviatedIRI>
        <Literal>On the radial aspect of the forearm, between the tendons of the abductor pollicis longus and the extensor pollicis brevis muscles, in the groove for the abductor pollicis longus tendon, 1.5 B-cun superior to the palmar wrist crease.</Literal>
    </AnnotationAssertion>
