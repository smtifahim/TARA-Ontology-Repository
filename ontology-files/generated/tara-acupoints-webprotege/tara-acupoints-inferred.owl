        <IRI>http://uri.interlex.org/base/ilx_0795292</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_4994509</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0000033</AbbreviatedIRI>
    </AnnotationAssertion>
