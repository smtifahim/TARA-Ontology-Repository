        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:HP_0025142</AbbreviatedIRI>
        <Literal>A symptom or manifestation indicating a systemic or general effect of a disease and that may affect the general well-being or status of an individual.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:HP_0025142</AbbreviatedIRI>
        <AbbreviatedIRI>obo:hp.owl</AbbreviatedIRI>
