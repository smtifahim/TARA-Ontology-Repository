    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="NIFRID:synonym"/>
        <IRI>http://uri.interlex.org/base/ilx_0795501</IRI>
        <Literal>Tendon of flexor carpi ulnaris muscle</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://uri.interlex.org/base/ilx_0795501</IRI>
        <Literal>tendon of flexor carpi ulnaris</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795502</IRI>
        <Literal>The tendon of the muscle that extends the fingers and assists in wrist extension, located on the posterior forearm.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="NIFRID:synonym"/>
        <IRI>http://uri.interlex.org/base/ilx_0795502</IRI>
        <Literal>Extensor digitorum tendon</Literal>
    </AnnotationAssertion>
