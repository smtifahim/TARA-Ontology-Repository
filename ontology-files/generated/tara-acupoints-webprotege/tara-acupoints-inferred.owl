    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:UBPROP_0000008"/>
        <AbbreviatedIRI>obo:UBERON_0002414</AbbreviatedIRI>
        <Literal>Whereas all rats had six lumbar vertebrae, variable patterns in mice included mostly five vertebrae in DBA/2J, mostly six vertebrae in C57BL/6J, and a mix in B6129PF2/J</Literal>
