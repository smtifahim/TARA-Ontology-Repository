        <AbbreviatedIRI>TARA:TARA_7634323</AbbreviatedIRI>
        <Literal>Pericardium 3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_7634323</AbbreviatedIRI>
        <Literal>On the pathway of the brachial artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
