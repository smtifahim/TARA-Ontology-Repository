        <AnnotationProperty abbreviatedIRI="OboInOwl:shorthand"/>
        <AbbreviatedIRI>obo:RO_0002171</AbbreviatedIRI>
        <Literal>mutually_spatially_disjoint_with</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:RO_0002171</AbbreviatedIRI>
        <Literal>mutually spatially disjoint with</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:RO_0002171</AbbreviatedIRI>
        <Literal xml:lang="en">mutually spatially disjoint with</Literal>
    </AnnotationAssertion>
