        <AnnotationProperty abbreviatedIRI="dc:date"/>
        <Literal>April 17, 2026</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <Literal xml:lang="en">The TARA Acupoints Ontology is an ontology developed as part of the Topological Atlas and Repository for Acupoint Research (TARA) project funded by the National Institute of Health (NIH). The goal of TARA is to establish a new comprehensive resource for the acupuncture research and clinician community. The ontology will be used to support semantic search and annotations for anatomical maps, atlases, and data sets relevant to the TARA project.
- About TARA: https://www.acupunctureresearch.org/tara
- GitHub Repo: https://github.com/SciCrunch/TARA-Ontology-Repository
- More About TARA Ontology: https://github.com/SciCrunch/TARA-Ontology-Repository/tree/master/ontology-files/generated#readme</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:source"/>
        <Literal>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. ISBN 978-7-119-01758-7.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:source"/>
        <Literal>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dc:title"/>
        <Literal xml:lang="en">TARA Acupoints Ontology</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">This file contains the imported terms from UBERON, InterLex, Mondo Disease Ontology (MONDO), and Human Phenotype Ontology (HPO) for TARA Acupoints Ontology. It includes the basic hierarchy and the partnomy of the imported terms.
- About UBERON: https://obofoundry.org/ontology/uberon.html
- About MONDO: https://mondo.monarchinitiative.org/
- About HPO: https://hpo.jax.org/
- About InterLex: https://scicrunch.org/scicrunch/interlex/dashboard</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">This file contains the upper ontology terms for the core TARA Acupoints Ontology. It uses some of the upper level classes from UBERON, extending the Basic Formal Ontology (BFO). It also includes the minimal subset of properties from relation ontology (RO Core). For annotation properties, it imports a subset of the Information Artifact Ontology (IAO).
- About RO Core: https://github.com/oborel/obo-relations/wiki/ROCore
- About BFO: https://obofoundry.org/ontology/bfo.html
- About IAO: https://github.com/information-artifact-ontology/IAO</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:seeAlso"/>
        <Literal xml:lang="en">https://github.com/SciCrunch/TARA-Ontology-Repository/tree/master/ontology-files/generated#readme</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:priorVersion"/>
        <Literal datatypeIRI="http://www.w3.org/2000/01/rdf-schema#Literal">1.0.0</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal datatypeIRI="http://www.w3.org/2000/01/rdf-schema#Literal">1.2.0</Literal>
    </Annotation>
