    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_1697302</AbbreviatedIRI>
        <Literal>Pain and stiffness of the lower back, diarrhea, indigestion.</Literal>
