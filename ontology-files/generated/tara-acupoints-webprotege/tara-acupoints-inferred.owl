        <AbbreviatedIRI>TARA:TARA_6845331</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0009567</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
