    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_1338884</AbbreviatedIRI>
        <Literal>Pain in the face, deviation of the eyes and mouth, spasm of facial muscle.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_1338884</AbbreviatedIRI>
        <Literal>1 cun lateral to Chengjiang (CV 24).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_1338884</AbbreviatedIRI>
        <Literal>Puncture obliquely 0.5-1.0 inch..</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1338884</AbbreviatedIRI>
        <Literal>M-HN 18</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_1338884</AbbreviatedIRI>
        <Literal>Jiachengjiang</Literal>
    </AnnotationAssertion>
