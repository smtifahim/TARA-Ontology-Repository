        <AbbreviatedIRI>TARA:TARA_8757342</AbbreviatedIRI>
        <Literal>G 27</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_8757342</AbbreviatedIRI>
        <Literal>Gallbladder 27</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_8757342</AbbreviatedIRI>
        <Literal>The superficial and deep circumflex iliac arteries and veins.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_8757342</AbbreviatedIRI>
        <Literal>GB 27</Literal>
    </AnnotationAssertion>
