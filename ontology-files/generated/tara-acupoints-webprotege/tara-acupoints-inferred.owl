        <AbbreviatedIRI>obo:UBERON_0013631</AbbreviatedIRI>
        <IRI>http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#human_subset</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="OboInOwl:inSubset"/>
        <AbbreviatedIRI>obo:UBERON_0013631</AbbreviatedIRI>
        <IRI>http://purl.oboInOwllibrary.org/oboInOwl/uberon/core#mouse_subset</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo:UBERON_0013631</AbbreviatedIRI>
        <Literal>Sesamoids are often endochondral replacement elements and in addition to bone tissue, may also be composed of articular cartilage, fibrocartilage, hyaline cartilage, and calcified cartilage.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:UBERON_0013631</AbbreviatedIRI>
        <Literal>sesamoid element</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0013685</AbbreviatedIRI>
        <Literal>Anatomical space that is an opening in a bone of the skull.</Literal>
    </AnnotationAssertion>
