        <AbbreviatedIRI>TARA:TARA_9406515</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_3472408</AbbreviatedIRI>
        <Literal>Asthma, pain in the chest, fullness in the chest, palpitation, insufficient lactation, hiccup, difficulty in swallowing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_3472408</AbbreviatedIRI>
        <Literal>The anterior cutaneous branch of the fourth intercostal nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_3472408</AbbreviatedIRI>
        <Literal>In the anterior thoracic region, at the same level as the fourth intercostal space, on the anterior median line.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_3472408</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_6789717</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
