        <AbbreviatedIRI>TARA:TARA_6091821</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795306</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6091821</AbbreviatedIRI>
        <Literal>G 22</Literal>
    </AnnotationAssertion>
