        <AbbreviatedIRI>obo:RO_0001025</AbbreviatedIRI>
        <AbbreviatedIRI>obo:RO_0001901</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:source"/>
        <AbbreviatedIRI>obo:RO_0001025</AbbreviatedIRI>
        <Literal>http://www.obofoundry.org/ro/#OBO_REL:located_in</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:RO_0001025</AbbreviatedIRI>
        <Literal xml:lang="en">located in</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000112"/>
        <AbbreviatedIRI>obo:RO_0002000</AbbreviatedIRI>
        <Literal xml:lang="en">the surface of my skin is a 2D boundary of my body</Literal>
