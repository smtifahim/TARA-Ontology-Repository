        <AbbreviatedIRI>TARA:TARA_6846652</AbbreviatedIRI>
        <Literal>B 49</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6846652</AbbreviatedIRI>
        <Literal>Bladder 49</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6846652</AbbreviatedIRI>
        <Literal>UB 49</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
