    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo:UBERON_0001453</AbbreviatedIRI>
        <Literal>The intermediate cuneiform (also known as second cuneiform / middle cuneiform) is shaped like a wedge, the thin end pointing downwards. It is situated between the other two cuneiforms (the medial and lateral cuneiforms), and articulates with the navicular posteriorly, the second metatarsal anteriorly and with the other cuneiforms on either side. [WP,unvetted]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:UBERON_0001453</AbbreviatedIRI>
        <Literal>distal tarsal bone 2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="foaf:depiction"/>
        <AbbreviatedIRI>obo:UBERON_0001453</AbbreviatedIRI>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/5/52/Gray291.png</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0001455</AbbreviatedIRI>
        <Literal>A tarsal bone that is formed from distal tarsals 4 and 5. [WP,modified].</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:UBERON_0001455</AbbreviatedIRI>
