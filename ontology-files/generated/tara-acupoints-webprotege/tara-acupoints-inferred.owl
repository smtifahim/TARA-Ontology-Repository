        <AbbreviatedIRI>TARA:TARA_6845331</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0011281</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
