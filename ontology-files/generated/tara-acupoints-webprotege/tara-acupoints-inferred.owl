    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_7793286</AbbreviatedIRI>
        <Literal>Vaginitis, retention of urine hemorrhoids, nocturnal emission, enuresis, irregular menstruation, mental disorders.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_7793286</AbbreviatedIRI>
