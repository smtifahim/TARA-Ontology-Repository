        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0794954</IRI>
        <Literal>The dorsum of hand (dorsal area) is the corresponding area on the posterior part of the hand. This refers to the back of the hand, which is opposite of the palm side of the hand.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>http://uri.interlex.org/base/ilx_0794954</IRI>
