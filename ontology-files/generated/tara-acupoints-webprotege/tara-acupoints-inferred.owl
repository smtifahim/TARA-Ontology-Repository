        <AbbreviatedIRI>TARA:TARA_3553465</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001485</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_3553465</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0003823</AbbreviatedIRI>
    </AnnotationAssertion>
