    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0007846</AbbreviatedIRI>
        <Literal>Connective tissue that is dominated by collagen fibres organized into a definitive pattern (e.g., parallel to one another), with comparatively fewer cells (mostly fibroblasts).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
