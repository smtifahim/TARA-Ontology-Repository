        <AbbreviatedIRI>TARA:TARA_9392275</AbbreviatedIRI>
        <Literal>Conception Vessel 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_9392275</AbbreviatedIRI>
        <Literal>RN 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_9392275</AbbreviatedIRI>
        <Literal>Ren 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_9392275</AbbreviatedIRI>
        <Literal>The inferior epigastric artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_9392275</AbbreviatedIRI>
        <Literal>CV 8</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <AbbreviatedIRI>TARA:TARA_9406515</AbbreviatedIRI>
        <Literal>Tanzhong (CV 17), the influential point of qi, is able to regulate the flow of qi. Tanzhong (CV 17), the Influential Point of qi, is to bring qi down.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_9406515</AbbreviatedIRI>
        <Literal>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasDesignatedSpecialPointRole"/>
        <AbbreviatedIRI>TARA:TARA_9406515</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_0521663</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_9406515</AbbreviatedIRI>
        <Literal>Influential Point of Qi</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_9460971</AbbreviatedIRI>
        <Literal>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 54. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasChineseLabel"/>
        <AbbreviatedIRI>TARA:TARA_9460971</AbbreviatedIRI>
        <Literal>(乳)中</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_9460971</AbbreviatedIRI>
        <Literal>In the anterior thoracic region, at the centre of the nipple. Note: In males, the centre of the nipple is located in the fourth intercostal space.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
