        <AbbreviatedIRI>TARA:TARA_5358142</AbbreviatedIRI>
        <Literal>KI 13</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <AbbreviatedIRI>TARA:TARA_5361067</AbbreviatedIRI>
        <Literal>An acupuncture point that is located along the Triple Energizer Meridian of Hand-Shaoyang (TE), which consists of 23 standardized acupoints beginning at TE 1 (Guanchong) on the ulnar side of the ring finger near the corner of the nail, traveling up the dorsal-middle aspect of the arm, ascending over the shoulder and the side of the neck, and circling around the ear, and ending at TE 23 (Sizhukong) in the depression at the lateral end of the eyebrow.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_5361067</AbbreviatedIRI>
        <Literal>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_5361067</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_3898257</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5361067</AbbreviatedIRI>
        <Literal>Acupuncture point of triple energizer meridian</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5361067</AbbreviatedIRI>
        <Literal>Acupuncture point of triple energizer meridian of hand-shaoyang</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5361067</AbbreviatedIRI>
        <Literal>SJ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5361067</AbbreviatedIRI>
        <Literal>TB</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5361067</AbbreviatedIRI>
        <Literal>TE</Literal>
    </AnnotationAssertion>
