        <AbbreviatedIRI>TARA:TARA_5590422</AbbreviatedIRI>
        <Literal>Triple Burner 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5590422</AbbreviatedIRI>
        <Literal>Triple Energizer 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5590422</AbbreviatedIRI>
        <Literal>Triple Heater 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5590422</AbbreviatedIRI>
        <Literal>Triple Warmer 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_5590422</AbbreviatedIRI>
        <Literal>See Huizong (TE 7).</Literal>
    </AnnotationAssertion>
