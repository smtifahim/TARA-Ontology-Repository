        <AbbreviatedIRI>obo:UBERON_0002446</AbbreviatedIRI>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/9/9a/Knee_diagram.svg</Literal>
    </AnnotationAssertion>
