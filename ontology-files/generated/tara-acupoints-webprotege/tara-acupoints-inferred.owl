        <Literal>K 11</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_9609679</AbbreviatedIRI>
        <Literal>Kidney 11</Literal>
    </AnnotationAssertion>
