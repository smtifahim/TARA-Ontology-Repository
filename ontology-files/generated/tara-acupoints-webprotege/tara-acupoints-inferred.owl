        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0002445</AbbreviatedIRI>
        <Literal>The postaxial bone of the proximal carpal region. Found in close approximation to the ulna, often in articulation[PHENOSCAPE:ad].</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:UBERON_0002445</AbbreviatedIRI>
