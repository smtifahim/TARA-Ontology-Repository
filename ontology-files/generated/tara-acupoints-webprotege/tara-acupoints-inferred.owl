        <AbbreviatedIRI>TARA:TARA_6314936</AbbreviatedIRI>
        <Literal>The arterial and venous network formed by the dorsal digital arteries and veins.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
