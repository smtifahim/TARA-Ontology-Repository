        <AbbreviatedIRI>TARA:TARA_1840369</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasDesignatedSpecialPointRole"/>
        <AbbreviatedIRI>TARA:TARA_3003448</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_6705086</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_3003448</AbbreviatedIRI>
        <Literal>Gastric pain, abdominal distension, constipation, dysentery, vomiting diarrhea, borborygmus, sluggishness, beriberi.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_3003448</AbbreviatedIRI>
        <Literal>The branches of the saphenous nerve and superficial peroneal nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_3003448</AbbreviatedIRI>
        <Literal>On the medial aspect of the foot, in the depression proximal to the first metatarsophalangeal joint, at the border between the red and white flesh.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_3003448</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_4167850</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_3003448</AbbreviatedIRI>
        <Literal>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasPinyinLabel"/>
        <AbbreviatedIRI>TARA:TARA_3003448</AbbreviatedIRI>
        <Literal>Taibai</Literal>
    </AnnotationAssertion>
