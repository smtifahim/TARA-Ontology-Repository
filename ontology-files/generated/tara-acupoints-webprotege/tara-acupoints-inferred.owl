        <AbbreviatedIRI>TARA:TARA_9474009</AbbreviatedIRI>
        <Literal>手少陰(阴)心經(经,経)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasDesignatedOrgan"/>
        <AbbreviatedIRI>TARA:TARA_9474009</AbbreviatedIRI>
