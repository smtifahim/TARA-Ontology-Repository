        <AbbreviatedIRI>TARA:TARA_6850321</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795297</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_6850321</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0016416</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6850321</AbbreviatedIRI>
        <Literal>Spleen 19</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_6850321</AbbreviatedIRI>
        <Literal>The lateral thoracic artery and vein, the third intercostal artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_6850321</AbbreviatedIRI>
        <Literal>SP 19</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 196. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 9, Acupuncture Points of the Jueyin and Shaoyang Meridian. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasChineseLabel"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>行間(间)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasDesignatedSpecialPointRole"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_9857829</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>Pain in the hypochondrium, abdominal distension, headache, dizziness and vertigo, congestion, swelling and pain of the eye, deviation of the mouth, hernia, painful urination, retention of urine, irregular menstruation, epilepsy, insomnia, convulsion.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>The site where the dorsal digital nerves split from the lateral dorsal metatarsal nerve of the deep peroneal nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>On the dorsum of the foot, between the first and second toes, proximal to the web margin, at the border between the red and white flesh.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_5419503</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>Puncture obliquely 0.3-0.5 inch. Moxibustion is applicable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasPinyinLabel"/>
        <AbbreviatedIRI>TARA:TARA_6862058</AbbreviatedIRI>
        <Literal>Xingjian</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
