        <IRI>http://uri.interlex.org/base/ilx_0795329</IRI>
        <Literal>inguinal crease</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795330</IRI>
        <Literal>This is the visible skin fold or line at the back of the knee, formed when the knee is flexed. It is a superficial feature and serves as a landmark for the location of the popliteal fossa beneath.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="http://uri.interlex.org/base/ilx_0112785"/>
        <IRI>http://uri.interlex.org/base/ilx_0795330</IRI>
        <AbbreviatedIRI>obo:UBERON_0000978</AbbreviatedIRI>
    </AnnotationAssertion>
