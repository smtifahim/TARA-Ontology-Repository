        <AbbreviatedIRI>TARA:TARA_6893448</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0008231</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_6893448</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795312</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
