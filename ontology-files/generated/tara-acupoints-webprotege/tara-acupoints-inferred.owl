        <AnnotationProperty abbreviatedIRI="ilxtr:hasExistingId"/>
        <IRI>http://uri.interlex.org/base/ilx_0795331</IRI>
        <IRI>http://uri.interlex.org/base/ilx_0795331</IRI>
    </AnnotationAssertion>
