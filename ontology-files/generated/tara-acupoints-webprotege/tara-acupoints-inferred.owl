        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001738</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0000974</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <Literal>Large Intestine 18</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <Literal>Deeper, on the medial side, the ascending cervical artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <Literal>LI 18</Literal>
