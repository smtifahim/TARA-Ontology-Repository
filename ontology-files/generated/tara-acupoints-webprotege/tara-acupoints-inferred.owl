        <AbbreviatedIRI>TARA:TARA_0829128</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001456</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_0829128</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0005402</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
