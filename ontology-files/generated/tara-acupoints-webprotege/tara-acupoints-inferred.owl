        <AbbreviatedIRI>obo:UBPROP_0000107</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0002412</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
