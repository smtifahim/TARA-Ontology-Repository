        <AbbreviatedIRI>TARA:TARA_6845331</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0004300</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
