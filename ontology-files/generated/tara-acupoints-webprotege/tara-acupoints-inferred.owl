        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0001476</AbbreviatedIRI>
        <Literal>A muscle of shoulder which attaches to the scapula, clavicle and humerus.[FMA,generalized].</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:UBERON_0001476</AbbreviatedIRI>
