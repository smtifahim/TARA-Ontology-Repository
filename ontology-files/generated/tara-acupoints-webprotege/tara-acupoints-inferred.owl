        <AbbreviatedIRI>TARA:TARA_7280334</AbbreviatedIRI>
        <Literal>See Quchai (BL 4).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_7280334</AbbreviatedIRI>
        <Literal>BL 5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <AbbreviatedIRI>TARA:TARA_7315457</AbbreviatedIRI>
        <Literal>The names of the five shu points image the flow of meridian q i as the flow of water. The Jing-River point is where the meridian qi is pouring abundantly.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_7315457</AbbreviatedIRI>
        <Literal>D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasDesignatedSpecialPointRole"/>
        <AbbreviatedIRI>TARA:TARA_7315457</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_1758929</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_7315457</AbbreviatedIRI>
        <Literal>Jing-River Point</Literal>
    </AnnotationAssertion>
