    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0007845</AbbreviatedIRI>
        <Literal>Connective tissue, which consists of fibroblasts, the intercellular matrix of which contains a regular network of collagen and elastic fiber bundles. Examples: bone (tissue), cartilage (tissue), dense regular connective tissue.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000116"/>
        <AbbreviatedIRI>obo:UBERON_0007845</AbbreviatedIRI>
        <Literal>the connective tissue hierarchy largely follows FMA with definitions from VSAO. Note that in FMA, loose-CT is irregular-CT. This means regular-CT is necessarily equivalent to dense-regular-CT (assuming a JEPD classification).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:UBERON_0007845</AbbreviatedIRI>
        <AbbreviatedIRI>obo:uberon.owl</AbbreviatedIRI>
    </AnnotationAssertion>
