        <AbbreviatedIRI>TARA:TARA_5797983</AbbreviatedIRI>
        <Literal>Back-Shu Point of the Heart</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5797983</AbbreviatedIRI>
        <Literal>Bladder 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5797983</AbbreviatedIRI>
        <Literal>UB 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5797983</AbbreviatedIRI>
        <Literal>Urinary Bladder 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_5797983</AbbreviatedIRI>
        <Literal>The medial cutaneous branches of the posterior branches of the intercostal artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_5797983</AbbreviatedIRI>
        <Literal>BL 15</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <Literal>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 231. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 10, Acupuncture Points of the Governor and the Conception Vessels and the Extra Points. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasChineseLabel"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <Literal>廉泉</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <Literal>Swelling and pain of the subglossal region, salivation with glossoplegia, aphasia with stiffness of tongue by apoplexy, sudden hoarseness of the voice, difficulty in swallowing.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <Literal>The branch of the cutaneous cervical nerve, the hypoglossal nerve, and the branch of the glossopharyngeal nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <Literal>In the anterior region of the neck, superior to superior border to thyroid cartilage, in the depression superior to the hyoid bone, on the anterior median line. Note: With the head slightly extended, the hyoid tubercle can be palpated between the mandible and the thyroid cartilage.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_6789717</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <Literal>Puncture obliquely 0.5-1.0 inch toward the tongue root. Moxibustion is applicable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasPinyinLabel"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <Literal>Lianquan</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_5804897</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0000974</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
