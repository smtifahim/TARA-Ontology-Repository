        <Literal>A metacarpal bone that distally_connected_to a proximal phalanx of manual digit 3[Automatically generated definition].</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:UBERON_0003647</AbbreviatedIRI>
