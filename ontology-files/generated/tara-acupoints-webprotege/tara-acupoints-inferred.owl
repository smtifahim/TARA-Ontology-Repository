        <Literal>秉風(风)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_5888779</AbbreviatedIRI>
        <Literal>Pain in the scapular region, numbness and aching of the upper extremities, motor impairment of the shoulder and arm.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_5888779</AbbreviatedIRI>
        <Literal>The lateral suprascapular nerve and accessory nerve; deeper, the suprascapular nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_5888779</AbbreviatedIRI>
        <Literal>In the scapular region, in the supraspinatous fossa, superior to the midpoint of the spine of the scapula.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
