    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_1992799</AbbreviatedIRI>
        <Literal>Pain around the umbilical region, abdominal distension, hernia, diarrhea, constipation.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
