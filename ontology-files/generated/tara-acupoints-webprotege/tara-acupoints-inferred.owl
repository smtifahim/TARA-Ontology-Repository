        <AbbreviatedIRI>TARA:TARA_5290080</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001465</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
