        <AbbreviatedIRI>TARA:TARA_3114756</AbbreviatedIRI>
        <Literal>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 136. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasChineseLabel"/>
        <AbbreviatedIRI>TARA:TARA_3114756</AbbreviatedIRI>
        <Literal>然谷</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasDesignatedSpecialPointRole"/>
        <AbbreviatedIRI>TARA:TARA_3114756</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_9857829</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_3114756</AbbreviatedIRI>
        <Literal>Pruritus vulvae, prolapse of uterus, irregular menstruation, nocturnal emission, hemoptysis, thirst, diarrhea, swelling and pain of the dorsum of foot, acute infantile omphalitis.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_3114756</AbbreviatedIRI>
        <Literal>The terminal branch of the medial crural cutaneous nerve, the medial plantar nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_3114756</AbbreviatedIRI>
        <Literal>On the medial aspect of the foot, inferior to the tuberosity of the navicular bone, at the border between the red and white flesh.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_3114756</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_4813389</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasPinyinLabel"/>
        <AbbreviatedIRI>TARA:TARA_3114756</AbbreviatedIRI>
        <Literal>Rangu</Literal>
    </AnnotationAssertion>
