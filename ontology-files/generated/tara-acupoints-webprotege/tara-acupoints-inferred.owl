        <AbbreviatedIRI>TARA:TARA_9128934</AbbreviatedIRI>
        <Literal>Bladder 30</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_9128934</AbbreviatedIRI>
        <Literal>UB 30</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_9128934</AbbreviatedIRI>
        <Literal>Urinary Bladder 30</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_9128934</AbbreviatedIRI>
        <Literal>The inferior gluteal artery and vein; deeper, the internal pudendal artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_9128934</AbbreviatedIRI>
        <Literal>BL 30</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <Literal>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 42. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 7, Acupuncture Points of the Taiyin and Yangming Meridian. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasChineseLabel"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <Literal>扶突</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <Literal>Cough, asthma, sore throat, sudden loss of voice, scrofula, goiter.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <Literal>The great auricular nerve, cutaneous cervical nerve, lesser occipital nerve and accessory nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <Literal>On the anterior aspect of the neck, at the same level as the superior border of the thyroid cartilage, between the anterior and posterior borders of the sternocleidomastoid muscle.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_4610474</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <Literal>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasPinyinLabel"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <Literal>Futu</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_9159226</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0000974</AbbreviatedIRI>
