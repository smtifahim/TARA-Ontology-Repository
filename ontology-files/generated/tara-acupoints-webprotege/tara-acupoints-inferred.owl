        <AbbreviatedIRI>TARA:TARA_3549064</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0000033</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
