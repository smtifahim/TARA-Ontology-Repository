        <AbbreviatedIRI>TARA:TARA_4839095</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0004636</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
