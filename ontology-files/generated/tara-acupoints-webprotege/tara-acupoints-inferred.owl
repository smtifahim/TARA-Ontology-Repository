        <IRI>http://uri.interlex.org/base/ilx_0795500</IRI>
        <Literal>tendon of flexor carpi radialis</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795501</IRI>
        <Literal>The tendon of the muscle that flexes and adducts the hand at the wrist.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="NIFRID:synonym"/>
        <IRI>http://uri.interlex.org/base/ilx_0795501</IRI>
