        <AbbreviatedIRI>TARA:TARA_6392753</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0018407</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_6392753</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001456</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6392753</AbbreviatedIRI>
        <Literal>S 2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6392753</AbbreviatedIRI>
        <Literal>Stomach 2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_6392753</AbbreviatedIRI>
        <Literal>The branches of facial artery and vein, the infraorbital artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_6392753</AbbreviatedIRI>
        <Literal>ST 2</Literal>
    </AnnotationAssertion>
