    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_3496812</AbbreviatedIRI>
        <Literal>Puncture perpendicularly 0.5-1 inch. Moxibustion is applicable.</Literal>
    </AnnotationAssertion>
