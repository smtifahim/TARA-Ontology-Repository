        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_4839095</AbbreviatedIRI>
        <Literal>B 21</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_4839095</AbbreviatedIRI>
        <Literal>Back-Shu Point of the Stomach</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_4839095</AbbreviatedIRI>
        <Literal>Bladder 21</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_4839095</AbbreviatedIRI>
        <Literal>UB 21</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
