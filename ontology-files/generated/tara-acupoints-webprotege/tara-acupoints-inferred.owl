        <AbbreviatedIRI>TARA:TARA_0992296</AbbreviatedIRI>
        <Literal>Back-Shu Point of the Kidney</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0992296</AbbreviatedIRI>
        <Literal>Bladder 23</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0992296</AbbreviatedIRI>
        <Literal>UB 23</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
