        <AnnotationProperty abbreviatedIRI="obo:IAO_0000111"/>
        <AbbreviatedIRI>obo:RO_0001025</AbbreviatedIRI>
        <Literal xml:lang="en">located in</Literal>
    </AnnotationAssertion>
