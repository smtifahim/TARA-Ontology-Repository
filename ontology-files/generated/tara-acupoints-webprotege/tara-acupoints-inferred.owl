    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <AbbreviatedIRI>obo:UBERON_0002030</AbbreviatedIRI>
        <Literal>Nipple being part_of mammary gland is due to a practical modelling in uberon that treats mammary gland as including adnexa. A GCI asserts that nipple is part of the breast in humans. For discussion of this, please refer to https://github.com/obophenotype/uberon/issues/1873.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>obo:UBERON_0002030</AbbreviatedIRI>
