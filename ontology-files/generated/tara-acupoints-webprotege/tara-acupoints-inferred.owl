        <AbbreviatedIRI>TARA:TARA_1522109</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795316</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_1522109</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0005473</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1522109</AbbreviatedIRI>
        <Literal>B 34</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1522109</AbbreviatedIRI>
        <Literal>Bladder 34</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1522109</AbbreviatedIRI>
        <Literal>UB 34</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_1522109</AbbreviatedIRI>
        <Literal>Urinary Bladder 34</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_1522109</AbbreviatedIRI>
        <Literal>The branches of the inferior gluteal artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_1522109</AbbreviatedIRI>
        <Literal>BL 34</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_1565977</AbbreviatedIRI>
        <Literal>Source for the Acupoint Location: WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. Page 102. ISBN 978-92-9061-248-7.

Source for Acupuncture Method, Vasculature, Innervation, and Indications:
D. Liangyue, G. Yijun, H. Shuhui, et al. Chinese Acupuncture and Moxibustion. Revised ed. Beijing: Foreign Languages Press; 1999. Chapter 8, Acupuncture Points of the Shaoyin and Taiyang Meridian. ISBN 978-7-119-01758-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasChineseLabel"/>
        <AbbreviatedIRI>TARA:TARA_1565977</AbbreviatedIRI>
        <Literal>承光</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_1565977</AbbreviatedIRI>
        <Literal>Headache, blurring of vision, nasal obstruction.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_1565977</AbbreviatedIRI>
        <Literal>The anastomotic branch of the lateral branch of the frontal nerve and the great occipital nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_1565977</AbbreviatedIRI>
        <Literal>On the head, 2.5 B-cun superior to the anterior hairline, 1.5 B-cun lateral to the anterior median line. Note: 1.5 B-cun superior to BL5. 2 B-cun superior to BL4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_1565977</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_7525476</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_1565977</AbbreviatedIRI>
        <Literal>Puncture subcutaneously 0.3-0.5 inch.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasPinyinLabel"/>
        <AbbreviatedIRI>TARA:TARA_1565977</AbbreviatedIRI>
        <Literal>Chengguang</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
