        <AbbreviatedIRI>TARA:TARA_1452771</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795303</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_1452771</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795303</IRI>
    </AnnotationAssertion>
