        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_2063814</AbbreviatedIRI>
        <Literal>M-UE 1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_2063814</AbbreviatedIRI>
        <Literal>Shixuan</Literal>
    </AnnotationAssertion>
