        <AbbreviatedIRI>TARA:TARA_5290080</AbbreviatedIRI>
        <Literal>Bladder 40</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5290080</AbbreviatedIRI>
        <Literal>UB 40</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_5290080</AbbreviatedIRI>
        <Literal>Urinary Bladder 40</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_5290080</AbbreviatedIRI>
        <Literal>Superficially, the femoro-popliteal vein; deeper and medially, the popliteal vein; deepest, the popliteal artery.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_5290080</AbbreviatedIRI>
        <Literal>BL 40</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
