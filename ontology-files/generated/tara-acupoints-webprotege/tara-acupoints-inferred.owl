    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0000303</AbbreviatedIRI>
        <Literal>An adductor muscle that attaches to the hip and femur. In humans, it is a part of the adductor group of the thigh, that as the name suggests adducts the thigh. The adductor longus muscle forms the medial wall of the femoral triangle[WP, generalized].</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:UBERON_0000303</AbbreviatedIRI>
        <AbbreviatedIRI>obo:uberon.owl</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
