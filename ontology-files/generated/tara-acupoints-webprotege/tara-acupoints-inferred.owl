    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dc:description"/>
        <AbbreviatedIRI>TARA:TARA_0739106</AbbreviatedIRI>
        <Literal>An acupuncture point that is located along the Liver Meridian of Foot-Jueyin (LR), which consists of 14 standardized acupoints beginning at LR 1 (Dadun) on the lateral side of the great toe near the corner of the nail, traveling up along the medial aspect of the leg and passing through the genital region and abdomen, and ending at LR 14 (Qimen) on the anterior chest in the sixth intercostal space.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="dcterms:bibliographicCitation"/>
        <AbbreviatedIRI>TARA:TARA_0739106</AbbreviatedIRI>
        <Literal>WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization. Regional Office for the Western Pacific, 2008. ISBN 978-92-9061-248-7.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_0739106</AbbreviatedIRI>
        <AbbreviatedIRI>TARA:TARA_5419503</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0739106</AbbreviatedIRI>
        <Literal>Acupoint of the liver meridian of foot-jueyin</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0739106</AbbreviatedIRI>
        <Literal>Acupuncture point of the liver meridian</Literal>
    </AnnotationAssertion>
