    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_7756426</AbbreviatedIRI>
        <Literal>Numbness, soreness, motor impairment of the leg and knee, motor impairment of the lower extremities.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_7756426</AbbreviatedIRI>
        <Literal>The anterior and lateral femoral cutaneous nerves.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_7756426</AbbreviatedIRI>
        <Literal>On the anterolateral aspect of the thigh, lateral to the rectus femoris tendon, 3 B-cun superior to the base of the patella. Note: ST33 is at the midpoint of the line connecting St32 with the lateral end of the base of the patella.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
