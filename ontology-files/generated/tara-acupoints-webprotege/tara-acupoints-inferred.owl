        <AbbreviatedIRI>TARA:TARA_6681003</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0006906</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_6681003</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795290</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
