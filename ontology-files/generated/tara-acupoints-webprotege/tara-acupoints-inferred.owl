    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6412285</AbbreviatedIRI>
        <Literal>L 18</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_6412285</AbbreviatedIRI>
        <Literal>Stomach 18</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_6412285</AbbreviatedIRI>
        <Literal>The branches of the intercostal artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
