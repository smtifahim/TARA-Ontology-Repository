        <AbbreviatedIRI>TARA:TARA_4459765</AbbreviatedIRI>
        <Literal>Kidney 27</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_4459765</AbbreviatedIRI>
        <Literal>The anterior perforating branches of the internal mammary artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
