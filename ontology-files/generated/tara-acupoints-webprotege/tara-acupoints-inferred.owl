        <AbbreviatedIRI>TARA:TARA_9128934</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0005473</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
