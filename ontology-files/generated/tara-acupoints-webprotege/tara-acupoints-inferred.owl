        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0003701</AbbreviatedIRI>
        <Literal>The Achilles tendon is a tendon of the posterior leg. It serves to attach the plantaris, gastrocnemius (calf) and soleus muscles to the calcaneus (heel) bone.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
