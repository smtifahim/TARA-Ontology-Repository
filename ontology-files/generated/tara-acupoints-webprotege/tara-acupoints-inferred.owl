        <AbbreviatedIRI>TARA:TARA_0794971</AbbreviatedIRI>
        <Literal>Influential Point of Zang Organs</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0794971</AbbreviatedIRI>
        <Literal>LIV 13</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0794971</AbbreviatedIRI>
        <Literal>LV 13</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_0794971</AbbreviatedIRI>
        <Literal>Liver 13</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_0794971</AbbreviatedIRI>
        <Literal>The terminal branch of the tenth intercostal artery.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
