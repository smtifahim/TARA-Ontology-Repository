    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795317</IRI>
        <Literal>The biceps femoris tendon is the rounded tendon that attaches the muscle bellies of the long and short heads of the biceps femoris muscle to the head of the fibula.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
