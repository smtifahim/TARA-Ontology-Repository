        <AbbreviatedIRI>TARA:TARA_2459635</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0008878</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_2459635</AbbreviatedIRI>
        <Literal>L 10</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_2459635</AbbreviatedIRI>
        <Literal>Lung 10</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_2459635</AbbreviatedIRI>
        <Literal>Venules of the thumb draining to the cephalic vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_2459635</AbbreviatedIRI>
        <Literal>LU 10</Literal>
