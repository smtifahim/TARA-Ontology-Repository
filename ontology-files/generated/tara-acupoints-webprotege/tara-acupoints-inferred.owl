        <Literal>Ren 11</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_4904054</AbbreviatedIRI>
        <Literal>The branches of the superior and inferior epigastric arteries.</Literal>
    </AnnotationAssertion>
