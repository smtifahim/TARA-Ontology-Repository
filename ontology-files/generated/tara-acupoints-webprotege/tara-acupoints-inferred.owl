        <AbbreviatedIRI>obo:UBERON_0000303</AbbreviatedIRI>
        <AbbreviatedIRI>obo:NCBITaxon_9606</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:UBPROP_0000001"/>
        <AbbreviatedIRI>obo:UBERON_0000303</AbbreviatedIRI>
        <Literal>Originates on the iliac portion of the ventral iliac rim and inserts on the lateral surface of the M. adductor magnus.[AAO]</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
