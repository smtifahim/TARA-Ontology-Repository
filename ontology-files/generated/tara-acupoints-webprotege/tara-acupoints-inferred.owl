        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_3553465</AbbreviatedIRI>
        <Literal>Spleen 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_3553465</AbbreviatedIRI>
        <Literal>Anteriorly, the great saphenous vein, the genu suprema artery; deeper, the posterior tibial artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <AbbreviatedIRI>TARA:TARA_3553465</AbbreviatedIRI>
        <Literal>SP 9</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
