    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_5047952</AbbreviatedIRI>
        <Literal>Hypochondriac pain, abdominal distension, hiccup, acid regurgitation, mastitis, depression, febrile diseases.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_5047952</AbbreviatedIRI>
