        <IRI>http://uri.interlex.org/base/ilx_0795325</IRI>
        <Literal>tibialis anterior tendon</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <IRI>http://uri.interlex.org/base/ilx_0795326</IRI>
        <Literal>The demarcation at the posterior margin of the scalp where hair growth begins, near the nape of the neck.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
