        <AbbreviatedIRI>TARA:TARA_2542400</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795285</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasRelatedLocation"/>
        <AbbreviatedIRI>TARA:TARA_2542400</AbbreviatedIRI>
        <IRI>http://uri.interlex.org/base/ilx_0795301</IRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_2542400</AbbreviatedIRI>
