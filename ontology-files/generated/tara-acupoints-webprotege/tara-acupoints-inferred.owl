        <AbbreviatedIRI>TARA:TARA_3682571</AbbreviatedIRI>
        <Literal>Triple Burner 13</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_3682571</AbbreviatedIRI>
        <Literal>Triple Energizer 13</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_3682571</AbbreviatedIRI>
        <Literal>Triple Heater 13</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasSynonym"/>
        <AbbreviatedIRI>TARA:TARA_3682571</AbbreviatedIRI>
        <Literal>Triple Warmer 13</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasVasculatureDescription"/>
        <AbbreviatedIRI>TARA:TARA_3682571</AbbreviatedIRI>
        <Literal>The median collateral artery and vein.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
