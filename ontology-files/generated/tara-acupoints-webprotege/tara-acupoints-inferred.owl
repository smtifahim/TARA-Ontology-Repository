        <AnnotationProperty abbreviatedIRI="obo:IAO_0000115"/>
        <AbbreviatedIRI>obo:UBERON_0001350</AbbreviatedIRI>
        <Literal>A collection of caudal vertebrae in the coccygeal region that are fused and part of the bony pelvis.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="obo:IAO_0000412"/>
        <AbbreviatedIRI>obo:UBERON_0001350</AbbreviatedIRI>
