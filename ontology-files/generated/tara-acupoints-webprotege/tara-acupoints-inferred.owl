        <AnnotationProperty abbreviatedIRI="TARA:hasSurfaceLocation"/>
        <AbbreviatedIRI>TARA:TARA_3553465</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0003823</AbbreviatedIRI>
    </AnnotationAssertion>
