    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_4611734</AbbreviatedIRI>
        <Literal>Fullness and pain in the chest and hypochondrium, cough, asthma, mastitis.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_4611734</AbbreviatedIRI>
        <Literal>The branch of the anterior thoracic nerve.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_4611734</AbbreviatedIRI>
        <Literal>In the anterior thoracic region, in the third intercostal space, 4 B-cun lateral to the anterior median line.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMeridian"/>
        <AbbreviatedIRI>TARA:TARA_4611734</AbbreviatedIRI>
