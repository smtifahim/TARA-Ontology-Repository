        <AnnotationProperty abbreviatedIRI="TARA:hasLocationalDescription"/>
        <AbbreviatedIRI>TARA:TARA_1216325</AbbreviatedIRI>
        <Literal>On the dorsal crease of the wrist, in the depression on the radial side of the tendon of common extensor muscle of fingers between Yangxi (Ll 5) and Yangchi (TE 4).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasMethodDescription"/>
        <AbbreviatedIRI>TARA:TARA_1216325</AbbreviatedIRI>
        <Literal>Puncture perpendicularly 0.3-0.5 inch. Moxibustion is applicable.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
