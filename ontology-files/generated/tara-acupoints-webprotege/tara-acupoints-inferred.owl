        <AbbreviatedIRI>TARA:TARA_6681003</AbbreviatedIRI>
        <AbbreviatedIRI>obo:UBERON_0001456</AbbreviatedIRI>
    </AnnotationAssertion>
    <AnnotationAssertion>
