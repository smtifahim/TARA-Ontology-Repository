        <AnnotationProperty abbreviatedIRI="TARA:hasIndicationsDescription"/>
        <AbbreviatedIRI>TARA:TARA_5902217</AbbreviatedIRI>
        <Literal>Pain in the epigastric region, diarrhea, jaundice, epilepsy, stiffness and pain of the back.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="TARA:hasInnervationDescription"/>
        <AbbreviatedIRI>TARA:TARA_5902217</AbbreviatedIRI>
