@prefix : <http://www.acupunctureresearch.org/tara/ontology/acupoints.owl#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix tara-ap: <http://www.acupunctureresearch.org/tara/ontology/annotation-property/> .
@prefix tara-op: <http://www.acupunctureresearch.org/tara/ontology/object-property/> .
@prefix OboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@base <http://www.acupunctureresearch.org/tara/ontology/acupoints.owl> .

<http://www.acupunctureresearch.org/tara/ontology/acupoints.owl> rdf:type owl:Ontology ;
                                                                  dc:contributor "Fahim T. Imam, PhD - https://orcid.org/0000-0003-4752-543X" ,
                                                                                 "Ilias Ziogas, PhD - https://orcid.org/0000-0002-9210-2455" ,
                                                                                 "Maryann E. Martone, PhD - https://orcid.org/0000-0002-8406-3871" ,
                                                                                 "Richard Harris, PhD - https://orcid.org/0000-0002-2067-8447" ;
                                                                  dc:creator "Fahim T. Imam, PhD - https://orcid.org/0000-0003-4752-543X" ;
                                                                  dc:description """The TARA Acupoints Ontology is an ontology developed as part of the Topological Atlas and Repository for Acupoint Research (TARA) project funded by the National Institute of Health (NIH). The goal of TARA is to establish a new comprehensive resource for the acupuncture research and clinician community. The ontology will be used to support semantic search and annotations for anatomical maps, atlases, and data sets relevant to the TARA project.
- About TARA Project: https://www.acupunctureresearch.org/tara
- TARA Ontology GitHub Repo: https://purl.org/tara/ontology/repo
- TARA Ontology Updates: https://purl.org/tara/ontology/updates
- TARA Ontology Files: https://purl.org/tara/ontology"""@en ;
                                                                  dc:source "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. ISBN 978-7-119-01758-7."@en ,
                                                                            "WHO Standard Acupuncture Point Locations in the Western Pacific Region. World Health Organization (WHO), WHO Regional Office for the Western Pacific, 2008. Page 26. https://iris.who.int/handle/10665/353407"@en ;
                                                                  dc:title "TARA Acupoints Ontology"@en ;
                                                                  owl:versionInfo "1.7.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.obolibrary.org/obo/IAO_0000112
obo:IAO_0000112 rdf:type owl:AnnotationProperty ;
                rdfs:label "example of usage"@en .


###  http://purl.obolibrary.org/obo/IAO_0000115
obo:IAO_0000115 rdf:type owl:AnnotationProperty ;
                rdfs:label "definition"@en .


###  http://purl.obolibrary.org/obo/IAO_0000116
obo:IAO_0000116 rdf:type owl:AnnotationProperty ;
                rdfs:label "editor note"@en .


###  http://purl.obolibrary.org/obo/IAO_0000118
obo:IAO_0000118 rdf:type owl:AnnotationProperty ;
                rdfs:label "alternative label"@en .


###  http://purl.org/dc/elements/1.1/contributor
dc:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/identifier
dc:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/relation
dc:relation rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/source
dc:source rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/bibliographicCitation
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/isReferencedBy
dcterms:isReferencedBy rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/isRequiredBy
dcterms:isRequiredBy rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/references
dcterms:references rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/replaces
dcterms:replaces rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/requires
dcterms:requires rdf:type owl:AnnotationProperty .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasAbbreviation
tara-ap:hasAbbreviation rdf:type owl:AnnotationProperty ;
                        rdfs:label "Abbreviation" ;
                        rdfs:subPropertyOf obo:IAO_0000118 .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasAcronym
tara-ap:hasAcronym rdf:type owl:AnnotationProperty ;
                   rdfs:label "Acronym" ;
                   rdfs:subPropertyOf obo:IAO_0000118 .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasAcupointAnnotationProperty
tara-ap:hasAcupointAnnotationProperty rdf:type owl:AnnotationProperty ;
                                      obo:IAO_0000112 "This grouping property is never meant to be used for direct annotations. Direct annotations must be asserted through its specific, leaf-level subproperties."@en ;
                                      dcterms:description "An annotation property that groups all acupoint-specific annotation properties in the TARA Acupoints Ontology. Therefore, the domain for this property and each of its sub-properties is specified as 'Acupuncture Point'." ;
                                      dcterms:references tara-op:hasAcupointObjectProperty ;
                                      rdfs:label "Acupoint Annotation Property"@en ;
                                      rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty ;
                                      rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasAcupointInformation
tara-ap:hasAcupointInformation rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 "This property is never meant to be used for direct annotations. Dierect annotations must be asserted through its specific subproperties."@en ;
                               dcterms:description "An annotation property that groups all textual, descriptive attributes of an acupoint, including its anatomical location, needling method, indications, vasculature, and innervation. Subproperties further specialize the type of description."@en ;
                               rdfs:label "Acupoint Information"@en ;
                               rdfs:subPropertyOf tara-ap:hasAcupointAnnotationProperty ;
                               rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasAssociatedOrgan
tara-ap:hasAssociatedOrgan rdf:type owl:AnnotationProperty ;
                           obo:IAO_0000112 "'Lung Meridian' tara-ap:hasAssociatedOrgan 'Lung'."@en ;
                           dcterms:description """An annotation property that records the organ a Meridian is associated with according to traditional Chinese medicine theory, as a simple IRI annotation.
- Corresponds to the object property tara-op:hasAssociatedOrgan, which is used for logical axioms."""@en ;
                           dcterms:references tara-op:hasAssociatedOrgan ;
                           rdfs:label "Associated Organ"@en ;
                           rdfs:subPropertyOf tara-ap:hasMeridianAnnotationProperty ;
                           rdfs:range obo:UBERON_0001062 ;
                           rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Meridian> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasAuthor
tara-ap:hasAuthor rdf:type owl:AnnotationProperty ;
                  rdfs:label "Author(s)" ;
                  rdfs:subPropertyOf dc:creator .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasChineseLabel
tara-ap:hasChineseLabel rdf:type owl:AnnotationProperty ;
                        rdfs:label "Chinese Label" ;
                        rdfs:subPropertyOf obo:IAO_0000118 .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasCurationSourceLink
tara-ap:hasCurationSourceLink rdf:type owl:AnnotationProperty ;
                              dc:description "An annotation property that links an extracted metadata element, class, or individual to its precise origin in the data curation layer via a direct URL. For Google Sheets, the value must be a fully qualified, clickable URL containing specific worksheet identifier (gid) and target cell or row parameters (range), establishing strict machine-readable provenance down to the exact grid coordinate."@en ;
                              rdfs:label "Curation Source Link"@en ;
                              rdfs:subPropertyOf dc:source .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasDOI
tara-ap:hasDOI rdf:type owl:AnnotationProperty ;
               rdfs:subPropertyOf dc:identifier .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasEnglishLabel
tara-ap:hasEnglishLabel rdf:type owl:AnnotationProperty ;
                        rdfs:label "English Label" ;
                        rdfs:subPropertyOf obo:IAO_0000118 .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasFigureSourceLink
tara-ap:hasFigureSourceLink rdf:type owl:AnnotationProperty ;
                            dc:description "An annotation property that links a figure from a web resource to enhance the information about an ontological class or entity."@en ;
                            rdfs:label "Figure Source Link"@en ;
                            rdfs:subPropertyOf dc:source .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasGeneralSurfaceLocation
tara-ap:hasGeneralSurfaceLocation rdf:type owl:AnnotationProperty ;
                                  obo:IAO_0000112 """The acupoint 'LU 1' has the following locational description:
- \"On the anterior thoracic region, at the same level as the first intercostal space, lateral to the infraclavicular fossa, 6 B-cun lateral to the anterior median line.\"

Based on the description above, 'LU 1' has three specific reference locations within the general surface of 'Anterior Thoracic Region'. So we can state:
- 'LU 1' tara-ap:hasGeneralSurfaceLocation 'Anterior Thoracic Region' 

After assering the general location, we can specify the specific reference locations using this property's subproperty, hasSpecificReferenceLocation:
- 'LU 1' tara-ap:hasSpecificReferenceLocation 'Infraclavicular Fossa' .
- 'LU 1' tara-ap:hasSpecificReferenceLocation 'First Intercostal Space' .
- 'LU 1' tara-ap:hasSpecificReferenceLocation  'Anterior Median Line' ."""@en ;
                                  dcterms:description """An annotation property that records the IRI of the general body region on whose surface an acupoint is located (using UBERON or ILX IRI).
- Corresponds to the object property tara-op:hasGeneralSurfaceLocation, which is used for logical axioms."""@en ;
                                  dcterms:references tara-op:hasGeneralSurfaceLocation ;
                                  dcterms:requires tara-ap:hasLocationalDescription ;
                                  tara-ap:hasSynonym "General Surface Location"@en ;
                                  rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
                                  rdfs:label "General Location"@en ;
                                  rdfs:subPropertyOf tara-ap:hasRelatedSurfaceAnatomy ;
                                  rdfs:range obo:UBERON_0001062 ;
                                  rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasInnervationInformation
tara-ap:hasInnervationInformation rdf:type owl:AnnotationProperty ;
                                  obo:IAO_0000112 "'LU 1' tara-ap:hasInnervationDescription \"The intermediate supraclavicular nerve, the branches of the anterior thoracic nerve, and the lateral cutaneous branch of the first intercostal nerve.\""@en ;
                                  dcterms:description "An annotation property that describes the nerve supply in the vicinity of an acupoint relevant to safe needling."@en ;
                                  dcterms:isRequiredBy tara-ap:hasRelatedInnervation ,
                                                       tara-ap:hasRelatedNerve ,
                                                       tara-op:hasRelatedInnervation ,
                                                       tara-op:hasRelatedNerve ;
                                  rdfs:label "Innervation Information"@en ;
                                  rdfs:subPropertyOf tara-ap:hasAcupointInformation ;
                                  rdfs:range xsd:string ;
                                  rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasListedIndications
tara-ap:hasListedIndications rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "'LU 1' tara-ap:hasListedIndications \"cough, asthma, pain in the chest, shoulder and back; fullness of the chest\""@en ;
                             dcterms:description "An annotation property that lists the clinical conditions and symptoms for which an acupoint is indicated according to traditional Chinese medicine."@en ;
                             rdfs:label "Listed Indication(s)"@en ;
                             rdfs:subPropertyOf tara-ap:hasAcupointInformation ;
                             rdfs:range xsd:string ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasLocationalDescription
tara-ap:hasLocationalDescription rdf:type owl:AnnotationProperty ;
                                 obo:IAO_0000112 "'LU 1' tara-ap:hasLocationalDescription \"On the anterior thoracic region, at the same level as the first intercostal space, lateral to the infraclavicular fossa, 6 B-cun lateral to the anterior median line.\""@en ;
                                 dcterms:description "An annotation property that provides the canonical textual description of an acupoint's anatomical location on the body surface. Values follow the WHO Standard Acupuncture Point Locations where available."@en ;
                                 dcterms:isRequiredBy tara-ap:hasGeneralSurfaceLocation ,
                                                      tara-ap:hasRelatedSurfaceAnatomy ,
                                                      tara-ap:hasSpecificReferenceLocation ,
                                                      tara-op:hasGeneralSurfaceLocation ,
                                                      tara-op:hasRelatedSurfaceAnatomy ,
                                                      tara-op:hasSpecificReferenceLocation ;
                                 rdfs:label "Locational Description"@en ;
                                 rdfs:subPropertyOf tara-ap:hasAcupointInformation ;
                                 rdfs:range xsd:string ;
                                 rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasMeridianAnnotationProperty
tara-ap:hasMeridianAnnotationProperty rdf:type owl:AnnotationProperty ;
                                      obo:IAO_0000112 "This grouping property is never meant to be used for direct annotations. Direct annotations must be asserted through its specific subproperties."@en ;
                                      dcterms:description "An annotation property that groups all meridian-specific annotation properties in TARA Acupoints Ontology. Therefore, the domain for each of its sub-properties is specified as 'Acupuncture Meridan'."@en ;
                                      rdfs:label "Meridian Annotation Property"@en ;
                                      rdfs:subPropertyOf tara-ap:topTARAAnnotaionProperty .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasMethodDescription
tara-ap:hasMethodDescription rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "'LU 1' tara-ap:hasMethodDescription \"Puncture obliquely 0.5-0.8 cun towards the lateral aspect of the chest. To avoid injuring the lung, never puncture deeply towards the medial aspect. Moxibustion is applicable.\""@en ;
                             dcterms:description "An annotation property that describes the recommended needling method for an acupoint, including needle angle, depth, and applicability of moxibustion."@en ;
                             rdfs:label "Acupuncture Method"@en ;
                             rdfs:subPropertyOf tara-ap:hasAcupointInformation ;
                             rdfs:range xsd:string ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasNextAcupoint
tara-ap:hasNextAcupoint rdf:type owl:AnnotationProperty ;
                        obo:IAO_0000112 "'LU 1' tara:hasNextAcupoint 'LU 2'."@en ;
                        dcterms:description "An annotation property to link a meridian acupoint to its next acupoint along the same meridian."@en ;
                        rdfs:label "Next Acupoint"@en ;
                        rdfs:subPropertyOf tara-ap:hasAcupointAnnotationProperty ;
                        rdfs:range <http://www.acupunctureresearch.org/tara/ontology/Meridian_Acupoint> ;
                        rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Meridian_Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasPinyinLabel
tara-ap:hasPinyinLabel rdf:type owl:AnnotationProperty ;
                       rdfs:label "Pinyin Label" ;
                       rdfs:subPropertyOf obo:IAO_0000118 .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasPublicationDate
tara-ap:hasPublicationDate rdf:type owl:AnnotationProperty ;
                           rdfs:subPropertyOf dc:date .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasPublicationVenue
tara-ap:hasPublicationVenue rdf:type owl:AnnotationProperty ;
                            rdfs:subPropertyOf dc:relation .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasRelatedArtery
tara-ap:hasRelatedArtery rdf:type owl:AnnotationProperty ;
                         obo:IAO_0000112 """The acupoint 'LU 1' has the following vasculature information:
- \"Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein.\"

Based on the information above, we can state:
- 'LU 1' tara-ap:hasRelatedArtery 'axillary artery'.
- 'LU 1' tara-ap:hasRelatedArtery 'thoraco-acromial artery'."""@en ;
                         dcterms:description """An annotation property that records the IRI of a specific artery in the vicinity of an acupoint's penetrated region (relevant to safe needling). 
- Corresponds to the object property tara-op:hasRelatedArtery, which is used for logical axioms."""@en ;
                         dcterms:references tara-op:hasRelatedArtery ;
                         dcterms:requires tara-ap:hasVasculatureInformation ;
                         tara-ap:hasSynonym "Related Artery"@en ;
                         rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
                         rdfs:label "Nearby Artery"@en ;
                         rdfs:subPropertyOf tara-ap:hasRelatedVasculature ;
                         rdfs:range obo:UBERON_0001062 ;
                         rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasRelatedInnervation
tara-ap:hasRelatedInnervation rdf:type owl:AnnotationProperty ;
                              obo:IAO_0000112 """This property is not meant for direct annotations about the nerves involved in an innervation; rather, this property is meant to hold the neural connectivity representing the innervation. Direct annotations about the nerves associated with an acupoint-specific innervation must be asserted through its subproperty, tara-ap:hasRelatedNerve.

This property will be used to answer the question: \"What is the neural pathway and ultimate destination of the signals triggered by this acupoint's related nerves?\""""@en ;
                              dcterms:description """An annotation property that records the IRI of a neuron population providing the downstream innervation, supplied by, and triggered through, the related nerves of an acupoint.
- Corresponds to the object property tara-op:hasRelatedInnervation, which is used for logical axioms."""@en ;
                              dcterms:references tara-op:hasRelatedInnervation ;
                              dcterms:requires tara-ap:hasInnervationInformation ;
                              rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
                              rdfs:label "Related Innervation"@en ;
                              rdfs:subPropertyOf tara-ap:hasRelatedSubSurfaceAnatomy ;
                              rdfs:range obo:UBERON_0001062 ;
                              rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasRelatedNerve
tara-ap:hasRelatedNerve rdf:type owl:AnnotationProperty ;
                        obo:IAO_0000112 """The acupoint 'LU 1' has the following innervation information: 
- \"The intermediate supraclavicular nerve, the branches of the anterior thoracic nerve, and the lateral cutaneous branch of the first intercostal nerve.\"

Based on the information above, we can state:
- 'LU 1' tara-ap:hasRelatedNerve 'Intermediate Supraclavicular Nerve'.
- 'LU 1' tara-ap:hasRelatedNerve 'medial pectoral nerve'.
- 'LU 1' tara-ap:hasRelatedNerve 'First intercostal nerve'.

Note: The medial pectoral nerve (also known as the medial anterior thoracic nerve) is (typically) a branch of the medial cord of the brachial plexus and is derived from ventral rami  C8-T1."""@en ;
                        dcterms:description """An annotation property that records the IRI of a nerve within the vicinity of an acupoint's location, asserting that a specific named nerve, nerve trunk, or branch physically occupies or passes through the three-dimensional tissue volume penetrated by the acupoint needle.
- Corresponds to the object property tara-op:hasRelatedNerve, which is used for logical axioms."""@en ;
                        dcterms:references tara-op:hasRelatedNerve ;
                        dcterms:requires tara-ap:hasInnervationInformation ;
                        rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
                        rdfs:label "Related Nerve"@en ;
                        rdfs:subPropertyOf tara-ap:hasRelatedInnervation ;
                        rdfs:range obo:UBERON_0001062 ;
                        rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasRelatedSubSurfaceAnatomy
tara-ap:hasRelatedSubSurfaceAnatomy rdf:type owl:AnnotationProperty ;
                                    obo:IAO_0000112 "This grouping property is never meant to be used for direct annotations. Dierect annotations must be asserted through its specific, leaf-level subproperties."@en ;
                                    dcterms:description """A grouping annotation property, the subproperties of which record the IRIs of the nerves, arteries, and veins physically occupying, passing through, or overlapping the three-dimensional tissue volume penetrated by the acupoint needle.
- Corresponds to the object property tara-op:hasRelatedSubSurfaceAnatomy, which is used for logical axioms."""@en ;
                                    dcterms:references tara-op:hasRelatedSubSurfaceAnatomy ;
                                    rdfs:label "Related Subsurface Anatomy"@en ;
                                    rdfs:subPropertyOf tara-ap:hasTopographicalAnatomy ;
                                    rdfs:range obo:UBERON_0001062 ;
                                    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasRelatedSurfaceAnatomy
tara-ap:hasRelatedSurfaceAnatomy rdf:type owl:AnnotationProperty ;
                                 obo:IAO_0000112 "This property is never meant to be used for direct annotations. Dierect annotations must be asserted through its subproperties."@en ;
                                 dcterms:description """A grouping annotation property that records the IRIs of the anatomical region and landmarks associated with an acupoint's surface location through its subproperties.
- Corresponds to the object property tara-op:hasRelatedSurfaceAnatomy, which is used for logical axioms."""@en ;
                                 dcterms:references tara-op:hasRelatedSurfaceAnatomy ;
                                 dcterms:requires tara-ap:hasLocationalDescription ;
                                 rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
                                 rdfs:label "Related Surface Anatomy"@en ;
                                 rdfs:subPropertyOf tara-ap:hasTopographicalAnatomy ;
                                 rdfs:range obo:UBERON_0001062 ;
                                 rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasRelatedVasculature
tara-ap:hasRelatedVasculature rdf:type owl:AnnotationProperty ;
                              obo:IAO_0000112 """This gruping property is never meant to be used for direct annotations. Dierect annotations must be asserted through its specific subproperties.

The acupoint 'LU 1' has the following vasculature information:
- \"Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein.\"

Based on the information above we can use the following subproperties to assert:
- 'LU 1' tara-ap:hasRelatedArtery 'axillary artery'.
- 'LU 1' tara-ap:hasRelatedArtery 'thoraco-acromial artery'.
- 'LU 1' tara-ap:hasRelatedVein 'axillary vein'.
- 'LU 1' tara-ap:hasRelatedVein 'thoracoacromial vein'."""@en ;
                              dcterms:description """A grouping annotation property whose subproperties record the IRIs of the blood vessels (such as arteries and veins) in the vicinity of an acupoint's penetrated region (relevant to safe needling).
- Corresponds to the object property tara-op:hasRelatedVasculature, which is used for logical axioms."""@en ;
                              dcterms:references tara-op:hasRelatedVasculature ;
                              rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
                              rdfs:label "Related Vasculature"@en ;
                              rdfs:subPropertyOf tara-ap:hasRelatedSubSurfaceAnatomy ;
                              rdfs:range obo:UBERON_0001062 ;
                              rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasRelatedVein
tara-ap:hasRelatedVein rdf:type owl:AnnotationProperty ;
                       obo:IAO_0000112 """The acupoint 'LU 1' has the following vasculature information:
- \"Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein.\"

Based on the information above, we can state:
- 'LU 1' tara-ap:hasRelatedVein 'axillary vein'.
- 'LU 1' tara-ap:hasRelatedVein 'thoracoacromial vein'."""@en ;
                       dcterms:description """An annotation property that records the IRI of a specific vein in the vicinity of an acupoint's penetrated region (relevant to safe needling).
- Corresponds to the object property tara-op:hasRelatedVein, which is used for logical axioms."""@en ;
                       dcterms:references tara-op:hasRelatedVein ;
                       dcterms:requires tara-ap:hasVasculatureInformation ;
                       tara-ap:hasSynonym "Related Vein"@en ;
                       rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
                       rdfs:label "Nearby Vein"@en ;
                       rdfs:subPropertyOf tara-ap:hasRelatedVasculature ;
                       rdfs:range obo:UBERON_0001062 ;
                       rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasSpecialPointRole
tara-ap:hasSpecialPointRole rdf:type owl:AnnotationProperty ;
                            obo:IAO_0000112 "'LU 1' tara-ap:hasSpecialPointRole 'Front-Mu Point of the Lung'."@en ;
                            dcterms:description "An annotation property that records the special point role(s) IRI designated to an acupoint as a textual annotation. Corresponds to the object property tara-op:hasSpecialPointRole, which is used for the logical classification of Special Points."@en ;
                            dcterms:references tara-op:hasSpecialPointRole ;
                            rdfs:label "Special Point Role"@en ;
                            rdfs:subPropertyOf tara-ap:hasAcupointAnnotationProperty ;
                            rdfs:range <http://www.acupunctureresearch.org/tara/ontology/Special_Acupoint_Role> ;
                            rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasSpecificReferenceLocation
tara-ap:hasSpecificReferenceLocation rdf:type owl:AnnotationProperty ;
                                     obo:IAO_0000112 """The acupoint 'LU 1' has the following locational description:
- \"On the anterior thoracic region, at the same level as the first intercostal space, lateral to the infraclavicular fossa, 6 B-cun lateral to the anterior median line.\"

Based on the description above, 'LU 1' has three specific reference locations within the general surface of 'Anterior Thoracic Region'. So, using this property's superproperty, hasGeneralSurfaceLocation, we can state:
- 'LU 1' tara-ap:hasGeneralSurfaceLocation 'Anterior Thoracic Region'.

After stating the general location, we can use this property to assert the specific reference locations:
- 'LU 1' tara-ap:hasSpecificReferenceLocation 'Infraclavicular Fossa' .
- 'LU 1' tara-ap:hasSpecificReferenceLocation 'First Intercostal Space' .
- 'LU 1' tara-ap:hasSpecificReferenceLocation  'Anterior Median Line' ."""@en ;
                                     dcterms:description """An annotation property that records the IRI of a specific anatomical landmark within the general surface region of an acupoint (using UBERON or ILX IRI).
- Corresponds to the object property tara-op:hasSpecificReferenceLocation, which is used for logical axioms."""@en ;
                                     dcterms:references tara-op:hasSpecificReferenceLocation ;
                                     dcterms:requires tara-ap:hasLocationalDescription ;
                                     tara-ap:hasSynonym "Specific Reference Location"@en ;
                                     rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
                                     rdfs:label "Reference Location"@en ;
                                     rdfs:subPropertyOf tara-ap:hasGeneralSurfaceLocation ;
                                     rdfs:range obo:UBERON_0001062 ;
                                     rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasSynonym
tara-ap:hasSynonym rdf:type owl:AnnotationProperty ;
                   rdfs:label "Synonym" ;
                   rdfs:subPropertyOf obo:IAO_0000118 .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasTopographicalAnatomy
tara-ap:hasTopographicalAnatomy rdf:type owl:AnnotationProperty ;
                                obo:IAO_0000112 "This grouping property is never meant to be used for direct annotations. Direct annotations must be asserted through its specific, leaf-level subproperties."@en ;
                                dcterms:description """An annotation property that groups all IRI annotations (using UBERON or ILX IRI) relating an acupoint to its topographical anatomy, through its specific subproperties that assert the IRIs of the anatomical entities within the vicinity of the three-dimensional tissue volume penetrated by the acupoint needle.
- Corresponds to the object property tara-op:hasTopographicalAnatomy, which is the root of the corresponding logical property hierarchy."""@en ;
                                dcterms:references tara-op:hasTopographicalAnatomy ;
                                tara-ap:hasSynonym "Regional Anatomy"@en ;
                                rdfs:label "Topographical Anatomy"@en ;
                                rdfs:subPropertyOf tara-ap:hasAcupointAnnotationProperty ;
                                rdfs:range obo:UBERON_0001062 ;
                                rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/hasVasculatureInformation
tara-ap:hasVasculatureInformation rdf:type owl:AnnotationProperty ;
                                  obo:IAO_0000112 "'LU 1' tara-ap:hasVasculatureInformation \"Superolaterally, the axillary artery and vein, the thoracoacromial artery and vein.\""@en ;
                                  dcterms:description "An annotation property that describes the blood vessels and arteries in the vicinity of an acupoint relevant to safe needling."@en ;
                                  dcterms:isRequiredBy tara-ap:hasRelatedArtery ,
                                                       tara-ap:hasRelatedVasculature ,
                                                       tara-ap:hasRelatedVein ,
                                                       tara-op:hasRelatedArtery ,
                                                       tara-op:hasRelatedVasculature ,
                                                       tara-op:hasRelatedVein ;
                                  rdfs:label "Vasculature Information"@en ;
                                  rdfs:subPropertyOf tara-ap:hasAcupointInformation ;
                                  rdfs:range xsd:string ;
                                  rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/isLocatedOnMeridian
tara-ap:isLocatedOnMeridian rdf:type owl:AnnotationProperty ;
                            obo:IAO_0000112 "'LU 1' tara-ap:isLocatedOnMeridian 'Lung Meridian'."@en ;
                            dcterms:description "An annotation property that records the Meridian along which an Acupoint is located, as a simple textual/IRI annotation. Corresponds to the object property tara-op:isLocatedOnMeridian, which is used for logical axioms."@en ;
                            dcterms:references tara-op:isLocatedOnMeridian ;
                            rdfs:label "Acupoint of Meridian"@en ;
                            rdfs:subPropertyOf tara-ap:hasAcupointAnnotationProperty ;
                            rdfs:range <http://www.acupunctureresearch.org/tara/ontology/Meridian> ;
                            rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/isMeridianLocationOf
tara-ap:isMeridianLocationOf rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "'Lung Meridian' tara-ap:isMeridianLocationOf 'LU 1'"@en ;
                             dcterms:description """An annotation property that relates a Meridian to an Acupoint that is located along its linear trajectory, as a simple IRI annotation.
- Corresponds to the object property tara-op:isMeridianLocationOf, which is used for logical axioms."""@en ;
                             dcterms:references tara-op:isMeridianLocationOf ;
                             rdfs:label "Meridian of Acupoint"@en ;
                             rdfs:subPropertyOf tara-ap:hasMeridianAnnotationProperty ;
                             rdfs:range <http://www.acupunctureresearch.org/tara/ontology/Meridian_Acupoint> ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Meridian> .


###  http://www.acupunctureresearch.org/tara/ontology/annotation-property/topTARAAnnotaionProperty
tara-ap:topTARAAnnotaionProperty rdf:type owl:AnnotationProperty ;
                                 dcterms:description "An annotation property that groups all TARA-specific annotation properties. It is a grouping relation that functions purely as an organizational root for browsing/querying the TARA-specific annotation property tree."@en ;
                                 rdfs:label "tara:topAnnotationProperty"@en .


###  http://www.geneontology.org/formats/oboInOwl#creation_date
OboInOwl:creation_date rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000050
obo:BFO_0000050 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf tara-op:bfoObjectProperty .


###  http://purl.obolibrary.org/obo/BFO_0000051
obo:BFO_0000051 rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf tara-op:bfoObjectProperty .


###  http://purl.obolibrary.org/obo/RO_0001025
obo:RO_0001025 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf tara-op:roObjectProperty .


###  http://purl.obolibrary.org/obo/RO_0002170
obo:RO_0002170 rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf tara-op:roObjectProperty .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasMeridianObjectProperty
<http://www.acupunctureresearch.org/tara/ontology/kb/hasMeridianObjectProperty> rdf:type owl:ObjectProperty ;
                                                                                rdfs:subPropertyOf tara-op:topTARAObjectProperty ;
                                                                                rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Meridian> ;
                                                                                dcterms:description "An object property grouping all meridian-specific object properties in TARA Acupoints Ontology. Therefore, the domain for this property is 'Acupuncture Meridian' which is inherited by all its subproperties." .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/bfoObjectProperty
tara-op:bfoObjectProperty rdf:type owl:ObjectProperty ;
                          rdfs:label "bfo:topObjectProperty" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasAcupointObjectProperty
tara-op:hasAcupointObjectProperty rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf tara-op:topTARAObjectProperty ;
                                  rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/Acupoint> ;
                                  dcterms:description "An object property grouping all acupoint-specific object properties in TARA Acupoints Ontology. Therefore, the domain for this property is 'Acupuncture Point' which is inherited by all its subproperties." ;
                                  dcterms:isReferencedBy tara-ap:hasAcupointAnnotationProperty .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasAssociatedOrgan
tara-op:hasAssociatedOrgan rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf <http://www.acupunctureresearch.org/tara/ontology/kb/hasMeridianObjectProperty> ;
                           rdfs:range obo:UBERON_0001062 ;
                           obo:IAO_0000112 "'Lung Meridian' tara-op:hasAssociatedOrgan some 'Lung'."@en ;
                           obo:IAO_0000115 "A Meridian x hasAssociatedOrgan an organ y if and only if traditional Chinese medicine theory designates y as the organ system with which x is affiliated."@en ;
                           obo:IAO_0000116 "Not declared as a subproperty of any RO relation, because the organ affiliation of a meridian is a doctrinal/functional association defined by TCM theory rather than a spatial or mereological relationship; located_in, overlaps, and part_of do not accurately describe it, so the property is left ungrounded at the top of the object-property hierarchy. - Fahim Imam"@en ;
                           dcterms:description "An object property that relates a meridian to the organ it is associated with according to traditional Chinese medicine theory. Used to express the organ affiliation of a meridian as an OWL axiom."@en ;
                           dcterms:isReferencedBy tara-ap:hasAssociatedOrgan ;
                           rdfs:label "hasAssociatedOrgan" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasGeneralSurfaceLocation
tara-op:hasGeneralSurfaceLocation rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf tara-op:hasRelatedSurfaceAnatomy ;
                                  obo:IAO_0000112 "'LU 1' tara-op:hasGeneralSurfaceLocation some 'Anterior Thoracic Region'."@en ;
                                  obo:IAO_0000115 "An Acupoint x hasGeneralSurfaceLocation a region y if and only if x hasRelatedSurfaceAnatomy y, and y is the coarse-grained body region within which x is situated."@en ;
                                  obo:IAO_0000116 "Inherits its subproperty-of relation to RO:0001025 (located_in) from its parent property hasRelatedSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
                                  dcterms:description "An object property that relates an acupoint to the general body region on whose surface it is located. It provides a coarse-grained anatomical grouping for the acupoint and is used together with hasSpecificReferenceLocation, which further specifies particular anatomical landmarks within this general region."@en ;
                                  dcterms:isReferencedBy tara-ap:hasGeneralSurfaceLocation ;
                                  dcterms:replaces "tara-op:locatedOnTheSurfaceOf" ;
                                  dcterms:requires tara-ap:hasLocationalDescription ;
                                  rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
                                  rdfs:label "hasGeneralSurfaceLocation" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasRelatedArtery
tara-op:hasRelatedArtery rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf tara-op:hasRelatedVasculature ;
                         obo:IAO_0000112 """'LU 1' tara-op:hasRelatedArtery some 'Axillary Artery'; 
'LU 1' tara-op:hasRelatedArtery some 'Thoracoacromial Artery'."""@en ;
                         obo:IAO_0000115 "An acupoint x hasRelatedArtery y if and only if x hasRelatedVasculature y and y is an artery."@en ;
                         obo:IAO_0000116 "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its ancestor properties hasRelatedVasculature and hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
                         dcterms:description "An object property that associates an acupoint to a specific related artery occupying its location."@en ;
                         dcterms:isReferencedBy tara-ap:hasRelatedArtery ;
                         dcterms:requires tara-ap:hasVasculatureInformation ;
                         rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
                         rdfs:label "hasRelatedArtery" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasRelatedInnervation
tara-op:hasRelatedInnervation rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf tara-op:hasRelatedSubSurfaceAnatomy ;
                              obo:IAO_0000112 """This property is not used for asserting direct logical axioms. It can be used to define innervation details based on its subproperty, hasRelatedNerve, where the nerve asserted is the axon location of a neuron population in SCKAN connectivity knowledgebase.
- SuperPropertyOf: hasRelatedNerve o isAxonLocationOf""" ;
                              obo:IAO_0000115 "An acupoint x hasRelatedInnervation a neuron population y if and only if x hasRelatedNerve a nerve z and y hasAxonLocation z."@en ;
                              obo:IAO_0000116 "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its parent property hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ,
                                              """This property is not used for asserting direct logical axioms. It can be used to define an acupoint's innervation details based on its subproperty connecting with SCKAN connectivity ontology. 
- If acupoint-x tara-op:hasRelatedNerve some nerve-y; and
- neuron-x ilxtr:hasAxonLocation some nerve-y; and
- neuron-x ilxtr:hasSomaLocation some region-a; and
- neuron-x ilxtr:hasAxonTerminal' some region-b1; and 
- neuron x ilxtr:hasAxonSensoryTerminal' some region-b2;
- Then, 'acupoint x' hasInnervation 'neuron x: a to b1, a to b2 via nerve-y'"""@en ;
                              dcterms:description "An object property that relates an acupoint to a neruon population representing the downstream innervation pathways and ultimate destination, supplied by, and triggered through, the related nerves of an acupoint."@en ;
                              dcterms:isReferencedBy tara-ap:hasRelatedInnervation ;
                              dcterms:requires tara-ap:hasInnervationInformation ;
                              rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
                              rdfs:label "hasRelatedInnervation" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasRelatedNerve
tara-op:hasRelatedNerve rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf tara-op:hasRelatedInnervation ;
                        obo:IAO_0000112 "'LU 1' tara-op:hasRelatedNerve some 'Intermediate Supraclavicular Nerve'"@en ;
                        obo:IAO_0000115 """An acupoint x hasRelatedNerve a nerve y if and only if x hasRelatedSubsurfaceAnatomy y.

An acupoint x hasRelatedNerve a nerve y if and only if x hasRelatedInnervation a neuron population z and z hasAxonLocation y."""@en ;
                        obo:IAO_0000116 "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its ancestor properties hasRelatedInnervation and hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
                        dcterms:description "An object property that relates an acupoint to a related nerve occupying or passing through the 3D tissue volume penetrated by an acupoint needle."@en ;
                        dcterms:isReferencedBy tara-ap:hasRelatedNerve ;
                        dcterms:requires tara-ap:hasInnervationInformation ;
                        rdfs:isDefinedBy tara-ap:hasInnervationInformation ;
                        rdfs:label "hasRelatedNerve" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasRelatedSubSurfaceAnatomy
tara-op:hasRelatedSubSurfaceAnatomy rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf tara-op:hasTopographicalAnatomy ;
                                    obo:IAO_0000112 "This property is never meant for asserting direct axioms. Direct axioms must be asserted using its specific subproperties." ;
                                    obo:IAO_0000115 "An acupoint x hasRelatedSubSurfaceAnatomy a material anatomical entity y if and only if x overlaps y, where y is a nerve, artery, or vein occupying the fiat volume of x."@en ;
                                    obo:IAO_0000116 "Declared as a subproperty of RO:0002131 (overlaps) because an acupoint, modeled as a BFO:0000024 (Fiat Object Part), and the nerves/vessels beneath it are both material entities; the segment of the nerve or vessel passing through the acupoint's fiat volume is a literal shared part, satisfying overlaps' requirement of a common part between the two continuants. - Fahim Imam"@en ;
                                    dcterms:description "An object property that relates an acupoint to the nerves, arteries, and veins that occupy the same shallow tissue volume as the acupoint at the site of needle insertion."@en ;
                                    dcterms:isReferencedBy tara-ap:hasRelatedSubSurfaceAnatomy ;
                                    rdfs:label "hasRelatedSubSurfaceAnatomy" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasRelatedSurfaceAnatomy
tara-op:hasRelatedSurfaceAnatomy rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf tara-op:hasTopographicalAnatomy ;
                                 obo:IAO_0000115 "An acupoint x hasRelatedSurfaceAnatomy an anatomical entity y if and only if x is located_in y, where y is a surface-level anatomical region, landmark, fossa, or line used to describe the position of x on the body surface."@en ;
                                 obo:IAO_0000116 "Declared as a subproperty of RO:0001025 (located_in) rather than RO:0002131 (overlaps), because the anatomical entities used to describe surface location (e.g., regions, fossae, lines) span a mix of material and immaterial UBERON classes; located_in does not require the related entities to share a common part, so it remains valid across this mixed range, unlike overlaps. - Fahim Imam"@en ;
                                 dcterms:description "An object property that relates an acupoint to an anatomical region, fossa, line, or other surface landmark in the vicinity of its location on the body surface."@en ;
                                 dcterms:isReferencedBy tara-ap:hasRelatedSurfaceAnatomy ;
                                 dcterms:requires tara-ap:hasLocationalDescription ;
                                 rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
                                 rdfs:label "hasRelatedSurfaceAnatomy"@en .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasRelatedVasculature
tara-op:hasRelatedVasculature rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf tara-op:hasRelatedSubSurfaceAnatomy ;
                              obo:IAO_0000115 "An acupoint x hasRelatedVasculature a vessel y if and only if x hasRelatedSubSurfaceAnatomy y."@en ;
                              obo:IAO_0000116 "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its parent property hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
                              dcterms:description "An object property that relates an acupoint to a blood vessel in the vicinity of its penetrated region, relevant to safe needling."@en ;
                              dcterms:isReferencedBy tara-ap:hasRelatedVasculature ;
                              dcterms:requires tara-ap:hasVasculatureInformation ;
                              rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
                              rdfs:label "hasRelatedVasculature" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasRelatedVein
tara-op:hasRelatedVein rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf tara-op:hasRelatedVasculature ;
                       obo:IAO_0000112 """'LU 1' tara-op:hasRelatedVein some 'Axillary Vein'; 
'LU 1' tara-op:hasRelatedVein some 'Thoracoacromial Vein'."""@en ;
                       obo:IAO_0000115 "An acupoint x hasRelatedVein y if and only if x hasRelatedVasculature y and y is a vein."@en ;
                       obo:IAO_0000116 "Inherits its subproperty-of relation to RO:0002131 (overlaps) from its ancestor properties hasRelatedVasculature and hasRelatedSubSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
                       dcterms:description "An object property that associates an acupoint to a specific related vein occupying its location."@en ;
                       dcterms:isReferencedBy tara-ap:hasRelatedVein ;
                       dcterms:requires tara-ap:hasVasculatureInformation ;
                       rdfs:isDefinedBy tara-ap:hasVasculatureInformation ;
                       rdfs:label "hasRelatedVein" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecialPointRole
tara-op:hasSpecialPointRole rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf tara-op:hasAcupointObjectProperty ;
                            rdfs:range <http://www.acupunctureresearch.org/tara/ontology/Special_Acupoint_Role> ;
                            obo:IAO_0000112 "'LU 1'  tara-op:hasSpecialPointRole some 'Front-Mu Point of the Lung Role'."@en ;
                            obo:IAO_0000115 "An Acupoint x hasSpecialPointRole a role y if and only if x has_role y, where y is a Special_Acupoint_Role realized in acupuncture practice."@en ;
                            obo:IAO_0000116 "Declared as a subproperty of RO:0000087 (has_role) rather than the more generic RO:0000053 (bearer_of), because its range is specifically restricted to instances of Special_Acupoint_Role, a subclass of BFO:0000023 Role; has_role is the RO relation specific to realizable entities of type Role, giving a more precise commitment than the fully general bearer_of. - Fahim Imam"@en ;
                            dcterms:description "An object property that relates an acupoint to the special role it bears. It is the inverse of isSpecialPointRoleOf and is the sole property used in this ontology to assert special-point classification for acupoints."@en ;
                            dcterms:isReferencedBy tara-ap:hasSpecialPointRole ;
                            rdfs:label "hasSpecialPointRole" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasSpecificReferenceLocation
tara-op:hasSpecificReferenceLocation rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf tara-op:hasGeneralSurfaceLocation ;
                                     obo:IAO_0000112 """The acupoint 'LU 1' has three specific reference locations within the general surface of 'Anterior Thoracic Region':
'LU 1' tara-op:hasSpecificReferenceLocation some 'First Intercostal Space'; 'LU 1' tara-op:hasSpecificReferenceLocation some 'Infraclavicular Fossa';
'LU 1' tara-op:hasSpecificReferenceLocation some 'Anterior Median Line'."""@en ;
                                     obo:IAO_0000115 "An acupoint x hasSpecificReferenceLocation a landmark y if and only if x hasGeneralSurfaceLocation y, and y is a specific anatomical landmark, fossa, or line used to further localize x within its general surface region."@en ;
                                     obo:IAO_0000116 "Inherits its subproperty-of relation to RO:0001025 (located_in) from its parent property hasRelatedSurfaceAnatomy; rdfs:subPropertyOf is transitive, so no separate RO assertion is required here. - Fahim Imam"@en ;
                                     dcterms:description "An object property that relates an acupoint to one or more specific anatomical landmarks within the general body region identified by hasGeneralSurfaceLocation, providing a finer-grained localization of the acupoint."@en ;
                                     dcterms:isReferencedBy tara-ap:hasSpecificReferenceLocation ;
                                     dcterms:replaces "tara-op:locatedInRelationTo" ;
                                     dcterms:requires tara-ap:hasLocationalDescription ;
                                     rdfs:isDefinedBy tara-ap:hasLocationalDescription ;
                                     rdfs:label "hasSpecificReferenceLocation" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/hasTopographicalAnatomy
tara-op:hasTopographicalAnatomy rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf tara-op:hasAcupointObjectProperty ;
                                rdfs:range obo:UBERON_0001062 ;
                                obo:IAO_0000115 "A grouping relation between an acupoint and any anatomical entity related to its surface or subsurface topography, holding whenever a more specific subproperty of hasTopographicalAnatomy holds between the same two entities."@en ;
                                obo:IAO_0000116 "Declared as a direct subproperty of tara-op:topObjectProperty rather than of any RO relation, because it is used purely to organize the Acupoint-specific property hierarchy for browsing and querying and does not itself assert overlap, location, or any other specific spatial relationship; that logical content is carried entirely by its subproperties. - Fahim Imam"@en ;
                                dcterms:description "An object property that groups all relations between an acupoint and the surface and subsurface anatomical entities associated with its location and needling, including surface regions, landmarks, nerves, arteries, and veins. It is the root organizational property for an acupoint's specific topographical property and carries no independent logical commitment of its own."@en ;
                                dcterms:isReferencedBy tara-ap:hasTopographicalAnatomy ;
                                tara-ap:hasSynonym "hasRegionalAnatomy" ;
                                rdfs:label "hasTopographicalAnatomy" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/isLocatedOnMeridian
tara-op:isLocatedOnMeridian rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf tara-op:hasAcupointObjectProperty ;
                            owl:inverseOf tara-op:isMeridianLocationOf ;
                            rdfs:range <http://www.acupunctureresearch.org/tara/ontology/Meridian> ;
                            obo:IAO_0000112 "'LU 1' tara-op:isLocatedOnMeridian some 'Lung Meridian'."@en ;
                            obo:IAO_0000115 "An acupoint a isLocatedOnMeridian a Meridian b if and only if a is located_in b, where b is the one-dimensional fiat channel along which a is conventionally situated."@en ;
                            dcterms:description "An object property that relates an Acupoint to the Meridian along which it is located."@en ;
                            dcterms:isReferencedBy tara-ap:isLocatedOnMeridian ;
                            rdfs:comment "Declared as a subproperty of RO:0001025 (located_in) rather than RO:0002350 (member_of), because a Meridian is modeled as a BFO:0000009 (one-dimensional continuant fiat boundary), a channel that acupoints are located along, rather than as an aggregate whose identity is exhausted by the sum of its acupoints; located_in correctly expresses this geometric relationship without implying that the meridian is merely a collection of its acupoints."@en ;
                            rdfs:label "isLocatedOnMeridian" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/isMeridianLocationOf
tara-op:isMeridianLocationOf rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf <http://www.acupunctureresearch.org/tara/ontology/kb/hasMeridianObjectProperty> ;
                             rdfs:range <http://www.acupunctureresearch.org/tara/ontology/Meridian_Acupoint> ;
                             obo:IAO_0000112 "'Lung Meridian' tara-op:isMeridianLocationOf some 'LU 1'."@en ;
                             dcterms:description "An object property that relates a meridian to an acupoint that is located along its linear trajectory. It serves as the exact inverse relation of 'isLocatedOnMeridian'."@en ;
                             dcterms:isReferencedBy tara-ap:isMeridianLocationOf ;
                             rdfs:label "isMeridianLocationOf"@en .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/roObjectProperty
tara-op:roObjectProperty rdf:type owl:ObjectProperty ;
                         rdfs:label "ro:topObjectProperty" .


###  http://www.acupunctureresearch.org/tara/ontology/object-property/topTARAObjectProperty
tara-op:topTARAObjectProperty rdf:type owl:ObjectProperty ;
                              dcterms:description "A grouping relation that functions purely as an organizational root for browsing/querying the TARA-specific object property tree, and asserts no independent semantic commitment that a reasoner needs to satisfy."@en ;
                              rdfs:label "tara-op:topObjectProperty" .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/UBERON_0001062
obo:UBERON_0001062 rdf:type owl:Class ;
                   obo:IAO_0000115 "Biological entity that is either an individual member of a biological species or constitutes the structural organization of an individual member of a biological species." ;
                   rdfs:label "anatomical entity" .


###  http://www.acupunctureresearch.org/tara/ontology/Acupoint
<http://www.acupunctureresearch.org/tara/ontology/Acupoint> rdf:type owl:Class ;
                                                            obo:IAO_0000115 "A fiat object part of the human body, delimited by the practice of needling rather than by any natural physical discontinuity, consisting of a surface locus where a needle is inserted together with the shallow underlying tissue it penetrates, without commitment to the exact depth or angle of penetration."@en ;
                                                            obo:IAO_0000116 "Acupoint is modeled as a subclass of 'fiat object part' (BFO:0000024): An acupoint is a fiat-demarcated volume carved out of whatever pre-existing material entities (skin, subcutaneous tissue, fascia, muscle) occupy that location, delimited by the practice of needling. Its identity as, e.g., \"LU 1\", as distinct from the surrounding tissue, comes entirely from TCM/acupuncture convention, not from any physical discontinuity or histological boundary."@en ;
                                                            dcterms:bibliographicCitation "Fang Li, Tian He, Qian Xu, Li-Ting Lin, Hui Li, Yan Liu, Guang-Xia Shi, Cun-Zhi Liu, What is the Acupoint? A preliminary review of Acupoints, Pain Medicine, Volume 16, Issue 10, October 2015, Pages 1905–1915, https://doi.org/10.1111/pme.12761" ;
                                                            dcterms:description "According to traditional Chinese medicine (TCM) theory, acupoints are specifically chosen sites of acupuncture manipulation, and also the basis for studying the mechanism of acupuncture. Stimulating different acupoints on the body surface could provide various therapeutic benefits."@en ;
                                                            tara-ap:hasSynonym "Acupoint" ;
                                                            rdfs:label "Acupuncture Point" .


###  http://www.acupunctureresearch.org/tara/ontology/Extra_Acupoint
<http://www.acupunctureresearch.org/tara/ontology/Extra_Acupoint> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/Acupoint> ;
                                                                  obo:IAO_0000115 "An Acupoint that has a fixed name and location recognized in traditional Chinese medicine but that is not located on any of the fourteen principal/extra meridians." ;
                                                                  dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 10, Sec. III, The Extra Points. ISBN 978-7-119-01758-7."@en ;
                                                                  dcterms:description "Extra points are experiential points with specific names and definite locations, but are not attributed to the fourteen meridians. They are effective in the treatment of certain diseases. Although scattered over the body, they are still related to the meridians system. Some extra points are distributed along the courses of the fourteen meridians, for example, Yimang (Extra I) related to the Governor Vessel, Lanwei (Extra 18) to the Stomach Meridian of Foot-Yangming."@en ;
                                                                  tara-ap:hasSynonym "Extra Acupoint" ,
                                                                                     "Extra point" ;
                                                                  rdfs:label "Extra Acupuncture Point" .


###  http://www.acupunctureresearch.org/tara/ontology/Extra_Meridian
<http://www.acupunctureresearch.org/tara/ontology/Extra_Meridian> rdf:type owl:Class ;
                                                                  rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/Meridian> ;
                                                                  obo:IAO_0000115 "A Meridian, other than the twelve principal meridians, that is not directly affiliated with a zang or fu organ system and does not stand in an exterior-interior pairing with another meridian."@en ;
                                                                  dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 5, Sec. III, The Eight Extra Meridians, Page 82. ISBN 978-7-119-01758-7." ;
                                                                  dcterms:description "Represents the extra meridians. The eight extra meridians are the Governor Vessel, Conception Vessel, Thoroughfare Vessel, Belt Vessel, Yang Heel Vessel, Yin Heel Vessel, Yang Link Vessel and Yin Link Vessel. They are different from the twelve main meridians because none of them pertains to the zang organs and communicates with the fu organs of pertains to the fu organs and communicates with the zang organs. And they are not exteriorly-interiorly related. Apart from the Governor Vessel and Conception Vessel which have their own acupuncture points, the extra meridians share their points with other main meridians."@en ;
                                                                  tara-ap:hasSynonym "Extra Acupoint Meridian" ,
                                                                                     "Extra Meridian" ;
                                                                  rdfs:label "Extra Acupuncture Meridian"@en .


###  http://www.acupunctureresearch.org/tara/ontology/Meridian
<http://www.acupunctureresearch.org/tara/ontology/Meridian> rdf:type owl:Class ;
                                                            obo:IAO_0000115 "A one-dimensional continuant fiat boundary, demarcated by convention within traditional Chinese medicine theory rather than by any natural physical discontinuity in the body, along which Acupoints are located."@en ;
                                                            obo:IAO_0000116 "Acupuncture Meridian is modeled as a subclass of 'one-dimensional continuant fiat boundary' (BFO:0000009): a TCM meridian is a channel/line demarcated by convention within acupuncture theory, not by any natural physical discontinuity, matching the fiat-line character of BFO:0000009 class's own examples (e.g. the Equator, lines of latitude/longitude)."@en ;
                                                            dcterms:bibliographicCitation "Maurer, N., Nissel, H., Egerbacher, M., Gornik, E., Schuller, P., & Traxler, H. (2019). Anatomical evidence of acupuncture meridians in the human extracellular matrix: results from a macroscopic and microscopic interdisciplinary multicentre study on human corpses. Evidence-Based Complementary and Alternative Medicine, 2019. https://doi.org/10.1155/2019/6976892" ;
                                                            dcterms:description "In traditional Chinese Medicine (TCM), meridians are strings connecting acupuncture points, which are considered as passageways through which energy flows throughout the body. The meridian system is composed of 12 principal meridians, each of which connects to an organ system and extends to an extremity and eight collaterals."@en ;
                                                            tara-ap:hasSynonym "Acupuncture Channel" ,
                                                                               "Acupuncture Pathway" ,
                                                                               "Meridian" ;
                                                            rdfs:label "Acupuncture Meridian"@en .


###  http://www.acupunctureresearch.org/tara/ontology/Meridian_Acupoint
<http://www.acupunctureresearch.org/tara/ontology/Meridian_Acupoint> rdf:type owl:Class ;
                                                                     owl:equivalentClass [ owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/Acupoint>
                                                                                                                [ rdf:type owl:Restriction ;
                                                                                                                  owl:onProperty tara-op:isLocatedOnMeridian ;
                                                                                                                  owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/Meridian>
                                                                                                                ]
                                                                                                              ) ;
                                                                                           rdf:type owl:Class
                                                                                         ] ;
                                                                     obo:IAO_0000115 "An Acupoint that isLocatedOnMeridian one of the twelve principal meridians, the Governor Vessel, or the Conception Vessel." ;
                                                                     dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points. ISBN 978-7-119-01758-7."@en ;
                                                                     dcterms:description "Acupuncture points of the fourteen meridians, also known as \"meridian points,\" acupuncture points of the fourteen meridians are distributed along the twelve main meridian, the Governor Vessel and the Conception Vessel, totally amounting to 361." ;
                                                                     tara-ap:hasSynonym "Acupoint of Meridian" ,
                                                                                        "Meridian Acupoint" ,
                                                                                        "Meridian Point" ,
                                                                                        "Meridian Points" ;
                                                                     rdfs:label "Meridian Acupuncture Point" .


###  http://www.acupunctureresearch.org/tara/ontology/Primary_Meridian
<http://www.acupunctureresearch.org/tara/ontology/Primary_Meridian> rdf:type owl:Class ;
                                                                    rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/Meridian> ;
                                                                    obo:IAO_0000115 "One of the twelve Meridians that is directly affiliated with a zang or fu organ system via hasAssociatedOrgan, and that is linked to the other eleven principal meridians in a fixed circulatory sequence."@en ;
                                                                    dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 5, Sec. II, The Twelve Main Meridians, Page 65. ISBN 978-7-119-01758-7."@en ;
                                                                    dcterms:description """As the major part in the meridian system, the twelve main meridians share the following features. Each with its own acupuncture points is distributed on a fixed portion of the body surface; each pertains to either a zang or a fu organ (those that pertain to the zang organ communicating with the fu organ, and vice versa). 

The twelve main meridians link one another in a fixed order. A cyclical now of qi is maintained by the connection of the meridians of the hand and foot, yin and yang, exterior and interior."""@en ;
                                                                    tara-ap:hasSynonym "Main Acupuncture Channel" ,
                                                                                       "Main Meridian" ,
                                                                                       "Primary Acupuncture Channel" ,
                                                                                       "Primary Meridian" ;
                                                                    rdfs:label "Main Acupuncture Meridian"@en .


###  http://www.acupunctureresearch.org/tara/ontology/Special_Acupoint_Role
<http://www.acupunctureresearch.org/tara/ontology/Special_Acupoint_Role> rdf:type owl:Class ;
                                                                         obo:IAO_0000115 "A Role, realized in acupuncture practice, that classifies an Acupoint according to a named functional category defined within traditional Chinese medicine theory (e.g., Front-Mu point, Back-Shu point, He-Sea point)."@en ;
                                                                         obo:IAO_0000116 "'Special Point Role' is modeled as a subclass of 'role' (BFO:0000023): whether an acupoint counts as, e.g., a Front-Mu point is conferred entirely by TCM theory (an external, institutional/doctrinal context) rather than by the acupoint's own physical make-up, matching the defining Role/Disposition distinction given by BFO."@en ;
                                                                         dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7."@en ;
                                                                         dcterms:description "A special, specific role of an acupoint located on the main meridian. Specific points refer to those of the fourteen meridians that have special properties (roles) and are grouped under special names. This class is used to classify the acupoints based on their special point roles."@en ;
                                                                         tara-ap:hasSynonym "Special Acupoint Role" ;
                                                                         rdfs:label "Special Acupunture Point Role"@en .


###  http://www.acupunctureresearch.org/tara/ontology/Special_Point
<http://www.acupunctureresearch.org/tara/ontology/Special_Point> rdf:type owl:Class ;
                                                                 owl:equivalentClass [ owl:intersectionOf ( <http://www.acupunctureresearch.org/tara/ontology/Acupoint>
                                                                                                            [ rdf:type owl:Restriction ;
                                                                                                              owl:onProperty tara-op:hasSpecialPointRole ;
                                                                                                              owl:someValuesFrom <http://www.acupunctureresearch.org/tara/ontology/Special_Acupoint_Role>
                                                                                                            ]
                                                                                                          ) ;
                                                                                       rdf:type owl:Class
                                                                                     ] ;
                                                                 obo:IAO_0000115 "An Acupoint that hasSpecialPointRole some Special_Acupoint_Role." ;
                                                                 dcterms:bibliographicCitation "Chinese Acupuncture and Moxibustion. Edited by C. Xinnong, Rev. Ed., Foreign Languages Press, Beijing, China, 1999. Ch. 6, An Introduction to Acupunture Points, Sec. III, Specific Points. ISBN 978-7-119-01758-7."@en ;
                                                                 dcterms:description "Special points refer to the specific points of the fourteen meridians that have special properties and are grouped under special names. In view of their locations, they can be classified into two major groups: one on the limbs, and the other one on the head and the trunk." ;
                                                                 tara-ap:hasSynonym "Special Acupoint" ,
                                                                                    "Special Point" ;
                                                                 rdfs:label "Special Acupuncture Point" .


