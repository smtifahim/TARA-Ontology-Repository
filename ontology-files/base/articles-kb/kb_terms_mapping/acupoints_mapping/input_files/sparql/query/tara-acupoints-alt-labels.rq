# ==============================================================================
# QUERY NAME: Acupoint Label and Synonym Cataloger
# AUTHOR: Fahim T. Imam (TARA Ontology-Core)
# LAST UPDATED: July 12, 2026
# DESCRIPTION: Retrieves a paginated list of valid TARA acupoints, 
#              including their unique IRIs, CURIEs, primary labels, and a 
#              comma-separated list of their merged synonyms and Pinyin names.
#
# DEPENDENCIES: Requires the TARA Ontology schema.
# FILTERS: Excludes meta-classes, groupings, and generic meridian category labels.
#
# EXPECTED OUTPUT COLUMNS:
#   - ?Acupoint_IRI       : The full ontology IRI for the acupoint.
#   - ?Acupoint_CURIE     : Prefixed ID format (e.g., TARA:XXXX).
#   - ?AcupoLnt_Label     : Standard alphaneumeric primary label of the acupoint.
#   - ?Acupoint_Alt_Label : Group-concatenated synonyms and Pinyin variants.
# ==============================================================================


PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX tara: <http://www.acupunctureresearch.org/tara/ontology/>
PREFIX TARA: <http://www.acupunctureresearch.org/tara/ontology/TARA_>

SELECT DISTINCT 
  ?Acupoint_IRI ?Acupoint_CURIE ?Acupoint_Label 
  (GROUP_CONCAT(DISTINCT ?alt_label; separator=", ") AS ?Acupoint_Alt_Label)

WHERE
{
  ?Acupoint_IRI rdfs:subClassOf+/rdfs:label "Acupoint".
  ?Acupoint_IRI rdfs:label ?Acupoint_Label.
  
  OPTIONAL 
    { 
        ?Acupoint_IRI (tara:hasSynonym|tara:hasPinyinLabel) ?alt_label.
    }
  
  # Exclude meta-classes, groupings, and generic meridian category labels.
  FILTER (!regex(STR(?Acupoint_Label), 'Acupoint of|Meridian Acupoint|Point of|Point|Extra Acupoint'))
  
  BIND ( REPLACE
            ( STR(?Acupoint_IRI), 
                "http://www.acupunctureresearch.org/tara/ontology/TARA_", 
                "TARA:"
            ) AS ?Acupoint_CURIE
       )
}
GROUP BY ?Acupoint_IRI ?Acupoint_CURIE ?Acupoint_Label
ORDER BY ?Acupoint_Label ?Acupoint_IRI