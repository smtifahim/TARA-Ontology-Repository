###  http://purl.obolibrary.org/obo/HP_0001250
obo:HP_0001250 rdf:type owl:Class ;
               rdfs:subClassOf obo:HP_0012638 ;
               obo:IAO_0000115 "A seizure is an intermittent abnormality of nervous system physiology characterized by a transient occurrence of signs and/or symptoms due to abnormal excessive or synchronous neuronal activity in the brain." ;
               oboInOwl:hasAlternativeId "HP:0001275" ,
                                         "HP:0001303" ,
                                         "HP:0002125" ,
                                         "HP:0002182" ,
                                         "HP:0002279" ,
                                         "HP:0002306" ,
                                         "HP:0002348" ,
