###  http://purl.obolibrary.org/obo/MONDO_0001301
obo:MONDO_0001301 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0005451 ;
                  obo:IAO_0000115 "Rumination disorder is the backward flow of recently eaten food from the stomach to the mouth. The food is then re-chewed and swallowed or spat out. A non-purposeful contraction of stomach muscles is involved in rumination. It may be initially triggered by a viral illness, emotional distress, or physical injury. In many cases, no underlying trigger is identified. Behavioral therapy is the mainstay of treatment." ;
                  mondo:curated_content_resource "https://www.malacards.org/card/rumination_disorder"^^xsd:anyURI ;
                  oboInOwl:hasDbXref "DOID:11507" ,
                                     "ICD9:307.53" ,
                                     "MEDGEN:102311" ,
                                     "MESH:D019959" ,
                                     "NCIT:C92567" ,
                                     "SCTID:192014006" ,
                                     "UMLS:C0154575" ,
                                     "icd11.foundation:879747857" ;
                  oboInOwl:hasExactSynonym "rumination" ;
                  oboInOwl:hasRelatedSynonym "rumination syndrome" ;
                  rdfs:label "rumination disorder" ;
                  rdfs:seeAlso "https://rarediseases.info.nih.gov/diseases/7594/rumination-disorder"^^xsd:anyURI ;
                  skos:exactMatch <http://id.who.int/icd/entity/879747857> ,
                                  <http://identifiers.org/medgen/102311> ,
