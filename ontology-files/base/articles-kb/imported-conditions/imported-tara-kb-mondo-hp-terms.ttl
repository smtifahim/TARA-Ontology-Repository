###  http://purl.obolibrary.org/obo/MONDO_1010182
obo:MONDO_1010182 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0004169 ;
                  obo:IAO_0000115 "A severe form of premenstrual syndrome (PMS) that involves significant emotional and physical symptoms in the week or two before a period." ;
                  dcterms:creator <https://orcid.org/0000-0002-5002-8648> ;
                  oboInOwl:hasDbXref "MEDGEN:636161" ,
                                     "UMLS:C0520676" ;
                  oboInOwl:hasExactSynonym "PMDD" ;
                  rdfs:label "premenstrual dysphoric disorder" ;
                  skos:exactMatch <http://identifiers.org/medgen/636161> ,
                                  <http://linkedlifedata.com/resource/umls/id/C0520676> .


###  http://purl.obolibrary.org/obo/MONDO_1060198
obo:MONDO_1060198 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0005098 ;
                  obo:IAO_0000115 "A stroke disorder caused by obstruction of blood flow to the brain, due to thrombotic (local blood clot formation) or embolic (due to a blood clot or other material traveling from another site) event." ;
                  dcterms:creator <https://orcid.org/0000-0002-7638-4659> ;
                  oboInOwl:hasDbXref "DOID:0051062" ,
                                     "MEDGEN:215292" ,
                                     "UMLS:C0948008" ;
                  oboInOwl:hasExactSynonym "ischaemic stroke" ;
                  rdfs:label "ischemic stroke" ;
                  skos:exactMatch <http://identifiers.org/medgen/215292> ,
                                  <http://linkedlifedata.com/resource/umls/id/C0948008> ,
                                  obo:DOID_0051062 .


###  http://purl.obolibrary.org/obo/MONDO_1060199
obo:MONDO_1060199 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0005098 ;
                  obo:IAO_0000115 "A stroke disorder caused by bleeding into the brain parenchyma or surrounding spaces. Hemorrhagic stroke includes intracerebral hemorrhage (bleeding within the brain tissue) and subarachnoid hemorrhage (bleeding in the space between the brain and the surrounding membrane)." ;
                  dcterms:creator <https://orcid.org/0000-0002-7638-4659> ;
                  oboInOwl:hasDbXref "DOID:0051063" ,
                                     "MEDGEN:1714259" ,
                                     "UMLS:C5234922" ;
                  oboInOwl:hasExactSynonym "haemorrhagic stroke" ;
                  rdfs:label "hemorrhagic stroke" ;
                  skos:exactMatch <http://identifiers.org/medgen/1714259> ,
                                  <http://linkedlifedata.com/resource/umls/id/C5234922> ,
                                  obo:DOID_0051063 .


###  http://purl.obolibrary.org/obo/MONDO_1060204
obo:MONDO_1060204 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0002263 ;
                  obo:IAO_0000115 "A disorder of the female reproductive system characterized by abnormalities in the menstrual cycle, including disturbances in timing, flow, or associated pain." ;
                  dcterms:creator <https://orcid.org/0000-0002-7638-4659> ;
                  rdfs:label "menstrual disorder" .


###  http://purl.obolibrary.org/obo/MONDO_1060205
obo:MONDO_1060205 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_1060204 ;
                  obo:IAO_0000115 "A menstrual disorder characterized by pain during the menstrual cycle." ;
                  dcterms:creator <https://orcid.org/0000-0002-7638-4659> ;
                  oboInOwl:hasDbXref "MEDGEN:4429" ,
                                     "UMLS:C0013390" ;
                  rdfs:label "dysmenorrhea" ;
                  skos:exactMatch <http://identifiers.org/medgen/4429> ,
                                  <http://linkedlifedata.com/resource/umls/id/C0013390> .


###  http://purl.obolibrary.org/obo/MONDO_1060206
obo:MONDO_1060206 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_1060205 ;
                  obo:IAO_0000115 "A form of dysmenorrhea characterized by recurrent menstrual pain without any identifiable underlying pelvic pathology, representing a diagnosis of exclusion. Symptoms typically emerge within two years of menarche." ;
                  dcterms:creator <https://orcid.org/0000-0002-7638-4659> ;
                  oboInOwl:hasDbXref "MEDGEN:508446" ,
                                     "UMLS:C0149875" ;
                  rdfs:label "primary dysmenorrhea" ;
                  skos:exactMatch <http://identifiers.org/medgen/508446> ,
                                  <http://linkedlifedata.com/resource/umls/id/C0149875> .


###  http://purl.obolibrary.org/obo/MONDO_7770002
obo:MONDO_7770002 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0005451 ;
                  obo:IAO_0000115 "An eating disorder characterized by avoidance or restriction of food intake due to one or more of the following: lack of interest in eating or food, sensitivity to sensory characteristics of food (such as taste, texture, smell, or appearance), or concern about aversive consequences of eating (such as choking or vomiting), resulting in persistent failure to meet appropriate nutritional and/or energy needs as manifested by significant weight loss, nutritional deficiency, dependence on enteral feeding or nutritional supplements, or marked interference with psychosocial functioning, and where the eating disturbance is not better explained by lack of available food, cultural or religious practices, another mental disorder, or a concurrent medical condition." ;
                  dcterms:creator <https://orcid.org/0000-0003-3311-7320> ;
                  oboInOwl:hasDbXref "DOID:0051057" ,
                                     "ICD10CM:F50.82" ,
                                     "ICD9:307.59" ,
                                     "MESH:D000080146" ;
                  oboInOwl:hasExactSynonym "ARFID" ,
                                           "selective eating disorder" ;
                  rdfs:label "avoidant/restrictive food intake disorder" ;
                  skos:exactMatch <http://identifiers.org/mesh/D000080146> ,
                                  <http://purl.bioontology.org/ontology/ICD10CM/F50.82> ,
                                  obo:DOID_0051057 .


###  http://purl.obolibrary.org/obo/MONDO_7770006
obo:MONDO_7770006 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0700096 ;
                  obo:IAO_0000115 "A grouping class for human diseases classified by the body system or anatomical component primarily affected." ;
                  rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
                  rdfs:label "disease by body system or component" .


###  http://purl.obolibrary.org/obo/MONDO_7770007
obo:MONDO_7770007 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0700096 ;
                  obo:IAO_0000115 "A grouping class for human diseases classified by the molecular, biochemical, cellular, anatomic, developmental or physiological process that is disrupted." ;
                  rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
                  rdfs:label "disease by developmental or physiological process" .


###  http://purl.obolibrary.org/obo/MONDO_7770008
obo:MONDO_7770008 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0700096 ;
                  obo:IAO_0000115 "A grouping class for human diseases classified by their etiologic mechanism, encompassing primarily intrinsic (genetic, genomic), primarily extrinsic (e.g., infections, toxins, radiation), and complex multifactorial (e.g. nutritional) causes." ;
                  rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
                  rdfs:label "disease by etiologic mechanism" .


###  http://purl.obolibrary.org/obo/MONDO_7770009
obo:MONDO_7770009 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_7770008 ;
                  obo:IAO_0000115 "A grouping class for human diseases caused by genetic or genomic alterations, including chromosomal abnormalities and heritable mutations." ;
                  rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
                  rdfs:label "disease of genetic or genomic mechanism" .


###  http://purl.obolibrary.org/obo/MONDO_7770010
obo:MONDO_7770010 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_7770008 ;
                  obo:IAO_0000115 "A grouping class for human diseases caused primarily by extrinsic factors, including infections, toxins, nutritional deficiencies, iatrogenic causes, and environmental exposures." ;
                  rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
                  rdfs:label "disease of primarily extrinsic mechanism" .


###  http://purl.obolibrary.org/obo/MONDO_7770011
obo:MONDO_7770011 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_7770007 ;
                  obo:IAO_0000115 "A grouping class for human diseases classified by their underlying molecular or pathophysiological mechanism, such as protein aggregation, ion channel dysfunction, or signal transduction disruption." ;
                  rdfs:comment "This term is intended solely for classification purposes and should not be used for direct data annotation." ;
                  rdfs:label "disease by molecular mechanism" .


