###  http://purl.obolibrary.org/obo/MONDO_0005284
obo:MONDO_0005284 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0005301 ;
                  obo:IAO_0000115 "A form of multiple sclerosis characterized by a progressive deterioration in neurologic function which is in contrast to the more typical relapsing remitting form. If the clinical course is free of distinct remissions, it is referred to as primary progressive multiple sclerosis. When the progressive decline is punctuated by acute exacerbations, it is referred to as progressive relapsing multiple sclerosis. The term secondary progressive multiple sclerosis is used when relapsing remitting multiple sclerosis evolves into the chronic progressive form. (From Ann Neurol 1994;36 Suppl:S73-S79; Adams et al., Principles of Neurology, 6th ed, pp903-914)" ;
                  oboInOwl:hasDbXref "EFO:0003840" ,
                                     "MEDGEN:140733" ,
                                     "MESH:D020528" ,
                                     "SCTID:230373008" ,
                                     "UMLS:C0393665" ;
                  rdfs:label "chronic progressive multiple sclerosis" ;
                  skos:exactMatch <http://identifiers.org/medgen/140733> ,
                                  <http://identifiers.org/mesh/D020528> ,
                                  <http://identifiers.org/snomedct/230373008> ,
                                  <http://linkedlifedata.com/resource/umls/id/C0393665> ,
                                  <http://www.ebi.ac.uk/efo/EFO_0003840> .


