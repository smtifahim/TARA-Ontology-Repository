###  http://purl.obolibrary.org/obo/MONDO_0021095
obo:MONDO_0021095 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0003996 ;
                  obo:IAO_0000115 "A group of disorders which feature impaired motor control characterized by bradykinesia, MUSCLE RIGIDITY; TREMOR; and postural instability. Parkinsonian diseases are generally divided into primary parkinsonism (see PARKINSON DISEASE), secondary parkinsonism (see PARKINSON DISEASE, SECONDARY) and inherited forms. These conditions are associated with dysfunction of dopaminergic or closely related motor integration neuronal pathways in the BASAL GANGLIA." ;
                  mondo:curated_content_resource "https://www.malacards.org/card/parkinsonism"^^xsd:anyURI ;
                  oboInOwl:hasDbXref "DOID:0080855" ,
                                     "MEDGEN:66079" ,
                                     "MESH:D020734" ,
                                     "UMLS:C0242422" ;
                  rdfs:comment "Editor note: TODO" ;
                  rdfs:label "parkinsonian disorder" ;
                  skos:exactMatch <http://identifiers.org/medgen/66079> ,
                                  <http://identifiers.org/mesh/D020734> ,
