###  http://purl.obolibrary.org/obo/HP_0000964
obo:HP_0000964 rdf:type owl:Class ;
               rdfs:subClassOf obo:HP_0011123 ;
               obo:IAO_0000115 "Eczema is a form of dermatitis that is characterized by scaly, pruritic, erythematous lesions located on flexural surfaces." ;
               oboInOwl:hasAlternativeId "HP:0000976" ,
                                         "HP:0001481" ;
               oboInOwl:hasDbXref "SNOMEDCT_US:281104002" ,
                                  "SNOMEDCT_US:43116000" ,
                                  "UMLS:C0013595" ;
               oboInOwl:hasExactSynonym "Eczema" ;
               oboInOwl:hasRelatedSynonym "Dermatitis" ;
               rdfs:comment "The term eczema is broadly applied to a range of persistent skin conditions and can be related to a number of underlying conditions. Manifestations of eczema can include dryness and recurring skin rashes with redness, skin edema, itching and dryness, crusting, flaking, blistering, cracking, oozing, or bleeding. Eczema has several forms including atopic dermatitis, contact dermatitis, dyshidrotic eczema, nummular eczema, seborrheic dermatitis, and stasis dermatitis." ;
               rdfs:label "Eczematoid dermatitis" .


###  http://purl.obolibrary.org/obo/HP_0000969
obo:HP_0000969 rdf:type owl:Class ;
               rdfs:subClassOf obo:HP_0011032 ;
               obo:IAO_0000115 "An abnormal accumulation of fluid beneath the skin, or in one or more cavities of the body." ;
               oboInOwl:hasAlternativeId "HP:0000990" ;
