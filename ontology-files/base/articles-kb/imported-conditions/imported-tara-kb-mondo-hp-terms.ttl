                  obo:IAO_0000115 "A sudden loss of neurological function secondary to hemorrhage or ischemia in the brain parenchyma due to a vascular event." ;
                  oboInOwl:hasDbXref "DOID:0051061" ,
                                     "EFO:0000712" ,
