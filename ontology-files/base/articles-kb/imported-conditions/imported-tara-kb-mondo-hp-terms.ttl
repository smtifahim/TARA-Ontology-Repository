###  http://purl.obolibrary.org/obo/HP_0025766
obo:HP_0025766 rdf:type owl:Class ;
               rdfs:subClassOf obo:HP_0011446 ;
               obo:IAO_0000115 "An anomaly in intensity, frequency, or duration of the verbal or behavioral expression of emotions, feelings, or thoughts." ;
               dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
               dcterms:date "2024-07-21T12:00:05+00:00"^^xsd:dateTime ;
               rdfs:comment "Affect includes a combination of emotion in terms of feelings and its expression either in the verbal or behavioral (action) level. Normal expressions are often relatively short lived and familiar to the person while pathological expressions may be intense and extended and considered out of character for the individual. Affect encompasses: 1) emotions, 2) volition, and 3) what is termed the intellect or cognitive elements expressing (communicating) emotion and volition. Affect includes an internal feeling (emotion), an internal drive (will), and a motor component expression (typically speech, but also reflected in thoughts)." ;
               rdfs:label "Abnormal affect" .


###  http://purl.obolibrary.org/obo/HP_0025780
obo:HP_0025780 rdf:type owl:Class ;
               rdfs:subClassOf obo:HP_0025766 ;
               obo:IAO_0000115 "An abnormality of internal states of motivation or drive that compromise, or interfere with, the ability of the person to attend to basic personal, social, or vocational activities." ;
               dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
               dcterms:date "2024-07-21T16:05:20+00:00"^^xsd:dateTime ;
               oboInOwl:hasAlternativeId "HP:5200275" ;
               oboInOwl:hasRelatedSynonym "Abnormal energy" ,
                                          "Abnormal motivation" ;
               rdfs:label "Abnormal volitional state" .


###  http://purl.obolibrary.org/obo/HP_0025783
obo:HP_0025783 rdf:type owl:Class ;
               rdfs:subClassOf obo:HP_0000708 ;
               obo:IAO_0000115 "The Human Phenotype Ontology provides terms to describe specific phenotypic abnormalities rather than disease diagnoses. Nevertheless, it is common for descriptions such as 'Autism' to be used to describe individuals affected with Mendelian forms of neurodevelopmental disease and many other conditions. If possible, we recommend annotation using specific terms in other branchs of the Atypical behavior subontology, but if this is not possible, then terms from this branch may be used." ;
               dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
               dcterms:date "2024-08-03T10:05:59+00:00"^^xsd:dateTime ;
               rdfs:label "Diagnostic behavioral phenotype" .


###  http://purl.obolibrary.org/obo/HP_0025792
obo:HP_0025792 rdf:type owl:Class ;
               rdfs:subClassOf obo:HP_0011446 ;
               obo:IAO_0000115 "An abnormal cognitive process can be defined as a deviation from the typical development, structural organization, or functional execution of mental operations that connect informational inputs to behavioral outputs, typically involve at least one of the following processes: perception, memory, learning, emotion, intentionality, self-representation, rationality, and decision-making." ;
               dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
               dcterms:date "2024-08-07T17:25:08+00:00"^^xsd:dateTime ;
               rdfs:comment "Definition adapted from Newen A (2017) What are cognitive processes? An example-based approach. Synthese 194:4251-4268." ;
               rdfs:label "Abnormal cognitive process" .


