                  rdfs:subClassOf obo:MONDO_0021201 ,
                                  obo:MONDO_0021680 ,
                                  obo:MONDO_0024295 ;
                  obo:IAO_0000115 "An infection of the upper layers of the skin caused by species of streptococcus. Erysipelas results in a fiery red rash with raised edges that can easily be distinguished from the skin around it. The affected skin may be warm to the touch." ;
                  mondo:curated_content_resource "https://www.malacards.org/card/erysipelas"^^xsd:anyURI ;
                  oboInOwl:hasDbXref "DOID:11330" ,
