                                    owl:someValuesFrom obo:UBERON_0007798
                                  ] ;
                  obo:IAO_0000115 "A general term used to describe any disease affecting blood vessels]. It includes vascular abnormalities caused by degenerative, metabolic and inflammatory conditions, embolic diseases, coagulative disorders, and functional disorders such as posteri or reversible encephalopathy syndrome." ;
                  mondo:curated_content_resource "https://www.malacards.org/card/vascular_disease"^^xsd:anyURI ;
                  dcterms:conformsTo <http://purl.obolibrary.org/obo/mondo/patterns/location.yaml> ,
