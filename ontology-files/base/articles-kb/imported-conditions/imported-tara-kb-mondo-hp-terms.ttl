                                     "SCTID:1593000" ,
                                     "UMLS:C0018991" ,
                                     "icd11.foundation:1641958762" ;
                  rdfs:label "hemiplegia" ;
                  rdfs:seeAlso "https://rarediseases.info.nih.gov/diseases/6583/hemiplegia"^^xsd:anyURI ;
