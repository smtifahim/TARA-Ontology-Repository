               rdfs:subClassOf obo:HP_0011446 ;
               obo:IAO_0000115 "Subjective phenomena or perceptions that deviate from what is considered correct or are outside the range of normal human experiences." ;
               dcterms:contributor <https://orcid.org/0000-0001-7062-8192> ,
                                   <https://orcid.org/0000-0001-7941-2961> ,
                                   <https://orcid.org/0000-0001-9221-9226> ,
