###  http://purl.obolibrary.org/obo/MONDO_0006894
obo:MONDO_0006894 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0006816 ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0004026 ;
                                    owl:someValuesFrom obo:UBERON_0011166
                                  ] ;
                  obo:IAO_0000115 "A syndrome characterized by retropatellar or peripatellar pain resulting from physical and biochemical changes in the patellofemoral joint. The pain is most prominent when ascending or descending stairs, squatting, or sitting with flexed knees. There is a lack of consensus on the etiology and treatment. The syndrome is often confused with (or accompanied by) chondromalacia patellae, the latter describing a pathological condition of the cartilage and not a syndrome." ;
                  mondo:curated_content_resource "https://www.malacards.org/card/patellofemoral_pain_syndrome"^^xsd:anyURI ;
                  oboInOwl:hasDbXref "DOID:14284" ,
                                     "EFO:1001092" ,
