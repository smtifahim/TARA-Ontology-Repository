                                     "MEDGEN:41855" ,
                                     "MESH:D004886" ,
                                     "SCTID:44653001" ,
                                     "UMLS:C0014733" ,
                                     "icd11.foundation:1651247891" ;
                  rdfs:comment "The most common cause is group A streptococcal bacteria, especially Streptococcus pyogenes" ;
                  rdfs:label "erysipelas" ;
                  rdfs:seeAlso "https://rarediseases.info.nih.gov/diseases/6370/erysipelas"^^xsd:anyURI ;
