###  http://purl.obolibrary.org/obo/MONDO_0008585
obo:MONDO_0008585 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0001641 ,
                                  obo:MONDO_0002254 ;
                  obo:IAO_0000115 "A life-threatening condition that can potentially complicate pregnancy. It is named for 3 features of the condition: H emolysis, E levated L iver enzyme levels, and L ow P latelet levels. It typically occurs in the last 3 months of pregnancy (the third trimester) but can also start soon after delivery. A wide range of non-specific symptoms may be present in women with HELLP syndrome. Symptoms may include fatigue; malaise; fluid retention and excess weight gain; headache; nausea and vomiting; pain in the upper right or middle of the abdomen; blurry vision; and rarely, nosebleed or seizures. The cause of HELLP syndrome is not known, but certain risk factors have been associated with the condition. It is most common in women with preeclampsia or eclampsia. If not diagnosed and treated quickly, HELLP syndrome can lead to serious complications for the mother and baby.The main treatment is to deliver the baby as soon as possible, even if premature. Treatment may also include medications needed for the mother or baby, and blood transfusion for severe bleeding problems." ;
                  mondo:curated_content_resource "https://www.malacards.org/card/hellp_syndrome"^^xsd:anyURI ;
                  mondo:excluded_from_qc_check <http://purl.obolibrary.org/obo/mondo/sparql/qc/general/qc-single-child.sparql> ;
                  oboInOwl:hasDbXref "DOID:13133" ,
                                     "EFO:0007297" ,
                                     "GARD:0008528" ,
                                     "ICD10CM:O14.2" ,
                                     "MEDGEN:58162" ,
                                     "MESH:D017359" ,
                                     "MedDRA:10049058" ,
                                     "NCIT:C84750" ,
                                     "Orphanet:244242" ,
                                     "UMLS:C0162739" ,
                                     "icd11.foundation:1748922908" ;
                  oboInOwl:hasExactSynonym "hemolysis, elevated liver enzymes, low platelets in pregnancy" ,
                                           "hemolysis-elevated liver enzymes-low platelet count syndrome" ,
                                           "hemolysis-elevated liver enzymes-low platelets syndrome" ;
                  oboInOwl:hasRelatedSynonym "PEE1" ,
                                             "PREECLAMPSIA/eclampsia 1" ,
                                             "hemolysis, elevated liver enzymes, lowered platelets" ,
                                             "toxaemia of pregnancy" ;
                  rdfs:label "HELLP syndrome" ;
                  rdfs:seeAlso "https://rarediseases.info.nih.gov/diseases/8528/hellp-syndrome"^^xsd:anyURI ;
                  skos:closeMatch <http://identifiers.org/meddra/10049058> ;
                  skos:exactMatch <http://id.who.int/icd/entity/1748922908> ,
                                  <http://identifiers.org/medgen/58162> ,
                                  <http://identifiers.org/mesh/D017359> ,
                                  <http://linkedlifedata.com/resource/umls/id/C0162739> ,
                                  <http://purl.bioontology.org/ontology/ICD10CM/O14.2> ,
                                  obo:DOID_13133 ,
                                  obo:NCIT_C84750 ,
                                  <http://www.ebi.ac.uk/efo/EFO_0007297> ,
                                  <http://www.orpha.net/ORDO/Orphanet_244242> .


###  http://purl.obolibrary.org/obo/MONDO_0008599
obo:MONDO_0008599 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0002602 ,
                                  obo:MONDO_0003543 ,
                                  obo:MONDO_0016374 ;
                  obo:IAO_0000115 "Trigeminal neuralgia is a nerve disorder that causes a stabbing or electric-shock-like pain in parts of the face. The pain lasts a few seconds to a few minutes, and usually on only one side of the face. It can also cause muscle spasms in the face the same time as the pain. The pain may result from a blood vessel pressing against the trigeminal nerve (the nerve that carries pain, feeling, and other sensations from the brain to the skin of theface), as a complication of multiple sclerosis, or due to compression of the nerve by a tumor or cyst. In some cases, the cause is unknown. Treatment options include medicines, surgery, and complementary approaches." ;
                  mondo:curated_content_resource "https://www.malacards.org/card/trigeminal_neuralgia"^^xsd:anyURI ;
                  oboInOwl:hasDbXref "DOID:12098" ,
                                     "EFO:1001219" ,
                                     "GARD:0007805" ,
                                     "ICD10CM:G50.0" ,
                                     "ICD9:350.1" ,
                                     "MEDGEN:21683" ,
                                     "MESH:D014277" ,
                                     "MedDRA:10044652" ,
                                     "NORD:1791" ,
                                     "OMIM:190400" ,
                                     "Orphanet:221091" ,
                                     "SCTID:31681005" ,
                                     "UMLS:C0040997" ,
                                     "icd11.foundation:1803581281" ;
                  oboInOwl:hasExactSynonym "neuralgia of trigeminal nerve" ,
                                           "trigeminal nerve neuralgia" ,
                                           "trigeminal neuralgia" ;
                  rdfs:label "trigeminal neuralgia" ;
                  rdfs:seeAlso "https://rarediseases.info.nih.gov/diseases/7805/trigeminal-neuralgia"^^xsd:anyURI ;
                  skos:closeMatch <http://identifiers.org/meddra/10044652> ;
                  skos:exactMatch <http://id.who.int/icd/entity/1803581281> ,
                                  <http://identifiers.org/medgen/21683> ,
