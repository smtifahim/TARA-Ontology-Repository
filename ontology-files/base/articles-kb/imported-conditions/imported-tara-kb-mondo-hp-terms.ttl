###  http://purl.obolibrary.org/obo/MONDO_0001170
obo:MONDO_0001170 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0006496 ;
                  obo:IAO_0000115 "Severe or complete loss of motor function on one side of the body. This condition is usually caused by brain diseases that are localized to the cerebral hemisphere opposite to the side of weakness. Less frequently, brain stem lesions; cervical spinal cord diseases; peripheral nervous system diseases; and other conditions may manifest as hemiplegia. The term hemiparesis (see paresis) refers to mild to moderate weakness involving one side of the body." ;
                  mondo:curated_content_resource "https://www.malacards.org/card/hemiplegia"^^xsd:anyURI ;
                  oboInOwl:hasDbXref "DOID:10969" ,
                                     "EFO:0009453" ,
