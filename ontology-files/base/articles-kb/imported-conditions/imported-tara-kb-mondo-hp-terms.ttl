###  http://purl.obolibrary.org/obo/MONDO_0005146
obo:MONDO_0005146 rdf:type owl:Class ;
                  rdfs:subClassOf obo:MONDO_0005379 ;
                  obo:IAO_0000115 "An anxiety disorder precipitated by an experience of intense fear or horror while exposed to a traumatic (especially life-threatening) event. The disorder is characterized by intrusive recurring thoughts or images of the traumatic event; avoidance of anything associated with the event; a state of hyperarousal and diminished emotional responsiveness. These symptoms are present for at least one month and the disorder is usually long-term." ;
                  mondo:curated_content_resource "https://www.malacards.org/card/post_traumatic_stress_disorder"^^xsd:anyURI ;
                  mondo:excluded_from_qc_check <http://purl.obolibrary.org/obo/mondo/sparql/qc/general/qc-single-child.sparql> ;
