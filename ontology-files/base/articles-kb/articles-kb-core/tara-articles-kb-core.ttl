###  http://www.acupunctureresearch.org/tara/ontology/kb/hasExtractedArticleMetadata
tara-kb:hasExtractedArticleMetadata rdf:type owl:AnnotationProperty ;
                                    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                    dcterms:description "A top-level grouping annotation property that organizes all metadata extracted from a trial study and its reporting publication into the bibliographic metadata and study metadata branches."@en ;
                                    dcterms:type tara-kb:grouping ;
                                    tara-ap:hasCompactURI "tara-kb:hasExtractedArticleMetadata" ;
                                    rdfs:label "Extracted Article Metadata"@en ;
                                    skos:altLabel "Extracted_Article_Metadata"@en ;
                                    rdfs:subPropertyOf tara-kb:hasTARAArticlesMetadata .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasGeneralArticleExtractionPrompt
tara-kb:hasGeneralArticleExtractionPrompt rdf:type owl:AnnotationProperty ;
                                          obo:IAO_0000112 """{
  \"role\": \"You are extracting structured metadata from one full-text acupuncture clinical trial article into a predefined set of fields, guided by the TARA ontology.\",
  \"task\": \"Load this article's full text once and reuse it, with prompt caching, across three sequential extraction calls in this fixed order: (1) Bibliographic Metadata (see hasBibliographicMetadata's hasGeneralBibliographicMetadataExtractionPrompt), (2) Acupuncture Study Metadata (see hasAcupunctureStudyMetadata's hasGeneralStudyMetadataExtractionPrompt), (3) OCSI Score Data (see hasOCSIItemScoringMetadata's hasGeneralOCSIScoreExtractionPrompt, a sibling branch of this one, not a structural descendant -- consult it separately). Preserve the same Article_ID_Curie across all three outputs so the resulting spreadsheet rows can be joined.\",
  \"ontology_grounding\": \"For every field's meaning, expected format, and which spreadsheet column it maps to, the field's own hasBibliographicMetadataExtractionPrompt / hasStudyMetadataExtractionPrompt fragment (and its skos:altLabel) in the ontology are authoritative -- do not infer a field's meaning from its property name alone. If a field is not accompanied by an extraction-prompt fragment, it is a derived/mapped or organizational property and must not be extracted directly.\",
  \"response_format\": \"Each of the three extraction calls returns its own JSON object/array as specified in that call's own general prompt; this master prompt does not define a combined output shape.\"
}"""@en ;
                                          dcterms:description """The single, article-independent master extraction prompt spanning all three TARA extraction branches (Bibliographic Metadata, Acupuncture Study Metadata, and OCSI Score Data). Asserted once on hasTARAArticlesMetadata, the true common ancestor of all three branches -- note that hasStudyQualityAssessmentMetadata (the OCSI branch) is a sibling of hasExtractedArticleMetadata, not its descendant, so this master prompt names all three branches explicitly in its content rather than relying on the property tree to imply them.

Top-level JSON keys:

- 'role' -- system framing (string).

- 'task' -- states the fixed extraction order (Bibliographic, then Study, then OCSI) and instructs the pipeline to load the article's full text once and reuse it, with prompt caching, across all three calls, preserving one Article_ID_Curie across all three outputs.

- 'ontology_grounding' -- instructs the extraction script/model that each field's own extraction-prompt fragment and skos:altLabel in the ontology are authoritative for meaning and column mapping, not the property's local name.

- 'response_format' -- notes that each of the three calls defines its own output shape; this property does not define a combined schema."""@en ;
                                          rdfs:label "General Article Extraction Prompt" ;
                                          skos:altLabel "General_Article_Extraction_Prompt" ;
                                          rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt ;
                                          rdfs:range rdf:JSON .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasGeneralBibliographicMetadataExtractionPrompt
tara-kb:hasGeneralBibliographicMetadataExtractionPrompt rdf:type owl:AnnotationProperty ;
                                                        obo:IAO_0000112 """{
  \"role\": \"You are extracting bibliographic metadata for one acupuncture clinical trial article.\",
  \"task\": \"You are given the full text of one article and a set of fields, each supplied separately with a compact extraction fragment (field, description, and optional normalization rules).\",
  \"output_schema\": {
    \"type\": \"array\",
    \"item_fields\": {
      \"field\": \"the field's skos:altLabel (spreadsheet column name)\",
      \"value\": \"the extracted string, or 'Not Specified' / empty per the missing-value rule below\"
    }
  },
  \"global_scoring_rules\": [
    \"If a value is genuinely not found in the article, write the literal string 'Not Specified' -- except for any field whose value is a URI (DOI Link, PubMed Link, Other Link, Dataset Link), where an unfound value must be left as an empty string, never the text 'Not Specified' or a fabricated URL.\",
    \"Never include Chinese characters (Hanzi) in any extracted value. Where a term appears with both an English/pinyin rendering and Chinese characters, extract only the English or pinyin form.\",
    \"Before recording any text value, repair likely PDF-extraction artifacts: (1) rejoin words split across a line break or column boundary, whether or not a stray hyphen was retained (e.g., 'ran- domized' or 'ran domized' -> 'randomized'), judging by whether the joined form is a real word or recognizable term in context; (2) correct a space incorrectly inserted mid-word, and correct two distinct words run together without a space, using context to find the right boundary; (3) do not preserve stray control characters, orphaned hyphens, or ligature-rendering artifacts; (4) if a term remains genuinely ambiguous after repair, extract your best reconstruction rather than leaving it visibly broken, but never fabricate content not present in the source.\",
    \"Preserve accented and diacritical characters exactly as they appear in the source (e.g., 'Muller', 'Garcia-Lopez', 'Sondergaard') -- do not strip or transliterate them to unaccented ASCII.\",
    \"Apply each field's own 'normalization' rule, where present, in addition to these general rules.\"
  ],
  \"response_format\": \"Return a JSON array of one object per field, covering every field supplied, in the order supplied, and nothing else -- no surrounding prose.\"
}"""@en ;
                                                        dcterms:description """The single extraction prompt shared by all Bibliographic Metadata fields. Asserted on hasBibliographicMetadata; combined by the extraction pipeline with each field's hasBibliographicMetadataExtractionPrompt fragment and the article's full text.

Top-level JSON keys:

- 'role' -- system framing (string).

- 'task' -- what the model is given and asked to do (string).

- 'output_schema' -- the required shape of each per-field result object ('field' and 'value').

- 'global_scoring_rules' -- array of strings: rules that apply identically across all Bibliographic fields -- the 'Not Specified' vs. empty-string missing-value rule, the no-Chinese-characters rule, the PDF-extraction text-repair rules, and accented-character preservation -- stated once here rather than repeated per field.

- 'response_format' -- the required shape of the overall response."""@en ;
                                                        rdfs:label "General Bibliographic Metadata Extraction Prompt" ;
                                                        skos:altLabel "General_Bibliographic_Metadata_Extraction_Prompt" ;
                                                        rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt ;
                                                        rdfs:range rdf:JSON .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasGeneralOCSIScoreExtractionPrompt
tara-kb:hasGeneralOCSIScoreExtractionPrompt rdf:type owl:AnnotationProperty ;
                                            obo:IAO_0000112 """{
  \"role\": \"...\",
  \"task\": \"...\",
  \"output_schema\": {
    \"type\": \"array\",
    \"item_fields\": {
      \"item_number\": \"integer 1-27\",
      \"score\": \"0, 1, 2, or 'N/A'\",
      \"rationale\": \"string, <=40 words\",
      \"supporting_quote\": \"string or null\"
    }
  },
  \"global_scoring_rules\": [
    \"...\"
  ],
  \"reviewer_framing\": {
    \"usage_note\": \"...\",
    \"persona\": \"...\",
    \"tie_breaker_heuristic\": \"...\"
  },
  \"section_guidance\": {
    \"usage_note\": \"...\",
    \"typical_sections\": {
      \"1\": [
        \"Abstract\"
      ]
    },
    \"instruction\": \"...\"
  },
  \"response_format\": \"...\"
}"""@en ;
                                            dcterms:description """The single, article-independent LLM extraction prompt covering all 27 OCSI items at once. Asserted on hasOCSIItemScoringMetadata; the extraction pipeline combines this value with each item's hasOCSIScoreExtractionPrompt fragment and the article's full text to assemble one API call per article.

Top-level JSON keys:

- 'role' -- system framing (string).

- 'task' -- what the model is given and asked to do (string).

- 'output_schema' -- the required shape of each per-item result object, via 'item_fields' naming and typing item_number/score/rationale/supporting_quote.

- 'global_scoring_rules' -- array of strings; rules that apply identically across all 27 items (e.g. the multi-part combination logic, the item-1 exception, and how to read a 'parts' vs 'criteria' fragment), so they are not repeated in every item fragment.

- 'reviewer_framing' -- optional, mirroring section_guidance: the extraction script may merge 'persona' (an expert-reviewer framing sentence) into 'role', and/or append 'tie_breaker_heuristic' (OCSI General Instruction A.1.1's reviewer-satisfaction check, applied only as a secondary tie-breaker after the rubric's specific criteria) to 'global_scoring_rules', for A/B testing.

- 'section_guidance' -- optional, for A/B testing: 'typical_sections' is a lookup table of item number to its conventional article section(s); 'instruction' tells the model to check there first before searching the full article.

- 'response_format' -- the required shape of the overall response.

Designed to be sent once as the cached portion of each API call, with per-article full text appended as the non-cached remainder, so its token cost is paid once per pipeline run rather than once per article."""@en ;
                                            rdfs:label "General OCSI Score Extraction Prompt" ;
                                            skos:altLabel "General_OCSI_Score_Extraction_Prompt" ;
                                            rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt ;
                                            rdfs:range rdf:JSON .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasGeneralOCSIScoringInstructions
tara-kb:hasGeneralOCSIScoringInstructions rdf:type owl:AnnotationProperty ;
                                          dcterms:description """Holds the OCSI Manual's General Scoring Instructions (Appendix A.1, Hammerschlag et al. 2011)
- Five mechanical/universal rules that apply identically across all 27 OCSI items (e.g., the composite yes/partial/no/'N/A' combination logic, the 'anywhere in the document' rule and its item-1 exception, and the items: 4-9/item: 16(b) item-specific notes). 
- Asserted once on hasOCSIItemScoringMetadata rather than repeated on each of the 27 item-level score properties;
- Individual hasOCSIScoringRubric values reference these rules by number rather than restating them."""@en ;
                                          rdfs:label "General OCSI Scoring Instructions" ;
                                          skos:altLabel "General_OCSI_Scoring_Instructions" ;
                                          rdfs:subPropertyOf dcterms:relation .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasGeneralOCSIScoringRubrics
tara-kb:hasGeneralOCSIScoringRubrics rdf:type owl:AnnotationProperty ;
                                     dcterms:description """Holds the OCSI Manual's overall scoring scale (Section 2.1, Hammerschlag et al. 2011) and total-score formula (Section 2.3)
- The yes=2/partial=1/no=0/'N/A' scale definition and the percentage-score calculation applied uniformly across all 27 items;
- Asserted once on hasOCSIItemScoringMetadata rather than repeated per item;
- Distinct from hasOCSIScoringRubric, which holds the item-specific operational criteria (TARA-authored, not source text) for each individual item."""@en ;
                                     rdfs:label "General OCSI Scoring Rubrics" ;
                                     skos:altLabel "General_OCSI_Scoring_Rubrics" ;
                                     rdfs:subPropertyOf dcterms:relation .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasGeneralStudyMetadataExtractionPrompt
tara-kb:hasGeneralStudyMetadataExtractionPrompt rdf:type owl:AnnotationProperty ;
                                                obo:IAO_0000112 """{
  \"role\": \"You are extracting acupuncture study design and findings metadata for one acupuncture clinical trial article.\",
  \"task\": \"You are given the full text of one article and a set of fields, each supplied separately with a compact extraction fragment (field, description, and optional normalization rules). Some fields (e.g. Acupuncture Protocol, Study Outcomes Measure, Treatment Duration and Frequency) intentionally combine several related pieces of information into one structured entry rather than separate fields -- follow each such field's normalization rule exactly for its required internal structure.\",
  \"output_schema\": {
    \"type\": \"array\",
    \"item_fields\": {
      \"field\": \"the field's skos:altLabel (spreadsheet column name)\",
      \"value\": \"the extracted string, or 'Not Specified' / empty per the missing-value rule below\"
    }
  },
  \"global_scoring_rules\": [
    \"If a value is genuinely not found in the article, write the literal string 'Not Specified' -- except for any field whose value is a URI (Dataset Link), where an unfound value must be left as an empty string, never the text 'Not Specified' or a fabricated URL.\",
    \"Never include Chinese characters (Hanzi) in any extracted value. Where a term appears with both an English/pinyin rendering and Chinese characters, extract only the English or pinyin form.\",
    \"Before recording any text value, repair likely PDF-extraction artifacts: (1) rejoin words split across a line break or column boundary, whether or not a stray hyphen was retained, judging by whether the joined form is a real word or recognizable term in context; (2) correct a space incorrectly inserted mid-word, and correct two distinct words run together without a space, using context to find the right boundary; (3) do not preserve stray control characters, orphaned hyphens, or ligature-rendering artifacts; (4) if a term remains genuinely ambiguous after repair, extract your best reconstruction rather than leaving it visibly broken, but never fabricate content not present in the source.\",
    \"Preserve accented and diacritical characters exactly as they appear in the source -- do not strip or transliterate them to unaccented ASCII.\",
    \"Fields whose normalization rule states they combine multiple sub-parts (Acupuncture Protocol, Study Outcomes Measure, Treatment Duration and Frequency) must be produced as ONE entry each, in the exact structure their normalization rule specifies -- their component sub-parts are not separately-extracted fields.\",
    \"Apply each field's own 'normalization' rule, where present, in addition to these general rules.\"
  ],
  \"response_format\": \"Return a JSON array of one object per field, covering every field supplied, in the order supplied, and nothing else -- no surrounding prose.\"
}"""@en ;
                                                dcterms:description """The single extraction prompt shared by all Acupuncture Study Metadata fields. Asserted on hasAcupunctureStudyMetadata; combined by the extraction pipeline with each field's hasStudyMetadataExtractionPrompt fragment and the article's full text.

Top-level JSON keys:

- 'role' -- system framing (string).

- 'task' -- what the model is given and asked to do, including the note that several fields (Acupuncture Protocol, Study Outcomes Measure, Treatment Duration and Frequency) intentionally combine multiple sub-parts into one structured entry.

- 'output_schema' -- the required shape of each per-field result object ('field' and 'value').

- 'global_scoring_rules' -- array of strings: rules that apply identically across all Study fields -- the missing-value rule, the no-Chinese-characters rule, the PDF-extraction text-repair rules, accented-character preservation, and the rule that combined-entry fields are produced once, not split into separate fields for their sub-parts.

- 'response_format' -- the required shape of the overall response."""@en ;
                                                rdfs:label "General Study Metadata Extraction Prompt" ;
                                                skos:altLabel "General_Study_Metadata_Extraction_Prompt" ;
                                                rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt ;
                                                rdfs:range rdf:JSON .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasGroupDemographicsCharacteristicsScore
tara-kb:hasGroupDemographicsCharacteristicsScore rdf:type owl:AnnotationProperty ;
                                                 dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011. https://doi.org/10.1155/2011/183910"@en ;
                                                 dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                 dcterms:description """The structural quality score grading the transparency of reporting baseline participant demographics and clinical characteristics.

- The OCSI Item Number, Assessment Question(s) (reproduced from Table 1, Hammerschlag et al., 2011),  and Per Question Instructions(s) (reproduced from Appendix A.2, Hammerschlag et al., 2011) are reproduced under the CC-BY license, with attribution to the original authors. See the Bibliographic Citation section."""@en ;
                                                 tara-ap:hasCompactURI "tara-kb:hasGroupDemographicsCharacteristicsScore" ;
                                                 tara-kb:hasOCSIAssessmentQuestions """(a) Are baseline demographics and

(b) clinical characteristics presented for each group?"""@en ;
                                                 tara-kb:hasOCSIItemNumber "20"^^tara-kb:ocsiItemNumber ;
                                                 tara-kb:hasOCSIPerQuestionInstructions """(a) It must present the demographics, for example, age, gender, ethnicity.

(b) It must present the clinical characteristics, for example, duration of condition, for each group."""@en ;
                                                 tara-kb:hasOCSIScoreExtractionPrompt """{
  \"item\": 20,
  \"question\": \"(a) Are baseline demographics and (b) clinical characteristics presented for each group?\",
  \"parts\": {
    \"a\": \"baseline demographics (e.g., age, gender, ethnicity) are presented for each group\",
    \"b\": \"clinical characteristics (e.g., duration of condition) are presented for each group\"
  }
}"""^^rdf:JSON ;
                                                 tara-kb:hasOCSIScoringRubric """Applicable sub-parts:

(a) baseline demographics (e.g., age, gender, ethnicity) are presented for each group;

(b) clinical characteristics (e.g., duration of condition) are presented for each group.

N = 2 when all 2 are applicable.

Combination rule (N = applicable sub-parts among a-b):

- All N met -> Score 2 (Yes).

- 0 of N met -> Score 0 (No).

- Exactly 1 of N met -> Score 1 (Partial).

OCSI's scale has no graduated partial; any mix short of full or zero collapses to the same Score 1.

- If all applicable sub-parts are N/A -> item scored N/A (interpretive extension, not explicit in Hammerschlag et al. 2011)."""@en ;
                                                 tara-kb:hasTypicalArticleSection "Results"^^tara-kb:articleSectionType ;
                                                 rdfs:label "(20) Group Demographics & Characteristics" ;
                                                 skos:altLabel "20_Group_Demographics_Characteristics" ;
                                                 rdfs:subPropertyOf tara-kb:hasResultsAndOutcomesMetrics ;
                                                 rdfs:range tara-kb:ocsiItemScore ;
                                                 rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasInterpretationOfResultsScore
tara-kb:hasInterpretationOfResultsScore rdf:type owl:AnnotationProperty ;
                                        dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011. https://doi.org/10.1155/2011/183910"@en ;
                                        dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                        dcterms:description """The reporting quality score assessing whether a general interpretation of the results is presented in the context of current evidence.

- The OCSI Item Number, Assessment Question(s) (reproduced from Table 1, Hammerschlag et al., 2011),  and Per Question Instructions(s) (reproduced from Appendix A.2, Hammerschlag et al., 2011) are reproduced under the CC-BY license, with attribution to the original authors. See the Bibliographic Citation section."""@en ;
                                        tara-ap:hasCompactURI "tara-kb:hasInterpretationOfResultsScore" ;
                                        tara-kb:hasOCSIAssessmentQuestions "Is a general interpretation of the results presented, in the context of current evidence?"@en ;
                                        tara-kb:hasOCSIItemNumber "27"^^tara-kb:ocsiItemNumber ;
                                        tara-kb:hasOCSIPerQuestionInstructions "'General interpretation' pertains to how these results relate to previous research. For full credit, authors must (i) cite and (ii) discuss the previous research."@en ;
                                        tara-kb:hasOCSIScoreExtractionPrompt """{
  \"item\": 27,
  \"question\": \"Is a general interpretation of the results presented, in the context of current evidence?\",
  \"parts\": {
    \"i\": \"the previous research is cited\",
    \"ii\": \"the previous research is discussed\"
  }
}"""^^rdf:JSON ;
                                        tara-kb:hasOCSIScoringRubric """Applicable sub-parts:

(i) the previous research is cited;

(ii) the previous research is discussed.

N = 2 when all 2 are applicable.

Combination rule (N = applicable sub-parts among i-ii):

- All N met -> Score 2 (Yes).

- 0 of N met -> Score 0 (No).

- Exactly 1 of N met -> Score 1 (Partial).

OCSI's scale has no graduated partial; any mix short of full or zero collapses to the same Score 1.

- If all applicable sub-parts are N/A -> item scored N/A (interpretive extension, not explicit in Hammerschlag et al. 2011)."""@en ;
                                        tara-kb:hasTypicalArticleSection "Discussion"^^tara-kb:articleSectionType ;
                                        rdfs:label "(27) Interpretation of Results" ;
                                        skos:altLabel "27_Interpretation_of_Results" ;
                                        rdfs:subPropertyOf tara-kb:hasResultsDiscussionMetrics ;
                                        rdfs:range tara-kb:ocsiItemScore ;
                                        rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLLMExtractionPrompt
tara-kb:hasLLMExtractionPrompt rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 """Paradigm A: Using it directly as a Unified JSON Container
:hasOutcomesMeasureX2Score rdf:type owl:AnnotationProperty ;
    :hasLLMExtractionPrompt \"\"\"{
        \"system\": \"You are an Acupucture clinical trial methodology appraiser. Output raw JSON\",
        \"user\": \"Check if primary outcomes are explicitly matched by statistical tests in text: {{ARTICLE_TEXT}}\"
    }\"\"\"^^xsd:string .

Paradigm B: Using it purely as a Parent/Grouping Property 
:hasResultsOutcomesScore rdf:type owl:DatatypeProperty ;
    rdfs:label \"Results Outcomes OCSI Score\" ;
    :hasLLMSystemPrompt \"You are an expert data transparency evaluator. Output raw JSON\" ;
    :hasLLMUserPrompt \"Evaluate if exact numeric p-values and CIs are provided in text: {{ARTICLE_TEXT}}\" ."""@en ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "A dual-purpose annotation property that serves as both a unified container for serialized JSON prompt strings and an organizational grouping property for granular sub-directives."@en ;
                               tara-ap:hasCompactURI "tara-kb:hasLLMExtractionPrompt" ;
                               rdfs:comment """Dual-use design:
1) Direct use: Can hold a single stringified JSON object containing both 'system' and 'user' keys for fast pipeline execution.
2) Taxonomic use: Acts as a structural parent grouping specialized sub-properties."""@en ,
                                            "This is an abstract parent property designed to organize specific prompting layers. In runtime execution environments, pipelines should query the specialized sub-properties rather than this root property to ensure structural separation between runtime environment configurations and target data tasks."@en ,
                                            "This property can be used as a contaier for structured payload specifying both system-level behavior and user-level extraction queries."@en ;
                               rdfs:label "LLM Extraction Prompt" ;
                               skos:altLabel "LLM_Extraction_Prompt" ;
                               rdfs:subPropertyOf dcterms:relation ;
                               rdfs:range rdf:JSON .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLLMSystemPrompt
tara-kb:hasLLMSystemPrompt rdf:type owl:AnnotationProperty ;
                           obo:IAO_0000112 """tara-kb:hasResultsOutcomesScore rdf:type owl:DatatypeProperty ;
    tara-kb:hasLLMSystemPrompt \"\"\"
    You are an expert clinical trial methodology annotator. 
    Your task is to analyze scientific text objectively. 
    Strict constraints: 
    1. Base your evaluation solely on explicit statements in the text. 
    2. Do not infer, extrapolate, or assume context.
    3. Output your final response strictly as a serialized JSON object matching this schema: 
       {\"score\": integer, \"confidence_interval_found\": boolean, \"rationale\": \"string\"}
    \"\"\" ."""@en ;
                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "A specialized annotation property that stores the system-level directives, including agent persona, cognitive constraints, guardrails, formatting parameters (e.g., rigid JSON schemas), and handling instructions for missing data or edge cases."@en ;
                           tara-ap:hasCompactURI "tara-kb:hasLLMSystemPrompt" ;
                           rdfs:comment "Content stored under this property must be injected into the system role array of the LLM chat completion API payload. It controls how the model operates globally across all evaluations, enforcing objectivity and preventing hallucination."@en ;
                           rdfs:label "LLM System Prompt"@en ;
                           skos:altLabel "LLM_System_Prompt"@en ;
                           rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLLMUserPrompt
tara-kb:hasLLMUserPrompt rdf:type owl:AnnotationProperty ;
                         obo:IAO_0000112 """tara-kb:hasResultsOutcomesScore rdf:type owl:AnnotationProperty ;
    tara-kb:hasLLMUserPrompt \"\"\"
    Review the 'Results' section of the attached full-text article.
    Locate all reported endpoints associated with the primary and secondary outcomes.
    Evaluate the completeness of reporting based on these strict rubric parameters:
    - Score 3: Exact numeric data, effect sizes, 95% Confidence Intervals (CIs), and precise p-values are clearly provided for all outcomes.
    - Score 2: Main findings are provided, but exact statistical precision reporting is slightly flawed or lacks CIs for minor endpoints.
    - Score 1: Vague reporting or text-only declarations (e.g., 'differences were non-significant') without underlying data tables or exact values.
    - Score 0: No empirical data or results are presented for the stated outcomes.
    
    Target Text to Evaluate: {{ARTICLE_TEXT}}
    \"\"\" ."""@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "A specialized annotation property that holds the element-specific extraction task, definitions, and grading criteria used to guide the LLM model's focus to a target variable or metric within the full-text article."@en ;
                         tara-ap:hasCompactURI "tara-kb:hasLLMUserPrompt" ;
                         rdfs:comment "Content stored under this property must be injected into the 'user' role array of the LLM chat completion API payload alongside the target article text. It acts as the direct query or instruction set for evaluating the schema field."@en ;
                         rdfs:label "LLM User Prompt" ;
                         skos:altLabel "LLM_User_Prompt" ;
                         rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAcupoints
tara-kb:hasListedAcupoints rdf:type owl:AnnotationProperty ;
                           obo:IAO_0000112 "E.g., \"BL 1, BL 2, BL 3\" (see rdfs:comment for normalization rules)."@en ;
                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "A dual-purpose annotation property that serves as a super-property grouping the mapped and unmappable acupoint sub-properties, while simultaneously acting as a direct container for the comma-separated, normalized list of acupoints extracted from the article."@en ;
                           tara-ap:hasCompactURI "tara-kb:hasListedAcupoints" ;
                           tara-kb:hasStudyMetadataExtractionPrompt """{
  \"field\": \"Listed_Acupoints\",
  \"description\": \"A dual-purpose annotation property that serves as a super-property grouping the mapped and unmappable acupoint sub-properties, while simultaneously acting as a direct container for the comma-separated, normalized list of acupoints extracted from the article.\",
  \"normalization\": \"List every specific acupuncture point mentioned anywhere in the article, including those only appearing in figures, regardless of which treatment group or protocol they belong to -- combine into one flat comma-separated list, not grouped by protocol. Standardize each point to the form 'PREFIX NUMBER' (e.g., 'SP 6', 'GB 20', 'EX-HN 5'); ignore hyphens, parentheses, or other punctuation within a single point's own code. If a point has multiple listed names (e.g., a standard code and a pinyin label), use the standard code; if only a pinyin label is given, use that. Exclude sham/control acupoints from this field.\"
}"""^^rdf:JSON ;
                           rdfs:comment "List every specific acupuncture point mentioned anywhere in the article, including those only appearing in figures, regardless of which treatment group or protocol they belong to -- combine into one flat comma-separated list, not grouped by protocol. Standardize each point to the form 'PREFIX NUMBER' (e.g., 'SP 6', 'GB 20', 'EX-HN 5'); ignore hyphens, parentheses, or other punctuation within a single point's own code. If a point has multiple listed names (e.g., a standard code and a pinyin label), use the standard code; if only a pinyin label is given, use that. Exclude sham/control acupoints from this field."@en ;
                           rdfs:label "Listed Acupoint(s)" ;
                           skos:altLabel "Listed_Acupoints" ;
                           rdfs:subPropertyOf dcterms:description ,
                                              tara-kb:hasAcupunctureStudyMetadata ;
                           rdfs:range xsd:string ;
                           rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAcupointsMapped
tara-kb:hasListedAcupointsMapped rdf:type owl:AnnotationProperty ;
                                 obo:IAO_0000112 "E.g., \"TARA:5363236\" representing acupoint \"GB 8\"."@en ;
                                 dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                 dcterms:description "A specialized mapping annotation property used to store an individual, authoritative controlled vocabulary IRI from the TARA ontology representing a specific anatomical acupuncture point successfully resolved from a publication's raw text list."@en ;
                                 dcterms:type tara-kb:mapping ;
                                 tara-ap:hasCompactURI "tara-kb:hasListedAcupointsMapped" ;
                                 rdfs:comment "Links the mapped TARA IRIs of the listed acupoints used in a study. Each assertion represents a single, un-ordered annotation entry holding an acupoint's full TARA IRI."@en ;
                                 rdfs:label "Listed Acupoint(s) Mapped" ;
                                 skos:altLabel "Listed_Acupoints_Mapped" ;
                                 rdfs:subPropertyOf tara-kb:hasListedAcupoints ;
                                 rdfs:range <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
                                 rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAcupointsMappedCurie
tara-kb:hasListedAcupointsMappedCurie rdf:type owl:AnnotationProperty ;
                                      obo:IAO_0000112 """tara-kb:hasListedAcupointsMappedCurie '''{ \"TARA:5363236\": \"GB 8\",
                                                                     \"TARA:9987270\": \"GB 14\",
                                                                     \"TARA:2324295\": \"GB 20\",
                                                                    }'''^^rdf:JSON ."""@en ;
                                      dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                      dcterms:description "This property associates a flat dictionary lookup table of TARA standard CURIE mappings of listed acupoints used in a trial study. The internal payload is formatted as a JSON object string where keys are CURIE identifiers and values are rdfs:label of the points; e.g., {\"TARA:5363236\": \"GB 8\"}. It provides a flat lookup dictionary map for frontend UI execution."@en ;
                                      dcterms:type tara-kb:mapping ;
                                      tara-ap:hasCompactURI "tara-kb:hasListedAcupointsMappedCurie" ;
                                      rdfs:comment "Associates a JSON object serving as a key-value data map that associates an acupoint's CURIE (key) with its human-readable display label (value). Intended for direct downstream application consumption to optimize localized UI rendering without graph traversal overhead."@en ;
                                      rdfs:label "Listed Acupoint(s) Mapped Curie" ;
                                      skos:altLabel "Listed_Acupoints_Mapped_Curie" ;
                                      rdfs:subPropertyOf tara-kb:hasListedAcupoints ;
                                      rdfs:range rdf:JSON ;
                                      rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAcupointsUnmappable
tara-kb:hasListedAcupointsUnmappable rdf:type owl:AnnotationProperty ;
                                     obo:IAO_0000112 "e.g., \"Ashi point\" or \"Motor point (non-standard)\" - extracted text with no corresponding TARA acupoint IRI."@en ;
                                     dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                     dcterms:description "A specialized tracking annotation property used to isolate and store individual literal text strings or non-standard acupoints extracted from a publication that could not be successfully resolved to a standard TARA ontology IRI."@en ;
                                     dcterms:type tara-kb:mapping ;
                                     tara-ap:hasCompactURI "tara-kb:hasListedAcupointsUnmappable" ;
                                     rdfs:label "Listed Acupoint(s) Unmappable" ;
                                     skos:altLabel "Listed_Acupoints_Unmappable" ;
                                     rdfs:subPropertyOf tara-kb:hasListedAcupoints ;
                                     rdfs:range xsd:string ;
                                     rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAuthors
tara-kb:hasListedAuthors rdf:type owl:AnnotationProperty ;
                         obo:IAO_0000112 "e.g., \"Smith J, Lee K, Chen H\"."@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "The full list of authors credited on the publication, typically recorded as a single delimited string in the order they appear on the article."@en ;
                         tara-ap:hasCompactURI "tara-kb:hasListedAuthors" ;
                         tara-kb:hasBibliographicMetadataExtractionPrompt """{
  \"field\": \"Listed_Authors\",
  \"description\": \"The full list of authors credited on the publication, typically recorded as a single delimited string in the order they appear on the article.\",
  \"normalization\": \"Format as 'Surname Initials' per author (no periods between initials, no space between multiple initials), authors comma-separated in the order listed on the article, e.g. 'Garcia-Lopez J, Lee KH, Muller A'. Preserve accented/diacritical characters exactly as in the source (do not transliterate to ASCII).\"
}"""^^rdf:JSON ;
                         rdfs:label "Listed Author(s)" ;
                         skos:altLabel "Listed_Authors" ;
                         rdfs:subPropertyOf dcterms:creator ,
                                            tara-kb:hasBibliographicMetadata ;
                         rdfs:range xsd:string ;
                         rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


