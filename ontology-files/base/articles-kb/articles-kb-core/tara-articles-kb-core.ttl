###  http://www.acupunctureresearch.org/tara/ontology/kb/hasNeedlingDetails
tara-kb:hasNeedlingDetails rdf:type owl:AnnotationProperty ;
                           obo:IAO_0000112 "\"0.30 mm diameter, 25 mm long stainless steel needles inserted to a depth of 15-20 mm and retained for 20 minutes.\""@en ,
                                           "\"Sterile, single-use coated acupuncture needles, 0.25-0.30 mm thick, 25-40 mm long; 10 to 25 needles per treatment; inserted 2-20 mm in depth; retained for 30 min.\"" ;
                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "The specific needling technique details reported for the acupuncture intervention, such as needle type, gauge, insertion depth, retention time, and elicitation of de qi."@en ;
                           tara-ap:hasCompactURI "tara-kb:hasNeedlingDetails" ;
                           rdfs:label "Needling Details" ;
                           skos:altLabel "Needling_Details" ;
                           rdfs:subPropertyOf dcterms:description ,
                                              tara-kb:hasAcupunctureProtocol ;
                           rdfs:range xsd:string ;
                           rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasNeedlingParametersScore
tara-kb:hasNeedlingParametersScore rdf:type owl:AnnotationProperty ;
                                   obo:IAO_0000112 "e.g., a score of 2 when needle gauge, insertion depth, and de qi response are all reported, or 0 when none of these parameters are given."@en ;
                                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                   dcterms:description "Category B: Acupuncture Intervention Metrics (STRICTA). The technical item score checking the completeness of needle parameters reported (e.g., gauge, depth, de qi sensation)." ;
                                   tara-ap:hasAssessmentQuestion """Are the following parameters of needling presented?

(a) Points used (uni/bilateral)

(b) Number of needles inserted

(c) Depth(s) of insertion

(d) Response elicited (e.g., de qi)

(e) Needle stimulation (manual or electrical)

(f) Needle retention time

(g) Needle type (Material and/or manufacturer, gauge, and length)"""@en ;
                                   tara-ap:hasCompactURI "tara-kb:hasNeedlingParametersScore" ;
                                   tara-ap:hasOCSIItemNumber "5"^^tara-kb:ocsiItemNumber ;
                                   tara-ap:hasScoringInstructions """(a) Unilateral or bilateral can be implied.

(b) If the treatment protocol is individualized, then the authors must state the range of needles utilized (e.g., 8-14 needles). This may be implied from (a).

(c) If the treatments were individualized, the depths must be given as a range, expressed in Cun, mm, or anatomical depth.

(d) Response refers to needle sensations such as de qi (TCM), muscle twitch (trigger point), or muscle contraction (electroacupuncture).

(e) Stimulation refers to techniques in manual acupuncture (lifting, thrusting, or rotating) or electroacupuncture (current, frequency, amplitude).

(f) If treatments were individualized, retention time must be reported as a mean and range.

(g) It must state the gauge, length, and material and/or manufacturer of the needles."""@en ;
                                   rdfs:label "Needling Parameters Score" ;
                                   skos:altLabel "Needling_Parameters_Score" ;
                                   rdfs:subPropertyOf tara-kb:hasAcupunctureInterventionMetrics ;
                                   rdfs:range tara-kb:ocsiItemScore ;
                                   rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOCSIAssessmentID
tara-kb:hasOCSIAssessmentID rdf:type owl:AnnotationProperty ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "A cross-linking annotation property designed to link the specific acupuncture clinical trial study (represented by the 'Acupuncture Research Study' class) to an individual Oregon CONSORT STRICTA Instrument (OCSI) assessment dataset instance (represented by the 'Acupuncture Study OCSI Assessment' class). The 'Acupuncture Research Study' serves as the primary input for the quality-of-reporting assessment represented by the 'Acupuncture Study OCSI Assessment' class." ;
                            tara-ap:hasCompactURI "tara-kb:hasOCSIAssessmentID" ;
                            rdfs:label "Has OCSI Assessment ID" ;
                            skos:altLabel "Has_OCSI_Assessment_ID" ;
                            rdfs:subPropertyOf dcterms:relation ;
                            rdfs:range <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> ;
                            rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> ,
                                        <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOCSIDatasetID
tara-kb:hasOCSIDatasetID rdf:type owl:AnnotationProperty ;
                         dcterms:description "The Compact URI (CURIE) ID of an Acupuncture Study OCSI Assessment Dataset in TARA Articles KB." ;
                         tara-ap:hasCompactURI "tara-kb:hasOCSIDatasetID" ;
                         rdfs:label "Has OCSI Dataset ID" ;
                         skos:altLabel "OCSI Dataset ID" ;
                         rdfs:subPropertyOf dcterms:identifier ;
                         rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOCSIInputStudyID
tara-kb:hasOCSIInputStudyID rdf:type owl:AnnotationProperty ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "A cross-linking annotation property designed to link an individual Oregon CONSORT STRICTA Instrument (OCSI) assessment dataset instance (represented by the 'Acupuncture Study Quality Appraisal' class) back to the specific acupuncture clinical trial study (represented by the 'Acupuncture Research Study' class) served as the primary input for the quality-of-reporting assessment." ;
                            tara-ap:hasCompactURI "tara-kb:hasOCSIInputStudyID" ;
                            rdfs:label "Has OCSI Input Study ID" ;
                            skos:altLabel "Has_OCSI_Input_Study_ID" ;
                            rdfs:subPropertyOf dcterms:relation ;
                            rdfs:range <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> ;
                            rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOCSIItemScoringMetadata
tara-kb:hasOCSIItemScoringMetadata rdf:type owl:AnnotationProperty ;
                                   dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011;2011:183910. https://doi.org/10.1155/2011/183910"@en ;
                                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                   dcterms:description """An annotation property that serves as a master grouping property for capturing quality assessment metrics mapped to individual reporting items within the Oregon CONSORT STRICTA Instrument (OCSI) for acupuncture trials. 

TARA-KB's sub-grouping of OCSI assessment categories (A-D), aggregate derived compliance values specifically tied to the combined CONSORT (Consolidated Standards of Reporting Trials) and STRICTA (Standards for Reporting Interventions in Clinical Trials of Acupuncture) guidelines. It organizes granular sub-properties tracking item-by-item compliance scores, separating the calculated evaluation of reporting quality from the raw extracted study parameters.

The sub-grouping properties across all four categories (A-D), are reporting-quality metrics: they assess how completely and transparently a trial was described in its published article, not the intrinsic quality, appropriateness, or clinical merit of the trial's design, intervention, or conduct. A high OCSI score means the article reported its methods and results thoroughly; it does not mean the underlying trial was well-designed or its findings reliable."""@en ;
                                   dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                   dcterms:type tara-kb:grouping ;
                                   tara-ap:hasCompactURI "tara-kb:hasOCSIItemScoringMetadata" ;
                                   tara-ap:hasScoringInstructions """General scoring instructions (OCSI Manual, Appendix A.1): 

(i) When scoring each question, consider whether a reviewer would be satisfied with what is reported, and whether the details given would be sufficient to reproduce the findings. 

(ii) When multiple components or \"and\" statements are listed for a question, all aspects must be met to receive full credit.

(iii) Except for item no. 1, if the information is placed anywhere in the document, the question can receive full credit.

(iv) For items 4-9 (from STRICTA), nos. 4-8 pertain only to the acupuncture aspects of the study, while no. 9 pertains to all types of control or comparison groups. 

(v) Practitioners are almost always NOT blinded in acupuncture research; hence item 16(b) is usually scored N/A."""@en ;
                                   rdfs:comment "Item questions (Table 1) and scoring rubrics (Appendix A) reproduced under the CC-BY license, with attribution to the original authors."@en ,
                                                """Scoring scale and total score formula (Hammerschlag et al. 2011, Section 2.1 and 2.3):
- Each of the 27 OCSI questions is scored yes = 2, partial = 1, no = 0, or Not Applicable = N/A, based on the composite scoring of its lettered sub-questions. A question is scored partial if its sub-questions receive a mix of ratings.
- An article's total OCSI score is calculated as: raw score ÷ (2 × [27 − n items scored N/A]) × 100, i.e., items scored N/A are excluded from both the numerator and the denominator rather than counted as zero."""@en ;
                                   rdfs:label "OCSI Item Scoring Metadata" ;
                                   skos:altLabel "OCSI_Item_Scoring_Metadata" ;
                                   rdfs:subPropertyOf tara-kb:hasStudyQualityAssessmentMetadata ;
                                   rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOCSITotalPercentage
tara-kb:hasOCSITotalPercentage rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 "e.g., 82.5 (representing 82.5% overall compliance across all OCSI-scored items)."@en ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "The global reporting-quality percentage for a study's OCSI assessment, calculated per Hammerschlag et al. 2011 as: raw score / (2 x [27 - n items scored N/A]) x 100. Unlike the 27 item-level score properties nested under the four OCSI categories, this is a derived summary value and is therefore attached directly to hasOCSIItemScoringMetadata rather than to any single category." ;
                               tara-ap:hasCompactURI "tara-kb:hasOCSITotalPercentage" ;
                               rdfs:label "OCSI Total Percentage" ;
                               skos:altLabel "OCSI_Total_Percentage" ;
                               rdfs:subPropertyOf tara-kb:hasOCSIItemScoringMetadata ;
                               rdfs:range tara-kb:percentFloat ;
                               rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOtherLink
tara-kb:hasOtherLink rdf:type owl:AnnotationProperty ;
                     obo:IAO_0000112 "A publisher landing page link or preprint repository link" ,
                                     "E.g., https://app.southbaylo.net/c1/library/uploads/daom/DAOM%20John%20Fang.pdf"@en ;
                     dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                     dcterms:description "A resolvable URI to any other authoritative online source for the article that is not captured by hasDOILink or hasPubMedLink."@en ;
                     tara-ap:hasCompactURI "tara-kb:hasOtherLink" ;
                     rdfs:label "Other Link" ;
                     skos:altLabel "Other_Link" ;
                     rdfs:subPropertyOf dcterms:identifier ,
                                        tara-kb:hasPublicationLink ;
                     rdfs:range xsd:anyURI ;
                     rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOutcomeMeasuresScore
tara-kb:hasOutcomeMeasuresScore rdf:type owl:AnnotationProperty ;
                                obo:IAO_0000112 "e.g., a score of 2 when the primary outcome and how it was measured are both clearly defined, or 0 when neither is stated."@en ;
                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                dcterms:description "Category C: Study Design and Analysis Metrics. The sub-score assessing whether the primary (and, if applicable, secondary) outcome measures are clearly defined, including any methods used to enhance measurement quality." ;
                                tara-ap:hasAssessmentQuestion """(a) Are primary and (if applicable) secondary outcome measures clearly defined?

(b) Are there statements (when applicable), regarding any methods used to enhance the quality of measurements, for example, multiple observers or training of assessors?"""@en ;
                                tara-ap:hasCompactURI "tara-kb:hasOutcomeMeasuresScore" ;
                                tara-ap:hasOCSIItemNumber "11"^^tara-kb:ocsiItemNumber ;
                                tara-ap:hasScoringInstructions """(a) It must explicitly state the primary outcome(s) and how it (they) was measured. If the primary outcome was not specifically indicated, partial credit can be awarded.

(b) If particular steps were taken to increase the reliability of the measurements, sufficient details of the steps must be presented."""@en ;
                                rdfs:label "Outcome Measures Score" ;
                                skos:altLabel "Outcome_Measures_Score" ;
                                rdfs:subPropertyOf tara-kb:hasOutcomesMeasureX2Score ;
                                rdfs:range tara-kb:ocsiItemScore ;
                                rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOutcomesMeasureX2Score
tara-kb:hasOutcomesMeasureX2Score rdf:type owl:AnnotationProperty ;
                                  obo:IAO_0000112 "e.g., a combined value of 4 when both the outcome-measure definitions and the statistical methods are fully reported (2 each), derived from its hasOutcomeMeasuresScore and hasStatisticalMethodsScore sub-scores." ;
                                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                  dcterms:description "A quality metric within Category C: Study Design and Analysis Metrics that assesses whether a study's outcome measures are explicitly defined and directly paired with appropriate, transparent statistical testing methods, derived as the sum of its two sub-scores." ;
                                  tara-ap:hasCompactURI "tara-kb:hasOutcomesMeasureX2Score" ;
                                  rdfs:label "Outcomes Measure X2 Score" ;
                                  skos:altLabel "Outcomes_Measure_X2_Score" ;
                                  rdfs:subPropertyOf tara-kb:hasStudyDesignAndAnalysisMetrics ;
                                  rdfs:range tara-kb:nonNegShortInt ;
                                  rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasParticipantFlowScore
tara-kb:hasParticipantFlowScore rdf:type owl:AnnotationProperty ;
                                obo:IAO_0000112 "e.g., a score of 2 when a participant flow diagram or equivalent quantitative account is given along with reasons for protocol deviations, or 0 when participant flow is not described."@en ;
                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                dcterms:description "Category D: Results and Discussion Metrics. The reporting score assessing whether the flow of participants through each stage of the trial is quantitatively described, including reasons for any protocol deviations." ;
                                tara-ap:hasAssessmentQuestion """(a) Is the flow of participants through each stage quantitatively described, and

(b) if protocol deviations are reported, were reasons presented?"""@en ;
                                tara-ap:hasCompactURI "tara-kb:hasParticipantFlowScore" ;
                                tara-ap:hasOCSIItemNumber "18"^^tara-kb:ocsiItemNumber ;
                                tara-ap:hasScoringInstructions """(a) A diagram is recommended but not necessary. For full credit, authors must state the number of participants who were evaluated for potential enrollment, randomized, received treatment, completed treatment, and analyzed for the primary outcome.

(b) Protocol deviations pertains to departures from the protocol after randomization, or the specific reasons for patient exclusions after randomization, including drop-outs."""@en ;
                                rdfs:label "Participant Flow Score" ;
                                skos:altLabel "Participant_Flow_Score" ;
                                rdfs:subPropertyOf tara-kb:hasResultsAndDiscussionMetrics ;
                                rdfs:range tara-kb:ocsiItemScore ;
                                rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasParticipantsScore
tara-kb:hasParticipantsScore rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "e.g., a score of 2 when age, sex, and enrollment/dropout flow are all reported, or 0 when none of this information is given."@en ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description "Category D: Results and Discussion Metrics. The structural quality score grading the transparency of reporting baseline participant demographics and flow data." ;
                             tara-ap:hasAssessmentQuestion """(a) Are baseline demographics and

(b) clinical characteristics presented for each group?"""@en ;
                             tara-ap:hasCompactURI "tara-kb:hasParticipantsScore" ;
                             tara-ap:hasOCSIItemNumber "20"^^tara-kb:ocsiItemNumber ;
                             tara-ap:hasScoringInstructions """(a) It must present the demographics, for example, age, gender, ethnicity.

(b) It must present the clinical characteristics, for example, duration of condition, for each group."""@en ;
                             rdfs:label "Participants Score" ;
                             skos:altLabel "Participants_Score" ;
                             rdfs:subPropertyOf tara-kb:hasResultsAndDiscussionMetrics ;
                             rdfs:range tara-kb:ocsiItemScore ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasPractitionerScore
tara-kb:hasPractitionerScore rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "e.g., a score of 2 when practitioner qualifications and years of experience are stated, or 0 when no practitioner background is given."@en ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description "Category B: Acupuncture Intervention Metrics (STRICTA). The sub-score assessing whether the practitioners' background, training, and experience administering acupuncture are reported."@en ;
                             tara-ap:hasAssessmentQuestion """Are descriptions provided of the

(a) duration of practitioner training,

(b) length of clinical experience, and

(c) expertise in specific condition?"""@en ;
                             tara-ap:hasCompactURI "tara-kb:hasPractitionerScore" ;
                             tara-ap:hasOCSIItemNumber "8"^^tara-kb:ocsiItemNumber ;
                             tara-ap:hasScoringInstructions """(a) Duration of practitioner training can be implied, for example, LAc or a similar indication of formal training.

(b) Clinical experience refers to number of years in practice as an acupuncturist.

(c) Expertise must include experience, as an acupuncturist, with the condition under investigation."""@en ;
                             rdfs:label "Practitioner Score" ;
                             skos:altLabel "Practitioner_Score" ;
                             rdfs:subPropertyOf tara-kb:hasAcupunctureInterventionMetrics ;
                             rdfs:range tara-kb:ocsiItemScore ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


