                          dcterms:description "The country (or countries, for multi-site trials) in which the study was conducted, normalized to a standard country name."@en ;
                          tara:hasCompactURI "tara-kb:hasCountryOfStudy" ;
                          rdfs:label "Country of Study"@en ;
                          skos:prefLabel "Country_Of_Study" ;
                          rdfs:subPropertyOf dcterms:relation ,
                                             tara-kb:hasStudyLocation ;
                          rdfs:range xsd:string ;
                          rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasDOILink
tara-kb:hasDOILink rdf:type owl:AnnotationProperty ;
                   <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"https://doi.org/10.1089/acm.2021.0142\"."@en ;
                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                   dcterms:description "The resolvable URI (typically expressed as a DOI-based URL) that uniquely and persistently identifies the publication."@en ;
                   tara:hasCompactURI "tara-kb:hasDOILink" ;
                   rdfs:label "DOI Link" ;
                   skos:prefLabel "DOI_Link" ;
                   rdfs:subPropertyOf dcterms:identifier ,
                                      tara-kb:hasPublicationLink ;
                   rdfs:range xsd:anyURI ;
                   rdfs:domain tara:TARA_8223728 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasDatasetLink
tara-kb:hasDatasetLink rdf:type owl:AnnotationProperty ;
                       <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"https://clinicaltrials.gov/study/NCT01234567\"."@en ;
                       dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                       dcterms:description "A resolvable URI pointing to a publicly available raw dataset, supplementary data, or trial registry entry associated with the study."@en ;
                       tara:hasCompactURI "tara-kb:hasDatasetLink" ;
                       rdfs:label "Dataset Link" ;
                       skos:prefLabel "Dataset_Link" ;
                       rdfs:subPropertyOf dcterms:relation ,
                                          tara-kb:hasStudyMetadata ;
                       rdfs:range xsd:anyURI ;
                       rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasEligibilityScore
tara-kb:hasEligibilityScore rdf:type owl:AnnotationProperty ;
                            <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., a score of 2 when both inclusion and exclusion criteria are explicitly listed, 1 when only partially described, or 0 when absent from the article."@en ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "Category A: Study Foundation & Background Metrics (CONSORT). The reporting score tracking how clearly the inclusion and exclusion criteria for study participants were defined." ;
                            tara:hasCompactURI "tara-kb:hasEligibilityScore" ;
                            rdfs:label "Eligibility Score" ;
                            skos:prefLabel "Eligibility_Score" ;
                            rdfs:subPropertyOf tara-kb:hasStudyFoundationAndBackgroundMetrics ;
                            rdfs:range tara:TARA_5972061 ;
                            rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasEvaluativeResultsAndGlobalMetrics
tara-kb:hasEvaluativeResultsAndGlobalMetrics rdf:type owl:AnnotationProperty ;
                                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                             dcterms:description "Category D: Evaluative Results & Global Metrics. Grouping property for mathematical evaluations, dataset scoring, and final percentage parameters." ;
                                             tara:hasCompactURI "tara-kb:hasEvaluativeResultsAndGlobalMetrics" ;
                                             rdfs:label "Evaluative Results and Global Metrics" ;
                                             skos:prefLabel "Evaluative_Results_And_Global_Metrics" ;
                                             rdfs:subPropertyOf tara-kb:hasOCSIScoreMetadata ;
                                             rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasExtractedArticleMetadata
tara-kb:hasExtractedArticleMetadata rdf:type owl:AnnotationProperty ;
                                    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                    dcterms:description "A top-level grouping annotation property that organizes all metadata extracted from a trial study and its reporting publication into the bibliographic metadata and study metadata branches."@en ;
                                    tara:hasCompactURI "tara-kb:hasExtractedArticleMetadata" ;
                                    rdfs:label "Extracted Article Metadata"@en ;
                                    skos:prefLabel "Extracted_Article_Metadata"@en ;
                                    rdfs:subPropertyOf tara-kb:hasTARAArticlesMetadata .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasFrequencyOfTreatmentScore
tara-kb:hasFrequencyOfTreatmentScore rdf:type owl:AnnotationProperty ;
                                     <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., a score of 2 when the number, interval, and total duration of sessions are all specified, or 0 when the treatment schedule is not reported."@en ;
                                     dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                     dcterms:description "Category B: Technical Intervention Quality Metrics (STRICTA). The reporting item score checking if treatment intervals, session patterns, and total schedules are documented." ;
                                     tara:hasCompactURI "tara-kb:hasFrequencyOfTreatmentScore" ;
                                     rdfs:label "Treatment Frequency Score" ;
                                     skos:prefLabel "Frequency_Of_Treatment_Score" ;
                                     rdfs:subPropertyOf tara-kb:hasTechnicalInterventionQualityMetrics ;
                                     rdfs:range tara:TARA_5972061 ;
                                     rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasIntroductionAndHypothesisScore
tara-kb:hasIntroductionAndHypothesisScore rdf:type owl:AnnotationProperty ;
                                          <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., a score of 2 when the article states both clinical background and an explicit hypothesis, or 0 when neither is present."@en ;
                                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                          dcterms:description "Category A: Study Foundation & Background Metrics (CONSORT). The quality score measuring how completely the trial introduction presents clinical context and scientific rationale." ;
                                          tara:hasCompactURI "tara-kb:hasIntroductionAndHypothesisScore" ;
                                          rdfs:label "Introduction and Hypothesis Score" ;
                                          skos:prefLabel "Introduction_And_Hypothesis_Score" ;
                                          rdfs:subPropertyOf tara-kb:hasStudyFoundationAndBackgroundMetrics ;
                                          rdfs:range tara:TARA_5972061 ;
                                          rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLLMExtractionPrompt
tara-kb:hasLLMExtractionPrompt rdf:type owl:AnnotationProperty ;
                               <http://purl.obolibrary.org/obo/IAO_0000112> """Paradigm A: Using it directly as a Unified JSON Container
:hasOutcomesMeasureX2Score rdf:type owl:AnnotationProperty ;
    :hasLLMExtractionPrompt \"\"\"{
        \"system\": \"You are an Acupucture clinical trial methodology appraiser. Output raw JSON\",
        \"user\": \"Check if primary outcomes are explicitly matched by statistical tests in text: {{ARTICLE_TEXT}}\"
    }\"\"\"^^xsd:string .

Paradigm B: Using it purely as a Parent/Grouping Property 
:hasResultsOutcomesScore rdf:type owl:DatatypeProperty ;
    rdfs:label \"Results Outcomes OCSI Score\" ;
    :hasLLMSystemPrompt \"You are an expert data transparency evaluator. Output raw JSON\" ;
    :hasLLMUserPrompt \"Evaluate if exact numeric p-values and CIs are provided in text: {{ARTICLE_TEXT}}\" ."""@en ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "A dual-purpose annotation property that serves as both a unified container for serialized JSON prompt strings and an organizational grouping property for granular sub-directives."@en ;
                               tara:hasCompactURI "tara-kb:hasLLMExtractionPrompt" ;
                               tara:hasSynonym "hasLLMDataExtractionPrompt" ;
                               rdfs:comment """Dual-use design:
1) Direct use: Can hold a single stringified JSON object containing both 'system' and 'user' keys for fast pipeline execution.
2) Taxonomic use: Acts as a structural parent grouping specialized sub-properties."""@en ,
                                            "This is an abstract parent property designed to organize specific prompting layers. In runtime execution environments, pipelines should query the specialized sub-properties rather than this root property to ensure structural separation between runtime environment configurations and target data tasks."@en ,
                                            "This property can be used as a contaier for structured payload specifying both system-level behavior and user-level extraction queries."@en ;
                               rdfs:label "LLM Extraction Prompt" ;
                               skos:prefLabel "LLM_Extraction_Prompt" ;
                               rdfs:subPropertyOf dcterms:relation ,
                                                  tara-kb:hasTARAArticlesMetadata ;
                               rdfs:range rdf:JSON .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLLMSystemPrompt
tara-kb:hasLLMSystemPrompt rdf:type owl:AnnotationProperty ;
                           <http://purl.obolibrary.org/obo/IAO_0000112> """tara-kb:hasResultsOutcomesScore rdf:type owl:DatatypeProperty ;
    tara-kb:hasLLMSystemPrompt \"\"\"
    You are an expert clinical trial methodology annotator. 
    Your task is to analyze scientific text objectively. 
    Strict constraints: 
    1. Base your evaluation solely on explicit statements in the text. 
    2. Do not infer, extrapolate, or assume context.
    3. Output your final response strictly as a serialized JSON object matching this schema: 
       {\"score\": integer, \"confidence_interval_found\": boolean, \"rationale\": \"string\"}
    \"\"\" ."""@en ;
                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "A specialized annotation property that stores the system-level directives, including agent persona, cognitive constraints, guardrails, formatting parameters (e.g., rigid JSON schemas), and handling instructions for missing data or edge cases."@en ;
                           tara:hasCompactURI "tara-kb:hasLLMSystemPrompt" ;
                           rdfs:comment "Content stored under this property must be injected into the system role array of the LLM chat completion API payload. It controls how the model operates globally across all evaluations, enforcing objectivity and preventing hallucination."@en ;
                           rdfs:label "LLM System Prompt"@en ;
                           skos:prefLabel "LLM_System_Prompt"@en ;
                           rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLLMUserPrompt
tara-kb:hasLLMUserPrompt rdf:type owl:AnnotationProperty ;
                         <http://purl.obolibrary.org/obo/IAO_0000112> """tara-kb:hasResultsOutcomesScore rdf:type owl:AnnotationProperty ;
    tara-kb:hasLLMUserPrompt \"\"\"
    Review the 'Results' section of the attached full-text article.
    Locate all reported endpoints associated with the primary and secondary outcomes.
    Evaluate the completeness of reporting based on these strict rubric parameters:
    - Score 3: Exact numeric data, effect sizes, 95% Confidence Intervals (CIs), and precise p-values are clearly provided for all outcomes.
    - Score 2: Main findings are provided, but exact statistical precision reporting is slightly flawed or lacks CIs for minor endpoints.
    - Score 1: Vague reporting or text-only declarations (e.g., 'differences were non-significant') without underlying data tables or exact values.
    - Score 0: No empirical data or results are presented for the stated outcomes.
    
    Target Text to Evaluate: {{ARTICLE_TEXT}}
    \"\"\" ."""@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "A specialized annotation property that holds the element-specific extraction task, definitions, and grading criteria used to guide the LLM model's focus to a target variable or metric within the full-text article."@en ;
                         tara:hasCompactURI "tara-kb:hasLLMUserPrompt" ;
                         rdfs:comment "Content stored under this property must be injected into the 'user' role array of the LLM chat completion API payload alongside the target article text. It acts as the direct query or instruction set for evaluating the schema field."@en ;
                         rdfs:label "LLM User Prompt" ;
                         skos:prefLabel "LLM_User_Prompt" ;
                         rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLimitationsScore
tara-kb:hasLimitationsScore rdf:type owl:AnnotationProperty ;
                            <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., a score of 2 when a dedicated limitations discussion is present, or 0 when limitations are not addressed at all."@en ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "Category A: Study Foundation & Background Metrics (CONSORT). The quality grading evaluating whether the study authors adequately identified and discussed potential sources of bias or trial constraints." ;
                            tara:hasCompactURI "tara-kb:hasLimitationsScore" ;
                            rdfs:label "Limitations Score" ;
                            skos:prefLabel "Limitations_Score" ;
                            rdfs:subPropertyOf tara-kb:hasStudyFoundationAndBackgroundMetrics ;
                            rdfs:range tara:TARA_5972061 ;
                            rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAcupoint
tara-kb:hasListedAcupoint rdf:type owl:AnnotationProperty ;
                          <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"BL 1, BL 2, BL 3\" (see rdfs:comment for normalization rules)."@en ;
                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                          dcterms:description "A dual-purpose annotation property that serves as a super-property grouping the mapped and unmappable acupoint sub-properties, while simultaneously acting as a direct container for the comma-separated, normalized list of acupoints reported in the article."@en ;
                          tara:hasCompactURI "tara-kb:hasListedAcupoint" ;
                          rdfs:comment """- The list should exclude sham acupoints from this field. 
- Instruct the LLM to normalize the extracted list as comma-separated values of acupoints; e.g., BL 1, BL 2, BL 3.
- Instruct to exclude the text inside parentheses/brackets (typically synonyms) to normalize the extracted list."""@en ,
                                       "Comma seperated list of acupoints used in the article." ;
                          rdfs:label "Listed Acupoint(s)" ;
                          skos:prefLabel "Listed_Acupoints" ;
                          rdfs:subPropertyOf dcterms:description ,
                                             tara-kb:hasAcupunctureProtocol ;
                          rdfs:range xsd:string ;
                          rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAcupointMap
tara-kb:hasListedAcupointMap rdf:type owl:AnnotationProperty ;
                             <http://purl.obolibrary.org/obo/IAO_0000112> """tara-kb:hasListedAcupointMap '''{
        \"TARA:5363236\": \"GB 8\",
        \"TARA:9987270\": \"GB 14\",
        \"TARA:2324295\": \"GB 20\",
    }'''^^rdf:JSON ."""@en ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description """This property associates a flat dictionary lookup table of TARA standard mappings of listed acupoints used in a trial study. The internal payload is formatted as a JSON object string where keys are CURIE identifiers and values are rdfs:label of the points; e.g., {\"TARA:5363236\": \"GB 8\"}. It provides a flat lookup dictionary map for frontend UI execution; e.g.,

tara-kb:hasListedAcupointMap '''{
        \"TARA:5363236\": \"GB 8\",
        \"TARA:9987270\": \"GB 14\",
        \"TARA:2324295\": \"GB 20\",
    }'''^^rdf:JSON ."""@en ;
                             tara:hasCompactURI "tara-kb:hasListedAcupointMap" ;
                             rdfs:comment "Associates a JSON object serving as a key-value data map that associates an acupoint's CURIE (key) with its human-readable display label (value). Intended for direct downstream application consumption to optimize localized UI rendering without graph traversal overhead."@en ;
                             rdfs:label "Listed Acupoint(s) Map" ;
                             skos:prefLabel "Listed_Acupoint_Map" ;
                             rdfs:subPropertyOf tara-kb:hasListedAcupoint ;
                             rdfs:range rdf:JSON ;
                             rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAuthors
tara-kb:hasListedAuthors rdf:type owl:AnnotationProperty ;
                         <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"Smith J, Lee K, Chen H\"."@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "The full list of authors credited on the publication, typically recorded as a single delimited string in the order they appear on the article."@en ;
                         tara:hasCompactURI "tara-kb:hasListedAuthors" ;
                         rdfs:label "Listed Author(s)" ;
                         skos:prefLabel "Listed_Authors" ;
                         rdfs:subPropertyOf dcterms:creator ,
                                            tara-kb:hasBibliographicMetadata ;
                         rdfs:range xsd:string ;
                         rdfs:domain tara:TARA_8223728 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasMappedAcupoint
tara-kb:hasMappedAcupoint rdf:type owl:AnnotationProperty ;
                          <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"TARA:5363236\" representing the acupoint \"GB 8\"."@en ;
                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                          dcterms:description "A specialized mapping annotation property used to store an individual, authoritative controlled vocabulary URI from the TARA ontology representing a specific anatomical acupuncture point successfully resolved from a publication's raw text list."@en ;
                          tara:hasCompactURI "tara-kb:hasMappedAcupoint" ;
                          rdfs:comment "Links the mapped TARA IRIs of the listed acupoints used in a study. Each assertion represents a single, un-ordered annotation entry holding an acupoint's full TARA IRI."@en ;
                          rdfs:label "Mapped Acupoint" ;
                          skos:prefLabel "Mapped_Acupoint" ;
                          rdfs:subPropertyOf tara-kb:hasListedAcupoint ;
                          rdfs:range tara:TARA_1132428 ;
                          rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasMappedTCMCondition
tara-kb:hasMappedTCMCondition rdf:type owl:AnnotationProperty ;
                              <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., a URI from an external TCM pattern vocabulary corresponding to \"Qi and Blood Stagnation\"."@en ;
                              dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                              dcterms:description "An individual, authoritative controlled vocabulary URI from an external biomedical ontology or standard vocabulary successfully resolved from a publication's raw TCM condition text." ;
                              tara:hasCompactURI "tara-kb:hasMappedTCMCondition" ;
                              rdfs:label "Mapped Condition (TCM)" ;
                              skos:prefLabel "Mapped_TCM_Condition" ;
                              rdfs:subPropertyOf tara-kb:hasStudiedTCMCondition ;
                              rdfs:range tara:TARA_6703917 ;
                              rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasMappedWesternCondition
tara-kb:hasMappedWesternCondition rdf:type owl:AnnotationProperty ;
                                  <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., a MONDO URI such as <http://purl.obolibrary.org/obo/MONDO_0005277> corresponding to \"migraine disorder\"."@en ;
                                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                  dcterms:description "An individual, authoritative controlled vocabulary URI from an external biomedical ontology (such as MONDO or HP) successfully resolved from a publication's raw Western condition text."@en ;
                                  tara:hasCompactURI "tara-kb:hasMappedWesternCondition" ;
                                  rdfs:label "Mapped Condition (Western)" ;
