###  http://www.acupunctureresearch.org/tara/ontology/kb/hasRandomAllocationScore
tara-kb:hasRandomAllocationScore rdf:type owl:AnnotationProperty ;
                                 obo:IAO_0000112 "e.g., a combined value of 4 when both the sequence-generation method and the allocation-concealment method are fully reported (2 each), derived from its hasSequenceGenerationScore and hasAllocationConcealmentScore sub-scores." ;
                                 dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                 dcterms:description "Category C: Study Design and Analysis Metrics. The core CONSORT-aligned quality score checking whether the sequence generation and allocation concealment methods are valid, derived as the sum of its two sub-scores." ;
                                 tara-ap:hasCompactURI "tara-kb:hasRandomAllocationScore" ;
                                 rdfs:label "Random Allocation Score" ;
                                 skos:altLabel "Random_Allocation_Score" ;
                                 rdfs:subPropertyOf tara-kb:hasStudyDesignAndAnalysisMetrics ;
                                 rdfs:range tara-kb:nonNegShortInt ;
                                 rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasRandomizationStatementScore
tara-kb:hasRandomizationStatementScore rdf:type owl:AnnotationProperty ;
                                       obo:IAO_0000112 "e.g., a score of 2 when the abstract or title explicitly states random allocation, or 0 when randomization is not mentioned in the abstract or title."@en ;
                                       dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                       dcterms:description "Category A: Study Rationale and Scope Metrics. The reporting score assessing whether the article explicitly states, in the abstract or title, that participants were randomly assigned to interventions." ;
                                       tara-ap:hasAssessmentQuestion "Is there an explicit statement that patients were randomly assigned to interventions?"@en ;
                                       tara-ap:hasCompactURI "tara-kb:hasRandomizationStatementScore" ;
                                       tara-ap:hasOCSIItemNumber "1"^^tara-kb:ocsiItemNumber ;
                                       tara-ap:hasScoringInstructions "It must state in the abstract or title that participants were allocated to interventions in a randomized manner, that is, random allocation, randomized, or randomly assigned."@en ;
                                       rdfs:label "Randomization Statement Score" ;
                                       skos:altLabel "Randomization_Statement_Score" ;
                                       rdfs:subPropertyOf tara-kb:hasStudyRationaleAndScopeMetrics ;
                                       rdfs:range tara-kb:ocsiItemScore ;
                                       rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasRecruitmentAndFollowUpScore
tara-kb:hasRecruitmentAndFollowUpScore rdf:type owl:AnnotationProperty ;
                                       obo:IAO_0000112 "e.g., a score of 2 when both the recruitment period dates and the follow-up duration are stated, or 0 when neither is reported."@en ;
                                       dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                       dcterms:description "Category D: Results and Discussion Metrics. The reporting score assessing whether the recruitment period and the length of follow-up are stated." ;
                                       tara-ap:hasAssessmentQuestion """(a) Are dates provided that define the period of recruitment?

(b) Is the length of followup (on-treatment and posttreatment) reported?"""@en ;
                                       tara-ap:hasCompactURI "tara-kb:hasRecruitmentAndFollowUpScore" ;
                                       tara-ap:hasOCSIItemNumber "19"^^tara-kb:ocsiItemNumber ;
                                       tara-ap:hasScoringInstructions """(a) It must state the start and finish dates of the recruitment period, to place the study in historical context.

(b) It must state the length of time for the followup period, for example, participants were followed for a total of 6 months, 3 months during treatment and 3 months of posttreatment followup."""@en ;
                                       rdfs:label "Recruitment and Follow-Up Score" ;
                                       skos:altLabel "Recruitment_And_Follow_Up_Score" ;
                                       rdfs:subPropertyOf tara-kb:hasResultsAndDiscussionMetrics ;
                                       rdfs:range tara-kb:ocsiItemScore ;
                                       rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasReportedStudyID
tara-kb:hasReportedStudyID rdf:type owl:AnnotationProperty ;
                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "A cross-linking annotation property designed to establish a direct relational association between an information artifact representing a 'Study Publication' (such as a journal article, systematic review, or report) and the physical, operational scientific trial or investigation process (represented by the 'Research Study' class) it documents."@en ;
                           tara-ap:hasCompactURI "tara-kb:hasReportedStudyID" ;
                           rdfs:label "Has Reported Study ID"@en ;
                           skos:altLabel "Reported_Study_ID"@en ;
                           rdfs:subPropertyOf dcterms:relation ;
                           rdfs:range <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> ;
                           rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasReportingPublicationID
tara-kb:hasReportingPublicationID rdf:type owl:AnnotationProperty ;
                                  dcterms:description "A cross-linking annotation property designed to establish a direct relational association between a Research Study (the physical, operational clinical trial or investigation process) and the publication (such as a journal article) where the study is reported." ;
                                  tara-ap:hasCompactURI "tara-kb:hasReportingPublicationID" ;
                                  rdfs:label "Has Reporting Publication ID" ;
                                  skos:altLabel "Reporting_Publication_ID" ;
                                  rdfs:subPropertyOf dcterms:relation ;
                                  rdfs:range <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> ;
                                  rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> ,
                                              <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasResultsAndDiscussionMetrics
tara-kb:hasResultsAndDiscussionMetrics rdf:type owl:AnnotationProperty ;
                                       dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                       dcterms:description "This is a TARA-KB convention of categorization: Category D, Results and Discussion Metrics, groups the OCSI items reporting what was actually observed and how it was interpreted -- participant flow (item 18), recruitment and follow-up (item 19), baseline demographics (item 20), numbers analyzed (item 21), outcomes and estimation (item 22), subgroup analyses (item 23), adverse events (item 24), and the discussion of limitations, generalizability, and interpretation (items 25-27)."@en ;
                                       dcterms:type tara-kb:grouping ;
                                       tara-ap:hasCompactURI "tara-kb:hasResultsAndDiscussionMetrics" ;
                                       rdfs:comment "This four-way category scheme (A/B/C/D) is a TARA-KB organizational convention, not sourced from Hammerschlag et al. 2011 (the OCSI paper) or the CONSORT 2010 checklist. This category's members do, however, correspond closely to CONSORT's own Results and Discussion sections, distinguishing reported/executed trial content from the planned trial design and analysis content grouped under Category C."@en ;
                                       rdfs:label "Category D: Results & Discussion Metrics" ;
                                       skos:altLabel "Results_And_Discussion_Metrics" ;
                                       rdfs:subPropertyOf tara-kb:hasOCSIItemScoringMetadata ;
                                       rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasResultsOutcomesScore
tara-kb:hasResultsOutcomesScore rdf:type owl:AnnotationProperty ;
                                obo:IAO_0000112 """Standardized Scoring Rubric (0–3 Scale) 
Following the standardized OCSI Likert-like scoring structure, the reporting of results should be scored based on the level of statistical disclosure and data transparency:
- 3 (Full Compliance): The study provides exact data for all predefined outcomes (whether evaluating a single primary outcome or primary + secondary outcomes). This includes specific numbers/estimates, precision metrics (e.g., 95% Confidence Intervals), and exact p-values for each finding.
- 2 (Substantial Compliance): Results are provided for all main outcomes, but exact statistical precision reporting is slightly flawed (e.g., reporting a generic \"p < 0.05\" or omitting confidence intervals for a minor secondary outcome).
- 1 (Partial Compliance): The study omits data for a major outcome, or results are reported selectively/vaguely (e.g., stating in text that \"group differences were not significant\" without actually providing the underlying data table or values).
- 0 (Non-compliance): No empirical results or raw data are presented for the stated primary outcomes, or data reporting is missing entirely."""@en ,
                                                "e.g., a score of 2 when reported results directly correspond to the pre-registered outcome measures, or 0 when a mismatch or omission exists."@en ;
                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                dcterms:description "A quality metric within Category D: Results and Discussion Metrics that assesses the completeness, transparency, and accuracy of the reported results for each predefined primary and secondary outcome measure, evaluating whether the text explicitly provides estimated effect sizes, confidence intervals, and precise statistical significance values (e.g., p-values) for each endpoint."@en ;
                                tara-ap:hasAssessmentQuestion """For each primary and (if applicable) secondary outcome, is

(a) a summary of results presented for each group,

(b) the estimated effect size presented for each between-group difference (e.g., SD), and

(c) the precision of the effect size presented for each between-group difference (e.g., confidence interval (CI))?"""@en ;
                                tara-ap:hasCompactURI "tara-kb:hasResultsOutcomesScore" ;
                                tara-ap:hasOCSIItemNumber "22"^^tara-kb:ocsiItemNumber ;
                                tara-ap:hasScoringInstructions """(a) It must state the results or use a table/graph, for example, the mean and standard deviation of the measurements.

(b) All results must indicate the effect size, for example, the difference in means, odds ratio, or relative risk ratio.

(c) For full credit, authors must state precision as a confidence interval (CI). Only presenting P-values will score a partial."""@en ;
                                rdfs:comment """To maintain data integrity and prevent construct contamination within the metadata schema, ensure that the data extraction models treat the following two properties separately:
1. hasOutcomesMeasureX2Score (Methodology/Design Check): Focuses on the definition and planned pairing of tests. (e.g., Did they tell us in the Methods section how they planned to calculate the math?)
2. hasResultsOutcomesScore (Reporting/Transparency Check): Focuses on the execution and transparency of the actual data. (e.g., Did they actually show us the exact numbers, tables, effect sizes, and p-values in the Results section?)"""@en ;
                                rdfs:label "Results Outcomes Score" ;
                                skos:altLabel "Results_Outcomes_Score" ;
                                rdfs:subPropertyOf tara-kb:hasResultsAndDiscussionMetrics ;
                                rdfs:range tara-kb:ocsiItemScore ;
                                rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasSampleSizeDetails
tara-kb:hasSampleSizeDetails rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "e.g., \"n=84 (42 in intervention, 42 in control)\"."@en ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description "For the final number of participants who completed the study and were analyzed."@en ;
                             tara-ap:hasCompactURI "tara-kb:hasSampleSizeDetails" ;
                             rdfs:comment "For the final number of participants who completed the study and were analyzed (e.g., \"n=84 (42 in intervention, 42 in control)\")." ;
                             rdfs:label "Sample Size Details" ;
                             skos:altLabel "Sample_Size_Details" ;
                             rdfs:subPropertyOf dcterms:description ,
                                                tara-kb:hasStudyDesignMetadata ;
                             rdfs:range xsd:string ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasSampleSizeScore
tara-kb:hasSampleSizeScore rdf:type owl:AnnotationProperty ;
                           obo:IAO_0000112 "e.g., a score of 2 when a formal sample-size/power calculation is described, or 0 when no justification for the sample size is given."@en ;
                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "Category C: Study Design and Analysis Metrics. The sub-score assessing whether the rationale or calculation used to determine the study's sample size is explicitly reported."@en ;
                           tara-ap:hasAssessmentQuestion """(a) Is there a statement regarding how the sample size was determined, and

(b) if applicable, an explanation of any interim analyses and stopping rules?"""@en ;
                           tara-ap:hasCompactURI "tara-kb:hasSampleSizeScore" ;
                           tara-ap:hasOCSIItemNumber "12"^^tara-kb:ocsiItemNumber ;
                           tara-ap:hasScoringInstructions """(a) It must include statements regarding estimated effect size of the intervention based on previous research and estimated attrition rate. If the study was a pilot, a statement such as No data exists upon which to base a sample size calculation must be included.

(b) Interim analysis and stopping rules pertains to long-term trials and may not be applicable to trials of shorter duration."""@en ;
                           rdfs:label "Sample Size Score" ;
                           skos:altLabel "Sample_Size_Score" ;
                           rdfs:subPropertyOf tara-kb:hasStudyDesignAndAnalysisMetrics ;
                           rdfs:range tara-kb:ocsiItemScore ;
                           rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasSecondaryOutcomeMeasure
tara-kb:hasSecondaryOutcomeMeasure rdf:type owl:AnnotationProperty ;
                                   obo:IAO_0000112 "\"Number of migraine days, visual analogue scale (VAS) for pain, physical and mental component summary scores of the 36-item short-form health survey (SF-36), change in migraine days, number of patients with acute medication, adverse events (AE)\""@en ;
                                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                   dcterms:description "Any additional, non-primary endpoint(s) measured to support or contextualize the primary outcome, together with its measurement instrument or method."@en ;
                                   tara-ap:hasCompactURI "tara-kb:hasSecondaryOutcomeMeasure" ;
                                   rdfs:label "Secondary Outcome Measure" ;
                                   skos:altLabel "Secondary_Outcome_Measure" ;
                                   rdfs:subPropertyOf dcterms:description ,
                                                      tara-kb:hasStudyOutcomesMeasure ;
                                   rdfs:range xsd:string ;
                                   rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasSequenceGenerationScore
tara-kb:hasSequenceGenerationScore rdf:type owl:AnnotationProperty ;
                                   obo:IAO_0000112 "e.g., a score of 2 when the method used to generate the random allocation sequence, and any restrictions, are described, or 0 when neither is reported."@en ;
                                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                   dcterms:description "Category C: Study Design and Analysis Metrics. The sub-score assessing whether the method used to generate the random allocation sequence, and any restrictions (e.g., blocking, stratification), are described." ;
                                   tara-ap:hasAssessmentQuestion """(a) Is the method presented that was used to generate the random allocation sequence, and

(b) if applicable, details of any restriction (e.g., blocking, stratification)?"""@en ;
                                   tara-ap:hasCompactURI "tara-kb:hasSequenceGenerationScore" ;
                                   tara-ap:hasOCSIItemNumber "13"^^tara-kb:ocsiItemNumber ;
                                   tara-ap:hasScoringInstructions """(a) Sufficient and specific information must be provided regarding the methods utilized to generate the random allocation scheme, for example, a computer-generated table. Simply stating that patients were randomly assigned is not sufficient.

(b) If randomization restrictions were utilized, for example, stratification or blocking, the methods and details must be stated."""@en ;
                                   rdfs:label "Sequence Generation Score" ;
                                   skos:altLabel "Sequence_Generation_Score" ;
                                   rdfs:subPropertyOf tara-kb:hasRandomAllocationScore ;
                                   rdfs:range tara-kb:ocsiItemScore ;
                                   rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasShamAcupunctureDetails
tara-kb:hasShamAcupunctureDetails rdf:type owl:AnnotationProperty ;
                                  obo:IAO_0000112 "\"Non-penetrating Streitberger placebo needle applied at non-acupoint sites.\""@en ,
                                                  "\"Sham protocol details: Superficial insertion (maximum 3 mm depth) of up to six needles on either side of the upper arm, both thighs, and below both scapulae at areas where no TCM acupuncture points are known; same number and type of needles used as verum; no manual stimulation.\"" ;
                                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                  dcterms:description "The specific details reported for the sham or control acupuncture intervention used for comparison, describing the device and procedure used to simulate real needling."@en ;
                                  tara-ap:hasCompactURI "tara-kb:hasShamAcupunctureDetails" ;
                                  tara-ap:hasSynonym "Control Intervention Details" ;
                                  rdfs:label "Sham Acupuncture Details" ;
                                  skos:altLabel "Sham_Acupuncture_Details" ;
                                  rdfs:subPropertyOf dcterms:description ,
                                                     tara-kb:hasAcupunctureProtocol ;
                                  rdfs:range xsd:string ;
                                  rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStatisticalMethodsScore
tara-kb:hasStatisticalMethodsScore rdf:type owl:AnnotationProperty ;
                                   obo:IAO_0000112 "e.g., a score of 2 when statistical methods are stated for both primary and additional analyses, or 0 when neither is reported."@en ;
                                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                   dcterms:description "Category C: Study Design and Analysis Metrics. The sub-score assessing whether the statistical methods used to compare groups for primary outcomes, and for any additional analyses, are stated." ;
                                   tara-ap:hasAssessmentQuestion """(a) Were the statistical methods stated that were used to compare groups for primary outcomes?

(b) Were the statistical methods stated that were used for additional analyses such as subgroup or adjusted analyses?"""@en ;
                                   tara-ap:hasCompactURI "tara-kb:hasStatisticalMethodsScore" ;
                                   tara-ap:hasOCSIItemNumber "17"^^tara-kb:ocsiItemNumber ;
                                   tara-ap:hasScoringInstructions """(a) It must specifically state the statistical methods used to compare groups for primary outcomes.

(b) If additional analyses were performed, the specific statistical methods used must be reported for full credit."""@en ;
                                   rdfs:label "Statistical Methods Score" ;
                                   skos:altLabel "Statistical_Methods_Score" ;
                                   rdfs:subPropertyOf tara-kb:hasOutcomesMeasureX2Score ;
                                   rdfs:range tara-kb:ocsiItemScore ;
                                   rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStimulationTypeDetails
tara-kb:hasStimulationTypeDetails rdf:type owl:AnnotationProperty ;
                                  obo:IAO_0000112 "\"Manual stimulation applied to achieve De Qi; no electrical stimulation or moxibustion.\"" ,
                                                  "e.g., \"Manual manipulation to elicit de qi\" or \"Electroacupuncture at 2/100 Hz, 1-3 mA for 20 minutes.\"."@en ;
                                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                  dcterms:description "The type and parameters of stimulation applied to the inserted needles, such as manual manipulation or electroacupuncture settings."@en ;
                                  tara-ap:hasCompactURI "tara-kb:hasStimulationTypeDetails" ;
                                  rdfs:label "Stimulation Type Details" ;
                                  skos:altLabel "Stimulation_Type_Details" ;
                                  rdfs:subPropertyOf dcterms:description ,
                                                     tara-kb:hasAcupunctureProtocol ;
                                  rdfs:range xsd:string ;
                                  rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudiedCondition
tara-kb:hasStudiedCondition rdf:type owl:AnnotationProperty ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "A grouping annotation property that organizes the raw and mapped disease/condition sub-properties for both TCM and Western medicine perspectives on the condition studied by the trial."@en ;
                            dcterms:type tara-kb:grouping ;
                            tara-ap:hasCompactURI "tara-kb:hasStudiedCondition" ;
                            rdfs:label "Studied Condition" ;
                            skos:altLabel "Studied_Condition" ;
                            rdfs:subPropertyOf tara-kb:hasAcupunctureStudyMetadata ;
                            rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudiedTCMCondition
tara-kb:hasStudiedTCMCondition rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 "e.g., \"Qi and Blood Stagnation\" or \"Kidney Yang Deficiency\"."@en ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "A dual-purpose annotation property that captures the raw, as-reported Traditional Chinese Medicine (TCM) condition or pattern-differentiation label from the article, while also serving as a super-property for its mapped, standardized counterpart (hasMappedTCMCondition)."@en ;
                               tara-ap:hasCompactURI "tara-kb:hasStudiedTCMCondition" ;
                               rdfs:label "Studied Condition (TCM)" ;
                               skos:altLabel "Studied_TCM_Condition" ;
                               rdfs:subPropertyOf dcterms:description ,
                                                  tara-kb:hasStudiedCondition ;
                               rdfs:range xsd:string ;
                               rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudiedWesternCondition
tara-kb:hasStudiedWesternCondition rdf:type owl:AnnotationProperty ;
                                   obo:IAO_0000112 "e.g., \"Chronic Low Back Pain\" or \"Migraine without Aura\"."@en ;
                                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                   dcterms:description "A dual-purpose annotation property that captures the raw, as-reported Western/biomedical condition label from the article, while also serving as a super-property for its mapped, standardized counterpart (hasMappedWesternCondition)."@en ;
                                   tara-ap:hasCompactURI "tara-kb:hasStudiedWesternCondition" ;
                                   rdfs:label "Studied Condition (Western)" ;
                                   skos:altLabel "Studied_Western_Condition" ;
                                   rdfs:subPropertyOf dcterms:description ,
                                                      tara-kb:hasStudiedCondition ;
                                   rdfs:range xsd:string ;
                                   rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyConclusions
tara-kb:hasStudyConclusions rdf:type owl:AnnotationProperty ;
                            obo:IAO_0000112 """e.g., \"Weak evidence was found of an effect of acupuncture on persistent non-specific low back pain at 12 months, but stronger evidence of a small benefit at 24 months. Referral to a qualified traditional acupuncturist for a short course of treatment seems safe and acceptable to patients with low back pain.\" 

The example above captures the \"Clinical Conclusions\" for the study 'Randomised controlled trial of a short course of traditional acupuncture compared with usual care for persistent non-specific low back pain'; Article DOI:https://doi.org/10.1136/bmj.38878.907361.7C"""@en ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "Captures a faithful summary of what the article reports as clinical conclusions, potentially including short direct quotations where appropriate."@en ;
                            tara-ap:hasCompactURI "tara-kb:hasStudyConclusions" ;
                            rdfs:comment """This field must not augment inferred \"Yes/No\" effectiveness statements.
Instead, the field should faithfully summarize what the paper reports as a clinical conclusion, potentially including short direct quotations where appropriate."""@en ;
                            rdfs:label "Study Conclusions" ;
                            skos:altLabel "Study_Conclusions" ;
                            rdfs:subPropertyOf dcterms:description ,
                                               tara-kb:hasStudyFindings ;
                            rdfs:range xsd:string ;
                            rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyDesignAndAnalysisMetrics
tara-kb:hasStudyDesignAndAnalysisMetrics rdf:type owl:AnnotationProperty ;
                                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                         dcterms:description "This is a TARA-KB convention of categorization: Category C, Study Design and Analysis Metrics, groups the OCSI items describing how a trial was planned and how its analysis was designed -- outcome measure definitions (item 11), sample size determination (item 12), random allocation sequence generation and concealment (items 13-14), allocation personnel (item 15), blinding (item 16), and statistical methods (item 17)."@en ;
                                         dcterms:type tara-kb:grouping ;
                                         tara-ap:hasCompactURI "tara-kb:hasStudyDesignAndAnalysisMetrics" ;
                                         tara-ap:hasSynonym "Trial Methodology and Analysis Planning Metrics" ;
                                         rdfs:comment "This four-way category scheme (A/B/C/D) is a TARA-KB organizational convention, not sourced from Hammerschlag et al. 2011 (the OCSI paper) or the CONSORT 2010 checklist. This category's members do, however, correspond closely to CONSORT's own Methods section (Outcomes, Sample size, Randomisation, Blinding, Statistical methods), distinguishing planned trial design and analysis content from the reported/executed content grouped under Category D."@en ;
                                         rdfs:label "Category C: Study Design & Analysis Metrics" ;
                                         skos:altLabel "Study_Design_And_Analysis_Metrics" ;
                                         rdfs:subPropertyOf tara-kb:hasOCSIItemScoringMetadata ;
                                         rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyDesignMetadata
tara-kb:hasStudyDesignMetadata rdf:type owl:AnnotationProperty ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "A grouping annotation property that organizes the sub-properties describing the study's design, comparator groups, sample retention, and treatment schedule."@en ;
                               dcterms:type tara-kb:grouping ;
                               tara-ap:hasCompactURI "tara-kb:hasStudyDesignMetadata" ;
                               rdfs:label "Study Design Metadata" ;
                               skos:altLabel "Study_Design_Metadata" ;
                               rdfs:subPropertyOf tara-kb:hasAcupunctureStudyMetadata ;
                               rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyEffectiveness
tara-kb:hasStudyEffectiveness rdf:type owl:AnnotationProperty ;
                              obo:IAO_0000112 """Example 1: \"Yes - acupuncture significantly reduced the duration of the active phase of labor and the need for oxytocin infusion compared to the control group.\"

Example 2: \"No - the primary outcome of reduction in migraine days did not differ significantly across the verum acupuncture, sham acupuncture, and standard therapy groups.\"

Example 2 above captures the inferred effectiveness detail based on the results and conclusions of the study 'Efficacy of acupuncture for the prophylaxis of migraine: a multicentre randomised controlled clinical trial'; PubMed link: https://pubmed.ncbi.nlm.nih.gov/16545747"""@en ;
                              dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                              dcterms:description """Captures the final overall takeaway regarding the effectiveness of the treatment compared to the control group. It should be a focused statement on whether and how effective the studied intervention was, with clearly defined inference based solely on the information already extracted as Study Findings including Main Results and Clinical Conclusions or Comparative narrative. For example:
* Yes - A concise explanation of why the intervention was considered effective.
* No – A concise explanation of why the intervention was not considered effective.
* Inconclusive – A concise explanation of why the evidence is insufficient, mixed, or does not support a definitive conclusion."""@en ;
                              tara-ap:hasCompactURI "tara-kb:hasStudyEffectiveness" ;
                              rdfs:label "Study Effectiveness" ;
                              skos:altLabel "Study_Effectiveness" ;
                              rdfs:subPropertyOf tara-kb:hasStudyFindings ;
                              rdfs:range xsd:string ;
                              rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyFindings
tara-kb:hasStudyFindings rdf:type owl:AnnotationProperty ;
                         obo:IAO_0000112 """\"Main Results: The primary outcome showed a mean reduction of 2·3 days (95% CI 1·9–2·7) in the verum acupuncture group, 1·5 days (1·1–2·0) in the sham acupuncture group, and 2·1 days (1·5–2·7) in the standard therapy group. These differences were statistically significant compared with baseline (p<0·0001), but not across the treatment groups (p=0·09).

Clinical Conclusions: Treatment outcomes for migraine do not differ between patients treated with sham acupuncture, verum acupuncture, or standard therapy.\"

The example above captures the study findings based on the results and conclusions from the study 'Efficacy of acupuncture for the prophylaxis of migraine: a multicentre randomised controlled clinical trial'; PubMed link: https://pubmed.ncbi.nlm.nih.gov/16545747"""@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description """A dual-purpose annotation property that serves as a super-property grouping the interpreted findings sub-properties (clinical conclusions, comparative findings, effectiveness, main results, and proposed mechanism), while simultaneously acting as a direct container for a general free-text stuctured summary of the study's findings when a more specific sub-property does not apply.

This field should faithfully summarize what the paper reports as main results (the core numeric and statistical information of the primary and secondary endpoints) and clinical conclusions in a structured way, potentially including short direct quotations where appropriate."""@en ;
                         tara-ap:hasCompactURI "tara-kb:hasStudyFindings" ;
                         tara-ap:hasSynonym "Study Outcomes" ;
                         rdfs:comment "In systematic reviews and clinical trial metadata, \"Findings\" or \"Conclusions\" are explicitly separated from raw outcome measures because they capture the interpreted results, statistical significance, and final takeaways of the research." ;
                         rdfs:label "Study Findings" ;
                         skos:altLabel "Study_Findings" ;
                         rdfs:subPropertyOf tara-kb:hasAcupunctureStudyMetadata ;
                         rdfs:range xsd:string ;
                         rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyID
tara-kb:hasStudyID rdf:type owl:AnnotationProperty ;
                   dcterms:description "The Compact URI (CURIE) ID of a Research Study in TARA Articles KB." ;
                   tara-ap:hasCompactURI "tara-kb:hasStudyID" ;
                   rdfs:label "Has Study ID" ;
                   skos:altLabel "Study_ID" ;
                   rdfs:subPropertyOf dcterms:identifier ;
                   rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_7008377> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyLocation
tara-kb:hasStudyLocation rdf:type owl:AnnotationProperty ;
                         obo:IAO_0000112 "e.g., \"Seoul National University Hospital, Seoul, South Korea\"."@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "A dual-purpose annotation property that captures the general, as-reported location or site(s) where the trial was conducted, while also serving as a super-property for the normalized hasCountryOfStudy."@en ;
                         tara-ap:hasCompactURI "tara-kb:hasStudyLocation" ;
                         rdfs:label "Study Location" ;
                         skos:altLabel "Study_Location" ;
                         rdfs:subPropertyOf dcterms:relation ,
                                            tara-kb:hasAcupunctureStudyMetadata ;
                         rdfs:range xsd:string ;
                         rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyOutcomesMeasure
tara-kb:hasStudyOutcomesMeasure rdf:type owl:AnnotationProperty ;
                                obo:IAO_0000112 """e.g., \"Primary outcome measure: Proportion of responders (defined as the proportion of patients with a reduction of migraine days by at least 50%).

Secondary outcome measures: Number of migraine days, visual analogue scale (VAS) for pain, physical and mental component summary scores of the 36-item short-form health survey (SF-36), change in migraine days, number of patients with acute medication, adverse events (AE).\""""@en ;
                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                dcterms:description """A dual-purpose annotation property that serves as a super-property grouping the primary and secondary outcome measure sub-properties, while simultaneously acting as a direct container for structured oucome measures as \"Primary Outcome Measure\" and/or \"Secondary Outcome Measure\". 

This property can also be used to capture the general outcome measure for the studies where primary/secondary distinction is not reported or not applicable."""@en ;
                                tara-ap:hasCompactURI "tara-kb:hasStudyOutcomesMeasure" ;
                                rdfs:label "Study Outcomes Measure" ;
                                skos:altLabel "Study_Outcomes_Measure" ;
                                rdfs:subPropertyOf dcterms:description ,
                                                   tara-kb:hasStudyDesignMetadata ;
                                rdfs:range xsd:string ;
                                rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyQualityAssessmentMetadata
tara-kb:hasStudyQualityAssessmentMetadata rdf:type owl:AnnotationProperty ;
                                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                          dcterms:description """An annotation property that serves as a high-level grouping property under which specific quality appraisal properties are defined to record evaluative quality data, risk-of-bias scores, and methodological rigor metrics calculated for a clinical trial study.

Crucially, the values asserted by the sub-properties under this property are not raw data elements directly extracted or verbatim copied from the published journal article. Instead, they represent secondary, derived appraisals generated, either algorithmically by automated computational models or manually by human domain experts, by evaluating an extracted set of primary metadata against standardized scoring frameworks and quality assessment criteria (such as OCSI)."""@en ;
                                          dcterms:type tara-kb:grouping ;
                                          tara-ap:hasCompactURI "tara-kb:hasStudyQualityAssessmentMetadata" ;
                                          rdfs:label "Study Assessment Metadata"@en ;
                                          skos:altLabel "Study_Assessment_Metadata"@en ;
                                          rdfs:subPropertyOf tara-kb:hasTARAArticlesMetadata ;
                                          rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_7227329> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyRationaleAndScopeMetrics
tara-kb:hasStudyRationaleAndScopeMetrics rdf:type owl:AnnotationProperty ;
                                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                         dcterms:description "This is a TARA-KB convention of categorization: Category A, Study Rationale and Scope Metrics, groups the OCSI items that establish why a trial was undertaken and what it covers before its methods and results are reported -- scientific background and rationale (item 2) and the stated objectives and hypothesis (item 10) address the rationale; eligibility criteria and study setting (item 3) define the trial's population and location scope. The randomization statement (item 1) is grouped here as a scope-defining fact in a different sense -- it discloses what kind of trial this is (randomized) rather than its population or setting -- rather than as a strict domain match; see rdfs:comment for further explanation of this placement."@en ;
                                         dcterms:type tara-kb:grouping ;
                                         tara-ap:hasCompactURI "tara-kb:hasStudyRationaleAndScopeMetrics" ;
                                         tara-ap:hasSynonym "Study Foundation and Background Metrics" ,
                                                            "Trial Framing and Background Metrics" ;
                                         rdfs:comment "This four-way category scheme (A/B/C/D) is a TARA-KB organizational convention, not sourced from Hammerschlag et al. 2011 (the OCSI paper), the CONSORT 2010 checklist, or the STRICTA 2010 checklist. Both CONSORT and STRICTA organize their own checklist items by manuscript section (Title/Abstract, Introduction, Methods, Results, Discussion) or by protocol-description topic, not by a four-category thematic taxonomy of this kind. This grouping exists for KB navigation and LLM-prompt structuring, not as a claim about the instrument's own domain structure. Note on item 1 (hasRandomizationStatementScore): 'scope' is used in two distinct senses across this category's members -- for item 3, scope means population and setting boundaries; for item 1, scope means the trial's design-type disclosure (that it is randomized). This is an intentional, documented stretch of the label rather than an oversight."@en ;
                                         rdfs:label "Category A: Study Rationale & Scope Metrics" ;
                                         skos:altLabel "Study_Rationale_And_Scope_Metrics" ;
                                         rdfs:subPropertyOf tara-kb:hasOCSIItemScoringMetadata ;
                                         rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyResults
tara-kb:hasStudyResults rdf:type owl:AnnotationProperty ;
                        obo:IAO_0000112 """e.g., \"At 12 months average SF-36 pain scores increased by 33.2 to 64.0 in the acupuncture group and by 27.9 to 58.3 in the control group. Adjusting for baseline score and for any clustering by acupuncturist, the estimated intervention effect was 5.6 points (95% confidence interval − 0.2 to 11.4) at 12 months (n = 213) and 8.0 points (2.8 to 13.2) at 24 months (n = 182).\"

The example above captures the \"Main Results\" from the study 'Randomised controlled trial of a short course of traditional acupuncture compared with usual care for persistent non-specific low back pain'. Article DOI:https://doi.org/10.1136/bmj.38878.907361.7C"""@en ;
                        dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                        dcterms:description "Captures the main results of the clinical trial containing numeric and statistical information of the primary and secondary endpoints."@en ;
                        tara-ap:hasCompactURI "tara-kb:hasStudyResults" ;
                        rdfs:label "Study Results" ;
                        skos:altLabel "Study_Results" ;
                        rdfs:subPropertyOf dcterms:description ,
                                           tara-kb:hasStudyFindings ;
                        rdfs:range xsd:string ;
                        rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyType
tara-kb:hasStudyType rdf:type owl:AnnotationProperty ;
                     obo:IAO_0000112 "e.g., \"Randomized Controlled Trial\", \"Crossover Trial\", \"Meta analysis\", \"Systematic Review\"."@en ;
                     dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                     dcterms:description "An annotation property that serves as a direct container for the high-level study type categorization (e.g., \"Randomized Controlled Trial\", \"Crossover Trial\", \"Meta Analysis\", \"Systemetic Review\" )."@en ;
                     tara-ap:hasCompactURI "tara-kb:hasStudyType" ;
                     rdfs:label "Study Design Category" ;
                     skos:altLabel "Study_Type" ;
                     rdfs:subPropertyOf dcterms:type ,
                                        tara-kb:hasStudyDesignMetadata ;
                     rdfs:range xsd:string ;
                     rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasSubgroupScore
tara-kb:hasSubgroupScore rdf:type owl:AnnotationProperty ;
                         obo:IAO_0000112 "e.g., a score of 2 when pre-specified or post-hoc subgroup analyses are clearly reported, or 0 when no subgroup analysis is mentioned."@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "Category D: Results and Discussion Metrics. The structural score grading the transparency and tracking of post-hoc stratifications or secondary data analyses." ;
                         tara-ap:hasAssessmentQuestion "If additional subgroup analyses and/or adjusted analyses are reported, is it stated whether they were prespecified or exploratory, that is, not prespecified?"@en ;
                         tara-ap:hasCompactURI "tara-kb:hasSubgroupScore" ;
                         tara-ap:hasOCSIItemNumber "23"^^tara-kb:ocsiItemNumber ;
                         tara-ap:hasScoringInstructions "If additional analyses are prespecified in the research design, the results must be presented, and it must be clearly stated whether or not these were exploratory (e.g., post hoc) analyses."@en ;
                         rdfs:label "Subgroup Score" ;
                         skos:altLabel "Subgroup_Score" ;
                         rdfs:subPropertyOf tara-kb:hasResultsAndDiscussionMetrics ;
                         rdfs:range tara-kb:ocsiItemScore ;
                         rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasTARAArticlesMetadata
tara-kb:hasTARAArticlesMetadata rdf:type owl:AnnotationProperty ;
                                dcterms:description "A grouping annotation property to organize all metadata annotation properties specific to TARA articles knowledgebase." ;
                                dcterms:type tara-kb:grouping ;
                                tara-ap:hasCompactURI "tara-kb:hasTARAArticlesMetadata" ;
                                rdfs:label "TARA-KB: Articles Metadata" ;
                                skos:altLabel "TARA_KB_Articles_Metadata" .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasTreatmentDuration
tara-kb:hasTreatmentDuration rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "e.g., \"6 weeks\", \"12 sessions over 1 month\"."@en ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description "Captures the information about the total length of the therapy course."@en ;
                             tara-ap:hasCompactURI "tara-kb:hasTreatmentDuration" ;
                             rdfs:comment "For the total length of the therapy course (e.g., \"6 weeks\", \"12 sessions over 1 month\")." ;
                             rdfs:label "Treatment Duration" ;
                             skos:altLabel "Treatment_Duration" ;
                             rdfs:subPropertyOf dcterms:description ,
                                                tara-kb:hasTreatmentDurationAndFrequency ;
                             rdfs:range xsd:string ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasTreatmentDurationAndFrequency
tara-kb:hasTreatmentDurationAndFrequency rdf:type owl:AnnotationProperty ;
                                         obo:IAO_0000112 "e.g., \"12 sessions over 6 weeks, administered 2 times per week.\"."@en ;
                                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                         dcterms:description "A dual-purpose annotation property that serves as a super-property grouping hasTreatmentDuration and hasTreatmentFrequency, while simultaneously acting as a direct container for a combined free-text statement of the treatment's duration and frequency."@en ;
                                         tara-ap:hasCompactURI "tara-kb:hasTreatmentDurationAndFrequency" ;
                                         rdfs:label "Treatment Duration and Frequency" ;
                                         skos:altLabel "Treatment_Duration_And_Frequency" ;
                                         rdfs:subPropertyOf tara-kb:hasStudyDesignMetadata ;
                                         rdfs:range xsd:string ;
                                         rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasTreatmentFrequency
tara-kb:hasTreatmentFrequency rdf:type owl:AnnotationProperty ;
                              obo:IAO_0000112 "e.g., \"3 times per week\", \"Every other day\"."@en ;
                              dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                              dcterms:description "Captures the information about how often the intervention was administered."@en ;
                              tara-ap:hasCompactURI "tara-kb:hasTreatmentFrequency" ;
                              rdfs:comment "For how often the intervention was administered (e.g., \"3 times per week\", \"Every other day\")." ;
                              rdfs:label "Treatment Frequency" ;
                              skos:altLabel "Treatment_Frequency" ;
                              rdfs:subPropertyOf dcterms:description ,
                                                 tara-kb:hasTreatmentDurationAndFrequency ;
                              rdfs:range xsd:string ;
                              rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#seeAlso
rdfs:seeAlso rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#deprecated
owl:deprecated rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty ;
              rdfs:subPropertyOf tara-ap:skosAnntotationProperty .


###  http://www.w3.org/2004/02/skos/core#hiddenLabel
skos:hiddenLabel rdf:type owl:AnnotationProperty ;
                 rdfs:subPropertyOf tara-ap:skosAnntotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.acupunctureresearch.org/tara/ontology/kb/articleSectionType
tara-kb:articleSectionType rdf:type rdfs:Datatype ;
                           dcterms:description "An enumerated custom datatype that restricts allowed values to standard structural sections of a scientific or academic article (e.g., Abstract, Introduction, Methods, Results, Discussion, Conclusion, References, Tables, Figures). It is intended for use with annotation properties to categorize the specific structural context of text fragments or article components without requiring an OWL class structure."@en ;
                           rdfs:label "Article Section"@en ;
                           owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                                 owl:oneOf [ rdf:type rdf:List ;
                                                             rdf:first "Abstract" ;
                                                             rdf:rest [ rdf:type rdf:List ;
                                                                        rdf:first "Conclusion" ;
                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                   rdf:first "Discussion" ;
                                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                                              rdf:first "Figures" ;
                                                                                              rdf:rest [ rdf:type rdf:List ;
                                                                                                         rdf:first "Introduction" ;
                                                                                                         rdf:rest [ rdf:type rdf:List ;
                                                                                                                    rdf:first "Methods" ;
                                                                                                                    rdf:rest [ rdf:type rdf:List ;
                                                                                                                               rdf:first "References" ;
                                                                                                                               rdf:rest [ rdf:type rdf:List ;
                                                                                                                                          rdf:first "Results" ;
                                                                                                                                          rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                     rdf:first "Tables" ;
                                                                                                                                                     rdf:rest [ rdf:type rdf:List ;
                                                                                                                                                                rdf:first "Title" ;
                                                                                                                                                                rdf:rest rdf:nil
                                                                                                                                                              ]
                                                                                                                                                   ]
                                                                                                                                        ]
                                                                                                                             ]
                                                                                                                  ]
                                                                                                       ]
                                                                                            ]
                                                                                 ]
                                                                      ]
                                                           ]
                                               ] .


###  http://www.acupunctureresearch.org/tara/ontology/kb/nonNegShortInt
tara-kb:nonNegShortInt rdf:type rdfs:Datatype ;
                       rdfs:comment "To represent individual score for each OCSI Score Category between 0 and 10."@en ;
                       rdfs:label "nonNegShortInt" ;
                       skos:altLabel "nonNegativeShortInterger" ;
                       owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                             owl:onDatatype xsd:integer ;
                                             owl:withRestrictions ( [ xsd:minInclusive 0
                                                                    ]
                                                                    [ xsd:maxInclusive 10
                                                                    ]
                                                                  )
                                           ] .


###  http://www.acupunctureresearch.org/tara/ontology/kb/ocsiItemNumber
tara-kb:ocsiItemNumber rdf:type rdfs:Datatype ;
                       rdfs:comment "The standard item number (1-27) in the Oregon CONSORT STRICTA Instrument (OCSI)."@en ;
                       rdfs:label "ocsiItemNumber" ;
                       owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                             owl:onDatatype xsd:short ;
                                             owl:withRestrictions ( [ xsd:minInclusive "1"^^xsd:short
                                                                    ]
                                                                    [ xsd:maxInclusive "27"^^xsd:short
                                                                    ]
                                                                  )
                                           ] .


###  http://www.acupunctureresearch.org/tara/ontology/kb/ocsiItemScore
tara-kb:ocsiItemScore rdf:type rdfs:Datatype ;
                      rdfs:comment "The valid per-item OCSI score: 0 (no), 1 (partial), 2 (yes), or the string 'N/A' when the item does not apply. Per Hammerschlag et al. 2011, each of the 27 OCSI questions is scored yes = 2, partial = 1, no = 0, or Not Applicable = N/A."@en ;
                      rdfs:label "ocsiItemScore" ;
                      owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                            owl:unionOf ( [ rdf:type rdfs:Datatype ;
                                                            owl:oneOf [ rdf:type rdf:List ;
                                                                        rdf:first 0 ;
                                                                        rdf:rest [ rdf:type rdf:List ;
                                                                                   rdf:first 1 ;
                                                                                   rdf:rest [ rdf:type rdf:List ;
                                                                                              rdf:first 2 ;
                                                                                              rdf:rest rdf:nil
                                                                                            ]
                                                                                 ]
                                                                      ]
                                                          ]
                                                          [ rdf:type rdfs:Datatype ;
                                                            owl:oneOf [ rdf:type rdf:List ;
                                                                        rdf:first "N/A" ;
                                                                        rdf:rest rdf:nil
                                                                      ]
                                                          ]
                                                        )
                                          ] .


###  http://www.acupunctureresearch.org/tara/ontology/kb/ocsiItemScoreRequired
tara-kb:ocsiItemScoreRequired rdf:type rdfs:Datatype ;
                              rdfs:comment "The valid per-item OCSI score for items that cannot be scored N/A: 0 (no), 1 (partial), or 2 (yes). Per Hammerschlag et al. 2011, item 24 (adverse events) is the sole exception to the general N/A allowance -- 'It cannot be scored as N/A.'"@en ;
                              rdfs:label "ocsiItemScoreRequired" ;
                              owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                                    owl:oneOf [ rdf:type rdf:List ;
                                                                rdf:first 0 ;
                                                                rdf:rest [ rdf:type rdf:List ;
                                                                           rdf:first 1 ;
                                                                           rdf:rest [ rdf:type rdf:List ;
                                                                                      rdf:first 2 ;
                                                                                      rdf:rest rdf:nil
                                                                                    ]
                                                                         ]
                                                              ]
                                                  ] .


###  http://www.acupunctureresearch.org/tara/ontology/kb/percentFloat
tara-kb:percentFloat rdf:type rdfs:Datatype ;
                     rdfs:comment "To represent the total OCSI Score percentage between 0.0 to 100.0."@en ;
                     owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                           owl:onDatatype xsd:float ;
                                           owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float
                                                                  ]
                                                                  [ xsd:maxInclusive "100.0"^^xsd:float
                                                                  ]
                                                                )
                                         ] .


###  http://www.acupunctureresearch.org/tara/ontology/kb/propertyType
tara-kb:propertyType rdf:type rdfs:Datatype ;
                     dcterms:description "The type of the annotation or object property to restrict its use as grouping, value holding, grouping and value-holding. Grouping indicates that the property serves as an organizational super property of its sub-properties."@en ;
                     rdfs:label "Property Type"@en ;
                     owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                           owl:oneOf [ rdf:type rdf:List ;
                                                       rdf:first "Grouping" ;
                                                       rdf:rest [ rdf:type rdf:List ;
                                                                  rdf:first "Grouping or Value-Holding" ;
                                                                  rdf:rest [ rdf:type rdf:List ;
                                                                             rdf:first "Value-Holding" ;
                                                                             rdf:rest rdf:nil
                                                                           ]
                                                                ]
                                                     ]
                                         ] .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON
rdf:JSON rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/UBERON_0001062
obo:UBERON_0001062 rdf:type owl:Class ;
                   rdfs:label "Anatomical Entity"@en ,
                              "anatomical entity" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_1132428
<http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> rdf:type owl:Class ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                rdfs:label "Acupuncture Point"@en .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_1244992
<http://www.acupunctureresearch.org/tara/ontology/TARA_1244992> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3448356> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A specialized subclass of 'Disease or Condition' representing health impairments conceptualized, diagnosed, and classified according to conventional Western biomedical science. This class categorizes illnesses based on localized structural, cellular, or molecular pathology, objective biomolecular testing, and specific etiologies (such as infectious, genetic, or metabolic agents), focusing primarily on measurable physiological mechanisms."@en ;
                                                                rdfs:label "Disease or Condition (Western)" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_2825659
<http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_9542913> ;
                                                                dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011;2011:183910. https://doi.org/10.1155/2011/183910" ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "An acupuncture study quality assessment data item that captures, organizes, and structures the specific multi-item compliance metrics and qualitative evaluation scores defined by the Oregon CONSORT STRICTA Instrument (OCSI) for assessing the reporting quality of acupuncture clinical trials."@en ;
                                                                rdfs:label "Acupuncture Study OCSI Assessment" ;
                                                                skos:altLabel "Acupuncture_Study_OCSI_Assessment" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_2894731
<http://www.acupunctureresearch.org/tara/ontology/TARA_2894731> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A specialized subclass of 'Acupuncture Study Publication' representing a peer-reviewed paper published within a periodic scientific journal. This class specifically designates formalized, citable academic literature that has undergone rigorous editorial evaluation, differentiating it from broader publication types by its structural alignment with journal metadata standardizations and its role in official scholarly records."@en ;
                                                                rdfs:label "Acupuncture Study Journal Article" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_3448356
<http://www.acupunctureresearch.org/tara/ontology/TARA_3448356> rdf:type owl:Class ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A broad ontology class representing any pathological process, abnormal state, or disruption of normal bodily structure or function manifested by a specific set of symptoms or signs. Within this ontology, it serves as the top-level concept for health impairments, encompassing both holistic pattern-based syndromic classifications and localized, etiology-driven physiological disorders without bias toward a specific medical paradigm."@en ;
                                                                rdfs:label "Disease or Condition" ;
                                                                skos:altLabel "Disease_Or_Condition" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_3677977
<http://www.acupunctureresearch.org/tara/ontology/TARA_3677977> rdf:type owl:Class ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "An abstract ontology class representing any formal written, digital, or multimedia artifact that documents, describes, or reports on a research study. Unlike the active, physical execution of a research study represented by the 'Research Study' class, this class encompasses the static conceptual and intellectual outputs, such as journal articles, books, conference proceedings, or preprints, created to communicate methodologies, data, and conclusions to the scientific community." ;
                                                                rdfs:label "Research Study Publication" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_6701896
<http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_7008377> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A specialized study process wherein the primary intervention under investigation involves acupuncture therapeutics, including needle insertion, point selection logic, needle manipulation methods, and stimulation protocols (manual, electrical, or thermal). It encompasses the physical trial execution from participant recruitment and baseline grouping through the active administration of real or sham acupuncture procedures up to final endpoint evaluation."@en ;
                                                                tara-ap:hasSynonym "Acupuncture Study" ;
                                                                rdfs:label "Acupuncture Research Study"@en ;
                                                                skos:altLabel "Acupuncture_Research_Study" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_6703917
<http://www.acupunctureresearch.org/tara/ontology/TARA_6703917> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3448356> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A specialized subclass of 'Disease or Condition' representing health impairments conceptualized, diagnosed, and classified according to the principles of Traditional Chinese Medicine. This class categorizes illnesses based on holistic disharmony, encompassing visceral organ patterns (Zang-Fu), channel theories, and pathogenic factors (e.g., Wind, Dampness), where the focus is on the body's overall functional pattern (Zheng) rather than isolated anatomical lesions."@en ;
                                                                rdfs:label "Disease or Condition (TCM)" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_7008377
<http://www.acupunctureresearch.org/tara/ontology/TARA_7008377> rdf:type owl:Class ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A planned acupuncture research process consisting of a coordinated group of research activities, methodological designs, and data-gathering evaluations aimed at systematically investigating a scientific hypothesis or clinical question. Within TARA Ontology, it represents the operational and temporal execution of the research project itself in the physical world, functioning as a distinct entity from the written publication artifacts (represented by the 'Research Study Publication' class) that report on its findings." ;
                                                                rdfs:label "Research Study" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_7227329
<http://www.acupunctureresearch.org/tara/ontology/TARA_7227329> rdf:type owl:Class ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A data item consisting of a structured collection of metrics, scores, or evaluations generated during a systematic process to assess the methodological rigor, risk of bias, validity, or reporting completeness of a scientific study or clinical trial." ;
                                                                rdfs:label "Research Study Quality Assessment" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_8223728
<http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3677977> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A specialized subclass of 'Research Study Publication' representing any formal written, digital, or multimedia artifact that documents, describes, or reports on an acupuncture research study. Unlike the active, physical execution of an acupuncture research study represented by the 'Acupuncture Research Study' class, this class encompasses the static conceptual and intellectual outputs, such as journal articles, books, conference proceedings, or preprints, created to communicate methodologies, data, and conclusions to the scientific community."@en ;
                                                                rdfs:label "Acupuncture Study Publication" ;
                                                                skos:altLabel "Acupuncture_Research_Study_Publication" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_9542913
<http://www.acupunctureresearch.org/tara/ontology/TARA_9542913> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_7227329> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
