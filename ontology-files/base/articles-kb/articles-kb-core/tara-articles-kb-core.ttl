                                  rdfs:subPropertyOf tara-kb:hasStudiedWesternCondition ;
                                  rdfs:range tara:TARA_1244992 ;
                                  rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasMethodologicalAndStatisticalAllocationMetrics
tara-kb:hasMethodologicalAndStatisticalAllocationMetrics rdf:type owl:AnnotationProperty ;
                                                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                         dcterms:description "Category C: Methodological & Statistical Allocation Metrics (CONSORT). Grouping property for trial management and statistical parameters." ;
                                                         tara:hasCompactURI "tara-kb:hasMethodologicalAndStatisticalAllocationMetrics" ;
