tara-kb:hasStudiedTCMCondition rdf:type owl:AnnotationProperty ;
                               <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"Qi and Blood Stagnation\" or \"Kidney Yang Deficiency\"."@en ;
