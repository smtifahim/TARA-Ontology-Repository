###  http://www.acupunctureresearch.org/tara/ontology/kb/hasProposedMechanism
tara-kb:hasProposedMechanism rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "e.g., \"Both PRF and EA therapies are related to electricity effects, but PRF has better electrical penetration due to its higher frequency pulse.\"."@en ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description "Captures the authors' theoretical or physiological explanations for why the treatments worked or differed."@en ;
                             tara-ap:hasCompactURI "tara-kb:hasProposedMechanism" ;
                             tara-kb:hasStudyMetadataExtractionPrompt """{
  \"field\": \"Proposed_Mechanism\",
  \"description\": \"Captures the authors' theoretical or physiological explanations for why the treatments worked or differed.\"
}"""^^rdf:JSON ;
                             rdfs:comment "Captures the authors' theoretical or physiological explanations for why the treatments worked or differed. Example: \"Both PRF and EA therapies are related to electricity effects, but PRF has better electrical penetration due to its higher frequency pulse.\"" ;
                             rdfs:label "Proposed Mechanism" ;
                             skos:altLabel "Proposed_Mechanism" ;
                             rdfs:subPropertyOf dcterms:description ,
                                                tara-kb:hasStudyFindings ;
                             rdfs:range xsd:string ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


