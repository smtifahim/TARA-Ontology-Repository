                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "Category B: Technical Intervention Quality Metrics (STRICTA). The sub-score assessing whether the rationale or calculation used to determine the study's sample size is explicitly reported."@en ;
                           tara:hasCompactURI "tara-kb:hasSampleSizeScore" ;
                           rdfs:label "Sample Size Score" ;
                           skos:prefLabel "Sample_Size_Score" ;
