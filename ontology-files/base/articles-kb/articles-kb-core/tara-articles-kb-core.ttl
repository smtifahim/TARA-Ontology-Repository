                               tara:hasCompactURI "tara-kb:hasStudiedTCMCondition" ;
                               rdfs:label "Studied Condition (TCM)" ;
                               skos:prefLabel "Studied_TCM_Condition" ;
                               rdfs:subPropertyOf dcterms:description ,
                                                  tara-kb:hasStudiedCondition ;
                               rdfs:range xsd:string ;
                               rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudiedWesternCondition
tara-kb:hasStudiedWesternCondition rdf:type owl:AnnotationProperty ;
                                   <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"Chronic Low Back Pain\" or \"Migraine without Aura\"."@en ;
                                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                   dcterms:description "A dual-purpose annotation property that captures the raw, as-reported Western/biomedical condition label from the article, while also serving as a super-property for its mapped, standardized counterpart (hasMappedWesternCondition)."@en ;
                                   tara:hasCompactURI "tara-kb:hasStudiedWesternCondition" ;
                                   rdfs:label "Studied Condition (Western)" ;
                                   skos:prefLabel "Studied_Western_Condition" ;
                                   rdfs:subPropertyOf dcterms:description ,
                                                      tara-kb:hasStudiedCondition ;
                                   rdfs:range xsd:string ;
                                   rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyConclusions
tara-kb:hasStudyConclusions rdf:type owl:AnnotationProperty ;
                            <http://purl.obolibrary.org/obo/IAO_0000112> """e.g., \"Weak evidence was found of an effect of acupuncture on persistent non-specific low back pain at 12 months, but stronger evidence of a small benefit at 24 months. Referral to a qualified traditional acupuncturist for a short course of treatment seems safe and acceptable to patients with low back pain.\" 

The example above captures the \"Clinical Conclusions\" for the study 'Randomised controlled trial of a short course of traditional acupuncture compared with usual care for persistent non-specific low back pain'; Article DOI:https://doi.org/10.1136/bmj.38878.907361.7C"""@en ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "Captures a faithful summary of what the article reports as clinical conclusions, potentially including short direct quotations where appropriate."@en ;
                            tara:hasCompactURI "tara-kb:hasStudyConclusions" ;
                            rdfs:comment """This field must not augment inferred \"Yes/No\" effectiveness statements.
Instead, the field should faithfully summarize what the paper reports as a clinical conclusion, potentially including short direct quotations where appropriate."""@en ;
                            rdfs:label "Study Conclusions" ;
                            skos:prefLabel "Study_Conclusions" ;
                            rdfs:subPropertyOf dcterms:description ,
                                               tara-kb:hasStudyFindings ;
                            rdfs:range xsd:string ;
                            rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyDesignMetadata
tara-kb:hasStudyDesignMetadata rdf:type owl:AnnotationProperty ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "A grouping annotation property that organizes the sub-properties describing the study's design, comparator groups, sample retention, and treatment schedule."@en ;
                               tara:hasCompactURI "tara-kb:hasStudyDesignMetadata" ;
                               rdfs:label "Study Design Metadata" ;
                               skos:prefLabel "Study_Design_Metadata" ;
                               rdfs:subPropertyOf tara-kb:hasStudyMetadata ;
                               rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyEffectiveness
tara-kb:hasStudyEffectiveness rdf:type owl:AnnotationProperty ;
                              <http://purl.obolibrary.org/obo/IAO_0000112> """Example 1: \"Yes - acupuncture significantly reduced the duration of the active phase of labor and the need for oxytocin infusion compared to the control group.\"

Example 2: \"No - the primary outcome of reduction in migraine days did not differ significantly across the verum acupuncture, sham acupuncture, and standard therapy groups.\"

Example 2 above captures the inferred effectiveness detail based on the results and conclusions of the study 'Efficacy of acupuncture for the prophylaxis of migraine: a multicentre randomised controlled clinical trial'; PubMed link: https://pubmed.ncbi.nlm.nih.gov/16545747"""@en ;
                              dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                              dcterms:description """Captures the final overall takeaway regarding the effectiveness of the treatment compared to the control group. It should be a focused statement on whether and how effective the studied intervention was, with clearly defined inference based solely on the information already extracted as Study Findings including Main Results and Clinical Conclusions or Comparative narrative. For example:
* Yes - A concise explanation of why the intervention was considered effective.
* No – A concise explanation of why the intervention was not considered effective.
* Inconclusive – A concise explanation of why the evidence is insufficient, mixed, or does not support a definitive conclusion."""@en ;
                              tara:hasCompactURI "tara-kb:hasStudyEffectiveness" ;
                              rdfs:label "Study Effectiveness" ;
                              skos:prefLabel "Study_Effectiveness" ;
                              rdfs:subPropertyOf tara-kb:hasStudyFindings ;
                              rdfs:range xsd:string ;
                              rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyFindings
tara-kb:hasStudyFindings rdf:type owl:AnnotationProperty ;
                         <http://purl.obolibrary.org/obo/IAO_0000112> """\"Main Results: The primary outcome showed a mean reduction of 2·3 days (95% CI 1·9–2·7) in the verum acupuncture group, 1·5 days (1·1–2·0) in the sham acupuncture group, and 2·1 days (1·5–2·7) in the standard therapy group. These differences were statistically significant compared with baseline (p<0·0001), but not across the treatment groups (p=0·09).

Clinical Conclusions: Treatment outcomes for migraine do not differ between patients treated with sham acupuncture, verum acupuncture, or standard therapy.\"

The example above captures the study findings based on the results and conclusions from the study 'Efficacy of acupuncture for the prophylaxis of migraine: a multicentre randomised controlled clinical trial'; PubMed link: https://pubmed.ncbi.nlm.nih.gov/16545747"""@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description """A dual-purpose annotation property that serves as a super-property grouping the interpreted findings sub-properties (clinical conclusions, comparative findings, effectiveness, main results, and proposed mechanism), while simultaneously acting as a direct container for a general free-text stuctured summary of the study's findings when a more specific sub-property does not apply.

This field should faithfully summarize what the paper reports as main results (the core numeric and statistical information of the primary and secondary endpoints) and clinical conclusions in a structured way, potentially including short direct quotations where appropriate."""@en ;
                         tara:hasCompactURI "tara-kb:hasStudyFindings" ;
                         tara:hasSynonym "Study Outcomes" ;
                         rdfs:comment "In systematic reviews and clinical trial metadata, \"Findings\" or \"Conclusions\" are explicitly separated from raw outcome measures because they capture the interpreted results, statistical significance, and final takeaways of the research." ;
                         rdfs:label "Study Findings" ;
                         skos:prefLabel "Study_Findings" ;
                         rdfs:subPropertyOf tara-kb:hasStudyMetadata ;
                         rdfs:range xsd:string ;
                         rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyFoundationAndBackgroundMetrics
tara-kb:hasStudyFoundationAndBackgroundMetrics rdf:type owl:AnnotationProperty ;
                                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                               dcterms:description "Category A: Study Foundation & Background Metrics (CONSORT). Grouping property for foundational framework and scoping layout metrics." ;
                                               tara:hasCompactURI "tara-kb:hasStudyFoundationAndBackgroundMetrics" ;
                                               rdfs:label "Study Foundation and Background Metrics" ;
                                               skos:prefLabel "Study_Foundation_And_Background_Metrics" ;
                                               rdfs:subPropertyOf tara-kb:hasOCSIScoreMetadata ;
                                               rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyLocation
tara-kb:hasStudyLocation rdf:type owl:AnnotationProperty ;
                         <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"Seoul National University Hospital, Seoul, South Korea\"."@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "A dual-purpose annotation property that captures the general, as-reported location or site(s) where the trial was conducted, while also serving as a super-property for the normalized hasCountryOfStudy."@en ;
                         tara:hasCompactURI "tara-kb:hasStudyLocation" ;
                         rdfs:label "Study Location" ;
                         skos:prefLabel "Study_Location" ;
                         rdfs:subPropertyOf dcterms:relation ,
                                            tara-kb:hasStudyMetadata ;
                         rdfs:range xsd:string ;
                         rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyMetadata
tara-kb:hasStudyMetadata rdf:type owl:AnnotationProperty ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "A grouping annotation property that organizes the operational, methodological, and outcome-related metadata describing the acupuncture research study itself (as opposed to its reporting publication)."@en ;
                         tara:hasCompactURI "tara-kb:hasStudyMetadata" ;
                         rdfs:label "Study Metadata" ;
                         skos:prefLabel "Study_Metadata" ;
                         rdfs:subPropertyOf tara-kb:hasExtractedArticleMetadata ;
                         rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyOutcomesMeasure
tara-kb:hasStudyOutcomesMeasure rdf:type owl:AnnotationProperty ;
                                <http://purl.obolibrary.org/obo/IAO_0000112> """e.g., \"Primary outcome measure: Proportion of responders (defined as the proportion of patients with a reduction of migraine days by at least 50%).

Secondary outcome measures: Number of migraine days, visual analogue scale (VAS) for pain, physical and mental component summary scores of the 36-item short-form health survey (SF-36), change in migraine days, number of patients with acute medication, adverse events (AE).\""""@en ;
                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                dcterms:description """A dual-purpose annotation property that serves as a super-property grouping the primary and secondary outcome measure sub-properties, while simultaneously acting as a direct container for structured oucome measures as \"Primary Outcome Measure\" and/or \"Secondary Outcome Measure\". 

This property can also be used to capture the general outcome measure for the studies where primary/secondary distinction is not reported or not applicable."""@en ;
                                tara:hasCompactURI "tara-kb:hasStudyOutcomesMeasure" ;
                                rdfs:label "Study Outcomes Measure" ;
                                skos:prefLabel "Study_Outcomes_Measure" ;
                                rdfs:subPropertyOf dcterms:description ,
                                                   tara-kb:hasStudyMetadata ;
                                rdfs:range xsd:string ;
                                rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyQualityAppraisalMetadata
tara-kb:hasStudyQualityAppraisalMetadata rdf:type owl:AnnotationProperty ;
                                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                         dcterms:description "An annotation property that serves as a high-level grouping property under which specific quality appraisal properties are defined to record evaluative quality data, risk-of-bias scores, and methodological rigor metrics calculated for a clinical trial study."@en ;
                                         tara:hasCompactURI "tara-kb:hasStudyAppraisalMetadata" ;
                                         rdfs:comment "Crucially, the values asserted by the sub-properties under this property are not raw data elements directly extracted or verbatim copied from the published journal article. Instead, they represent secondary, derived appraisals generated, either algorithmically by automated computational models or manually by human domain experts, by evaluating an extracted set of primary metadata against standardized scoring frameworks and quality assessment criteria (such as OCSI)." ;
                                         rdfs:label "Study Appraisal Metadata"@en ;
                                         skos:prefLabel "Study_Appraisal_Metadata"@en ;
                                         rdfs:subPropertyOf tara-kb:hasTARAArticlesMetadata ;
                                         rdfs:domain tara:TARA_7227329 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyResults
tara-kb:hasStudyResults rdf:type owl:AnnotationProperty ;
                        <http://purl.obolibrary.org/obo/IAO_0000112> """e.g., \"At 12 months average SF-36 pain scores increased by 33.2 to 64.0 in the acupuncture group and by 27.9 to 58.3 in the control group. Adjusting for baseline score and for any clustering by acupuncturist, the estimated intervention effect was 5.6 points (95% confidence interval − 0.2 to 11.4) at 12 months (n = 213) and 8.0 points (2.8 to 13.2) at 24 months (n = 182).\"

The example above captures the \"Main Results\" from the study 'Randomised controlled trial of a short course of traditional acupuncture compared with usual care for persistent non-specific low back pain'. Article DOI:https://doi.org/10.1136/bmj.38878.907361.7C"""@en ;
                        dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                        dcterms:description "Captures the main results of the clinical trial containing numeric and statistical information of the primary and secondary endpoints."@en ;
                        tara:hasCompactURI "tara-kb:hasStudyResults" ;
                        rdfs:label "Study Results" ;
                        skos:prefLabel "Study_Results" ;
                        rdfs:subPropertyOf dcterms:description ,
                                           tara-kb:hasStudyFindings ;
                        rdfs:range xsd:string ;
                        rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasStudyType
tara-kb:hasStudyType rdf:type owl:AnnotationProperty ;
                     <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"Randomized Controlled Trial\", \"Crossover Trial\", \"Meta analysis\", \"Systematic Review\"."@en ;
                     dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                     dcterms:description "A dual-purpose annotation property that serves as a super-property for the more granular hasClinicalTrialType, while simultaneously acting as a direct container for the high-level study type categorization."@en ;
                     tara:hasCompactURI "tara-kb:hasStudyType" ;
                     rdfs:comment "For the high-level study type categorization (e.g., \"Randomized Controlled Trial\", \"Crossover Trial\", \"Meta analysis\", \"Systemetic Review\" )." ;
                     rdfs:label "Study Type" ;
                     skos:prefLabel "Study_Type" ;
                     rdfs:subPropertyOf dcterms:type ,
                                        tara-kb:hasStudyDesignMetadata ;
                     rdfs:range xsd:string ;
                     rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasSubgroupScore
tara-kb:hasSubgroupScore rdf:type owl:AnnotationProperty ;
                         <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., a score of 2 when pre-specified or post-hoc subgroup analyses are clearly reported, or 0 when no subgroup analysis is mentioned."@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "Category C: Methodological & Statistical Allocation Metrics (CONSORT). The structural score grading the transparency and tracking of post-hoc stratifications or secondary data analyses." ;
                         tara:hasCompactURI "tara-kb:hasSubgroupScore" ;
                         rdfs:label "Subgroup Score" ;
                         skos:prefLabel "Subgroup_Score" ;
                         rdfs:subPropertyOf tara-kb:hasMethodologicalAndStatisticalAllocationMetrics ;
                         rdfs:range tara:TARA_5972061 ;
                         rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasTARAArticlesMetadata
tara-kb:hasTARAArticlesMetadata rdf:type owl:AnnotationProperty ;
                                dcterms:description "An annotation property grouping annotation properties specific to TARA-extracted articles metadata." ;
                                tara:hasCompactURI "tara-kb:hasTARAArticlesMetadata" ;
                                rdfs:label "TARA-KB: Articles Metadata" ;
                                skos:prefLabel "TARA_KB_Articles_Metadata" .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasTechnicalInterventionQualityMetrics
tara-kb:hasTechnicalInterventionQualityMetrics rdf:type owl:AnnotationProperty ;
                                               <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., an aggregate value of 14 summarizing the combined STRICTA-aligned sub-scores (acupuncture details, needling parameters, stimulation, sham details, control groups, co-interventions, practitioner and sample size)."@en ;
                                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                               dcterms:description "Category B: Technical Intervention Quality Metrics (STRICTA). Grouping property for acupuncture needle parameters and clinical protocol parameters." ;
                                               tara:hasCompactURI "tara-kb:hasTechnicalInterventionQualityMetrics" ;
                                               rdfs:label "Technical Intervention Quality Metrics" ;
                                               skos:prefLabel "Technical_Intervention_Quality_Metrics" ;
                                               rdfs:subPropertyOf tara-kb:hasOCSIScoreMetadata ;
                                               rdfs:range tara:TARA_5972061 ;
                                               rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasTreatmentDuration
tara-kb:hasTreatmentDuration rdf:type owl:AnnotationProperty ;
                             <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"6 weeks\", \"12 sessions over 1 month\"."@en ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description "Captures the information about the total length of the therapy course."@en ;
                             tara:hasCompactURI "tara-kb:hasTreatmentDuration" ;
                             rdfs:comment "For the total length of the therapy course (e.g., \"6 weeks\", \"12 sessions over 1 month\")." ;
                             rdfs:label "Treatment Duration" ;
                             skos:prefLabel "Treatment_Duration" ;
                             rdfs:subPropertyOf dcterms:description ,
                                                tara-kb:hasTreatmentDurationAndFrequency ;
                             rdfs:range xsd:string ;
                             rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasTreatmentDurationAndFrequency
tara-kb:hasTreatmentDurationAndFrequency rdf:type owl:AnnotationProperty ;
                                         <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"12 sessions over 6 weeks, administered 2 times per week.\"."@en ;
                                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                         dcterms:description "A dual-purpose annotation property that serves as a super-property grouping hasTreatmentDuration and hasTreatmentFrequency, while simultaneously acting as a direct container for a combined free-text statement of the treatment's duration and frequency."@en ;
                                         tara:hasCompactURI "tara-kb:hasTreatmentDurationAndFrequency" ;
                                         rdfs:label "Treatment Duration and Frequency" ;
                                         skos:prefLabel "Treatment_Duration_And_Frequency" ;
                                         rdfs:subPropertyOf tara-kb:hasStudyDesignMetadata ;
                                         rdfs:range xsd:string ;
                                         rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasTreatmentFrequency
tara-kb:hasTreatmentFrequency rdf:type owl:AnnotationProperty ;
                              <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"3 times per week\", \"Every other day\"."@en ;
                              dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                              dcterms:description "Captures the information about how often the intervention was administered."@en ;
                              tara:hasCompactURI "tara-kb:hasTreatmentFrequency" ;
                              rdfs:comment "For how often the intervention was administered (e.g., \"3 times per week\", \"Every other day\")." ;
                              rdfs:label "Treatment Frequency" ;
                              skos:prefLabel "Treatment_Frequency" ;
                              rdfs:subPropertyOf dcterms:description ,
                                                 tara-kb:hasTreatmentDurationAndFrequency ;
                              rdfs:range xsd:string ;
                              rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasUnmappableAcupoint
tara-kb:hasUnmappableAcupoint rdf:type owl:AnnotationProperty ;
                              <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., \"Ashi point\" or \"Motor point (non-standard)\" - extracted text with no corresponding TARA acupoint IRI."@en ;
                              dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                              dcterms:description "A specialized tracking annotation property used to isolate and store individual literal text strings or non-standard acupoints extracted from a publication that could not be successfully resolved to a standard TARA ontology IRI."@en ;
                              tara:hasCompactURI "tara-kb:hasUnmappableAcupoint" ;
                              rdfs:label "Unmappable Acupoint(s)" ;
                              skos:prefLabel "Unmappable_Acupoint" ;
                              rdfs:subPropertyOf tara-kb:hasListedAcupoint ;
                              rdfs:range xsd:string ;
                              rdfs:domain tara:TARA_6701896 .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#seeAlso
rdfs:seeAlso rdf:type owl:AnnotationProperty ;
             rdfs:label "seeAlso" .


###  http://www.w3.org/2002/07/owl#deprecated
owl:deprecated rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#hiddenLabel
skos:hiddenLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#narrowMatch
skos:narrowMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
skos:relatedMatch rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.acupunctureresearch.org/tara/ontology/TARA_5972061
tara:TARA_5972061 rdf:type rdfs:Datatype ;
                  rdfs:comment "To represent individual score for each OCSI Score Category between 0 and 10."@en ;
                  rdfs:label "nonNegShortInt" ;
                  skos:prefLabel "nonNegativeShortInterger" ;
                  owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                        owl:onDatatype xsd:integer ;
                                        owl:withRestrictions ( [ xsd:minInclusive 0
                                                               ]
                                                               [ xsd:maxInclusive 10
                                                               ]
                                                             )
                                      ] .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_6560239
tara:TARA_6560239 rdf:type rdfs:Datatype ;
                  rdfs:comment "To represent the total OCSI Score percentage between 0.0 to 100.0."@en ;
                  owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                        owl:onDatatype xsd:float ;
                                        owl:withRestrictions ( [ xsd:minInclusive "0.0"^^xsd:float
                                                               ]
                                                               [ xsd:maxInclusive "100.0"^^xsd:float
                                                               ]
                                                             )
                                      ] .


###  http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON
rdf:JSON rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/UBERON_0001062
<http://purl.obolibrary.org/obo/UBERON_0001062> rdf:type owl:Class ;
                                                rdfs:label "anatomical entity" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_1132428
tara:TARA_1132428 rdf:type owl:Class ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  rdfs:label "Acupuncture Point"@en .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_1244992
tara:TARA_1244992 rdf:type owl:Class ;
                  rdfs:subClassOf tara:TARA_3448356 ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "A specialized subclass of 'Disease or Condition' representing health impairments conceptualized, diagnosed, and classified according to conventional Western biomedical science. This class categorizes illnesses based on localized structural, cellular, or molecular pathology, objective biomolecular testing, and specific etiologies (such as infectious, genetic, or metabolic agents), focusing primarily on measurable physiological mechanisms."@en ;
                  rdfs:label "Disease or Condition (Western)" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_2825659
tara:TARA_2825659 rdf:type owl:Class ;
                  rdfs:subClassOf tara:TARA_9542913 ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "An acupuncture study quality appraisal data item that captures, organizes, and structures the specific multi-item compliance metrics and qualitative evaluation scores defined by the Oregon CONSORT STRICTA Instrument (OCSI) for assessing the reporting quality of acupuncture clinical trials." ;
                  rdfs:label "Acupuncture Study OCSI Appraisal" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_2894731
tara:TARA_2894731 rdf:type owl:Class ;
                  rdfs:subClassOf tara:TARA_8223728 ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "A specialized subclass of 'Acupuncture Study Publication' representing a peer-reviewed paper published within a periodic scientific journal. This class specifically designates formalized, citable academic literature that has undergone rigorous editorial evaluation, differentiating it from broader publication types by its structural alignment with journal metadata standardizations and its role in official scholarly records."@en ;
                  rdfs:label "Acupuncture Study Journal Article" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_3448356
tara:TARA_3448356 rdf:type owl:Class ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "A broad ontology class representing any pathological process, abnormal state, or disruption of normal bodily structure or function manifested by a specific set of symptoms or signs. Within this ontology, it serves as the top-level concept for health impairments, encompassing both holistic pattern-based syndromic classifications and localized, etiology-driven physiological disorders without bias toward a specific medical paradigm."@en ;
                  rdfs:label "Disease or Condition" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_3677977
tara:TARA_3677977 rdf:type owl:Class ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "An abstract ontology class representing any formal written, digital, or multimedia artifact that documents, describes, or reports on a research study. Unlike the active, physical execution of a research study represented by the 'Research Study' class, this class encompasses the static conceptual and intellectual outputs, such as journal articles, books, conference proceedings, or preprints, created to communicate methodologies, data, and conclusions to the scientific community." ;
                  rdfs:label "Research Study Publication" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_6701896
tara:TARA_6701896 rdf:type owl:Class ;
                  rdfs:subClassOf tara:TARA_7008377 ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "A specialized study process wherein the primary intervention under investigation involves acupuncture therapeutics, including needle insertion, point selection logic, needle manipulation methods, and stimulation protocols (manual, electrical, or thermal). It encompasses the physical trial execution from participant recruitment and baseline grouping through the active administration of real or sham acupuncture procedures up to final endpoint evaluation."@en ;
                  tara:hasSynonym "Acupuncture Study" ;
                  rdfs:label "Acupuncture Research Study"@en .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_6703917
tara:TARA_6703917 rdf:type owl:Class ;
                  rdfs:subClassOf tara:TARA_3448356 ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "A specialized subclass of 'Disease or Condition' representing health impairments conceptualized, diagnosed, and classified according to the principles of Traditional Chinese Medicine. This class categorizes illnesses based on holistic disharmony, encompassing visceral organ patterns (Zang-Fu), channel theories, and pathogenic factors (e.g., Wind, Dampness), where the focus is on the body's overall functional pattern (Zheng) rather than isolated anatomical lesions."@en ;
                  rdfs:label "Disease or Condition (TCM)" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_7008377
tara:TARA_7008377 rdf:type owl:Class ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "A planned acupuncture research process consisting of a coordinated group of research activities, methodological designs, and data-gathering evaluations aimed at systematically investigating a scientific hypothesis or clinical question. Within TARA Ontology, it represents the operational and temporal execution of the research project itself in the physical world, functioning as a distinct entity from the written publication artifacts (represented by the 'Research Study Publication' class) that report on its findings." ;
                  rdfs:label "Research Study" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_7227329
tara:TARA_7227329 rdf:type owl:Class ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "A data item consisting of a structured collection of metrics, scores, or evaluations generated during a systematic process to assess the methodological rigor, risk of bias, validity, or reporting completeness of a scientific study or clinical trial." ;
                  rdfs:label "Study Quality Appraisal" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_8223728
tara:TARA_8223728 rdf:type owl:Class ;
                  rdfs:subClassOf tara:TARA_3677977 ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "A specialized subclass of 'Research Study Publication' representing any formal written, digital, or multimedia artifact that documents, describes, or reports on an acupuncture research study. Unlike the active, physical execution of an acupuncture research study represented by the 'Acupuncture Research Study' class, this class encompasses the static conceptual and intellectual outputs, such as journal articles, books, conference proceedings, or preprints, created to communicate methodologies, data, and conclusions to the scientific community."@en ;
                  rdfs:label "Acupuncture Study Publication" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_9542913
tara:TARA_9542913 rdf:type owl:Class ;
                  rdfs:subClassOf tara:TARA_7227329 ;
                  dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                  dcterms:description "A study quality appraisal data item specifically designed or adapted to evaluate the methodological rigor and reporting completeness of clinical trials or systematic reviews evaluating acupuncture interventions, capturing specific operational variables unique to needle-based therapeutics." ;
                  rdfs:label "Acupuncture Study Qualty Appraisal" .


