###  http://purl.obolibrary.org/obo/UBERON_0001062
obo:UBERON_0001062 rdf:type owl:Class ;
                   rdfs:label "Anatomical Entity"@en ,
                              "anatomical entity" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_1132428
<http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> rdf:type owl:Class ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                rdfs:label "Acupuncture Point"@en .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_1244992
<http://www.acupunctureresearch.org/tara/ontology/TARA_1244992> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3448356> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A specialized subclass of 'Disease or Condition' representing health impairments conceptualized, diagnosed, and classified according to conventional Western biomedical science. This class categorizes illnesses based on localized structural, cellular, or molecular pathology, objective biomolecular testing, and specific etiologies (such as infectious, genetic, or metabolic agents), focusing primarily on measurable physiological mechanisms."@en ;
                                                                rdfs:label "Disease or Condition (Western)" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_2825659
<http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_9542913> ;
                                                                dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011;2011:183910. https://doi.org/10.1155/2011/183910" ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "An acupuncture study quality assessment data item that captures, organizes, and structures the specific multi-item compliance metrics and qualitative evaluation scores defined by the Oregon CONSORT STRICTA Instrument (OCSI) for assessing the reporting quality of acupuncture clinical trials."@en ;
                                                                rdfs:label "Acupuncture Study OCSI Assessment" ;
                                                                skos:altLabel "Acupuncture_Study_OCSI_Assessment" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_2894731
<http://www.acupunctureresearch.org/tara/ontology/TARA_2894731> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A specialized subclass of 'Acupuncture Study Publication' representing a peer-reviewed paper published within a periodic scientific journal. This class specifically designates formalized, citable academic literature that has undergone rigorous editorial evaluation, differentiating it from broader publication types by its structural alignment with journal metadata standardizations and its role in official scholarly records."@en ;
                                                                rdfs:label "Acupuncture Study Journal Article" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_3448356
<http://www.acupunctureresearch.org/tara/ontology/TARA_3448356> rdf:type owl:Class ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A broad ontology class representing any pathological process, abnormal state, or disruption of normal bodily structure or function manifested by a specific set of symptoms or signs. Within this ontology, it serves as the top-level concept for health impairments, encompassing both holistic pattern-based syndromic classifications and localized, etiology-driven physiological disorders without bias toward a specific medical paradigm."@en ;
                                                                rdfs:label "Disease or Condition" ;
                                                                skos:altLabel "Disease_Or_Condition" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_3677977
<http://www.acupunctureresearch.org/tara/ontology/TARA_3677977> rdf:type owl:Class ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "An abstract ontology class representing any formal written, digital, or multimedia artifact that documents, describes, or reports on a research study. Unlike the active, physical execution of a research study represented by the 'Research Study' class, this class encompasses the static conceptual and intellectual outputs, such as journal articles, books, conference proceedings, or preprints, created to communicate methodologies, data, and conclusions to the scientific community." ;
                                                                rdfs:label "Research Study Publication" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_6701896
<http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_7008377> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A specialized study process wherein the primary intervention under investigation involves acupuncture therapeutics, including needle insertion, point selection logic, needle manipulation methods, and stimulation protocols (manual, electrical, or thermal). It encompasses the physical trial execution from participant recruitment and baseline grouping through the active administration of real or sham acupuncture procedures up to final endpoint evaluation."@en ;
                                                                tara-ap:hasSynonym "Acupuncture Study" ;
                                                                rdfs:label "Acupuncture Research Study"@en ;
                                                                skos:altLabel "Acupuncture_Research_Study" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_6703917
<http://www.acupunctureresearch.org/tara/ontology/TARA_6703917> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3448356> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A specialized subclass of 'Disease or Condition' representing health impairments conceptualized, diagnosed, and classified according to the principles of Traditional Chinese Medicine. This class categorizes illnesses based on holistic disharmony, encompassing visceral organ patterns (Zang-Fu), channel theories, and pathogenic factors (e.g., Wind, Dampness), where the focus is on the body's overall functional pattern (Zheng) rather than isolated anatomical lesions."@en ;
                                                                rdfs:label "Disease or Condition (TCM)" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_7008377
<http://www.acupunctureresearch.org/tara/ontology/TARA_7008377> rdf:type owl:Class ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A planned acupuncture research process consisting of a coordinated group of research activities, methodological designs, and data-gathering evaluations aimed at systematically investigating a scientific hypothesis or clinical question. Within TARA Ontology, it represents the operational and temporal execution of the research project itself in the physical world, functioning as a distinct entity from the written publication artifacts (represented by the 'Research Study Publication' class) that report on its findings." ;
                                                                rdfs:label "Research Study" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_7227329
<http://www.acupunctureresearch.org/tara/ontology/TARA_7227329> rdf:type owl:Class ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A data item consisting of a structured collection of metrics, scores, or evaluations generated during a systematic process to assess the methodological rigor, risk of bias, validity, or reporting completeness of a scientific study or clinical trial." ;
                                                                rdfs:label "Research Study Quality Assessment" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_8223728
<http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_3677977> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A specialized subclass of 'Research Study Publication' representing any formal written, digital, or multimedia artifact that documents, describes, or reports on an acupuncture research study. Unlike the active, physical execution of an acupuncture research study represented by the 'Acupuncture Research Study' class, this class encompasses the static conceptual and intellectual outputs, such as journal articles, books, conference proceedings, or preprints, created to communicate methodologies, data, and conclusions to the scientific community."@en ;
                                                                rdfs:label "Acupuncture Study Publication" ;
                                                                skos:altLabel "Acupuncture_Research_Study_Publication" .


###  http://www.acupunctureresearch.org/tara/ontology/TARA_9542913
<http://www.acupunctureresearch.org/tara/ontology/TARA_9542913> rdf:type owl:Class ;
                                                                rdfs:subClassOf <http://www.acupunctureresearch.org/tara/ontology/TARA_7227329> ;
                                                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                                                dcterms:description "A study quality appraisal data item specifically designed or adapted to evaluate the methodological rigor and reporting completeness of clinical trials or systematic reviews evaluating acupuncture interventions, capturing specific operational variables unique to needle-based therapeutics." ;
                                                                rdfs:label "Acupuncture Study Qualty Assessment" ;
                                                                skos:altLabel "Acupuncture_Study_Qualty_Assessment" .


