###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupointGrouping
tara-kb:hasAcupointGrouping rdf:type owl:AnnotationProperty ;
                            obo:IAO_0000112 "\"Three pairs of acupuncture points on the right side: LI 4 and PC 6, ST 36 and SP 9, LR 3 and SP 6; PC 6 was located approximately 1 cm radial to the traditional point.\"" ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "An annotation property to capture acupoint grouping information, the structural combination, pairing, or categorization of multiple selected acupuncture points, including primary and secondary points, designed to work synergistically within a clinical trial treatment prescription." ;
                            tara-ap:hasCompactURI "tara-kb:hasAcupointGrouping" ;
                            rdfs:comment "Acupoint grouping is about organizing multiple points into a single treatment protocol, often divided into primary (core) points for the main condition and secondary (adjuvant) points for specific symptoms." ;
                            rdfs:label "Acupoint Grouping" ;
                            skos:altLabel "Acupoint_Grouping" ;
                            rdfs:subPropertyOf tara-kb:hasAcupointSelectionAndGrouping ;
                            rdfs:range xsd:string ;
                            rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupointSelection
tara-kb:hasAcupointSelection rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "\"Combination of scalp, body, and auricular acupuncture specific to the affected areas of the child and inclusive of both sides of the body.\"" ,
                                             "\"Trigger points in the gluteals isolated by palpation ensuring reproduction of symptoms, mostly in the region of the upper outer buttock quadrant, 3 to 5 points per subject.\"" ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description "An annotation property to capture specific choice of body sites (anatomical locations) targeted for acupuncture needle insertion within a clinical trial protocol." ;
                             tara-ap:hasCompactURI "tara-kb:hasAcupointSelection" ;
                             rdfs:comment "Acupoint selection is about deciding which exact body locations to target during an intervention, guided by traditional systems (like meridians and specific point attributes) or modern anatomical maps (like local trigger points or nerve distributions). Researchers standardize this to test if a specific set of points delivers reproducible health outcomes." ;
                             rdfs:label "Acupoint Selection" ;
                             skos:altLabel "Acupoint_Selection" ;
                             rdfs:subPropertyOf tara-kb:hasAcupointSelectionAndGrouping ;
                             rdfs:range xsd:string ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupointSelectionAndGrouping
tara-kb:hasAcupointSelectionAndGrouping rdf:type owl:AnnotationProperty ;
                                        obo:IAO_0000112 "\"Point selection and grouping: Verum points selected from a prescribed list (part standardisation) consisting of obligatory points and additional points individually chosen based on TCM diagnosis for syndromes, acupuncture channels related to the individual headache area, and Ah Shi points; needling was bilateral.\"" ;
                                        dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                        dcterms:description "A dual-purpose annotation property that serves as a super-property grouping 'Acupoint Selection' and 'Acupoint Grouping', while simultaneously acting as a direct container for a combined free-text statement about Acupoints Seclection and Grouping." ;
                                        tara-ap:hasCompactURI "tara-kb:hasAcupointSelectionAndGrouping" ;
                                        rdfs:comment "In clinical trials evaluating acupuncture, acupoint selection is the specific choice of body sites (the points) where needles are inserted based on traditional theory or modern neuroscience. Acupoint grouping (or combination) refers to how these points are paired together in a treatment prescription to work synergistically for a medical condition." ;
                                        rdfs:label "Point Selection and Grouping" ;
                                        skos:altLabel "Point_Selection_And_Grouping" ;
                                        rdfs:subPropertyOf tara-kb:hasAcupunctureProtocol ;
                                        rdfs:range xsd:string ;
                                        rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupunctureCointerventionsScore
tara-kb:hasAcupunctureCointerventionsScore rdf:type owl:AnnotationProperty ;
                                           dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011. https://doi.org/10.1155/2011/183910"@en ;
                                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                           dcterms:description """The reporting assessment score evaluating whether extra pharmaceutical drugs or parallel therapies are tracked or declared along with the intervention.

- The OCSI Item Number, Assessment Question(s) (reproduced from Table 1, Hammerschlag et al., 2011),  and Per Question Instructions(s) (reproduced from Appendix A.2, Hammerschlag et al., 2011) are reproduced under the CC-BY license, with attribution to the original authors. See the Bibliographic Citation section."""@en ;
                                           tara-ap:hasCompactURI "tara-kb:hasAcupunctureCointerventionsScore" ;
                                           tara-kb:hasOCSIAssessmentQuestions "Are details of the acupuncture group cointervention(s) presented? (e.g., moxa, cupping, life-style advice, plum-blossom needling, Chinese herbs)"@en ;
                                           tara-kb:hasOCSIItemNumber "7"^^tara-kb:ocsiItemNumber ;
                                           tara-kb:hasOCSIPerQuestionInstructions "It refers only to cointerventions within the scope of acupuncture licensure. If the protocol specifies the option of prescribed self-help treatments, for example, exercise advice, stretching, or qi gong, these must also be described. Scored N/A if no adjunctive treatment was provided to the acupuncture group."@en ;
                                           tara-kb:hasOCSIScoreExtractionPrompt """{
  \"item\": 7,
  \"question\": \"Are details of the acupuncture group cointervention(s) presented? (e.g., moxa, cupping, life-style advice, plum-blossom needling, Chinese herbs)\",
  \"criteria\": {
    \"yes\": \"details of the acupuncture group's cointervention(s) are presented (e.g., moxa, cupping, life-style advice, plum-blossom needling, Chinese herbs), including any prescribed self-help treatments.\",
    \"partial\": \"cointerventions are mentioned but not described in sufficient detail.\",
    \"no\": \"cointerventions are known or implied to have occurred but are not described at all.\",
    \"na\": \"N/A if no adjunctive treatment was provided to the acupuncture group.\"
  }
}"""^^rdf:JSON ;
                                           tara-kb:hasOCSIScoringRubric """- Score 2 (Yes): details of the acupuncture group's cointervention(s) are presented (e.g., moxa, cupping, life-style advice, plum-blossom needling, Chinese herbs), including any prescribed self-help treatments.

- Score 1 (Partial): cointerventions are mentioned but not described in sufficient detail.

- Score 0 (No): cointerventions are known or implied to have occurred but are not described at all.

- N/A if no adjunctive treatment was provided to the acupuncture group."""@en ;
                                           tara-kb:hasTypicalArticleSection "Methods"^^tara-kb:articleSectionType ;
                                           rdfs:label "(7) Acupuncture Group Cointervention(s)" ;
                                           skos:altLabel "7_Acupuncture_Group_Cointerventions" ;
                                           rdfs:subPropertyOf tara-kb:hasAcupunctureInterventionMetrics ;
                                           rdfs:range tara-kb:ocsiItemScore ;
                                           rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupunctureInterventionMetrics
tara-kb:hasAcupunctureInterventionMetrics rdf:type owl:AnnotationProperty ;
                                          dcterms:bibliographicCitation """MacPherson H, Altman DG, Hammerschlag R, Youping L, Taixiang W, White A, Moher D; STRICTA Revision Group. Revised STandards for Reporting Interventions in Clinical Trials of Acupuncture (STRICTA): extending the CONSORT statement. PLoS Med. 2010;7(6):e1000261. doi:10.1371/journal.pmed.1000261. https://doi.org/10.1371/journal.pmed.1000261

Note: The article is concurrently published in Acupuncture in Medicine 2010;28(2):83-93, doi:10.1136/aim.2009.001370, and Journal of Alternative and Complementary Medicine 2010;16(10):ST-1-14."""@en ;
                                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                          dcterms:description """Category B, Acupuncture Intervention Metrics, groups OCSI items 4 through 9, which report on the acupuncture intervention itself and correspond one-to-one, in order, to the six official STRICTA 2010 checklist items: (1) Acupuncture rationale, (2) Details of needling, (3) Treatment regimen, (4) Other components of treatment, (5) Practitioner background, (6) Control or comparator interventions. Hammerschlag et al. 2011 state these six items substitute for CONSORT's own item 4.

The OCSI items included under this category include:
- Item 4: Acupuncture Style & Acupoints Selection Score
- Item 5: Acupuncture Needling Parameters
- Item 6: Treatments Duration and Frequency
- Item 7: Acupuncture Group Cointervention(s)
- Item 8: Practitioner Training and Expertise 
- Item 9: Control Groups Intervention"""@en ;
                                          dcterms:type tara-kb:grouping ;
                                          tara-ap:hasCompactURI "tara-kb:hasAcupunctureInterventionMetrics" ;
                                          rdfs:comment "The umbrella label 'Acupuncture Intervention Metrics' and its place in this ontology's four-category scheme (A/B/C/D) are a TARA-KB convention, not STRICTA's own terminology. This category's item membership (OCSI items 4-9), however, is directly traceable to STRICTA (MacPherson et al. 2010), with an exact one-to-one, in-order correspondence to STRICTA's six official checklist items."@en ;
                                          rdfs:label "Category B: Acupuncture Intervention Metrics" ;
                                          skos:altLabel "Category_B_Acupuncture_Intervention_Metrics" ;
                                          rdfs:subPropertyOf tara-kb:hasOCSIItemScoringMetadata ;
                                          rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupunctureNeedlingParametersScore
tara-kb:hasAcupunctureNeedlingParametersScore rdf:type owl:AnnotationProperty ;
                                              dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011. https://doi.org/10.1155/2011/183910"@en ;
                                              dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                              dcterms:description """The technical STRICTRA-aligned item score checking the completeness of needle parameters reported (e.g., gauge, depth, de qi sensation).

- The OCSI Item Number, Assessment Question(s) (reproduced from Table 1, Hammerschlag et al., 2011),  and Per Question Instructions(s) (reproduced from Appendix A.2, Hammerschlag et al., 2011) are reproduced under the CC-BY license, with attribution to the original authors. See the Bibliographic Citation section."""@en ;
                                              tara-ap:hasCompactURI "tara-kb:hasAcupunctureNeedlingParametersScore" ;
                                              tara-kb:hasOCSIAssessmentQuestions """Are the following parameters of needling presented?

(a) Points used (uni/bilateral)

(b) Number of needles inserted

(c) Depth(s) of insertion

(d) Response elicited (e.g., de qi)

(e) Needle stimulation (manual or electrical)

(f) Needle retention time

(g) Needle type (Material and/or manufacturer, gauge, and length)"""@en ;
                                              tara-kb:hasOCSIItemNumber "5"^^tara-kb:ocsiItemNumber ;
                                              tara-kb:hasOCSIPerQuestionInstructions """(a) Unilateral or bilateral can be implied.

(b) If the treatment protocol is individualized, then the authors must state the range of needles utilized (e.g., 8-14 needles). This may be implied from (a).

(c) If the treatments were individualized, the depths must be given as a range, expressed in Cun, mm, or anatomical depth.

(d) Response refers to needle sensations such as de qi (TCM), muscle twitch (trigger point), or muscle contraction (electroacupuncture).

(e) Stimulation refers to techniques in manual acupuncture (lifting, thrusting, or rotating) or electroacupuncture (current, frequency, amplitude).

(f) If treatments were individualized, retention time must be reported as a mean and range.

(g) It must state the gauge, length, and material and/or manufacturer of the needles."""@en ;
                                              tara-kb:hasOCSIScoreExtractionPrompt """{
  \"item\": 5,
  \"question\": \"Are the following parameters of needling presented? (a) Points used (uni/bilateral) (b) Number of needles inserted (c) Depth(s) of insertion (d) Response elicited (e.g., de qi) (e) Needle stimulation (manual or electrical) (f) Needle retention time (g) Needle type (Material and/or manufacturer, gauge, and length)\",
  \"parts\": {
    \"a\": \"points used (uni/bilateral) are stated\",
    \"b\": \"number of needles inserted is stated\",
    \"c\": \"depth(s) of insertion is stated\",
    \"d\": \"response elicited (e.g., de qi) is stated\",
    \"e\": \"needle stimulation (manual or electrical) is stated\",
    \"f\": \"needle retention time is stated\",
    \"g\": \"needle type (material and/or manufacturer, gauge, and length) is stated\"
  }
}"""^^rdf:JSON ;
                                              tara-kb:hasOCSIScoringRubric """Applicable sub-parts:

(a) points used (uni/bilateral) are stated;

(b) number of needles inserted is stated;

(c) depth(s) of insertion is stated;

(d) response elicited (e.g., de qi) is stated;

(e) needle stimulation (manual or electrical) is stated;

(f) needle retention time is stated;

(g) needle type (material and/or manufacturer, gauge, and length) is stated.

N = 7 when all 7 are applicable.

Combination rule (N = applicable sub-parts among a-g):

- All N met -> Score 2 (Yes).

- 0 of N met -> Score 0 (No).

- Any count strictly between 0 and N met -> Score 1 (Partial). This applies whether 1 of 7 or 6 of 7 sub-parts are met.

OCSI's scale has no graduated partial; any mix short of full or zero collapses to the same Score 1.

- If all applicable sub-parts are N/A -> item scored N/A (interpretive extension, not explicit in Hammerschlag et al. 2011)."""@en ;
                                              tara-kb:hasTypicalArticleSection "Methods"^^tara-kb:articleSectionType ;
                                              rdfs:label "(5) Acupuncture Needling Parameters" ;
                                              skos:altLabel "5_Acupuncture_Needling_Parameters" ;
                                              rdfs:subPropertyOf tara-kb:hasAcupunctureInterventionMetrics ;
                                              rdfs:range tara-kb:ocsiItemScore ;
                                              rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupunctureProtocol
tara-kb:hasAcupunctureProtocol rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 """The value for this should be a structured information about the acupuncturue protocol used by the trial study. Here is an example structure:

Example 1:
Acupoints selection and grouping: Combination of scalp, body, and auricular acupuncture specific to the affected areas of the child and inclusive of both sides of the body.
| Needling details: Not specified.
| Stimulation details: Not specified.
| Sham protocol details: No sham arm.

Example 2:
Point selection and grouping: Trigger points in the gluteals isolated by palpation ensuring reproduction of symptoms, mostly in the region of the upper outer buttock quadrant, 3 to 5 points per subject.
| Needling details: Sterile acupuncture needles (Seirin Corp, Shizuoka, Japan), 0.30 mm diameter, 25 mm long; pierced skin and advanced into trigger point until reproduction of pain or local twitch response; partially withdrawn and repeatedly advanced into muscle until pain resolved and no further twitches seen; retention time Not specified.
| Stimulation details: Manual repeated advancement into the muscle; no electrical or thermal stimulation.
| Sham protocol details: Non-penetrating modified acupuncture needle with sharp tip removed and glued back in sheath; tip applied to the skin over the trigger point with pressure for 10 or more seconds and moved slightly to simulate real needling, repeated at each point for up to one minute.""" ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description """A dual-purpose annotation property that serves as a super-property grouping the granular acupuncture intervention sub-properties (method, needling, stimulation, sham, and acupoints), while simultaneously acting as a direct container for a single, structured free-text summary of the full acupuncture protocol.

This field should conatin a structured summary combining acupoint selection and grouping, needling details, stimulation details, and sham protocol details into one field (see the 'example of usage' for full worked examples)."""@en ;
                               tara-ap:hasCompactURI "tara-kb:hasAcupunctureProtocol" ;
                               tara-ap:hasSynonym "hasAcupunctureIntervention" ;
                               tara-kb:hasStudyMetadataExtractionPrompt """{
  \"field\": \"Acupuncture_Protocol\",
  \"description\": \"A dual-purpose annotation property that serves as a super-property grouping the granular acupuncture intervention sub-properties (method, needling, stimulation, sham, and acupoints), while simultaneously acting as a direct container for a single, structured free-text summary of the full acupuncture protocol. This field should conatin a structured summary combining acupoint selection and grouping, needling details, stimulation details, and sham protocol details into one field (see the 'example of usage' for full worked examples).\",
  \"normalization\": \"Produce one structured, uniformly-formatted entry combining four sub-parts, in this exact order and pipe-delimited format (see this property's own obo:IAO_0000112 for full worked examples): 'Point selection and grouping: <text> | Needling details: <text> | Stimulation details: <text> | Sham protocol details: <text>'. Base 'Point selection and grouping' on the context described for hasAcupointSelectionAndGrouping (the acupoints' selection rationale and grouping/combination logic) -- do NOT restate the raw acupoint list itself, which belongs under hasListedAcupoints only. Base 'Needling details' on the context described for hasNeedlingDetails, 'Stimulation details' on hasStimulationTypeDetails, and 'Sham protocol details' on hasShamAcupunctureDetails. If a sub-part is not reported, write 'Not specified' for that sub-part only, not for the whole entry. These four sub-parts are captured here only -- they are not extracted again as separate fields.\"
}"""^^rdf:JSON ;
                               rdfs:label "Acupuncture Protocol" ;
                               skos:altLabel "Acupuncture_Protocol" ;
                               rdfs:subPropertyOf tara-kb:hasAcupunctureStudyMetadata ;
                               rdfs:range xsd:string ;
                               rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupunctureStudyMetadata
tara-kb:hasAcupunctureStudyMetadata rdf:type owl:AnnotationProperty ;
                                    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                    dcterms:description "A grouping annotation property that organizes the operational, methodological, and outcome-related metadata describing the acupuncture research study itself (as opposed to its reporting publication)."@en ;
                                    dcterms:type tara-kb:grouping ;
                                    tara-ap:hasCompactURI "tara-kb:hasAcupunctureStudyMetadata" ;
                                    tara-kb:hasGeneralStudyMetadataExtractionPrompt """{
  \"role\": \"You are extracting acupuncture study design and findings metadata for one acupuncture clinical trial article.\",
  \"task\": \"You are given the full text of one article and a set of fields, each supplied separately with a compact extraction fragment (field, description, and optional normalization rules). Some fields (e.g. Acupuncture Protocol, Study Outcomes Measure, Treatment Duration and Frequency) intentionally combine several related pieces of information into one structured entry rather than separate fields -- follow each such field's normalization rule exactly for its required internal structure.\",
  \"output_schema\": {
    \"type\": \"array\",
    \"item_fields\": {
      \"field\": \"the field's skos:altLabel (spreadsheet column name)\",
      \"value\": \"the extracted string, or 'Not Specified' / empty per the missing-value rule below\"
    }
  },
  \"global_scoring_rules\": [
    \"If a value is genuinely not found in the article, write the literal string 'Not Specified' -- except for any field whose value is a URI (Dataset Link), where an unfound value must be left as an empty string, never the text 'Not Specified' or a fabricated URL.\",
    \"Never include Chinese characters (Hanzi) in any extracted value. Where a term appears with both an English/pinyin rendering and Chinese characters, extract only the English or pinyin form.\",
    \"Before recording any text value, repair likely PDF-extraction artifacts: (1) rejoin words split across a line break or column boundary, whether or not a stray hyphen was retained, judging by whether the joined form is a real word or recognizable term in context; (2) correct a space incorrectly inserted mid-word, and correct two distinct words run together without a space, using context to find the right boundary; (3) do not preserve stray control characters, orphaned hyphens, or ligature-rendering artifacts; (4) if a term remains genuinely ambiguous after repair, extract your best reconstruction rather than leaving it visibly broken, but never fabricate content not present in the source.\",
    \"Preserve accented and diacritical characters exactly as they appear in the source -- do not strip or transliterate them to unaccented ASCII.\",
    \"Fields whose normalization rule states they combine multiple sub-parts (Acupuncture Protocol, Study Outcomes Measure, Treatment Duration and Frequency) must be produced as ONE entry each, in the exact structure their normalization rule specifies -- their component sub-parts are not separately-extracted fields.\",
    \"Apply each field's own 'normalization' rule, where present, in addition to these general rules.\"
  ],
  \"response_format\": \"Return a JSON array of one object per field, covering every field supplied, in the order supplied, and nothing else -- no surrounding prose.\"
}"""^^rdf:JSON ;
                                    rdfs:label "Acupuncture Study Metadata" ;
                                    skos:altLabel "Acupuncture_Study_Metadata" ;
                                    rdfs:subPropertyOf tara-kb:hasExtractedArticleMetadata ;
                                    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupunctureStyleAndSelectionScore
tara-kb:hasAcupunctureStyleAndSelectionScore rdf:type owl:AnnotationProperty ;
                                             dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011. https://doi.org/10.1155/2011/183910"@en ;
                                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                             dcterms:description """The STRICTA-aligned score evaluating the general description of the acupuncture style and acupoints selection rationale for the intervention.

- The OCSI Item Number, Assessment Question(s) (reproduced from Table 1, Hammerschlag et al., 2011),  and Per Question Instructions(s) (reproduced from Appendix A.2, Hammerschlag et al., 2011) are reproduced under the CC-BY license, with attribution to the original authors. See the Bibliographic Citation section."""@en ;
                                             tara-ap:hasCompactURI "tara-kb:hasAcupunctureStyleAndSelectionScore" ;
                                             tara-kb:hasOCSIAssessmentQuestions """(a) Is the style of acupuncture stated?

(b) Is the rationale presented for the selection of acupuncture points?

(c) Was the rationale justified?"""@en ;
                                             tara-kb:hasOCSIItemNumber "4"^^tara-kb:ocsiItemNumber ;
                                             tara-kb:hasOCSIPerQuestionInstructions """(a) Style of acupuncture can be implied from the author affiliation information; for example, authors were from the Beijing TCM hospital, so style is TCM. If the protocol utilized a single acupoint or only lists the names of the acupoint(s), the style still needs to be stated.

(b) For example, the acupoints were chosen on the basis of text books, practitioner survey, or prior research.

(c) Justified, for a YES score, requires citing journals, texts, practitioner survey, or an expert panel."""@en ;
                                             tara-kb:hasOCSIScoreExtractionPrompt """{
  \"item\": 4,
  \"question\": \"(a) Is the style of acupuncture stated? (b) Is the rationale presented for the selection of acupuncture points? (c) Was the rationale justified?\",
  \"parts\": {
    \"a\": \"the style of acupuncture is stated\",
    \"b\": \"the rationale is presented for the selection of acupuncture points\",
    \"c\": \"the rationale is justified (citing journals, texts, practitioner survey, or an expert panel)\"
  }
}"""^^rdf:JSON ;
                                             tara-kb:hasOCSIScoringRubric """Applicable sub-parts:

(a) the style of acupuncture is stated;

(b) the rationale is presented for the selection of acupuncture points;

(c) the rationale is justified (citing journals, texts, practitioner survey, or an expert panel).

N = 3 when all 3 are applicable.

Combination rule (N = applicable sub-parts among a-c):

- All N met -> Score 2 (Yes).

- 0 of N met -> Score 0 (No).

- Any count strictly between 0 and N met -> Score 1 (Partial). This applies whether 1 of 3 or 2 of 3 sub-parts are met.

OCSI's scale has no graduated partial; any mix short of full or zero collapses to the same Score 1.

- If all applicable sub-parts are N/A -> item scored N/A (interpretive extension, not explicit in Hammerschlag et al. 2011)."""@en ;
                                             tara-kb:hasTypicalArticleSection "Methods"^^tara-kb:articleSectionType ;
                                             rdfs:label "(4) Acupuncture Style & Acupoints Selection" ;
                                             skos:altLabel "4_Acupuncture_Style_Acupoints_Selection" ;
                                             rdfs:subPropertyOf tara-kb:hasAcupunctureInterventionMetrics ;
                                             rdfs:range tara-kb:ocsiItemScore ;
                                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAdverseEventsSideEffectsScore
tara-kb:hasAdverseEventsSideEffectsScore rdf:type owl:AnnotationProperty ;
                                         dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011. https://doi.org/10.1155/2011/183910"@en ;
                                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                         dcterms:description """The reporting quality score assessing the transparency of reporting adverse events or side effects for each intervention group.

- The OCSI Item Number, Assessment Question(s) (reproduced from Table 1, Hammerschlag et al., 2011),  and Per Question Instructions(s) (reproduced from Appendix A.2, Hammerschlag et al., 2011) are reproduced under the CC-BY license, with attribution to the original authors. See the Bibliographic Citation section."""@en ;
                                         tara-ap:hasCompactURI "tara-kb:hasAdverseEventsSideEffectsScore" ;
                                         tara-kb:hasOCSIAssessmentQuestions "Are all important adverse events or side effects presented for each intervention group?"@en ;
                                         tara-kb:hasOCSIItemNumber "24"^^tara-kb:ocsiItemNumber ;
                                         tara-kb:hasOCSIPerQuestionInstructions "It cannot be scored as N/A. Authors need to state whether there were or were not adverse events (AE) or side effects for each group. If severe AEs occurred, estimates of the frequency should be reported."@en ;
                                         tara-kb:hasOCSIScoreExtractionPrompt """{
  \"item\": 24,
  \"question\": \"Are all important adverse events or side effects presented for each intervention group?\",
  \"criteria\": {
    \"yes\": \"all important adverse events or side effects are presented for each intervention group, including frequency estimates if severe events occurred.\",
    \"partial\": \"adverse events are mentioned but not broken out by group, or reporting is incomplete.\",
    \"no\": \"no statement is made about adverse events or side effects for any group.\",
    \"na\": null,
    \"na_excluded\": true
  }
}"""^^rdf:JSON ;
                                         tara-kb:hasOCSIScoringRubric """- Score 2 (Yes): all important adverse events or side effects are presented for each intervention group, including frequency estimates if severe events occurred.

- Score 1 (Partial): adverse events are mentioned but not broken out by group, or reporting is incomplete.

- Score 0 (No): no statement is made about adverse events or side effects for any group.

- N/A: Not applicable -- this item cannot be scored N/A.

Per Appendix A.2, item 24 cannot be scored N/A: authors must state whether adverse events occurred, even if the answer is that none did."""@en ;
                                         tara-kb:hasTypicalArticleSection "Results"^^tara-kb:articleSectionType ;
                                         rdfs:label "(24) Adverse Events & Side Effects" ;
                                         skos:altLabel "24_Adverse_Events_Side_Effects" ;
                                         rdfs:subPropertyOf tara-kb:hasResultsAndOutcomesMetrics ;
                                         rdfs:range tara-kb:ocsiItemScoreRequired ;
                                         rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasArticleTitle
tara-kb:hasArticleTitle rdf:type owl:AnnotationProperty ;
                        obo:IAO_0000112 "e.g., \"Acupuncture for Chronic Low Back Pain: A Randomized Controlled Trial\"."@en ;
                        dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                        dcterms:description "The full, verbatim title of the journal article as published."@en ;
                        tara-ap:hasCompactURI "tara-kb:hasArticleTitle" ;
                        tara-kb:hasBibliographicMetadataExtractionPrompt """{
  \"field\": \"Article_Title\",
  \"description\": \"The full, verbatim title of the journal article as published.\"
}"""^^rdf:JSON ;
                        rdfs:label "Article Title" ;
                        skos:altLabel "Article_Title" ;
                        rdfs:subPropertyOf dcterms:title ,
                                           tara-kb:hasBibliographicMetadata ;
                        rdfs:range xsd:string ;
                        rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasArticleType
tara-kb:hasArticleType rdf:type owl:AnnotationProperty ;
                       obo:IAO_0000112 "e.g., \"Primary Article\", \"Review Article\", \"Systematic Review Article\", or \"Meta-analysis Article\"."@en ;
                       dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                       dcterms:description "The specific classification of the publication based on its methodology, structure, and evidentiary value (e.g., Primary Article, Review Article, Systematic Review Article, Meta-analysis Article)."@en ;
                       tara-ap:hasCompactURI "tara-kb:hasArticleType" ;
                       tara-kb:hasBibliographicMetadataExtractionPrompt """{
  \"field\": \"Article_Type\",
  \"description\": \"The specific classification of the publication based on its methodology, structure, and evidentiary value (e.g., Primary Article, Review Article, Systematic Review Article, Meta-analysis Article).\"
}"""^^rdf:JSON ;
                       rdfs:label "Article Type" ;
                       skos:altLabel "Article_Type" ;
                       rdfs:subPropertyOf dcterms:type ,
                                          tara-kb:hasBibliographicMetadata ;
                       rdfs:range xsd:string ;
                       rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasBibliographicMetadata
tara-kb:hasBibliographicMetadata rdf:type owl:AnnotationProperty ;
                                 obo:IAO_0000112 "E.g., \"Smith J, et al. (2021). Acupuncture for chronic low back pain. J Altern Complement Med. 27(4):301-310.\" while also grouping hasArticleTitle, hasListedAuthors, hasPublicationDate, hasPublicationVenue, and hasPublicationLink."@en ;
                                 dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                 dcterms:description "A dual-purpose annotation property that serves as a super-property to logically group granular bibliographic sub-properties (e.g., titles, identifiers, and venues), while simultaneously acting as a direct container for a complete, pre-formatted human-readable citation string (such as APA, MLA, or Chicago styles)."@en ;
                                 tara-ap:hasCompactURI "tara-kb:hasBibliographicMetadata" ;
                                 tara-ap:hasSynonym "Publication Metadata" ;
                                 tara-kb:hasGeneralBibliographicMetadataExtractionPrompt """{
  \"role\": \"You are extracting bibliographic metadata for one acupuncture clinical trial article.\",
  \"task\": \"You are given the full text of one article and a set of fields, each supplied separately with a compact extraction fragment (field, description, and optional normalization rules).\",
  \"output_schema\": {
    \"type\": \"array\",
    \"item_fields\": {
      \"field\": \"the field's skos:altLabel (spreadsheet column name)\",
      \"value\": \"the extracted string, or 'Not Specified' / empty per the missing-value rule below\"
    }
  },
  \"global_scoring_rules\": [
    \"If a value is genuinely not found in the article, write the literal string 'Not Specified' -- except for any field whose value is a URI (DOI Link, PubMed Link, Other Link, Dataset Link), where an unfound value must be left as an empty string, never the text 'Not Specified' or a fabricated URL.\",
    \"Never include Chinese characters (Hanzi) in any extracted value. Where a term appears with both an English/pinyin rendering and Chinese characters, extract only the English or pinyin form.\",
    \"Before recording any text value, repair likely PDF-extraction artifacts: (1) rejoin words split across a line break or column boundary, whether or not a stray hyphen was retained (e.g., 'ran- domized' or 'ran domized' -> 'randomized'), judging by whether the joined form is a real word or recognizable term in context; (2) correct a space incorrectly inserted mid-word, and correct two distinct words run together without a space, using context to find the right boundary; (3) do not preserve stray control characters, orphaned hyphens, or ligature-rendering artifacts; (4) if a term remains genuinely ambiguous after repair, extract your best reconstruction rather than leaving it visibly broken, but never fabricate content not present in the source.\",
    \"Preserve accented and diacritical characters exactly as they appear in the source (e.g., 'Muller', 'Garcia-Lopez', 'Sondergaard') -- do not strip or transliterate them to unaccented ASCII.\",
    \"Apply each field's own 'normalization' rule, where present, in addition to these general rules.\"
  ],
  \"response_format\": \"Return a JSON array of one object per field, covering every field supplied, in the order supplied, and nothing else -- no surrounding prose.\"
}"""^^rdf:JSON ;
                                 rdfs:label "Bibliographic Metadata" ;
                                 skos:altLabel "Bibliographic_Metadata" ;
                                 rdfs:subPropertyOf tara-kb:hasExtractedArticleMetadata ;
                                 rdfs:range xsd:string ;
                                 rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasBibliographicMetadataExtractionPrompt
tara-kb:hasBibliographicMetadataExtractionPrompt rdf:type owl:AnnotationProperty ;
                                                 obo:IAO_0000112 """{
  \"field\": \"Listed_Authors\",
  \"description\": \"The full list of authors credited on the publication, typically recorded as a single delimited string in the order they appear on the article.\",
  \"normalization\": \"Format as 'Surname Initials' per author (no periods between initials, no space between multiple initials), authors comma-separated in the order listed on the article, e.g. 'Garcia-Lopez J, Lee KH, Muller A'. Preserve accented/diacritical characters exactly as in the source (do not transliterate to ASCII).\"
}"""@en ;
                                                 dcterms:description """The compact, LLM-facing extraction fragment for a single Bibliographic Metadata field, attached directly to that field's property (e.g. hasArticleTitle). Combined by the extraction pipeline with hasGeneralBibliographicMetadataExtractionPrompt and the article's full text into one API call covering all Bibliographic Metadata fields at once.

Top-level JSON keys:

- 'field' -- the property's skos:altLabel (the spreadsheet column name).

- 'description' -- the field's meaning, taken directly from the property's own dcterms:description.

- 'normalization' -- present only where a field needs extraction/formatting guidance beyond the general rules in hasGeneralBibliographicMetadataExtractionPrompt (e.g. the author-name formatting convention); absent otherwise."""@en ;
                                                 rdfs:label "Bibliographic Metadata Extraction Prompt" ;
                                                 skos:altLabel "Bibliographic_Metadata_Extraction_Prompt" ;
                                                 rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt ;
                                                 rdfs:range rdf:JSON .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasBlindingStatementsQualityScore
tara-kb:hasBlindingStatementsQualityScore rdf:type owl:AnnotationProperty ;
                                          dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011. https://doi.org/10.1155/2011/183910"@en ;
                                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                          dcterms:description """The quality check score auditing whether the trial describes who was masked to trial assignments (e.g., patients, operators, assessors).

- The OCSI Item Number, Assessment Question(s) (reproduced from Table 1, Hammerschlag et al., 2011),  and Per Question Instructions(s) (reproduced from Appendix A.2, Hammerschlag et al., 2011) are reproduced under the CC-BY license, with attribution to the original authors. See the Bibliographic Citation section."""@en ;
                                          tara-ap:hasCompactURI "tara-kb:hasBlindingStatementsQualityScore" ;
                                          tara-kb:hasOCSIAssessmentQuestions """Is it stated whether or not

(a) participants,

(b) those administering the interventions, and

(c) those assessing the outcomes were blinded? and

(d) was the success of participant blinding evaluated?"""@en ;
                                          tara-kb:hasOCSIItemNumber "16"^^tara-kb:ocsiItemNumber ;
                                          tara-kb:hasOCSIPerQuestionInstructions """(a) It must state that patients were blinded to group assignments, for example, a statement that the trial was single-blinded. If the trial was a comparison of active treatments, for example, acupuncture versus massage, this will be scored N/A.

(b) This will usually be scored N/A. In the rare case that the study did blind the practitioners, there must be an explicit statement regarding the method utiliz.

(c) It must state whether or not the persons performing outcome measures were blinded to group assignments.This is more important with subjective outcomes, less so with objective outcomes where there is less chance of bias.

(d) For full credit, authors must (i) state that the success of participant blinding was evaluated and (ii) present the results of the assessment. This is N/A if acupuncture was compared to another active treatment (e.g., standard care or massage)."""@en ;
                                          tara-kb:hasOCSIScoreExtractionPrompt """{
  \"item\": 16,
  \"question\": \"Is it stated whether or not (a) participants, (b) those administering the interventions, and (c) those assessing the outcomes were blinded? and (d) was the success of participant blinding evaluated?\",
  \"parts\": {
    \"a\": \"participant blinding is stated (N/A if the trial compared two active treatments rather than treatment vs. control.)\",
    \"b\": \"practitioner blinding is stated or correctly scored N/A (usually N/A -- practitioners are almost never blinded in acupuncture research (OCSI General Instruction A.1.5).)\",
    \"c\": \"outcome-assessor blinding is stated\",
    \"d\": \"success of participant blinding is evaluated and reported (N/A under the same active-treatment-comparison condition as (a).)\"
  }
}"""^^rdf:JSON ;
                                          tara-kb:hasOCSIScoringRubric """Applicable sub-parts:

(a) participant blinding is stated;

(b) practitioner blinding is stated or correctly scored N/A;

(c) outcome-assessor blinding is stated;

(d) success of participant blinding is evaluated and reported.

N = 4 when all 4 are applicable; N is reduced by however many sub-parts are individually N/A (see below).

Combination rule (N = applicable sub-parts among a-d):

- All N met -> Score 2 (Yes).

- 0 of N met -> Score 0 (No).

- Any count strictly between 0 and N met -> Score 1 (Partial). This applies whether 1 of 4 or 3 of 4 sub-parts are met.

OCSI's scale has no graduated partial; any mix short of full or zero collapses to the same Score 1.

- If all applicable sub-parts are N/A -> item scored N/A (interpretive extension, not explicit in Hammerschlag et al. 2011).

Sub-part N/A conditions:

(a) is N/A if the trial compared two active treatments rather than treatment vs. control.

(b) is usually N/A - practitioners are almost never blinded in acupuncture research (OCSI General Instruction A.1.5).

(d) is N/A under the same active-treatment-comparison condition as (a)."""@en ;
                                          tara-kb:hasTypicalArticleSection "Methods"^^tara-kb:articleSectionType ;
                                          rdfs:label "(16) Blinding Statements Quality" ;
                                          skos:altLabel "16_Blinding_Statements_Quality" ;
                                          rdfs:subPropertyOf tara-kb:hasStudyDesignAndAnalysisMetrics ;
                                          rdfs:range tara-kb:ocsiItemScore ;
                                          rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasComparativeFindings
tara-kb:hasComparativeFindings rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 "e.g., \"EA therapy showed functional improvement in the lumbar spine, but the improvement in motion recovery was not significantly different from PRF.\"."@en ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "Captures how different active treatment arms performed relative to each other across different parameters."@en ;
                               tara-ap:hasCompactURI "tara-kb:hasComparativeFindings" ;
                               tara-kb:hasStudyMetadataExtractionPrompt """{
  \"field\": \"Comparative_Findings\",
  \"description\": \"Captures how different active treatment arms performed relative to each other across different parameters.\"
}"""^^rdf:JSON ;
                               rdfs:comment "Captures how different active treatment arms performed relative to each other across different parameters. Example: \"EA therapy showed functional improvement in the lumbar spine, but the improvement in motion recovery was not significantly different from PRF.\"" ;
                               rdfs:label "Comparative Findings" ;
                               skos:altLabel "Comparative_Findings" ;
                               rdfs:subPropertyOf dcterms:description ,
                                                  tara-kb:hasStudyFindings ;
                               rdfs:range xsd:string ;
                               rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasControlGroupsDetails
tara-kb:hasControlGroupsDetails rdf:type owl:AnnotationProperty ;
                                obo:IAO_0000112 """Control Arm 1 - Sham Acupuncture: Deployed Streitberger non-penetrating placebo needles at valid acupoints. Patients were successfully blinded to needle penetration, though mild skin pressure-induced neurological stimulation remains a potential confounding physiological sham effect.

Control Arm 2 - Non-Acupoint Real Needling: Used identical standard 0.25mm stainless steel needles fully inserted to standard depths (15mm), but placed 2-3 cm away from traditional meridians in anatomically neutral zones to test point-specificity.

Control Arm 3 - Active Control: Standard Care regimen consisting of prescribed physical therapy twice weekly and open-label Naproxen (500mg daily) to evaluate clinical superiority."""@en ,
                                                "Sham acupuncture: Patients received sham acupuncture once a week for 6 weeks, using blunt-tipped needles that did not penetrate the skin, as a control group to compare with true acupuncture."@en ;
                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                dcterms:description "An annotation property to capture structured details about the control group methodologies (control arms) deployed within a clinical trial study, as reported in a journal publication. It explicitly documents the specific type of control utilized, such as sham interventions, non-acupoint/minimal treatments, active controls, or waitlists, along with critical methodological protocols, including patient blinding mechanisms, the physiological nature of the control, and any deviations from standard or traditional practices meant to isolate specific therapeutic variables."@en ;
                                tara-ap:hasCompactURI "tara-kb:hasControlGroupsDetails" ;
                                tara-kb:hasStudyMetadataExtractionPrompt """{
  \"field\": \"Control_Groups_Details\",
  \"description\": \"An annotation property to capture structured details about the control group methodologies (control arms) deployed within a clinical trial study, as reported in a journal publication. It explicitly documents the specific type of control utilized, such as sham interventions, non-acupoint/minimal treatments, active controls, or waitlists, along with critical methodological protocols, including patient blinding mechanisms, the physiological nature of the control, and any deviations from standard or traditional practices meant to isolate specific therapeutic variables.\"
}"""^^rdf:JSON ;
                                rdfs:comment """Acupuncture control groups are fundamentally classified into four main methodological paradigms:
1) Sham Acupuncture: Placebo needling using non-penetrating retracting devices to isolate needling-specific effects;
2) Real Acupuncture at Non-Acupoints: Minimal acupuncture using standard needles at non-meridian locations to isolate point-specificity;
3) Active Control: Ttreatment-as-usual, standard care, or pharmacotherapy to test clinical superiority/equivalence; and
4) Waitlist or No-Treatment Control: To measure natural disease progression. 

Note: Researchers must account for the 'physiological sham effect,' where even non-penetrating skin pressure or non-acupoint stimulation can trigger local neurological and circulatory responses, meaning these controls are rarely completely inert."""@en ;
                                rdfs:label "Control Groups Details" ;
                                skos:altLabel "Control_Groups_Details" ;
                                rdfs:subPropertyOf dcterms:description ,
                                                   tara-kb:hasStudyDesignMetadata ;
                                rdfs:range xsd:string ;
                                rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasControlGroupsInterventionScore
tara-kb:hasControlGroupsInterventionScore rdf:type owl:AnnotationProperty ;
                                          dcterms:bibliographicCitation "Hammerschlag R, Milley RJ, Colbert A, Weih J, Yohalem-Ilsley B, Mist S, Aickin M. Randomized Controlled Trials of Acupuncture (1997–2007): An Assessment of Reporting Quality with a CONSORT- and STRICTA-Based Instrument. Evidence-Based Complementary and Alternative Medicine. 2011. https://doi.org/10.1155/2011/183910"@en ;
                                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                          dcterms:description """The quality check score evaluating how thoroughly the rationales and structural formats of the control or comparative groups are reported.

- The OCSI Item Number, Assessment Question(s) (reproduced from Table 1, Hammerschlag et al., 2011),  and Per Question Instructions(s) (reproduced from Appendix A.2, Hammerschlag et al., 2011) are reproduced under the CC-BY license, with attribution to the original authors. See the Bibliographic Citation section."""@en ;
                                          tara-ap:hasCompactURI "tara-kb:hasControlGroupsInterventionScore" ;
                                          tara-kb:hasOCSIAssessmentQuestions """(a) Is the intended effect of the control or comparison intervention presented?

(b) Were the specific explanations given to patients of the treatment and control interventions presented?

(c) Are details for the control or comparison intervention presented?

(d) Are sources provided, that justify the choice of the control or comparison intervention?"""@en ;
                                          tara-kb:hasOCSIItemNumber "9"^^tara-kb:ocsiItemNumber ;
                                          tara-kb:hasOCSIPerQuestionInstructions """A no-treatment control is scored the same as a sham or comparison control.

(a) Intended effect refers to the specific rationale for choosing the control (including no treatment).

(b) Specific explanations refers to the specific wording the patient receives regarding the treatment and control procedures.

(c) Details refers to a precise description of the control intervention, including (if applicable, e.g., invasive sham) the parameters of needling (item 5(a)-(g)). This includes no treatment controls, for example, who may have been required to keep diaries. If no tracking was performed, it must be stated.

(d) Justification refers to citing journals, textbooks, practitioner survey, or an expert consensus panel."""@en ;
                                          tara-kb:hasOCSIScoreExtractionPrompt """{
  \"item\": 9,
  \"question\": \"(a) Is the intended effect of the control or comparison intervention presented? (b) Were the specific explanations given to patients of the treatment and control interventions presented? (c) Are details for the control or comparison intervention presented? (d) Are sources provided, that justify the choice of the control or comparison intervention?\",
  \"parts\": {
    \"a\": \"the intended effect of the control or comparison intervention is presented\",
    \"b\": \"the specific explanations given to patients about treatment and control interventions are presented\",
    \"c\": \"details for the control or comparison intervention are presented (including needling parameters, item 5(a)-(g), if applicable)\",
    \"d\": \"sources are provided that justify the choice of the control or comparison intervention\"
  }
}"""^^rdf:JSON ;
                                          tara-kb:hasOCSIScoringRubric """Applicable sub-parts:

(a) the intended effect of the control or comparison intervention is presented;

(b) the specific explanations given to patients about treatment and control interventions are presented;

(c) details for the control or comparison intervention are presented (including needling parameters, item 5(a)-(g), if applicable);

(d) sources are provided that justify the choice of the control or comparison intervention.

N = 4 when all 4 are applicable.

Combination rule (N = applicable sub-parts among a-d):

- All N met -> Score 2 (Yes).

- 0 of N met -> Score 0 (No).

- Any count strictly between 0 and N met -> Score 1 (Partial). This applies whether 1 of 4 or 3 of 4 sub-parts are met.

OCSI's scale has no graduated partial; any mix short of full or zero collapses to the same Score 1.

- If all applicable sub-parts are N/A -> item scored N/A (interpretive extension, not explicit in Hammerschlag et al. 2011)."""@en ;
                                          tara-kb:hasTypicalArticleSection "Methods"^^tara-kb:articleSectionType ;
                                          rdfs:label "(9) Control Groups Intervention" ;
                                          skos:altLabel "9_Control_Groups_Intervention" ;
                                          rdfs:subPropertyOf tara-kb:hasAcupunctureInterventionMetrics ;
                                          rdfs:range tara-kb:ocsiItemScore ;
                                          rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasCountryOfStudy
tara-kb:hasCountryOfStudy rdf:type owl:AnnotationProperty ;
                          obo:IAO_0000112 "e.g., \"South Korea\" or \"United States\"."@en ;
                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                          dcterms:description "The country (or countries, for multi-site trials) in which the study was conducted, normalized to a standard country name."@en ;
                          tara-ap:hasCompactURI "tara-kb:hasCountryOfStudy" ;
                          tara-kb:hasStudyMetadataExtractionPrompt """{
  \"field\": \"Country_Of_Study\",
  \"description\": \"The country (or countries, for multi-site trials) in which the study was conducted, normalized to a standard country name.\"
}"""^^rdf:JSON ;
                          rdfs:label "Country of Study"@en ;
                          skos:altLabel "Country_Of_Study" ;
                          rdfs:subPropertyOf dcterms:relation ,
                                             tara-kb:hasStudyLocation ;
                          rdfs:range xsd:string ;
                          rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasDOILink
tara-kb:hasDOILink rdf:type owl:AnnotationProperty ;
                   obo:IAO_0000112 "e.g., \"https://doi.org/10.1089/acm.2021.0142\"."@en ;
