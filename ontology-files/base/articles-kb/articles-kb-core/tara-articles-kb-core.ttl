tara-ap:skosAnntotationProperty rdf:type owl:AnnotationProperty ;
                                rdfs:label "skos:topAnnotationProperty" .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupointGrouping
tara-kb:hasAcupointGrouping rdf:type owl:AnnotationProperty ;
                            obo:IAO_0000112 "\"Three pairs of acupuncture points on the right side: LI 4 and PC 6, ST 36 and SP 9, LR 3 and SP 6; PC 6 was located approximately 1 cm radial to the traditional point.\"" ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "An annotation property to capture acupoint grouping information, the structural combination, pairing, or categorization of multiple selected acupuncture points, including primary and secondary points, designed to work synergistically within a clinical trial treatment prescription." ;
                            tara-ap:hasCompactURI "tara-kb:hasAcupointGrouping" ;
                            rdfs:comment "Acupoint grouping is about organizing multiple points into a single treatment protocol, often divided into primary (core) points for the main condition and secondary (adjuvant) points for specific symptoms." ;
                            rdfs:label "Acupoint Grouping" ;
                            rdfs:subPropertyOf tara-kb:hasAcupointSelectionAndGrouping ;
                            rdfs:range xsd:string ;
                            rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupointSelection
tara-kb:hasAcupointSelection rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "\"Combination of scalp, body, and auricular acupuncture specific to the affected areas of the child and inclusive of both sides of the body.\"" ,
                                             "\"Trigger points in the gluteals isolated by palpation ensuring reproduction of symptoms, mostly in the region of the upper outer buttock quadrant, 3 to 5 points per subject.\"" ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description "An annotation property to capture specific choice of body sites (anatomical locations) targeted for acupuncture needle insertion within a clinical trial protocol." ;
                             tara-ap:hasCompactURI "tara-kb:hasAcupointSelection" ;
                             rdfs:comment "Acupoint selection is about deciding which exact body locations to target during an intervention, guided by traditional systems (like meridians and specific point attributes) or modern anatomical maps (like local trigger points or nerve distributions). Researchers standardize this to test if a specific set of points delivers reproducible health outcomes." ;
                             rdfs:label "Acupoint Selection" ;
                             rdfs:subPropertyOf tara-kb:hasAcupointSelectionAndGrouping ;
                             rdfs:range xsd:string ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupointSelectionAndGrouping
tara-kb:hasAcupointSelectionAndGrouping rdf:type owl:AnnotationProperty ;
                                        obo:IAO_0000112 "\"Point selection and grouping: Verum points selected from a prescribed list (part standardisation) consisting of obligatory points and additional points individually chosen based on TCM diagnosis for syndromes, acupuncture channels related to the individual headache area, and Ah Shi points; needling was bilateral.\"" ;
                                        dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                        dcterms:description "A dual-purpose annotation property that serves as a super-property grouping 'Acupoint Selection' and 'Acupoint Grouping', while simultaneously acting as a direct container for a combined free-text statement about Acupoints Seclection and Grouping." ;
                                        tara-ap:hasCompactURI "tara-kb:hasAcupointSelectionAndGrouping" ;
                                        rdfs:comment "In clinical trials evaluating acupuncture, acupoint selection is the specific choice of body sites (the points) where needles are inserted based on traditional theory or modern neuroscience. Acupoint grouping (or combination) refers to how these points are paired together in a treatment prescription to work synergistically for a medical condition." ;
                                        rdfs:label "Point Selection and Grouping" ;
                                        rdfs:subPropertyOf tara-kb:hasAcupunctureProtocol ;
                                        rdfs:range xsd:string ;
                                        rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupunctureDetailsScore
tara-kb:hasAcupunctureDetailsScore rdf:type owl:AnnotationProperty ;
                                   obo:IAO_0000112 "e.g., a score of 2 when the acupuncture style and its rationale are both fully described, 1 when only partially described, or 0 when neither is reported."@en ;
                                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                   dcterms:description "Category B: Acupuncture Intervention Metrics (STRICTA). The STRICTA-aligned score evaluating the general description of the acupuncture style and rationale." ;
                                   tara-ap:hasAssessmentQuestion """(a) Is the style of acupuncture stated?

(b) Is the rationale presented for the selection of acupuncture points?

(c) Was the rationale justified?"""@en ;
                                   tara-ap:hasCompactURI "tara-kb:hasAcupunctureDetailsScore" ;
                                   tara-ap:hasOCSIItemNumber "4"^^tara-kb:ocsiItemNumber ;
                                   tara-ap:hasScoringInstructions """(a) Style of acupuncture can be implied from the author affiliation information; for example, authors were from the Beijing TCM hospital, so style is TCM. If the protocol utilized a single acupoint or only lists the names of the acupoint(s), the style still needs to be stated.

(b) For example, the acupoints were chosen on the basis of text books, practitioner survey, or prior research.

(c) Justified, for a YES score, requires citing journals, texts, practitioner survey, or an expert panel."""@en ;
                                   rdfs:label "Acupuncture Details Score" ;
                                   skos:altLabel "Acupuncture_Details_Score" ;
                                   rdfs:subPropertyOf tara-kb:hasAcupunctureInterventionMetrics ;
                                   rdfs:range tara-kb:ocsiItemScore ;
                                   rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupunctureInterventionMetrics
tara-kb:hasAcupunctureInterventionMetrics rdf:type owl:AnnotationProperty ;
                                          obo:IAO_0000112 "e.g., an aggregate value of 12 summarizing the combined STRICTA-aligned sub-scores (acupuncture details, needling parameters, treatment frequency, cointerventions, practitioner background, control group details)."@en ;
                                          dcterms:bibliographicCitation "MacPherson H, Altman DG, Hammerschlag R, Youping L, Taixiang W, White A, Moher D; STRICTA Revision Group. Revised STandards for Reporting Interventions in Clinical Trials of Acupuncture (STRICTA): extending the CONSORT statement. PLoS Med. 2010;7(6):e1000261. doi:10.1371/journal.pmed.1000261. (Concurrently published in Acupuncture in Medicine 2010;28(2):83-93, doi:10.1136/aim.2009.001370, and Journal of Alternative and Complementary Medicine 2010;16(10):ST-1-14.)"@en ;
                                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                          dcterms:description "This is a TARA-KB convention of categorization: Category B, Acupuncture Intervention Metrics, groups OCSI items 4 through 9, which report on the acupuncture intervention itself and correspond one-to-one, in order, to the six official STRICTA 2010 checklist items -- (1) Acupuncture rationale, (2) Details of needling, (3) Treatment regimen, (4) Other components of treatment, (5) Practitioner background, (6) Control or comparator interventions -- since Hammerschlag et al. 2011 state these six items substitute for CONSORT's own item 4."@en ;
                                          dcterms:source <https://doi.org/10.1371/journal.pmed.1000261> ;
                                          dcterms:type tara-kb:grouping ;
                                          tara-ap:hasCompactURI "tara-kb:hasAcupunctureInterventionMetrics" ;
                                          rdfs:comment "The umbrella label 'Acupuncture Intervention Metrics' and its place in this ontology's four-category scheme (A/B/C/D) are a TARA-KB convention, not STRICTA's own terminology. This category's item membership (OCSI items 4-9), however, is directly traceable to STRICTA (MacPherson et al. 2010), with an exact one-to-one, in-order correspondence to STRICTA's six official checklist items. Unlike an earlier version of this ontology, hasSampleSizeScore (OCSI item 12) is no longer nested here: item 12 is a plain CONSORT item (sample size determination), not one of STRICTA's six items, and has been moved to Category C (hasStudyDesignAndAnalysisMetrics), making this category's membership an exact match to STRICTA's item set."@en ;
                                          rdfs:label "Category B: Acupuncture Intervention Metrics" ;
                                          skos:altLabel "Acupuncture_Intervention_Metrics" ;
                                          rdfs:subPropertyOf tara-kb:hasOCSIItemScoringMetadata ;
                                          rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupunctureProtocol
tara-kb:hasAcupunctureProtocol rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 """The value for this should be a structured information about the acupuncturue protocol used by the trial study. Here is an example structure:

Example 1:
Acupoints selection and grouping: Combination of scalp, body, and auricular acupuncture specific to the affected areas of the child and inclusive of both sides of the body.
| Needling details: Not specified.
| Stimulation details: Not specified.
| Sham protocol details: No sham arm.

Example 2:
Point selection and grouping: Trigger points in the gluteals isolated by palpation ensuring reproduction of symptoms, mostly in the region of the upper outer buttock quadrant, 3 to 5 points per subject.
| Needling details: Sterile acupuncture needles (Seirin Corp, Shizuoka, Japan), 0.30 mm diameter, 25 mm long; pierced skin and advanced into trigger point until reproduction of pain or local twitch response; partially withdrawn and repeatedly advanced into muscle until pain resolved and no further twitches seen; retention time Not specified.
| Stimulation details: Manual repeated advancement into the muscle; no electrical or thermal stimulation.
| Sham protocol details: Non-penetrating modified acupuncture needle with sharp tip removed and glued back in sheath; tip applied to the skin over the trigger point with pressure for 10 or more seconds and moved slightly to simulate real needling, repeated at each point for up to one minute.""" ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description """A dual-purpose annotation property that serves as a super-property grouping the granular acupuncture intervention sub-properties (method, needling, stimulation, sham, and acupoints), while simultaneously acting as a direct container for a single, structured free-text summary of the full acupuncture protocol.

This field should conatin a structured summary combining acupoint selection and grouping, needling details, stimulation details, and sham protocol details into one field (see the 'example of usage' for full worked examples)."""@en ;
                               tara-ap:hasCompactURI "tara-kb:hasAcupunctureProtocol" ;
                               tara-ap:hasSynonym "hasAcupunctureIntervention" ;
                               rdfs:label "Acupuncture Protocol" ;
                               skos:altLabel "Acupuncture_Protocol" ;
                               rdfs:subPropertyOf tara-kb:hasAcupunctureStudyMetadata ;
                               rdfs:range xsd:string ;
                               rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAcupunctureStudyMetadata
tara-kb:hasAcupunctureStudyMetadata rdf:type owl:AnnotationProperty ;
                                    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                    dcterms:description "A grouping annotation property that organizes the operational, methodological, and outcome-related metadata describing the acupuncture research study itself (as opposed to its reporting publication)."@en ;
                                    dcterms:type tara-kb:grouping ;
                                    tara-ap:hasCompactURI "tara-kb:hasAcupunctureStudyMetadata" ;
                                    rdfs:label "Acupuncture Study Metadata" ;
                                    skos:altLabel "Acupuncture_Study_Metadata" ;
                                    rdfs:subPropertyOf tara-kb:hasExtractedArticleMetadata ;
                                    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAdverseEffectsScore
tara-kb:hasAdverseEffectsScore rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 "e.g., a score of 2 when adverse events and their monitoring are explicitly reported, or 0 when adverse events are not mentioned."@en ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "Category D: Results and Discussion Metrics. The quality metric assessing the safety transparency and recording protocols for harmful events or patient side effects." ;
                               tara-ap:hasAssessmentQuestion "Are all important adverse events or side effects presented for each intervention group?"@en ;
                               tara-ap:hasCompactURI "tara-kb:hasAdverseEffectsScore" ;
                               tara-ap:hasOCSIItemNumber "24"^^tara-kb:ocsiItemNumber ;
                               tara-ap:hasScoringInstructions "It cannot be scored as N/A. Authors need to state whether there were or were not adverse events or side effects for each group. If severe AEs occurred, estimates of the frequency should be reported."@en ;
                               rdfs:label "Adverse Effects Score" ;
                               skos:altLabel "Adverse_Effects_Score" ;
                               rdfs:subPropertyOf tara-kb:hasResultsAndDiscussionMetrics ;
                               rdfs:range tara-kb:ocsiItemScoreRequired ;
                               rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAllocationConcealmentScore
tara-kb:hasAllocationConcealmentScore rdf:type owl:AnnotationProperty ;
                                      obo:IAO_0000112 "e.g., a score of 2 when both the implementation method and concealment status of the allocation sequence are described, or 0 when neither is reported."@en ;
                                      dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                      dcterms:description "Category C: Study Design and Analysis Metrics. The sub-score assessing whether the method used to implement the random allocation sequence is described, and whether the sequence was concealed until interventions were assigned." ;
                                      tara-ap:hasAssessmentQuestion """(a) Is the method presented that was used to implement the random allocation sequence,

(b) with clarification as to whether the sequence was concealed until interventions were assigned?"""@en ;
                                      tara-ap:hasCompactURI "tara-kb:hasAllocationConcealmentScore" ;
                                      tara-ap:hasOCSIItemNumber "14"^^tara-kb:ocsiItemNumber ;
                                      tara-ap:hasScoringInstructions """(a) Implementation refers to how the random assignment was applied, for example, a sealed envelope containing the computer-generated group assignment.

(b) Concealment is required to prevent foreknowledge of and introduction of bias in treatment assignment."""@en ;
                                      rdfs:label "Allocation Concealment Score" ;
                                      skos:altLabel "Allocation_Concealment_Score" ;
                                      rdfs:subPropertyOf tara-kb:hasRandomAllocationScore ;
                                      rdfs:range tara-kb:ocsiItemScore ;
                                      rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAllocationPersonnelScore
tara-kb:hasAllocationPersonnelScore rdf:type owl:AnnotationProperty ;
                                    obo:IAO_0000112 "e.g., a score of 2 when the article names who generated the allocation sequence, who enrolled participants, and who assigned them to groups, or 0 when none of these roles are reported."@en ;
                                    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                    dcterms:description "Category C: Study Design and Analysis Metrics. The reporting score assessing whether the article states who generated the randomization sequence, who enrolled participants, and who assigned participants to their groups." ;
                                    tara-ap:hasAssessmentQuestion """Are there statements as to

(a) who generated the allocation sequence,

(b) who enrolled participants, and

(c) who assigned participants to their groups?"""@en ;
                                    tara-ap:hasCompactURI "tara-kb:hasAllocationPersonnelScore" ;
                                    tara-ap:hasOCSIItemNumber "15"^^tara-kb:ocsiItemNumber ;
                                    tara-ap:hasScoringInstructions """(a) It must specifically state the person responsible for generating the randomization.

(b) It refers to the specific person(s) responsible for consenting the participants.

(c) It refers to the person who assigned participants to their respective randomized groups; if this person also generated the randomization scheme, the authors should report how the potential for biased group assignments was addressed."""@en ;
                                    rdfs:label "Allocation Personnel Score" ;
                                    skos:altLabel "Allocation_Personnel_Score" ;
                                    rdfs:subPropertyOf tara-kb:hasStudyDesignAndAnalysisMetrics ;
                                    rdfs:range tara-kb:ocsiItemScore ;
                                    rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasAnalysisPopulationScore
tara-kb:hasAnalysisPopulationScore rdf:type owl:AnnotationProperty ;
                                   obo:IAO_0000112 "e.g., a score of 2 when per-analysis sample sizes, an intention-to-treat analysis, and absolute numbers are all reported, or 0 when none of these are given."@en ;
                                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                   dcterms:description "Category D: Results and Discussion Metrics. The reporting score assessing whether the number of participants included in each analysis, use of an intention-to-treat analysis, and results in absolute numbers are stated." ;
                                   tara-ap:hasAssessmentQuestion """(a) Is the number of participants in each group included in each analysis?

(b) Was the intention to treat analysis presented?

(c) When feasible, are the results stated in absolute numbers (e.g., 10 of 20, not just 50%)?"""@en ;
                                   tara-ap:hasCompactURI "tara-kb:hasAnalysisPopulationScore" ;
                                   tara-ap:hasOCSIItemNumber "21"^^tara-kb:ocsiItemNumber ;
                                   tara-ap:hasScoringInstructions """(a) For full credit, it must state the n per each analysis, since the actual n may vary per outcome. If no dropouts occurred, the n can be implied.

(b) Must use an intention to treat analysis (or a valid substitute) to avoid bias associated with non-random loss of participants.

(c) It must state absolute numbers, for example, reduction of VAS pain from 10 to 5, not just a 50% reduction."""@en ;
                                   rdfs:label "Analysis Population Score" ;
                                   skos:altLabel "Analysis_Population_Score" ;
                                   rdfs:subPropertyOf tara-kb:hasResultsAndDiscussionMetrics ;
                                   rdfs:range tara-kb:ocsiItemScore ;
                                   rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasArticleTitle
tara-kb:hasArticleTitle rdf:type owl:AnnotationProperty ;
                        obo:IAO_0000112 "e.g., \"Acupuncture for Chronic Low Back Pain: A Randomized Controlled Trial\"."@en ;
                        dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                        dcterms:description "The full, verbatim title of the journal article as published."@en ;
                        tara-ap:hasCompactURI "tara-kb:hasArticleTitle" ;
                        rdfs:label "Article Title" ;
                        skos:altLabel "Article_Title" ;
                        rdfs:subPropertyOf dcterms:title ,
                                           tara-kb:hasBibliographicMetadata ;
                        rdfs:range xsd:string ;
                        rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasArticleType
tara-kb:hasArticleType rdf:type owl:AnnotationProperty ;
                       obo:IAO_0000112 "e.g., \"Primary Article\", \"Review Article\", \"Systematic Review Article\", or \"Meta-analysis Article\"."@en ;
                       dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                       dcterms:description "The specific classification of the publication based on its methodology, structure, and evidentiary value (e.g., Primary Article, Review Article, Systematic Review Article, Meta-analysis Article)."@en ;
                       tara-ap:hasCompactURI "tara-kb:hasArticleType" ;
                       rdfs:label "Article Type" ;
                       skos:altLabel "Article_Type" ;
                       rdfs:subPropertyOf dcterms:type ,
                                          tara-kb:hasBibliographicMetadata ;
                       rdfs:range xsd:string ;
                       rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasBibliographicMetadata
tara-kb:hasBibliographicMetadata rdf:type owl:AnnotationProperty ;
                                 obo:IAO_0000112 "E.g., \"Smith J, et al. (2021). Acupuncture for chronic low back pain. J Altern Complement Med. 27(4):301-310.\" while also grouping hasArticleTitle, hasListedAuthors, hasPublicationDate, hasPublicationVenue, and hasPublicationLink."@en ;
                                 dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                 dcterms:description "A dual-purpose annotation property that serves as a super-property to logically group granular bibliographic sub-properties (e.g., titles, identifiers, and venues), while simultaneously acting as a direct container for a complete, pre-formatted human-readable citation string (such as APA, MLA, or Chicago styles)."@en ;
                                 tara-ap:hasCompactURI "tara-kb:hasBibliographicMetadata" ;
                                 tara-ap:hasSynonym "Publication Metadata" ;
                                 rdfs:label "Bibliographic Metadata" ;
                                 skos:altLabel "Bibliographic_Metadata" ;
                                 rdfs:subPropertyOf tara-kb:hasExtractedArticleMetadata ;
                                 rdfs:range xsd:string ;
                                 rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasBlindingQualityScore
tara-kb:hasBlindingQualityScore rdf:type owl:AnnotationProperty ;
                                obo:IAO_0000112 """Standardized Scoring Rubric (0–3 Scale)
- 3 (Excellent): The study explicitly details active methods used to enhance measurement quality and prevent bias (e.g., using a strictly blinded independent observer).
- 2 (Good): The study mentions that observers or assessors were \"blinded,\" but lacks hyper-specific details on the logistical execution (e.g., fails to mention when they entered the room).
- 1 (Poor): The study hints at attempts to keep measurements objective, but blinding is incomplete, or the design makes blinding highly vulnerable to unblinding.
- 0 (Non-compliant): No measures were taken to enhance measurement quality, or the outcomes were assessed openly by the same individuals who performed the intervention (high risk of bias)."""@en ,
                                                "e.g., a score of 2 when blinding status is stated for participants, practitioners, and outcome assessors, or 0 when blinding is not addressed."@en ;
                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                dcterms:description "Category C: Study Design and Analysis Metrics. The quality check score auditing whether the trial describes who was masked to assignments (e.g., patients, operators, assessors)." ;
                                tara-ap:hasAssessmentQuestion """Is it stated whether or not

(a) participants,

(b) those administering the interventions, and

(c) those assessing the outcomes were blinded? and

(d) was the success of participant blinding evaluated?"""@en ;
                                tara-ap:hasCompactURI "tara-kb:hasBlindingScore" ;
                                tara-ap:hasOCSIItemNumber "16"^^tara-kb:ocsiItemNumber ;
                                tara-ap:hasScoringInstructions """(a) It must state that patients were blinded to group assignments. If the trial was a comparison of active treatments, this will be scored N/A.

(b) Practitioners are almost always NOT blinded in acupuncture research; this will usually be scored N/A.

(c) It must state whether or not the persons performing outcome measures were blinded to group assignments.

(d) For full credit, authors must state that the success of participant blinding was evaluated and present the results of the assessment."""@en ;
                                tara-ap:hasSynonym "hasDetectionBiasMitigationScore"@en ;
                                rdfs:label "Blinding Quality Score" ;
                                skos:altLabel "Blinding_Quality_Score" ;
                                rdfs:subPropertyOf tara-kb:hasStudyDesignAndAnalysisMetrics ;
                                rdfs:range tara-kb:ocsiItemScore ;
                                rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasCointerventionsScore
tara-kb:hasCointerventionsScore rdf:type owl:AnnotationProperty ;
                                obo:IAO_0000112 "e.g., a score of 2 when permitted or prohibited co-interventions are explicitly stated, or 0 when co-interventions are not mentioned."@en ;
                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                dcterms:description "Category B: Acupuncture Intervention Metrics (STRICTA). The reporting assessment score evaluating whether extra pharmaceutical drugs or parallel therapies are tracked or declared." ;
                                tara-ap:hasAssessmentQuestion "Are details of the acupuncture group cointervention(s) presented? (e.g., moxa, cupping, life-style advice, plum-blossom needling, Chinese herbs)"@en ;
                                tara-ap:hasCompactURI "tara-kb:hasCointerventionsScore" ;
                                tara-ap:hasOCSIItemNumber "7"^^tara-kb:ocsiItemNumber ;
                                tara-ap:hasScoringInstructions "It refers only to cointerventions within the scope of acupuncture licensure. If the protocol specifies the option of prescribed self-help treatments, for example, exercise advice, stretching, or qi gong, these must also be described. Scored N/A if no adjunctive treatment was provided to the acupuncture group."@en ;
                                rdfs:label "Cointerventions Score" ;
                                skos:altLabel "Cointerventions_Score" ;
                                rdfs:subPropertyOf tara-kb:hasAcupunctureInterventionMetrics ;
                                rdfs:range tara-kb:ocsiItemScore ;
                                rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasComparativeFindings
tara-kb:hasComparativeFindings rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 "e.g., \"EA therapy showed functional improvement in the lumbar spine, but the improvement in motion recovery was not significantly different from PRF.\"."@en ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "Captures how different active treatment arms performed relative to each other across different parameters."@en ;
                               tara-ap:hasCompactURI "tara-kb:hasComparativeFindings" ;
                               rdfs:comment "Captures how different active treatment arms performed relative to each other across different parameters. Example: \"EA therapy showed functional improvement in the lumbar spine, but the improvement in motion recovery was not significantly different from PRF.\"" ;
                               rdfs:label "Comparative Findings" ;
                               skos:altLabel "Comparative_Findings" ;
                               rdfs:subPropertyOf dcterms:description ,
                                                  tara-kb:hasStudyFindings ;
                               rdfs:range xsd:string ;
                               rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasControlGroupsDetails
tara-kb:hasControlGroupsDetails rdf:type owl:AnnotationProperty ;
                                obo:IAO_0000112 """Control Arm 1 - Sham Acupuncture: Deployed Streitberger non-penetrating placebo needles at valid acupoints. Patients were successfully blinded to needle penetration, though mild skin pressure-induced neurological stimulation remains a potential confounding physiological sham effect.

Control Arm 2 - Non-Acupoint Real Needling: Used identical standard 0.25mm stainless steel needles fully inserted to standard depths (15mm), but placed 2-3 cm away from traditional meridians in anatomically neutral zones to test point-specificity.

Control Arm 3 - Active Control: Standard Care regimen consisting of prescribed physical therapy twice weekly and open-label Naproxen (500mg daily) to evaluate clinical superiority."""@en ,
                                                "Sham acupuncture: Patients received sham acupuncture once a week for 6 weeks, using blunt-tipped needles that did not penetrate the skin, as a control group to compare with true acupuncture."@en ;
                                dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                dcterms:description "An annotation property to capture structured details about the control group methodologies (control arms) deployed within a clinical trial study, as reported in a journal publication. It explicitly documents the specific type of control utilized, such as sham interventions, non-acupoint/minimal treatments, active controls, or waitlists, along with critical methodological protocols, including patient blinding mechanisms, the physiological nature of the control, and any deviations from standard or traditional practices meant to isolate specific therapeutic variables."@en ;
                                tara-ap:hasCompactURI "tara-kb:hasControlGroupsDetails" ;
                                rdfs:comment """Acupuncture control groups are fundamentally classified into four main methodological paradigms:
1) Sham Acupuncture: Placebo needling using non-penetrating retracting devices to isolate needling-specific effects;
2) Real Acupuncture at Non-Acupoints: Minimal acupuncture using standard needles at non-meridian locations to isolate point-specificity;
3) Active Control: Ttreatment-as-usual, standard care, or pharmacotherapy to test clinical superiority/equivalence; and
4) Waitlist or No-Treatment Control: To measure natural disease progression. 

Note: Researchers must account for the 'physiological sham effect,' where even non-penetrating skin pressure or non-acupoint stimulation can trigger local neurological and circulatory responses, meaning these controls are rarely completely inert."""@en ;
                                rdfs:label "Control Groups Details" ;
                                skos:altLabel "Control_Groups_Details" ;
                                rdfs:subPropertyOf dcterms:description ,
                                                   tara-kb:hasStudyDesignMetadata ;
                                rdfs:range xsd:string ;
                                rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasControlGroupsScore
tara-kb:hasControlGroupsScore rdf:type owl:AnnotationProperty ;
                              obo:IAO_0000112 "e.g., a score of 2 when the rationale and precise composition of each comparator arm are described, or 0 when comparator groups are only named without detail."@en ;
                              dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                              dcterms:description "Category B: Acupuncture Intervention Metrics (STRICTA). The quality check score evaluating how thoroughly the rationales and structural formats of the comparative groups are reported." ;
                              tara-ap:hasAssessmentQuestion """(a) Is the intended effect of the control or comparison intervention presented?

(b) Were the specific explanations given to patients of the treatment and control interventions presented?

(c) Are details for the control or comparison intervention presented?

(d) Are sources provided, that justify the choice of the control or comparison intervention?"""@en ;
                              tara-ap:hasCompactURI "tara-kb:hasControlGroupsScore" ;
                              tara-ap:hasOCSIItemNumber "9"^^tara-kb:ocsiItemNumber ;
                              tara-ap:hasScoringInstructions """A no-treatment control is scored the same as a sham or comparison control.

(a) Intended effect refers to the specific rationale for choosing the control (including no treatment).

(b) Specific explanations refers to the specific wording the patient receives regarding the treatment and control procedures.

(c) Details refers to a precise description of the control intervention, including (if applicable, e.g., invasive sham) the parameters of needling (item 5(a)-(g)). This includes no treatment controls, for example, who may have been required to keep diaries. If no tracking was performed, it must be stated.

(d) Justification refers to citing journals, textbooks, practitioner survey, or an expert consensus panel."""@en ;
                              rdfs:label "Control Groups Score" ;
                              skos:altLabel "Control_Groups_Score" ;
                              rdfs:subPropertyOf tara-kb:hasAcupunctureInterventionMetrics ;
                              rdfs:range tara-kb:ocsiItemScore ;
                              rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasCountryOfStudy
tara-kb:hasCountryOfStudy rdf:type owl:AnnotationProperty ;
                          obo:IAO_0000112 "e.g., \"South Korea\" or \"United States\"."@en ;
                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                          dcterms:description "The country (or countries, for multi-site trials) in which the study was conducted, normalized to a standard country name."@en ;
                          tara-ap:hasCompactURI "tara-kb:hasCountryOfStudy" ;
                          rdfs:label "Country of Study"@en ;
                          skos:altLabel "Country_Of_Study" ;
                          rdfs:subPropertyOf dcterms:relation ,
                                             tara-kb:hasStudyLocation ;
                          rdfs:range xsd:string ;
                          rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasDOILink
tara-kb:hasDOILink rdf:type owl:AnnotationProperty ;
                   obo:IAO_0000112 "e.g., \"https://doi.org/10.1089/acm.2021.0142\"."@en ;
                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                   dcterms:description "The resolvable URI (typically expressed as a DOI-based URL) that uniquely and persistently identifies the publication."@en ;
                   tara-ap:hasCompactURI "tara-kb:hasDOILink" ;
                   rdfs:label "DOI Link" ;
                   skos:altLabel "DOI_Link" ;
                   rdfs:subPropertyOf dcterms:identifier ,
                                      tara-kb:hasPublicationLink ;
                   rdfs:range xsd:anyURI ;
                   rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_8223728> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasDatasetLink
tara-kb:hasDatasetLink rdf:type owl:AnnotationProperty ;
                       obo:IAO_0000112 "e.g., \"https://clinicaltrials.gov/study/NCT01234567\"."@en ;
                       dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                       dcterms:description "A resolvable URI pointing to a publicly available raw dataset, supplementary data, or trial registry entry associated with the study."@en ;
                       tara-ap:hasCompactURI "tara-kb:hasDatasetLink" ;
                       rdfs:label "Dataset Link" ;
                       skos:altLabel "Dataset_Link" ;
                       rdfs:subPropertyOf dcterms:relation ,
                                          tara-kb:hasAcupunctureStudyMetadata ;
                       rdfs:range xsd:anyURI ;
                       rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasEligibilityScore
tara-kb:hasEligibilityScore rdf:type owl:AnnotationProperty ;
                            obo:IAO_0000112 "e.g., a score of 2 when both inclusion and exclusion criteria are explicitly listed, 1 when only partially described, or 0 when absent from the article."@en ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "Category A: Study Rationale and Scope Metrics. The reporting score tracking how clearly the inclusion and exclusion criteria for study participants were defined." ;
                            tara-ap:hasAssessmentQuestion """(a) Are the eligibility criteria (inclusion and exclusion criteria) stated and

(b) are the setting(s) and location(s) where the data was collected described?"""@en ;
                            tara-ap:hasCompactURI "tara-kb:hasEligibilityScore" ;
                            tara-ap:hasOCSIItemNumber "3"^^tara-kb:ocsiItemNumber ;
                            tara-ap:hasScoringInstructions """(a) The distinction between inclusion and exclusion criteria is unnecessary; for example, an exclusion criterion may be listed as a negative within the inclusion criteria. Stating the patient demographics and clinical characteristics after recruitment (e.g., post hoc demographics) does not qualify as eligibility criteria.

(b) Settings, for example, private practice or outpatient clinic, and Locations, for example, medical center or acupuncture college, can be implied from the author affiliation information."""@en ;
                            rdfs:label "Eligibility Score" ;
                            skos:altLabel "Eligibility_Score" ;
                            rdfs:subPropertyOf tara-kb:hasStudyRationaleAndScopeMetrics ;
                            rdfs:range tara-kb:ocsiItemScore ;
                            rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasExtractedArticleMetadata
tara-kb:hasExtractedArticleMetadata rdf:type owl:AnnotationProperty ;
                                    dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                    dcterms:description "A top-level grouping annotation property that organizes all metadata extracted from a trial study and its reporting publication into the bibliographic metadata and study metadata branches."@en ;
                                    dcterms:type tara-kb:grouping ;
                                    tara-ap:hasCompactURI "tara-kb:hasExtractedArticleMetadata" ;
                                    rdfs:label "Extracted Article Metadata"@en ;
                                    skos:altLabel "Extracted_Article_Metadata"@en ;
                                    rdfs:subPropertyOf tara-kb:hasTARAArticlesMetadata .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasFrequencyOfTreatmentScore
tara-kb:hasFrequencyOfTreatmentScore rdf:type owl:AnnotationProperty ;
                                     obo:IAO_0000112 "e.g., a score of 2 when the number, interval, and total duration of sessions are all specified, or 0 when the treatment schedule is not reported."@en ;
                                     dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                     dcterms:description "Category B: Acupuncture Intervention Metrics (STRICTA). The reporting item score checking if treatment intervals, session patterns, and total schedules are documented." ;
                                     tara-ap:hasAssessmentQuestion """Are the

(a) number and

(b) frequency of treatments stated?"""@en ;
                                     tara-ap:hasCompactURI "tara-kb:hasFrequencyOfTreatmentScore" ;
                                     tara-ap:hasOCSIItemNumber "6"^^tara-kb:ocsiItemNumber ;
                                     tara-ap:hasScoringInstructions """(a) If treatments were individualized, then the mean and range of the number of treatments must be stated.

(b) If the protocol was one treatment, then the frequency is N/A."""@en ;
                                     rdfs:label "Treatment Frequency Score" ;
                                     skos:altLabel "Frequency_Of_Treatment_Score" ;
                                     rdfs:subPropertyOf tara-kb:hasAcupunctureInterventionMetrics ;
                                     rdfs:range tara-kb:ocsiItemScore ;
                                     rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasGeneralizabilityScore
tara-kb:hasGeneralizabilityScore rdf:type owl:AnnotationProperty ;
                                 obo:IAO_0000112 "e.g., a score of 2 when the external validity of the findings is explicitly discussed, or 0 when generalizability is not addressed."@en ;
                                 dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                 dcterms:description "Category D: Results and Discussion Metrics. The reporting score assessing whether the generalizability (external validity) of the trial findings is discussed." ;
                                 tara-ap:hasAssessmentQuestion "Is the generalizability (external validity) of the trial findings discussed?"@en ;
                                 tara-ap:hasCompactURI "tara-kb:hasGeneralizabilityScore" ;
                                 tara-ap:hasOCSIItemNumber "26"^^tara-kb:ocsiItemNumber ;
                                 tara-ap:hasScoringInstructions "Generalizability pertains to the external validity or general applicability of the results -- for example, to what extent do the results, with the population limited by the eligibility criteria, pertain to the greater population with this condition. Topics to consider are eligibility criteria, setting and location, the intervention protocol, and the period of recruitment and followup."@en ;
                                 rdfs:label "Generalizability Score" ;
                                 skos:altLabel "Generalizability_Score" ;
                                 rdfs:subPropertyOf tara-kb:hasResultsAndDiscussionMetrics ;
                                 rdfs:range tara-kb:ocsiItemScore ;
                                 rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasHypothesisScore
tara-kb:hasHypothesisScore rdf:type owl:AnnotationProperty ;
                           obo:IAO_0000112 "e.g., a score of 2 when both specific objectives and a stated hypothesis are given, or 0 when neither is present."@en ;
                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "Category A: Study Rationale and Scope Metrics. The sub-score assessing whether the article states specific objectives and a hypothesis to be tested." ;
                           tara-ap:hasAssessmentQuestion """Are there statements of

(a) specific objectives and

(b) hypotheses to be tested?"""@en ;
                           tara-ap:hasCompactURI "tara-kb:hasHypothesisScore" ;
                           tara-ap:hasOCSIItemNumber "10"^^tara-kb:ocsiItemNumber ;
                           tara-ap:hasScoringInstructions """(a) If objectives are clearly implied but not specifically stated, a Yes may be scored.

(b) The actual word hypothesis or a valid substitute, for example, theory, must be used."""@en ;
                           rdfs:label "Hypothesis Score" ;
                           skos:altLabel "Hypothesis_Score" ;
                           rdfs:subPropertyOf tara-kb:hasIntroductionAndHypothesisScore ;
                           rdfs:range tara-kb:ocsiItemScore ;
                           rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasInterpretationScore
tara-kb:hasInterpretationScore rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 "e.g., a score of 2 when the results are interpreted in the context of prior evidence, or 0 when no such interpretation is offered."@en ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "Category D: Results and Discussion Metrics. The reporting score assessing whether a general interpretation of the results is presented in the context of current evidence." ;
                               tara-ap:hasAssessmentQuestion "Is a general interpretation of the results presented, in the context of current evidence?"@en ;
                               tara-ap:hasCompactURI "tara-kb:hasInterpretationScore" ;
                               tara-ap:hasOCSIItemNumber "27"^^tara-kb:ocsiItemNumber ;
                               tara-ap:hasScoringInstructions "General interpretation pertains to how these results relate to previous research. For full credit, authors must cite and discuss the previous research."@en ;
                               rdfs:label "Interpretation Score" ;
                               skos:altLabel "Interpretation_Score" ;
                               rdfs:subPropertyOf tara-kb:hasResultsAndDiscussionMetrics ;
                               rdfs:range tara-kb:ocsiItemScore ;
                               rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasIntroductionAndHypothesisScore
tara-kb:hasIntroductionAndHypothesisScore rdf:type owl:AnnotationProperty ;
                                          obo:IAO_0000112 "e.g., a combined value of 4 when both the background/rationale and the objectives/hypothesis are fully reported (2 each), derived from its hasIntroductionScore and hasHypothesisScore sub-scores." ;
                                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                          dcterms:description "Category A: Study Rationale and Scope Metrics. The quality score measuring how completely the trial introduction presents clinical context, scientific rationale, and the stated objectives/hypothesis, derived as the sum of its two sub-scores." ;
                                          tara-ap:hasCompactURI "tara-kb:hasIntroductionAndHypothesisScore" ;
                                          rdfs:label "Introduction and Hypothesis Score" ;
                                          skos:altLabel "Introduction_And_Hypothesis_Score" ;
                                          rdfs:subPropertyOf tara-kb:hasStudyRationaleAndScopeMetrics ;
                                          rdfs:range tara-kb:nonNegShortInt ;
                                          rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasIntroductionScore
tara-kb:hasIntroductionScore rdf:type owl:AnnotationProperty ;
                             obo:IAO_0000112 "e.g., a score of 2 when both scientific background and rationale are provided, or 0 when neither is present."@en ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description "Category A: Study Rationale and Scope Metrics. The sub-score assessing whether the article's introduction provides scientific background and explains the rationale for the trial." ;
                             tara-ap:hasAssessmentQuestion """(a) Is scientific background provided and

(b) is the rationale explained?"""@en ;
                             tara-ap:hasCompactURI "tara-kb:hasIntroductionScore" ;
                             tara-ap:hasOCSIItemNumber "2"^^tara-kb:ocsiItemNumber ;
                             tara-ap:hasScoringInstructions """(a) Scientific background pertains to the previous research and the current understanding of the disease.

(b) Rationale pertains to the justification for the trial and/or the expected effects/benefits of the treatment."""@en ;
                             rdfs:label "Introduction Score" ;
                             skos:altLabel "Introduction_Score" ;
                             rdfs:subPropertyOf tara-kb:hasIntroductionAndHypothesisScore ;
                             rdfs:range tara-kb:ocsiItemScore ;
                             rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLLMExtractionPrompt
tara-kb:hasLLMExtractionPrompt rdf:type owl:AnnotationProperty ;
                               obo:IAO_0000112 """Paradigm A: Using it directly as a Unified JSON Container
:hasOutcomesMeasureX2Score rdf:type owl:AnnotationProperty ;
    :hasLLMExtractionPrompt \"\"\"{
        \"system\": \"You are an Acupucture clinical trial methodology appraiser. Output raw JSON\",
        \"user\": \"Check if primary outcomes are explicitly matched by statistical tests in text: {{ARTICLE_TEXT}}\"
    }\"\"\"^^xsd:string .

Paradigm B: Using it purely as a Parent/Grouping Property 
:hasResultsOutcomesScore rdf:type owl:DatatypeProperty ;
    rdfs:label \"Results Outcomes OCSI Score\" ;
    :hasLLMSystemPrompt \"You are an expert data transparency evaluator. Output raw JSON\" ;
    :hasLLMUserPrompt \"Evaluate if exact numeric p-values and CIs are provided in text: {{ARTICLE_TEXT}}\" ."""@en ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "A dual-purpose annotation property that serves as both a unified container for serialized JSON prompt strings and an organizational grouping property for granular sub-directives."@en ;
                               tara-ap:hasCompactURI "tara-kb:hasLLMExtractionPrompt" ;
                               rdfs:comment """Dual-use design:
1) Direct use: Can hold a single stringified JSON object containing both 'system' and 'user' keys for fast pipeline execution.
2) Taxonomic use: Acts as a structural parent grouping specialized sub-properties."""@en ,
                                            "This is an abstract parent property designed to organize specific prompting layers. In runtime execution environments, pipelines should query the specialized sub-properties rather than this root property to ensure structural separation between runtime environment configurations and target data tasks."@en ,
                                            "This property can be used as a contaier for structured payload specifying both system-level behavior and user-level extraction queries."@en ;
                               rdfs:label "LLM Extraction Prompt" ;
                               skos:altLabel "LLM_Extraction_Prompt" ;
                               rdfs:subPropertyOf dcterms:relation ;
                               rdfs:range rdf:JSON .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLLMSystemPrompt
tara-kb:hasLLMSystemPrompt rdf:type owl:AnnotationProperty ;
                           obo:IAO_0000112 """tara-kb:hasResultsOutcomesScore rdf:type owl:DatatypeProperty ;
    tara-kb:hasLLMSystemPrompt \"\"\"
    You are an expert clinical trial methodology annotator. 
    Your task is to analyze scientific text objectively. 
    Strict constraints: 
    1. Base your evaluation solely on explicit statements in the text. 
    2. Do not infer, extrapolate, or assume context.
    3. Output your final response strictly as a serialized JSON object matching this schema: 
       {\"score\": integer, \"confidence_interval_found\": boolean, \"rationale\": \"string\"}
    \"\"\" ."""@en ;
                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "A specialized annotation property that stores the system-level directives, including agent persona, cognitive constraints, guardrails, formatting parameters (e.g., rigid JSON schemas), and handling instructions for missing data or edge cases."@en ;
                           tara-ap:hasCompactURI "tara-kb:hasLLMSystemPrompt" ;
                           rdfs:comment "Content stored under this property must be injected into the system role array of the LLM chat completion API payload. It controls how the model operates globally across all evaluations, enforcing objectivity and preventing hallucination."@en ;
                           rdfs:label "LLM System Prompt"@en ;
                           skos:altLabel "LLM_System_Prompt"@en ;
                           rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLLMUserPrompt
tara-kb:hasLLMUserPrompt rdf:type owl:AnnotationProperty ;
                         obo:IAO_0000112 """tara-kb:hasResultsOutcomesScore rdf:type owl:AnnotationProperty ;
    tara-kb:hasLLMUserPrompt \"\"\"
    Review the 'Results' section of the attached full-text article.
    Locate all reported endpoints associated with the primary and secondary outcomes.
    Evaluate the completeness of reporting based on these strict rubric parameters:
    - Score 3: Exact numeric data, effect sizes, 95% Confidence Intervals (CIs), and precise p-values are clearly provided for all outcomes.
    - Score 2: Main findings are provided, but exact statistical precision reporting is slightly flawed or lacks CIs for minor endpoints.
    - Score 1: Vague reporting or text-only declarations (e.g., 'differences were non-significant') without underlying data tables or exact values.
    - Score 0: No empirical data or results are presented for the stated outcomes.
    
    Target Text to Evaluate: {{ARTICLE_TEXT}}
    \"\"\" ."""@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "A specialized annotation property that holds the element-specific extraction task, definitions, and grading criteria used to guide the LLM model's focus to a target variable or metric within the full-text article."@en ;
                         tara-ap:hasCompactURI "tara-kb:hasLLMUserPrompt" ;
                         rdfs:comment "Content stored under this property must be injected into the 'user' role array of the LLM chat completion API payload alongside the target article text. It acts as the direct query or instruction set for evaluating the schema field."@en ;
                         rdfs:label "LLM User Prompt" ;
                         skos:altLabel "LLM_User_Prompt" ;
                         rdfs:subPropertyOf tara-kb:hasLLMExtractionPrompt .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasLimitationsScore
tara-kb:hasLimitationsScore rdf:type owl:AnnotationProperty ;
                            obo:IAO_0000112 "e.g., a score of 2 when a dedicated limitations discussion is present, or 0 when limitations are not addressed at all."@en ;
                            dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                            dcterms:description "Category D: Results and Discussion Metrics. The quality grading evaluating whether the study authors adequately identified and discussed potential sources of bias or trial constraints." ;
                            tara-ap:hasAssessmentQuestion """Is an interpretation of the results presented that takes into account

(a) study hypotheses,

(b) sources of potential bias or imprecision, and

(c) the potential dangers associated with multiple analyses and outcomes?"""@en ;
                            tara-ap:hasCompactURI "tara-kb:hasLimitationsScore" ;
                            tara-ap:hasOCSIItemNumber "25"^^tara-kb:ocsiItemNumber ;
                            tara-ap:hasScoringInstructions """(a) The relevance of the findings to the hypotheses or objectives must be discussed.

(b) The strengths and weakness of the trial must be discussed, particularly in the context of potential for bias and imprecision of study findings.

(c) This is usually scored as N/A unless numerous analyses, both prespecified and exploratory, were performed."""@en ;
                            rdfs:label "Limitations Score" ;
                            skos:altLabel "Limitations_Score" ;
                            rdfs:subPropertyOf tara-kb:hasResultsAndDiscussionMetrics ;
                            rdfs:range tara-kb:ocsiItemScore ;
                            rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_2825659> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAcupoints
tara-kb:hasListedAcupoints rdf:type owl:AnnotationProperty ;
                           obo:IAO_0000112 "E.g., \"BL 1, BL 2, BL 3\" (see rdfs:comment for normalization rules)."@en ;
                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "A dual-purpose annotation property that serves as a super-property grouping the mapped and unmappable acupoint sub-properties, while simultaneously acting as a direct container for the comma-separated, normalized list of acupoints extracted from the article."@en ;
                           tara-ap:hasCompactURI "tara-kb:hasListedAcupoints" ;
                           rdfs:comment "The list should exclude sham acupoints from this field. Instruct the LLM to normalize the extracted acupoints as comma-separated values; e.g., BL 1, BL 2, BL 3. Instruct to exclude the texts inside parentheses/brackets (typically synonyms) to normalize the extracted list."@en ;
                           rdfs:label "Listed Acupoint(s)" ;
                           skos:altLabel "Listed_Acupoints" ;
                           rdfs:subPropertyOf dcterms:description ,
                                              tara-kb:hasAcupunctureProtocol ;
                           rdfs:range xsd:string ;
                           rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAcupointsMapped
tara-kb:hasListedAcupointsMapped rdf:type owl:AnnotationProperty ;
                                 obo:IAO_0000112 "E.g., \"TARA:5363236\" representing acupoint \"GB 8\"."@en ;
                                 dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                 dcterms:description "A specialized mapping annotation property used to store an individual, authoritative controlled vocabulary IRI from the TARA ontology representing a specific anatomical acupuncture point successfully resolved from a publication's raw text list."@en ;
                                 tara-ap:hasCompactURI "tara-kb:hasListedAcupointsMapped" ;
                                 rdfs:comment "Links the mapped TARA IRIs of the listed acupoints used in a study. Each assertion represents a single, un-ordered annotation entry holding an acupoint's full TARA IRI."@en ;
                                 rdfs:label "Listed Acupoint(s) Mapped" ;
                                 skos:altLabel "Listed_Acupoints_Mapped" ;
                                 rdfs:subPropertyOf tara-kb:hasListedAcupoints ;
                                 rdfs:range <http://www.acupunctureresearch.org/tara/ontology/TARA_1132428> ;
                                 rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAcupointsMappedCurie
tara-kb:hasListedAcupointsMappedCurie rdf:type owl:AnnotationProperty ;
                                      obo:IAO_0000112 """tara-kb:hasListedAcupointsMappedCurie '''{ \"TARA:5363236\": \"GB 8\",
                                                                     \"TARA:9987270\": \"GB 14\",
                                                                     \"TARA:2324295\": \"GB 20\",
                                                                    }'''^^rdf:JSON ."""@en ;
                                      dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                      dcterms:description "This property associates a flat dictionary lookup table of TARA standard CURIE mappings of listed acupoints used in a trial study. The internal payload is formatted as a JSON object string where keys are CURIE identifiers and values are rdfs:label of the points; e.g., {\"TARA:5363236\": \"GB 8\"}. It provides a flat lookup dictionary map for frontend UI execution."@en ;
                                      tara-ap:hasCompactURI "tara-kb:hasListedAcupointsMappedCurie" ;
                                      rdfs:comment "Associates a JSON object serving as a key-value data map that associates an acupoint's CURIE (key) with its human-readable display label (value). Intended for direct downstream application consumption to optimize localized UI rendering without graph traversal overhead."@en ;
                                      rdfs:label "Listed Acupoint(s) Mapped Curie" ;
                                      skos:altLabel "Listed_Acupoints_Mapped_Curie" ;
                                      rdfs:subPropertyOf tara-kb:hasListedAcupoints ;
                                      rdfs:range rdf:JSON ;
                                      rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAcupointsUnmappable
tara-kb:hasListedAcupointsUnmappable rdf:type owl:AnnotationProperty ;
                                     obo:IAO_0000112 "e.g., \"Ashi point\" or \"Motor point (non-standard)\" - extracted text with no corresponding TARA acupoint IRI."@en ;
                                     dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                     dcterms:description "A specialized tracking annotation property used to isolate and store individual literal text strings or non-standard acupoints extracted from a publication that could not be successfully resolved to a standard TARA ontology IRI."@en ;
                                     tara-ap:hasCompactURI "tara-kb:hasListedAcupointsUnmappable" ;
                                     rdfs:label "Listed Acupoint(s) Unmappable" ;
                                     skos:altLabel "Listed_Acupoints_Unmappable" ;
                                     rdfs:subPropertyOf tara-kb:hasListedAcupoints ;
                                     rdfs:range xsd:string ;
                                     rdfs:domain <http://www.acupunctureresearch.org/tara/ontology/TARA_6701896> .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasListedAuthors
tara-kb:hasListedAuthors rdf:type owl:AnnotationProperty ;
                         obo:IAO_0000112 "e.g., \"Smith J, Lee K, Chen H\"."@en ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "The full list of authors credited on the publication, typically recorded as a single delimited string in the order they appear on the article."@en ;
