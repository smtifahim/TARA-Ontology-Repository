                                                         skos:prefLabel "Methodological_And_Statistical_Allocation_Metrics" ;
                                                         rdfs:subPropertyOf tara-kb:hasOCSIScoreMetadata ;
                                                         rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasNeedlingDetails
tara-kb:hasNeedlingDetails rdf:type owl:AnnotationProperty ;
                           <http://purl.obolibrary.org/obo/IAO_0000112> "\"0.30 mm diameter, 25 mm long stainless steel needles inserted to a depth of 15-20 mm and retained for 20 minutes.\""@en ,
                                                                        "\"Sterile, single-use coated acupuncture needles, 0.25-0.30 mm thick, 25-40 mm long; 10 to 25 needles per treatment; inserted 2-20 mm in depth; retained for 30 min.\"" ;
                           dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                           dcterms:description "The specific needling technique details reported for the acupuncture intervention, such as needle type, gauge, insertion depth, retention time, and elicitation of de qi."@en ;
                           tara:hasCompactURI "tara-kb:hasNeedlingDetails" ;
                           rdfs:label "Needling Details" ;
                           skos:prefLabel "Needling_Details" ;
                           rdfs:subPropertyOf dcterms:description ,
                                              tara-kb:hasAcupunctureProtocol ;
                           rdfs:range xsd:string ;
                           rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasNeedlingParametersScore
tara-kb:hasNeedlingParametersScore rdf:type owl:AnnotationProperty ;
                                   <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., a score of 2 when needle gauge, insertion depth, and de qi response are all reported, or 0 when none of these parameters are given."@en ;
                                   dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                                   dcterms:description "Category B: Technical Intervention Quality Metrics (STRICTA). The technical item score checking the completeness of needle parameters reported (e.g., gauge, depth, de qi sensation)." ;
                                   tara:hasCompactURI "tara-kb:hasNeedlingParametersScore" ;
                                   rdfs:label "Needling Parameters Score" ;
                                   skos:prefLabel "Needling_Parameters_Score" ;
                                   rdfs:subPropertyOf tara-kb:hasTechnicalInterventionQualityMetrics ;
                                   rdfs:range tara:TARA_5972061 ;
                                   rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOCSIAppraisal
tara-kb:hasOCSIAppraisal rdf:type owl:AnnotationProperty ;
                         dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                         dcterms:description "A cross-linking annotation property designed to link the specific acupuncture clinical trial study (represented by the 'Acupuncture Research Study' class) to an individual Oregon CONSORT STRICTA Instrument (OCSI) appraisal dataset instance (represented by the 'Acupuncture Study OCSI Appraisal' class). The 'Acupuncture Research Study' serves as the primary input for the quality-of-reporting assessment represented by the 'Acupuncture Study OCSI Appraisal' class." ;
                         tara:hasCompactURI "tara-kb:hasOCSIAppraisal" ;
                         rdfs:label "Has OCSI Appraisal" ;
                         skos:prefLabel "Has_OCSI_Appraisal" ;
                         rdfs:subPropertyOf dcterms:relation ;
                         rdfs:range tara:TARA_2825659 ;
                         rdfs:domain tara:TARA_6701896 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOCSIInputStudy
tara-kb:hasOCSIInputStudy rdf:type owl:AnnotationProperty ;
                          dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                          dcterms:description "A cross-linking annotation property designed to link an individual Oregon CONSORT STRICTA Instrument (OCSI) appraisal dataset instance (represented by the 'Acupuncture Study Quality Appraisal' class) back to the specific acupuncture clinical trial study (represented by the 'Acupuncture Research Study' class) served as the primary input for the quality-of-reporting assessment." ;
                          tara:hasCompactURI "tara-kb:hasOCSIInputStudy" ;
                          rdfs:label "Has OCSI Input Study" ;
                          skos:prefLabel "Has_OCSI_Input_Study" ;
                          rdfs:subPropertyOf dcterms:relation ;
                          rdfs:range tara:TARA_6701896 ;
                          rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOCSIScoreMetadata
tara-kb:hasOCSIScoreMetadata rdf:type owl:AnnotationProperty ;
                             dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                             dcterms:description """An annotation property that serves as a master grouping property for capturing quality appraisal metrics mapped to individual reporting items within the Oregon CONSORT STRICTA Instrument (OCSI) for acupuncture trials. 

Crucially, the scores and details grouped under this property are not native metrics extracted directly or verbatim from the published articles. Instead, they represent secondary, derived appraisals generated, either algorithmically by automated computational models or manually judged by human domain experts by analyzing the extracted textual metadata of the trial against the specific compliance benchmarks defined by the OCSI framework."""@en ;
                             tara:hasCompactURI "tara-kb:hasOCSIScoreMetadata" ;
                             rdfs:comment "This sub-grouping property aggregates derived compliance values specifically tied to the combined CONSORT (Consolidated Standards of Reporting Trials) and STRICTA (Standards for Reporting Interventions in Clinical Trials of Acupuncture) guidelines. It organizes granular sub-properties tracking item-by-item compliance scores (e.g., needle stimulation details, control group rationale), separating the calculated evaluation of reporting quality from the raw extracted study parameters."@en ;
                             rdfs:label "OCSI Score Metadata" ;
                             skos:prefLabel "OCSI_Score_Metadata" ;
                             rdfs:subPropertyOf tara-kb:hasStudyQualityAppraisalMetadata ;
                             rdfs:domain tara:TARA_2825659 .


###  http://www.acupunctureresearch.org/tara/ontology/kb/hasOCSITotalPercentage
tara-kb:hasOCSITotalPercentage rdf:type owl:AnnotationProperty ;
                               <http://purl.obolibrary.org/obo/IAO_0000112> "e.g., 82.5 (representing 82.5% overall compliance across all OCSI-scored items)."@en ;
                               dcterms:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
                               dcterms:description "A quality metric within Category D: Evaluative Results & Global Metrics that assigns the global mathematical reporting accuracy value calculated as a raw percentage summarizing compliance across all combined item criteria." ;
                               tara:hasCompactURI "tara-kb:hasOCSITotalPercentage" ;
                               rdfs:label "OCSI Total Percentage" ;
                               skos:prefLabel "OCSI_Total_Percentage" ;
                               rdfs:subPropertyOf tara-kb:hasEvaluativeResultsAndGlobalMetrics ;
                               rdfs:range tara:TARA_6560239 ;
                               rdfs:domain tara:TARA_2825659 .


