@prefix : <http://www.acupunctureresearch.org/tara/ontology/tara-annotation-properties.ttl> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tara: <http://www.acupunctureresearch.org/tara/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix protege: <http://protege.stanford.edu/plugins/owl/protege#> .
@prefix oboInOwl: <http://www.geneontology.org/formats/oboInOwl#> .
@base <http://www.acupunctureresearch.org/tara/ontology/tara-annotation-properties.ttl> .

<http://www.acupunctureresearch.org/tara/ontology/tara-annotation-properties.ttl> rdf:type owl:Ontology ;
                                                                                   rdfs:comment """This file includes a subset of metadata terms from Dublin Core (DC Terms), SKOS documentation properties, and annotation properties from Information Artifact Ontology (IAO). It only includes owl annotation properties specific to TARA Acupoints Ontology.
- About DC Terms: http://purl.org/dc/terms
- About SKOS: http://www.w3.org/2004/02/skos/core
- About IAO: https://github.com/information-artifact-ontology/IAO"""@en .

#################################################################
#    Annotation properties
#################################################################

###  http://protege.stanford.edu/plugins/owl/protege#defaultLanguage
protege:defaultLanguage rdf:type owl:AnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000111
<http://purl.obolibrary.org/obo/IAO_0000111> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "The value of this annotation property provides the preferred term that an editor has chosen, from among all the alternative terms available, to represent a given class or property in a human readable form."@en ;
                                             rdfs:label "editor preferred term"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000112
<http://purl.obolibrary.org/obo/IAO_0000112> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A phrase describing how a term should be used and/or a citation to a work which uses it. May also include other kinds of examples that facilitate immediate understanding, such as widely know prototypes or instances of a class, or cases where a relation is said to hold."@en ,
                                                                                          "The value of this annotation property shows the correct usage of the class or property to which it is attached, in the form of a natural-language sentence or a subject-predicate-object statement." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
                                             rdfs:isDefinedBy <http://purl.obolibrary.org/obo/iao.owl> ;
                                             rdfs:label "example of usage"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000114
<http://purl.obolibrary.org/obo/IAO_0000114> rdf:type owl:AnnotationProperty ;
                                             rdfs:label "has curation status"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000115
<http://purl.obolibrary.org/obo/IAO_0000115> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "The official definition, explaining the meaning of a class or property. Shall be Aristotelian, formalized and normalized. Can be augmented with colloquial definitions."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
                                             dcterms:description "The official definition, explaining the meaning of a class or property, shall be a genus-differentia definition wherever the term admits one; for primitive terms that cannot be defined non-circularly, an elucidation is supplied instead." ;
                                             rdfs:isDefinedBy <http://purl.obolibrary.org/obo/iao.owl> ;
                                             rdfs:label "definition"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000116
<http://purl.obolibrary.org/obo/IAO_0000116> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An administrative note intended for its editor. It may not be included in the publication version of the ontology, so it should contain nothing necessary for end users to understand the ontology."@en ,
                                                                                          "An administrative note intended for its editor. It might record a rationale for a design decision, flag whether a definition/example is a verbatim quotation from the source ontology versus a paraphrase/reconstruction, or explain how a term connects to a domain ontology (here, TARA) that depends on it." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:OBI:<http://purl.obofoundry.org/obo/obi>"@en ;
                                             rdfs:isDefinedBy <http://purl.obolibrary.org/obo/iao.owl> ;
                                             rdfs:label "editor note"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000118
<http://purl.obolibrary.org/obo/IAO_0000118> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A label for a class or property that can be used to refer to the class or property instead of the preferred rdfs:label. Alternative labels should be used to indicate community- or context-specific labels, abbreviations, shorthand forms and the like."@en ,
                                                                                          "An alternative name for a class or property, distinct from the editor preferred term (see IAO:0000111)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
                                             rdfs:comment "Consider re-defing to: An alternative name for a class or property which can mean the same thing as the preferred name (semantically equivalent, narrow, broad or related)." ;
                                             rdfs:label "alternative label"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000119
<http://purl.obolibrary.org/obo/IAO_0000119> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Formal citation -- e.g. the identifier of a document, an ISO/IEC standard, a book, a personal communication, or a URI -- for the source of a term's definition." ,
                                                                                          "Formal citation, e.g. identifier in external database to indicate / attribute source(s) for the definition. Free text indicate / attribute source(s) for the definition. EXAMPLE: Author Name, URI, MeSH Term C04, PUBMED ID, Wiki uri on 31.01.2007"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP:OBI:<http://purl.obolibrary.org/obo/obi>"@en ;
                                             rdfs:isDefinedBy <http://purl.obolibrary.org/obo/iao.owl> ;
                                             rdfs:label "definition source"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000232
<http://purl.obolibrary.org/obo/IAO_0000232> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An administrative note of use for a curator but of no use for a user"@en ;
                                             rdfs:isDefinedBy <http://purl.obolibrary.org/obo/iao.owl> ;
                                             rdfs:label "curator note"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000234
<http://purl.obolibrary.org/obo/IAO_0000234> rdf:type owl:AnnotationProperty ;
                                             rdfs:label "ontology term requester"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000412
<http://purl.obolibrary.org/obo/IAO_0000412> rdf:type owl:AnnotationProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Annotation property connecting a term to the ontology document, denoted by an IRI, from which it is imported."@en ;
                                             rdfs:label "imported from"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0000589
<http://purl.obolibrary.org/obo/IAO_0000589> rdf:type owl:AnnotationProperty ;
                                             rdfs:label "OBO foundry unique label"@en ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/IAO_0006012
<http://purl.obolibrary.org/obo/IAO_0006012> rdf:type owl:AnnotationProperty ;
                                             rdfs:label "scheduled for obsoletion on or after" ;
                                             rdfs:subPropertyOf tara:iaoAnnotationProperty .


###  http://purl.obolibrary.org/obo/RO_0002475
<http://purl.obolibrary.org/obo/RO_0002475> rdf:type owl:AnnotationProperty ;
                                            rdfs:label "has no connections with" ;
                                            rdfs:subPropertyOf tara:oboInOwlAnnotationProperty .


###  http://purl.obolibrary.org/obo/mondo#curated_content_resource
<http://purl.obolibrary.org/obo/mondo#curated_content_resource> rdf:type owl:AnnotationProperty ;
                                                                rdfs:subPropertyOf tara:mondoAnnotationProperty .


###  http://purl.obolibrary.org/obo/mondo#excluded_from_qc_check
<http://purl.obolibrary.org/obo/mondo#excluded_from_qc_check> rdf:type owl:AnnotationProperty ;
                                                              rdfs:subPropertyOf tara:mondoAnnotationProperty .


###  http://purl.obolibrary.org/obo/mondo#excluded_subClassOf
<http://purl.obolibrary.org/obo/mondo#excluded_subClassOf> rdf:type owl:AnnotationProperty ;
                                                           rdfs:subPropertyOf tara:mondoAnnotationProperty .


###  http://purl.obolibrary.org/obo/mondo#should_conform_to
<http://purl.obolibrary.org/obo/mondo#should_conform_to> rdf:type owl:AnnotationProperty ;
                                                         rdfs:subPropertyOf tara:mondoAnnotationProperty .


###  http://purl.org/dc/elements/1.1/contributor
dc:contributor rdf:type owl:AnnotationProperty ;
               rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/coverage
dc:coverage rdf:type owl:AnnotationProperty ;
            rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty ;
           rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty ;
        rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty ;
               rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/format
dc:format rdf:type owl:AnnotationProperty ;
          rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/identifier
dc:identifier rdf:type owl:AnnotationProperty ;
              rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/language
dc:language rdf:type owl:AnnotationProperty ;
            rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/member
dc:member rdf:type owl:AnnotationProperty ;
          rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/publisher
dc:publisher rdf:type owl:AnnotationProperty ;
             rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/relation
dc:relation rdf:type owl:AnnotationProperty ;
            rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/rights
dc:rights rdf:type owl:AnnotationProperty ;
          rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/source
dc:source rdf:type owl:AnnotationProperty ;
          rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/subject
dc:subject rdf:type owl:AnnotationProperty ;
           rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty ;
         rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/elements/1.1/type
dc:type rdf:type owl:AnnotationProperty ;
        rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/terms/abstract
dcterms:abstract rdf:type owl:AnnotationProperty ;
                 rdfs:isDefinedBy dcterms: ;
                 rdfs:label "abstract" ;
                 skos:definition "A summary of the resource."@en ;
                 rdfs:subPropertyOf dcterms:description .


###  http://purl.org/dc/terms/accessRights
dcterms:accessRights rdf:type owl:AnnotationProperty ;
                     rdfs:comment "Access Rights may include information regarding access or restrictions based on privacy, security, or other policies."@en ;
                     rdfs:label "Access Rights"@en ;
                     skos:definition "Information about who can access the resource or an indication of its security status."@en ;
                     rdfs:subPropertyOf dcterms:rights ;
                     rdfs:range dcterms:RightsStatement .


###  http://purl.org/dc/terms/alternative
dcterms:alternative rdf:type owl:AnnotationProperty ;
                    rdfs:comment "The distinction between titles and alternative titles is application-specific."@en ;
                    rdfs:label "Alternative Title"@en ;
                    skos:definition "An alternative name for the resource."@en ;
                    skos:note "In current practice, this term is used primarily with literal values; however, there are important uses with non-literal values as well. As of December 2007, the DCMI Usage Board is leaving this range unspecified pending an investigation of options."@en ;
                    rdfs:subPropertyOf dcterms:title .


###  http://purl.org/dc/terms/available
dcterms:available rdf:type owl:AnnotationProperty ;
                  rdfs:label "Date Available"@en ;
                  skos:definition "Date (often a range) that the resource became or will become available."@en ;
                  rdfs:subPropertyOf dcterms:date ;
                  rdfs:range rdfs:Literal .


###  http://purl.org/dc/terms/bibliographicCitation
dcterms:bibliographicCitation rdf:type owl:AnnotationProperty ;
                              rdfs:comment "Recommended practice is to include sufficient bibliographic detail to identify the resource as unambiguously as possible." ;
                              rdfs:label "Bibliographic Citation"@en ;
                              skos:definition "A bibliographic reference for the resource."@en ;
                              rdfs:subPropertyOf dcterms:identifier ;
                              rdfs:range rdfs:Literal ;
                              rdfs:domain dcterms:BibliographicResource .


###  http://purl.org/dc/terms/conformsTo
dcterms:conformsTo rdf:type owl:AnnotationProperty ;
                   rdfs:label "Conforms To"@en ;
                   skos:definition "An established standard to which the described resource conforms."@en ;
                   rdfs:subPropertyOf dcterms:relation ;
                   rdfs:range dcterms:Standard .


###  http://purl.org/dc/terms/contributor
dcterms:contributor rdf:type owl:AnnotationProperty ;
                    rdfs:comment "Examples of a Contributor include a person, an organization, or a service. Typically, the name of a Contributor should be used to indicate the entity."@en ;
                    rdfs:label "Contributor"@en ;
                    skos:definition "An entity responsible for making contributions to the resource."@en ;
                    rdfs:subPropertyOf dc:contributor .


###  http://purl.org/dc/terms/coverage
dcterms:coverage rdf:type owl:AnnotationProperty ;
                 rdfs:comment "Spatial topic and spatial applicability may be a named place or a location specified by its geographic coordinates. Temporal topic may be a named period, date, or date range. A jurisdiction may be a named administrative entity or a geographic place to which the resource applies. Recommended best practice is to use a controlled vocabulary such as the Thesaurus of Geographic Names [TGN]. Where appropriate, named places or time periods can be used in preference to numeric identifiers such as sets of coordinates or date ranges."@en ;
                 rdfs:label "Coverage"@en ;
                 skos:definition "The spatial or temporal topic of the resource, the spatial applicability of the resource, or the jurisdiction under which the resource is relevant."@en ;
                 rdfs:subPropertyOf dc:coverage ;
                 rdfs:range dcterms:LocationPeriodOrJurisdiction .


###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty ;
                rdfs:label "Date Created"@en ;
                skos:definition "Date of creation of the resource."@en ;
                rdfs:subPropertyOf dcterms:date ;
                rdfs:range rdfs:Literal .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty ;
                rdfs:comment "Examples of a Creator include a person, an organization, or a service. Typically, the name of a Creator should be used to indicate the entity."@en ;
                rdfs:label "Creator"@en ;
                skos:definition "An entity primarily responsible for making the resource."@en ;
                rdfs:subPropertyOf dc:creator ,
                                   dcterms:contributor .


###  http://purl.org/dc/terms/date
dcterms:date rdf:type owl:AnnotationProperty ;
             dcterms:bibliographicCitation "[W3CDTF] http://www.w3.org/TR/NOTE-datetime" ;
             rdfs:comment "Date may be used to express temporal information at any level of granularity. Recommended best practice is to use an encoding scheme, such as the W3CDTF profile of ISO 8601 [W3CDTF]."@en ;
             rdfs:label "Date"@en ;
             rdfs:seeAlso <http://www.w3.org/TR/NOTE-datetime> ;
             skos:definition "A point or period of time associated with an event in the lifecycle of the resource."@en ;
             rdfs:subPropertyOf dc:date ;
             rdfs:range rdfs:Literal .


###  http://purl.org/dc/terms/dateAccepted
dcterms:dateAccepted rdf:type owl:AnnotationProperty ;
                     rdfs:comment "Examples of resources to which a Date Accepted may be relevant are a thesis (accepted by a university department) or an article (accepted by a journal)."@en ;
                     rdfs:label "Date Accepted"@en ;
                     skos:definition "Date of acceptance of the resource."@en ;
                     rdfs:subPropertyOf dcterms:date ;
                     rdfs:range rdfs:Literal .


###  http://purl.org/dc/terms/dateCopyrighted
dcterms:dateCopyrighted rdf:type owl:AnnotationProperty ;
                        rdfs:label "Date Copyrighted"@en ;
                        skos:definition "Date of copyright."@en ;
                        rdfs:subPropertyOf dcterms:date ;
                        rdfs:range rdfs:Literal .


###  http://purl.org/dc/terms/dateSubmitted
dcterms:dateSubmitted rdf:type owl:AnnotationProperty ;
                      rdfs:comment "Examples of resources to which a Date Submitted may be relevant are a thesis (submitted to a university department) or an article (submitted to a journal)."@en ;
                      rdfs:label "Date Submitted"@en ;
                      skos:definition "Date of submission of the resource."@en ;
                      rdfs:subPropertyOf dcterms:date ;
                      rdfs:range rdfs:Literal .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:comment "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource."@en ;
                    rdfs:isDefinedBy dcterms: ;
                    rdfs:label "description" ;
                    skos:definition "An account of the resource."@en ;
                    skos:note "Description may include but is not limited to: an abstract, a table of contents, a graphical representation, or a free-text account of the resource." ;
                    rdfs:subPropertyOf dc:description ,
                                       skos:note .


###  http://purl.org/dc/terms/extent
dcterms:extent rdf:type owl:AnnotationProperty ;
               rdfs:label "Extent"@en ;
               skos:definition "The size or duration of the resource."@en ;
               rdfs:subPropertyOf dcterms:format ;
               rdfs:range dcterms:SizeOrDuration .


###  http://purl.org/dc/terms/format
dcterms:format rdf:type owl:AnnotationProperty ;
               dcterms:bibliographicCitation "[MIME] http://www.iana.org/assignments/media-types/" ;
               rdfs:comment "Examples of dimensions include size and duration. Recommended best practice is to use a controlled vocabulary such as the list of Internet Media Types [MIME]."@en ;
               rdfs:label "Format"@en ;
               rdfs:seeAlso <http://www.iana.org/assignments/media-types/> ;
               skos:definition "The file format, physical medium, or dimensions of the resource."@en ;
               rdfs:subPropertyOf dc:format ;
               rdfs:range dc:contributor .


###  http://purl.org/dc/terms/hasFormat
dcterms:hasFormat rdf:type owl:AnnotationProperty ;
                  rdfs:label "Has Format"@en ;
                  skos:definition "A related resource that is substantially the same as the pre-existing described resource, but in another format."@en ;
                  skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                  rdfs:subPropertyOf dcterms:relation .


###  http://purl.org/dc/terms/hasVersion
dcterms:hasVersion rdf:type owl:AnnotationProperty ;
                   rdfs:label "Has Version"@en ;
                   skos:definition "A related resource that is a version, edition, or adaptation of the described resource."@en ;
                   skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                   rdfs:subPropertyOf dcterms:relation .


###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty ;
                   rdfs:comment "Recommended best practice is to identify the resource by means of a string conforming to a formal identification system."@en ;
                   rdfs:label "Identifier"@en ;
                   skos:definition "An unambiguous reference to the resource within a given context."@en ;
                   rdfs:subPropertyOf dc:identifier ;
                   rdfs:range rdfs:Literal .


###  http://purl.org/dc/terms/instructionalMethod
dcterms:instructionalMethod rdf:type owl:AnnotationProperty ;
                            rdfs:comment "Instructional Method will typically include ways of presenting instructional materials or conducting instructional activities, patterns of learner-to-learner and learner-to-instructor interactions, and mechanisms by which group and individual levels of learning are measured. Instructional methods include all aspects of the instruction and learning processes from planning and implementation through evaluation and feedback."@en ;
                            rdfs:label "Instructional Method"@en ;
                            skos:definition "A process, used to engender knowledge, attitudes and skills, that the described resource is designed to support."@en ;
                            rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/terms/isReferencedBy
dcterms:isReferencedBy rdf:type owl:AnnotationProperty ;
                       rdfs:label "Is Referenced By"@en ;
                       skos:definition "A related resource that references, cites, or otherwise points to the described resource."@en ;
                       skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                       rdfs:subPropertyOf dcterms:relation .


###  http://purl.org/dc/terms/isReplacedBy
dcterms:isReplacedBy rdf:type owl:AnnotationProperty ;
                     rdfs:label "Is Replaced By"@en ;
                     skos:definition "A related resource that supplants, displaces, or supersedes the described resource."@en ;
                     skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                     rdfs:subPropertyOf dcterms:relation .


###  http://purl.org/dc/terms/isRequiredBy
dcterms:isRequiredBy rdf:type owl:AnnotationProperty ;
                     rdfs:label "Is Required By"@en ;
                     skos:definition "A related resource that requires the described resource to support its function, delivery, or coherence."@en ;
                     skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                     rdfs:subPropertyOf dcterms:relation .


###  http://purl.org/dc/terms/isVersionOf
dcterms:isVersionOf rdf:type owl:AnnotationProperty ;
                    rdfs:comment "Changes in version imply substantive changes in content rather than differences in format."@en ;
                    rdfs:label "Is Version Of"@en ;
                    skos:definition "A related resource of which the described resource is a version, edition, or adaptation."@en ;
                    skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                    rdfs:subPropertyOf dcterms:relation .


###  http://purl.org/dc/terms/issued
dcterms:issued rdf:type owl:AnnotationProperty ;
               rdfs:label "Date Issued"@en ;
               skos:definition "Date of formal issuance (e.g., publication) of the resource."@en ;
               rdfs:subPropertyOf dcterms:date ;
               rdfs:range rdfs:Literal .


###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty ;
                rdfs:label "License"@en ;
                skos:definition "A legal document giving official permission to do something with the resource."@en ;
                rdfs:subPropertyOf dcterms:rights ;
                rdfs:range dcterms:LicenseDocument .


