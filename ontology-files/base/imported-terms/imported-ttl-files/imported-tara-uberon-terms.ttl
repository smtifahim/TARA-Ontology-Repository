###  http://purl.obolibrary.org/obo/UBERON_0006137
<http://purl.obolibrary.org/obo/UBERON_0006137> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0006141> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/RO_0002170> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001410>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The proper palmar digital arteries travel along the sides of the phalanges (along the contiguous sides of the index, middle, ring, and little fingers), each artery lying just below its corresponding digital nerve. Alternative names for these arteries are: proper volar digital arteries, collateral digital arteries, arteriae digitales palmares propriae, or aa. digitales volares propriae. They anastomose freely in the subcutaneous tissue of the finger tips and by smaller branches near the interphalangeal joints. Each also gives off a couple of dorsal branches which anastomose with the dorsal digital arteries, and supply the soft parts on the back of the second and third phalanges, including the matrix of the fingernail. The proper palmar digital artery for the medial side of the little finger arises directly from the ulnar artery deep to the palmaris brevis muscle, but the rest arise from the common palmar digital arteries." ;
                                                oboInOwl:hasDbXref "EMAPA:37218" ,
                                                                   "FMA:70804" ,
                                                                   "MA:0001959" ,
                                                                   "SCTID:91778006" ,
                                                                   "Wikipedia:Proper_palmar_digital_arteries" ;
                                                oboInOwl:hasExactSynonym "arteriae digitales palmares propriae" ,
                                                                         "proper palmal digital arteries" ,
                                                                         "proper palmar digital arteries" ,
                                                                         "proper palmar digital arteries set" ;
                                                oboInOwl:hasRelatedSynonym "arteriae digitales palmares propriae" ,
                                                                           "proper volar digital arteries" ,
                                                                           "proper volar digital artery" ,
                                                                           "set of proper palmar digital arteries" ;
                                                rdfs:label "proper palmar digital artery" ;
                                                foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/a/a9/Gray1237.svg"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/UBERON_0006139
<http://purl.obolibrary.org/obo/UBERON_0006139> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0004564> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The plantar digital veins arise from plexuses on the plantar surfaces of the digits, and, after sending intercapitular veins to join the dorsal digital veins, unite to form four metatarsal veins." ;
                                                oboInOwl:hasDbXref "FMA:44517" ,
                                                                   "Wikipedia:Plantar_digital_veins" ;
                                                oboInOwl:hasRelatedSynonym "venae digitales plantares" ;
                                                rdfs:label "plantar digital vein" .


