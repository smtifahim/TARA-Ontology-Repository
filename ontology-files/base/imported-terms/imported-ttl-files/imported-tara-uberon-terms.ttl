###  http://purl.obolibrary.org/obo/UBERON_0013630
<http://purl.obolibrary.org/obo/UBERON_0013630> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0001474> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Short bones are designated as those bones that are as wide as they are long. Their primary function is to provide support and stability with little to no movement. They are one of five types of bones: long, short, flat, irregular and sesamoid. Examples of these bones include the tarsals in the foot and the carpals in the hand." ;
                                                <http://purl.obolibrary.org/obo/IAO_0000116> "TODO - make subclass links" ;
                                                oboInOwl:hasDbXref "FMA:7475" ,
                                                                   "NCIT:C33545" ,
                                                                   "SCTID:332807009" ,
                                                                   "Wikipedia:Short_bone" ;
                                                rdfs:label "short bone" .


###  http://purl.obolibrary.org/obo/UBERON_0013631
<http://purl.obolibrary.org/obo/UBERON_0013631> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0010911> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Ossicle that develops within bands of dense, regular connective tissue (e.g., tendons and ligaments). Sesamoids are generally located proximate to a bony prominence, over which the dense regular connective tissue wraps, and/or a joint or articulation." ;
                                                oboInOwl:hasDbXref "VSAO:0000137" ;
                                                oboInOwl:hasExactSynonym "sesamoid" ;
                                                rdfs:comment "Sesamoids are often endochondral replacement elements and in addition to bone tissue, may also be composed of articular cartilage, fibrocartilage, hyaline cartilage, and calcified cartilage." ;
                                                rdfs:label "sesamoid element" .


###  http://purl.obolibrary.org/obo/UBERON_0013646
<http://purl.obolibrary.org/obo/UBERON_0013646> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0011779> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0000375>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The buccal nerve (also called the long buccal nerve) is a nerve in the face. It is a branch of the mandibular nerve (which is itself a branch of the trigeminal nerve) and transmits sensory information from skin over the buccal membrane (in general, the cheek) and from the second and third molar teeth." ;
                                                oboInOwl:hasDbXref "BAMS:bucn" ,
                                                                   "FMA:53066" ,
                                                                   "SCTID:280253000" ,
                                                                   "Wikipedia:Buccal_nerve" ;
                                                oboInOwl:hasExactSynonym "buccinator nerve" ,
                                                                         "long buccal nerve" ;
                                                oboInOwl:hasRelatedSynonym "buccinator branch" ,
                                                                           "long buccal nerve" ;
                                                rdfs:label "buccal nerve" .


###  http://purl.obolibrary.org/obo/UBERON_0013648
<http://purl.obolibrary.org/obo/UBERON_0013648> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0001637> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The masseteric artery is small and passes laterally through the mandibular notch to the deep surface of the masseter muscle, which it supplies. It anastomoses with the masseteric branches of the external maxillary artery and with the transverse facial artery." ;
                                                oboInOwl:hasDbXref "FMA:49739" ,
                                                                   "NCIT:C53052" ,
                                                                   "SCTID:147864007" ,
                                                                   "UMLS:C0226149" ,
                                                                   "Wikipedia:Masseteric_artery" ;
                                                oboInOwl:hasExactSynonym "arteria masseterica" ;
                                                rdfs:label "masseteric artery" .


###  http://purl.obolibrary.org/obo/UBERON_0013685
<http://purl.obolibrary.org/obo/UBERON_0013685> rdf:type owl:Class ;
