###  http://purl.obolibrary.org/obo/UBERON_0001271
<http://purl.obolibrary.org/obo/UBERON_0001271> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0007823> ,
