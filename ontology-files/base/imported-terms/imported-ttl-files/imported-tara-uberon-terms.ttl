###  http://purl.obolibrary.org/obo/UBERON_0002380
<http://purl.obolibrary.org/obo/UBERON_0002380> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0001482> ,
                                                                <http://purl.obolibrary.org/obo/UBERON_0010313> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "A large superficial muscle that extends longitudinally from the occipital bone to the lower thoracic vertebrae and laterally to the spine of the scapula (shoulder blade). Its functions are to move the scapulae and support the arm. The trapezius has three functional regions: the superior region (descending part), which supports the weight of the arm; the intermediate region (transverse part), which retracts the scapulae; and the inferior region (ascending part), which medially rotates and depresses the scapulae. [WP,unvetted]." ;
                                                oboInOwl:hasDbXref "EMAPA:18183" ,
                                                                   "FMA:9626" ,
                                                                   "MA:0002398" ,
                                                                   "NCIT:C33809" ,
                                                                   "SCTID:181740005" ,
                                                                   "UMLS:C0224361" ,
                                                                   "VHOG:0000834" ,
                                                                   "Wikipedia:Trapezius_muscle" ;
                                                oboInOwl:hasExactSynonym "trapezius" ;
                                                oboInOwl:hasRelatedSynonym "musculus trapezius" ,
                                                                           "spinotrapezius" ;
                                                rdfs:label "trapezius muscle" ;
                                                foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/6/60/Trapezius.png"^^xsd:anyURI .


