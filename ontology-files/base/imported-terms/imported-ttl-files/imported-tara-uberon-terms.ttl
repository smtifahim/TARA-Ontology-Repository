###  http://purl.obolibrary.org/obo/UBERON_0009551
<http://purl.obolibrary.org/obo/UBERON_0009551> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0002529> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
