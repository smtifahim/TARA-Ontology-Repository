###  http://purl.obolibrary.org/obo/UBERON_0001653
<http://purl.obolibrary.org/obo/UBERON_0001653> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0003496> ,
