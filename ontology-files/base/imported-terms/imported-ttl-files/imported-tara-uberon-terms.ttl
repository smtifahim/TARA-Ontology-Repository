###  http://purl.obolibrary.org/obo/UBERON_0001148
<http://purl.obolibrary.org/obo/UBERON_0001148> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0003433> ,
