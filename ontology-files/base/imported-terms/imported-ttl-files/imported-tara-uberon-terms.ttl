###  http://purl.obolibrary.org/obo/UBERON_0004088
<http://purl.obolibrary.org/obo/UBERON_0004088> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0001444> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001456>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The subdivision of the face that includes the eye (eyeball plus adnexa such as eyelids) and the orbit of the skull and associated parts of the face such as the eyebrows, if present." ;
                                                <http://purl.obolibrary.org/obo/IAO_0000116> "note the FMA class is more narrow though, and is more like eye + muscles + vasculature. The FMA also has FMA:72951 orbital part of eye" ;
                                                oboInOwl:hasDbXref "FMA:260119" ;
                                                oboInOwl:hasExactSynonym "content of orbital part of eye" ,
                                                                         "eye region" ,
                                                                         "orbital part of face" ;
                                                oboInOwl:hasRelatedSynonym "ocular and peri-ocular region" ,
                                                                           "ocular region" ,
                                                                           "orbital content" ,
                                                                           "orbital part of eye" ;
                                                rdfs:label "orbital region" .


###  http://purl.obolibrary.org/obo/UBERON_0004089
<http://purl.obolibrary.org/obo/UBERON_0004089> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0001444> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001456>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "The middle of the face including the nose and its associated bony structures[MW]." ;
                                                <http://purl.obolibrary.org/obo/IAO_0000116> "this class is currently a union of the snout (e.g. in mouse), the midface and the lower face. Note that in MA, snout includes the whole jaw and should thus be more alike the lower face than the midface, so its placement here is not strictly accurate. In future we might introduce specific classes for each of these, and include the full parthood relationships. if this is done, then care should be taken to preserve inferences such as an abnormality of the lower face being an abnormality of the midface." ;
                                                oboInOwl:hasDbXref "FMA:285406" ,
                                                                   "MA:0001910" ;
                                                oboInOwl:hasRelatedSynonym "lower face" ,
                                                                           "midface/lower face" ,
                                                                           "snout" ;
                                                rdfs:label "midface" .


