###  http://purl.obolibrary.org/obo/UBERON_0011597
<http://purl.obolibrary.org/obo/UBERON_0011597> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0012360> ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0001709>
                                                                ] ,
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                  owl:someValuesFrom <http://purl.obolibrary.org/obo/UBERON_0003277>
                                                                ] ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Any bone that is part of the upper jaw skeleton. This includes (when present): the maxilla, the quadrate (in some species)." ;
