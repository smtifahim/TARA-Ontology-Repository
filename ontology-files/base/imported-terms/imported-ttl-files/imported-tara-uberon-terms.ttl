###  http://purl.obolibrary.org/obo/UBERON_0013692
<http://purl.obolibrary.org/obo/UBERON_0013692> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0006800> ,
