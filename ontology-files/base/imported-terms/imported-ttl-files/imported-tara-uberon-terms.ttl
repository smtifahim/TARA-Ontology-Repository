                                                                   "TADS:0000066" ,
                                                                   "TGMA:0001279" ,
                                                                   "UMLS:C0003461" ,
                                                                   "WBbt:0005364" ,
                                                                   "Wikipedia:Anus" ,
                                                                   "galen:Anus" ;
