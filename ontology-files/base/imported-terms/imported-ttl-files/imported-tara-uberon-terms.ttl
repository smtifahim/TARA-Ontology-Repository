###  http://purl.obolibrary.org/obo/UBERON_0010323
<http://purl.obolibrary.org/obo/UBERON_0010323> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0000075> ,
