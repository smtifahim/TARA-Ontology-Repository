                                                                   "UMLS:C0025058" ,
                                                                   "Wikipedia:Median_nerve" ;
                                                oboInOwl:hasRelatedSynonym "nervus medianus" ;
                                                rdfs:comment "The median nerve is the only nerve that passes through the carpal tunnel, where it may be compressed to cause carpal tunnel syndrome. [WP]" ;
                                                rdfs:label "median nerve" ;
                                                foaf:depiction "http://upload.wikimedia.org/wikipedia/commons/a/a7/Nerves_of_the_left_upper_extremity.gif"^^xsd:anyURI .


###  http://purl.obolibrary.org/obo/UBERON_0001172
<http://purl.obolibrary.org/obo/UBERON_0001172> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0009842> ,
                                                                <http://purl.obolibrary.org/obo/UBERON_0011858> ,
