                                                rdfs:subClassOf <http://purl.obolibrary.org/obo/UBERON_0011821> ;
                                                <http://purl.obolibrary.org/obo/IAO_0000115> "Irregular connective tissue, the intercellular matrix of which contains a sparse irregular network of collagen and elastic fiber bundles. Examples: areolar tissue, neuroglial tissue, mucoid tissue." ;
                                                oboInOwl:hasDbXref "FMA:19783" ,
                                                                   "NCIT:C33007" ,
                                                                   "UMLS:C1253917" ,
                                                                   "Wikipedia:Loose_connective_tissue" ;
                                                oboInOwl:hasExactSynonym "textus connectivus collagenosus laxus" ,
                                                                         "textus connectivus laxus" ;
                                                rdfs:label "loose connective tissue" .


