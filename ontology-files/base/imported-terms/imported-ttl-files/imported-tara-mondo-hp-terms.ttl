HP:0010535 a owl:Class ;
    rdfs:label "Sleep apnea" ;
    IAO:0000115 "An intermittent cessation of airflow at the mouth and nose during sleep is known as sleep apnea. Apneas that last at least 10 seconds are considered significant, but individuals with sleep apnea may experience apneas lasting from 20 seconds up to 2 or 3 minutes. Patients may have up to 15 events per hour of sleep." ;
    dcterms:contributor <https://orcid.org/0000-0001-6262-8264>,
        <https://orcid.org/0000-0001-9446-5121>,
        <https://orcid.org/0000-0002-1592-0825>,
        <https://orcid.org/0000-0002-4672-4923>,
        <https://orcid.org/0000-0002-5554-6946>,
        <https://orcid.org/0000-0002-7367-663X> ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2009-09-21T08:53:35+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "SNOMEDCT_US:73430006",
        "UMLS:C0037315" ;
    oboInOwl:hasExactSynonym "Pauses in breathing while sleeping",
        "Sleep apnea",
        "Sleep apnoea" ;
    rdfs:subClassOf HP:5200283 .

