MONDO:0002562 a owl:Class ;
    rdfs:label "demyelinating disease" ;
    IAO:0000115 "A broad group of disorders that affect the myelin sheaths that cover the neurons. Myelin sheathes cover neuronal axons in the central and peripheral nervous system and function to increase traveling impulse speeds. Disruption of this sheath impairs neuronal transmission and can result in disorders such as multiple sclerosis and Guillain-Barre syndrome, among others." ;
    mondo:curated_content_resource "https://www.malacards.org/card/demyelinating_disease"^^xsd:anyURI ;
