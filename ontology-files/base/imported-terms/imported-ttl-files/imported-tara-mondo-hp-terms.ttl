    rdfs:subClassOf HP:0025031 .

HP:0025085 a owl:Class ;
    rdfs:label "Bloody diarrhea" ;
    IAO:0000115 "Passage of many stools containing blood." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-10-15T13:58:14+00:00"^^xsd:dateTime ;
    oboInOwl:hasBroadSynonym "Blood in stool",
        "Bloody stool" ;
    oboInOwl:hasExactSynonym "Bloody bowel movement",
        "Bloody diarrhea" ;
    rdfs:comment "Diarrhea that contains bright red or maroon-colored blood may be referred to as hematochezia, while melena is used to describe black, tarry, and smelly diarrhea." ;
    rdfs:subClassOf HP:0002014 .

HP:0025276 a owl:Class ;
    rdfs:label "Abnormality of skin adnexa physiology" ;
    IAO:0000115 "Any functional anomaly of the skin adnexa (skin appendages), which are specialized skin structures located within the dermis and focally within the subcutaneous fatty tissue, comprising three histologically distinct structures: (1) the pilosebaceous unit (hair follicle and sebaceous glands); (2) the eccrine sweat glands; and (3) the apocrine glands." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-12-18T14:51:16+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0001574 .

HP:0025280 a owl:Class ;
    rdfs:label "Pain characteristic" ;
    IAO:0000115 "A pain characteristic is defined as a subjective category or type of pain." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-12-18T15:21:51+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0012823 .

HP:0025323 a owl:Class ;
    rdfs:label "Abnormal arterial physiology" ;
    IAO:0000115 "An anomaly of arterial function." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-02-03T12:08:38+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0030163 .

HP:0025424 a owl:Class ;
    rdfs:label "Abnormal larynx physiology" ;
    IAO:0000115 "Any anomaly of the function of the larynx." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-04-23T12:46:36+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0001600 .

HP:0025780 a owl:Class ;
    rdfs:label "Abnormal volitional state" ;
    IAO:0000115 "An abnormality of internal states of motivation or drive that compromise, or interfere with, the ability of the person to attend to basic personal, social, or vocational activities." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2024-07-21T16:05:20+00:00"^^xsd:dateTime ;
    oboInOwl:hasAlternativeId "HP:5200275" ;
    oboInOwl:hasRelatedSynonym "Abnormal energy",
        "Abnormal motivation" ;
    rdfs:subClassOf HP:0025766 .

HP:0025783 a owl:Class ;
    rdfs:label "Diagnostic behavioral phenotype" ;
    IAO:0000115 "The Human Phenotype Ontology provides terms to describe specific phenotypic abnormalities rather than disease diagnoses. Nevertheless, it is common for descriptions such as 'Autism' to be used to describe individuals affected with Mendelian forms of neurodevelopmental disease and many other conditions. If possible, we recommend annotation using specific terms in other branchs of the Atypical behavior subontology, but if this is not possible, then terms from this branch may be used." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2024-08-03T10:05:59+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0000708 .

HP:0025792 a owl:Class ;
    rdfs:label "Abnormal cognitive process" ;
    IAO:0000115 "An abnormal cognitive process can be defined as a deviation from the typical development, structural organization, or functional execution of mental operations that connect informational inputs to behavioral outputs, typically involve at least one of the following processes: perception, memory, learning, emotion, intentionality, self-representation, rationality, and decision-making." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2024-08-07T17:25:08+00:00"^^xsd:dateTime ;
    rdfs:comment "Definition adapted from Newen A (2017) What are cognitive processes? An example-based approach. Synthese 194:4251-4268." ;
    rdfs:subClassOf HP:0011446 .

HP:0030012 a owl:Class ;
    rdfs:label "Abnormal female reproductive system physiology" ;
    oboInOwl:hasDbXref "UMLS:C4020714",
        "UMLS:C4022678" ;
    oboInOwl:hasExactSynonym "Abnormal female reproductive system physiology" ;
    oboInOwl:hasRelatedSynonym "Abnormal female genital system physiology" ;
    rdfs:subClassOf HP:0000080 .

HP:0030163 a owl:Class ;
