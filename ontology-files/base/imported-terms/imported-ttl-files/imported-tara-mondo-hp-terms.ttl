HP:0100547 a owl:Class ;
    rdfs:label "Abnormal forebrain morphology" ;
    IAO:0000115 "An abnormality of the forebrain, which has as its parts the telencephalon, diencephalon, lateral ventricles and third ventricle." ;
    dcterms:creator <https://orcid.org/0009-0006-4530-3154> ;
