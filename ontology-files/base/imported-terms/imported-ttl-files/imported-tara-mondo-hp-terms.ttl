MONDO:1060199 a owl:Class ;
    rdfs:label "hemorrhagic stroke" ;
    IAO:0000115 "A stroke disorder caused by bleeding into the brain parenchyma or surrounding spaces. Hemorrhagic stroke includes intracerebral hemorrhage (bleeding within the brain tissue) and subarachnoid hemorrhage (bleeding in the space between the brain and the surrounding membrane)." ;
    dcterms:creator <https://orcid.org/0000-0002-7638-4659> ;
