MONDO:0021095 a owl:Class ;
    rdfs:label "parkinsonian disorder" ;
    IAO:0000115 "A group of disorders which feature impaired motor control characterized by bradykinesia, MUSCLE RIGIDITY; TREMOR; and postural instability. Parkinsonian diseases are generally divided into primary parkinsonism (see PARKINSON DISEASE), secondary parkinsonism (see PARKINSON DISEASE, SECONDARY) and inherited forms. These conditions are associated with dysfunction of dopaminergic or closely related motor integration neuronal pathways in the BASAL GANGLIA." ;
    mondo:curated_content_resource "https://www.malacards.org/card/parkinsonism"^^xsd:anyURI ;
    oboInOwl:hasDbXref "DOID:0080855",
