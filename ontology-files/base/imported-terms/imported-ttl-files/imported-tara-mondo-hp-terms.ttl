        "SNOMEDCT_US:262285001",
        "SNOMEDCT_US:89362005",
        "UMLS:C1262477" ;
    oboInOwl:hasExactSynonym "Loss of weight" ;
    rdfs:subClassOf HP:0004325 .

HP:0001877 a owl:Class ;
    rdfs:label "Abnormal erythrocyte morphology" ;
    IAO:0000115 "Any structural abnormality of erythrocytes (red-blood cells)." ;
    oboInOwl:hasAlternativeId "HP:0010973" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:12222001",
        "UMLS:C0391870",
        "UMLS:C4020862" ;
