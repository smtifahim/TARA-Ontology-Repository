MONDO:1060206 a owl:Class ;
    rdfs:label "primary dysmenorrhea" ;
    IAO:0000115 "A form of dysmenorrhea characterized by recurrent menstrual pain without any identifiable underlying pelvic pathology, representing a diagnosis of exclusion. Symptoms typically emerge within two years of menarche." ;
    dcterms:creator <https://orcid.org/0000-0002-7638-4659> ;
    oboInOwl:hasDbXref "MEDGEN:508446",
