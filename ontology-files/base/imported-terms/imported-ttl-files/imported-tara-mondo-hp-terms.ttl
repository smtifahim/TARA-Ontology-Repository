MONDO:0005047 a owl:Class ;
    rdfs:label "infertility disorder" ;
    IAO:0000115 "Inability to conceive for at least one year after trying and having unprotected sex. Causes of female infertility include endometriosis, fallopian tubes obstruction, and polycystic ovary syndrome. Causes of male infertility include abnormal sperm production or function, blockage of the epididymis, blockage of the ejaculatory ducts, hypospadias, exposure to pesticides, and health related issues." ;
    mondo:curated_content_resource "https://www.malacards.org/card/infertility"^^xsd:anyURI ;
