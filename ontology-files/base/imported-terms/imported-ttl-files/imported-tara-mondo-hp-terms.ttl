HP:0012647 a owl:Class ;
    rdfs:label "Abnormal inflammatory response" ;
    IAO:0000115 "Any anomaly of the inflammatory response, a response to injury or infection characterized by local vasodilation, extravasation of plasma into intercellular spaces and accumulation of white blood cells and macrophages." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-02-01T01:25:42+00:00"^^xsd:dateTime ;
