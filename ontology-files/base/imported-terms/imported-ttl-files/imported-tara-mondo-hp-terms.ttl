HP:0002170 a owl:Class ;
    rdfs:label "Intracranial hemorrhage" ;
    IAO:0000115 "Hemorrhage occurring within the skull." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:1386000",
        "UMLS:C0151699" ;
    oboInOwl:hasExactSynonym "Bleeding within the skull",
