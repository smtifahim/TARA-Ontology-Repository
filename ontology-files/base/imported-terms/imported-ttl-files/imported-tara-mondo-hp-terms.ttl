HP:0001618 a owl:Class ;
    rdfs:label "Dysphonia" ;
    IAO:0000115 "Difficulty in speaking due to a physical disorder of the mouth, tongue, throat, or vocal cords. Associated with a known physical or neurological cause." ;
    dcterms:contributor <https://orcid.org/0000-0001-8430-6039>,
        <https://orcid.org/0000-0002-2592-4715>,
        <https://orcid.org/0000-0002-9593-5508>,
        <https://orcid.org/0000-0003-3777-1389> ;
    oboInOwl:hasDbXref "SNOMEDCT_US:47004009",
        "UMLS:C1527344" ;
    oboInOwl:hasExactSynonym "Inability to produce voice sounds",
        "Voice change" ;
    rdfs:subClassOf HP:0001608 .

HP:0001627 a owl:Class ;
