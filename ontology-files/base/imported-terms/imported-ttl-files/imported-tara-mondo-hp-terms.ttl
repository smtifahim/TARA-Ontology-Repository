    rdfs:comment "Abdominal distention can be a secondary feature associated with a number of conditions such as bowel obstruction." ;
    rdfs:subClassOf HP:0011458 .

HP:0003326 a owl:Class ;
    rdfs:label "Myalgia" ;
    IAO:0000115 "Pain in muscle." ;
    oboInOwl:hasAlternativeId "HP:0003718" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:68962001",
        "UMLS:C0231528" ;
    oboInOwl:hasExactSynonym "Muscle ache",
        "Muscle pain" ;
    oboInOwl:hasRelatedSynonym "Myalgias" ;
    rdfs:subClassOf HP:0012531 .

HP:0003419 a owl:Class ;
    rdfs:label "Low back pain" ;
    IAO:0000115 "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the lower back." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:279039007",
        "UMLS:C0024031" ;
    oboInOwl:hasExactSynonym "Lower back pain",
        "Lumbago" ;
    rdfs:subClassOf HP:0003418 .

HP:0003750 a owl:Class ;
    rdfs:label "Increased muscle fatiguability" ;
    IAO:0000115 "An abnormal, increased fatiguability of the musculature." ;
