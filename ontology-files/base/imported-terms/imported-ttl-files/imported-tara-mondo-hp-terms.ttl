HP:0002185 a owl:Class ;
    rdfs:label "Neurofibrillary tangles" ;
    IAO:0000115 "Pathological protein aggregates formed by hyperphosphorylation of a microtubule-associated protein known as tau, causing it to aggregate in an insoluble form." ;
    oboInOwl:hasAlternativeId "HP:0003132",
        "HP:0007070" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:85775002",
        "UMLS:C0085400" ;
    oboInOwl:hasExactSynonym "NFTs",
        "Neurofibrillary tangles composed of disordered microtubules in neurons",
        "Paired helical filaments",
        "Tau-positive neurofibrillary tangles",
        "Tau-positive tangle" ;
    rdfs:subClassOf HP:0100314 .

HP:0002200 a owl:Class ;
    rdfs:label "Pseudobulbar signs" ;
    IAO:0000115 "Pseudobulbar signs result from injury to an upper motor neuron lesion to the corticobulbar pathways in the pyramidal tract. Patients have difficulty chewing, swallowing and demonstrate slurred speech (often initial presentation) as well as abnormal behavioral symptoms such as inappropriate emotional outbursts of uncontrolled laughter or weeping etc." ;
    oboInOwl:hasDbXref "UMLS:C1838579" ;
    oboInOwl:hasExactSynonym "Pseudobulbar symptoms" ;
    rdfs:subClassOf HP:0012638 .

HP:0002242 a owl:Class ;
    rdfs:label "Abnormal intestine morphology" ;
    IAO:0000115 "An abnormality of the intestine. The closely related term enteropathy is used to refer to any disease of the intestine." ;
    oboInOwl:hasAlternativeId "HP:0002628" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:85919009",
        "UMLS:C0021831" ;
    oboInOwl:hasExactSynonym "Abnormality of the intestine",
        "Enteropathy" ;
    rdfs:subClassOf HP:0012718 .

HP:0002250 a owl:Class ;
    rdfs:label "Abnormal large intestine morphology" ;
    IAO:0000115 "Any abnormality of the large intestine." ;
    oboInOwl:hasDbXref "UMLS:C4025715" ;
    oboInOwl:hasExactSynonym "Abnormality of the large intestine" ;
    rdfs:comment "The large intestine comprises the cecum and colon." ;
    rdfs:subClassOf HP:0002242 .

HP:0002300 a owl:Class ;
    rdfs:label "Mutism" ;
    IAO:0000115 "Complete lack of speech or verbal communication in a person despite attempts to engage in conversation. Mutism as a phenomena assumes the individual has previous capacity for speech and in the pediatric population it assumes that the person is past the age of typical language development." ;
    dcterms:contributor <https://orcid.org/0000-0001-5395-5036>,
        <https://orcid.org/0000-0001-6886-767X>,
        <https://orcid.org/0000-0001-8423-2623>,
        <https://orcid.org/0000-0001-9114-8737>,
        <https://orcid.org/0000-0002-0375-6247>,
        <https://orcid.org/0000-0002-2414-5605>,
        <https://orcid.org/0000-0002-4487-3589> ;
    oboInOwl:hasDbXref "SNOMEDCT_US:88052002",
        "UMLS:C0026884" ;
    oboInOwl:hasExactSynonym "Inability to speak",
        "Muteness" ;
    rdfs:subClassOf HP:0002167 .

HP:0002360 a owl:Class ;
    rdfs:label "Sleep disturbance" ;
    IAO:0000115 "An abnormal pattern in the quality, quantity, or characteristics of sleep." ;
    dcterms:contributor <https://orcid.org/0000-0001-6262-8264>,
        <https://orcid.org/0000-0001-9446-5121>,
        <https://orcid.org/0000-0002-1592-0825>,
        <https://orcid.org/0000-0002-4672-4923>,
        <https://orcid.org/0000-0002-5554-6946>,
        <https://orcid.org/0000-0002-7367-663X> ;
    oboInOwl:hasDbXref "SNOMEDCT_US:53888004",
        "UMLS:C0037317" ;
    oboInOwl:hasExactSynonym "Difficulty sleeping",
        "Sleep abnormality",
        "Sleep disturbances",
        "Sleep dysfunction",
        "Sleep-wake disturbance",
        "Trouble sleeping" ;
    rdfs:subClassOf HP:0011446 .

HP:0002463 a owl:Class ;
    rdfs:label "Language impairment" ;
    IAO:0000115 "Language impairment is a deficit in comprehension or production of language that includes reduced vocabulary, limited sentence structure, or impairments in written or spoken communication. Language abilities are substantially and quantifiably below age expectations." ;
    dcterms:contributor <https://orcid.org/0000-0001-8430-6039>,
        <https://orcid.org/0000-0002-2592-4715>,
        <https://orcid.org/0000-0002-9593-5508>,
        <https://orcid.org/0000-0003-3777-1389> ;
    oboInOwl:hasDbXref "SNOMEDCT_US:62305002",
        "UMLS:C0023015" ;
    oboInOwl:hasExactSynonym "Language disorder" ;
    rdfs:subClassOf HP:0034434 .

HP:0002583 a owl:Class ;
    rdfs:label "Colitis" ;
    IAO:0000115 "Colitis refers to an inflammation of the colon and is often used to describe an inflammation of the large intestine (colon, cecum and rectum). Colitides may be acute and self-limited or chronic, and broadly fit into the category of digestive diseases." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:64226004",
        "UMLS:C0009319" ;
    rdfs:subClassOf HP:0002037 .

HP:0002758 a owl:Class ;
    rdfs:label "Osteoarthritis" ;
    IAO:0000115 "Degeneration (wear and tear) of articular cartilage, i.e., of the joint surface. Joint degeneration may be accompanied by osteophytes (bone overgrowth), narrowing of the joint space, regions of sclerosis at the joint surface, or joint deformity." ;
    oboInOwl:hasAlternativeId "HP:0001379",
        "HP:0002824",
        "HP:0005762" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:225655006",
        "SNOMEDCT_US:396275006",
        "UMLS:C0029408" ;
    oboInOwl:hasExactSynonym "Degenerative joint disease" ;
    rdfs:subClassOf HP:0001369 .

HP:0002789 a owl:Class ;
    rdfs:label "Tachypnea" ;
    IAO:0000115 "Very rapid breathing." ;
    oboInOwl:hasAlternativeId "HP:0002874",
        "HP:0004346" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:271823003",
        "UMLS:C0231835" ;
    oboInOwl:hasExactSynonym "Increased respiratory rate or depth of breathing",
        "Polypnea" ;
    rdfs:comment "In adults, a beathing rate of between 12-20 breaths per minute is normal and tachypnea is present with a ventilatory rate greater than 20 breaths per minute." ;
    rdfs:subClassOf HP:0002793 .

HP:0002814 a owl:Class ;
    rdfs:label "Abnormality of the lower limb" ;
    IAO:0000115 "An abnormality of the leg." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:449715001",
        "UMLS:C1096086" ;
    oboInOwl:hasExactSynonym "Abnormality of the leg",
        "Abnormality of the lower limb",
        "Lower limb deformities" ;
    rdfs:subClassOf HP:0040064 .

HP:0002815 a owl:Class ;
    rdfs:label "Abnormality of the knee" ;
    IAO:0000115 "An abnormality of the knee joint or surrounding structures." ;
    oboInOwl:hasDbXref "UMLS:C4025676" ;
    oboInOwl:hasExactSynonym "Abnormality of the knee" ;
    rdfs:subClassOf HP:0100491 .

HP:0002829 a owl:Class ;
    rdfs:label "Arthralgia" ;
    IAO:0000115 "Joint pain." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:57676002",
        "UMLS:C0003862" ;
    oboInOwl:hasExactSynonym "Arthralgias",
        "Joint pain" ;
    oboInOwl:hasRelatedSynonym "Arthritic pain",
        "Joint pains" ;
    rdfs:comment "Arthralgia is distinct from Arthritis, which is not a symptom but a diagnosis with articular inflammation or signs of osteoarthritis." ;
    rdfs:subClassOf HP:0012531 .

HP:0002960 a owl:Class ;
    rdfs:label "Autoimmunity" ;
    IAO:0000115 "The occurrence of an immune reaction against the organism's own cells or tissues." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:85828009",
        "UMLS:C0004364" ;
    oboInOwl:hasExactSynonym "Autoimmune condition",
        "Autoimmune disease",
        "Autoimmune disorder",
        "Autoimmunity" ;
    rdfs:subClassOf HP:0010978 .

HP:0002977 a owl:Class ;
    rdfs:label "Aplasia/Hypoplasia involving the central nervous system" ;
    IAO:0000115 "Absence or underdevelopment of tissue in the central nervous system." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-03-31T05:13:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasAlternativeId "HP:0001323" ;
    oboInOwl:hasDbXref "UMLS:C4025665" ;
    oboInOwl:hasExactSynonym "Absent/underdeveloped central nervous system tissue",
        "Aplasia/Hypoplasia involving the CNS" ;
    rdfs:subClassOf HP:0002011 .

HP:0003028 a owl:Class ;
    rdfs:label "Abnormality of the ankle" ;
    IAO:0000115 "An anomaly of the joint that connects the foot with the leg." ;
    oboInOwl:hasDbXref "UMLS:C4025660" ;
    oboInOwl:hasExactSynonym "Abnormality of the ankles" ;
    rdfs:subClassOf HP:0100491 .

HP:0003077 a owl:Class ;
    rdfs:label "Hyperlipidemia" ;
    IAO:0000115 "An elevated lipid concentration in the blood." ;
    oboInOwl:hasAlternativeId "HP:0008159",
        "HP:0008356" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:55822004",
        "UMLS:C0020473" ;
    oboInOwl:hasExactSynonym "Elevated lipids in blood" ;
    rdfs:comment "Hyperlipidemia is an elevation of the blood levels of lipids including primarily cholesterol, phospholipids and triglycerides and cholesterol esters. The lipids are transported on lipoproteins some of which are commonly used for clinical measurements, including chylomicrons, very-low density lipoproteins (VLDL), intermediate-density lipoproteins (IDL), low-density lipoproteins, and high-density lipoproteins (HDL)." ;
    rdfs:subClassOf HP:0003119 .

HP:0003107 a owl:Class ;
    rdfs:label "Abnormal circulating cholesterol concentration" ;
    IAO:0000115 "Any deviation from the normal concentration of cholesterol in the blood circulation." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-03-17T01:02:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasAlternativeId "HP:0003464" ;
    oboInOwl:hasDbXref "UMLS:C4025656" ;
    oboInOwl:hasExactSynonym "Abnormal cholesterol homeostasis",
        "Abnormality of cholesterol metabolism" ;
    rdfs:subClassOf HP:0003119 .

HP:0003198 a owl:Class ;
    rdfs:label "Myopathy" ;
    IAO:0000115 "A disorder of muscle unrelated to impairment of innervation or neuromuscular junction." ;
    oboInOwl:hasAlternativeId "HP:0003569",
        "HP:0003705",
        "HP:0003742",
        "HP:0003802" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:129565002",
        "UMLS:C0026848" ;
    oboInOwl:hasExactSynonym "Muscle tissue disease",
        "Myopathic changes" ;
    rdfs:comment "The diagnosis of myopathy is often confirmed on the basis of myopathic changes in muscle biopsy." ;
    rdfs:subClassOf HP:0011805 .

HP:0003319 a owl:Class ;
    rdfs:label "Abnormality of the cervical spine" ;
    IAO:0000115 "Any abnormality of the cervical vertebral column." ;
    oboInOwl:hasAlternativeId "HP:0004587" ;
    oboInOwl:hasDbXref "UMLS:C1852464" ;
    oboInOwl:hasExactSynonym "Abnormal cervical spine",
        "Abnormality of cervical vertebra",
        "Abnormality of the cervical vertebrae",
        "Cervical spine abnormalities",
        "Cervical vertebral abnormalities",
        "Disorder of cervical vertebra" ;
    oboInOwl:hasRelatedSynonym "Cervical vertebral anomalies" ;
    rdfs:subClassOf HP:0000925 .

HP:0003401 a owl:Class ;
    rdfs:label "Paresthesia" ;
    IAO:0000115 "Abnormal sensations such as tingling, pricking, or numbness of the skin with no apparent physical cause." ;
    oboInOwl:hasAlternativeId "HP:0002082" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:91019004",
        "UMLS:C0030554" ;
    oboInOwl:hasExactSynonym "Paresthesias",
        "Pins and needles feeling",
        "Tingling" ;
    rdfs:subClassOf HP:0033747 .

HP:0003418 a owl:Class ;
    rdfs:label "Back pain" ;
    IAO:0000115 "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the back." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:161891005",
        "UMLS:C0004604" ;
    oboInOwl:hasExactSynonym "Back pain" ;
    rdfs:subClassOf HP:0000925,
        HP:0012531 .

HP:0003470 a owl:Class ;
    rdfs:label "Paralysis" ;
    IAO:0000115 "Paralysis of voluntary muscles means loss of contraction due to interruption of one or more motor pathways from the brain to the muscle fibers. Although the word paralysis is often used interchangeably to mean either complete or partial loss of muscle strength, it is preferable to use paralysis or plegia for complete or severe loss of muscle strength, and paresis for partial or slight loss. Motor paralysis results from deficits of the upper motor neurons (corticospinal, corticobulbar, or subcorticospinal). Motor paralysis is often accompanied by an impairment in the facility of movement." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:44695005",
        "UMLS:C0522224" ;
    oboInOwl:hasExactSynonym "Inability to move",
        "Paralysis" ;
    rdfs:subClassOf HP:0011442 .

HP:0003474 a owl:Class ;
    rdfs:label "Somatic sensory dysfunction" ;
    IAO:0000115 "An abnormality of the primary sensation that is mediated by peripheral nerves (pain, temperature, touch, vibration, joint position). The word hypoesthesia (or hypesthesia) refers to a reduction in cutaneous sensation to a specific type of testing." ;
    oboInOwl:hasAlternativeId "HP:0100964" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:397974008",
        "SNOMEDCT_US:398026008",
        "SNOMEDCT_US:59073000",
        "UMLS:C0020580" ;
    oboInOwl:hasExactSynonym "Sensory impairment" ;
    rdfs:comment "This term does not include abnormalities of cortical sensation such as two-point discrimination, stereognosis, and graphesthesia." ;
    rdfs:subClassOf HP:0012638 .

HP:0003549 a owl:Class ;
    rdfs:label "Abnormality of connective tissue" ;
    IAO:0000115 "Any abnormality of the soft tissues, including both connective tissue (tendons, ligaments, fascia, fibrous tissues, and fat)." ;
    oboInOwl:hasDbXref "UMLS:C4025596" ;
    rdfs:subClassOf HP:0033127 .

HP:0004298 a owl:Class ;
    rdfs:label "Abnormal abdominal wall morphology" ;
    IAO:0000115 "The presence of any abnormality affecting the abdominal wall." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-02-20T11:40:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasAlternativeId "HP:0001462" ;
    oboInOwl:hasDbXref "UMLS:C4021664" ;
    oboInOwl:hasExactSynonym "Abnormality of external features of the abdomen",
        "Abnormality of the abdominal wall" ;
    rdfs:subClassOf HP:0025031 .

HP:0004299 a owl:Class ;
    rdfs:label "Hernia of the abdominal wall" ;
    IAO:0000115 "The presence of a hernia in the abdominal wall." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-02-20T11:42:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "Fyler:4414",
        "SNOMEDCT_US:128545000",
        "UMLS:C1442978" ;
    oboInOwl:hasExactSynonym "Herniated abdominal wall" ;
    rdfs:comment "A hernia refers to a sac formed by the lining of the abdominal cavity (peritoneum). The sac can protrude through a hole or weak area in the abdominal fascia." ;
    rdfs:subClassOf HP:0010866,
        HP:0100790 .

HP:0004325 a owl:Class ;
    rdfs:label "Decreased body weight" ;
    IAO:0000115 "Abnormally low body weight." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-02-27T03:22:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasAlternativeId "HP:0001823",
        "HP:0001826" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:161832001",
        "SNOMEDCT_US:248342006",
        "SNOMEDCT_US:262285001",
        "SNOMEDCT_US:89362005",
        "UMLS:C0041667",
        "UMLS:C1262477",
        "UMLS:C1844806" ;
    oboInOwl:hasExactSynonym "Decreased body weight",
        "Decreased weight",
        "Low body weight",
        "Low weight",
        "Weight less than 3rd percentile" ;
    rdfs:subClassOf HP:0004323 .

HP:0004374 a owl:Class ;
    rdfs:label "Hemiplegia/hemiparesis" ;
    IAO:0000115 "Loss of strength in the arm, leg, and sometimes face on one side of the body. Hemiplegia refers to a severe or complete loss of strength, whereas hemiparesis refers to a relatively mild loss of strength." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-03-18T07:35:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C0375206" ;
    oboInOwl:hasExactSynonym "Paralysis or weakness of one side of body" ;
    rdfs:subClassOf HP:0010549 .

HP:0004386 a owl:Class ;
    rdfs:label "Gastrointestinal inflammation" ;
    IAO:0000115 "Inflammation of the alimentary part of the gastrointestinal system." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-03-18T09:01:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C1535950" ;
    oboInOwl:hasExactSynonym "GI inflammation",
        "Gastrointestinal inflammation" ;
    rdfs:subClassOf HP:0012649,
        HP:0012719 .

HP:0007313 a owl:Class ;
    rdfs:label "Cerebral degeneration" ;
    oboInOwl:hasAlternativeId "HP:0006874" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:418143002",
        "SNOMEDCT_US:52522001",
        "UMLS:C0154671" ;
    oboInOwl:hasExactSynonym "Neuroaxonal degeneration in the brain" ;
    rdfs:subClassOf HP:0007369 .

HP:0007367 a owl:Class ;
    rdfs:label "Atrophy/Degeneration affecting the central nervous system" ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-04-01T10:23:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C4024899" ;
    oboInOwl:hasExactSynonym "Atrophy/Degeneration affecting the CNS" ;
    rdfs:subClassOf HP:0002011 .

HP:0007369 a owl:Class ;
    rdfs:label "Atrophy/Degeneration affecting the cerebrum" ;
    IAO:0000115 "The presence of atrophy (wasting) of the cerebrum, also known as the telencephalon, the largest and most highly developed part of the human brain." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-04-01T10:28:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C4024898" ;
    rdfs:subClassOf HP:0002060,
        HP:0002977,
        HP:0012444 .

HP:0007550 a owl:Class ;
    rdfs:label "Hypohidrosis or hyperhidrosis" ;
    oboInOwl:hasDbXref "UMLS:C4021831" ;
    oboInOwl:hasExactSynonym "Lack of sweating or excessive sweating" ;
    rdfs:subClassOf HP:0025276 .

HP:0008066 a owl:Class ;
    rdfs:label "Abnormal blistering of the skin" ;
    IAO:0000115 "The presence of one or more bullae on the skin, defined as fluid-filled blisters more than 5 mm in diameter with thin walls." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-04-02T03:54:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasAlternativeId "HP:0007467",
        "HP:0007496",
        "HP:0200038" ;
    oboInOwl:hasDbXref "UMLS:C0241054",
        "UMLS:C2132198",
        "UMLS:C2220104" ;
    oboInOwl:hasExactSynonym "Abnormal blistering of the skin",
        "Blister",
        "Blistering, generalised",
        "Blistering, generalized",
        "Blisters",
        "Skin bullae" ;
    oboInOwl:hasRelatedSynonym "Skin blisters" ;
    rdfs:comment "A bulla is a large vesicle described as a rounded or irregularly shaped blister containing serous or seropurulent fluid, equal to or greater than 10mm. In approaching blistering diseases, there are 3 fundamental criteria to consider: (1) the site or level of the blister (or the lowest level of vesiculation): subcorneal, midepidermis, suprabasal, subepidermal; (2) the findings that implicate the mechanism of blister formation (spongiosis, acantholysis, blistering degeneration, or epidermolysis); and (3) the type of inflammation (neutrophilic, lymphocytic, eosinophilic, mixed), if present." ;
    rdfs:subClassOf HP:0011121 .

HP:0009121 a owl:Class ;
    rdfs:label "Abnormal axial skeleton morphology" ;
    IAO:0000115 "An abnormality of the axial skeleton, which comprises the skull, the vertebral column, the ribs and the sternum." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2008-04-05T11:16:00+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C4020785",
        "UMLS:C4024586" ;
    oboInOwl:hasRelatedSynonym "Abnormality of the axial skeleton" ;
    rdfs:subClassOf HP:0011842 .

HP:0010280 a owl:Class ;
    rdfs:label "Stomatitis" ;
    IAO:0000115 "Stomatitis is an inflammation of the mucous membranes of any of the structures in the mouth." ;
    dcterms:contributor <https://orcid.org/0000-0001-7601-9822>,
        <https://orcid.org/0000-0001-9382-150X>,
        <https://orcid.org/0000-0002-2029-0733>,
        <https://orcid.org/0000-0002-3577-9021>,
        <https://orcid.org/0000-0002-4315-9105>,
        <https://orcid.org/0009-0004-8124-8864> ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2009-07-12T09:48:56+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "SNOMEDCT_US:20607006",
        "SNOMEDCT_US:61170000",
        "UMLS:C0038362",
        "UMLS:C0149704" ;
    oboInOwl:hasExactSynonym "Inflammation of the mouth",
        "Stomatitis" ;
    oboInOwl:hasNarrowSynonym "Gingivostomatitis" ;
    rdfs:comment "Principal causative agents include herpes simplex virus (HSV), which causes recurrent herpetic stomatitis particularly in T-cell deficiencies, and Coxsackievirus (hand-foot-and-mouth disease), which may be unusually severe or prolonged in antibody deficiencies." ;
    rdfs:subClassOf HP:0011830,
        HP:0012649 .

HP:0010549 a owl:Class ;
    rdfs:label "Weakness due to upper motor neuron dysfunction" ;
    IAO:0000115 "Paralysis of voluntary muscles means loss of contraction due to interruption of one or more motor pathways from the brain to the muscle fibers. Although the word paralysis is often used interchangeably to mean either complete or partial loss of muscle strength, it is preferable to use paralysis or plegia for complete or severe loss of muscle strength, and paresis for partial or slight loss. Paralysis due to lesions of the principle motor tracts is related to a lesion in the corticospinal, corticobulbar or brainstem descending (subcorticospinal) neurons." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2009-10-01T08:30:25+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C4021255" ;
    oboInOwl:hasExactSynonym "Paralysis due to lesions of the principle motor tracts" ;
    rdfs:subClassOf HP:0002493 .

HP:0010866 a owl:Class ;
    rdfs:label "Abdominal wall defect" ;
    IAO:0000115 "An incomplete closure of the abdominal wall." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2010-08-03T09:55:15+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C0238577" ;
    oboInOwl:hasExactSynonym "Abdominal wall defect",
        "Congenital anterior abdominal wall defect" ;
    rdfs:subClassOf HP:0004298 .

HP:0010935 a owl:Class ;
    rdfs:label "Abnormality of the upper urinary tract" ;
    IAO:0000115 "An abnormality of the upper urinary tract." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-01-16T11:37:29+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C4023641" ;
    oboInOwl:hasExactSynonym "Abnormality of the upper urinary tract" ;
    rdfs:comment "The upper urinary tract is a subdivision of urinary system which consists of the kidney and the ureters." ;
    rdfs:subClassOf HP:0000079 .

HP:0010936 a owl:Class ;
    rdfs:label "Abnormality of the lower urinary tract" ;
    IAO:0000115 "An abnormality of the lower urinary tract." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-01-16T11:39:17+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C4023640" ;
    rdfs:comment "The lower urinary tract is a subdivision of urinary system which consists of the urinary bladder and the urethra." ;
    rdfs:subClassOf HP:0000079 .

HP:0011028 a owl:Class ;
    rdfs:label "Abnormality of blood circulation" ;
    IAO:0000115 "An abnormality of blood circulation." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2011-03-03T10:25:21+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C4020760",
        "UMLS:C4023585" ;
    oboInOwl:hasRelatedSynonym "Blood circulation disorder" ;
    rdfs:subClassOf HP:0011025 .

HP:0011029 a owl:Class ;
