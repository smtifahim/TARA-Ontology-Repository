MONDO:0005098 a owl:Class ;
    rdfs:label "stroke disorder" ;
    IAO:0000115 "A sudden loss of neurological function secondary to hemorrhage or ischemia in the brain parenchyma due to a vascular event." ;
    oboInOwl:hasDbXref "DOID:0051061",
