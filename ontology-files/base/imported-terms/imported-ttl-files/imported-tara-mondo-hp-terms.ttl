    IAO:0000115 "Abnormality of vascular function." ;
    oboInOwl:hasDbXref "UMLS:C4022603" ;
    rdfs:subClassOf HP:0002597,
        HP:0011025 .

HP:0030828 a owl:Class ;
    rdfs:label "Wheezing" ;
    IAO:0000115 "A high-pitched whistling sound associated with labored breathing." ;
    dcterms:date "2016-05-09T07:51:16+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "SNOMEDCT_US:56018004",
        "UMLS:C0043144" ;
    oboInOwl:hasExactSynonym "Wheezing" ;
    rdfs:comment "Wheezes and rhonchi are continuous musical lung sounds. The American Thoracic Society (ATS) Committee on pulmonary nomenclature defines wheezes as high-pitched continuous sounds with a dominant frequency of 400 Hz or more, and rhonchi as low-pitched continuous musical sounds with a dominant frequency of about 200 Hz or less" ;
    rdfs:subClassOf HP:0030829 .

HP:0030835 a owl:Class ;
    rdfs:label "Elbow pain" ;
    IAO:0000115 "An unpleasant sensation characterized by physical discomfort (such as pricking, throbbing, or aching) localized to the elbow." ;
    dcterms:date "2016-05-17T07:00:44+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "SNOMEDCT_US:74323005",
        "UMLS:C0239266" ;
    oboInOwl:hasExactSynonym "Elbow pain" ;
    rdfs:subClassOf HP:0012513 .

HP:0030956 a owl:Class ;
    rdfs:label "Abnormality of cardiovascular system electrophysiology" ;
    IAO:0000115 "An anomaly of the electrical conduction physiology of the heart." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-03-17T17:47:04+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0011025 .

HP:0030972 a owl:Class ;
    rdfs:label "Abnormal systemic blood pressure" ;
    IAO:0000115 "A chronic deviation from normal pressure in the systemic arterial system." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2017-04-18T13:55:40+00:00"^^xsd:dateTime ;
    oboInOwl:hasExactSynonym "Abnormal systemic BP" ;
    rdfs:subClassOf HP:0011025 .

HP:0031058 a owl:Class ;
    rdfs:label "Impairment of activities of daily living" ;
    IAO:0000115 "Difficulty in performing one or more activities normally performed every day, such as eating, bathing, dressing, grooming, work, homemaking, and leisure." ;
