    rdfs:subClassOf HP:0002360 .

HP:5200401 a owl:Class ;
    rdfs:label "Abnormal judgment" ;
    IAO:0000115 "Beliefs that deviate from what is considered rational or within the range of normal human judgment and belief formation." ;
    dcterms:contributor <https://orcid.org/0000-0001-7062-8192>,
        <https://orcid.org/0000-0001-7941-2961>,
