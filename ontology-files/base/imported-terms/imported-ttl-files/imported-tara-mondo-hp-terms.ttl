    IAO:0000115 "Coughing up (expectoration) of blood or blood-streaked sputum from the larynx, trachea, bronchi, or lungs." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:66857006",
        "SNOMEDCT_US:6686005",
        "UMLS:C0019079" ;
