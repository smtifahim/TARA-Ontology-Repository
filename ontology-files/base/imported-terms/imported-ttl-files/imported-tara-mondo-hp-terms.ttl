MONDO:0700322 a owl:Class ;
    rdfs:label "tinnitus" ;
    IAO:0000115 "A central nervous system dysperception disorder characterized by the perception of a sound not justified by any internal or external vibration, lasting at least 5 minutes and occurring more than once a week, arising from maladaptive neuroplasticity secondary to an organic cochlear peripheral lesion, and classifiable as positive auditory hallucinosis in the absence of delusional attitudes or behaviors." ;
    dcterms:creator <https://orcid.org/0000-0002-4142-7153> ;
    oboInOwl:hasDbXref "ICD10CM:H93.1" ;
