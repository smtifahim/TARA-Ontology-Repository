MONDO:0004855 a owl:Class ;
    rdfs:label "tenosynovitis" ;
    IAO:0000115 "Inflammation of the synovial lining of a tendon sheath. Causes include trauma, tendon stress, bacterial disease (gonorrhea, tuberculosis), rheumatic disease, and gout. Common sites are the hand, wrist, shoulder capsule, hip capsule, hamstring muscles, and Achilles tendon. The tendon sheaths become inflamed and painful, and accumulate fluid. Joint mobility is usually reduced." ;
    mondo:curated_content_resource "https://www.malacards.org/card/tenosynovitis"^^xsd:anyURI ;
    dcterms:conformsTo <http://purl.obolibrary.org/obo/mondo/patterns/inflammatory_disease_by_site.yaml>,
