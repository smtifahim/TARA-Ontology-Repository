HP:0005086 a owl:Class ;
    rdfs:label "Knee osteoarthritis" ;
    oboInOwl:hasDbXref "SNOMEDCT_US:239873007",
        "UMLS:C0409959" ;
    rdfs:subClassOf HP:0002758,
        HP:0034669 .

HP:0005268 a owl:Class ;
    rdfs:label "Miscarriage" ;
    IAO:0000115 "A pregnancy that ends at a stage in which the fetus is incapable of surviving on its own, defined as the spontaneous loss of a fetus before the 22th week of pregnancy." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:17369002",
        "UMLS:C0000786" ;
    oboInOwl:hasExactSynonym "Early fetal demise",
        "Early foetal demise",
        "Spontaneous abortion" ;
    rdfs:comment "The age at which fetal demise is legally classified asa a miscarriage varies between countries with the US being 20 gestational weeks and the UK being 24 gestational weeks. The HPO chooses the average of these age ranges." ;
    rdfs:subClassOf HP:0034241 .

HP:0006986 a owl:Class ;
    rdfs:label "Upper limb spasticity" ;
