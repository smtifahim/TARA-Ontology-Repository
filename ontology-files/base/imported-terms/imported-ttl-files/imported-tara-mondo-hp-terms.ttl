HP:0025270 a owl:Class ;
    rdfs:label "Abnormal esophagus physiology" ;
    IAO:0000115 "Any physiological abnormality of the esophagus." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
