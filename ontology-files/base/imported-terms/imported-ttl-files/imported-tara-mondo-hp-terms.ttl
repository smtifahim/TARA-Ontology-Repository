    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2022-03-02T16:12:30+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0034434 .

HP:5200283 a owl:Class ;
