MONDO:0004979 a owl:Class ;
    rdfs:label "asthma" ;
    IAO:0000115 "A bronchial disease that is characterized by chronic inflammation and narrowing of the airways, which is caused by a combination of environmental and genetic factors resulting in recurring periods of wheezing (a whistling sound while breathing), chest tightness, shortness of breath, mucus production and coughing. The symptoms appear due to a variety of triggers such as allergens, irritants, respiratory infections, weather changes, exercise, stress, reflux disease, medications, foods and emotional anxiety." ;
    mondo:curated_content_resource "https://www.malacards.org/card/asthma"^^xsd:anyURI ;
