        "SNOMEDCT_US:288939007",
        "SNOMEDCT_US:40739000",
        "UMLS:C0011168" ;
    oboInOwl:hasExactSynonym "Difficulty swallowing",
        "Poor swallowing",
        "Swallowing difficulties",
        "Swallowing difficulty" ;
    oboInOwl:hasRelatedSynonym "Deglutition disorder" ;
    rdfs:subClassOf HP:0012638,
        HP:0025270 .

HP:0002037 a owl:Class ;
    rdfs:label "Inflammation of the large intestine" ;
    IAO:0000115 "Inflammation, or an inflammatory state in the large intestine." ;
    oboInOwl:hasDbXref "SNOMEDCT_US:24526004",
