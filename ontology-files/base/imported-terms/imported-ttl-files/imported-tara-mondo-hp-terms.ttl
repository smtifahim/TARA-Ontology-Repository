HP:0031815 a owl:Class ;
    rdfs:label "Abnormal oral physiology" ;
    IAO:0000115 "A functional anomaly of the mouth (which is also known as the oral cavity)." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2018-04-29T14:50:56+00:00"^^xsd:dateTime ;
    rdfs:comment "The physiological functions of the mouth include salivary gland secretory function, mastication (chewing) and preparation of food for swallowing." ;
    rdfs:subClassOf HP:0000153 .

HP:0032101 a owl:Class ;
    rdfs:label "Unusual infection" ;
    IAO:0000115 "Increased susceptibility to infection, as manifested by recurrent infection, severe or invasive infection, infection occurring in an unusual anatomical location, or infection with opportunistic organisms, that is unusual for a healthy individual of the same age." ;
    dcterms:contributor <https://orcid.org/0000-0001-7601-9822>,
        <https://orcid.org/0000-0001-9382-150X>,
        <https://orcid.org/0000-0002-2029-0733>,
        <https://orcid.org/0000-0002-3577-9021>,
        <https://orcid.org/0000-0002-4315-9105>,
        <https://orcid.org/0009-0004-8124-8864> ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2018-11-04T22:23:03+00:00"^^xsd:dateTime ;
    rdfs:comment "There are five general subtypes. (i) Opportunistic infection, meaning infection by a pathogen that is not normally able to cause infection in a healthy host (e.g., pneumonia by Pneumocystis jirovecii or CMV); (ii) Unusual location (focus) of an infection (e.g., an aspergillus brain abscess); (iii) a protracted course or lack of adequate response to treatment (e.g., chronic rhinosinusitis); (iv) Unusual severity or intensity of an infection; and (v) unusual recurrence of infections." ;
    rdfs:subClassOf HP:0010978 .

HP:0032158 a owl:Class ;
    rdfs:label "Unusual infection by anatomical site" ;
    IAO:0000115 "An unusual infection classified by the affected body part." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2018-12-09T12:17:59+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0032101 .

