    dcterms:date "2023-07-28T13:55:40+00:00"^^xsd:dateTime ;
    oboInOwl:hasExactSynonym "Abnormal beliefs" ;
    rdfs:subClassOf HP:5200423 .

HP:5200423 a owl:Class ;
    rdfs:label "Abnormal experience of reality" ;
    IAO:0000115 "Subjective phenomena or perceptions that deviate from what is considered correct or are outside the range of normal human experiences." ;
    dcterms:contributor <https://orcid.org/0000-0001-7062-8192>,
        <https://orcid.org/0000-0001-7941-2961>,
        <https://orcid.org/0000-0001-9221-9226>,
        <https://orcid.org/0000-0002-0183-1637>,
        <https://orcid.org/0000-0003-1785-7126>,
        <https://orcid.org/0000-0003-2291-6952>,
        <https://orcid.org/0000-0003-4958-6025> ;
    dcterms:date "2023-07-28T13:55:40+00:00"^^xsd:dateTime ;
    rdfs:comment "Abnormal experiences of reality can range from rare perceptions, such as hallucinations or delusions, to more common experiences, such as subtle misinterpretations of events, like cognitive distortions." ;
    rdfs:subClassOf HP:0011446 .

HP:5210191 a owl:Class ;
    rdfs:label "Unusual cystitis" ;
    IAO:0000115 "Increased susceptibility to cystitis, as manifested by recurrent or severe infection of the urinary bladder, or by cystitis caused by an atypical or opportunistic organism." ;
    dcterms:contributor <https://orcid.org/0000-0001-7601-9822>,
        <https://orcid.org/0000-0001-9382-150X>,
        <https://orcid.org/0000-0002-2029-0733>,
        <https://orcid.org/0000-0002-3577-9021>,
        <https://orcid.org/0000-0002-4315-9105>,
        <https://orcid.org/0009-0004-8124-8864> ;
    oboInOwl:hasExactSynonym "Bladder inflammation",
        "Cystitis",
        "Infection of the bladder" ;
    rdfs:comment "Causative agents include bacteria (Escherichia coli, Klebsiella pneumoniae, Enterococcus species), viruses (adenovirus, BK polyomavirus), and fungi (Candida species)." ;
    rdfs:subClassOf HP:5210135 .

HP:5210251 a owl:Class ;
    rdfs:label "Recurrent stomatitis" ;
    IAO:0000115 "Increased susceptibility to infectious stomatitis, as manifested by recurrent episodes of oral mucosal infection that are unusual in frequency or severity for a healthy individual of the same age." ;
    dcterms:contributor <https://orcid.org/0000-0001-7601-9822>,
