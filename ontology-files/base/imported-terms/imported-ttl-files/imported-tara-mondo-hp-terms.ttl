    oboInOwl:hasExactSynonym "Abnormal spine",
        "Abnormal vertebral column",
        "Abnormality of the spine",
        "Abnormality of the vertebral column" ;
    oboInOwl:hasRelatedSynonym "Abnormality of the backbone" ;
    rdfs:subClassOf HP:0009121 .

