HP:0012718 a owl:Class ;
    rdfs:label "Abnormal gastrointestinal tract morphology" ;
    IAO:0000115 "Abnormal structure of the gastrointestinal tract." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-03-23T01:09:02+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C4021073" ;
    oboInOwl:hasExactSynonym "Abnormal shape of the digestive system",
        "Morphological abnormality of the GI tract",
        "Morphological abnormality of the gastrointestinal tract",
        "Morphological anomaly of the digestive system" ;
    rdfs:subClassOf HP:0011024,
        HP:0025033 .

HP:0012758 a owl:Class ;
    rdfs:label "Neurodevelopmental delay" ;
    IAO:0000115 "Neurodevelopmental delay (NDD) refers to delays in the maturation of the brain and central nervous system; infants and young children with NDD may experience delays in the development of one or more skills including gross motor abilities, fine-motor coordination, language abilities and ability to solve increasingly complex problems." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-04-03T12:16:19+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C4022738" ;
    oboInOwl:hasExactSynonym "NDD" ;
    rdfs:comment "Though the definitions of NDD vary broadly in the literature, all are used to signify a delay in one or more developmental domains compared to typical development." ;
    rdfs:subClassOf HP:0012759 .

HP:0012759 a owl:Class ;
    rdfs:label "Neurodevelopmental abnormality" ;
    IAO:0000115 "A deviation from normal of the neurological development of a child, which may include any or all of the aspects of the development of personal, social, gross or fine motor, and cognitive abilities." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2014-04-03T12:20:28+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "UMLS:C4022737" ;
    rdfs:comment "This term should be used to describe abnormalities with onset in the developmental period." ;
    rdfs:subClassOf HP:0012638 .

HP:0012875 a owl:Class ;
    rdfs:label "Abnormal ejaculation" ;
    IAO:0000115 "Abnormality in the process of ejection of semen (usually carrying sperm) from the male reproductive tract." ;
    dcterms:creator <https://orcid.org/0000-0002-6996-5279> ;
    dcterms:date "2014-06-09T11:21:29+00:00"^^xsd:dateTime ;
    oboInOwl:hasDbXref "SNOMEDCT_US:386674000",
        "UMLS:C2937350" ;
    rdfs:subClassOf HP:0012874 .

HP:0020342 a owl:Class ;
    rdfs:label "Unusual stomatitis" ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2026-05-22T11:17:28+00:00"^^xsd:dateTime ;
    oboInOwl:hasExactSynonym "Unusual infectious stomatitis",
        "Unusual oral mucosal infection" ;
    rdfs:subClassOf HP:0010280,
        HP:5210280 ;
    owl:incompatibleWith "Stomatitis is an inflammation of the mucous membranes of any of the structures in the mouth. An unusual stomatitis is characterized by an increased susceptibility to infectious stomatitis, as manifested by recurrent or severe oral mucosal infection." .

HP:0025015 a owl:Class ;
    rdfs:label "Abnormal vascular morphology" ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2016-08-12T11:24:56+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0002597,
        HP:0030680 .

HP:0025033 a owl:Class ;
    rdfs:label "Abnormal digestive system morphology" ;
    IAO:0000115 "A structural anomaly of the digestive system." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
