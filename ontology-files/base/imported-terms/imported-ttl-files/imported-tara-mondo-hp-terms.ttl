HP:0100851 a owl:Class ;
    rdfs:label "Abnormal emotional state" ;
    IAO:0000115 "A disturbance in the experience or expression of emotion, characterized by alterations in valence, intensity, frequency, or duration. It may also involve emotional responses that are mismatched, exaggerated, or incongruent relative to internal expectations or external contextual stimuli, such as experiencing negative affect in response to neutral or positive events." ;
    dcterms:contributor <https://orcid.org/0000-0002-1111-7357>,
        <https://orcid.org/0000-0002-7954-5235>,
        <https://orcid.org/0000-0003-2897-0458>,
        <https://orcid.org/0000-0003-4298-5074>,
        <https://orcid.org/0000-0003-4618-6544> ;
    dcterms:creator <https://orcid.org/0009-0006-4530-3154> ;
    dcterms:date "2011-06-23T11:07:13+00:00"^^xsd:dateTime ;
    oboInOwl:hasBroadSynonym "Affective dysregulation",
        "Emotional dysregulation",
        "Mood disturbance",
        "Psychological distress" ;
    oboInOwl:hasDbXref "UMLS:C4020949" ;
    rdfs:comment "Emotions are complex psychological and physiological states that may include any combination of: a subjective internal experience, a physiological response, and a behavioral or expressive component. Behavioral expression is not required for the emotional state to be considered present or clinically relevant. The assessment of abnormal emotional states should consider sociocultural and individual context, as well as intra-individual baselines. The term 'abnormal' is used descriptively and non-pejoratively, to denote deviations from typical emotional patterns, which may or may not reach the threshold of clinical disorder." ;
    rdfs:subClassOf HP:0025766 .

HP:0430071 a owl:Class ;
    rdfs:label "Abnormal circulating organic compound concentration" ;
    IAO:0000115 "Any deviation of the concentration of an orrganic compound from the normal range. An organic compound is defined as any compound that contains a carbon atom." ;
    dcterms:creator <https://orcid.org/0000-0002-0736-9199> ;
    dcterms:date "2024-01-30T05:58:49+00:00"^^xsd:dateTime ;
    rdfs:subClassOf HP:0032180 .

HP:4000072 a owl:Class ;
    rdfs:label "Abnormal language feature" ;
    IAO:0000115 "The presence of any atypical form of expressive language." ;
    dcterms:contributor <https://orcid.org/0000-0001-8430-6039>,
        <https://orcid.org/0000-0002-2592-4715>,
        <https://orcid.org/0000-0002-9593-5508>,
