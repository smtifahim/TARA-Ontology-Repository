        "http://www.snomedbrowser.com/Codes/Details/41065002" ;
    oboInOwl:hasExactSynonym "arteria profunda brachii",
        "profunda brachii artery" ;
    rdfs:subClassOf UBERON:0001637 .

UBERON:0001406 a owl:Class ;
    rdfs:label "ulnar artery" ;
    IAO:0000115 "The ulnar artery is the main blood vessel, with oxygenated blood, of the medial aspect of the forearm. It arises from the brachial artery and terminates in the superficial palmar arch, which joins with the superficial branch of the radial artery. It is palpable on the anterior and medial aspect of the wrist. Along its course, it is accompanied by a similarly named vein or veins, the ulnar vein or ulnar veins. The ulnar artery, the larger of the two terminal branches of the brachial, begins a little below the bend of the elbow in the cubital fossa, and, passing obliquely downward, reaches the ulnar side of the forearm at a point about midway between the elbow and the wrist. It then runs along the ulnar border to the wrist, crosses the transverse carpal ligament on the radial side of the pisiform bone, and immediately beyond this bone divides into two branches, which enter into the formation of the superficial and deep volar arches. [WP,unvetted]." ;
    ILX:0112785 UBERON:0001406 ;
    ilxtr:hasExistingId UBERON:0001406,
        FMA:22796,
        ILX:0726607 ;
    oboInOwl:hasDbXref "EMAPA:37675",
        "FMA:22796",
        "GAID:515",
        "MA:0002069",
        "MESH:D017535",
        "NCIT:C12839",
        "OpenCyc:Mx4rwAF2PJwpEbGdrcN5Y29ycA",
        "UMLS:C0162858",
        "galen:UlnarArtery",
        "http://en.wikipedia.org/wiki/Ulnar_artery",
        "http://linkedlifedata.com/resource/umls/id/C0162858",
        "http://www.snomedbrowser.com/Codes/Details/181333006" ;
    oboInOwl:hasExactSynonym "arteria ulnaris" ;
    rdfs:subClassOf UBERON:0001637 .

