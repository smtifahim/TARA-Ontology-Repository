UBERON:0001810 a owl:Class ;
    rdfs:label "nerve plexus" ;
    IAO:0000115 "Anatomical junction where subdivisions of two or more neural trees interconnect with one another to form a network through which nerve fibers of the constituent nerve trees become regrouped; together with other nerve plexuses, nerves and ganglia, it constitutes the peripheral nervous system. Examples: cervical nerve plexus, brachial nerve plexus, sacral nerve plexus[FMA]." ;
    ILX:0381387 "right" ;
    ilxtr:hasExistingId UBERON:0001810,
        FMA:5901,
        ILX:0731150 ;
