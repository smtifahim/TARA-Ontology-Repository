UBERON:0001397 a owl:Class ;
    rdfs:label "subscapular artery" ;
    IAO:0000115 "The subscapular artery, the largest branch of the axillary artery, arises at the lower border of the Subscapularis, which it follows to the inferior angle of the scapula, where it anastomoses with the lateral thoracic and intercostal arteries and with the descending branch of the transverse cervical, and ends in the neighboring muscles. About 4 cm. from its origin it gives off two branches, first the scapular circumflex artery and then the thoracodorsal artery. [WP,unvetted]." ;
    ILX:0112785 UBERON:0001397 ;
    ilxtr:hasExistingId UBERON:0001397,
        FMA:22677,
        ILX:0727623 ;
    oboInOwl:hasDbXref "EMAPA:37116",
        "FMA:22677",
        "MA:0002050",
        "NCIT:C33650",
        "UMLS:C0226422",
