    oboInOwl:hasExactSynonym "arteria profunda femoris",
        "profunda femoris artery" ;
    rdfs:subClassOf UBERON:0001637 .

UBERON:0001361 a owl:Class ;
    rdfs:label "femoral vein" ;
    IAO:0000115 "In the human body, the femoral vein is a blood vessel that accompanies the femoral artery in the femoral sheath. It begins at the adductor canal (also known as Hunter's canal) and is a continuation of the popliteal vein. It ends at the inferior margin of the inguinal ligament, where it becomes the external iliac vein. [WP,unvetted]." ;
    ILX:0112785 UBERON:0001361 ;
    ilxtr:hasExistingId UBERON:0001361,
        FMA:21185,
