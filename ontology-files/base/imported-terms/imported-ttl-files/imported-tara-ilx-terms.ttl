    oboInOwl:hasRelatedSynonym "arteria brachialis" ;
    rdfs:subClassOf UBERON:0001637 .

UBERON:0001399 a owl:Class ;
    rdfs:label "deep brachial artery" ;
    IAO:0000115 "The arteria profunda brachii (also known as deep artery of the arm and the deep brachial artery) is a large vessel which arises from the medial and back part of the brachial, just below the lower border of the Teres major. [WP,unvetted]." ;
    ILX:0112785 UBERON:0001399 ;
    ilxtr:hasExistingId UBERON:0001399,
        FMA:22695,
        ILX:0734311 ;
    oboInOwl:hasDbXref "EMAPA:37215",
        "FMA:22695",
