ILX:0795500 a owl:Class ;
    rdfs:label "tendon of flexor carpi radialis" ;
    IAO:0000115 "The tendon of the muscle that flexes and abducts the wrist, located in the anterior forearm." ;
    ilxtr:hasExistingId FMA:38582,
        ILX:0795500 ;
    rdfs:subClassOf UBERON:0000043 .

ILX:0795501 a owl:Class ;
    rdfs:label "Tendon of flexor carpi ulnaris" ;
    IAO:0000115 "The tendon of the muscle that flexes and adducts the hand at the wrist." ;
    ilxtr:hasExistingId FMA:38606,
        ILX:0795501 ;
    rdfs:subClassOf UBERON:0000043 .

ILX:0795502 a owl:Class ;
    rdfs:label "tendon of extensor digitorum" ;
    IAO:0000115 "The tendon of the muscle that extends the fingers and assists in wrist extension, located on the posterior forearm." ;
    ilxtr:hasExistingId FMA:40734,
        ILX:0795502 ;
    rdfs:subClassOf UBERON:0000043 .

ILX:0795503 a owl:Class ;
    rdfs:label "tendon of extensor hallucis longus" ;
    IAO:0000115 "The tendon of the muscle extending the big toe and assisting in dorsiflexion of the foot." ;
    ilxtr:hasExistingId FMA:47065,
        ILX:0795503 ;
    rdfs:subClassOf UBERON:0000043 .

ILX:0797391 a owl:Class ;
    rdfs:label "superficial branch of radial nerve" ;
    IAO:0000115 "The superficial branch of the radial nerve passes along the front of the radial side of the forearm to the commencement of its lower third. It is a sensory nerve." ;
    ILX:0112785 UBERON:0001492 ;
    ilxtr:hasExistingId ILX:0797391 ;
    rdfs:subClassOf UBERON:0001021 .

ILX:0797451 a owl:Class ;
    rdfs:label "subcostal nerve" ;
    IAO:0000115 "The anterior division (rami anteriores; ventral divisions) of the twelfth thoracic spinal nerve. It emerges below the twelfth" ;
    ilxtr:hasExistingId ILX:0797451 ;
    rdfs:subClassOf UBERON:0003726 .

ILX:0797461 a owl:Class ;
    rdfs:label "dorsal digital nerve of radial nerve" ;
    IAO:0000115 "A sensory branch of the superficial radial nerve supplying the dorsal aspect of the lateral digits of the hand." ;
    ILX:0112785 UBERON:0001492 ;
    ilxtr:hasExistingId ILX:0797461 ;
    rdfs:subClassOf UBERON:0001027 ;
    oboInOwl:hasExactSynonym "Dorsal digital branch of radial nerve" .

ILX:0797475 a owl:Class ;
    rdfs:label "Lateral supraclavicular nerve" ;
    IAO:0000115 "A terminal cutaneous branch of the supraclavicular nerves (C3-C4) that supplies sensation to the skin over the acromion, upper deltoid region, and posterior shoulder." ;
    ILX:0112785 UBERON:0003725 ;
    ilxtr:hasExistingId FMA:78654,
        ILX:0797475 ;
    rdfs:subClassOf ILX:0797474 ;
    oboInOwl:hasExactSynonym "Posterior supraclavicular nerve",
        "Supra-acromial nerve" .

ILX:0797476 a owl:Class ;
    rdfs:label "Intermediate supraclavicular nerve" ;
    IAO:0000115 "A cutaneous branch of the cervical plexus that descends across the clavicle to supply the skin over the upper pectoral and deltoid regions." ;
    ILX:0112785 UBERON:0003725 ;
    ilxtr:hasExistingId FMA:78651,
        ILX:0797476 ;
    rdfs:subClassOf ILX:0797474 ;
    oboInOwl:hasExactSynonym "Middle supraclavicular nerve" .

ILX:0797477 a owl:Class ;
    rdfs:label "Posterior antebrachial cutaneous nerve" ;
    IAO:0000115 "A sensory branch of the radial nerve that innervates the skin of the posterior forearm." ;
    ILX:0112785 UBERON:0001492 ;
    ilxtr:hasExistingId FMA:39145,
        ILX:0797477 ;
    rdfs:subClassOf UBERON:0001027 ;
    oboInOwl:hasExactSynonym "Posterior cutaneous nerve of forearm" .

ILX:0797478 a owl:Class ;
    rdfs:label "Lesser occipital nerve" ;
    IAO:0000115 "A branch of the cervical plexus (primarily C2) that supplies sensation to the scalp posterior and superior to the ear." ;
    ILX:0112785 UBERON:0003725 ;
    ilxtr:hasExistingId FMA:6871,
        ILX:0797478 ;
    rdfs:subClassOf UBERON:0001027 ;
    oboInOwl:hasExactSynonym "Small occipital nerve" .

ILX:0797479 a owl:Class ;
    rdfs:label "Zygomatic branch of the facial nerve" ;
    IAO:0000115 "A branch of the facial nerve that innervates muscles of facial expression in the zygomatic and orbital regions." ;
    ILX:0112785 UBERON:0001647 ;
    ilxtr:hasExistingId ILX:0797479 ;
    rdfs:subClassOf UBERON:0001021 ;
    oboInOwl:hasExactSynonym "Malar branch of facial nerve" .

ILX:0797480 a owl:Class ;
    rdfs:label "Transverse cervical nerve" ;
    IAO:0000115 "A superficial branch of the cervical plexus (C2-C3) providing sensory innervation to the skin of the anterior neck." ;
    ILX:0112785 UBERON:0003725 ;
    ilxtr:hasExistingId FMA:6873,
        ILX:0797480 ;
    rdfs:subClassOf UBERON:0001027 ;
    oboInOwl:hasExactSynonym "Cervical cutaneous nerve",
        "Transverse cutaneous nerve of neck" .

ILX:0797481 a owl:Class ;
    rdfs:label "Anterior cutaneous branch of femoral nerve" ;
    IAO:0000115 "A cutaneous branch of the femoral nerve supplying sensation to the anterior and medial thigh." ;
    ILX:0112785 UBERON:0001267 ;
    ilxtr:hasExistingId FMA:45250,
        ILX:0797481 ;
    rdfs:subClassOf UBERON:0001027 ;
    oboInOwl:hasExactSynonym "Anterior femoral cutaneous nerve" .

ILX:0797482 a owl:Class ;
    rdfs:label "Medial dorsal cutaneous nerve of foot" ;
    IAO:0000115 "A terminal branch of the superficial fibular nerve supplying the medial dorsum of the foot and adjacent toes." ;
    ILX:0112785 UBERON:0035526 ;
    ilxtr:hasExistingId ILX:0797482 ;
    rdfs:subClassOf UBERON:0001021 ;
    oboInOwl:hasExactSynonym "Medial dorsal cutaneous nerve" .

ILX:0797483 a owl:Class ;
    rdfs:label "Dorsal digital nerve of foot" ;
    IAO:0000115 "A digital sensory nerve supplying the dorsal surface of one or more toes. These nerves arise primarily from the superficial fibular, deep fibular, or sural nerves." ;
    ILX:0112785 UBERON:0001466 ;
    ilxtr:hasExistingId ILX:0797483 ;
    rdfs:subClassOf UBERON:0003435 ;
    oboInOwl:hasExactSynonym "Dorsal digital nerve of pes" .

ILX:0797484 a owl:Class ;
    rdfs:label "Proper plantar digital nerve" ;
    IAO:0000115 "A terminal branch of a plantar digital nerve supplying sensation to the sides of individual toes and adjacent plantar skin." ;
    ILX:0112785 UBERON:0035109 ;
    ilxtr:hasExistingId FMA:44741,
        ILX:0797484 ;
    rdfs:subClassOf UBERON:0001021 ;
    oboInOwl:hasExactSynonym "Proper digital nerve of foot" .

ILX:0797485 a owl:Class ;
    rdfs:label "Medial crural cutaneous nerve" ;
    IAO:0000115 "A sensory branch of the saphenous nerve supplying the skin along the medial aspect of the leg." ;
    ILX:0112785 UBERON:0002475 ;
    ilxtr:hasExistingId FMA:45328,
        ILX:0797485 ;
    rdfs:subClassOf UBERON:0001021 ;
    oboInOwl:hasExactSynonym "Medial cutaneous nerve of leg" .

ILX:0797486 a owl:Class ;
    rdfs:label "Muscular branch of the femoral nerve" ;
    IAO:0000115 "A motor branch of the femoral nerve supplying muscles of the anterior compartment of the thigh, including the quadriceps femoris." ;
    ILX:0112785 UBERON:0001267 ;
    ilxtr:hasExistingId ILX:0797486 ;
    rdfs:subClassOf UBERON:0001021 ;
    oboInOwl:hasExactSynonym "Motor branch of femoral nerve" .

ILX:0797487 a owl:Class ;
    rdfs:label "Long thoracic nerve" ;
    IAO:0000115 "A nerve arising from C5-C7 roots that innervates the serratus anterior muscle and contributes to scapular stabilization." ;
    ILX:0112785 UBERON:0001814 ;
    ilxtr:hasExistingId FMA:65275,
        ILX:0797487 ;
    rdfs:subClassOf UBERON:0001021 ;
    oboInOwl:hasExactSynonym "External respiratory nerve of Bell" .

ILX:0797488 a owl:Class ;
    rdfs:label "Fourth common palmar digital nerve" ;
    IAO:0000115 "The most medial common palmar digital nerve, arising from the superficial branch of the ulnar nerve and dividing into proper digital nerves for adjacent fingers." ;
    ILX:0112785 UBERON:0001494 ;
    ilxtr:hasExistingId FMA:44844,
        ILX:0797488 ;
    rdfs:subClassOf UBERON:0001027 ;
    oboInOwl:hasExactSynonym "Common palmar digital nerve IV" .

ILX:0797489 a owl:Class ;
    rdfs:label "Proper palmar digital nerve" ;
    IAO:0000115 "A terminal digital nerve supplying sensation to the sides of the fingers and adjacent palmar skin." ;
    ILX:0112785 UBERON:0003447 ;
    ilxtr:hasExistingId ILX:0797489 ;
    rdfs:subClassOf UBERON:0001027 ;
    oboInOwl:hasExactSynonym "Proper digital nerve of hand" .

ILX:0797490 a owl:Class ;
    rdfs:label "Dorsal digital nerve of ulnar nerve" ;
    IAO:0000115 "A sensory branch derived from the dorsal cutaneous branch of the ulnar nerve supplying the dorsal medial digits." ;
    ILX:0112785 UBERON:0001494 ;
    ilxtr:hasExistingId ILX:0797490 ;
    rdfs:subClassOf UBERON:0001027 ;
    oboInOwl:hasExactSynonym "Dorsal digital branch of ulnar nerve" .

ILX:0797491 a owl:Class ;
    rdfs:label "Dorsal cutaneous branch of the ulnar nerve" ;
    IAO:0000115 "A sensory branch of the ulnar nerve supplying the skin of the medial dorsum of the hand and giving rise to dorsal digital nerves." ;
    ILX:0112785 UBERON:0001494 ;
    ilxtr:hasExistingId ILX:0797491 ;
    rdfs:subClassOf UBERON:0001027 ;
    oboInOwl:hasExactSynonym "Dorsal branch of ulnar nerve" .

ILX:0797492 a owl:Class ;
    rdfs:label "Motor branches of the suprascapular nerve" ;
    IAO:0000115 "Terminal motor branches of the suprascapular nerve supplying the supraspinatus and infraspinatus muscles." ;
    ILX:0112785 ILX:0794966 ;
    ilxtr:hasExistingId ILX:0797492 ;
    rdfs:subClassOf UBERON:0001021 ;
    oboInOwl:hasExactSynonym "Muscular branches of suprascapular nerve" .

ILX:0797493 a owl:Class ;
    rdfs:label "Cervical branch of the facial nerve" ;
    IAO:0000115 "The lowest branch of the facial nerve that innervates the platysma muscle in the neck." ;
    ILX:0112785 UBERON:0001647 ;
    ilxtr:hasExistingId ILX:0797493 ;
    rdfs:subClassOf UBERON:0001021 ;
    oboInOwl:hasExactSynonym "Cervical ramus of facial nerve" .

ILX:0797494 a owl:Class ;
    rdfs:label "Radial recurrent artery" ;
    IAO:0000115 "A branch of the radial artery that ascends toward the elbow and participates in the periarticular arterial anastomosis." ;
    ILX:0112785 UBERON:0001404 ;
    ilxtr:hasExistingId FMA:22748,
        ILX:0797494 ;
    rdfs:subClassOf UBERON:0001637 ;
    oboInOwl:hasExactSynonym "Arteria recurrens radialis" .

ILX:0797495 a owl:Class ;
    rdfs:label "Radial recurrent vein" ;
    IAO:0000115 "A vein accompanying the radial recurrent artery that drains the lateral elbow region into the radial venous system." ;
    ilxtr:hasExistingId ILX:0797495 ;
    rdfs:subClassOf UBERON:0001638 ;
    oboInOwl:hasExactSynonym "Vena recurrens radialis" .

ILX:0797496 a owl:Class ;
    rdfs:label "Posterior circumflex humeral artery" ;
