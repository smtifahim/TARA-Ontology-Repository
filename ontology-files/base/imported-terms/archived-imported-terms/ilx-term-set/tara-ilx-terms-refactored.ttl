        ILX:0795305 ;
    ilxtr:hasIlxPreferredId FMA:35451 .

ILX:0795500 a owl:Class ;
    rdfs:label "tendon of flexor carpi radialis" ;
    definition: "The tendon of the muscle that flexes and abducts the wrist, located in the anterior forearm." ;
    rdfs:subClassOf UBERON:0000043 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:38582,
        ILX:0795500 ;
    ilxtr:hasIlxPreferredId FMA:38582 .

ILX:0795501 a owl:Class ;
    rdfs:label "Tendon of flexor carpi ulnaris" ;
    definition: "The tendon of the muscle that flexes and adducts the hand at the wrist." ;
    rdfs:subClassOf UBERON:0000043 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:38606,
        ILX:0795501 ;
    ilxtr:hasIlxPreferredId FMA:38606 .

ILX:0797477 a owl:Class ;
    rdfs:label "Posterior antebrachial cutaneous nerve" ;
    definition: "A sensory branch of the radial nerve that innervates the skin of the posterior forearm." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0001492 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:39145,
        ILX:0797477 ;
    oboInOwl:hasExactSynonym "Posterior cutaneous nerve of forearm" .

ILX:0795310 a owl:Class ;
    rdfs:label "cubital fossa" ;
    definition: "A triangular depression on the anterior aspect of the elbow, containing important neurovascular structures." ;
    rdfs:subClassOf UBERON:0004704 ;
    ilx.partOf: UBERON:0001460 ;
    ILX:0777130 <https://en.wikipedia.org/wiki/Cubital_fossa> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:39848,
        ILX:0795310 ;
    ilxtr:hasIlxPreferredId FMA:39848 .

ILX:0795502 a owl:Class ;
    rdfs:label "tendon of extensor digitorum" ;
    definition: "The tendon of the muscle that extends the fingers and assists in wrist extension, located on the posterior forearm." ;
    rdfs:subClassOf UBERON:0000043 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:40734,
        ILX:0795502 ;
    ilxtr:hasIlxPreferredId FMA:40734 .

ILX:0797502 a owl:Class ;
    rdfs:label "Lateral circumflex femoral vein" ;
    definition: "A vein accompanying the lateral circumflex femoral artery that drains the lateral thigh into the profunda femoris vein." ;
    rdfs:subClassOf UBERON:0001638 ;
    ilx.partOf: UBERON:0001361 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:44326,
        ILX:0797502 ;
    oboInOwl:hasExactSynonym "Vena circumflexa femoris lateralis" .

ILX:0797503 a owl:Class ;
    rdfs:label "Dorsal digital vein of foot" ;
    definition: "A superficial vein draining the dorsal aspect of a toe and contributing to the dorsal venous network of the foot." ;
    rdfs:subClassOf UBERON:0004562 ;
    ilx.partOf: UBERON:0012356 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:44392,
        ILX:0797503 ;
    oboInOwl:hasExactSynonym "Dorsal digital vein of pes" .

ILX:0797521 a owl:Class ;
    rdfs:label "Lateral sural cutaneous nerve" ;
    definition: "A sensory branch of the common fibular nerve that supplies the skin of the lateral aspect of the leg proximal to the ankle." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0001324 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:44697,
        ILX:0797521 ;
    oboInOwl:hasExactSynonym "Lateral cutaneous nerve of calf",
        "Nervus cutaneus surae lateralis" .

ILX:0797484 a owl:Class ;
    rdfs:label "Proper plantar digital nerve" ;
    definition: "A terminal branch of a plantar digital nerve supplying sensation to the sides of individual toes and adjacent plantar skin." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0035109 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:44741,
        ILX:0797484 ;
    oboInOwl:hasExactSynonym "Proper digital nerve of foot" .

ILX:0797488 a owl:Class ;
    rdfs:label "Fourth common palmar digital nerve" ;
    definition: "The most medial common palmar digital nerve, arising from the superficial branch of the ulnar nerve and dividing into proper digital nerves for adjacent fingers." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0001494 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:44844,
        ILX:0797488 ;
    oboInOwl:hasExactSynonym "Common palmar digital nerve IV" .

ILX:0797481 a owl:Class ;
    rdfs:label "Anterior cutaneous branch of femoral nerve" ;
    definition: "A cutaneous branch of the femoral nerve supplying sensation to the anterior and medial thigh." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0001267 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:45250,
        ILX:0797481 ;
    oboInOwl:hasExactSynonym "Anterior femoral cutaneous nerve" .

ILX:0797485 a owl:Class ;
    rdfs:label "Medial crural cutaneous nerve" ;
    definition: "A sensory branch of the saphenous nerve supplying the skin along the medial aspect of the leg." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0002475 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:45328,
        ILX:0797485 ;
    oboInOwl:hasExactSynonym "Medial cutaneous nerve of leg" .

ILX:0795317 a owl:Class ;
    rdfs:label "biceps femoris tendon" ;
    definition: "The biceps femoris tendon is the rounded tendon that attaches the muscle bellies of the long and short heads of the biceps femoris muscle to the head of the fibula." ;
    rdfs:subClassOf UBERON:0000043 ;
    ilx.partOf: UBERON:0008784 ;
    ILX:0777130 <https://www.elsevier.com/resources/anatomy/muscular-system/muscles-of-lower-limb/biceps-femoris-tendon/22415> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:45930,
        ILX:0795317 ;
    ilxtr:hasIlxPreferredId FMA:45930 .

ILX:0795325 a owl:Class ;
    rdfs:label "tibialis anterior tendon" ;
    definition: "The tibialis anterior tendon is the tendon of the tibialis anterior muscle, located on the front of the lower leg. It passes along the ankle and inserts on the medial cuneiform and the first metatarsal. This tendon enables dorsiflexion and inversion of the foot. The tibialis anterior tendon (TAT) begins at the distal one-third of the tibia. It is the most medial tendon of the ankle and foot." ;
    rdfs:subClassOf UBERON:0000043 ;
    ilx.partOf: UBERON:0000978 ;
    ILX:0777130 <https://en.wikipedia.org/wiki/Tibialis_anterior_muscle> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:47050,
        ILX:0795325 ;
    ilxtr:hasIlxPreferredId FMA:47050 .

ILX:0795503 a owl:Class ;
    rdfs:label "tendon of extensor hallucis longus" ;
    definition: "The tendon of the muscle extending the big toe and assisting in dorsiflexion of the foot." ;
    rdfs:subClassOf UBERON:0000043 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:47065,
        ILX:0795503 ;
    ilxtr:hasIlxPreferredId FMA:47065 .

ILX:0795324 a owl:Class ;
    rdfs:label "iliotibial band" ;
    definition: "Your iliotibial band is a strong, thick band of tissue that runs down the outside of your thigh. It extends all the way from the hip bone to the top of the shinbone." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0008784 ;
    ILX:0777130 <https://en.wikipedia.org/wiki/Iliotibial_tract> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:51048,
        ILX:0795324 ;
    ilxtr:hasIlxPreferredId FMA:51048 .

ILX:0793723 a owl:Class ;
    rdfs:label "Auriculotemporal nerve" ;
    definition: "The auriculotemporal nerve is a branch of the mandibular nerve (CN V3) that runs with the superficial temporal artery and vein, and provides sensory innervation to various regions on the side of the head, including parasympathetic innervation of the parotid gland (Adapted from Wikipedia)" ;
    rdfs:subClassOf UBERON:0001021 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:53000,
        ILX:0793723 ;
    ilxtr:hasIlxPreferredId FMA:53000 .

ILX:0795291 a owl:Class ;
    rdfs:label "mandibular notch" ;
    NIFRID:synonym "sigmoid notch" ;
    definition: "The mandibular notch, also known as the sigmoid notch, is a groove in the ramus of the mandible. A curved depression between the coronoid and condylar processes of the mandible." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0003129 ;
    ILX:0777130 <https://en.wikipedia.org/wiki/Mandibular_notch> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:59481,
        ILX:0795291 ;
    ilxtr:hasIlxPreferredId FMA:59481 .

ILX:0795309 a owl:Class ;
    rdfs:label "axillary fossa" ;
    definition: "A pyramidal depression located at the junction of the upper limb and thorax, commonly referred to as the armpit." ;
    rdfs:subClassOf UBERON:0004704 ;
    ilx.partOf: UBERON:0008785 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/axillary-fossa-1536889648> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:61464,
        ILX:0795309 ;
    ilxtr:hasIlxPreferredId FMA:61464 .

ILX:0795306 a owl:Class ;
    rdfs:label "lateral thoracic region" ;
    definition: "The area of the thorax on the lateral body wall, containing portions of the serratus anterior and intercostal muscles." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0001443 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/lateral-region-of-thorax-1536888820> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:61533,
        ILX:0795306 ;
    ilxtr:hasIlxPreferredId FMA:61533 .

ILX:0795284 a owl:Class ;
    rdfs:label "infraclavicular fossa" ;
    definition: "A small triangular depression located inferior to the clavicle, bounded by the clavicle, deltoid, and pectoralis major muscles." ;
    rdfs:subClassOf UBERON:0004704 ;
    ilx.partOf: UBERON:0001443 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/infraclavicular-fossa-1536888660> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:61541,
        ILX:0795284 ;
    ilxtr:hasIlxPreferredId FMA:61541 .

ILX:0797487 a owl:Class ;
    rdfs:label "Long thoracic nerve" ;
    definition: "A nerve arising from C5-C7 roots that innervates the serratus anterior muscle and contributes to scapular stabilization." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0001814 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:65275,
        ILX:0797487 ;
    oboInOwl:hasExactSynonym "External respiratory nerve of Bell" .

ILX:0797474 a owl:Class ;
    rdfs:label "Supraclavicular nerve" ;
    definition: "The supraclavicular nerve is a cutaneous (sensory) nerve of the cervical plexus that arises from the third and fourth cervical (spinal) nerves. It emerges from beneath the posterior border of the sternocleidomastoid muscle, then split into multiple branches. Together, these innervate the skin over the shoulder." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0003725 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:65414,
        ILX:0797474 ;
    oboInOwl:hasExactSynonym "cutaneous branches of the cervical plexus" .

ILX:0797526 a owl:Class ;
    rdfs:label "Dorsal venous network of hand" ;
    definition: "A superficial venous network on the dorsum of the hand that receives blood from the dorsal digital and metacarpal veins and contributes to the cephalic and basilic veins." ;
    rdfs:subClassOf UBERON:0001638 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:67977,
        ILX:0797526 ;
    oboInOwl:hasExactSynonym "Dorsal venous arch of hand",
        "Dorsal venous rete of hand" .

ILX:0797525 a owl:Class ;
    rdfs:label "Dorsal digital veins" ;
    definition: "Small superficial veins that drain the dorsal surfaces of the fingers or toes and empty into the dorsal venous networks of the hand or foot." ;
    rdfs:subClassOf UBERON:0004563 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:70917,
        ILX:0797525 ;
    oboInOwl:hasExactSynonym "Digital dorsal veins",
        "Dorsal veins of digits" .

ILX:0795290 a owl:Class ;
    rdfs:label "nasolabial sulcus" ;
    definition: "A shallow groove extending from the lateral aspect of the nostril to the corner of the mouth." ;
    rdfs:subClassOf UBERON:0000093 ;
    ilx.partOf: UBERON:0001456 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/nasolabial-sulcus-1536888784> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:75018,
        ILX:0795290 ;
    ilxtr:hasIlxPreferredId FMA:75018 .

ILX:0795327 a owl:Class ;
    rdfs:label "mentolabial sulcus" ;
    definition: "The mentolabial sulcus is the vertical groove or fold that forms between the lower lip and the chin, marking the transition between the lower lip and the mental region of the face." ;
    rdfs:subClassOf UBERON:0000093 ;
    ilx.partOf: UBERON:0001456 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/mentolabial-sulcus-1536888420> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:75019,
        ILX:0795327 ;
    ilxtr:hasIlxPreferredId FMA:75019 .

ILX:0795338 a owl:Class ;
    rdfs:label "lateral supraepicondylar ridge" ;
    definition: "The lateral supracondylar ridge (lateral supraepicondylar ridge or lateral supracondylar crest) is the sharp, prominent margin located along the lateral aspect of the distal end of the body of the humerus. It is the less curved of the two supracondylar ridges of the humerus, the other being the medial supracondylar ridge." ;
    rdfs:subClassOf UBERON:0001062 ;
    ILX:0777130 <https://www.elsevier.com/resources/anatomy/skeletal-system/appendicular-skeleton/lateral-supracondylar-ridge/18104> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:75078,
        ILX:0795338 ;
    ilxtr:hasIlxPreferredId FMA:75078 .

ILX:0797507 a owl:Class ;
    rdfs:label "Ulnar recurrent artery" ;
    definition: "An artery arising from the proximal ulnar artery that ascends toward the elbow and participates in the periarticular arterial network." ;
    rdfs:subClassOf UBERON:0001637 ;
    ilx.partOf: UBERON:0001406 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:77140,
        ILX:0797507 ;
    oboInOwl:hasExactSynonym "Anterior ulnar recurrent artery",
        "Posterior ulnar recurrent artery" .

ILX:0797515 a owl:Class ;
    rdfs:label "Circumflex scapular vein" ;
    definition: "A vein accompanying the circumflex scapular artery that drains the scapular region into the subscapular vein." ;
    rdfs:subClassOf UBERON:0003515 ;
    ilx.partOf: UBERON:0000985 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:77498,
        ILX:0797515 ;
    oboInOwl:hasExactSynonym "Vena circumflexa scapulae" .

ILX:0797476 a owl:Class ;
    rdfs:label "Intermediate supraclavicular nerve" ;
    definition: "A cutaneous branch of the cervical plexus that descends across the clavicle to supply the skin over the upper pectoral and deltoid regions." ;
    rdfs:subClassOf ILX:0797474 ;
    ilx.partOf: UBERON:0003725 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:78651,
        ILX:0797476 ;
    oboInOwl:hasExactSynonym "Middle supraclavicular nerve" .

ILX:0797475 a owl:Class ;
    rdfs:label "Lateral supraclavicular nerve" ;
    definition: "A terminal cutaneous branch of the supraclavicular nerves (C3-C4) that supplies sensation to the skin over the acromion, upper deltoid region, and posterior shoulder." ;
    rdfs:subClassOf ILX:0797474 ;
    ilx.partOf: UBERON:0003725 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:78654,
        ILX:0797475 ;
    oboInOwl:hasExactSynonym "Posterior supraclavicular nerve",
        "Supra-acromial nerve" .

ILX:0797524 a owl:Class ;
    rdfs:label "Branch of ansa cervicalis" ;
    definition: "A motor branch arising from the ansa cervicalis that innervates one or more infrahyoid muscles of the anterior neck." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:82555,
        ILX:0797524 ;
    oboInOwl:hasExactSynonym "Muscular branch of ansa cervicalis" .

ILX:0795294 a owl:Class ;
    rdfs:label "greater supraclavicular fossa" ;
    definition: "The greater supraclavicular fossa refers to the larger, lateral depression above the clavicle, located lateral to the sternocleidomastoid muscle." ;
    rdfs:subClassOf UBERON:0004704 ;
    ilx.partOf: UBERON:0000974 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/greater-supraclavicular-fossa-1536888404> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:84958,
        ILX:0795294 ;
    ilxtr:hasIlxPreferredId FMA:84958 .

ILX:0795293 a owl:Class ;
    rdfs:label "lesser supraclavicular fossa" ;
    definition: "A small depression located superior to the clavicle and medial to the clavicular head of the sternocleidomastoid muscle." ;
    rdfs:subClassOf UBERON:0004704 ;
    ilx.partOf: UBERON:0000974 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/lesser-supraclavicular-fossa-1536888804> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:84981,
        ILX:0795293 ;
    ilxtr:hasIlxPreferredId FMA:84981 .

ILX:0795292 a owl:Class ;
    rdfs:label "anterior hairline" ;
    definition: "The demarcation at the anterior margin of the scalp where hair growth begins." ;
    rdfs:subClassOf UBERON:0006800 ;
