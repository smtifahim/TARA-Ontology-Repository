ILX:0795296 a owl:Class ;
    rdfs:label "sternal angle" ;
    definition: "The sternal angle (angle of Louis, Ludwig, or Ludovicus) is the inclined junction between the anterior surfaces of the manubrium and body of the sternum." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0001443 ;
    ILX:0777130 <https://www.elsevier.com/resources/anatomy/skeletal-system/axial-skeleton/sternal-angle/18493> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:7547,
        ILX:0795296 ;
    ilxtr:hasIlxPreferredId FMA:7547 .

ILX:0795302 a owl:Class ;
    rdfs:label "infrasternal angle" ;
    NIFRID:synonym "Mammillary line" ;
    definition: "The infrasternal angle (subcostal angle) is formed in front of thoracic cage by the cartilages of the tenth, ninth, eighth, and seventh ribs, which ascend on either side, where the apex of which the xiphoid process projects." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0000916 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/infrasternal-angle-1537019816> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:7573,
        ILX:0795302 ;
    ilxtr:hasIlxPreferredId FMA:7573 .

