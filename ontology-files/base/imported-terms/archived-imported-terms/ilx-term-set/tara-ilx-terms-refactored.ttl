    oboInOwl:hasExactSynonym "Malar branch of facial nerve" .

ILX:0797482 a owl:Class ;
    rdfs:label "Medial dorsal cutaneous nerve of foot" ;
    definition: "A terminal branch of the superficial fibular nerve supplying the medial dorsum of the foot and adjacent toes." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0035526 ;
