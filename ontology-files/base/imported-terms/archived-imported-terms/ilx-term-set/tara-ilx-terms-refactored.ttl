ILX:0797505 a owl:Class ;
    rdfs:label "Thoracoepigastric vein" ;
    definition: "A superficial vein of the trunk connecting the lateral thoracic and superficial epigastric veins, providing collateral venous drainage between the axillary and femoral systems." ;
    rdfs:subClassOf UBERON:0001638 ;
    ilx.partOf: UBERON:0000985 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:13416,
        ILX:0797505 ;
    oboInOwl:hasExactSynonym "Vena thoracoepigastrica" .

ILX:0795308 a owl:Class ;
    rdfs:label "midaxillary line" ;
    definition: "A vertical line running down the lateral thorax from the apex of the axilla to the hip." ;
    rdfs:subClassOf UBERON:0006800 ;
    ilx.partOf: UBERON:0001443 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/midaxillary-line-1536888352> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:14368,
        ILX:0795308 ;
    ilxtr:hasIlxPreferredId FMA:14368 .

ILX:0795322 a owl:Class ;
    rdfs:label "midclavicular line" ;
    definition: "Midclavicular line is an important vertical reference line on the anterior chest wall. It connects the midclavicular point (superiorly) with the middle of the inguinal ligament (inferiorly)." ;
    rdfs:subClassOf UBERON:0006800 ;
    ilx.partOf: UBERON:0001443 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/midclavicular-line-15368877400> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:20251,
        ILX:0795322 ;
    ilxtr:hasIlxPreferredId FMA:20251 .

ILX:0795323 a owl:Class ;
    rdfs:label "posterior axillary line" ;
    definition: "Posterior axillary line is an imaginary reference line which can be drawn on the posterior torso. It extends vertically downwards from the posterior axillary fold. The posterior axillary line runs in parallel to the midaxillary and anterior axillary lines." ;
    rdfs:subClassOf UBERON:0006800 ;
    ilx.partOf: UBERON:0001443 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/posterior-axillary-line-1536888360> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:20260,
        ILX:0795323 ;
    ilxtr:hasIlxPreferredId FMA:20260 .

ILX:0795300 a owl:Class ;
    rdfs:label "nipple line" ;
    definition: "The nipple line is an imaginary horizontal reference line running around the body at the level of the nipples." ;
    rdfs:subClassOf UBERON:0006800 ;
    ilx.partOf: UBERON:0001443 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/mammillary-line-1536888320> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:20304,
        ILX:0795300 ;
    ilxtr:hasIlxPreferredId FMA:20304 .

ILX:0795285 a owl:Class ;
    rdfs:label "anterior median line" ;
    definition: "A vertical line running along the midline of the anterior body surface, aligned with the sternum. On the anterior abdominal and chest walls, the anterior median line can be seen extending from the jugular notch, crossing over the sternum and linea alba in their midline, and reaching out to the midline pubic symphysis." ;
    rdfs:subClassOf UBERON:0006800 ;
    ilx.partOf: UBERON:0000916 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/anterior-median-line-1536887700> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:20310,
        ILX:0795285 ;
    ilxtr:hasIlxPreferredId FMA:20310 .

ILX:0795312 a owl:Class ;
    rdfs:label "posterior median line" ;
    definition: "A vertical line running along the posterior midline of the back, aligned with the spinous processes of the vertebrae." ;
    rdfs:subClassOf UBERON:0006800 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/posterior-median-line-1536888480> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:20311,
        ILX:0795312 ;
    ilxtr:hasIlxPreferredId FMA:20311 .

ILX:0795301 a owl:Class ;
    rdfs:label "upper abdomen" ;
    definition: "The superior portion of the abdomen, located above the umbilicus and below the ribcage." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0000916 ;
    ILX:0777130 <https://www.britannica.com/science/abdominal-cavity> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:20364,
        ILX:0795301 ;
    ilxtr:hasIlxPreferredId FMA:20364 .

ILX:0795303 a owl:Class ;
    rdfs:label "lower abdomen" ;
    definition: "The inferior portion of the abdomen, located below the umbilicus and above the pelvic region." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0000916 ;
    ILX:0777130 <https://www.britannica.com/science/abdominal-cavity> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:20365,
        ILX:0795303 ;
    ilxtr:hasIlxPreferredId FMA:20365 .

ILX:0797501 a owl:Class ;
    rdfs:label "Lateral circumflex femoral artery" ;
    definition: "A branch of the profunda femoris artery supplying the lateral thigh, hip region, and adjacent muscles." ;
    rdfs:subClassOf UBERON:0001637 ;
    ilx.partOf: UBERON:0001355 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:20798,
        ILX:0797501 ;
    oboInOwl:hasExactSynonym "Arteria circumflexa femoris lateralis" .

ILX:0797504 a owl:Class ;
    rdfs:label "Descending genicular artery" ;
    definition: "The final branch of the femoral artery that descends medially toward the knee and contributes to the genicular anastomosis." ;
    rdfs:subClassOf UBERON:0001637 ;
    ilx.partOf: UBERON:0002060 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:22506,
        ILX:0797504 ;
    oboInOwl:hasExactSynonym "Arteria genus descendens" .

ILX:0797496 a owl:Class ;
    rdfs:label "Posterior circumflex humeral artery" ;
    definition: "A branch of the axillary artery that passes through the quadrangular space to supply the deltoid region and shoulder joint." ;
    rdfs:subClassOf UBERON:0001637 ;
    ilx.partOf: UBERON:0001394 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:22684,
        ILX:0797496 ;
    oboInOwl:hasExactSynonym "Arteria circumflexa humeri posterior" .

ILX:0797506 a owl:Class ;
    rdfs:label "Superior ulnar collateral artery" ;
    definition: "A branch of the brachial artery that accompanies the ulnar nerve posterior to the medial epicondyle and contributes to the arterial anastomosis around the elbow." ;
    rdfs:subClassOf UBERON:0001637 ;
    ilx.partOf: UBERON:0001398 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:22706,
        ILX:0797506 ;
    oboInOwl:hasExactSynonym "Arteria collateralis ulnaris superior" .

ILX:0797509 a owl:Class ;
    rdfs:label "Inferior ulnar collateral artery" ;
    definition: "A branch of the brachial artery arising above the elbow that contributes to the arterial anastomosis around the medial aspect of the elbow joint." ;
    rdfs:subClassOf UBERON:0004260 ;
    ilx.partOf: UBERON:0001398 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:22710,
        ILX:0797509 ;
    oboInOwl:hasExactSynonym "Arteria collateralis ulnaris inferior" .

ILX:0797494 a owl:Class ;
    rdfs:label "Radial recurrent artery" ;
    definition: "A branch of the radial artery that ascends toward the elbow and participates in the periarticular arterial anastomosis." ;
    rdfs:subClassOf UBERON:0001637 ;
    ilx.partOf: UBERON:0001404 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:22748,
        ILX:0797494 ;
    oboInOwl:hasExactSynonym "Arteria recurrens radialis" .

ILX:0797527 a owl:Class ;
    rdfs:label "First dorsal metacarpal artery" ;
    definition: "The first branch of the dorsal metacarpal arterial system, supplying the thumb, index finger, and adjacent dorsal hand. It commonly arises from the radial artery near the anatomical snuffbox." ;
    rdfs:subClassOf UBERON:0001637 ;
    ilx.partOf: UBERON:0001404 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:22761,
        ILX:0797527 ;
    oboInOwl:hasExactSynonym "Arteria metacarpalis dorsalis prima",
        "First dorsal metacarpal branch" .

ILX:0797510 a owl:Class ;
    rdfs:label "Posterior interosseous artery" ;
    definition: "A branch of the common interosseous artery that supplies the posterior compartment of the forearm and participates in wrist anastomoses." ;
    rdfs:subClassOf UBERON:0004259 ;
    ilx.partOf: UBERON:0001406 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:22811,
        ILX:0797510 ;
    oboInOwl:hasExactSynonym "Arteria interossea posterior" .

ILX:0797498 a owl:Class ;
    rdfs:label "Deep brachial vein" ;
    definition: "A deep vein accompanying the profunda brachii artery and draining the posterior compartment of the arm." ;
    rdfs:subClassOf UBERON:0004260 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:22938,
        ILX:0797498 ;
    oboInOwl:hasExactSynonym "Profunda brachii vein" .

ILX:0797511 a owl:Class ;
    rdfs:label "Posterior interosseous vein" ;
    definition: "A vein accompanying the posterior interosseous artery that drains the extensor compartment of the forearm." ;
    rdfs:subClassOf UBERON:0004259 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:22980,
        ILX:0797511 ;
    oboInOwl:hasExactSynonym "Vena interossea posterior" .

ILX:0797497 a owl:Class ;
    rdfs:label "Radial collateral artery" ;
    definition: "A terminal branch of the profunda brachii artery contributing to the arterial network around the elbow." ;
    rdfs:subClassOf UBERON:0001637 ;
    ilx.partOf: UBERON:0001399 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:23120,
        ILX:0797497 ;
    oboInOwl:hasExactSynonym "Anterior descending branch of profunda brachii artery" .

ILX:0797514 a owl:Class ;
    rdfs:label "Circumflex scapular artery" ;
    definition: "A branch of the subscapular artery that passes through the triangular space to supply muscles and structures on the posterior surface of the scapula." ;
    rdfs:subClassOf UBERON:0003515 ;
    ilx.partOf: UBERON:0001397 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:23179,
        ILX:0797514 ;
    oboInOwl:hasExactSynonym "Arteria circumflexa scapulae" .

ILX:0795289 a owl:Class ;
    rdfs:label "radial fossa" ;
    NIFRID:synonym "anatomical snuffbox" ;
    definition: "The radial fossa, also called the anatomical snuffbox, is a triangular depression on the lateral wrist. It is bordered by the tendons of the extensor pollicis longus, extensor pollicis brevis, and abductor pollicis longus, with the scaphoid and trapezium forming its floor. It houses the radial artery and is clinically relevant for assessing scaphoid fractures or arterial pulse." ;
    rdfs:subClassOf UBERON:0004704 ;
    ilx.partOf: UBERON:0001461 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/radial-fossa-1537018612> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:23452,
        ILX:0795289 ;
    ilxtr:hasIlxPreferredId FMA:23452 .

ILX:0795288 a owl:Class ;
    rdfs:label "dorsal wrist" ;
    definition: "The posterior aspect of the wrist, containing the extensor tendons and underlying carpal bones." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0008785 ;
    ILX:0777130 <https://www.uptodate.com/contents/anatomy-and-basic-biomechanics-of-the-wrist> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:24924,
        ILX:0795288 ;
    ilxtr:hasIlxPreferredId FMA:24924 .

