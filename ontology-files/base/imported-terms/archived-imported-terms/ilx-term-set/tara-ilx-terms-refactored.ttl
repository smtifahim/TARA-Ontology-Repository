    ilxtr:hasIlxPreferredId FMA:322185 .

ILX:0797523 a owl:Class ;
    rdfs:label "Medial supraclavicular nerve" ;
    definition: "A cutaneous branch of the cervical plexus that supplies sensation to the skin over the sternoclavicular region and upper chest near the midline." ;
    rdfs:subClassOf ILX:0797474 ;
    ilx.partOf: UBERON:0003725 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:0329233,
        ILX:0797523 ;
    oboInOwl:hasExactSynonym "Anterior supraclavicular nerve",
        "Medial branch of supraclavicular nerve" .

