ILX:0795311 a owl:Class ;
    rdfs:label "posterior axillary fold" ;
    NIFRID:synonym "posterior armpit fold" ;
    definition: "The posterior axillary fold, also known as the posterior armpit fold, refers to the inferior border of the posterior wall of axilla." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0008785 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/posterior-axillary-fold-1536887776> ;
