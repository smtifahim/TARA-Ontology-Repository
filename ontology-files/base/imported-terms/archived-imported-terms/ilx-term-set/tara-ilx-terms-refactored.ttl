    oboInOwl:hasExactSynonym "Motor branch of femoral nerve" .

ILX:0797489 a owl:Class ;
    rdfs:label "Proper palmar digital nerve" ;
    definition: "A terminal digital nerve supplying sensation to the sides of the fingers and adjacent palmar skin." ;
