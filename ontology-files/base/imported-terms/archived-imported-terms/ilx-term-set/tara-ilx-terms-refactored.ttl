### Classes

ILX:0797522 a owl:Class ;
    rdfs:label "Superior cardiac nerve" ;
    definition: "A sympathetic cardiac nerve arising from the superior cervical ganglion that contributes to the cardiac plexus and autonomic innervation of the heart." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0001989 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:6578,
        ILX:0797522 ;
    oboInOwl:hasExactSynonym "Superior cardiac branch of sympathetic trunk",
        "Superior cervical cardiac nerve" .

ILX:0797478 a owl:Class ;
    rdfs:label "Lesser occipital nerve" ;
    definition: "A branch of the cervical plexus (primarily C2) that supplies sensation to the scalp posterior and superior to the ear." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0003725 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:6871,
        ILX:0797478 ;
    oboInOwl:hasExactSynonym "Small occipital nerve" .

ILX:0797480 a owl:Class ;
    rdfs:label "Transverse cervical nerve" ;
    definition: "A superficial branch of the cervical plexus (C2-C3) providing sensory innervation to the skin of the anterior neck." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0003725 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId FMA:6873,
        ILX:0797480 ;
    oboInOwl:hasExactSynonym "Cervical cutaneous nerve",
        "Transverse cutaneous nerve of neck" .

