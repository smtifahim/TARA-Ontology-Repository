ILX:0794951 a owl:Class ;
    rdfs:label "lateral cutaneous nerve of the forearm" ;
    NIFRID:synonym "lateral antebrachial cutaneous nerve" ;
    definition: "The lateral cutaneous nerve of forearm (or lateral antebrachial cutaneous nerve) is a sensory nerve representing the continuation of the musculocutaneous nerve beyond the lateral edge of the tendon of the biceps brachii muscle. The lateral antebrachial cutaneous nerve provides sensory innervation to the skin of the lateral forearm. It pierces the deep fascia of forearm to enter the subcutaneous compartment before splitting into a volar branch and a dorsal branch. It is derived from C5, C6 ventral rami." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0002386 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0794951 ;
    ilxtr:hasIlxId ILX:0794951 ;
    ilxtr:hasIlxPreferredId ILX:0794951 .

ILX:0794952 a owl:Class ;
    rdfs:label "medial cutaneous nerve of the arm" ;
    NIFRID:synonym "lesser internal cutaneous nerve",
        "medial brachial cutaneous nerve" ;
    definition: "The medial cutaneous nerve of the arm (also known as the medial brachial cutaneous nerve and the lesser internal cutaneous nerve) is a sensory branch of the medial cord of the brachial plexus derived from spinal nerves C8-T1. It provides sensory innervation to the lower portion of the medial arm. It descends accompanied by the basilic vein." ;
    rdfs:subClassOf UBERON:0003433 ;
    ilx.partOf: UBERON:0001814 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0794952 ;
    ilxtr:hasIlxId ILX:0794952 ;
    ilxtr:hasIlxPreferredId ILX:0794952 .

ILX:0794953 a owl:Class ;
    rdfs:label "medial cutaneous nerve of the forearm" ;
    NIFRID:synonym "medial antebrachial cutaneous nerve" ;
    definition: "The medial cutaneous nerve of the forearm (also known as the medial antebrachial cutaneous nerve) is a sensory branch of the medial cord of the brachial plexus derived from the ventral rami of spinal nerves C8-T1. It provides sensory innervation to the skin of the medial forearm." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0001814,
        UBERON:0003433 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0794953 ;
    ilxtr:hasIlxId ILX:0794953 ;
    ilxtr:hasIlxPreferredId ILX:0794953 .

ILX:0794966 a owl:Class ;
    rdfs:label "suprascapular nerve" ;
    definition: "A branch of the upper trunk of the brachial plexus (C5-C6) supplying the supraspinatus and infraspinatus muscles and contributing articular branches to the shoulder." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0001814 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0794966 ;
    ilxtr:hasIlxId ILX:0794966 ;
    ilxtr:hasIlxPreferredId ILX:0794966 ;
    oboInOwl:hasExactSynonym "Nervus suprascapularis" .

ILX:0794967 a owl:Class ;
    rdfs:label "posterior interosseous nerve" ;
    definition: "The continuation of the deep branch of the radial nerve after traversing the supinator muscle, supplying most extensor muscles of the forearm." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: ILX:0794977 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0794967 ;
    ilxtr:hasIlxId ILX:0794967 ;
    ilxtr:hasIlxPreferredId ILX:0794967 ;
    oboInOwl:hasExactSynonym "Posterior antebrachial interosseous nerve" .

ILX:0794975 a owl:Class ;
    rdfs:label "medial pectoral nerve" ;
    NIFRID:synonym "anterior thoracic nerve",
        "medial anterior thoracic nerve" ;
    definition: "The medial pectoral nerve (also known as the medial anterior thoracic nerve) is (typically) a branch of the medial cord of the brachial plexus and is derived from ventral rami  C8-T1. It provides motor innervation to the pectoralis minor muscle, and part of the pectoralis major muscle." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0001814 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0794975 ;
    ilxtr:hasIlxId ILX:0794975 ;
    ilxtr:hasIlxPreferredId ILX:0794975 .

ILX:0794977 a owl:Class ;
    rdfs:label "deep branch of radial nerve" ;
    NIFRID:synonym "Posterior interosseous nerve" ;
    definition: "The radial nerve divides into a superficial (sensory) and deep (motor) branch at the cubital fossa. The deep branch of the radial nerve winds to the back of the forearm around the lateral side of the radius between the two planes of fibers of the supinator, and is prolonged downward between the superficial and deep layers of muscles, to the middle of the forearm. The deep branch and its continuation, called the posterior interosseous nerve, provides motor function to the muscles in the posterior compartment of the forearm, which are mostly the extensor muscles of the wrist and hand." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0001492 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0794977 ;
    ilxtr:hasIlxId ILX:0794977 ;
    ilxtr:hasIlxPreferredId ILX:0794977 .

ILX:0794979 a owl:Class ;
    rdfs:label "dorsal scapular nerve" ;
    definition: "The dorsal scapular nerve is a branch of the brachial plexus, usually derived from the ventral ramus of cervical nerve C5. It provides motor innervation to the rhomboid major muscle, rhomboid minor muscle, and sometimes the levator scapulae muscle." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0001814 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0794979 ;
    ilxtr:hasIlxId ILX:0794979 ;
    ilxtr:hasIlxPreferredId ILX:0794979 .

ILX:0794996 a owl:Class ;
    rdfs:label "Ilioinguinal nerve" ;
    NIFRID:synonym """Ilio-inguinal nerve\r
Nervus ilio-inguinalis""" ;
    definition: "The ilioinguinal nerve is a branch of the first lumbar nerve (L1). The ilioinguinal nerve then perforates the transversus abdominis near the anterior part of the iliac crest, and communicates with the iliohypogastric nerve between the transversus and the internal oblique muscle." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0034987 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0794996 ;
    ilxtr:hasIlxId ILX:0794996 ;
    ilxtr:hasIlxPreferredId ILX:0794996 .

ILX:0794999 a owl:Class ;
    rdfs:label "Lateral cutaneous nerve of thigh" ;
    NIFRID:synonym "Lateral femoral cutaneous nerve" ;
    definition: "The lateral cutaneous nerve of the thigh (also called the lateral femoral cutaneous nerve) is a cutaneous nerve of the thigh. It originates from the second and third lumbar nerves which are derived from the lumbar plexus. It passes under the inguinal ligament to reach the thigh. It supplies sensation to the skin on the lateral part of the thigh by an anterior branch and a posterior branch. It is derived from the ventral rami of L2 and L3." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0034987 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0794999 ;
    ilxtr:hasIlxId ILX:0794999 ;
    ilxtr:hasIlxPreferredId ILX:0794999 .

ILX:0795002 a owl:Class ;
    rdfs:label "iliohypogastric nerve" ;
    NIFRID:synonym "Iliopubic nerve" ;
    definition: "The iliohypogastric nerve is a nerve that originates from the lumbar plexus that supplies sensation to skin over the lateral gluteal and hypogastric regions and motor to the internal oblique muscles and transverse abdominal muscles. It is derived from the ventral ramus of L1. It is a branch of the lumbar plexus that provides sensory innervation to the skin of the gluteal region and lower abdomen, as well as motor control to key muscles of the lower abdominal wall" ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0034987 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795002 ;
    ilxtr:hasIlxId ILX:0795002 ;
    ilxtr:hasIlxPreferredId ILX:0795002 .

ILX:0795005 a owl:Class ;
    rdfs:label "Posterior cutaneous nerve of arm" ;
    NIFRID:synonym "Posterior brachial cutaneous nerve" ;
    definition: "The posterior cutaneous nerve of arm (also known as posterior brachial cutaneous nerve) is a branch of the radial nerve that provides sensory innervation for much of the skin on the back of the arm. It is derived from the ventral rami of C5, C6, C7, and C8." ;
    rdfs:subClassOf UBERON:0003433 ;
    ilx.partOf: UBERON:0001492 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795005 ;
    ilxtr:hasIlxId ILX:0795005 ;
    ilxtr:hasIlxPreferredId ILX:0795005 .

ILX:0795007 a owl:Class ;
    rdfs:label "superior lateral cutaneous nerve of arm" ;
    NIFRID:synonym "Superior lateral brachial cutaneous nerve",
        "Upper lateral cutaneous nerve of arm" ;
    definition: "The superior lateral cutaneous nerve of arm (or superior lateral brachial cutaneous nerve) is the continuation of the posterior branch of the axillary nerve, after it pierces the deep fascia. It is derived from the ventral rami of C5 and C6." ;
    rdfs:subClassOf ILX:0797544 ;
    ilx.partOf: UBERON:0001493 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795007 ;
    ilxtr:hasIlxId ILX:0795007 ;
    ilxtr:hasIlxPreferredId ILX:0795007 .

ILX:0795018 a owl:Class ;
    rdfs:label "proper palmar digital branches of median nerve" ;
    NIFRID:synonym "Proper Palmar Digital Branches of Median Nerve",
        "proper palmar digital nerve of median nerve" ;
    definition: "Proper palmar digital nerves arise from the common digital branches of the median nerve and innervate the lateral 3 digits and the lateral side of the ring (4th) digit." ;
    rdfs:subClassOf UBERON:0001027 ;
    ilx.partOf: UBERON:0001148 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795018 ;
    ilxtr:hasIlxId ILX:0795018 ;
    ilxtr:hasIlxPreferredId ILX:0795018 .

ILX:0795021 a owl:Class ;
    rdfs:label "Inferior lateral cutaneous nerve of arm" ;
    NIFRID:synonym "Inferior lateral brachial cutaneous nerve",
        "Lower lateral cutaneous nerve of arm" ;
    definition: "The inferior lateral cutaneous nerve of arm is a nerve found in humans and other animals. It is also called the inferior lateral brachial cutaneous nerve. It is a branch of the radial nerve that provides sensory and vasomotor innervation to the lower, lateral aspect of the arm.  It is derived from the ventral rami of C5 and C6." ;
    rdfs:subClassOf ILX:0797544 ;
    ilx.partOf: UBERON:0001492 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795021 ;
    ilxtr:hasIlxId ILX:0795021 ;
    ilxtr:hasIlxPreferredId ILX:0795021 .

ILX:0795286 a owl:Class ;
    rdfs:label "clavipectoral triangle" ;
    definition: "A triangular region bounded by the clavicle superiorly, the pectoralis major medially, and the deltoid laterally." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0008785 ;
    ILX:0777130 <https://en.wikipedia.org/wiki/Clavipectoral_triangle> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795286 ;
    ilxtr:hasIlxId ILX:0795286 ;
    ilxtr:hasIlxPreferredId ILX:0795286 .

ILX:0795304 a owl:Class ;
    rdfs:label "rectus femoris muscle" ;
    definition: "The rectus femoris is a muscle in the anterior compartment of the thigh. It forms part of the quadriceps femoris muscle complex, and is the only muscle in this group to cross both the hip joint and the knee joints." ;
    rdfs:subClassOf UBERON:0001630 ;
    ilx.partOf: UBERON:0008784 ;
    ILX:0777130 <https://en.wikipedia.org/wiki/Rectus_femoris_muscle> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795304 ;
    ilxtr:hasIlxId ILX:0795304 ;
    ilxtr:hasIlxPreferredId ILX:0795304 .

ILX:0795318 a owl:Class ;
    rdfs:label "fourth metacarpal bone" ;
    definition: "The long bone in the hand that connects the fourth finger to the carpal bones of the wrist. The fourth metacarpal bone is shorter and smaller than the third. The base is small and quadrilateral." ;
    rdfs:subClassOf UBERON:0001474 ;
    ilx.partOf: UBERON:0001442 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/metacarpal-iv-121123560> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795318 ;
    ilxtr:hasIlxId ILX:0795318 ;
    ilxtr:hasIlxPreferredId ILX:0795318 .

ILX:0795328 a owl:Class ;
    rdfs:label "hyoid tubercle" ;
    definition: "A small prominence on the posterior end of the greater horn of hyoid bone, serving as an attachment point for muscles and ligaments. Each tubercle of hyoid bone provides an attachment site for a lateral thyrohyoid ligament." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0000974 ;
    ILX:0777130 <https://en.wikipedia.org/wiki/Hyoid_bone> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795328 ;
    ilxtr:hasIlxId ILX:0795328 ;
    ilxtr:hasIlxPreferredId ILX:0795328 .

ILX:0795329 a owl:Class ;
    rdfs:label "inguinal crease" ;
    definition: "The inguinal crease refers to the skin fold or line that forms where the lower abdomen meets the thigh, often most noticeable when the hip is flexed. It marks the boundary between the abdominal and thigh regions." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0000916 ;
    ILX:0777130 <https://www.sciencedirect.com/topics/medicine-and-dentistry/inguinal-region> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795329 ;
    ilxtr:hasIlxId ILX:0795329 ;
    ilxtr:hasIlxPreferredId ILX:0795329 .

ILX:0795330 a owl:Class ;
    rdfs:label "popliteal crease" ;
    definition: "This is the visible skin fold or line at the back of the knee, formed when the knee is flexed. It is a superficial feature and serves as a landmark for the location of the popliteal fossa beneath." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0000978 ;
    ILX:0777130 <https://en.wikipedia.org/wiki/Popliteal_fossa> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795330 ;
    ilxtr:hasIlxId ILX:0795330 ;
    ilxtr:hasIlxPreferredId ILX:0795330 .

ILX:0795331 a owl:Class ;
    rdfs:label "suprasternal fossa" ;
    NIFRID:synonym "Fossa jugularis",
        "Interclavicular fossa",
        "Jugular notch" ;
    definition: "This is the depression on the skin surface of the neck between the sternal heads of the sternocleidomastoid muscles. This area is situated just above the manubrium of the sternum and is a visible landmark in the neck." ;
    rdfs:subClassOf UBERON:0004704 ;
    ilx.partOf: UBERON:0000974 ;
    ILX:0777130 <https://en.wikipedia.org/wiki/Suprasternal_notch> ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795331 ;
    ilxtr:hasIlxId ILX:0795331 ;
    ilxtr:hasIlxPreferredId ILX:0795331 .

ILX:0795332 a owl:Class ;
    rdfs:label "cubital crease" ;
    definition: "The anterior skin fold of the elbow, marking the transition between the upper arm and forearm, overlying the cubital fossa." ;
    rdfs:subClassOf UBERON:0019243 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795332 ;
    ilxtr:hasIlxId ILX:0795332 ;
    ilxtr:hasIlxPreferredId ILX:0795332 .

ILX:0795333 a owl:Class ;
    rdfs:label "dorsal wrist crease" ;
    definition: "The dorsal wrist crease is the skin fold that forms on the back (dorsal) side of the wrist, often visible when the hand is extended. It marks the junction between the forearm and the hand and is located near the proximal ends of the metacarpal bones." ;
    rdfs:subClassOf UBERON:0019243 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795333 ;
    ilxtr:hasIlxId ILX:0795333 ;
    ilxtr:hasIlxPreferredId ILX:0795333 .

ILX:0795334 a owl:Class ;
    rdfs:label "palmar wrist crease" ;
    definition: "The palmar wrist crease is the transverse skin fold that appears on the palm side of the wrist when the hand is flexed. It marks the boundary between the forearm and the palm and is located approximately at the level of the distal radius and ulna." ;
    rdfs:subClassOf UBERON:0019243 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795334 ;
    ilxtr:hasIlxId ILX:0795334 ;
    ilxtr:hasIlxPreferredId ILX:0795334 .

ILX:0795335 a owl:Class ;
    rdfs:label "abductor pollicis longus tendon" ;
    definition: "The tendon of the muscle that abducts and extends the thumb, located in the posterior compartment of the forearm." ;
    rdfs:subClassOf UBERON:0000043 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795335 ;
    ilxtr:hasIlxId ILX:0795335 ;
    ilxtr:hasIlxPreferredId ILX:0795335 .

ILX:0795336 a owl:Class ;
    rdfs:label "extensor pollicis brevis tendon" ;
    definition: "The tendon of the muscle extending the proximal phalanx of the thumb, positioned laterally in the forearm." ;
    rdfs:subClassOf UBERON:0000043 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795336 ;
    ilxtr:hasIlxId ILX:0795336 ;
    ilxtr:hasIlxPreferredId ILX:0795336 .

ILX:0795337 a owl:Class ;
    rdfs:label "extensor pollicis longus tendon" ;
    definition: "The tendon of the muscle responsible for extending the thumb at the interphalangeal joint." ;
    rdfs:subClassOf UBERON:0000043 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0795337 ;
    ilxtr:hasIlxId ILX:0795337 ;
    ilxtr:hasIlxPreferredId ILX:0795337 .

ILX:0797391 a owl:Class ;
    rdfs:label "superficial branch of radial nerve" ;
    definition: "The superficial branch of the radial nerve passes along the front of the radial side of the forearm to the commencement of its lower third. It is a sensory nerve." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.partOf: UBERON:0001492 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0797391 ;
    ilxtr:hasIlxId ILX:0797391 ;
    ilxtr:hasIlxPreferredId ILX:0797391 .

ILX:0797451 a owl:Class ;
    rdfs:label "subcostal nerve" ;
    definition: "The anterior division (rami anteriores; ventral divisions) of the twelfth thoracic spinal nerve. It emerges below the twelfth" ;
    rdfs:subClassOf UBERON:0003726 ;
    ilxr:type ilx.type:term ;
    ilxtr:hasExistingId ILX:0797451 ;
    ilxtr:hasIlxId ILX:0797451 ;
    ilxtr:hasIlxPreferredId ILX:0797451 .

ILX:0797461 a owl:Class ;
    rdfs:label "dorsal digital nerve of radial nerve" ;
    definition: "A sensory branch of the superficial radial nerve supplying the dorsal aspect of the lateral digits of the hand." ;
