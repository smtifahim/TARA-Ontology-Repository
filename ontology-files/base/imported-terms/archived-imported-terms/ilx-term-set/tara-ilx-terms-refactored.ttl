ILX:0795305 a owl:Class ;
    rdfs:label "medial malleolus" ;
    definition: "A prominent bony projection on the medial aspect of the distal tibia, forming part of the ankle joint." ;
    rdfs:subClassOf UBERON:0001062 ;
    ilx.partOf: UBERON:0008784 ;
    ILX:0777130 <https://www.imaios.com/en/e-anatomy/anatomical-structure/medial-malleolus-1537020872> ;
