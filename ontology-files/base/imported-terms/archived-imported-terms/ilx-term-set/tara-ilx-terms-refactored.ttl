ILX:0794900 a owl:Class ;
    rdfs:label "supraclavicular nerve" ;
    definition: "Cutaneous nerve of the neck originating from nerve point of the neck and providing sensory innervation to skin over the clavicle, shoulder and chest. REVA annotation term." ;
    rdfs:subClassOf UBERON:0001021 ;
    ilx.includeForSPARC: ILX:0794901,
        ILX:0794902 ;
