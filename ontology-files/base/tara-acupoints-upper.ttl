               rdfs:subPropertyOf dcterms:format ;
               rdfs:range dcterms:PhysicalMedium ;
               rdfs:domain dcterms:PhysicalResource .


###  http://purl.org/dc/terms/modified
dcterms:modified rdf:type owl:AnnotationProperty ;
                 rdfs:label "Date Modified"@en ;
                 skos:definition "Date on which the resource was changed."@en ;
                 rdfs:subPropertyOf dcterms:date ;
                 rdfs:range rdfs:Literal .


###  http://purl.org/dc/terms/provenance
dcterms:provenance rdf:type owl:AnnotationProperty ;
                   rdfs:comment "The statement may include a description of any changes successive custodians made to the resource."@en ;
                   rdfs:label "Provenance"@en ;
                   skos:definition "A statement of any changes in ownership and custody of the resource since its creation that are significant for its authenticity, integrity, and interpretation."@en ;
                   rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/terms/publisher
dcterms:publisher rdf:type owl:AnnotationProperty ;
                  rdfs:comment "Examples of a Publisher include a person, an organization, or a service. Typically, the name of a Publisher should be used to indicate the entity."@en ;
                  rdfs:label "Publisher"@en ;
                  skos:definition "An entity responsible for making the resource available."@en ;
                  rdfs:subPropertyOf dc:publisher ;
                  rdfs:range dcterms:Agent .


###  http://purl.org/dc/terms/references
dcterms:references rdf:type owl:AnnotationProperty ;
                   rdfs:label "References"@en ;
                   skos:definition "A related resource that is referenced, cited, or otherwise pointed to by the described resource."@en ;
                   skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                   rdfs:subPropertyOf dcterms:relation .


###  http://purl.org/dc/terms/relation
dcterms:relation rdf:type owl:AnnotationProperty ;
                 rdfs:comment "Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system."@en ;
                 rdfs:label "Relation"@en ;
                 skos:definition "A related resource."@en ;
                 skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                 rdfs:subPropertyOf dc:relation .


###  http://purl.org/dc/terms/replaces
dcterms:replaces rdf:type owl:AnnotationProperty ;
                 rdfs:label "Replaces"@en ;
                 skos:definition "A related resource that is supplanted, displaced, or superseded by the described resource."@en ;
                 skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                 rdfs:subPropertyOf dcterms:relation .


###  http://purl.org/dc/terms/requires
dcterms:requires rdf:type owl:AnnotationProperty ;
                 rdfs:label "Requires"@en ;
                 skos:definition "A related resource that is required by the described resource to support its function, delivery, or coherence."@en ;
                 skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                 rdfs:subPropertyOf dcterms:relation .


###  http://purl.org/dc/terms/rights
dcterms:rights rdf:type owl:AnnotationProperty ;
               rdfs:comment "Typically, rights information includes a statement about various property rights associated with the resource, including intellectual property rights."@en ;
               rdfs:label "Rights"@en ;
               skos:definition "Information about rights held in and over the resource."@en ;
               rdfs:subPropertyOf dc:rights ;
               rdfs:range dcterms:RightsStatement .


###  http://purl.org/dc/terms/rightsHolder
dcterms:rightsHolder rdf:type owl:AnnotationProperty ;
                     rdfs:label "Rights Holder"@en ;
                     skos:definition "A person or organization owning or managing rights over the resource."@en ;
                     rdfs:subPropertyOf tara:dctermsMetadata .


###  http://purl.org/dc/terms/source
dcterms:source rdf:type owl:AnnotationProperty ;
               rdfs:comment "The described resource may be derived from the related resource in whole or in part. Recommended best practice is to identify the related resource by means of a string conforming to a formal identification system."@en ;
               rdfs:label "Source"@en ;
               skos:definition "A related resource from which the described resource is derived."@en ;
               skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
               rdfs:subPropertyOf dc:source ,
                                  dcterms:relation .


###  http://purl.org/dc/terms/spatial
dcterms:spatial rdf:type owl:AnnotationProperty ;
                rdfs:label "Spatial Coverage"@en ;
                skos:definition "Spatial characteristics of the resource."@en ;
                rdfs:subPropertyOf dcterms:coverage ;
                rdfs:range dcterms:Location .


###  http://purl.org/dc/terms/subject
dcterms:subject rdf:type owl:AnnotationProperty ;
                rdfs:comment "Typically, the subject will be represented using keywords, key phrases, or classification codes. Recommended best practice is to use a controlled vocabulary. To describe the spatial or temporal topic of the resource, use the Coverage element."@en ;
                rdfs:label "Subject"@en ;
                skos:definition "The topic of the resource."@en ;
                skos:note "This term is intended to be used with non-literal values as defined in the DCMI Abstract Model (http://dublincore.org/documents/abstract-model/). As of December 2007, the DCMI Usage Board is seeking a way to express this intention with a formal range declaration."@en ;
                rdfs:subPropertyOf dc:subject .


###  http://purl.org/dc/terms/tableOfContents
dcterms:tableOfContents rdf:type owl:AnnotationProperty ;
                        rdfs:label "table of contents" ;
                        skos:definition "A list of subunits of the resource." ;
                        rdfs:subPropertyOf dcterms:description .


###  http://purl.org/dc/terms/temporal
dcterms:temporal rdf:type owl:AnnotationProperty ;
                 rdfs:label "Temporal Coverage"@en ;
                 skos:definition "Temporal characteristics of the resource."@en ;
                 rdfs:subPropertyOf dcterms:coverage ;
                 rdfs:range dcterms:PeriodOfTime .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "Title"@en ;
              skos:definition "A name given to the resource."@en ;
              skos:note "In current practice, this term is used primarily with literal values; however, there are important uses with non-literal values as well. As of December 2007, the DCMI Usage Board is leaving this range unspecified pending an investigation of options."@en ;
              rdfs:subPropertyOf dc:title .


###  http://purl.org/dc/terms/type
dcterms:type rdf:type owl:AnnotationProperty ;
             rdfs:comment "Recommended practice is to use a controlled vocabulary such as the DCMI Type Vocabulary [DCMI-TYPE]. To describe the file format, physical medium, or dimensions of the resource, use the property Format."@en ;
             rdfs:label "Type"@en ;
             skos:definition "The nature or genre of the resource."@en ;
             rdfs:subPropertyOf dc:type .


###  http://purl.org/dc/terms/valid
dcterms:valid rdf:type owl:AnnotationProperty ;
              rdfs:label "Date Valid"@en ;
              skos:definition "Date (often a range) of validity of a resource."@en ;
              rdfs:subPropertyOf dcterms:date ;
              rdfs:range rdfs:Literal .


###  http://uri.interlex.org/base/ilx_0112785
<http://uri.interlex.org/base/ilx_0112785> rdf:type owl:AnnotationProperty ;
                                           rdfs:label "isPartOf" ;
                                           rdfs:subPropertyOf tara:ilxAnnotationProperty .


###  http://uri.interlex.org/base/ilx_0381387
<http://uri.interlex.org/base/ilx_0381387> rdf:type owl:AnnotationProperty ;
                                           rdfs:label "hasLaterality" ;
                                           rdfs:subPropertyOf tara:ilxAnnotationProperty .


###  http://uri.interlex.org/base/ilx_0383241
<http://uri.interlex.org/base/ilx_0383241> rdf:type owl:AnnotationProperty ;
                                           rdfs:label "isDeprecated" ;
                                           rdfs:subPropertyOf tara:ilxAnnotationProperty .


###  http://uri.interlex.org/base/ilx_0777130
<http://uri.interlex.org/base/ilx_0777130> rdf:type owl:AnnotationProperty ;
                                           rdfs:label "hasDefinitionSource" ;
                                           rdfs:subPropertyOf tara:ilxAnnotationProperty .


###  http://uri.interlex.org/base/ilx_0778161
<http://uri.interlex.org/base/ilx_0778161> rdf:type owl:AnnotationProperty ;
                                           rdfs:label "subClassOf" ;
                                           rdfs:subPropertyOf tara:ilxAnnotationProperty .


###  http://uri.interlex.org/tgbugs/uris/readable/hasExistingId
<http://uri.interlex.org/tgbugs/uris/readable/hasExistingId> rdf:type owl:AnnotationProperty ;
                                                             rdfs:subPropertyOf tara:ilxAnnotationProperty .


###  http://www.acupunctureresearch.org/tara/ontology/dctermsMetadata
tara:dctermsMetadata rdf:type owl:AnnotationProperty ;
                     dcterms:description "An annotation property to group all dcterms metadata properties specific to TARA Acupoints Ontology."@en ;
                     rdfs:label "dcterms:topMetadataProperty" .


###  http://www.acupunctureresearch.org/tara/ontology/foafAnnotationProperty
tara:foafAnnotationProperty rdf:type owl:AnnotationProperty ;
                            dcterms:description "An annotation property to group all foaf: annotation properties specific to TARA Acupoints Ontology." ;
                            rdfs:label "foaf:topAnnotationProperty" .


###  http://www.acupunctureresearch.org/tara/ontology/hasCompactURI
tara:hasCompactURI rdf:type owl:AnnotationProperty ;
                   <http://purl.obolibrary.org/obo/IAO_0000118> "CURIE" ;
                   dcterms:description "A CURIE (Compact URI) for an ontology IRI is a shortened, human-readable abbreviation consisting of a prefix and a local identifier separated by a colon. For example, the full IRI http://purl.obolibrary.org/obo/UBERON_0000948 condenses into the CURIE UBERON:0000948."@en ;
                   rdfs:label "Compact URI"@en ;
                   rdfs:subPropertyOf dcterms:identifier .


###  http://www.acupunctureresearch.org/tara/ontology/hasSourceSheetColumnLabel
tara:hasSourceSheetColumnLabel rdf:type owl:AnnotationProperty ;
                               dcterms:description "An annotation property used to link a formal concept, property, or class within an ontology to its exact literal string representation used as a column header in a data extraction spreadsheet or CSV file. As a subproperty of skos:hiddenLabel, it preserves the raw, unformatted, and informal terminology of the source data layer for ingestion and mapping purposes, without polluting the clean, formal vocabulary defined by skos:prefLabel."@en ;
                               rdfs:label "Source Sheet Column Label"@en ;
                               rdfs:subPropertyOf skos:hiddenLabel .


###  http://www.acupunctureresearch.org/tara/ontology/iaoAnnotationProperty
tara:iaoAnnotationProperty rdf:type owl:AnnotationProperty ;
                           dcterms:description "An annotation property to group all IAO annotation properties specific to TARA Acupoints Ontology." ;
                           rdfs:label "iao:topAnnotationProperty" .


###  http://www.acupunctureresearch.org/tara/ontology/ilxAnnotationProperty
tara:ilxAnnotationProperty rdf:type owl:AnnotationProperty ;
                           dcterms:description "An annotation property to group all ILX annotation properties specific to TARA Acupoints Ontology." ;
                           rdfs:label "ilx:topAnnotationProperty" .


###  http://www.acupunctureresearch.org/tara/ontology/oboInOwlAnnotationProperty
tara:oboInOwlAnnotationProperty rdf:type owl:AnnotationProperty ;
                                dcterms:description "An annotation property to group all oboInOwl annotation properties specific to TARA Acupoints Ontology." ;
                                rdfs:label "oboInOwl:topAnnotationProperty" .


###  http://www.acupunctureresearch.org/tara/ontology/skosAnntotationProperty
tara:skosAnntotationProperty rdf:type owl:AnnotationProperty ;
                             dcterms:description "An annotation property to group all skos annotation properties specific to TARA Acupoints Ontology." ;
                             rdfs:label "skos:topAnnotationProperty" .


###  http://www.geneontology.org/formats/oboInOwl#abbrev
oboInOwl:abbrev rdf:type owl:AnnotationProperty ;
                rdfs:label "abbreviation" ;
                rdfs:subPropertyOf tara:oboInOwlAnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#consider
oboInOwl:consider rdf:type owl:AnnotationProperty ;
                  rdfs:subPropertyOf tara:oboInOwlAnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#created_by
oboInOwl:created_by rdf:type owl:AnnotationProperty ;
                    rdfs:label "created by" ;
                    rdfs:subPropertyOf tara:oboInOwlAnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#creation_date
oboInOwl:creation_date rdf:type owl:AnnotationProperty ;
                       rdfs:label "creation date" ;
                       rdfs:subPropertyOf tara:oboInOwlAnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#hasAlternativeId
oboInOwl:hasAlternativeId rdf:type owl:AnnotationProperty ;
                          rdfs:subPropertyOf tara:oboInOwlAnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym
oboInOwl:hasBroadSynonym rdf:type owl:AnnotationProperty ;
                         <http://purl.obolibrary.org/obo/IAO_0000115> "An alternative label for a class or property which has a more general meaning than the preferred name/primary label." ;
                         rdfs:label "has broad synonym"@en ;
                         rdfs:seeAlso "https://github.com/information-artifact-ontology/ontology-metadata/issues/18" ;
                         rdfs:subPropertyOf <http://purl.obolibrary.org/obo/IAO_0000118> .


###  http://www.geneontology.org/formats/oboInOwl#hasDbXref
oboInOwl:hasDbXref rdf:type owl:AnnotationProperty ;
                   rdfs:subPropertyOf tara:oboInOwlAnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#hasExactSynonym
oboInOwl:hasExactSynonym rdf:type owl:AnnotationProperty ;
                         <http://purl.obolibrary.org/obo/IAO_0000115> "An alternative label for a class or property which has the exact same meaning than the preferred name/primary label." ;
                         rdfs:label "has exact synonym"@en ;
                         rdfs:seeAlso "https://github.com/information-artifact-ontology/ontology-metadata/issues/20" ;
                         rdfs:subPropertyOf <http://purl.obolibrary.org/obo/IAO_0000118> .


###  http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym
oboInOwl:hasNarrowSynonym rdf:type owl:AnnotationProperty ;
                          <http://purl.obolibrary.org/obo/IAO_0000115> "An alternative label for a class or property which has a more specific meaning than the preferred name/primary label." ;
                          rdfs:label "has narrow synonym"@en ;
                          rdfs:seeAlso "https://github.com/information-artifact-ontology/ontology-metadata/issues/19" ;
                          rdfs:subPropertyOf <http://purl.obolibrary.org/obo/IAO_0000118> .


###  http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym
oboInOwl:hasRelatedSynonym rdf:type owl:AnnotationProperty ;
                           <http://purl.obolibrary.org/obo/IAO_0000115> "An alternative label for a class or property that has been used synonymously with the primary term name, but the usage is not strictly correct." ;
                           rdfs:label "has related synonym"@en ;
                           rdfs:seeAlso "https://github.com/information-artifact-ontology/ontology-metadata/issues/21" ;
                           rdfs:subPropertyOf <http://purl.obolibrary.org/obo/IAO_0000118> .


###  http://www.geneontology.org/formats/oboInOwl#is_class_level
oboInOwl:is_class_level rdf:type owl:AnnotationProperty ;
                        rdfs:subPropertyOf tara:oboInOwlAnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#is_metadata_tag
oboInOwl:is_metadata_tag rdf:type owl:AnnotationProperty ;
                         rdfs:subPropertyOf tara:oboInOwlAnnotationProperty .


###  http://www.geneontology.org/formats/oboInOwl#shorthand
oboInOwl:shorthand rdf:type owl:AnnotationProperty ;
                   rdfs:subPropertyOf tara:oboInOwlAnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#isDefinedBy
rdfs:isDefinedBy rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#seeAlso
rdfs:seeAlso rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty ;
              rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
              rdfs:label "alternative label" ;
              skos:definition "an alternative lexical label for a resource" ;
              skos:example "Acronyms, abbreviations, spelling variants, and irregular plural/singular forms may be included among the alternative labels for a concept. Mis-spelled terms are normally included as hidden labels (see skos:hiddenLabel)." ;
              skos:note "The range of skos:altLabel is the class of RDF plain literals." ,
                        "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties." ;
              rdfs:subPropertyOf tara:skosAnntotationProperty ,
                                 rdfs:label .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty ;
                rdfs:subPropertyOf tara:skosAnntotationProperty .


###  http://www.w3.org/2004/02/skos/core#changeNote
skos:changeNote rdf:type owl:AnnotationProperty ;
                rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                rdfs:label "change note" ;
                skos:definition "a note about a modification to a concept" ;
                rdfs:subPropertyOf skos:note .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty ;
                rdfs:subPropertyOf tara:skosAnntotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty ;
                rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                rdfs:label "definition" ;
                skos:definition "a statement or formal explanation of the meaning of a concept" ;
                rdfs:subPropertyOf dcterms:description ,
                                   tara:skosAnntotationProperty ,
                                   skos:note .


###  http://www.w3.org/2004/02/skos/core#editorialNote
skos:editorialNote rdf:type owl:AnnotationProperty ;
                   rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                   rdfs:label "editorial note" ;
                   skos:definition "a note for an editor, translator or maintainer of the vocabulary" ;
                   rdfs:subPropertyOf skos:note .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty ;
                rdfs:subPropertyOf tara:skosAnntotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty ;
             rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
             rdfs:label "example" ;
             skos:definition "an example of the use of a concept" ;
             rdfs:subPropertyOf skos:note .


###  http://www.w3.org/2004/02/skos/core#hiddenLabel
skos:hiddenLabel rdf:type owl:AnnotationProperty ;
                 rdfs:label "hidden label" ;
                 skos:definition "The property skos:hiddenLabel is used to assign a hidden lexical label to a resource. A hidden lexical label is a string of characters that a Knowledge Organization System (KOS) designer would like to be accessible to applications performing text-based indexing and search operations, but would not like to be visible to users on visual displays." ;
                 rdfs:subPropertyOf tara:skosAnntotationProperty ,
                                    rdfs:label .


###  http://www.w3.org/2004/02/skos/core#historyNote
skos:historyNote rdf:type owl:AnnotationProperty ;
                 rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
                 rdfs:label "history note" ;
                 skos:definition "a note about the past state, use, or meaning of a concept" ;
                 rdfs:subPropertyOf skos:note .


###  http://www.w3.org/2004/02/skos/core#narrowMatch
skos:narrowMatch rdf:type owl:AnnotationProperty ;
                 rdfs:subPropertyOf tara:skosAnntotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty ;
          rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
          rdfs:label "note" ;
          skos:definition "a general note, for any purpose" ;
          skos:scopeNote "This property may be used directly, or as a super-property for more specific note types." ;
          rdfs:subPropertyOf tara:skosAnntotationProperty ,
                             rdfs:comment .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
               rdfs:label "preferred label" ;
               skos:definition "the preferred lexical label for a resource, in a given language" ;
               skos:note "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag." ,
                         "The range of skos:prefLabel is the class of RDF plain literals." ,
                         "skos:prefLabel, skos:altLabel and skos:hiddenLabel are pairwise disjoint properties." ;
               rdfs:subPropertyOf tara:skosAnntotationProperty ,
                                  rdfs:label .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
skos:relatedMatch rdf:type owl:AnnotationProperty ;
                  rdfs:subPropertyOf tara:skosAnntotationProperty .


###  http://www.w3.org/2004/02/skos/core#scopeNote
skos:scopeNote rdf:type owl:AnnotationProperty ;
               rdfs:isDefinedBy <http://www.w3.org/2004/02/skos/core> ;
               rdfs:label "scope note" ;
               skos:definition "a note that helps to clarify the meaning and/or the use of a concept" ;
               rdfs:subPropertyOf skos:note .


###  http://xmlns.com/foaf/0.1/depiction
foaf:depiction rdf:type owl:AnnotationProperty ;
               rdfs:subPropertyOf tara:foafAnnotationProperty .


###  http://xmlns.com/foaf/0.1/homepage
foaf:homepage rdf:type owl:AnnotationProperty ;
              rdfs:subPropertyOf tara:foafAnnotationProperty .


###  http://xmlns.com/foaf/0.1/mbox
foaf:mbox rdf:type owl:AnnotationProperty ;
          rdfs:subPropertyOf tara:foafAnnotationProperty .


###  http://xmlns.com/foaf/0.1/page
foaf:page rdf:type owl:AnnotationProperty ;
          rdfs:subPropertyOf tara:foafAnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://purl.org/dc/terms/URI
dcterms:URI rdf:type rdfs:Datatype ;
            rdfs:isDefinedBy <http://www.ietf.org/rfc/rfc3986.txt> ;
            rdfs:label "URI"@en ;
            skos:definition "The set of identifiers constructed according to the generic syntax for Uniform Resource Identifiers as specified by the Internet Engineering Task Force."@en .


###  http://purl.org/dc/terms/W3CDTF
dcterms:W3CDTF rdf:type rdfs:Datatype ;
               rdfs:isDefinedBy <http://www.w3.org/TR/NOTE-datetime> ;
               rdfs:label "W3C-DTF"@en ;
               skos:definition "The set of dates and times constructed according to the W3C Date and Time Formats Specification."@en .


#################################################################
#    Object Properties
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000050
<http://purl.obolibrary.org/obo/BFO_0000050> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002131> ;
                                             owl:inverseOf <http://purl.obolibrary.org/obo/BFO_0000051> ;
                                             rdf:type owl:TransitiveProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "is part of"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Every cell nucleus is part_of some cell." ,
                                                                                          "my brain is part of my body (continuant parthood, two material entities)"@en ,
                                                                                          "my stomach cavity is part of my stomach (continuant parthood, immaterial entity is part of material entity)"@en ,
                                                                                          "this day is part of this year (occurrent parthood)"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A primitive, reflexive, transitive relation holding between two continuants (or, in its occurrent-specific form, between two processes), such that b part_of c holds when, at every time t at which b exists, b is a continuant part of c at t." ,
                                                                                          "a core relation that holds between a part and its whole"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Everything is part of itself. Any part of any part of a thing is itself part of that thing. Two distinct things cannot be part of each other."@en ,
                                                                                          "Occurrents are not subject to change and so parthood between occurrents holds for all the times that the part exists. Many continuants are subject to change, so parthood between continuants will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en ,
                                                                                          """Parthood requires the part and the whole to have compatible classes: only an occurrent can be part of an occurrent; only a process can be part of a process; only a continuant can be part of a continuant; only an independent continuant can be part of an independent continuant; only an immaterial entity can be part of an immaterial entity; only a specifically dependent continuant can be part of a specifically dependent continuant; only a generically dependent continuant can be part of a generically dependent continuant. (This list is not exhaustive.)

A continuant cannot be part of an occurrent: use 'participates in'. An occurrent cannot be part of a continuant: use 'has participant'. A material entity cannot be part of an immaterial entity: use 'has location'. A specifically dependent continuant cannot be part of an independent continuant: use 'inheres in'. An independent continuant cannot be part of a specifically dependent continuant: use 'bearer of'."""@en ,
                                                                                          "Simplified/summary rendering: BFO 2020 formally defines part_of via separate temporalized continuant_part_of and occurrent_part_of relations rather than a single non-temporalized elucidation; this entry gives the commonly cited summary form used across OBO ontologies." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "part_of"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 axiom family [002-xxx]; RO core.obo (BFO_0000050 part_of, is_a: RO:0002131 overlaps)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "part of"@en ;
                                             rdfs:seeAlso "http://www.obofoundry.org/ro/#OBO_REL:part_of" .


###  http://purl.obolibrary.org/obo/BFO_0000051
<http://purl.obolibrary.org/obo/BFO_0000051> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf <http://purl.obolibrary.org/obo/RO_0002131> ;
                                             rdf:type owl:TransitiveProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "has part"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "my body has part my brain (continuant parthood, two material entities)"@en ,
                                                                                          "my stomach has part my stomach cavity (continuant parthood, material entity has part immaterial entity)"@en ,
                                                                                          "this year has part this day (occurrent parthood)"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "a core relation that holds between a whole and its part"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Everything has itself as a part. Any part of any part of a thing is itself part of that thing. Two distinct things cannot have each other as a part."@en ,
                                                                                          "Included as a bare stub solely to carry the owl:inverseOf axiom on BFO:0000050 (part_of); not independently used as a TARA property." ,
                                                                                          "Occurrents are not subject to change and so parthood between occurrents holds for all the times that the part exists. Many continuants are subject to change, so parthood between continuants will only hold at certain times, but this is difficult to specify in OWL. See http://purl.obolibrary.org/obo/ro/docs/temporal-semantics/"@en ,
                                                                                          """Parthood requires the part and the whole to have compatible classes: only an occurrent have an occurrent as part; only a process can have a process as part; only a continuant can have a continuant as part; only an independent continuant can have an independent continuant as part; only a specifically dependent continuant can have a specifically dependent continuant as part; only a generically dependent continuant can have a generically dependent continuant as part. (This list is not exhaustive.)

A continuant cannot have an occurrent as part: use 'participates in'. An occurrent cannot have a continuant as part: use 'has participant'. An immaterial entity cannot have a material entity as part: use 'location of'. An independent continuant cannot have a specifically dependent continuant as part: use 'bearer of'. A specifically dependent continuant cannot have an independent continuant as part: use 'inheres in'."""@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "has_part"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "has part"@en .


###  http://purl.obolibrary.org/obo/BFO_0000066
<http://purl.obolibrary.org/obo/BFO_0000066> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf tara:bfoObjectProperty ;
                                             owl:inverseOf <http://purl.obolibrary.org/obo/BFO_0000067> ;
                                             rdfs:domain <http://purl.obolibrary.org/obo/BFO_0000003> ;
                                             rdfs:range <http://purl.obolibrary.org/obo/BFO_0000004> ;
                                             owl:propertyChainAxiom ( <http://purl.obolibrary.org/obo/BFO_0000050>
                                                                      <http://purl.obolibrary.org/obo/BFO_0000066>
                                                                    ) ,
                                                                    ( <http://purl.obolibrary.org/obo/BFO_0000066>
                                                                      <http://purl.obolibrary.org/obo/BFO_0000050>
                                                                    ) ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "occurs in"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "b occurs_in c =def b is a process and c is a material entity or immaterial entity& there exists a spatiotemporal region r and b occupies_spatiotemporal_region r.& forall(t) if b exists_at t then c exists_at t & there exist spatial regions s and s’ where & b spatially_projects_onto s at t& c is occupies_spatial_region s’ at t& s is a proper_continuant_part_of s’ at t"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000118> "occurs_in"@en ,
                                                                                          "unfolds in"@en ,
                                                                                          "unfolds_in"@en ;
                                             rdfs:comment "Paraphrase of definition: a relation between a process and an independent continuant, in which the process takes place entirely within the independent continuant" ;
                                             rdfs:isDefinedBy <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "occurs in"@en .


###  http://purl.obolibrary.org/obo/BFO_0000067
<http://purl.obolibrary.org/obo/BFO_0000067> rdf:type owl:ObjectProperty ;
                                             rdfs:subPropertyOf tara:bfoObjectProperty ;
                                             <http://purl.obolibrary.org/obo/IAO_0000111> "site of"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "[copied from inverse property 'occurs in'] b occurs_in c =def b is a process and c is a material entity or immaterial entity& there exists a spatiotemporal region r and b occupies_spatiotemporal_region r.& forall(t) if b exists_at t then c exists_at t & there exist spatial regions s and s’ where & b spatially_projects_onto s at t& c is occupies_spatial_region s’ at t& s is a proper_continuant_part_of s’ at t"@en ;
                                             rdfs:comment "Paraphrase of definition: a relation between an independent continuant and a process, in which the process takes place entirely within the independent continuant" ;
                                             rdfs:isDefinedBy <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "contains process"@en .


