###  http://purl.obolibrary.org/obo/BFO_0000001
<http://purl.obolibrary.org/obo/BFO_0000001> rdf:type owl:Class ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An entity is anything that exists or has existed or will exist." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "'Entity' is a primitive term: it is so basic to our understanding of reality that there is no way of defining it non-circularly, so BFO supplies only an elucidation rather than a genus-differentia definition. (axiom label in BFO2 Reference: [001-001])" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021), axiom [001-001]." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:isDefinedBy <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "entity" .


###  http://purl.obolibrary.org/obo/BFO_0000002
<http://purl.obolibrary.org/obo/BFO_0000002> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000003> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000003>
                                                              ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "An organism; a heart; a color; a role; the sequence of a protein molecule." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An entity that exists in full at any time in which it exists at all, persists through time while maintaining its identity and has no temporal parts."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:isDefinedBy <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "continuant" .


###  http://purl.obolibrary.org/obo/BFO_0000003
<http://purl.obolibrary.org/obo/BFO_0000003> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000001> ;
                                             owl:disjointWith [ rdf:type owl:Restriction ;
                                                                owl:onProperty <http://purl.obolibrary.org/obo/BFO_0000050> ;
                                                                owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000002>
                                                              ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An entity that has temporal parts and that happens, unfolds or develops through time."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Included as a bare stub solely to carry the owl:disjointWith axiom on BFO:0000002 (continuant), which reflects BFO's fundamental continuant/occurrent bifurcation; not independently used as a TARA class." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "occurrent" .


###  http://purl.obolibrary.org/obo/BFO_0000004
<http://purl.obolibrary.org/obo/BFO_0000004> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000020> ,
                                                              <http://purl.obolibrary.org/obo/BFO_0000031> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "An organism; a heart; a chair; a spatial region." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021); disjointness with specifically/generically dependent continuant confirmed against the BFO OBO source (BFO_0000004 disjoint_from: BFO_0000020, BFO_0000031)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:comment "A continuant that is a bearer of quality and realizable entity entities, in which other entities inhere and which itself cannot inhere in anything."@en ;
                                             rdfs:label "independent continuant" .


###  http://purl.obolibrary.org/obo/BFO_0000006
<http://purl.obolibrary.org/obo/BFO_0000006> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000140> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Included as a bare stub solely to carry the owl:disjointWith axiom on BFO:0000140 (continuant fiat boundary); not independently used as a TARA class." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "spatial region" .


###  http://purl.obolibrary.org/obo/BFO_0000009
<http://purl.obolibrary.org/obo/BFO_0000009> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000140> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000018> ,
                                                              <http://purl.obolibrary.org/obo/BFO_0000146> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The Equator; all geopolitical boundaries; all lines of latitude and longitude; the median sulcus of the tongue; the line separating the outer surface of the mucosa of the lower lip from the outer surface of the skin of the chin." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "(Elucidation, reconstructed by analogy with the confirmed BFO definitions of the sibling zero- and two-dimensional continuant fiat boundary classes) A one-dimensional continuant fiat boundary (line) is a self-connected fiat line whose location is defined in relation to some material entity." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "TARA:Meridian is modeled as a subclass of this class: a TCM meridian is a channel/line demarcated by convention within acupuncture theory, not by any natural physical discontinuity, matching the fiat-line character of this class's own examples (e.g. the Equator, lines of latitude/longitude). NOTE: the exact verbatim BFO source text for this specific class's elucidation could not be independently confirmed at time of writing (unlike its zero- and two-dimensional siblings, which were confirmed verbatim); the definition given here is a faithful reconstruction by direct analogy and should be checked against the live BFO OWL release. The example list, however, is drawn directly from a confirmed source." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021), axiom family [031-032]." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "one-dimensional continuant fiat boundary" .


###  http://purl.obolibrary.org/obo/BFO_0000015
<http://purl.obolibrary.org/obo/BFO_0000015> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "p is a process = Def. p is an occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t. (axiom label in BFO2 Reference: [083-003])"@en ;
                                             rdfs:comment "An occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t."@en ;
                                             rdfs:label "process"@en .


###  http://purl.obolibrary.org/obo/BFO_0000016
<http://purl.obolibrary.org/obo/BFO_0000016> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000023> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Included as a bare stub solely to carry the owl:disjointWith axiom on BFO:0000023 (role). Directly relevant to TARA's design history: the Role/Disposition distinction (a role depends on external context; a disposition depends on the bearer's own physical make-up) is exactly the criterion used to justify modeling TARA:Special_Acupoint_Role as a Role rather than a Disposition." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "disposition" .


###  http://purl.obolibrary.org/obo/BFO_0000017
<http://purl.obolibrary.org/obo/BFO_0000017> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000019> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The role of being a doctor; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of a piece of metal to conduct electricity." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A specifically dependent continuant  that inheres in continuant  entities and are not exhibited in full at every time in which it inheres in an entity or group of entities. The exhibition or actualization of a realizable entity is a particular manifestation, functioning or process that occurs under certain circumstances."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Distinguished from quality (the other main subtype of specifically dependent continuant) by the fact that a realizable entity need not be manifested/realized at every time it exists (e.g. a role can exist unrealized), whereas a quality is fully manifested whenever it is borne at all." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "realizable entity" .


###  http://purl.obolibrary.org/obo/BFO_0000018
<http://purl.obolibrary.org/obo/BFO_0000018> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000140> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Included as a bare stub solely to carry the owl:disjointWith axiom on BFO:0000009 (one-dimensional continuant fiat boundary). Directly relevant to TARA's design history: this class (a dimensionless fiat point) was the very first alternative considered and rejected for TARA:Acupoint, since a 0-D boundary cannot have parts and so cannot overlap material nerves/vessels." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "zero-dimensional continuant fiat boundary" .


###  http://purl.obolibrary.org/obo/BFO_0000019
<http://purl.obolibrary.org/obo/BFO_0000019> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000020> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Included as a bare stub solely to carry the owl:disjointWith axiom on BFO:0000017 (realizable entity); not independently used as a TARA class." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "quality" .


###  http://purl.obolibrary.org/obo/BFO_0000020
<http://purl.obolibrary.org/obo/BFO_0000020> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000031> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A color; a shape; a role; a disposition." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "b is a specifically dependent continuant = Def. b is a continuant & there is some independent continuant c which is not a spatial region and which is such that b s-depends_on c at every time t during the course of b’s existence. (axiom label in BFO2 Reference: [050-003])"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:comment "A continuant that inheres in or is borne by other entities. Every instance of A requires some specific instance of B which must always be the same."@en ;
                                             rdfs:label "specifically dependent continuant" .


###  http://purl.obolibrary.org/obo/BFO_0000023
<http://purl.obolibrary.org/obo/BFO_0000023> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000017> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The priest role; the student role; the role of subject in a clinical trial; the role of a stone in marking a property boundary; the role of a building in serving as a military target." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "(Elucidation) A role is a realizable entity that exists because there is some single bearer that is in some special physical, social, or institutional set of circumstances in which this bearer does not have to be, and is not such that, if it ceases to exist, then the physical make-up of the bearer is thereby changed." ,
                                                                                          "A realizable entity  the manifestation of which brings about some result or end that is not essential to a continuant  in virtue of the kind of thing that it is but that can be served or participated in by that kind of continuant  in some kinds of natural, social or institutional contexts."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "TARA:Special_Acupoint_Role is modeled as a subclass of this class: whether an acupoint counts as, e.g., a Front-Mu point is conferred entirely by TCM theory (an external, institutional/doctrinal context) rather than by the acupoint's own physical make-up, matching the defining Role/Disposition distinction given here." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "role" .


###  http://purl.obolibrary.org/obo/BFO_0000024
<http://purl.obolibrary.org/obo/BFO_0000024> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000027> ,
                                                              <http://purl.obolibrary.org/obo/BFO_0000030> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The upper and lower lobes of the left lung; the dorsal and ventral surfaces of the body; the Western hemisphere of the Earth; the FMA regional parts of an intact human body." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "(Elucidation) A fiat object part b is a material entity which is such that for all times t, if b exists at t then there is some object c such that b is a proper continuant part of c at t and b is demarcated from the remainder of c by one or more fiat surfaces." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "TARA:Acupoint is modeled as a subclass of this class: an acupoint is a fiat-demarcated volume of pre-existing tissue (skin, fascia, muscle), delimited by needling convention rather than by any natural physical discontinuity, matching the 'not itself a distinct kind of tissue' character of this class's own examples (e.g. the upper/lower lobes of the lung are not a distinct tissue type from the rest of the lung)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "fiat object part" .


###  http://purl.obolibrary.org/obo/BFO_0000027
<http://purl.obolibrary.org/obo/BFO_0000027> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Included as a bare stub solely to carry the owl:disjointWith axiom on BFO:0000024 (fiat object part); not independently used as a TARA class." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "object aggregate" .


###  http://purl.obolibrary.org/obo/BFO_0000029
<http://purl.obolibrary.org/obo/BFO_0000029> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000140> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Included as a bare stub solely to carry the owl:disjointWith axiom on BFO:0000140 (continuant fiat boundary). Directly relevant to TARA's design history: Site was an alternative BFO class considered and rejected for both TARA:Acupoint and TARA:Meridian, precisely because a Site (unlike a Fiat Object Part or a Continuant Fiat Boundary) is immaterial and so cannot overlap the material nerves/vessels those classes need to relate to." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "site" .


###  http://purl.obolibrary.org/obo/BFO_0000030
<http://purl.obolibrary.org/obo/BFO_0000030> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Included as a bare stub solely to carry the owl:disjointWith axiom on BFO:0000024 (fiat object part), one of the three (pairwise disjoint) direct subclasses of material entity; not independently used as a TARA class." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "object" .


###  http://purl.obolibrary.org/obo/BFO_0000031
<http://purl.obolibrary.org/obo/BFO_0000031> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000002> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Included as a bare stub solely to carry disjointWith axioms against BFO:0000004 and BFO:0000020, the two other direct subclasses of continuant; not independently used as a TARA class." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021), axiom [074-001]." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:comment "A continuant that is dependent on one or other independent continuant bearers. For every instance of A requires some instance of (an independent continuant type) B but which instance of B serves can change from time to time."@en ;
                                             rdfs:isDefinedBy <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "generically dependent continuant" .


###  http://purl.obolibrary.org/obo/BFO_0000034
<http://purl.obolibrary.org/obo/BFO_0000034> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000016> ;
                                             rdfs:label "function" .


###  http://purl.obolibrary.org/obo/BFO_0000040
<http://purl.obolibrary.org/obo/BFO_0000040> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> ;
                                             owl:disjointWith <http://purl.obolibrary.org/obo/BFO_0000141> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "An organism; a heart; a chair; a lung; an apple." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An independent continuant that is spatially extended whose identity is independent of that of other entities and can be maintained through time."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ,
                                                                                          <http://purl.obolibrary.org/obo/uberon.owl> ;
                                             rdfs:label "material entity" .


###  http://purl.obolibrary.org/obo/BFO_0000140
<http://purl.obolibrary.org/obo/BFO_0000140> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000141> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "The North Pole (a fiat point); the Equator (a fiat line); the plane separating the Northern from the Southern hemisphere (a fiat surface)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "b is a continuant fiat boundary = Def. b is an immaterial entity that is of zero, one or two dimensions and does not include a spatial region as part. (axiom label in BFO2 Reference: [029-001])" ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021), axiom [029-001]." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "continuant fiat boundary" .


###  http://purl.obolibrary.org/obo/BFO_0000141
<http://purl.obolibrary.org/obo/BFO_0000141> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000004> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A spatial region; a site; a continuant fiat boundary." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "b is an immaterial entity =Def. b is an independent continuant which is such that there is no time t when it has a material entity as continuant part." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "immaterial entity" .


###  http://purl.obolibrary.org/obo/BFO_0000146
<http://purl.obolibrary.org/obo/BFO_0000146> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000140> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "Included as a bare stub solely to carry the owl:disjointWith axiom on BFO:0000009 (one-dimensional continuant fiat boundary); not independently used as a TARA class." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "BFO 2020 (ISO/IEC 21838-2:2021)." ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> <http://purl.obolibrary.org/obo/bfo.owl> ;
                                             rdfs:label "two-dimensional continuant fiat boundary" .


###  http://purl.obolibrary.org/obo/IAO_0000013
<http://purl.obolibrary.org/obo/IAO_0000013> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000088> ,
                                                             <http://purl.obolibrary.org/obo/IAO_0000311> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Examples are articles published in the journals, Nature and Science. The content can often be cited by reference to a paper based encoding, e.g. Authors, Title of article, Journal name, date or year of publication, volume and page number."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A report that is published in a journal."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "group:OBI; OBI_0000159"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> "http://purl.obolibrary.org/obo/iao.owl"@en ;
                                             rdfs:label "journal article" .


###  http://purl.obolibrary.org/obo/IAO_0000027
<http://purl.obolibrary.org/obo/IAO_0000027> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Data items include counts of things, analyte concentrations, and statistical summaries."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "An information content entity that is intended to be one or more truthful statement(s) about something (modulo, e.g., measurement precision or other systematic errors) and is constructed/acquired by a method which reliably tends to produce (approximately) truthful statements."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> "http://purl.obolibrary.org/obo/iao.owl" ;
                                             rdfs:label "data entity" .


###  http://purl.obolibrary.org/obo/IAO_0000030
<http://purl.obolibrary.org/obo/IAO_0000030> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000031> ,
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty <http://purl.obolibrary.org/obo/IAO_0000136> ;
                                                               owl:someValuesFrom <http://purl.obolibrary.org/obo/BFO_0000001>
                                                             ] ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Examples of information content entites include journal articles, data, graphical layouts, and graphs."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A generically dependent continuant that is about some thing."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000116> "2014-03-10: The use of \"thing\" is intended to be general enough to include universals and configurations (see https://groups.google.com/d/msg/information-ontology/GBxvYZCk1oc/-L6B5fSBBTQJ)."@en ,
                                                                                          "information_content_entity 'is_encoded_in' some digital_entity in obi before split (040907). information_content_entity 'is_encoded_in' some physical_document in obi before split (040907). Previous. An information content entity is a non-realizable information entity that 'is encoded in' some digital or physical entity."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "OBI_0000142"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> "http://purl.obolibrary.org/obo/iao.owl" ;
                                             rdfs:label "information content entity" .


###  http://purl.obolibrary.org/obo/IAO_0000088
<http://purl.obolibrary.org/obo/IAO_0000088> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000310> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "Examples of reports are gene lists and investigation reports. These are not published (journal) articles but may be included in a journal article."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A document assembled by an author for the purpose of providing information for the audience. A report is the output of a documenting process and has the objective to be consumed by a specific audience. Topic of the report is on something that has completed. A report is not a single figure. Examples of reports are journal article, patent application, grant progress report, case report (not patient record)."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000119> "GROUP: OBI; OBI_0000099"@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> "http://purl.obolibrary.org/obo/iao.owl"@en ;
                                             rdfs:label "report" .


###  http://purl.obolibrary.org/obo/IAO_0000102
<http://purl.obolibrary.org/obo/IAO_0000102> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000027> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "Data about an ontology part is a data item about a part of an ontology, for example a term."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> "http://purl.obolibrary.org/obo/iao.owl" ;
                                             rdfs:label "data about an ontology part" .


###  http://purl.obolibrary.org/obo/IAO_0000310
<http://purl.obolibrary.org/obo/IAO_0000310> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000030> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "A journal article, patent application, laboratory notebook, or a book."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A collection of information content entities intended to be understood together as a whole."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000412> "http://purl.obolibrary.org/obo/iao.owl"@en ;
                                             rdfs:label "document" .


###  http://purl.obolibrary.org/obo/IAO_0000311
<http://purl.obolibrary.org/obo/IAO_0000311> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://purl.obolibrary.org/obo/IAO_0000310> ;
                                             <http://purl.obolibrary.org/obo/IAO_0000112> "journal article, newspaper story, book, etc."@en ;
                                             <http://purl.obolibrary.org/obo/IAO_0000115> "A document that is the output of a publishing process."@en ;
