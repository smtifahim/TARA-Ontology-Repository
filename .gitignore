# Ignore environment files containing secrets
.env

# Google OAuth client secret / cached token for curated-sheets downloader
curated-data/.credentials/

# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Python cache profiles
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Temporary files generated by the ontology generator
.vscode/*